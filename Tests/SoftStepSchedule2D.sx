use GFX.Physics
use STD.Math

test "perform one biased solve and one relaxation per Soft Step substep" {
    for substeps in [1, 2, 4, 8] {
        var world = Physics.World2D()
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..body_type = Physics.BodyType2D.fixed
            ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
            ..position = Math.Vec2(0.0, -0.5)
        )
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
            ..position = Math.Vec2(0.0, 0.5)
            ..allow_sleep = false
        )
        world.step(1.0 / 60.0, substeps:substeps)
        assert(world.soft_step_stage_count() == 2 + substeps * 5 + 3)
        assert(world.soft_step_stage_at(0) == 1)
        assert(world.soft_step_stage_at(1) == 2)
        var step = 0
        while step < substeps {
            var stage = 0
            while stage < 5 {
                assert(world.soft_step_stage_at(2 + step * 5 + stage) == 3 + stage)
                stage++
            }
            step++
        }
        assert(world.soft_step_stage_at(2 + substeps * 5) == 8)
        assert(world.soft_step_stage_at(3 + substeps * 5) == 9)
        assert(world.soft_step_stage_at(4 + substeps * 5) == 10)
    }
}
