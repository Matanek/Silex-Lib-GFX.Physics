use GFX.Physics
use GFX.Physics.Geometry3D.BoxPointQuery3D
use STD.Math

test "prepared box point query retains exact generic distances at faces edges corners and inside" {
    let scales:float[]=[0.001,1.0,1000.0]
    let coordinates:float[]=[-2.0,-1.0,-0.75,0.0,0.75,1.0,2.0]
    for scale in scales {
        let box=Physics.Box3D(Math.Vec3(2.0,1.5,3.0).multiply(scale))
        let poses:Physics.Transform3D[]=[Physics.Transform3D(),
            Physics.Transform3D(Math.Vec3(0.0,3.0,0.0),Math.Quat.angle_axis(-0.3,Math.Vec3.right())),
            Physics.Transform3D(Math.Vec3(20.0,-5.0,30.0),Math.Quat.angle_axis(0.7,Math.Vec3(1.0,2.0,3.0).normalized()))]
        for pose in poses {
            let query=BoxPointQuery3D(box,pose)
            let target=Physics.ShapePlacement3D(Physics.Shape3D.box(box),pose)
            for x in coordinates { for y in coordinates { for z in coordinates {
                let center=pose.point(Math.Vec3(x,y,z).multiply(scale));let radius=0.035*scale
                let actual=query.sphere_distance(center,radius)
                let expected=Physics.Geometry3D.distance(Physics.ShapePlacement3D(
                    Physics.Shape3D.sphere(Physics.Sphere3D(radius)),Physics.Transform3D(center)),target)
                assert(actual.separation==expected.separation && actual.normal==expected.normal)
                assert(actual.first_point==expected.first_point && actual.second_point==expected.second_point)
            } } }
        }
    }
}

test "prepared soft box contacts refresh pose shape enable and removal" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3() ..soft_body_substeps=1)
    var rigid=world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.0))))
    var soft=world.create_soft_body(Physics.SoftBody3DDefinition(positions:[Math.Vec3(0.0,1.025,0.0)]),
        Physics.SoftBody3DSettings() ..vertex_radius=0.05 ..friction=0.0)
    world.step(1.0/120.0)
    assert(soft.position(0).nearly_equal(Math.Vec3(0.0,1.05,0.0),0.00001))
    rigid.set_transform(Physics.Transform3D(Math.Vec3(0.0,2.0,0.0)))
    world.step(1.0/120.0)
    assert(soft.position(0).nearly_equal(Math.Vec3(0.0,0.95,0.0),0.00001))
    rigid.set_shape(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0))))
    soft.set_pose([Physics.SoftPose3D(0,Math.Vec3(0.0,1.525,0.0))]);world.step(1.0/120.0)
    assert(soft.position(0).nearly_equal(Math.Vec3(0.0,1.45,0.0),0.00001))
    rigid.set_enabled(false)
    soft.set_pose([Physics.SoftPose3D(0,Math.Vec3(0.0,2.0,0.0))]);world.step(1.0/120.0)
    assert(soft.position(0).nearly_equal(Math.Vec3(0.0,2.0,0.0),0.00001))
    rigid.set_enabled(true);world.destroy_rigid_body(rigid);world.step(1.0/120.0)
    assert(soft.position(0).nearly_equal(Math.Vec3(0.0,2.0,0.0),0.00001))
}
