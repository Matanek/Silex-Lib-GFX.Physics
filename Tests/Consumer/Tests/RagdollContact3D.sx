use GFX.Physics
use STD.Math

func contact_settings() Physics.Ragdoll3DSettings {
    let root=Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..collision_filter=Physics.CollisionFilter3D(mask_bits:0)
    let body=Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.sphere(Physics.Sphere3D(0.25))
        ..mass_properties=Physics.MassProperties3D(2.0,Math.Vec3(0.2))
        ..allow_sleep=false ..friction=0.0 ..restitution=0.0
    let joint=Physics.SwingTwistConstraint3DSettings() ..minimum_twist=-0.2 ..maximum_twist=0.35
        ..swing_limits=Physics.SwingLimits3D.cone(Math.Vec2(0.6))
    return Physics.Ragdoll3DSettings([Physics.RagdollPart3D(-1,root),
        Physics.RagdollPart3D(0,body,body_offset:Physics.Transform3D(Math.Vec3(1.0,0.0,0.0)),joint:joint)],self_collision:false)
}
func contact_target(side:int,phase:int) Math.Quat {
    var direction=1.0;var twist=0.7
    if phase==1 { direction=-1.0;twist=-0.5 }
    let y=Math.sin(0.25*side as float*direction);let z=Math.sin(-0.4*direction)
    return Math.Quat(0.0,y,z,Math.sqrt(1.0-y*y-z*z)).multiply(Math.Quat.angle_axis(twist,Math.Vec3(1.0,0.0,0.0)))
}

test "ragdoll clamped pose efforts lift from a floor and return without placing members" {
    var sides:int[]=[-1,1]
    for mode in [0,1] { for rate in [60,120] { for side in sides { for frame in [0,1] {
        var world=Physics.World3D(Physics.World3DSettings() ..position_iterations=16)
        if mode==1 { world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=0.0 ..restitution=0.0) }
        let base=Math.Quat.angle_axis(0.7*frame as float,Math.Vec3(0.0,1.0,0.0));var config=contact_settings()
        var ragdoll=world.create_ragdoll(config,Physics.Transform3D(Math.Vec3(0.0,0.5,0.0),base))
        var separate=world.create_ragdoll(config,Physics.Transform3D(Math.Vec3(5.0,4.5,0.0),base))
        var body=ragdoll.body(1);var joint=ragdoll.joint(1)!
        var contacts:Physics.Contact3D[]=[];var step=0
        while step<rate*14 {
            if step==0 || step==rate*4 || step==rate*8 || step==rate*12 {
                let pose=copy body.transform();let v=copy body.linear_velocity();let w=copy body.angular_velocity()
                let other=copy separate.body(1).transform();let ov=copy separate.body(1).linear_velocity();let ow=copy separate.body(1).angular_velocity()
                if step==rate*12 { ragdoll.stop_motors();body.apply_angular_impulse(body.rotation().rotate(Math.Vec3(0.2,0.0,0.0))) }
                else { var phase=0;if step==rate*4 { phase=1 }
                    ragdoll.drive_to_local_pose([Physics.Transform3D(Math.Vec3(0.0,0.5,0.0),base),
                        Physics.Transform3D(rotation:contact_target(side,phase))],30.0,80.0,15.0) }
                assert(body.transform()==pose && body.linear_velocity()==v)
                var change=Math.Vec3();if step==rate*12 { change=pose.rotation.rotate(Math.Vec3(1.0,0.0,0.0)) }
                assert(body.angular_velocity().subtract(w).nearly_equal(change,0.00001))
                assert(separate.body(1).transform()==other && separate.body(1).linear_velocity()==ov && separate.body(1).angular_velocity()==ow)
                assert(separate.joint(1)!.twist_motor()==null && separate.joint(1)!.swing_motor()==null)
            }
            let before=copy body.linear_velocity();world.step(1.0/rate);step++
            world.write_contacts(contacts);var impulse=Math.Vec3();var own_contacts=0
            for contact in contacts {
                if contact.first_body().same_body(body) || contact.second_body().same_body(body) {
                    own_contacts++;var applied=contact.normal().multiply(contact.normal_impulse()).add(contact.tangent_impulse())
                    if contact.first_body().same_body(body) { applied=applied.negated() }
                    impulse=impulse.add(applied)
                }
            }
            let balance=body.linear_velocity().subtract(before).multiply(2.0)
                .subtract(joint.reaction_force().divide(rate as float)).subtract(Math.Vec3(0.0,-19.62/rate,0.0)).subtract(impulse)
            assert(balance.length()<0.0002 && impulse.y>=0.0 && Math.abs(impulse.x)+Math.abs(impulse.z)<0.00001)
            assert(joint.anchor_error().length()<0.02 && body.linear_velocity().length()<40.0 && body.angular_velocity().length()<40.0)
            let twist=joint.twist_angle();let swing=joint.orientation().multiply(Math.Quat.angle_axis(-twist,Math.Vec3(1.0,0.0,0.0)))
            assert(twist> -0.28 && twist<0.43 && 2.0*Math.asin(Math.min(1.0,Math.sqrt(swing.y*swing.y+swing.z*swing.z)))<0.68)
            let motor=joint.motor_torque();assert(Math.abs(motor.x)<30.001 && Math.abs(motor.y)<30.001 && Math.abs(motor.z)<30.001)
            if mode==1 { assert(body.position().y>0.23) } else { assert(own_contacts==0) }
            if step>rate*12 { assert(motor.length()<0.00001) }
            for phase in [0,1,2] {
                if step>=rate*phase*4+rate*7/2 && step<=rate*(phase+1)*4 {
                    assert(body.linear_velocity().length()<0.15 && body.angular_velocity().length()<0.15)
                    if phase==1 { assert(own_contacts==0 && body.position().y>0.4) }
                    else if mode==1 { assert(own_contacts==1 && Math.abs(body.position().y-0.25)<0.02) }
                }
            }
        }
        var stale=body;world.destroy_ragdoll(ragdoll);assert(!stale.is_valid() && separate.is_valid())
        var fresh=world.create_ragdoll(config);assert(!stale.same_body(fresh.body(1)))
        world.destroy_ragdoll(fresh);world.destroy_ragdoll(separate)
        assert(world.body_count()==mode && world.swing_twist_constraint_count()==0)
    } } } }
}
