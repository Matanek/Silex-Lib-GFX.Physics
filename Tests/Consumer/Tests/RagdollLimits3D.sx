use GFX.Physics
use STD.Math

func passive_limits_settings() Physics.Ragdoll3DSettings {
    let body=Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.sphere(Physics.Sphere3D(0.25))
        ..mass_properties=Physics.MassProperties3D(2.0,Math.Vec3(0.2)) ..allow_sleep=false
    let joint=Physics.SwingTwistConstraint3DSettings() ..swing_limits=Physics.SwingLimits3D.cone(Math.Vec2())
        ..minimum_twist=-0.2 ..maximum_twist=0.35
    return Physics.Ragdoll3DSettings([
        Physics.RagdollPart3D(-1,body),
        Physics.RagdollPart3D(0,body,local_transform:Physics.Transform3D(Math.Vec3(0.5,0.0,0.0)),
            body_offset:Physics.Transform3D(Math.Vec3(0.5,0.0,0.0)),joint:joint),
        Physics.RagdollPart3D(1,body,local_transform:Physics.Transform3D(Math.Vec3(1.0,0.0,0.0)),
            body_offset:Physics.Transform3D(Math.Vec3(0.5,0.0,0.0)),joint:joint)
    ],self_collision:false)
}

test "passive ragdoll transmits opposed angular impulses through asymmetric stops without energy injection" {
    var sides:int[]=[-1,1]
    for rate in [60,120] { for side in sides { for frame in [0,1] {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3() ..position_iterations=8)
        var base=Math.Quat();if frame==1 { base=Math.Quat.angle_axis(0.6,Math.Vec3(1.0,2.0,-1.0).normalized()) }
        let axis=base.rotate(Math.Vec3(1.0,0.0,0.0));var settings=passive_limits_settings()
        var ragdoll=world.create_ragdoll(settings,Physics.Transform3D(Math.Vec3(0.0,3.0,0.0),base))
        var separate=world.create_ragdoll(settings,Physics.Transform3D(Math.Vec3(0.0,13.0,0.0),base))
        var prior_energy=0.0;var step=0
        while step<=rate*4 {
            if step==0 || step==rate*2 {
                let before=ragdoll.body(2).transform();let speed=ragdoll.body(2).angular_velocity()
                var impulse=0.6*side as float;if step>0 { impulse=-impulse }
                ragdoll.body(2).apply_angular_impulse(axis.multiply(impulse))
                assert(ragdoll.body(2).transform()==before)
                assert(ragdoll.body(2).angular_velocity().subtract(speed).nearly_equal(axis.multiply(impulse/0.2),0.00001))
            }
            var angular=Math.Vec3();var energy=0.0
            for part in [0,1,2] {
                var member=ragdoll.body(part);let p=member.position();let v=member.linear_velocity();let w=member.angular_velocity()
                angular=angular.add(p.cross(v.multiply(2.0))).add(w.multiply(0.2))
                energy+=v.dot(v)+0.1*w.dot(w)
                assert(p.nearly_equal(Math.Vec3(0.0,3.0,0.0).add(axis.multiply(part as float)),0.001))
                assert(v.length()<0.001 && w.cross(axis).length()<0.001)
                assert(separate.body(part).linear_velocity().length()<0.00001 && separate.body(part).angular_velocity().length()<0.00001)
                if part>0 {
                    var joint=ragdoll.joint(part)!;let angle=joint.twist_angle()
                    assert(joint.anchor_error().length()<0.001 && joint.swing_angles().length()<0.001)
                    assert(angle>=-0.2-3.0/rate-0.005 && angle<=0.35+3.0/rate+0.005)
                    if step==rate*2-1 || step==rate*4 {
                        var direction=side;if step==rate*4 { direction=-direction }
                        var target=-0.2;if direction>0 { target=0.35 }
                        assert(Math.abs(angle-target)<0.02)
                    }
                }
                if step==rate*2-1 || step==rate*4 {
                    var speed=side as float;if step==rate*4 { speed=0.0 }
                    assert(w.subtract(axis.multiply(speed)).length()<0.01)
                }
            }
            var momentum=0.6*side as float;if step>=rate*2 { momentum=0.0 }
            assert(angular.subtract(axis.multiply(momentum)).length()<0.0001)
            if step!=0 && step!=rate*2 { assert(energy<=prior_energy+0.0001) }
            prior_energy=energy
            if step<rate*4 { world.step(1.0/rate) }
            step++
        }
        var stale=ragdoll.body(2);world.destroy_ragdoll(ragdoll)
        assert(!stale.is_valid() && separate.is_valid())
        var fresh=world.create_ragdoll(settings);assert(!stale.same_body(fresh.body(2)))
        world.destroy_ragdoll(fresh);world.destroy_ragdoll(separate)
        assert(world.body_count()==0 && world.swing_twist_constraint_count()==0)
    } } }
}
