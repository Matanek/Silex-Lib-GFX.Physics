use GFX.Physics
use STD.Math

func make(world:Physics.World3D) Physics.TrackedVehicle3D {
    var wheels:Physics.TrackedWheel3DSettings[]=[];var i=0
    let longitudinal=1.0;let lateral=0.15
    while i<6 {
        var x= -0.6;if i>=3 { x=0.6 }
        wheels.append(Physics.TrackedWheel3DSettings(Math.Vec3(x,0.0,(i%3-1) as float),longitudinal_friction:longitudinal,lateral_friction:lateral));i++
    }
    var vehicle=world.create_tracked_vehicle(Physics.TrackedVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
            ..transform=Physics.Transform3D(Math.Vec3(1.0,1.15,0.0)) ..allow_sleep=false
            ..linear_damping=0.0 ..angular_damping=0.0 ..friction=0.0,wheels,
        Physics.VehicleTrack3DSettings(0,[0,1,2],inertia:2.0,angular_damping:0.0,maximum_brake_torque:1500.0,differential_ratio:6.0),
        Physics.VehicleTrack3DSettings(3,[3,4,5],inertia:2.0,angular_damping:0.0,maximum_brake_torque:1500.0,differential_ratio:6.0),
        engine:Physics.VehicleEngine3DSettings(maximum_torque:15.0,minimum_rpm:1000.0,maximum_rpm:6000.0,inertia:0.5,angular_damping:0.0,torque_curve:[Math.Vec2(0.0,1.0)]),
        transmission:Physics.VehicleTransmission3DSettings(mode:Physics.VehicleTransmissionMode3D.automatic,gear_ratios:[2.0,1.4,1.0],reverse_gear_ratios:[-2.0,-1.4,-1.0],shift_up_rpm:1800.0,shift_down_rpm:1200.0)))
    return vehicle
}
func fixture(rate:int) Physics.World3D {
    return Physics.World3D()
}
func reflect_point(value:Math.Vec3) Math.Vec3 { return Math.Vec3(value.x,value.y,-value.z) }
func reflect_spin(value:Math.Vec3) Math.Vec3 { return Math.Vec3(-value.x,-value.y,value.z) }
test "braked tracks preserve mirrored rotating support response through stopping" {
    for rate in [60,120] {
        var positive=fixture(rate);var negative=fixture(rate)
        let settings=Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.kinematic
            ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(8.0,0.4,12.0)))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,-0.2,0.0)) ..friction=1.0 ..allow_sleep=false
        var first=positive.create_rigid_body(settings);var second=negative.create_rigid_body(settings)
        var left=make(positive);var right=make(negative);var step=0
        while step<6*rate {
            var spin=0.0;if step>=2*rate && step<4*rate { spin=0.25 }
            first.set_angular_velocity(Math.Vec3(0.0,spin,0.0));second.set_angular_velocity(Math.Vec3(0.0,-spin,0.0))
            left.set_controls(throttle:0.0,left_ratio:1.0,right_ratio:1.0,brake:1.0)
            right.set_controls(throttle:0.0,left_ratio:1.0,right_ratio:1.0,brake:1.0)
            positive.step(1.0/rate as float);negative.step(1.0/rate as float);step++
            var a=left.chassis();var b=right.chassis()
            assert(a.position().subtract(reflect_point(b.position())).length()<0.005)
            assert(a.linear_velocity().subtract(reflect_point(b.linear_velocity())).length()<0.02)
            assert(a.angular_velocity().subtract(reflect_spin(b.angular_velocity())).length()<0.02)
            if step>5*rate {
                assert(a.linear_velocity().length()<0.05 && b.linear_velocity().length()<0.05)
                assert(a.angular_velocity().length()<0.05 && b.angular_velocity().length()<0.05)
            }
        }
    }
}
