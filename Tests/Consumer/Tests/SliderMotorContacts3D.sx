use GFX.Physics
use STD.Math

test "slider motor pushes against a real contact while preserving its force capacity and can reverse away" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var rail = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..transform = Physics.Transform3D(Math.Vec3(1.0, 0.0, 0.0))
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0, 4.0, 4.0))))
    var carriage = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.25))
        ..mass_properties = Physics.MassProperties3D(2.0, Math.Vec3(0.2))
        ..allow_sleep = false ..restitution = 0.0)
    var joint = world.create_slider_constraint(rail, carriage,
        Physics.SliderConstraint3DSettings() ..motor = Physics.SliderMotor3D(1.0, 2.0))
    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        assert(Math.abs(joint.motor_force()) <= 2.0001)
        assert(joint.anchor_error().length() < 0.001 && joint.angular_error().length() < 0.001)
        step++
    }
    print("slider motor contact: x=$(joint.position()) speed=$(joint.speed()) force=$(joint.motor_force()) count=$(world.contact_count())")
    assert(world.contact_count() == 1)
    assert(Math.abs(joint.position() - 0.25) < 0.001 && Math.abs(joint.speed()) < 0.001)
    assert(Math.abs(joint.motor_force() - 2.0) < 0.001 && joint.limit_force() == 0.0)
    joint.set_motor(Physics.SliderMotor3D(-1.0, 2.0))
    step = 0
    while step < 60 { world.step(1.0 / 120.0); step++ }
    assert(joint.position() < 0.2 && joint.speed() < -0.49 && world.contact_count() == 0)
}
