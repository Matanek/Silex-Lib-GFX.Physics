use GFX.Physics
use STD.Math

func position_body(world:Physics.World3D, mass:float = 2.0, position:Math.Vec3 = Math.Vec3()) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position)
        ..mass_properties = Physics.MassProperties3D(mass, Math.Vec3(mass * 0.1))
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
}
func position_rail(world:Physics.World3D) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
}
func position_alignment(joint:Physics.SliderConstraint3D) {
    assert(joint.anchor_error().length() < 0.0001 && joint.angular_error().length() < 0.0001)
}
func position_steps(world:Physics.World3D, count:int) {
    var step = 0
    while step < count { world.step(1.0 / 120.0); step++ }
}

test "slider position follows the independent implicit recurrence at sixty and one hundred twenty hertz" {
    let dampings:float[] = [8.0, 0.8]
    for rate in [60, 120] {
        for damping in dampings {
            var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
            var joint = world.create_slider_constraint(position_rail(world), position_body(world),
                Physics.SliderConstraint3DSettings() ..motor = Physics.SliderMotor3D.position(0.75, 100.0, 8.0, damping))
            let dt = 1.0 / rate as float
            var speed = 0.0
            var position = 0.0
            var peak = 0.0
            var step = 0
            while step < rate * 6 {
                var target = 0.75
                if step >= rate * 2 { target = -0.4 }
                if step >= rate * 4 { target = 0.2 }
                if step == rate * 2 || step == rate * 4 {
                    joint.set_motor(Physics.SliderMotor3D.position(target, 100.0, 8.0, damping))
                }
                speed = (2.0 * speed + dt * 8.0 * (target - position)) / (2.0 + dt * damping + dt * dt * 8.0)
                position += dt * speed
                world.step(dt)
                assert(Math.abs(joint.position() - position) < 0.00001)
                assert(Math.abs(joint.speed() - speed) < 0.00001)
                assert(Math.abs(joint.motor_force() - 8.0 * (target - position) + damping * speed) < 0.0001)
                assert(Math.abs(joint.reaction_force().x - joint.motor_force()) < 0.00001 && joint.limit_force() == 0.0)
                position_alignment(joint)
                if step < rate * 2 { peak = Math.max(peak, joint.position()) }
                step++
            }
            if damping == 8.0 { assert(peak < 0.75) } else { assert(peak > 1.0) }
            let force = joint.motor_force()
            world.step(0.0)
            assert(joint.motor_force() == force)
        }
    }
}

test "slider position saturation shares one force budget across all solver passes" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var joint = world.create_slider_constraint(position_rail(world), position_body(world),
        Physics.SliderConstraint3DSettings() ..motor = Physics.SliderMotor3D.position(5.0, 0.2, 8.0, 8.0))
    var step = 0
    while step < 120 {
        world.step(1.0 / 120.0)
        let n = (step + 1) as float
        assert(Math.abs(joint.speed() - 0.1 * n / 120.0) < 0.00001)
        assert(Math.abs(joint.position() - 0.1 * n * (n + 1.0) / (2.0 * 120.0 * 120.0)) < 0.00001)
        assert(Math.abs(joint.motor_force() - 0.2) < 0.00001)
        step++
    }
}

test "slider position has a physical load offset and cannot overcome insufficient capacity" {
    let capacities:float[] = [10.0, 1.0]
    for capacity in capacities {
        var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3(-2.0, -9.81, 0.0))
        var joint = world.create_slider_constraint(position_rail(world), position_body(world),
            Physics.SliderConstraint3DSettings() ..motor = Physics.SliderMotor3D.position(0.75, capacity, 8.0, 8.0))
        let dt = 1.0 / 120.0
        var speed = 0.0
        var position = 0.0
        var step = 0
        var duration = 720
        if capacity == 1.0 { duration = 120 }
        while step < duration {
            let next = (2.0 * speed + dt * 8.0 * (0.75 - position) - 4.0 * dt) / (2.0 + 8.0 * dt + 8.0 * dt * dt)
            let force = Math.clamp(2.0 * (next - speed + 2.0 * dt) / dt, -capacity, capacity)
            speed += -2.0 * dt + force * dt / 2.0
            position += speed * dt
            world.step(dt)
            assert(Math.abs(joint.position() - position) < 0.00001 && Math.abs(joint.speed() - speed) < 0.00001)
            assert(Math.abs(joint.motor_force() - force) < 0.0001)
            assert(Math.abs(joint.reaction_force().y - 19.62) < 0.0001)
            position_alignment(joint)
            step++
        }
        if capacity == 10.0 {
            assert(Math.abs(joint.position() - 0.25) < 0.0001 && Math.abs(joint.speed()) < 0.0001)
            assert(Math.abs(joint.motor_force() - (4.0 + 8.0 * (0.25 - joint.position()) - 8.0 * joint.speed())) < 0.0001)
        } else { assert(joint.speed() < -1.49 && joint.motor_force() > 0.9999) }
    }
}

test "slider position between unequal free masses follows reduced mass and conserves momentum" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var first = position_body(world, 2.0)
    var second = position_body(world, 8.0)
    var joint = world.create_slider_constraint(first, second,
        Physics.SliderConstraint3DSettings() ..motor = Physics.SliderMotor3D.position(0.75, 10.0, 6.4, 6.4))
    var speed = 0.0
    var position = 0.0
    let dt = 1.0 / 120.0
    var step = 0
    while step < 480 {
        speed = (1.6 * speed + dt * 6.4 * (0.75 - position)) / (1.6 + dt * 6.4 + dt * dt * 6.4)
        position += speed * dt
        world.step(dt)
        assert(Math.abs(joint.position() - position) < 0.00001 && Math.abs(joint.speed() - speed) < 0.00001)
        assert(first.linear_velocity().multiply(2.0).add(second.linear_velocity().multiply(8.0)).length() < 0.00001)
        assert(first.position().multiply(2.0).add(second.position().multiply(8.0)).length() < 0.00001)
        assert(first.angular_velocity().length() < 0.00001 && second.angular_velocity().length() < 0.00001)
        position_alignment(joint)
        step++
    }
}

test "slider position preserves arbitrary three dimensional offset anchors and mass frames" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    let rotation = Math.Quat.angle_axis(0.7, Math.Vec3(1.0, 2.0, 3.0).normalized())
    let origin = Math.Vec3(0.7, 1.2, -0.6)
    let anchor = Math.Vec3(0.1, 0.4, 0.2)
    let center = Math.Vec3(-0.2, 0.1, 0.4)
    var rail = position_rail(world)
    rail.set_transform(Physics.Transform3D(origin, rotation))
    var body = position_body(world, 3.0, origin.subtract(rotation.rotate(anchor)))
    body.set_transform(Physics.Transform3D(body.position(), rotation))
    body.set_mass_properties(Physics.MassProperties3D(3.0, Math.Vec3(0.3, 0.6, 0.9), center))
    var joint = world.create_slider_constraint(rail, body, Physics.SliderConstraint3DSettings()
        ..second_local_frame = Physics.Transform3D(anchor)
        ..motor = Physics.SliderMotor3D.position(0.75, 30.0, 12.0, 12.0))
    let axis = rotation.rotate(Math.Vec3(1.0, 0.0, 0.0))
    let radius = rotation.rotate(anchor.subtract(center))
    var position = 0.0
    var speed = 0.0
    let dt = 1.0 / 120.0
    var step = 0
    while step < 360 {
        speed = (3.0 * speed + dt * 12.0 * (0.75 - position)) / (3.0 + dt * 12.0 + dt * dt * 12.0)
        position += speed * dt
        world.step(dt)
        let force = axis.multiply(12.0 * (0.75 - position) - 12.0 * speed)
        assert(Math.abs(joint.position() - position) < 0.00001 && Math.abs(joint.speed() - speed) < 0.00001)
        assert(joint.reaction_force().subtract(force).length() < 0.001)
        assert(joint.reaction_torque().add(radius.cross(force)).length() < 0.001)
        assert(body.angular_velocity().length() < 0.00001)
        position_alignment(joint)
        step++
    }
}

test "slider position clamps its effective target while retaining the requested value" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var joint = world.create_slider_constraint(position_rail(world), position_body(world),
        Physics.SliderConstraint3DSettings() ..minimum_position = -0.2 ..maximum_position = 0.3
        ..motor = Physics.SliderMotor3D.position(5.0, 100.0, 8.0, 8.0))
    position_steps(world, 720)
    assert(joint.motor()!.target_position == 5.0 && Math.abs(joint.position() - 0.3) < 0.0001)
    joint.set_limits(-0.2, 0.1)
    position_steps(world, 720)
    assert(joint.position() <= 0.10001 && Math.abs(joint.speed()) < 0.0001)
    joint.set_motor(Physics.SliderMotor3D.position(-5.0, 100.0, 8.0, 8.0))
    position_steps(world, 720)
    assert(Math.abs(joint.position() + 0.2) < 0.0001 && joint.motor()!.target_position == -5.0)
    joint.set_limits(0.0, 0.0)
    position_steps(world, 120)
    assert(Math.abs(joint.position()) < 0.00001 && Math.abs(joint.speed()) < 0.00001)
}

test "slider position mutations reset observations and preserve velocity and off modes" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = position_body(world)
    var settings = Physics.SliderConstraint3DSettings() ..motor = Physics.SliderMotor3D.position(0.75, 10.0, 8.0, 8.0)
    var joint = world.create_slider_constraint(position_rail(world), body, settings)
    settings.motor = null
    assert(joint.motor()!.target_position == 0.75 && joint.motor()!.stiffness == 8.0 && joint.motor()!.damping == 8.0)
    position_steps(world, 120)
    joint.set_motor(Physics.SliderMotor3D.position(-0.75, 10.0, 8.0, 8.0))
    assert(joint.motor_force() == 0.0 && joint.reaction_force().length() == 0.0 && body.is_awake())
    body.set_mass_properties(Physics.MassProperties3D(4.0, Math.Vec3(0.4)))
    let previous = joint.speed()
    let position = joint.position()
    let dt = 1.0 / 120.0
    let unconstrained = (4.0 * previous + dt * 8.0 * (-0.75 - position)) / (4.0 + 8.0 * dt + 8.0 * dt * dt)
    let force = Math.clamp(4.0 * (unconstrained - previous) / dt, -10.0, 10.0)
    let expected = previous + force * dt / 4.0
    world.step(dt)
    assert(Math.abs(joint.speed() - expected) < 0.00001)
    joint.set_motor(Physics.SliderMotor3D(0.4, 10.0))
    assert(joint.motor()!.target_position == null)
    position_steps(world, 120)
    assert(Math.abs(joint.speed() - 0.4) < 0.00001)
    joint.set_motor(null)
    position_steps(world, 120)
    assert(joint.motor_force() == 0.0 && Math.abs(joint.speed() - 0.4) < 0.00001)
    joint.set_motor(Physics.SliderMotor3D.position(-0.75, 0.0, 8.0, 8.0))
    position_steps(world, 120)
    assert(joint.motor_force() == 0.0 && Math.abs(joint.speed() - 0.4) < 0.00001)
    joint.set_frames(Physics.Transform3D(), Physics.Transform3D())
    assert(joint.motor_force() == 0.0)
}

test "slider position wakes a sleeping carriage and suspends with either participant" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = position_body(world)
    body.set_sleep_enabled(true)
    var joint = world.create_slider_constraint(position_rail(world), body)
    position_steps(world, 480)
    assert(!body.is_awake())
    joint.set_motor(Physics.SliderMotor3D.position(0.75, 10.0, 8.0, 8.0))
    assert(body.is_awake())
    joint.set_enabled(false)
    position_steps(world, 20)
    assert(joint.motor_force() == 0.0 && joint.speed() == 0.0)
    joint.set_enabled(true)
    world.step(1.0 / 120.0)
    assert(joint.motor_force() > 0.0)
    body.set_enabled(false)
    world.step(1.0 / 120.0)
    assert(joint.motor_force() == 0.0)
    body.set_enabled(true)
    world.step(1.0 / 120.0)
    assert(joint.motor_force() > 0.0 && body.is_awake())
    position_steps(world, 720)
    assert(body.is_awake() && Math.abs(joint.position() - 0.75) < 0.0001)
}

test "slider position is relative to a translating kinematic rail" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var rail = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.kinematic)
    var body = position_body(world)
    var joint = world.create_slider_constraint(rail, body, Physics.SliderConstraint3DSettings()
        ..motor = Physics.SliderMotor3D.position(0.75, 10.0, 8.0, 8.0))
    rail.move_kinematic(Physics.Transform3D(Math.Vec3(1.2, 0.0, 0.0)), 3.0)
    position_steps(world, 360)
    assert(Math.abs(rail.position().x - 1.2) < 0.00001)
    assert(Math.abs(joint.position() - 0.75) < 0.02 && Math.abs(body.linear_velocity().x - 0.4) < 0.02)
    position_alignment(joint)
}


test "slider undamped position conserves its oscillatory response with implicit energy decay" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var joint = world.create_slider_constraint(position_rail(world), position_body(world),
        Physics.SliderConstraint3DSettings() ..motor = Physics.SliderMotor3D.position(0.75, 100.0, 8.0, 0.0))
    var energy = 4.0 * 0.75 * 0.75
    var peak = 0.0
    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        let error = joint.position() - 0.75
        let speed = joint.speed()
        let next_energy = speed * speed + 4.0 * error * error
        assert(next_energy <= energy + 0.00001)
        energy = next_energy
        assert(Math.abs(joint.motor_force() + 8.0 * error) < 0.0001)
        peak = Math.max(peak, joint.position())
        position_alignment(joint)
        step++
    }
    assert(peak > 1.4 && energy > 2.0)
}
