use GFX.Physics
use STD.Math

func run_spatial_rail(mode:int,mass_id:int,rate:int,side:int) {
    let mass=(mass_id+1) as float;let sign=side as float;let delta=1.0/rate as float
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3(0.0,-9.81,0.0))
    let disabled=Physics.CollisionFilter3D(mask_bits:0)
    var pivot=world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type=Physics.BodyType3D.fixed ..collision_filter=disabled)
    var arm=world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform=Physics.Transform3D(Math.Vec3(0.5,0.0,0.0))
        ..mass_properties=Physics.MassProperties3D(2.0,Math.Vec3(0.4))
        ..allow_sleep=false ..collision_filter=disabled)
    if mode==1 {
        world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=Physics.Shape3D.plane(Physics.Plane3D(Math.Vec3(0.0,1.0,0.0),-0.22))
            ..friction=0.0 ..restitution=0.0)
    }
    var payload=world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape=Physics.Shape3D.sphere(Physics.Sphere3D(0.15))
        ..transform=Physics.Transform3D(Math.Vec3(1.0,0.0,0.8*sign))
        ..mass_properties=Physics.MassProperties3D(mass,Math.Vec3(0.2))
        ..allow_sleep=false ..friction=0.0 ..restitution=0.0)
    var first=world.create_hinge_constraint(pivot,arm,Physics.HingeConstraint3DSettings()
        ..second_local_anchor=Math.Vec3(-0.5,0.0,0.0) ..motor=Physics.HingeMotor3D(0.0,60.0))
    let target= -0.2
    var second=world.create_slider_constraint(arm,payload,Physics.SliderConstraint3DSettings()
        ..first_local_frame=Physics.Transform3D(Math.Vec3(0.5,0.0,0.8*sign),Math.Quat.angle_axis(Math.pi()/2.0,Math.Vec3(0.0,0.0,1.0)))
        ..second_local_frame=Physics.Transform3D(Math.Vec3(),Math.Quat.angle_axis(Math.pi()/2.0,Math.Vec3(0.0,0.0,1.0)))
        ..motor=Physics.SliderMotor3D(target,40.0))
    var contacts:Physics.Contact3D[]=[]
    var points:Physics.ContactPoint3D[]=[]
    var peak=0.0;var lowest=0.0;var fastest=0.0;var slowest=0.0;var cumulative=Math.Vec3()
    var step=1
    while step<=rate*2 {
        if step==rate*2/3+1 { second.set_motor(Physics.SliderMotor3D(0.2,40.0)) }
        if step==rate*4/3+1 { second.set_motor(Physics.SliderMotor3D(0.0,40.0)) }
        let bp1=copy arm.position();let bv1=copy arm.linear_velocity();let bw1=copy arm.angular_velocity();let bq1=copy arm.transform().rotation
        let bp2=copy payload.position();let bv2=copy payload.linear_velocity();let bw2=copy payload.angular_velocity();let bq2=copy payload.transform().rotation
        world.step(delta);world.write_contacts(contacts)
        var impulse=Math.Vec3();var point=Math.Vec3();var lever=Math.Vec3()
        for contact in contacts {
            assert(contact.first_body().same_body(payload) || contact.second_body().same_body(payload))
            contact.write_points(points);assert(points.count()==1 && contacts.count()==1)
            point=points[0].position
            lever=Math.Vec3(0.0,-0.15-0.5*contact.separation(),0.0)
            var applied=contact.normal().multiply(contact.normal_impulse()).add(contact.tangent_impulse())
            if contact.first_body().same_body(payload) { applied=applied.negated() }
            impulse=impulse.add(applied)
        }
        let p1=arm.position();let v1=arm.linear_velocity();let w1=arm.angular_velocity();let q1=arm.transform().rotation
        let p2=payload.position();let v2=payload.linear_velocity();let w2=payload.angular_velocity();let q2=payload.transform().rotation
        let f1=first.reaction_force();let t1=first.reaction_torque();let f2=second.reaction_force();let t2=second.reaction_torque()
        let penetration=Math.max(0.0,-0.07-p2.y)
        let g1=Math.Vec3(0.0,-19.62,0.0);let g2=Math.Vec3(0.0,-mass*9.81,0.0)
        assert(v1.subtract(bv1).multiply(2.0).subtract(f1.subtract(f2).add(g1).multiply(delta)).length()<0.00001)
        assert(v2.subtract(bv2).multiply(mass).subtract(f2.add(g2).multiply(delta)).subtract(impulse).length()<0.00001)
        let r1=bq1.rotate(Math.Vec3(-0.5,0.0,0.0));let r12=bp2.subtract(bp1)
        let arm_spin=t1.subtract(t2).add(r1.cross(f1)).subtract(r12.cross(f2)).multiply(delta)
        assert(w1.subtract(bw1).multiply(0.4).subtract(arm_spin).length()<0.001)
        assert(w2.subtract(bw2).multiply(0.2).subtract(t2.multiply(delta)).subtract(lever.cross(impulse)).length()<0.001)
        let before=bp1.cross(bv1.multiply(2.0)).add(bw1.multiply(0.4)).add(bp2.cross(bv2.multiply(mass))).add(bw2.multiply(0.2))
        let after=p1.cross(v1.multiply(2.0)).add(w1.multiply(0.4)).add(p2.cross(v2.multiply(mass))).add(w2.multiply(0.2))
        let external=t1.add(bp1.cross(g1)).add(bp2.cross(g2)).multiply(delta).add(point.cross(impulse))
        let residual=after.subtract(before).subtract(external);cumulative=cumulative.add(residual)
        assert(residual.length()<0.003 && cumulative.length()<0.03)
        assert(first.anchor_error().length()<0.005 && first.axis_error()<0.005)
        assert(second.anchor_error().length()<0.005 && second.angular_error().length()<0.005)
        assert(Math.abs(first.angle())<0.02 && Math.abs(first.motor_torque())<=60.0001 && Math.abs(second.motor_force())<=40.0001)
        assert(Math.abs(f2.dot(bq1.rotate(Math.Vec3(0.0,1.0,0.0)))-second.motor_force())<0.02)
        if mode==1 { assert(penetration<0.003) } else { assert(contacts.is_empty()) }
        peak=Math.max(peak,impulse.y);lowest=Math.min(lowest,second.position())
        fastest=Math.max(fastest,second.speed());slowest=Math.min(slowest,second.speed())
        step++
    }
    var expected_depth=2.0/15.0
    if mode==1 { expected_depth=0.07 }
    assert(Math.abs(lowest+expected_depth)<0.005 && fastest>0.15 && slowest< -0.15)
    assert(contacts.is_empty() && payload.linear_velocity().length()<0.005 && arm.linear_velocity().length()<0.005)
    assert(payload.angular_velocity().length()<0.005 && arm.angular_velocity().length()<0.005)
    let gravity1=Math.Vec3(0.0,-19.62,0.0);let gravity2=Math.Vec3(0.0,-mass*9.81,0.0)
    assert(first.reaction_force().add(gravity1).add(gravity2).length()<0.05)
    assert(second.reaction_force().add(gravity2).length()<0.05 && second.reaction_torque().length()<0.05)
    let expected=arm.position().cross(gravity1).add(payload.position().cross(gravity2)).negated()
    assert(first.reaction_torque().subtract(expected).length()<0.05)
    if mode==1 { assert(peak>0.1) }

}

func exercise_spatial_rail(mode:int) {
    let masses:int[]=[0,1];let rates:int[]=[60,120];let sides:int[]=[-1,1]
    for mass in masses { for rate in rates { for side in sides { run_spatial_rail(mode,mass,rate,side) } } }
}
test "spatial hinge and vertical slider transfer off-plane gravity and independent reaction moments" {
    exercise_spatial_rail(0)
}
test "spatial mixed chain composes floor impulses and releases after reversing the carriage" {
    exercise_spatial_rail(1)
}
