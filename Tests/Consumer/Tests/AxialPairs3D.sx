use GFX.Physics
use STD.Math
func hull() Physics.Shape3D {
    var vertices:Math.Vec3[] = []
    var i = 0
    while i < 8 {
        var x = -0.5; var y = -0.5; var z = -0.5
        if i % 2 == 1 { x = 0.5 }
        if (i / 2) % 2 == 1 { y = 0.5 }
        if i / 4 == 1 { z = 0.5 }
        vertices.append(Math.Vec3(x, y, z)); i++
    }
    return Physics.Shape3D.convex(Physics.ConvexHull3D(vertices))
}
func pair_cases() {
    var shapes:Physics.Shape3D[] = [Physics.Shape3D.cylinder(Physics.Cylinder3D()),
        Physics.Shape3D.tapered_cylinder(Physics.TaperedCylinder3D()),
        Physics.Shape3D.tapered_capsule(Physics.TaperedCapsule3D()),
        Physics.Shape3D.box(Physics.Box3D()), Physics.Shape3D.capsule(Physics.Capsule3D()), hull(),
        Physics.Shape3D.triangle(Physics.Triangle3D(Math.Vec3(-2.0, 0.0, -2.0), Math.Vec3(0.0, 0.0, 2.0), Math.Vec3(2.0, 0.0, -2.0)))]
    var i = 0
    for a in shapes {
        var j = 0
        for b in shapes {
            if i < 3 || j < 3 {
                var k = 0
                while k < 31 {
                    let t = k as float
                    let pose = Physics.Transform3D(Math.Vec3(Math.sin(t * 1.73) * 1.4, Math.cos(t * 0.47) * 1.1, Math.sin(t * 0.79) * 0.7), Math.Quat.angle_axis(t * 0.19, Math.Vec3(1.0, 2.0, 3.0).normalized()))
                    let first = Physics.ShapePlacement3D(a, pose); let second = Physics.ShapePlacement3D(b)
                    let distance = Physics.Geometry3D.distance(first, second)
                    let reverse = Physics.Geometry3D.distance(second, first)
                    assert(Math.abs(distance.separation - reverse.separation) < 0.0001)
                    assert(Math.abs(distance.normal.length() - 1.0) < 0.0001)
                    let probe = Physics.Shape3D.sphere(Physics.Sphere3D(0.00001))
                    let surface_a = Physics.Geometry3D.distance(Physics.ShapePlacement3D(probe, Physics.Transform3D(distance.first_point)), first)
                    let surface_b = Physics.Geometry3D.distance(Physics.ShapePlacement3D(probe, Physics.Transform3D(distance.second_point)), second)
                    assert(Math.abs(surface_a.separation + 0.00001) < 0.0001)
                    assert(Math.abs(surface_b.separation + 0.00001) < 0.0001)
                    let difference = distance.second_point.subtract(distance.first_point)
                    assert(difference.subtract(distance.normal.multiply(distance.separation)).length() < 0.0001)
                    k++
                }
            }
            j++
        }
        i++
    }
}

func main() { pair_cases(); degenerate_cases(); tangent_cases(); print("Axial pairs: 1023 cases passed") }
test "axial convex pairs preserve signed distance, both surface witnesses and inversion under independent rotations" { pair_cases() }

func degenerate_cases() {
    let cylinder = Physics.Shape3D.cylinder(Physics.Cylinder3D())
    let face = Physics.ShapePlacement3D(Physics.Shape3D.triangle(Physics.Triangle3D(Math.Vec3(-2.0, 0.0, 0.0), Math.Vec3(-2.0, 0.0, 2.0), Math.Vec3(0.0, 0.0, 0.0))))
    let rotation = Math.Quat(-0.0000000032226875, -0.000000028379935, -0.0000000014003129, 1.0)
    let distance = Physics.Geometry3D.distance(Physics.ShapePlacement3D(cylinder, Physics.Transform3D(Math.Vec3(0.0, 0.497275, 0.0), rotation)), face)
    assert(Math.abs(distance.separation + 0.002725) < 0.00002)
    assert(distance.normal.nearly_equal(Math.Vec3.down(), 0.002))
    let axial = Physics.Shape3D.tapered_capsule(Physics.TaperedCapsule3D())
    let first = Physics.ShapePlacement3D(axial, Physics.Transform3D(Math.Vec3(0.0, 1.1, 0.0)))
    // The Minkowski support is piecewise affine in cos(theta). Checking its
    // endpoints and cap-switch values gives the exact inradius: 0.65 / 0.9.
    let same = Physics.Geometry3D.distance(first, Physics.ShapePlacement3D(axial))
    let capsule = Physics.Geometry3D.distance(first, Physics.ShapePlacement3D(Physics.Shape3D.capsule(Physics.Capsule3D())))
    assert(Math.abs(same.separation + 0.65) < 0.00001)
    assert(Math.abs(capsule.separation + 0.9) < 0.00001)
}
test "near planar tangency at a mesh vertex converges and coaxial penetrations keep their analytic depth" { degenerate_cases() }

func tangent_cases() {
    var shapes:Physics.Shape3D[] = [Physics.Shape3D.cylinder(Physics.Cylinder3D()), Physics.Shape3D.tapered_cylinder(Physics.TaperedCylinder3D()), Physics.Shape3D.tapered_capsule(Physics.TaperedCapsule3D())]
    var index = 0
    for shape in shapes {
        var angle = 0
        while angle < 8 {
            let pose = Physics.Transform3D(Math.Vec3(4.0, 2.0, -3.0), Math.Quat.angle_axis(angle as float * 0.37, Math.Vec3(1.0, 2.0, 3.0).normalized()))
            var y = 1.0; if index == 2 { y = 1.5 }
            let first = Physics.ShapePlacement3D(shape, Physics.Transform3D(pose.point(Math.Vec3(0.0, y, 0.0)), pose.rotation))
            let second = Physics.ShapePlacement3D(Physics.Shape3D.box(Physics.Box3D()), pose)
            let distance = Physics.Geometry3D.distance(first, second)
            print("tangent=$(index),$(angle) gap=$(distance.separation) normal length=$(distance.normal.length())")
            assert(Math.abs(distance.separation) < 0.00001)
            assert(Math.abs(distance.normal.length() - 1.0) < 0.0001)
            angle++
        }
        index++
    }
}
test "axial cap tangencies retain unit distance normals under rotated common poses" { tangent_cases() }
