use GFX.Physics
use STD.Math

func verify_created_contacts() {
    for plane in [true,false] { for mode in [0,1,2,3] {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3() ..position_iterations=32)
        var floor_settings=Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..collision_filter=Physics.CollisionFilter3D(category_bits:2,mask_bits:1)
        if !plane {
            floor_settings.shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(20.0,2.0,20.0)))
            floor_settings.transform=Physics.Transform3D(Math.Vec3(0.0,-1.0,0.0))
        }
        if mode==1 { floor_settings.is_sensor=true }
        if mode==2 { floor_settings.collision_filter=Physics.CollisionFilter3D(category_bits:2,mask_bits:0) }
        var floor=world.create_rigid_body(floor_settings)
        if mode==3 { floor.set_enabled(false) }
        var parent=world.create_rigid_body(Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.sphere(Physics.Sphere3D(0.05))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,0.6,0.0)) ..mass_properties=Physics.MassProperties3D(3.0,Math.Vec3(0.2))
            ..collision_filter=Physics.CollisionFilter3D(category_bits:1,mask_bits:2) ..allow_sleep=false)
        var child=world.create_rigid_body(Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.4,0.1,0.8)))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,0.1,0.4)) ..collision_filter=Physics.CollisionFilter3D(category_bits:1,mask_bits:2) ..allow_sleep=false)
        var joint=world.create_swing_twist_constraint(parent,child,Physics.SwingTwistConstraint3DSettings()
            ..first_local_frame=Physics.Transform3D(Math.Vec3(0.0,-0.5,0.0)) ..second_local_frame=Physics.Transform3D(Math.Vec3(0.0,0.0,-0.4))
            ..minimum_twist=0.5 ..maximum_twist=0.8)
        let initial=Physics.Geometry3D.distance(Physics.ShapePlacement3D(child.shape(),child.transform()),Physics.ShapePlacement3D(floor.shape(),floor.transform()))
        assert(initial.separation>0.049 && initial.separation<0.051)
        world.step(1.0/60.0)
        let gap=Physics.Geometry3D.distance(Physics.ShapePlacement3D(child.shape(),child.transform()),Physics.ShapePlacement3D(floor.shape(),floor.transform()))
        if mode==0 { assert(gap.separation> -0.001 && gap.separation<0.01) }
        else { assert(gap.separation< -0.1) }
        // These are pose projections after detection, not retroactive impacts.
        assert(world.contact_count()==0)
        assert(child.linear_velocity().length()<0.0001 && child.angular_velocity().length()<0.0001)
    } }
}
test "position projection detects a newly created floor pair and respects sensors filters and disabled supports" { verify_created_contacts() }
func main() { verify_created_contacts();print("Projection-created contacts: plane, finite box, sensors, filters, disabled support and no retroactive impact verified") }
