use GFX.Physics
use STD.Math

func ground(world:Physics.World3D) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(10.0, 1.0, 10.0))))
}

func box_at(world:Physics.World3D, height:float) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, height, 0.0)))
}

func advance(world:Physics.World3D, steps:int) {
    var index = 0
    while index < steps {
        world.step(1.0 / 60.0)
        index++
    }
}

test "a resting stack sleeps together without losing its contacts" {
    var world = Physics.World3D()
    ground(world)
    var lower = box_at(world, 1.0)
    var upper = box_at(world, 2.0)
    advance(world, 120)
    assert(!lower.is_awake() && !upper.is_awake())
    let lower_pose = lower.transform()
    let upper_pose = upper.transform()
    advance(world, 120)
    assert(!lower.is_awake() && !upper.is_awake())
    assert(lower.position().nearly_equal(lower_pose.position, 0.000001))
    assert(upper.position().nearly_equal(upper_pose.position, 0.000001))
    assert(world.contact_count() == 2)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts[0].point_count() == 4 && contacts[1].point_count() == 4)
    assert(contacts[0].normal_impulse() == 0.0)
    assert(contacts[1].normal_impulse() == 0.0)
}

test "a command wakes the contacted island and a removed support releases it" {
    var world = Physics.World3D()
    var floor = ground(world)
    var lower = box_at(world, 1.0)
    var upper = box_at(world, 2.0)
    advance(world, 120)
    assert(!lower.is_awake() && !upper.is_awake())
    upper.apply_impulse(Math.Vec3(0.0, 0.01, 0.0))
    assert(upper.is_awake())
    world.step(1.0 / 60.0)
    assert(lower.is_awake() && upper.is_awake())
    advance(world, 120)
    assert(!lower.is_awake() && !upper.is_awake())
    world.destroy_rigid_body(floor)
    assert(lower.is_awake())
    let before = lower.position().y
    world.step(1.0 / 60.0)
    assert(upper.is_awake())
    assert(lower.position().y < before)
}

test "new collision wakes a sleeping free body" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var sleeper = world.create_rigid_body()
    advance(world, 60)
    assert(!sleeper.is_awake())
    var striker = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(1.1, 0.0, 0.0))
        ..linear_velocity = Math.Vec3(-2.0, 0.0, 0.0))
    world.step(0.1)
    assert(world.contact_count() == 1)
    assert(sleeper.is_awake() && striker.is_awake())
}

test "unsupported slow motion and disabled sleep remain awake" {
    var slow = Physics.World3D(Physics.World3DSettings()
        ..gravity = Math.Vec3(0.0, -0.00001, 0.0))
    var falling = slow.create_rigid_body()
    advance(slow, 120)
    assert(falling.is_awake())
    var disabled = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = disabled.create_rigid_body(Physics.RigidBody3DSettings()
        ..allow_sleep = false)
    advance(disabled, 120)
    assert(body.is_awake())
    body.set_sleep_enabled(true)
    advance(disabled, 60)
    assert(!body.is_awake())
    body.wake_up()
    assert(body.is_awake())
    disabled.step(0.0)
    assert(body.is_awake())
    body.set_sleep_threshold(0.01)
    assert(body.sleep_threshold() == 0.01)
}

test "mass change and an independent world preserve separate wake states" {
    var first_world = Physics.World3D(Physics.World3DSettings()
        ..gravity = Math.Vec3())
    var second_world = Physics.World3D(Physics.World3DSettings()
        ..gravity = Math.Vec3())
    var first = first_world.create_rigid_body()
    var second = second_world.create_rigid_body()
    advance(first_world, 60)
    advance(second_world, 60)
    assert(!first.is_awake() && !second.is_awake())
    first.set_mass_properties(Physics.MassProperties3D(
        2.0, Math.Vec3(0.8)
    ))
    assert(first.is_awake() && !second.is_awake())
    first_world.step(0.0)
    assert(first.is_awake() && !second.is_awake())
}

test "weak and strong impulses wake with different subsequent motion" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = world.create_rigid_body()
    advance(world, 60)
    assert(!body.is_awake())
    body.apply_impulse(Math.Vec3(0.000001, 0.0, 0.0))
    assert(body.is_awake())
    world.step(1.0 / 60.0)
    assert(body.linear_velocity().x > 0.0)
    advance(world, 60)
    assert(!body.is_awake())
    let before = body.position().x
    body.apply_impulse(Math.Vec3(1.0, 0.0, 0.0))
    assert(body.is_awake())
    world.step(1.0 / 60.0)
    assert(body.position().x > before + 0.01)
    assert(body.linear_velocity().x > 1.0)
}

test "moving and disabling a fixed support wake its sleeping body" {
    var world = Physics.World3D()
    var floor = ground(world)
    var box = box_at(world, 1.0)
    advance(world, 120)
    assert(!box.is_awake())
    floor.set_transform(Physics.Transform3D(position:Math.Vec3(0.0, -2.0, 0.0)))
    assert(box.is_awake())
    world.step(1.0 / 60.0)
    assert(box.position().y < 1.0)
    floor.set_transform(Physics.Transform3D())
    advance(world, 120)
    assert(!box.is_awake())
    floor.set_enabled(false)
    assert(box.is_awake())
    world.step(1.0 / 60.0)
    assert(world.contact_count() == 0)
}

test "recycled support cannot preserve an old sleeping pair" {
    var world = Physics.World3D()
    var original = ground(world)
    var box = box_at(world, 1.0)
    advance(world, 120)
    assert(!box.is_awake())
    world.destroy_rigid_body(original)
    assert(box.is_awake())
    var replacement = ground(world)
    assert(!original.same_body(replacement))
    world.step(1.0 / 60.0)
    assert(world.contact_count() == 1)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts[0].first_body().same_body(replacement))
    assert(contacts[0].normal_impulse() > 0.0)
    advance(world, 120)
    assert(!box.is_awake())
}
