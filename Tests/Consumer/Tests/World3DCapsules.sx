use GFX.Physics
use STD.Math

func capsule_at(position:Math.Vec3, rotation:Math.Quat = Math.Quat.identity())
    Physics.ShapePlacement3D
{
    return Physics.ShapePlacement3D(
        Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5)),
        Physics.Transform3D(position:position, rotation:rotation)
    )
}

test "capsule distances retain pair symmetry and analytical gaps" {
    let capsule = capsule_at(Math.Vec3())
    let sphere = Physics.ShapePlacement3D(
        Physics.Shape3D.sphere(Physics.Sphere3D(0.5)),
        Physics.Transform3D(position:Math.Vec3(2.0, 0.0, 0.0))
    )
    let gap = Physics.Geometry3D.distance(sphere, capsule)
    let reverse = Physics.Geometry3D.distance(capsule, sphere)
    assert(Math.abs(gap.separation - 1.25) < 0.00001)
    assert(Math.abs(reverse.separation - gap.separation) < 0.00001)
    assert(gap.normal.nearly_equal(reverse.normal.negated(), 0.00001))
    let second = capsule_at(Math.Vec3(1.5, 0.0, 0.0))
    assert(Math.abs(Physics.Geometry3D.distance(capsule, second).separation - 1.0)
        < 0.00001)
}

test "rotated capsule and box match an analytical side contact" {
    let box = Physics.ShapePlacement3D(
        Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.0)))
    )
    let rotation = Math.Quat.angle_axis(Math.pi() / 6.0, Math.Vec3.back())
    for center_mm in [1600, 1500, 1400] {
        let capsule = capsule_at(
            Math.Vec3(center_mm as float / 1000.0, 0.0, 0.0), rotation
        )
        let result = Physics.Geometry3D.distance(capsule, box)
        let expected = center_mm as float / 1000.0 - 1.5
        assert(Math.abs(result.separation - expected) < 0.0001)
        assert(Math.abs(result.first_point.x - (1.0 + expected)) < 0.0001)
        assert(Math.abs(result.second_point.x - 1.0) < 0.0001)
        assert(Math.abs(result.first_point.y - 0.4330127) < 0.0001)
        assert(result.normal.nearly_equal(Math.Vec3.left(), 0.0001))
        let reverse = Physics.Geometry3D.distance(box, capsule)
        assert(Math.abs(reverse.separation - result.separation) < 0.0001)
        assert(reverse.normal.nearly_equal(result.normal.negated(), 0.0001))
        assert(Physics.Geometry3D.overlaps(capsule, box) == (expected <= 0.0))
    }
}

test "rays hit the capsule cylinder and axial cap" {
    let capsule = capsule_at(Math.Vec3())
    let side = Physics.Geometry3D.ray_cast(
        Physics.Ray3D(Math.Vec3(2.0, 0.0, 0.0), Math.Vec3(-4.0, 0.0, 0.0)),
        capsule
    )
    assert(side.hit)
    assert(Math.abs(side.fraction - 0.4375) < 0.00001)
    assert(side.normal.nearly_equal(Math.Vec3.right(), 0.00001))
    let cap = Physics.Geometry3D.ray_cast(
        Physics.Ray3D(Math.Vec3(0.0, 2.0, 0.0), Math.Vec3(0.0, -4.0, 0.0)),
        capsule
    )
    assert(cap.hit)
    assert(Math.abs(cap.fraction - 0.3125) < 0.00001)
    assert(cap.normal.nearly_equal(Math.Vec3.up(), 0.00001))
    let interior = Physics.Geometry3D.ray_cast(
        Physics.Ray3D(Math.Vec3(), Math.Vec3(1.0, 0.0, 0.0)), capsule
    )
    assert(interior.hit)
    assert(Math.abs(interior.fraction - 0.25) < 0.00001)
    let rotated = capsule_at(
        Math.Vec3(), Math.Quat.angle_axis(Math.half_pi(), Math.Vec3.back())
    )
    let rotated_cap = Physics.Geometry3D.ray_cast(
        Physics.Ray3D(Math.Vec3(2.0, 0.0, 0.0), Math.Vec3(-4.0, 0.0, 0.0)),
        rotated
    )
    assert(rotated_cap.hit)
    assert(Math.abs(rotated_cap.fraction - 0.3125) < 0.00001)
}

test "capsule mass and contact support are finite" {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(10.0, 1.0, 10.0))))
    var body = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 1.25, 0.0)))
    assert(body.mass_properties().mass > 0.0)
    assert(Math.abs(body.mass_properties().mass - Math.pi() / 12.0) < 0.00001)
    assert(body.mass_properties().local_inertia.x >
        body.mass_properties().local_inertia.y)
    var step = 0
    while step < 120 {
        world.step(1.0 / 60.0)
        step++
    }
    assert(Math.abs(body.position().y - 1.25) < 0.02)
    assert(world.contact_count() == 1)
    assert(!body.is_awake())
}

test "capsule pairs respond in the world and enclosed capsules leave a box" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var first = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5))
        ..transform = Physics.Transform3D(position:Math.Vec3(-0.25, 0.0, 0.0))
        ..linear_velocity = Math.Vec3(1.0, 0.0, 0.0))
    var second = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.25, 0.0, 0.0))
        ..linear_velocity = Math.Vec3(-1.0, 0.0, 0.0))
    world.step(0.05)
    assert(world.contact_count() == 1)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts[0].point_count() == 2)
    assert(first.linear_velocity().x > -0.1 && first.linear_velocity().x < 0.1)
    assert(second.linear_velocity().x > -0.1 && second.linear_velocity().x < 0.1)

    var enclosure = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var capsule = enclosure.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5)))
    enclosure.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.0))))
    enclosure.step(0.01)
    assert(enclosure.contact_count() == 1)
    // The shortest exit is sideways for this tall capsule, not toward a cap.
    assert(capsule.position().x > 1.2)
    let recovered = Physics.Geometry3D.distance(
        Physics.ShapePlacement3D(capsule.shape(), capsule.transform()),
        Physics.ShapePlacement3D(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.0)))))
    assert(recovered.separation > -0.01)
}

test "a sphere collides with a capsule without a false distant pair" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var capsule = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5)))
    var sphere = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(0.75, 0.0, 0.0))
        ..linear_velocity = Math.Vec3(-1.0, 0.0, 0.0))
    world.step(0.1)
    assert(world.contact_count() == 1)
    assert(sphere.linear_velocity().x > -0.1)
    assert(capsule.position().nearly_equal(Math.Vec3(), 0.00001))
    sphere.set_transform(Physics.Transform3D(position:Math.Vec3(10.0, 0.0, 0.0)))
    world.step(0.01)
    assert(world.contact_count() == 0)
}

test "parallel capsules keep two lateral points while resting" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5)))
    var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.5, 0.0, 0.0)))
    var step = 0
    while step < 60 {
        world.step(1.0 / 60.0)
        step++
    }
    assert(world.contact_count() == 1)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts[0].point_count() == 2)
    assert(!moving.is_awake())
}
