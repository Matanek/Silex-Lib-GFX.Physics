test "discard dynamic step deltas when a connected body becomes fixed" {
    var family=0
    while family<4 {
        var world=Physics.World2D(gravity:Math.Vec2())
        var first=world.create_rigid_body(Physics.RigidBody2DSettings()
            ..create_implicit_collider=false ..angular_velocity=2.0 ..allow_sleep=false)
        first.set_mass_properties(Physics.MassProperties2D(1.0,1.0))
        world.step(1.0/60.0,4)
        first.set_angular_velocity(0.0)
        first.set_velocity(Math.Vec2())
        first.set_body_type(Physics.BodyType2D.fixed)
        var second=world.create_rigid_body(Physics.RigidBody2DSettings()
            ..create_implicit_collider=false ..allow_sleep=false)
        second.set_mass_properties(Physics.MassProperties2D(1.0,1.0))
        if family==0 { world.create_prismatic_joint(first,second,Physics.PrismaticJoint2DSettings() ..anchor=Math.Vec2(0.2,0.3)) }
        if family==1 { world.create_revolute_joint(first,second,Physics.RevoluteJoint2DSettings() ..anchor=Math.Vec2(0.2,0.3)) }
        if family==2 { world.create_weld_joint(first,second,Physics.WeldJoint2DSettings() ..anchor=Math.Vec2(0.2,0.3)) }
        if family==3 { world.create_wheel_joint(first,second,Physics.WheelJoint2DSettings() ..anchor=Math.Vec2(0.2,0.3) ..spring_enabled=false) }
        world.step(1.0/60.0,4)
        assert(second.position().nearly_equal(Math.Vec2(),0.00001))
        assert(Math.abs(second.rotation())<0.00001)
        family++
    }
}
