use GFX.Physics
use STD.Math

test "configure prismatic constraint tuning independently and wake sleeping bodies" {
    let defaults=Physics.PrismaticJoint2DSettings()
    assert(defaults.constraint_hertz==60.0)
    assert(defaults.constraint_damping_ratio==2.0)
    var world=Physics.World2D(gravity:Math.Vec2())
    var fixed=world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type=Physics.BodyType2D.fixed ..create_implicit_collider=false)
    var body=world.create_rigid_body(Physics.RigidBody2DSettings()
        ..create_implicit_collider=false)
    var joint=world.create_prismatic_joint(fixed,body,Physics.PrismaticJoint2DSettings()
        ..constraint_hertz=7.0 ..constraint_damping_ratio=3.0)
    assert(joint.constraint_hertz()==7.0)
    assert(joint.constraint_damping_ratio()==3.0)
    joint.set_spring(true,5.0,0.8)
    joint.set_limits(true,-0.5,0.5)
    joint.set_motor(1.5,3.0)
    joint.set_constraint_tuning(11.0,4.0)
    assert(joint.spring_enabled())
    assert(joint.spring_hertz()==5.0)
    assert(joint.spring_damping_ratio()==0.8)
    assert(joint.limits_enabled())
    assert(joint.motor_enabled())
    assert(joint.motor_speed()==1.5)
    joint.set_spring(false,0.0,0.0)
    joint.set_limits(false,-0.5,0.5)
    joint.set_motor_enabled(false)
    assert(joint.constraint_hertz()==11.0)
    assert(joint.constraint_damping_ratio()==4.0)
    var step=0
    while step<120 { world.step(1.0/60.0,4); step++ }
    assert(!body.is_awake())
    joint.set_constraint_tuning(0.0,0.0)
    assert(body.is_awake())
    assert(joint.constraint_hertz()==0.0)
    assert(joint.constraint_damping_ratio()==0.0)
}

