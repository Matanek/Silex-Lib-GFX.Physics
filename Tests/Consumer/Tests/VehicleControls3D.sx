use GFX.Physics
use STD.Math

func car(world:Physics.World3D, speed:float=3.0, brake:float=1500.0, handbrake:float=0.0, tire:bool=true, height:float=0.875475) Physics.WheeledVehicle3D {
    var wheels:Physics.Wheel3DSettings[]=[];let sides:int[]=[-1,1]
    for x in sides { for z in sides {
        var rubber:Physics.Tire3DSettings?=null;if tire { rubber=Physics.Tire3DSettings(angular_damping:0.0) }
        var steer=0.0;var hand=handbrake;if z==1 { steer=0.5;hand=0.0 }
        wheels.append(Physics.Wheel3DSettings(Math.Vec3(0.6*x as float,0.0,z as float),tire:rubber,
            maximum_steering_angle:steer,maximum_brake_torque:brake,maximum_handbrake_torque:hand))
    } }
    var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,height,0.0)) ..linear_velocity=Math.Vec3(0.0,0.0,speed)
            ..allow_sleep=false ..linear_damping=0.0 ..angular_damping=0.0,wheels))
    if tire { for i in [0,1,2,3] { vehicle.set_wheel_angular_velocity(i,speed/0.3) } }
    return vehicle
}
func floor(world:Physics.World3D, friction:float=1.0) {
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=friction)
}

test "service braking consumes wheel torque and bounds contact forces in either travel direction" {
    let signs:float[]=[-1.0,1.0];let torques:float[]=[1.5,1500.0]
    for rate in [60,120] { for sign in signs { for torque in torques {
        var world=Physics.World3D();floor(world);var vehicle=car(world,3.0*sign,torque)
        vehicle.set_controls(brake:1.0);var step=0
        while step<rate*3 {
            var before:float[]=[];for i in [0,1,2,3] { before.append(vehicle.wheel(i).angular_velocity) }
            world.step(1.0/rate as float)
            for i in [0,1,2,3] {
                var wheel=vehicle.wheel(i)
                assert(Math.abs(wheel.brake_torque)<=torque+0.01)
                assert(Math.abs(0.9*(wheel.angular_velocity-before[i])+(wheel.longitudinal_force*0.3-wheel.brake_torque)/rate as float)<0.001)
            }
            step++
        }
        if torque>100.0 { assert(Math.abs(vehicle.chassis().linear_velocity().z)<0.01) }
        else { assert(sign*vehicle.chassis().linear_velocity().z<2.8 && sign*vehicle.chassis().linear_velocity().z>2.0) }
    } } }
}

test "a locked tire cannot brake the chassis without surface friction and rear handbrakes are selective" {
    var world=Physics.World3D();floor(world,0.0);var vehicle=car(world)
    vehicle.set_controls(brake:1.0);var step=0;while step<240 { world.step(1.0/120.0);step++ }
    assert(Math.abs(vehicle.chassis().linear_velocity().z-3.0)<0.0001)
    for i in [0,1,2,3] { assert(vehicle.wheel(i).angular_velocity==0.0 && vehicle.wheel(i).longitudinal_force==0.0) }
    var flight=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3());var hand=car(flight,3.0,0.0,0.9,height:3.0)
    hand.set_controls(handbrake:1.0);step=0;while step<120 { flight.step(1.0/120.0);step++ }
    for i in [0,2] { assert(Math.abs(hand.wheel(i).angular_velocity-9.0)<0.001 && Math.abs(hand.wheel(i).brake_torque+0.9)<0.001) }
    for i in [1,3] { assert(hand.wheel(i).angular_velocity==10.0 && hand.wheel(i).brake_torque==0.0) }
}

test "braking in flight advances angle before torque and never reverses isolated wheel spin" {
    for rate in [60,120] {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3());var vehicle=car(world,0.0,0.9,height:3.0)
        vehicle.set_wheel_angular_velocity(0,1.0);vehicle.set_wheel_angular_velocity(1,-1.0);vehicle.set_controls(brake:1.0)
        world.step(0.0);assert(vehicle.wheel(0).angular_velocity==1.0 && vehicle.wheel(0).rotation_angle==0.0)
        var step=0;var angle=0.0
        while step<rate*2 {
            let before=vehicle.wheel(0).angular_velocity;angle+=before/rate as float
            world.step(1.0/rate as float)
            assert(vehicle.wheel(0).angular_velocity>=0.0 && vehicle.wheel(1).angular_velocity<=0.0)
            assert(Math.abs(vehicle.wheel(0).rotation_angle-angle)<0.00001)
            step++
        }
        assert(vehicle.wheel(0).angular_velocity==0.0 && vehicle.wheel(1).angular_velocity==0.0)
        assert(Math.abs(angle-(0.5+0.5/rate as float))<0.0001)
    }
}

test "steering is persistent mirrored and respects zero disabled sleep and suspension only wheels" {
    var turns:float[]=[]
    let signs:float[]=[-1.0,1.0]
    for sign in signs {
        var world=Physics.World3D();floor(world);var vehicle=car(world)
        vehicle.set_controls(steering:sign*0.2);world.step(0.0);assert(vehicle.wheel(1).steering_angle==0.0)
        var step=0;while step<240 { world.step(1.0/120.0);step++ }
        assert(Math.abs(vehicle.wheel(1).steering_angle+sign*0.1)<0.00001 && vehicle.wheel(0).steering_angle==0.0)
        assert(sign*vehicle.chassis().position().x< -0.1);turns.append(vehicle.chassis().position().x)
        vehicle.chassis().set_enabled(false);let held=vehicle.wheel(1).steering_angle
        vehicle.set_controls(steering:0.5);world.step(0.1);assert(vehicle.wheel(1).steering_angle==held)
        vehicle.chassis().set_enabled(true);world.step(0.01);assert(Math.abs(vehicle.wheel(1).steering_angle+0.25)<0.00001)
    }
    assert(Math.abs(turns[0]+turns[1])<0.03)
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3());var vehicle=car(world,0.0,tire:false,height:3.0)
    vehicle.set_controls(steering:0.5,brake:1.0);world.step(0.01)
    assert(Math.abs(vehicle.wheel(1).steering_angle+0.25)<0.00001 && vehicle.wheel(1).brake_torque==0.0)
    vehicle.chassis().set_sleep_enabled(true);var step=0;while step<240 { world.step(1.0/120.0);step++ }
    assert(!vehicle.chassis().is_awake());vehicle.set_controls(steering:0.5,brake:1.0);assert(!vehicle.chassis().is_awake())
    vehicle.set_controls();assert(vehicle.chassis().is_awake())
}

test "braked steering tires transfer equal opposite impulses to dynamic supports" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    var platform=world.create_rigid_body(Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(20.0,0.1,20.0)))
        ..mass_properties=Physics.MassProperties3D(200.0,Math.Vec3(500.0)) ..allow_sleep=false ..friction=1.0 ..linear_damping=0.0 ..angular_damping=0.0)
    var vehicle=car(world);vehicle.set_controls(steering:0.2,brake:1.0)
    var response=false;var step=0
    while step<120 {
        world.step(1.0/120.0)
        let first=vehicle.chassis().linear_velocity().multiply(100.0);let second=platform.linear_velocity().multiply(200.0)
        let angular=vehicle.chassis().angular_velocity().multiply(100.0).add(platform.angular_velocity().multiply(500.0))
            .add(vehicle.chassis().world_center_of_mass().cross(first)).add(platform.world_center_of_mass().cross(second))
        assert(first.add(second).subtract(Math.Vec3(0.0,0.0,300.0)).length()<0.01 && angular.subtract(Math.Vec3(262.6425,0.0,0.0)).length()<0.03)
        if platform.linear_velocity().z>0.001 { response=true }
        step++
    }
    assert(response)
    var sibling=car(world,0.0,height:3.0);assert(sibling.wheel(1).steering_angle==0.0 && sibling.wheel(1).brake_torque==0.0)
    world.destroy_wheeled_vehicle(vehicle);assert(!vehicle.is_valid() && sibling.is_valid())
}

test "counter steering axes and combined brake settings are copied and applied" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    let axis=Math.Vec3(0.0,0.8,0.6)
    var wheels:Physics.Wheel3DSettings[]=[Physics.Wheel3DSettings(Math.Vec3(),tire:Physics.Tire3DSettings(angular_damping:0.0),
        maximum_steering_angle:-0.5,steering_axis:axis,maximum_brake_torque:0.4,maximum_handbrake_torque:0.5)]
    var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(Physics.RigidBody3DSettings() ..transform=Physics.Transform3D(Math.Vec3(0.0,3.0,0.0)),wheels))
    wheels[0]=Physics.Wheel3DSettings(Math.Vec3())
    vehicle.set_wheel_angular_velocity(0,10.0);vehicle.set_controls(steering:1.0,brake:1.0,handbrake:1.0);world.step(0.1)
    assert(Math.abs(vehicle.wheel(0).steering_angle-0.5)<0.00001 && Math.abs(vehicle.wheel(0).angular_velocity-9.9)<0.00001)
    assert(Math.abs(vehicle.wheel(0).brake_torque+0.9)<0.0001 && vehicle.wheel_settings(0).steering_axis.nearly_equal(axis,0.00001))
    var supported=Physics.World3D();floor(supported)
    var wheel=Physics.Wheel3DSettings(Math.Vec3(),tire:Physics.Tire3DSettings(),maximum_steering_angle:-0.5,steering_axis:axis)
    var car=supported.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(Physics.RigidBody3DSettings() ..transform=Physics.Transform3D(Math.Vec3(0.0,0.8,0.0)),[wheel]))
    car.set_controls(steering:1.0);supported.step(1.0/120.0)
    let right=Math.Quat.angle_axis(0.5,axis).rotate(Math.Vec3(-1.0,0.0,0.0))
    let expected=Math.Vec3.up().cross(right).normalized()
    assert(car.wheel(0).longitudinal_direction.nearly_equal(expected,0.00001))
}
