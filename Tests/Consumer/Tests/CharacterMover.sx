use GFX.Physics
use STD.Math

func fixed_box(
    world:Physics.World2D,
    position:Math.Vec2,
    size:Math.Vec2,
    rotation:float = 0.0
) Physics.Collider2D {
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..position = position
        ..rotation = rotation
        ..create_implicit_collider = false
    )
    return world.create_collider(body, Physics.Collider2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(size))
    )
}

func mover() Physics.CharacterMover2D {
    return Physics.CharacterMover2D(Physics.CharacterMover2DSettings()
        ..capsule = Physics.Capsule2D(
            Math.Vec2(0.0, -0.4),
            Math.Vec2(0.0, 0.4),
            0.3
        )
    )
}

test "slide along a floor and stop at a wall" {
    var world = Physics.World2D(gravity:Math.Vec2())
    fixed_box(world, Math.Vec2(0.0, -0.25), Math.Vec2(8.0, 0.5))
    fixed_box(world, Math.Vec2(2.25, 1.0), Math.Vec2(0.5, 2.5))
    var character = mover()
    var result = character.calculate_move(
        world,
        Math.Vec2(0.0, 0.7),
        Math.Vec2(4.0, -1.0)
    )
    assert(result.applied_translation.x > 1.4)
    assert(result.applied_translation.x < 1.72)
    assert(result.applied_translation.y > -0.05)
    assert(result.colliders().count() == 2)
    assert(result.planes().count() >= 2)
}

test "slide down a slope without tunneling" {
    var world = Physics.World2D(gravity:Math.Vec2())
    fixed_box(
        world,
        Math.Vec2(),
        Math.Vec2(6.0, 0.4),
        -Math.pi() * 0.15
    )
    var character = mover()
    var result = character.calculate_move(
        world,
        Math.Vec2(-1.5, 2.0),
        Math.Vec2(4.0, -4.0)
    )
    assert(result.colliders().count() == 1)
    assert(result.applied_translation.x > 2.0)
    assert(result.applied_translation.y > -4.0)
}

test "resolve a concave corner with two planes" {
    var world = Physics.World2D(gravity:Math.Vec2())
    fixed_box(world, Math.Vec2(0.0, -0.25), Math.Vec2(5.0, 0.5))
    fixed_box(world, Math.Vec2(2.25, 1.0), Math.Vec2(0.5, 2.5))
    var character = mover()
    var result = character.calculate_move(
        world,
        Math.Vec2(1.3, 1.4),
        Math.Vec2(2.0, -2.0)
    )
    assert(result.colliders().count() == 2)
    assert(result.remaining_translation.length_squared() > 0.1)
}

test "depenetrate an initial overlap" {
    var world = Physics.World2D(gravity:Math.Vec2())
    fixed_box(world, Math.Vec2(0.0, -0.25), Math.Vec2(4.0, 0.5))
    var character = mover()
    var result = character.calculate_move(
        world,
        Math.Vec2(0.0, 0.5),
        Math.Vec2()
    )
    assert(result.started_overlapping)
    assert(result.applied_translation.y > 0.15)
    assert(result.colliders().count() == 1)
}

test "stop at a step and inside a narrow tunnel" {
    var step_world = Physics.World2D(gravity:Math.Vec2())
    fixed_box(step_world, Math.Vec2(1.0, 0.2), Math.Vec2(0.6, 0.4))
    var character = mover()
    var step_result = character.calculate_move(
        step_world,
        Math.Vec2(0.0, 0.7),
        Math.Vec2(2.0, 0.0)
    )
    assert(step_result.applied_translation.x > 0.35)
    assert(step_result.applied_translation.x < 0.45)

    var tunnel_world = Physics.World2D(gravity:Math.Vec2())
    fixed_box(tunnel_world, Math.Vec2(1.5, -0.25), Math.Vec2(3.0, 0.5))
    fixed_box(tunnel_world, Math.Vec2(1.5, 1.25), Math.Vec2(3.0, 0.5))
    var tunnel_result = character.calculate_move(
        tunnel_world,
        Math.Vec2(-0.5, 0.5),
        Math.Vec2(3.0, 0.0)
    )
    assert(tunnel_result.applied_translation.x < 0.25)
    assert(tunnel_result.colliders().count() >= 1)
}

test "follow the current pose of a moving kinematic platform" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var platform = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.kinematic
        ..position = Math.Vec2(0.0, -0.25)
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 0.5)))
    )
    platform.set_velocity(Math.Vec2(0.0, 1.0))
    world.step(0.5)
    var character = mover()
    var result = character.calculate_move(
        world,
        Math.Vec2(0.0, 1.2),
        Math.Vec2(1.0, -1.0)
    )
    assert(result.applied_translation.x > 0.9)
    assert(result.applied_translation.y > -0.05)
    assert(result.colliders().count() == 1)
}

test "expose plane collection and resolution separately" {
    var world = Physics.World2D(gravity:Math.Vec2())
    fixed_box(world, Math.Vec2(0.0, -0.25), Math.Vec2(4.0, 0.5))
    var character = mover()
    var planes:Physics.CharacterCollisionPlane2D[] = []
    character.collect_planes(world, Math.Vec2(0.0, 0.7), planes)
    assert(planes.count() == 1)
    let solved = character.solve_planes(Math.Vec2(1.0, -1.0), planes)
    assert(solved.translation.x > 0.99)
    assert(solved.translation.y > -0.01)
    assert(planes[0].push() > 0.9)
    let clipped = character.clip_vector(Math.Vec2(2.0, -3.0), planes)
    assert(clipped.nearly_equal(Math.Vec2(2.0, 0.0), 0.01))
}

test "respect query filters and sensor policy" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..position = Math.Vec2(1.0, 0.7)
        ..create_implicit_collider = false
    )
    world.create_collider(body, Physics.Collider2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.3, 2.0)))
        ..is_sensor = true
    )
    var character = mover()
    var ignored = character.calculate_move(
        world,
        Math.Vec2(0.0, 0.7),
        Math.Vec2(2.0, 0.0)
    )
    assert(ignored.applied_translation.nearly_equal(Math.Vec2(2.0, 0.0)))

    var including = Physics.CharacterMover2D(
        Physics.CharacterMover2DSettings()
            ..capsule = Physics.Capsule2D(
                Math.Vec2(0.0, -0.4),
                Math.Vec2(0.0, 0.4),
                0.3
            )
            ..include_sensors = true
    )
    var blocked = including.calculate_move(
        world,
        Math.Vec2(0.0, 0.7),
        Math.Vec2(2.0, 0.0)
    )
    assert(blocked.applied_translation.x < 0.9)
}
