use GFX.Physics
use STD.Math

test "slider soft stop and obstacle contact share a step before negative separation" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var rail = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..transform = Physics.Transform3D(Math.Vec3(1.0,0.0,0.0)) ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0,4.0,4.0))))
    var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.25))
        ..mass_properties = Physics.MassProperties3D(2.0,Math.Vec3(0.2)) ..restitution = 0.0 ..allow_sleep = false)
    var joint = world.create_slider_constraint(rail,body,Physics.SliderConstraint3DSettings() ..maximum_position = 0.2
        ..limit_spring = Physics.SliderLimitSpring3D(8.0,8.0) ..motor = Physics.SliderMotor3D(1.0,-0.5,2.0))
    var step = 0;while step<360 { world.step(1.0/120.0);step++ }
    print("soft contact x=$(joint.position()) v=$(joint.speed()) limit=$(joint.limit_force()) motor=$(joint.motor_force()) contacts=$(world.contact_count())")
    assert(Math.abs(joint.position()-0.25)<0.001 && Math.abs(joint.speed())<0.001 && world.contact_count()==1)
    assert(Math.abs(joint.limit_force()+0.4)<0.01 && Math.abs(joint.motor_force()-2.0)<0.001)
    joint.set_motor(Physics.SliderMotor3D(-0.5,-0.5,0.0));step = 0;while step<360 { world.step(1.0/120.0);step++ }
    print("soft separated x=$(joint.position()) v=$(joint.speed()) limit=$(joint.limit_force()) contacts=$(world.contact_count())")
    assert(joint.position()< -0.7 && Math.abs(joint.speed()+0.5)<0.001 && world.contact_count()==0 && joint.limit_force()==0.0)
}
