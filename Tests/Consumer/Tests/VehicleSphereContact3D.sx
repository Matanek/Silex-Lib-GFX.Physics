use GFX.Physics
use STD.Math

func body_settings(position:Math.Vec3) Physics.RigidBody3DSettings {
    return Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.sphere(Physics.Sphere3D(0.01))
        ..transform=Physics.Transform3D(position) ..allow_sleep=false
        ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
        ..linear_damping=0.0 ..angular_damping=0.0 ..friction=0.0
}
func probe(world:Physics.World3D, position:Math.Vec3,
    contact:Physics.WheelContact3D=Physics.WheelContact3D.sphere(0.3)) Physics.WheeledVehicle3D
{
    return world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(body_settings(position),
        [Physics.Wheel3DSettings(Math.Vec3(),contact:contact)]))
}
func box(world:Physics.World3D, size:Math.Vec3, position:Math.Vec3) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.box(Physics.Box3D(size)) ..transform=Physics.Transform3D(position))
}

test "four spherical wheel supports stay symmetric at first landing" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    var ground=box(world,Math.Vec3(20.0,1.0,20.0),Math.Vec3(0.0,-0.5,0.0))
    var wheels:Physics.Wheel3DSettings[]=[];let sides:float[]=[-1.0,1.0]
    for x in sides { for z in sides { wheels.append(Physics.Wheel3DSettings(Math.Vec3(x*0.6,0.0,z),contact:Physics.WheelContact3D.sphere(0.3))) } }
    var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(body_settings(Math.Vec3(0.0,0.88224953,0.0)),wheels))
    world.step(1.0/60.0)
    for i in [0,1,2,3] { assert(vehicle.wheel(i).support()!.same_body(ground)) }
    assert(vehicle.chassis().angular_velocity().length()<0.0001)
}

test "spherical wheel contact finds a box edge missed by its central ray" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    var ground=box(world,Math.Vec3(1.0,0.1,2.0),Math.Vec3(0.0,-0.05,0.0))
    var sphere=probe(world,Math.Vec3(0.7,0.75,0.0))
    world.step(1.0/120.0)
    let wheel=sphere.wheel(0)
    assert(wheel.support()!.same_body(ground))
    assert(Math.abs(wheel.length-(0.75-Math.sqrt(0.05)))<0.00001)
    assert(wheel.contact_point.nearly_equal(Math.Vec3(0.5,0.0,0.0),0.00001))
    assert(wheel.contact_normal.nearly_equal(Math.Vec3(2.0/3.0,Math.sqrt(5.0)/3.0,0.0),0.00001))
    world.destroy_wheeled_vehicle(sphere)
    var ray=probe(world,Math.Vec3(0.7,0.75,0.0),Physics.WheelContact3D.ray)
    world.step(1.0/120.0);assert(ray.wheel(0).support()==null)
}

test "cast radius changes edge reach and steep candidates do not become supports" {
    let radii:float[]=[0.1,0.3]
    for radius in radii {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
        box(world,Math.Vec3(1.0,0.1,2.0),Math.Vec3(0.0,-0.05,0.0))
        var vehicle=probe(world,Math.Vec3(0.7,0.75,0.0),Physics.WheelContact3D.sphere(radius))
        world.step(1.0/120.0);assert((vehicle.wheel(0).support()!=null)==(radius>0.2))
    }
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    box(world,Math.Vec3(1.0,0.1,2.0),Math.Vec3(0.0,-0.05,0.0))
    var ground=box(world,Math.Vec3(5.0,0.1,5.0),Math.Vec3(0.0,-0.2,0.0))
    var vehicle=probe(world,Math.Vec3(0.79,0.6,0.0));world.step(1.0/120.0)
    assert(vehicle.wheel(0).support()!.same_body(ground))
    assert(vehicle.wheel(0).contact_normal.nearly_equal(Math.Vec3.up(),0.00001))
}

test "initial spherical overlap chooses the deeper admissible support" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    box(world,Math.Vec3(3.0,0.1,3.0),Math.Vec3(0.0,-0.05,0.0))
    var deeper=box(world,Math.Vec3(3.0,0.1,3.0),Math.Vec3(0.0,0.05,0.0))
    var vehicle=probe(world,Math.Vec3(0.0,0.2,0.0));world.step(1.0/120.0)
    assert(vehicle.wheel(0).support()!.same_body(deeper))
    assert(vehicle.wheel(0).length==0.0)
    assert(vehicle.wheel(0).contact_point.nearly_equal(Math.Vec3(0.0,0.1,0.0),0.00001))
}

test "spherical supports ignore sensors filters and disabled bodies" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    var ground=box(world,Math.Vec3(5.0,0.1,5.0),Math.Vec3(0.0,-0.05,0.0))
    var sensor=box(world,Math.Vec3(5.0,0.1,5.0),Math.Vec3(0.0,0.1,0.0));sensor.set_sensor(true)
    var excluded=box(world,Math.Vec3(5.0,0.1,5.0),Math.Vec3(0.0,0.2,0.0));excluded.set_collision_filter(Physics.CollisionFilter3D(category_bits:2,mask_bits:0))
    var vehicle=probe(world,Math.Vec3(0.0,0.8,0.0));world.step(1.0/120.0)
    assert(vehicle.wheel(0).support()!.same_body(ground))
    ground.set_enabled(false);world.step(1.0/120.0);assert(vehicle.wheel(0).support()==null)
    vehicle.chassis().set_enabled(false);world.step(1.0/120.0)
    assert(vehicle.wheel(0).normal_force==0.0)
    world.destroy_wheeled_vehicle(vehicle);assert(!vehicle.is_valid())
}

test "spherical suspension exchanges equal opposite impulses with dynamic support" {
    for rate in [60,120] {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
        var platform=world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(5.0,0.1,5.0)))
            ..mass_properties=Physics.MassProperties3D(200.0,Math.Vec3(100.0))
            ..allow_sleep=false ..linear_damping=0.0 ..angular_damping=0.0 ..friction=0.0)
        var config=body_settings(Math.Vec3(0.0,0.75,0.0))
        config.mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0),Math.Vec3(0.2,0.0,0.1))
        var wheels:Physics.Wheel3DSettings[]=[];let sides:float[]=[-1.0,1.0]
        for x in sides { for z in sides { wheels.append(Physics.Wheel3DSettings(Math.Vec3(x*0.6,0.0,z),contact:Physics.WheelContact3D.sphere(0.3))) } }
        var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(config,wheels))
        var step=0
        while step<rate {
            world.step(1.0/rate as float)
            let momentum=platform.linear_velocity().multiply(200.0).add(vehicle.chassis().linear_velocity().multiply(100.0))
            let angular=platform.angular_velocity().multiply(100.0).add(vehicle.chassis().angular_velocity().multiply(100.0))
                .add(platform.world_center_of_mass().cross(platform.linear_velocity().multiply(200.0)))
                .add(vehicle.chassis().world_center_of_mass().cross(vehicle.chassis().linear_velocity().multiply(100.0)))
            assert(momentum.length()<0.002 && angular.length()<0.002)
            step++
        }
        assert(platform.position().y< -0.05 && vehicle.chassis().position().y>0.8)
    }
}
