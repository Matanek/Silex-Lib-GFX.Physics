use GFX.Physics
use STD.Math

func slider_body(world:Physics.World3D, position:Math.Vec3 = Math.Vec3(), mass:float = 2.0,
    rotation:Math.Quat = Math.Quat.identity()) Physics.RigidBody3D
{
    return world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position, rotation)
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.25))
        ..mass_properties = Physics.MassProperties3D(mass, Math.Vec3(mass * 0.1))
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
}
func slider_support(world:Physics.World3D) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
}
func slider_steps(world:Physics.World3D, count:int, delta:float = 1.0 / 60.0) {
    var step = 0
    while step < count { world.step(delta); step++ }
}

test "slider leaves only signed axial translation free at sixty and one hundred twenty hertz" {
    for rate in [60, 120] {
        let dt = 1.0 / rate as float
        var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3(0.3, -9.81, 0.0))
        var body = slider_body(world)
        body.set_linear_velocity(Math.Vec3(-0.5, 2.0, -3.0))
        body.set_angular_velocity(Math.Vec3(1.0, -2.0, 3.0))
        var joint = world.create_slider_constraint(slider_support(world), body)
        assert(joint.minimum_position() == null && joint.maximum_position() == null)
        var position = 0.0
        var speed = -0.5
        var step = 0
        while step < rate * 2 {
            speed += dt * 0.3
            position += dt * speed
            world.step(dt)
            assert(Math.abs(joint.position() - position) < 0.00001)
            assert(Math.abs(joint.speed() - speed) < 0.00001)
            assert(joint.anchor_error().length() < 0.00001 && joint.angular_error().length() < 0.00001)
            assert(Math.abs(joint.reaction_force().x) < 0.00001)
            step++
        }
        assert(Math.abs(joint.reaction_force().y - 19.62) < 0.00001)
        assert(joint.limit_force() == 0.0)
    }
}

test "slider rotating rail projection conserves momentum with unequal masses and inertias" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var first = slider_body(world, mass:2.0)
    var second = slider_body(world, Math.Vec3(2.0, 0.0, 0.0), mass:8.0)
    first.set_angular_velocity(Math.Vec3(0.0, 0.0, 1.0))
    var joint = world.create_slider_constraint(first, second)
    world.step(1.0 / 120.0)
    // I1 / (I1 + I2 + reduced_mass * distance^2).
    let common = 0.2 / 7.4
    print("slider projection omega=$(first.angular_velocity().z)/$(second.angular_velocity().z), y=$(first.linear_velocity().y)/$(second.linear_velocity().y)")
    assert(Math.abs(first.angular_velocity().z - common) < 0.00001)
    assert(Math.abs(second.angular_velocity().z - common) < 0.00001)
    assert(Math.abs(first.linear_velocity().y + 1.6 * common) < 0.00001)
    assert(Math.abs(second.linear_velocity().y - 0.4 * common) < 0.00001)
    assert(first.linear_velocity().multiply(2.0).add(second.linear_velocity().multiply(8.0)).length() < 0.00001)
    let angular = first.angular_velocity().z * 0.2 + second.angular_velocity().z * 0.8 +
        first.position().cross(first.linear_velocity().multiply(2.0)).z +
        second.position().cross(second.linear_velocity().multiply(8.0)).z
    assert(Math.abs(angular - 0.2) < 0.00001)
    assert(joint.anchor_error().length() < 0.00001 && joint.angular_error().length() < 0.00001)
}

test "slider follows a rotating kinematic reference while permitting axial centrifugal motion" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var rail = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.kinematic)
    var body = slider_body(world, Math.Vec3(2.0, 0.0, 0.0))
    var joint = world.create_slider_constraint(rail, body)
    rail.move_kinematic(Physics.Transform3D(Math.Vec3(), Math.Quat.angle_axis(0.4, Math.Vec3(0.0, 0.0, 1.0))), 2.0)
    body.set_linear_velocity(Math.Vec3(0.0, 0.4, 0.0))
    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        assert(joint.anchor_error().length() < 0.0001 && joint.angular_error().length() < 0.0001)
        step++
    }
    print("slider rotating position=$(joint.position()) speed=$(joint.speed())")
    assert(Math.abs(joint.position() - 2.0 * Math.cosh(0.4)) < 0.003)
    assert(Math.abs(joint.speed() - 0.4 * Math.sinh(0.4)) < 0.003)
}

test "slider rotated local frames and off center mass support transverse gravity without axial effort" {
    let orientation = Math.Quat.angle_axis(0.4, Math.Vec3(0.0, 1.0, 0.0))
    var world = Physics.World3D()
    var body = slider_body(world, Math.Vec3(1.0, 0.0, 0.0), rotation:orientation)
    body.set_mass_properties(Physics.MassProperties3D(3.0, Math.Vec3(0.3, 0.6, 0.9), Math.Vec3(0.0, 0.5, 0.0)))
    let settings = Physics.SliderConstraint3DSettings()
        ..first_local_frame = Physics.Transform3D(Math.Vec3(1.0, 0.0, 0.0), orientation)
    var joint = world.create_slider_constraint(slider_support(world), body, settings)
    body.set_linear_velocity(orientation.rotate(Math.Vec3(0.5, 0.0, 0.0)))
    slider_steps(world, 180)
    assert(Math.abs(joint.position() - 1.5) < 0.0001 && Math.abs(joint.speed() - 0.5) < 0.0001)
    assert(joint.anchor_error().length() < 0.0001 && joint.angular_error().length() < 0.0001)
    assert(Math.abs(joint.reaction_force().y - 29.43) < 0.0001)
}

test "slider rigid lower upper equal and one sided limits hold signed loads and mutations clear effort" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3(2.0, 0.0, 0.0))
    var body = slider_body(world)
    var joint = world.create_slider_constraint(slider_support(world), body,
        Physics.SliderConstraint3DSettings() ..minimum_position = -0.5 ..maximum_position = 0.75)
    var step = 0
    while step < 180 {
        world.step(1.0 / 60.0)
        assert(joint.position() >= -0.5001 && joint.position() <= 0.7501)
        assert(joint.anchor_error().length() < 0.0001 && joint.angular_error().length() < 0.0001)
        step++
    }
    assert(Math.abs(joint.position() - 0.75) < 0.0001 && Math.abs(joint.speed()) < 0.0001)
    assert(Math.abs(joint.limit_force() + 4.0) < 0.0001)
    world.set_gravity(Math.Vec3(-2.0, 0.0, 0.0))
    slider_steps(world, 180)
    assert(Math.abs(joint.position() + 0.5) < 0.0001 && Math.abs(joint.limit_force() - 4.0) < 0.0001)
    let previous = joint.reaction_force()
    world.step(0.0); assert(joint.reaction_force() == previous)
    joint.set_limits(0.25, 0.25)
    assert(joint.reaction_force().length() == 0.0 && joint.limit_force() == 0.0)
    slider_steps(world, 90)
    assert(Math.abs(joint.position() - 0.25) < 0.0001 && Math.abs(joint.speed()) < 0.0001)
    joint.set_limits(null, 0.25)
    assert(joint.minimum_position() == null && joint.maximum_position() == 0.25)
    slider_steps(world, 60)
    assert(joint.position() < -0.7 && joint.limit_force() == 0.0)
    joint.set_limits(-0.5, null)
    slider_steps(world, 90)
    assert(Math.abs(joint.position() + 0.5) < 0.0001 && Math.abs(joint.limit_force() - 4.0) < 0.0001)
    joint.set_limits(null, null)
    slider_steps(world, 60); assert(joint.position() < -1.4)
}

test "slider frame replacement moves the rail resets reactions and preserves snapshots" {
    var world = Physics.World3D()
    var body = slider_body(world)
    var settings = Physics.SliderConstraint3DSettings()
    var joint = world.create_slider_constraint(slider_support(world), body, settings)
    settings.minimum_position = 1.0
    slider_steps(world, 30)
    assert(joint.minimum_position() == null && joint.reaction_force().y > 19.0)
    let frame = Physics.Transform3D(Math.Vec3(0.0, 1.0, 0.0), Math.Quat.angle_axis(0.3, Math.Vec3(1.0, 0.0, 0.0)))
    joint.set_frames(frame, Physics.Transform3D())
    assert(joint.reaction_force().length() == 0.0 && joint.reaction_torque().length() == 0.0)
    slider_steps(world, 120)
    assert(joint.first_local_frame() == frame && joint.second_local_frame() == Physics.Transform3D())
    assert(joint.anchor_error().length() < 0.0001 && joint.angular_error().length() < 0.0001)
    assert(Math.abs(body.position().y - 1.0) < 0.0001)
}

test "slider disabling body or joint suspends reactions and reenabling resumes the real constraint" {
    var world = Physics.World3D()
    var body = slider_body(world)
    var joint = world.create_slider_constraint(slider_support(world), body)
    slider_steps(world, 30)
    joint.set_enabled(false)
    assert(!joint.is_enabled() && joint.reaction_force().length() == 0.0)
    slider_steps(world, 15); assert(joint.anchor_error().length() > 0.1)
    joint.set_enabled(true); slider_steps(world, 90)
    assert(joint.anchor_error().length() < 0.0001)
    body.set_enabled(false); world.step(1.0 / 60.0)
    assert(joint.reaction_force().length() == 0.0 && joint.reaction_torque().length() == 0.0)
    body.set_enabled(true); slider_steps(world, 30)
    assert(joint.reaction_force().y > 19.0)
    body.set_mass_properties(Physics.MassProperties3D(4.0, Math.Vec3(0.4)))
    world.step(1.0 / 60.0); assert(Math.abs(joint.reaction_force().y - 39.24) < 0.0001)
}

test "slider generations body deletion and world lifetime invalidate retained handles" {
    var world = Physics.World3D()
    var first = slider_support(world)
    var second = slider_body(world)
    var old = world.create_slider_constraint(first, second)
    world.destroy_slider_constraint(old)
    var replacement = world.create_slider_constraint(first, second)
    assert(!old.is_valid() && replacement.is_valid() && world.slider_constraint_count() == 1)
    world.destroy_rigid_body(second)
    assert(!replacement.is_valid() && world.slider_constraint_count() == 0)
    var retained:Physics.SliderConstraint3D? = null
    {
        var short_world = Physics.World3D()
        retained = short_world.create_slider_constraint(slider_support(short_world), slider_body(short_world))
    }
    assert(!retained!.is_valid())
}

test "slider assembly sleeps wakes through limits and follows a moving kinematic rail" {
    var world = Physics.World3D()
    var rail = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.kinematic)
    var body = slider_body(world)
    body.set_sleep_enabled(true)
    var joint = world.create_slider_constraint(rail, body)
    slider_steps(world, 120); assert(!body.is_awake())
    joint.set_limits(-1.0, 1.0); assert(body.is_awake())
    slider_steps(world, 120); assert(!body.is_awake())
    rail.move_kinematic(Physics.Transform3D(Math.Vec3(0.0, 1.0, 0.0)), 1.0)
    world.step(1.0 / 60.0); assert(body.is_awake())
    slider_steps(world, 119)
    assert(joint.anchor_error().length() < 0.001 && joint.angular_error().length() < 0.001)
}

test "slider vertical free travel stops on a real floor contact instead of an artificial rail force" {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
        ..transform = Physics.Transform3D(Math.Vec3(0.0, -0.5, 0.0))
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(4.0, 1.0, 4.0))))
    var body = slider_body(world, Math.Vec3(0.0, 2.0, 0.0))
    body.set_collision_filter(Physics.CollisionFilter3D())
    let orientation = Math.Quat.angle_axis(Math.pi() / 2.0, Math.Vec3(0.0, 0.0, 1.0))
    var joint = world.create_slider_constraint(slider_support(world), body,
        Physics.SliderConstraint3DSettings()
        ..first_local_frame = Physics.Transform3D(rotation:orientation)
        ..second_local_frame = Physics.Transform3D(rotation:orientation)
        ..minimum_position = -1.0 ..maximum_position = 4.0)
    slider_steps(world, 180)
    print("slider contact y=$(body.position().y) count=$(world.contact_count()) force=$(joint.reaction_force().y)")
    assert(world.contact_count() > 0 && Math.abs(body.position().y - 0.25) < 0.01)
    assert(joint.anchor_error().length() < 0.001 && joint.angular_error().length() < 0.001)
    assert(Math.abs(joint.reaction_force().y) < 0.001 && joint.limit_force() == 0.0)
}

test "slider converges misaligned frames near pi while leaving the axial coordinate unconstrained" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = slider_body(world, Math.Vec3(1.0, 0.0, 0.0), rotation:Math.Quat.angle_axis(3.13, Math.Vec3(0.0, 1.0, 0.0)))
    var joint = world.create_slider_constraint(slider_support(world), body)
    slider_steps(world, 120)
    assert(Math.abs(joint.position() - 1.0) < 0.0001 && joint.anchor_error().length() < 0.0001)
    assert(joint.angular_error().length() < 0.0001)
}

test "slider handles a spatial offset anchor under unequal inertias and arbitrary rail orientation" {
    let orientation = Math.Quat.angle_axis(0.7, Math.Vec3(1.0, 2.0, 3.0).normalized())
    let second_anchor = Math.Vec3(0.3, -0.7, 0.5)
    let origin = Math.Vec3(0.7, 1.2, -0.6)
    var world = Physics.World3D()
    var body = slider_body(world, origin.subtract(orientation.rotate(second_anchor)), rotation:orientation)
    body.set_mass_properties(Physics.MassProperties3D(3.0, Math.Vec3(0.3, 0.6, 0.9), Math.Vec3(-0.2, 0.1, 0.4)))
    var joint = world.create_slider_constraint(slider_support(world), body,
        Physics.SliderConstraint3DSettings()
        ..first_local_frame = Physics.Transform3D(origin,orientation)
        ..second_local_frame = Physics.Transform3D(second_anchor)
        ..minimum_position = -0.5 ..maximum_position = 0.75)
    var step = 0
    while step < 180 {
        world.step(1.0/60.0)
        assert(joint.anchor_error().length() < 0.001 && joint.angular_error().length() < 0.001)
        assert(joint.position() >= -0.5001 && joint.position() <= 0.7501)
        step++
    }
}
