use GFX.Physics
use STD.Math

test "construct the first 3D shapes as finite values" {
    let sphere = Physics.Sphere3D(2.0)
    let box = Physics.Box3D(Math.Vec3(2.0, 4.0, 6.0))
    assert(sphere.radius == 2.0)
    assert(box.half_size().nearly_equal(Math.Vec3(1.0, 2.0, 3.0), 0.00001))

    let sphere_shape = Physics.Shape3D.sphere(sphere)
    let box_shape = Physics.Shape3D.box(box)
    match sphere_shape {
        sphere(value) => { assert(value.radius == 2.0) }
        box(_) => { assert(false) }
        capsule(_) => { assert(false) }
        compound(_) => { assert(false) }
        triangle(_) => { assert(false) }
        mesh(_) => { assert(false) }
    }
    match box_shape {
        sphere(_) => { assert(false) }
        box(value) => { assert(value.size.x == 2.0) }
        capsule(_) => { assert(false) }
        compound(_) => { assert(false) }
        triangle(_) => { assert(false) }
        mesh(_) => { assert(false) }
    }
}

test "transform points and vectors with an invertible rigid pose" {
    let pose = Physics.Transform3D(
        position:Math.Vec3(2.0, 3.0, 4.0),
        rotation:Math.Quat.angle_axis(Math.half_pi(), Math.Vec3.up())
    )
    let direction = Math.Vec3.right()
    let world = pose.point(direction)
    assert(world.nearly_equal(Math.Vec3(2.0, 3.0, 3.0), 0.00001))
    assert(pose.inverse_point(world).nearly_equal(direction, 0.00001))
    assert(pose.inverse_vector(pose.vector(direction)).nearly_equal(direction, 0.00001))
}
