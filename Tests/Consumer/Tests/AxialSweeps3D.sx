use GFX.Physics
use STD.Math
func hull() Physics.Shape3D {
    var vertices:Math.Vec3[] = []
    var i = 0
    while i < 8 {
        var x = -0.5; var y = -0.5; var z = -0.5
        if i % 2 == 1 { x = 0.5 }
        if (i / 2) % 2 == 1 { y = 0.5 }
        if i / 4 == 1 { z = 0.5 }
        vertices.append(Math.Vec3(x, y, z)); i++
    }
    return Physics.Shape3D.convex(Physics.ConvexHull3D(vertices))
}
