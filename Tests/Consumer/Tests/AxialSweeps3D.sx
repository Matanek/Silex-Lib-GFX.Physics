func cast_cases() {
    var expected = ExpectedSweep3D()
    var all:Physics.Shape3D[] = [Physics.Shape3D.cylinder(Physics.Cylinder3D()), Physics.Shape3D.tapered_cylinder(Physics.TaperedCylinder3D()), Physics.Shape3D.tapered_capsule(Physics.TaperedCapsule3D()), Physics.Shape3D.box(Physics.Box3D()), Physics.Shape3D.capsule(Physics.Capsule3D()), hull()]
    let rotation = Math.Quat.angle_axis(0.37, Math.Vec3(1.0, 2.0, 3.0).normalized())
    let pose = Physics.Transform3D(rotation:Math.Quat.angle_axis(-0.4, Math.Vec3(1.0, 2.0, 3.0).normalized()))
    var i = 0
    for mover in all {
        var j = 0
        for target in all {
            if i < 3 || j < 3 {
                report("$(i)_$(j)", mover, Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(6.0, 0.0, 0.0), rotation, Physics.ShapePlacement3D(target, pose), expected)
                report("miss$(i)_$(j)", mover, Math.Vec3(-3.0, 4.0, 0.0), Math.Vec3(6.0, 0.0, 0.0), rotation, Physics.ShapePlacement3D(target, pose), expected)
            }
            j++
        }
        report("terrain$(i)", mover, Math.Vec3(0.0, 3.0, 0.0), Math.Vec3(0.0, -6.0, 0.0), rotation, Physics.ShapePlacement3D(Physics.Shape3D.triangle(Physics.Triangle3D(Math.Vec3(-2.0, 0.0, -2.0), Math.Vec3(0.0, 0.0, 2.0), Math.Vec3(2.0, 0.0, -2.0)))), expected)
        i++
    }
}

func report(name:str, mover:Physics.Shape3D, origin:Math.Vec3, translation:Math.Vec3,
    rotation:Math.Quat, target:Physics.ShapePlacement3D, expected:ExpectedSweep3D) {
    let result = Physics.Geometry3D.shape_cast(Physics.ShapeCast3D(Physics.ShapePlacement3D(mover, Physics.Transform3D(origin, rotation)), translation), target)
    let fraction = expected.fractions[expected.index]; let normal = expected.normals[expected.index]; expected.index++
    if fraction < 0.0 { assert(!result.hit); return }
    assert(result.hit); assert(Math.abs(result.fraction - fraction) <= 0.0002)
    assert(result.normal.nearly_equal(normal, 0.002))
    let point = Physics.ShapePlacement3D(Physics.Shape3D.sphere(Physics.Sphere3D(0.00001)), Physics.Transform3D(result.point))
    let stop = Physics.ShapePlacement3D(mover, Physics.Transform3D(origin.add(translation.multiply(result.fraction)), rotation))
    assert(Math.abs(Physics.Geometry3D.distance(point, stop).separation + 0.00001) < 0.0001)
    assert(Math.abs(Physics.Geometry3D.distance(point, target).separation + 0.00001) < 0.0001)
}
func main() { cast_cases(); print("Axial sweeps: 60 pinned oracle controls passed") }
test "axial oblique sweeps preserve pinned Jolt fractions, analytic smooth normals and both boundary witnesses" { cast_cases() }


test "cylinder sweeps retain inclined box faces at different target widths" {
    let rotation=Math.Quat.angle_axis(Math.radians(20.0),Math.Vec3(0.0,0.0,1.0))
    let sizes:float[]=[2.0,10.0,20.0]
    for size in sizes {
        let target=Physics.ShapePlacement3D(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(size,1.0,size))),
            Physics.Transform3D(rotation.rotate(Math.Vec3(0.0,-0.5,0.0)),rotation))
        let mover=Physics.ShapePlacement3D(Physics.Shape3D.cylinder(Physics.Cylinder3D(0.3,0.2)),
            Physics.Transform3D(Math.Vec3(0.0,0.8,0.0),Math.Quat.angle_axis(Math.half_pi(),Math.Vec3(0.0,0.0,1.0))))
        let result=Physics.Geometry3D.shape_cast(Physics.ShapeCast3D(mover,Math.Vec3(0.0,-0.6,0.0)),target)
        assert(result.hit)
        assert(Math.abs(result.fraction*0.6-(0.5-0.2*Math.tan(Math.radians(20.0))))<0.0001)
        assert(result.normal.nearly_equal(rotation.rotate(Math.Vec3.up()),0.0001))
        assert(Math.abs(result.point.dot(rotation.rotate(Math.Vec3.up())))<0.0001)
    }
}

test "cylinder smooth tread normal is analytic at a box corner" {
    let mover=Physics.ShapePlacement3D(Physics.Shape3D.cylinder(Physics.Cylinder3D(0.3,0.2)),
        Physics.Transform3D(Math.Vec3(0.65,0.75,0.65),Math.Quat.angle_axis(Math.half_pi(),Math.Vec3(0.0,0.0,1.0))))
    let target=Physics.ShapePlacement3D(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0,0.1,1.0))),Physics.Transform3D(Math.Vec3(0.0,-0.05,0.0)))
    let hit=Physics.Geometry3D.shape_cast(Physics.ShapeCast3D(mover,Math.Vec3(0.0,-0.6,0.0)),target)
    assert(hit.hit && hit.normal.nearly_equal(Math.Vec3(0.0,Math.sqrt(0.75),0.5),0.0001))
}
