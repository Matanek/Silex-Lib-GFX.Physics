use GFX.Physics
use STD.Math

func friction_pivot(world:Physics.World3D) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
        ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
}
func friction_body(world:Physics.World3D, inertia:float = 0.1) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
        ..mass_properties = Physics.MassProperties3D(1.0,Math.Vec3(inertia))
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
}
func friction_steps(world:Physics.World3D, count:int) { var step = 0; while step < count { world.step(1.0/60.0); step++ } }

test "hinge friction brakes both signs with one torque budget at 60 and 120 Hz" {
    var sign = -1.0
    while sign <= 1.0 {
        var rate = 60
        while rate <= 120 {
            var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
            var body = friction_body(world); body.set_angular_velocity(Math.Vec3(0.0,0.0,sign))
            var hinge = world.create_hinge_constraint(friction_pivot(world),body,
                Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.1)
            let delta = 1.0/rate as float; var speed = sign; var angle = 0.0; var step = 0
            while step < rate*2 {
                let previous = speed
                speed = sign*Math.max(0.0,Math.abs(speed)-delta)
                angle += delta*speed
                world.step(delta)
                assert(Math.abs(hinge.angular_speed()-speed) < 0.00001)
                assert(Math.abs(hinge.angle()-angle) < 0.00002)
                assert(Math.abs(hinge.friction_torque()-0.1*(speed-previous)/delta) < 0.00002)
                assert(Math.abs(hinge.friction_torque()) <= 0.100001 && hinge.motor_torque()==0.0)
                assert(Math.abs(hinge.reaction_torque().z-hinge.friction_torque()) < 0.00001)
                step++
            }
            assert(hinge.maximum_friction_torque()==0.1 && Math.abs(hinge.angular_speed()) < 0.00001)
            rate += 60
        }
        sign += 2.0
    }
}

test "zero friction leaves the hinge axis free" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = friction_body(world); body.set_angular_velocity(Math.Vec3(0.0,0.0,0.5))
    var hinge = world.create_hinge_constraint(friction_pivot(world),body)
    friction_steps(world,120)
    assert(Math.abs(hinge.angular_speed()-0.5)<0.00001 && hinge.friction_torque()==0.0)
}

test "offset hinge friction respects inertia about the anchor" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = friction_body(world); body.set_transform(Physics.Transform3D(Math.Vec3(0.0,-1.0,0.0)))
    body.set_angular_velocity(Math.Vec3(0.0,0.0,0.8)); body.set_linear_velocity(Math.Vec3(0.8,0.0,0.0))
    var hinge = world.create_hinge_constraint(friction_pivot(world),body,
        Physics.HingeConstraint3DSettings() ..second_local_anchor = Math.Vec3(0.0,1.0,0.0) ..maximum_friction_torque = 0.3)
    world.step(1.0/60.0)
    assert(Math.abs(hinge.angular_speed()-(0.8-0.3/66.0)) < 0.001)
    assert(Math.abs(hinge.friction_torque()+0.3) < 0.00001)
    friction_steps(world,240)
    assert(Math.abs(hinge.angular_speed()) < 0.001 && hinge.anchor_error().length() < 0.003)
}

test "friction exchanges momentum between unequal free inertias" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var first = friction_body(world,0.1); var second = friction_body(world,0.4)
    second.set_angular_velocity(Math.Vec3(0.0,0.0,1.0))
    var hinge = world.create_hinge_constraint(first,second,Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.02)
    var step = 0
    while step < 300 {
        world.step(1.0/60.0)
        let expected = Math.max(0.0,1.0-(step+1) as float/240.0)
        assert(Math.abs(hinge.angular_speed()-expected) < 0.00002)
        assert(Math.abs(first.angular_velocity().z*0.1+second.angular_velocity().z*0.4-0.4) < 0.00001)
        step++
    }
    assert(Math.abs(first.angular_velocity().z-0.8)<0.00001 && Math.abs(second.angular_velocity().z-0.8)<0.00001)
}

test "passive hinge friction holds a load below its torque capacity" {
    var sign = -1.0
    while sign <= 1.0 {
        var world = Physics.World3D()
        var body = friction_body(world)
        let rotation = Math.Quat.angle_axis(sign*0.3,Math.Vec3(0.0,0.0,1.0))
        body.set_transform(Physics.Transform3D(rotation.rotate(Math.Vec3(0.0,-1.0,0.0)),rotation))
        var hinge = world.create_hinge_constraint(friction_pivot(world),body,
            Physics.HingeConstraint3DSettings() ..second_local_anchor = Math.Vec3(0.0,1.0,0.0) ..maximum_friction_torque = 4.0)
        friction_steps(world,360)
        assert(Math.abs(hinge.angle()-sign*0.3) < 0.003 && Math.abs(hinge.angular_speed()) < 0.003)
        assert(Math.abs(hinge.friction_torque()-9.81*Math.sin(hinge.angle())) < 0.03)
        assert(Math.abs(hinge.reaction_force().y-9.81) < 0.03 && hinge.anchor_error().length() < 0.003)
        hinge.set_maximum_friction_torque(0.0); friction_steps(world,15)
        assert(Math.abs(hinge.angle()-sign*0.3) > 0.02 && hinge.friction_torque()==0.0)
        sign += 2.0
    }
}

test "friction mutations clear reactions and permit reverse coasting" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = friction_body(world); body.set_angular_velocity(Math.Vec3(0.0,0.0,0.5))
    var hinge = world.create_hinge_constraint(friction_pivot(world),body)
    hinge.set_maximum_friction_torque(0.1); assert(hinge.maximum_friction_torque()==0.1)
    friction_steps(world,10); assert(hinge.friction_torque() < -0.09)
    hinge.set_maximum_friction_torque(0.2)
    assert(hinge.friction_torque()==0.0 && hinge.reaction_torque().length()==0.0 && hinge.reaction_force().length()==0.0)
    friction_steps(world,30); assert(Math.abs(hinge.angular_speed()) < 0.00001)
    hinge.set_maximum_friction_torque(0.0); body.set_angular_velocity(Math.Vec3(0.0,0.0,-0.5)); friction_steps(world,60)
    assert(Math.abs(hinge.angular_speed()+0.5) < 0.00001 && hinge.friction_torque()==0.0)
}

test "installed motors take precedence even with zero effort" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = friction_body(world)
    var hinge = world.create_hinge_constraint(friction_pivot(world),body,
        Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 10.0 ..motor = Physics.HingeMotor3D(1.0,0.01))
    world.step(1.0/60.0)
    assert(Math.abs(hinge.angular_speed()-1.0/600.0)<0.00001 && hinge.friction_torque()==0.0)
    hinge.set_motor(Physics.HingeMotor3D(1.0,0.0)); body.set_angular_velocity(Math.Vec3(0.0,0.0,0.5)); friction_steps(world,30)
    assert(Math.abs(hinge.angular_speed()-0.5)<0.00001 && hinge.friction_torque()==0.0 && hinge.motor_torque()==0.0)
    hinge.set_motor(Physics.HingeMotor3D.position(0.6,10.0,1.6,0.8)); friction_steps(world,180)
    assert(Math.abs(hinge.angle()-0.6)<0.001 && hinge.friction_torque()==0.0)
    hinge.set_motor(Physics.HingeMotor3D.position(0.0,0.0,1.6,0.8)); body.set_angular_velocity(Math.Vec3(0.0,0.0,-0.5)); friction_steps(world,30)
    assert(Math.abs(hinge.angular_speed()+0.5)<0.00001 && hinge.friction_torque()==0.0)
    hinge.set_motor(null); assert(hinge.maximum_friction_torque()==10.0); world.step(1.0/60.0)
    assert(Math.abs(hinge.angular_speed())<0.00001 && hinge.motor_torque()==0.0 && hinge.friction_torque()>0.0)
}

test "friction sleeps at rest and follows constraint and body suspension" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    var hinge = world.create_hinge_constraint(friction_pivot(world),body,Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.1)
    friction_steps(world,120); assert(!body.is_awake())
    hinge.set_maximum_friction_torque(0.2); assert(body.is_awake())
    hinge.set_enabled(false); body.set_angular_velocity(Math.Vec3(0.0,0.0,1.0)); friction_steps(world,15)
    assert(Math.abs(hinge.angular_speed()-1.0)<0.00001 && hinge.friction_torque()==0.0)
    hinge.set_enabled(true); world.step(1.0/60.0); assert(hinge.angular_speed()<1.0 && hinge.friction_torque()<0.0)
    body.set_enabled(false); let pose = body.transform(); friction_steps(world,15)
    assert(body.transform().position==pose.position && body.transform().rotation==pose.rotation && hinge.friction_torque()==0.0)
    body.set_enabled(true); world.step(1.0/60.0); assert(hinge.friction_torque()<0.0)
}

test "hinge friction shares a real floor contact" {
    var world = Physics.World3D()
    var pivot = friction_pivot(world); pivot.set_transform(Physics.Transform3D(Math.Vec3(0.0,1.0,0.0)))
    var body = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(Math.Vec3(0.0,0.5,0.0))
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5)) ..allow_sleep = false)
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..shape = Physics.Shape3D.plane(Physics.Plane3D()))
    body.set_angular_velocity(Math.Vec3(0.0,1.0,0.0))
    var hinge = world.create_hinge_constraint(pivot,body,Physics.HingeConstraint3DSettings()
        ..first_local_axis = Math.Vec3(0.0,1.0,0.0) ..second_local_axis = Math.Vec3(0.0,1.0,0.0)
        ..second_local_anchor = Math.Vec3(0.0,0.5,0.0) ..maximum_friction_torque = 0.1)
    friction_steps(world,120)
    assert(world.contact_count()>0 && Math.abs(body.position().y-0.5)<0.001)
    assert(Math.abs(hinge.angular_speed())<0.001 && hinge.anchor_error().length()<0.003 && hinge.axis_error()<0.001)
}

test "friction uses the tilted frame and anisotropic inertia" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    let rotation = Math.Quat.angle_axis(0.4,Math.Vec3(1.0,0.0,0.0))
    var pivot = friction_pivot(world); pivot.set_transform(Physics.Transform3D(rotation:rotation))
    var body = friction_body(world); body.set_transform(Physics.Transform3D(rotation:rotation))
    body.set_mass_properties(Physics.MassProperties3D(1.0,Math.Vec3(0.4,0.2,0.1)))
    body.set_angular_velocity(rotation.rotate(Math.Vec3(0.0,0.0,1.0)))
    var hinge = world.create_hinge_constraint(pivot,body,Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.1)
    world.step(1.0/60.0)
    assert(Math.abs(hinge.angular_speed()-59.0/60.0)<0.00001 && hinge.axis_error()<0.001)
    friction_steps(world,120); assert(Math.abs(hinge.angular_speed())<0.00001)
}

test "friction brakes an assembly carrying a fixed payload" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = friction_body(world); var payload = friction_body(world)
    payload.set_transform(Physics.Transform3D(Math.Vec3(1.0,0.0,0.0)))
    body.set_angular_velocity(Math.Vec3(0.0,0.0,1.0)); payload.set_angular_velocity(Math.Vec3(0.0,0.0,1.0))
    payload.set_linear_velocity(Math.Vec3(0.0,1.0,0.0))
    var attachment = world.create_fixed_constraint(body,payload)
    var hinge = world.create_hinge_constraint(friction_pivot(world),body,Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.12)
    var step = 0
    while step < 660 {
        world.step(1.0/60.0)
        assert(Math.abs(hinge.friction_torque())<=0.120001 && hinge.anchor_error().length()<0.005)
        assert(attachment.anchor_error().length()<0.005 && attachment.angular_error().length()<0.005)
        step++
    }
    assert(Math.abs(hinge.angular_speed())<0.03)
}

test "zero step preserves friction observations and destruction invalidates clones" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = friction_body(world); body.set_angular_velocity(Math.Vec3(0.0,0.0,1.0))
    var hinge = world.create_hinge_constraint(friction_pivot(world),body,Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.1)
    world.step(1.0/60.0); let torque = hinge.friction_torque(); let angle = hinge.angle()
    world.step(0.0); assert(hinge.friction_torque()==torque && hinge.angle()==angle)
    var clone = hinge; world.destroy_rigid_body(body); assert(!clone.is_valid() && !hinge.is_valid())
    var retained = friction_orphan(); assert(!retained.is_valid())
}

func friction_orphan() Physics.HingeConstraint3D {
    var world = Physics.World3D()
    return world.create_hinge_constraint(friction_pivot(world),friction_body(world),
        Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.1)
}
