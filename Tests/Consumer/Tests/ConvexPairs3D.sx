use GFX.Physics
use STD.Math

func hull_box(size:Math.Vec3) Physics.Shape3D {
    var points:Math.Vec3[] = []
    var index = 0
    while index < 8 {
        var x = -0.5; var y = -0.5; var z = -0.5
        if index % 2 == 1 { x = 0.5 }
        if (index / 2) % 2 == 1 { y = 0.5 }
        if index / 4 == 1 { z = 0.5 }
        points.append(Math.Vec3(x * size.x, y * size.y, z * size.z)); index++
    }
    return Physics.Shape3D.convex(Physics.ConvexHull3D(points))
}
func placed(shape:Physics.Shape3D, point:Math.Vec3, rotation:Math.Quat = Math.Quat()) Physics.ShapePlacement3D {
    return Physics.ShapePlacement3D(shape, Physics.Transform3D(position:point, rotation:rotation))
}
func near(actual:float, expected:float, tolerance:float = 0.0001) {
    assert(actual == actual && Math.abs(actual - expected) <= tolerance)
}
func symmetric(first:Physics.ShapePlacement3D, second:Physics.ShapePlacement3D,
    expected:float, tolerance:float = 0.0001) {
    let result = Physics.Geometry3D.distance(first, second)
    let reverse = Physics.Geometry3D.distance(second, first)
    near(result.separation, expected, tolerance); near(reverse.separation, expected, tolerance)
    near(result.normal.length(), 1.0)
    assert(reverse.normal.nearly_equal(result.normal.negated(), 0.0002))
    if expected > tolerance {
        near(result.second_point.subtract(result.first_point).length(), expected, tolerance)
        assert(result.second_point.subtract(result.first_point).normalized().nearly_equal(result.normal, 0.0002))
    }
}
func simple_geometry() {
    let second = placed(hull_box(Math.Vec3(2.0)), Math.Vec3())
    let points:Math.Vec3[] = [Math.Vec3(0.0, 2.0, 0.0), Math.Vec3(1.8, 1.9, 0.0),
        Math.Vec3(1.8, 1.9, 1.9), Math.Vec3(0.0, 1.5, 0.0), Math.Vec3(0.0, 1.3, 0.0), Math.Vec3(0.0, 0.2, 0.0)]
    let gaps:float[] = [0.5, 0.5, Math.sqrt(0.41), 0.0, -0.2, -1.3]
    var index = 0
    while index < points.count() {
        let first = placed(hull_box(Math.Vec3(1.0)), points[index])
        symmetric(first, second, gaps[index])
        assert(Physics.Geometry3D.overlaps(first, second) == (gaps[index] <= 0.0))
        let result = Physics.Geometry3D.distance(first, second)
        print("gap name=simple$(index) value=$(result.separation)")
        index++
    }
    let tetra = placed(Physics.Shape3D.convex(Physics.ConvexHull3D([
        Math.Vec3(), Math.Vec3(4.0, 0.0, 0.0), Math.Vec3(0.0, 4.0, 0.0), Math.Vec3(0.0, 0.0, 4.0)])), Math.Vec3())
    symmetric(placed(hull_box(Math.Vec3(1.0)), Math.Vec3(1.5)), tetra, -1.0 / Math.sqrt(3.0))
    symmetric(placed(hull_box(Math.Vec3(1.0)), Math.Vec3(2.0)), tetra, 0.5 / Math.sqrt(3.0))
    print("gap name=tetraInside value=$(Physics.Geometry3D.distance(placed(hull_box(Math.Vec3(1.0)), Math.Vec3(1.5)), tetra).separation)")
    print("gap name=tetraOutside value=$(Physics.Geometry3D.distance(placed(hull_box(Math.Vec3(1.0)), Math.Vec3(2.0)), tetra).separation)")
}
func transformed_geometry() {
    let scales:float[] = [0.01, 1.0, 100.0]
    for scale in scales {
        let common_rotation = Math.Quat.angle_axis(0.7, Math.Vec3(1.0, 2.0, 3.0))
        let common = Physics.Transform3D(position:Math.Vec3(4.0, -3.0, 2.0).multiply(scale), rotation:common_rotation)
        let second = Physics.ShapePlacement3D(hull_box(Math.Vec3(2.0 * scale)), common)
        let second_box = Physics.ShapePlacement3D(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.0 * scale))), common)
        var index = 0
        while index < 12 {
            let point = common.point(Math.Vec3(1.3 + index as float * 0.08, 1.1, 0.3).multiply(scale))
            let rotation = common_rotation.multiply(Math.Quat.angle_axis(index as float * 0.19, Math.Vec3(1.0, 2.0, 3.0)))
            let first = placed(hull_box(Math.Vec3(scale)), point, rotation)
            let first_box = placed(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(scale))), point, rotation)
            let expected = Physics.Geometry3D.distance(first_box, second_box)
            let result = Physics.Geometry3D.distance(first, second)
            symmetric(first, second, expected.separation, 0.0001 * scale)
            assert(result.normal.nearly_equal(expected.normal, 0.0002))
            if scale == 1.0 { print("gap name=rotated$(index) value=$(result.separation)") }
            if result.separation > 0.0 {
                let local_point = first.transform().inverse_point(result.first_point)
                let half = scale * 0.5
                assert(Math.abs(local_point.x) <= half + 0.0001 * scale && Math.abs(local_point.y) <= half + 0.0001 * scale && Math.abs(local_point.z) <= half + 0.0001 * scale)
                near(Math.max(Math.abs(local_point.x), Math.max(Math.abs(local_point.y), Math.abs(local_point.z))), half, 0.0001 * scale)
            }
            index++
        }
    }
    // Thin oblique bars select edge-cross axes, with witnesses on real edges.
    var index = 0
    while index < 16 {
        let first_rotation = Math.Quat.angle_axis(0.7, Math.Vec3.up())
        let second_rotation = Math.Quat.angle_axis(0.31 + index as float * 0.1, Math.Vec3(1.0, 2.0, 3.0))
        let first_size = Math.Vec3(3.0, 0.3, 0.4); let second_size = Math.Vec3(2.0, 0.25, 0.3)
        let point = Math.Vec3(0.1, 0.1, 0.3 + index as float * 0.03)
        let first = placed(hull_box(first_size), Math.Vec3(), first_rotation)
        let second = placed(hull_box(second_size), point, second_rotation)
        let expected = Physics.Geometry3D.distance(placed(Physics.Shape3D.box(Physics.Box3D(first_size)), Math.Vec3(), first_rotation),
            placed(Physics.Shape3D.box(Physics.Box3D(second_size)), point, second_rotation))
        symmetric(first, second, expected.separation)
        assert(Physics.Geometry3D.distance(first, second).normal.nearly_equal(expected.normal, 0.0002))
        index++
    }
}
func advance(world:Physics.World3D, count:int) {
    var step = 0
    while step < count { world.step(1.0 / 120.0); step++ }
}
func rest_case(reverse:bool, stack:bool) {
    var world = Physics.World3D()
    let floor = Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
        ..shape = hull_box(Math.Vec3(8.0, 1.0, 8.0)) ..friction = 0.0
    let moving = Physics.RigidBody3DSettings() ..shape = hull_box(Math.Vec3(1.0))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 4.0, 0.0)) ..friction = 0.0 ..allow_sleep = false
    var first_settings = floor; var second_settings = moving
    if reverse { first_settings = moving; second_settings = floor }
    var first = world.create_rigid_body(first_settings); var second = world.create_rigid_body(second_settings)
    var body = second
    if reverse { body = first }
    if stack {
        body.set_transform(Physics.Transform3D(position:Math.Vec3(0.0, 1.0, 0.0)))
        var upper = world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = hull_box(Math.Vec3(1.0))
            ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 2.5, 0.0)) ..friction = 0.0 ..allow_sleep = false)
        // Match analytic unit-cube mass/inertia in the independent stack witness.
        body.set_mass_properties(Physics.MassProperties3D(1.0, Math.Vec3(1.0 / 6.0)))
        upper.set_mass_properties(Physics.MassProperties3D(1.0, Math.Vec3(1.0 / 6.0)))
        advance(world, 480)
        near(upper.position().y, 2.0, 0.005)
        assert(upper.angular_velocity().length() < 0.001 && upper.linear_velocity().length() < 0.05)
        // With no friction, opposite lateral motion conserves total momentum.
        // Shared finite-iteration stack drift is qualified separately in Task-12.
        near(upper.position().x + body.position().x, 0.0, 0.00001)
        near(upper.position().z + body.position().z, 0.0, 0.00001)
        near(upper.linear_velocity().x + body.linear_velocity().x, 0.0, 0.00001)
        near(upper.linear_velocity().z + body.linear_velocity().z, 0.0, 0.00001)
    } else { advance(world, 480) }
    near(body.position().y, 1.0, 0.005)
    if !stack { assert(Math.abs(body.position().x) < 0.0001 && Math.abs(body.position().z) < 0.0001) }
    assert(body.angular_velocity().length() < 0.001 && body.linear_velocity().length() < 0.05)
    var contacts:Physics.Contact3D[] = []; world.write_contacts(contacts)
    assert(contacts.count() > 0)
    for contact in contacts { assert(contact.point_count() == 4) }
    print("rest reverse=$(reverse) stack=$(stack) y=$(body.position().y) vy=$(body.linear_velocity().y)")
}
func inclusion() {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..shape = hull_box(Math.Vec3(2.0)))
    var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = hull_box(Math.Vec3(1.0))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 0.2, 0.0)) ..allow_sleep = false)
    advance(world, 120)
    near(body.position().y, 1.5, 0.005)
    assert(Math.abs(body.position().x) < 0.0001 && Math.abs(body.position().z) < 0.0001 && body.angular_velocity().length() < 0.001)
}
func impact(reverse:bool) {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    let left = Physics.RigidBody3DSettings() ..shape = hull_box(Math.Vec3(1.0))
        ..transform = Physics.Transform3D(position:Math.Vec3(-0.55, 0.0, 0.0)) ..linear_velocity = Math.Vec3.right()
        ..friction = 0.0 ..restitution = 1.0 ..allow_sleep = false
    let right = Physics.RigidBody3DSettings() ..shape = hull_box(Math.Vec3(1.0))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.55, 0.0, 0.0)) ..linear_velocity = Math.Vec3.right().negated()
        ..friction = 0.0 ..restitution = 1.0 ..allow_sleep = false
    var first_settings = left; var second_settings = right
    if reverse { first_settings = right; second_settings = left }
    var first = world.create_rigid_body(first_settings); var second = world.create_rigid_body(second_settings)
    advance(world, 24)
    var expected = -1.0
    if reverse { expected = 1.0 }
    near(first.linear_velocity().x, expected); near(second.linear_velocity().x, -expected)
    assert(first.linear_velocity().add(second.linear_velocity()).length() < 0.0001)
    near(first.linear_velocity().length_squared() + second.linear_velocity().length_squared(), 2.0, 0.0002)
    assert(first.angular_velocity().length() < 0.0001 && second.angular_velocity().length() < 0.0001)
    print("impact reverse=$(reverse) vx=$(first.linear_velocity().x) other=$(second.linear_velocity().x)")
}
func ccd_events() {
    var mode = 0
    while mode < 3 {
        var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
        var wall = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
            ..shape = hull_box(Math.Vec3(0.02, 2.0, 2.0)) ..is_sensor = (mode == 2))
        if mode == 1 { wall.set_collision_filter(Physics.CollisionFilter3D(mask_bits:0)) }
        var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = hull_box(Math.Vec3(0.2))
            ..transform = Physics.Transform3D(position:Math.Vec3(-1.0, 0.0, 0.0))
            ..linear_velocity = Math.Vec3(240.0, 0.0, 0.0) ..continuous_collision = true ..friction = 0.0)
        world.step(1.0 / 120.0)
        if mode == 0 {
            print("ccd x=$(body.position().x) vx=$(body.linear_velocity().x)")
            near(body.position().x, -0.11, 0.001); assert(body.linear_velocity().length() < 0.001)
            var contacts:Physics.Contact3D[] = []; world.write_contacts(contacts)
            assert(contacts.count() == 1 && contacts[0].point_count() == 4)
        } else {
            near(body.position().x, 1.0, 0.001); near(body.linear_velocity().x, 240.0, 0.001)
            var begins:Physics.Contact3D[] = []; var ends:Physics.Contact3D[] = []
            world.write_contact_begin_events(begins); world.write_contact_end_events(ends)
            if mode == 2 { assert(begins.count() == 1 && ends.count() == 1 && begins[0].is_sensor()) }
            else { assert(begins.is_empty() && ends.is_empty()) }
        }
        mode++
    }
}
func kinematic_queries() {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var platform = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.kinematic
        ..shape = hull_box(Math.Vec3(1.0)))
    var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = hull_box(Math.Vec3(1.0))
        ..transform = Physics.Transform3D(position:Math.Vec3(1.2, 0.0, 0.0)) ..allow_sleep = false)
    platform.move_kinematic(Physics.Transform3D(position:Math.Vec3(1.0, 0.0, 0.0)), 1.0)
    advance(world, 120)
    assert(body.position().x > 1.99 && body.angular_velocity().length() < 0.001)
    var hits:Physics.WorldOverlap3D[] = []
    world.write_overlaps(placed(hull_box(Math.Vec3(0.2)), platform.position()), hits, ignore_body:body)
    assert(hits.count() == 1 && hits[0].body().same_body(platform))
    var identity = platform
    platform.set_shape(hull_box(Math.Vec3(0.5)))
    assert(platform.same_body(identity))
    platform.set_sensor(true)
    body.set_transform(Physics.Transform3D(position:platform.position())); body.set_linear_velocity(Math.Vec3())
    world.step(1.0 / 120.0)
    var contacts:Physics.Contact3D[] = []; world.write_contacts(contacts)
    assert(contacts.count() == 1 && contacts[0].is_sensor())
    world.destroy_rigid_body(platform)
    world.step(1.0 / 120.0)
    var ends:Physics.Contact3D[] = []; world.write_contact_end_events(ends)
    assert(ends.count() == 1 && !ends[0].first_body().is_valid())
}
func main() {
    simple_geometry(); transformed_geometry()
    rest_case(false, false); rest_case(true, false); rest_case(false, true); rest_case(true, true)
    inclusion(); impact(false); impact(true); ccd_events(); kinematic_queries()
    print("Convex pairs: all scenarios passed")
}
test "convex pairs have Euclidean exterior distances and solid inclusion depths" { simple_geometry() }
test "convex pair transforms scales and oblique edges agree with independent boxes" { transformed_geometry() }
test "convex pairs rest and stack with four contacts in both body orders" {
    rest_case(false, false); rest_case(true, false); rest_case(false, true); rest_case(true, true)
}
test "a convex contained in another exits without spurious torque" { inclusion() }
test "dynamic convex pairs conserve symmetric elastic momentum and energy" { impact(false); impact(true) }
test "convex pair CCD respects thin walls masks and transient sensors" { ccd_events() }
test "kinematic convex pairs support queries mutation and removal events" { kinematic_queries() }
