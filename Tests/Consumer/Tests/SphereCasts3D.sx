use GFX.Physics
use STD.Math

func corner_case() {
    let box = Physics.ShapePlacement3D(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0))))
    let cast = Physics.SphereCast3D(Physics.Sphere3D(0.5), Math.Vec3(-3.0, 0.0, 0.8), Math.Vec3(6.0, 0.0, 0.0))
    let result = Physics.Geometry3D.sphere_cast(cast, box)
    print("corner hit=$(result.hit) fraction=$(result.fraction) point=$(result.point.x),$(result.point.y),$(result.point.z) normal=$(result.normal.x),$(result.normal.y),$(result.normal.z)")
    assert(result.hit && Math.abs(result.fraction - 0.35) < 0.0002)
    assert(result.point.nearly_equal(Math.Vec3(-0.5, 0.0, 0.5), 0.0005))
    assert(result.normal.nearly_equal(Math.Vec3(-0.8, 0.0, 0.6), 0.0005))
    assert(!Physics.Geometry3D.ray_cast(Physics.Ray3D(cast.origin, cast.translation), box).hit)
    let miss = Physics.SphereCast3D(Physics.Sphere3D(0.5), Math.Vec3(-3.0, 0.0, 1.05), cast.translation)
    assert(!Physics.Geometry3D.sphere_cast(miss, box).hit)
}
test "sphere sweep reaches rounded box edge while its center ray misses" { corner_case() }
func main() { corner_case(); primitive_cases(); corner_tangent_cases(); triangle_cases(); initial_cases(); transformed_cases(); world_cases(); world_child_cases(); print("Sphere casts: all cases passed") }

func hull(scale:float = 1.0, offset:Math.Vec3 = Math.Vec3()) Physics.Shape3D {
    var points:Math.Vec3[] = []; var index = 0
    while index < 8 {
        var x = -0.5; var y = -0.5; var z = -0.5
        if index % 2 == 1 { x = 0.5 }
        if (index / 2) % 2 == 1 { y = 0.5 }
        if index / 4 == 1 { z = 0.5 }
        points.append(Math.Vec3(x, y, z).multiply(scale).add(offset)); index++
    }
    return Physics.Shape3D.convex(Physics.ConvexHull3D(points))
}
func face() Physics.Triangle3D {
    return Physics.Triangle3D(Math.Vec3(0.0, -1.0, -1.0), Math.Vec3(0.0, 1.0, -1.0), Math.Vec3(0.0, 0.0, 1.0))
}
func near(value:float, expected:float, tolerance:float = 0.0002) {
    assert(value == value && Math.abs(value - expected) <= tolerance)
}
func expect(name:str, hit:Physics.CastResult3D, fraction:float, point:Math.Vec3, normal:Math.Vec3, child:int = -1, scale:float = 1.0) {
    assert(hit.hit); near(hit.fraction, fraction)
    assert(hit.point.nearly_equal(point, 0.0005 * scale))
    assert(hit.normal.nearly_equal(normal, 0.0005)); assert(hit.child_id == child)
    print("cast name=$(name) hit=$(hit.hit) fraction=$(hit.fraction) point=$(hit.point.x),$(hit.point.y),$(hit.point.z) normal=$(hit.normal.x),$(hit.normal.y),$(hit.normal.z) child=$(hit.child_id)")
}
func primitive_cases() {
    let cast = Physics.SphereCast3D(Physics.Sphere3D(0.5), Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(6.0, 0.0, 0.0))
    var index = 0
    var shapes:Physics.Shape3D[] = [Physics.Shape3D.sphere(Physics.Sphere3D(0.5)), Physics.Shape3D.capsule(Physics.Capsule3D(0.5, 0.5)),
        Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0))), hull()]
    for shape in shapes {
        expect("face$(index)", Physics.Geometry3D.sphere_cast(cast, Physics.ShapePlacement3D(shape)), 1.0 / 3.0,
            Math.Vec3(-0.5, 0.0, 0.0), Math.Vec3(-1.0, 0.0, 0.0)); index++
    }
    let capsule = Physics.ShapePlacement3D(Physics.Shape3D.capsule(Physics.Capsule3D(0.5, 0.5)))
    expect("cap", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(0.0, 3.0, 0.0), Math.Vec3(0.0, -6.0, 0.0)), capsule), 0.25, Math.Vec3(0.0, 1.0, 0.0), Math.Vec3.up())
    expect("capjoin", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.5, 0.0), cast.translation), capsule), 1.0 / 3.0, Math.Vec3(-0.5, 0.5, 0.0), Math.Vec3(-1.0, 0.0, 0.0))
    expect("long", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-1000.0, 0.0, 0.0), Math.Vec3(2000.0, 0.0, 0.0)), Physics.ShapePlacement3D(shapes[0])),
        0.4995, Math.Vec3(-0.5, 0.0, 0.0), Math.Vec3(-1.0, 0.0, 0.0))
}
func corner_tangent_cases() {
    let box = Physics.ShapePlacement3D(Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0))))
    let direction = Math.Vec3(6.0, 0.0, 0.0)
    expect("corner", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.8, 0.8), direction), box), (2.5 - Math.sqrt(0.07)) / 6.0,
        Math.Vec3(-0.5, 0.5, 0.5), Math.Vec3(-Math.sqrt(0.28), 0.6, 0.6))
    expect("tangent", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.0, 1.0), direction), box), 2.5 / 6.0,
        Math.Vec3(-0.5, 0.0, 0.5), Math.Vec3.back())
    expect("endpoint", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(2.0, 0.0, 0.0)), box), 1.0, Math.Vec3(-0.5, 0.0, 0.0), Math.Vec3(-1.0, 0.0, 0.0))
    let misses:Math.Vec3[] = [Math.Vec3(-3.0, 0.95, 0.95), Math.Vec3(-3.0, 0.0, 1.001)]
    var miss_index = 0
    for start in misses {
        assert(!Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5), start, direction), box).hit)
        if miss_index == 0 { print("cast name=misscorner hit=false") }
        miss_index++
    }
    assert(!Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5), Math.Vec3(-3.0, 0.0, 0.0), direction.negated()), box).hit)
    print("cast name=missaway hit=false")
    assert(!Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5), Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(1.99, 0.0, 0.0)), box).hit)
}
func triangle_cases() {
    let target = Physics.ShapePlacement3D(Physics.Shape3D.triangle(face()))
    expect("trifront", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(3.0, 0.0, 0.0), Math.Vec3(-6.0, 0.0, 0.0)), target), 2.5 / 6.0, Math.Vec3(), Math.Vec3.right())
    expect("triback", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(6.0, 0.0, 0.0)), target), 2.5 / 6.0, Math.Vec3(), Math.Vec3(-1.0, 0.0, 0.0))
    expect("triedge", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.0, -1.3), Math.Vec3(6.0, 0.0, 0.0)), target), 2.6 / 6.0,
        Math.Vec3(0.0, 0.0, -1.0), Math.Vec3(-0.8, 0.0, -0.6))
    expect("trivertex", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.0, 1.3), Math.Vec3(6.0, 0.0, 0.0)), target), 2.6 / 6.0,
        Math.Vec3(0.0, 0.0, 1.0), Math.Vec3(-0.8, 0.0, 0.6))
    let tri = face(); let later = Physics.Triangle3D(tri.first.add(Math.Vec3(2.0, 0.0, 0.0)), tri.second.add(Math.Vec3(2.0, 0.0, 0.0)), tri.third.add(Math.Vec3(2.0, 0.0, 0.0)))
    var mesh = Physics.ShapePlacement3D(Physics.Shape3D.mesh(Physics.TriangleMesh3D([later, tri])))
    expect("mesh", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(6.0, 0.0, 0.0)), mesh), 2.5 / 6.0,
        Math.Vec3(), Math.Vec3(-1.0, 0.0, 0.0), 1)
}
func initial_cases() {
    var shapes:Physics.Shape3D[] = [Physics.Shape3D.sphere(Physics.Sphere3D(0.5)), Physics.Shape3D.capsule(Physics.Capsule3D(0.5, 0.5)),
        Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0))), hull(), Physics.Shape3D.triangle(face())]
    for shape in shapes {
        let origins:Math.Vec3[] = [Math.Vec3(), Math.Vec3(0.2, 0.0, 0.0)]
        for origin in origins {
            let hit = Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5), origin, Math.Vec3.right()), Physics.ShapePlacement3D(shape))
            assert(hit.hit && hit.fraction == 0.0); near(hit.normal.length(), 1.0)
            assert(hit.point.length() < 1.01 && hit.point.length() == hit.point.length())
        }
    }
    expect("startoutside", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(0.8, 0.0, 0.0), Math.Vec3.right()), Physics.ShapePlacement3D(shapes[2])), 0.0,
        Math.Vec3(0.5, 0.0, 0.0), Math.Vec3.right())
    expect("startinside", Physics.Geometry3D.sphere_cast(Physics.SphereCast3D(Physics.Sphere3D(0.5),
        Math.Vec3(0.2, 0.0, 0.0), Math.Vec3.right()), Physics.ShapePlacement3D(shapes[2])), 0.0,
        Math.Vec3(0.5, 0.0, 0.0), Math.Vec3.right())
}
func transformed_cases() {
    var variant = 0
    let scales:float[] = [0.1, 1.0, 10.0]
    for scale in scales {
        var step = 0
        while step < 4 {
            let pose = Physics.Transform3D(Math.Vec3(4.0, 2.0, -3.0).multiply(scale),
                Math.Quat.angle_axis(0.37 * step as float, Math.Vec3(1.0, 2.0, 3.0).normalized()))
            let offset = Math.Vec3(3.0, -4.0, 2.0).multiply(scale)
            var compound = Physics.Shape3D.compound(Physics.Compound3D([
                Physics.CompoundChild3D(9, Physics.Shape3D.box(Physics.Box3D(Math.Vec3(scale))), Physics.Transform3D(Math.Vec3(2.0 * scale, 0.0, 0.0))),
                Physics.CompoundChild3D(71, hull(scale, offset), Physics.Transform3D(offset.negated()))]))
            let cast = Physics.SphereCast3D(Physics.Sphere3D(0.5 * scale),
                pose.point(Math.Vec3(-3.0, 0.0, 0.8).multiply(scale)), pose.vector(Math.Vec3(6.0 * scale, 0.0, 0.0)))
            expect("shift$(variant)", Physics.Geometry3D.sphere_cast(cast, Physics.ShapePlacement3D(compound, pose)), 0.35,
                pose.point(Math.Vec3(-0.5, 0.0, 0.5).multiply(scale)), pose.vector(Math.Vec3(-0.8, 0.0, 0.6)), 71, scale)
            step++; variant++
        }
    }
}
func world_cases() {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    let shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
    var sensor = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..shape = shape
        ..is_sensor = true ..collision_filter = Physics.CollisionFilter3D(category_bits:2))
    var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.kinematic ..shape = shape
        ..transform = Physics.Transform3D(Math.Vec3(2.0, 0.0, 0.0)) ..collision_filter = Physics.CollisionFilter3D(category_bits:4))
    let cast = Physics.SphereCast3D(Physics.Sphere3D(0.5), Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(6.0, 0.0, 0.0))
    let before = body.transform(); let count = world.body_count()
    if let hit = world.sphere_cast(cast) { assert(hit.body().same_body(sensor)); near(hit.fraction(), 1.0 / 3.0) } else { panic("sensor hit missing") }
    if let hit = world.sphere_cast(cast, filter:Physics.QueryFilter3D(include_sensors:false)) {
        assert(hit.body().same_body(body)); near(hit.fraction(), 2.0 / 3.0)
    } else { panic("body hit missing") }
    if let hit = world.sphere_cast(cast, ignore_body:sensor) { assert(hit.body().same_body(body)) } else { panic("ignore failed") }
    if let hit = world.sphere_cast(cast, filter:Physics.QueryFilter3D(mask_bits:4)) { assert(hit.body().same_body(body)) } else { panic("mask failed") }
    assert(world.sphere_cast(cast, filter:Physics.QueryFilter3D(mask_bits:8)) == null)
    sensor.set_enabled(false)
    if let hit = world.sphere_cast(cast) { assert(hit.body().same_body(body)) } else { panic("disabled failed") }
    sensor.set_enabled(true); body.set_transform(Physics.Transform3D())
    if let hit = world.sphere_cast(cast) { assert(hit.body().same_body(sensor)) } else { panic("stable tie failed") }
    body.set_transform(before); sensor.set_sensor(false)
    assert(body.transform().position == before.position && world.body_count() == count && world.contact_count() == 0)
    if let snapshot = world.sphere_cast(cast) {
        let fraction = snapshot.fraction(); let point = snapshot.point(); let normal = snapshot.normal()
        world.destroy_rigid_body(sensor)
        var recycled = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..shape = shape)
        assert(!snapshot.body().is_valid() && !snapshot.body().same_body(recycled))
        near(snapshot.fraction(), fraction); assert(snapshot.point() == point && snapshot.normal() == normal)
        recycled.set_enabled(false)
    } else { panic("snapshot missing") }
    assert(world.body_count() == count)
}
test "sphere sweep covers primitive sides and capsule caps" { primitive_cases() }
test "sphere sweep distinguishes corners tangencies misses and endpoints" { corner_tangent_cases() }
test "sphere sweep covers bilateral triangles and stable mesh faces" { triangle_cases() }
test "sphere sweep reports initial overlap without a world step" { initial_cases() }
test "sphere sweep preserves scaled rotated compensated child poses" { transformed_cases() }
test "sphere world query respects filters exclusion ties and snapshot lifetime" { world_cases() }

func world_child_cases() {
    let cast = Physics.SphereCast3D(Physics.Sphere3D(0.5), Math.Vec3(-3.0, 0.0, 0.0), Math.Vec3(6.0, 0.0, 0.0))
    var retained:Physics.WorldSphereHit3D? = null
    {
        var world = Physics.World3D()
        var compound = Physics.Shape3D.compound(Physics.Compound3D([
            Physics.CompoundChild3D(71, hull()), Physics.CompoundChild3D(9, hull())]))
        var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = compound ..allow_sleep = false)
        if let hit = world.sphere_cast(cast) {
            assert(hit.body().same_body(body) && hit.child_id() == 71); near(hit.fraction(), 1.0 / 3.0)
            retained = hit
        } else { panic("compound hit missing") }
        body.set_shape(Physics.Shape3D.compound(Physics.Compound3D([
            Physics.CompoundChild3D(9, hull(), Physics.Transform3D(Math.Vec3(2.0, 0.0, 0.0)))])))
        if let hit = world.sphere_cast(cast) { assert(hit.child_id() == 9); near(hit.fraction(), 2.0 / 3.0) } else { panic("mutated hit missing") }
        assert(retained!.child_id() == 71 && retained!.point().nearly_equal(Math.Vec3(-0.5, 0.0, 0.0), 0.0005))
    }
    assert(!retained!.body().is_valid() && retained!.child_id() == 71)
}
test "sphere world query retains child identities across mutation and world destruction" { world_child_cases() }
