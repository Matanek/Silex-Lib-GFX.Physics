use GFX.Physics
use STD.Math

func particle(world:Physics.World3D,position:Math.Vec3) Physics.SoftBody3D {
    return world.create_soft_body(Physics.SoftBody3DDefinition(positions:[position]),
        Physics.SoftBody3DSettings() ..vertex_radius=0.05 ..friction=0.0)
}

func moved_and_replaced() {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3() ..soft_body_substeps=1)
    let rotation=Math.Quat.angle_axis(Math.half_pi(),Math.Vec3.back())
    var rigid=world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.cylinder(Physics.Cylinder3D(1.0,0.5))
        ..transform=Physics.Transform3D(Math.Vec3(),rotation))
    var body=particle(world,Math.Vec3(0.0,1.025,0.0))
    world.step(1.0/120.0)
    assert(body.position(0).nearly_equal(Math.Vec3(0.0,1.05,0.0),0.00001))
    rigid.set_transform(Physics.Transform3D(Math.Vec3(0.0,2.0,0.0),rotation))
    world.step(1.0/120.0)
    assert(body.position(0).nearly_equal(Math.Vec3(0.0,0.95,0.0),0.00001))
    rigid.set_shape(Physics.Shape3D.cylinder(Physics.Cylinder3D(0.5,0.5)))
    body.set_pose([Physics.SoftPose3D(0,Math.Vec3(0.0,1.525,0.0))])
    world.step(1.0/120.0)
    assert(body.position(0).nearly_equal(Math.Vec3(0.0,1.45,0.0),0.00001))
}

func compounds() {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3() ..soft_body_substeps=1)
    var children:Physics.CompoundChild3D[]=[
        Physics.CompoundChild3D(0,Physics.Shape3D.cylinder(Physics.Cylinder3D(1.0,0.5))),
        Physics.CompoundChild3D(1,Physics.Shape3D.cylinder(Physics.Cylinder3D(1.25,0.05)),
            Physics.Transform3D(Math.Vec3(0.0,0.6,0.0))),
        Physics.CompoundChild3D(2,Physics.Shape3D.cylinder(Physics.Cylinder3D(1.25,0.05)),
            Physics.Transform3D(Math.Vec3(0.0,-0.6,0.0)))]
    var rigid=world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.compound(Physics.Compound3D(children))
        ..transform=Physics.Transform3D(Math.Vec3(),Math.Quat.angle_axis(Math.half_pi(),Math.Vec3.back())))
    let start=Math.Vec3(-0.6,1.275,0.0);let expected=Math.Vec3(-0.6,1.3,0.0)
    var body=particle(world,start);world.step(1.0/120.0)
    assert(body.position(0).nearly_equal(expected,0.00001))
    var mixed:Physics.CompoundChild3D[]=[children[0],
        Physics.CompoundChild3D(1,Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.5,0.1,2.5))),
            Physics.Transform3D(Math.Vec3(0.0,0.6,0.0)))]
    rigid.set_shape(Physics.Shape3D.compound(Physics.Compound3D(mixed)))
    body.set_pose([Physics.SoftPose3D(0,start)]);world.step(1.0/120.0)
    assert(body.position(0).nearly_equal(expected,0.00001))
}

func end_caps() {
    var shapes:Physics.Shape3D[]=[Physics.Shape3D.cylinder(Physics.Cylinder3D(1.0,0.5)),
        Physics.Shape3D.tapered_cylinder(Physics.TaperedCylinder3D(1.0,0.5,0.5)),
        Physics.Shape3D.tapered_capsule(Physics.TaperedCapsule3D(1.0,0.5,0.5))]
    let tops:float[]=[0.5,0.5,1.5]
    let pose=Physics.Transform3D(Math.Vec3(2.0,3.0,-1.0),
        Math.Quat.angle_axis(0.7,Math.Vec3(1.0,2.0,3.0).normalized()))
    for index in 0...3 {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3() ..soft_body_substeps=1)
        world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=shapes[index] ..transform=pose)
        var body=particle(world,pose.point(Math.Vec3(0.0,tops[index]+0.025,0.0)))
        world.step(1.0/120.0)
        assert(body.position(0).nearly_equal(pose.point(Math.Vec3(0.0,tops[index]+0.05,0.0)),0.00001))
    }
}

test "soft axial contacts follow rigid pose and shape changes" { moved_and_replaced() }
test "soft contacts preserve axial compound and mixed compound response" { compounds() }
test "soft cylinder and tapered end caps keep their analytic boundary after rotation" { end_caps() }

test "soft axial CCD stops complete barrel, cap and flange crossings" {
    var children:Physics.CompoundChild3D[]=[
        Physics.CompoundChild3D(0,Physics.Shape3D.cylinder(Physics.Cylinder3D(1.0,0.25))),
        Physics.CompoundChild3D(1,Physics.Shape3D.cylinder(Physics.Cylinder3D(1.25,0.05)),
            Physics.Transform3D(Math.Vec3(0.0,0.3,0.0)))]
    var shapes:Physics.Shape3D[]=[Physics.Shape3D.cylinder(Physics.Cylinder3D(1.0,0.5)),
        Physics.Shape3D.cylinder(Physics.Cylinder3D(1.0,0.5)),
        Physics.Shape3D.compound(Physics.Compound3D(children))]
    let starts:Math.Vec3[]=[Math.Vec3(-3.0,0.0,0.0),Math.Vec3(0.0,3.0,0.0),Math.Vec3(-3.0,0.3,0.0)]
    let impulses:Math.Vec3[]=[Math.Vec3(720.0,0.0,0.0),Math.Vec3(0.0,-720.0,0.0),Math.Vec3(720.0,0.0,0.0)]
    for index in 0...3 {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3() ..soft_body_substeps=1)
        world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed ..shape=shapes[index])
        var body=world.create_soft_body(Physics.SoftBody3DDefinition(positions:[starts[index]]),
            Physics.SoftBody3DSettings() ..vertex_radius=0.05 ..linear_damping=0.0 ..friction=0.0)
        body.apply_impulse(0,impulses[index]);world.step(1.0/120.0)
        let point=body.position(0)
        if index==0 { assert(Math.abs(point.x+1.05)<0.0001) }
        if index==1 { assert(Math.abs(point.y-0.55)<0.0001) }
        if index==2 { assert(Math.abs(point.x+1.3)<0.0001) }
        assert(body.velocity(0).length()<0.001)
    }
}
