use GFX.Physics as Physics
use STD.Math

func reject_tagged(pair:Physics.ContactPairSnapshot2D) bool {
    return pair.first().material.application_id.value() != 42 &&
        pair.second().material.application_id.value() != 42
}

func disable_contact(input:Physics.ContactPreSolve2D) Physics.ContactDecision2D {
    return Physics.ContactDecision2D() ..enabled = false
}

func one_way_platform(
    input:Physics.ContactPreSolve2D
) Physics.ContactDecision2D {
    if input.pair().second().body().velocity().y > 0.0 {
        return Physics.ContactDecision2D() ..enabled = false
    }
    return Physics.ContactDecision2D()
}

func require_average_materials(
    input:Physics.ContactPreSolve2D
) Physics.ContactDecision2D {
    var decision = Physics.ContactDecision2D()
    if !Math.nearly_equal(input.friction, 0.5, 0.000001) ||
        !Math.nearly_equal(input.restitution, 0.5, 0.000001)
    {
        decision.enabled = false
    }
    return decision
}

func material_decision(
    input:Physics.ContactPreSolve2D,
    expected:float
) Physics.ContactDecision2D {
    var decision = Physics.ContactDecision2D()
    if !Math.nearly_equal(input.friction, expected, 0.000001) ||
        !Math.nearly_equal(input.restitution, expected, 0.000001)
    {
        decision.enabled = false
    }
    return decision
}

func require_geometric_materials(
    input:Physics.ContactPreSolve2D
) Physics.ContactDecision2D {
    return material_decision(input, 0.4)
}

func require_minimum_materials(
    input:Physics.ContactPreSolve2D
) Physics.ContactDecision2D {
    return material_decision(input, 0.2)
}

func require_maximum_materials(
    input:Physics.ContactPreSolve2D
) Physics.ContactDecision2D {
    return material_decision(input, 0.8)
}

func require_multiplied_materials(
    input:Physics.ContactPreSolve2D
) Physics.ContactDecision2D {
    return material_decision(input, 0.16)
}

func sideways_normal(
    input:Physics.ContactPreSolve2D
) Physics.ContactDecision2D {
    return Physics.ContactDecision2D()
        ..manifold = Physics.Manifold2D(
            Math.Vec2(1.0, 0.0),
            input.manifold.points
        )
}

func create_policy_pair(
    world:Physics.World2D,
    first_settings:Physics.Collider2DSettings,
    second_settings:Physics.Collider2DSettings
) Physics.RigidBody2D {
    var support = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..create_implicit_collider = false
    )
    world.create_collider(support, first_settings)
    var moving = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..create_implicit_collider = false
    )
    world.create_collider(moving, second_settings)
    return moving
}

test "reject an opted-in collider pair through the custom filter" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.set_custom_filter(reject_tagged)
    let tagged = Physics.PhysicsMaterial2D()
        ..application_id = Physics.PhysicsMaterialId2D(42)
    var moving = create_policy_pair(
        world,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..material = tagged
            ..enable_custom_filter = true,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..enable_contact_events = true
            ..enable_hit_events = true
    )

    moving.set_velocity(Math.Vec2(-2.0, 0.0))
    world.step(0.1)
    assert(world.contact_count() == 0)
    var began:Physics.ContactBeginEvent2D[] = []
    var hits:Physics.ContactHitEvent2D[] = []
    world.write_contact_begin_events(began)
    world.write_contact_hit_events(hits)
    assert(began.count() == 0)
    assert(hits.count() == 0)

    world.clear_custom_filter()
    world.step(0.0)
    assert(world.contact_count() == 1)
}

test "disable the current contact through an opted-in pre-solve" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.set_pre_solve(disable_contact)
    var moving = create_policy_pair(
        world,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(3.0, 0.5)))
            ..enable_pre_solve = true,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
            ..enable_hit_events = true
    )
    moving.set_velocity(Math.Vec2(0.0, -2.0))

    world.step(0.25)
    assert(world.contact_count() == 0)
    assert(moving.position().y < -0.1)
    var hits:Physics.ContactHitEvent2D[] = []
    world.write_contact_hit_events(hits)
    assert(hits.count() == 0)

    world.clear_pre_solve()
    moving.set_position(Math.Vec2())
    world.step(0.0)
    assert(world.contact_count() == 1)
}

test "cross a one-way platform upward and collide while descending" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.set_pre_solve(one_way_platform)
    var moving = create_policy_pair(
        world,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..enable_pre_solve = true,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
    )
    moving.set_position(Math.Vec2(0.0, -1.5))
    moving.set_velocity(Math.Vec2(0.0, 2.0))
    world.step(0.1)
    assert(world.contact_count() == 0)

    moving.set_position(Math.Vec2(0.0, 1.5))
    moving.set_velocity(Math.Vec2(0.0, -2.0))
    world.step(0.0)
    assert(world.contact_count() == 1)
}

test "resolve explicit average friction and restitution before pre-solve" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.set_pre_solve(require_average_materials)
    let first_material = Physics.PhysicsMaterial2D()
        ..friction = 0.2
        ..restitution = 0.2
        ..friction_combine = Physics.MaterialCombineMode2D.average
        ..restitution_combine = Physics.MaterialCombineMode2D.average
    let second_material = Physics.PhysicsMaterial2D()
        ..friction = 0.8
        ..restitution = 0.8
        ..friction_combine = Physics.MaterialCombineMode2D.average
        ..restitution_combine = Physics.MaterialCombineMode2D.average
    create_policy_pair(
        world,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..material = first_material
            ..enable_pre_solve = true,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..material = second_material
    )

    world.step(0.0)
    assert(world.contact_count() == 1)
}

func verify_material_mode(
    mode:Physics.MaterialCombineMode2D,
    policy:func(Physics.ContactPreSolve2D) Physics.ContactDecision2D
) {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.set_pre_solve(policy)
    let first = Physics.PhysicsMaterial2D()
        ..friction = 0.2
        ..restitution = 0.2
        ..friction_combine = mode
        ..restitution_combine = mode
    let second = Physics.PhysicsMaterial2D()
        ..friction = 0.8
        ..restitution = 0.8
        ..friction_combine = mode
        ..restitution_combine = mode
    create_policy_pair(
        world,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..material = first
            ..enable_pre_solve = true,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..material = second
    )
    world.step(0.0)
    assert(world.contact_count() == 1)
}

test "combine materials with every supported mode" {
    verify_material_mode(
        Physics.MaterialCombineMode2D.geometric_mean,
        require_geometric_materials
    )
    verify_material_mode(
        Physics.MaterialCombineMode2D.minimum,
        require_minimum_materials
    )
    verify_material_mode(
        Physics.MaterialCombineMode2D.maximum,
        require_maximum_materials
    )
    verify_material_mode(
        Physics.MaterialCombineMode2D.multiply,
        require_multiplied_materials
    )
}

test "replace the contact normal with a validated manifold value" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.set_pre_solve(sideways_normal)
    var moving = create_policy_pair(
        world,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(3.0, 0.5)))
            ..enable_pre_solve = true,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
    )
    moving.set_velocity(Math.Vec2(0.0, -2.0))

    world.step(0.1)
    assert(world.contact_count() == 1)
    assert(moving.velocity().y < -1.5)
}

func policy_trace(worker_count:int) float[] {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.enable_parallelism(worker_count)
    world.set_pre_solve(disable_contact)
    var moving = create_policy_pair(
        world,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
            ..enable_pre_solve = true,
        Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(1.0))
    )
    moving.set_velocity(Math.Vec2(1.0, -2.0))
    world.step(0.25)
    return [moving.position().x, moving.position().y]
}

test "retain contact policy results across worker counts" {
    let direct = policy_trace(1)
    let parallel = policy_trace(4)
    assert(Math.nearly_equal(direct[0], parallel[0], 0.000001))
    assert(Math.nearly_equal(direct[1], parallel[1], 0.000001))
}
