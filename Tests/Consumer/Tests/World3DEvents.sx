use GFX.Physics
use STD.Math

test "contact transitions merge interleaved pairs and exhausted tails" {
    var world = quiet_world()
    var moving:Physics.RigidBody3D[] = []
    var index = 0
    while index < 7 {
        let x = index as float * 4.0
        world.create_rigid_body(Physics.RigidBody3DSettings()
            ..body_type = Physics.BodyType3D.fixed
            ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
            ..transform = Physics.Transform3D(position:Math.Vec3(x, 0.0, 0.0)))
        moving.append(world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
            ..transform = Physics.Transform3D(position:Math.Vec3(x + 0.9, 0.0, 0.0))
            ..is_enabled = index == 1 || index == 3 || index == 5))
        index++
    }
    var begins:Physics.Contact3D[] = []
    var ends:Physics.Contact3D[] = []
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    assert(begins.count() == 3)
    index = 0
    while index < 7 {
        moving[index].set_enabled(index == 0 || index == 3 || index == 4 || index == 6)
        index++
    }
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(world.contact_count() == 4 && begins.count() == 3 && ends.count() == 2)
    assert(begins[0].second_body().same_body(moving[0]))
    assert(begins[1].second_body().same_body(moving[4]))
    assert(begins[2].second_body().same_body(moving[6]))
    assert(ends[0].second_body().same_body(moving[1]))
    assert(ends[1].second_body().same_body(moving[5]))
    index = 0
    while index < 7 {
        moving[index].set_enabled(index == 1 || index == 3 || index == 5)
        index++
    }
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(world.contact_count() == 3 && begins.count() == 2 && ends.count() == 3)
    assert(begins[0].second_body().same_body(moving[1]))
    assert(begins[1].second_body().same_body(moving[5]))
    assert(ends[0].second_body().same_body(moving[0]))
    assert(ends[1].second_body().same_body(moving[4]))
    assert(ends[2].second_body().same_body(moving[6]))
    for body in moving { body.set_enabled(false) }
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(world.contact_count() == 0 && begins.count() == 0 && ends.count() == 3)
    assert(ends[0].second_body().same_body(moving[1]))
    assert(ends[1].second_body().same_body(moving[3]))
    assert(ends[2].second_body().same_body(moving[5]))
}

func quiet_world() Physics.World3D {
    return Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
}

test "entry persists then exits at positive step boundaries" {
    var world = quiet_world()
    var fixed = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(0.9, 0.0, 0.0)))
    var begins:Physics.Contact3D[] = []
    var ends:Physics.Contact3D[] = []
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(begins.count() == 1 && ends.count() == 0)
    assert(begins[0].first_body().same_body(fixed))
    world.step(0.0)
    world.write_contact_begin_events(begins)
    assert(begins.count() == 1)
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(begins.count() == 0 && ends.count() == 0)
    moving.set_transform(Physics.Transform3D(position:Math.Vec3(4.0, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(begins.count() == 0 && ends.count() == 1)
    assert(ends[0].first_body().same_body(fixed))
    assert(ends[0].separation() <= 0.000001)
    world.step(1.0 / 60.0)
    world.write_contact_end_events(ends)
    assert(ends.count() == 0)
}

test "destroyed and recycled support keeps an old end and a new begin" {
    var world = quiet_world()
    var support = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(0.9, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    var begins:Physics.Contact3D[] = []
    var ends:Physics.Contact3D[] = []
    world.write_contact_begin_events(begins)
    assert(begins.count() == 1)
    world.destroy_rigid_body(support)
    assert(world.contact_count() == 0)
    var replacement = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    moving.set_transform(Physics.Transform3D(position:Math.Vec3(0.9, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(begins.count() == 1 && ends.count() == 1)
    assert(ends[0].first_body().same_body(support))
    assert(!ends[0].first_body().is_valid())
    assert(begins[0].first_body().same_body(replacement))
    assert(!begins[0].first_body().same_body(ends[0].first_body()))
    var old_end = ends[0]
    world.step(1.0 / 60.0)
    world.write_contact_end_events(ends)
    assert(ends.count() == 0)
    assert(old_end.first_body().same_body(support))
    assert(!old_end.first_body().is_valid())
}

test "switching compound children ends one identity and begins another" {
    var compound = Physics.Compound3D([
        Physics.CompoundChild3D(11,
            Physics.Shape3D.sphere(Physics.Sphere3D(0.5)),
            Physics.Transform3D(position:Math.Vec3(-2.0, 0.0, 0.0))),
        Physics.CompoundChild3D(22,
            Physics.Shape3D.sphere(Physics.Sphere3D(0.5)),
            Physics.Transform3D(position:Math.Vec3(2.0, 0.0, 0.0)))
    ])
    var world = quiet_world()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.compound(compound))
    var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(-2.9, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    moving.set_transform(Physics.Transform3D(position:Math.Vec3(2.9, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    var begins:Physics.Contact3D[] = []
    var ends:Physics.Contact3D[] = []
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(begins.count() == 1 && begins[0].first_child_id() == 22)
    assert(ends.count() == 1 && ends[0].first_child_id() == 11)
}

test "disabling and re-enabling a support yields one end and new begin" {
    var world = quiet_world()
    var support = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(0.9, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    support.set_enabled(false)
    world.step(1.0 / 60.0)
    var begins:Physics.Contact3D[] = []
    var ends:Physics.Contact3D[] = []
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(begins.count() == 0 && ends.count() == 1)
    support.set_enabled(true)
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    world.write_contact_end_events(ends)
    assert(begins.count() == 1 && ends.count() == 0)
}

test "ordered contact lookup keeps the middle pair's lifecycle" {
    var world = quiet_world()
    var moving:Physics.RigidBody3D[] = []
    var index = 0
    while index < 3 {
        let x = index as float * 4.0
        world.create_rigid_body(Physics.RigidBody3DSettings()
            ..body_type = Physics.BodyType3D.fixed
            ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
            ..transform = Physics.Transform3D(position:Math.Vec3(x, 0.0, 0.0)))
        moving.append(world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
            ..transform = Physics.Transform3D(position:Math.Vec3(x + 0.9, 0.0, 0.0))))
        index++
    }
    var begins:Physics.Contact3D[] = []
    var ends:Physics.Contact3D[] = []
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    assert(world.contact_count() == 3 && begins.count() == 3)
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    assert(world.contact_count() == 3 && begins.count() == 0)
    moving[1].set_transform(Physics.Transform3D(
        position:Math.Vec3(20.0, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    world.write_contact_end_events(ends)
    assert(world.contact_count() == 2 && ends.count() == 1)
    assert(ends[0].second_body().same_body(moving[1]))
    moving[1].set_transform(Physics.Transform3D(
        position:Math.Vec3(4.9, 0.0, 0.0)))
    world.step(1.0 / 60.0)
    world.write_contact_begin_events(begins)
    assert(world.contact_count() == 3 && begins.count() == 1)
    assert(begins[0].second_body().same_body(moving[1]))
}
