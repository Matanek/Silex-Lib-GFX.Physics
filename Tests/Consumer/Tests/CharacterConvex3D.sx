use GFX.Physics
use STD.Math

func convex_box(size:Math.Vec3) Physics.Shape3D {
    let half = size.multiply(0.5)
    var points:Math.Vec3[] = []
    var index = 0
    while index < 8 {
        var x = -half.x; var y = -half.y; var z = -half.z
        if index % 2 == 1 { x = half.x }
        if (index / 2) % 2 == 1 { y = half.y }
        if index / 4 == 1 { z = half.z }
        points.append(Math.Vec3(x, y, z))
        index++
    }
    return Physics.Shape3D.convex(Physics.ConvexHull3D(points))
}
func obstacle(world:&Physics.World3D, size:Math.Vec3, pose:Physics.Transform3D,
    convex:bool = true) Physics.RigidBody3D {
    var shape = Physics.Shape3D.box(Physics.Box3D(size))
    if convex { shape = convex_box(size) }
    return world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed ..shape = shape ..transform = pose)
}
func capsule_at(position:Math.Vec3) Physics.ShapePlacement3D {
    return Physics.ShapePlacement3D(Physics.Shape3D.capsule(Physics.Capsule3D(0.3, 0.55)),
        Physics.Transform3D(position:position))
}
func face() {
    var world = Physics.World3D()
    var floor = obstacle(world, Math.Vec3(8.0, 1.0, 8.0),
        Physics.Transform3D(position:Math.Vec3(0.0, -0.5, 0.0)))
    var mover = Physics.CharacterMover3D()
    let landed = mover.calculate_move(world, Math.Vec3(0.0, 3.0, 0.0), Math.Vec3(0.0, -5.0, 0.0))
    assert(landed.grounded && Math.abs(landed.position.y - 0.852) < 0.0001)
    if let support = landed.support() { assert(support.same_body(floor)) }
    else { assert(false) }
    let recovered = mover.calculate_move(world, Math.Vec3(0.0, 0.75, 0.0), Math.Vec3())
    assert(recovered.grounded && Math.abs(recovered.position.y - 0.852) < 0.0001)
    let idle = mover.calculate_move(world, recovered.position, Math.Vec3(), true)
    assert(idle.grounded && idle.position.nearly_equal(recovered.position, 0.0001))
    let jumped = mover.calculate_move(world, idle.position, Math.Vec3(0.0, 0.4, 0.0), true)
    assert(!jumped.grounded && jumped.support() == null)
    world.destroy_rigid_body(floor)
    let removed = mover.calculate_move(world, idle.position, Math.Vec3(), true)
    assert(!removed.grounded && removed.support() == null)
}

test "character lands recovers jumps and loses a fixed convex support" { face() }
func main() {
    face(); walls(); stairs(0.25, false, true); stairs(0.6, false, false); stairs(0.25, true, false)
    walking(false); walking(true); walking(false, 0.7); walking(true, 0.7)
    steep(); filtering(); equivalent_boxes()
    print("Character convex: all scenarios passed")
}

func wedge(slope:float = 0.25) Physics.Shape3D {
    var points:Math.Vec3[] = []
    let coordinates:float[] = [-3.0, 3.0]
    for x in coordinates {
        for z in coordinates {
            points.append(Math.Vec3(x, -8.0, z))
            points.append(Math.Vec3(x, slope * z, z))
        }
    }
    return Physics.Shape3D.convex(Physics.ConvexHull3D(points))
}
func walls() {
    var world = Physics.World3D()
    obstacle(world, Math.Vec3(8.0, 1.0, 8.0), Physics.Transform3D(position:Math.Vec3(0.0, -0.5, 0.0)))
    obstacle(world, Math.Vec3(0.1, 4.0, 8.0), Physics.Transform3D(position:Math.Vec3(2.0, 2.0, 0.0)))
    var mover = Physics.CharacterMover3D(Physics.CharacterMover3DSettings() ..step_height = 0.0)
    let slide = mover.calculate_move(world, Math.Vec3(0.0, 0.852, 0.0), Math.Vec3(5.0, 0.0, 1.0), true)
    assert(slide.grounded && Math.abs(slide.position.x - 1.648) < 0.0001)
    assert(Math.abs(slide.position.z - 1.0) < 0.0001)
    assert(slide.clip_velocity(Math.Vec3(5.0, 0.0, 1.0)).nearly_equal(Math.Vec3(0.0, 0.0, 1.0), 0.0001))
    obstacle(world, Math.Vec3(8.0, 4.0, 0.1), Physics.Transform3D(position:Math.Vec3(0.0, 2.0, 2.0)))
    let corner = mover.calculate_move(world, Math.Vec3(0.0, 0.852, 0.0), Math.Vec3(5.0, 0.0, 5.0), true)
    assert(corner.grounded && corner.position.nearly_equal(Math.Vec3(1.648, 0.852, 1.648), 0.0002))
    obstacle(world, Math.Vec3(8.0, 0.2, 8.0), Physics.Transform3D(position:Math.Vec3(0.0, 2.1, 0.0)))
    let ceiling = mover.calculate_move(world, Math.Vec3(0.0, 0.852, 0.0), Math.Vec3(0.0, 5.0, 0.0), true)
    assert(!ceiling.grounded && Math.abs(ceiling.position.y - 1.148) < 0.0001)
    assert(ceiling.clip_velocity(Math.Vec3(0.0, 5.0, 0.0)).length() < 0.0001)
}
func stairs(height:float, ceiling:bool, expected:bool) {
    var world = Physics.World3D()
    obstacle(world, Math.Vec3(12.0, 1.0, 8.0), Physics.Transform3D(position:Math.Vec3(0.0, -0.5, 0.0)))
    obstacle(world, Math.Vec3(4.0, height, 4.0), Physics.Transform3D(position:Math.Vec3(3.0, height * 0.5, 0.0)))
    if ceiling {
        obstacle(world, Math.Vec3(4.0, 0.2, 4.0), Physics.Transform3D(position:Math.Vec3(2.0, 1.9, 0.0)))
    }
    var mover = Physics.CharacterMover3D()
    var position = Math.Vec3(0.0, 0.852, 0.0)
    var stepped = false
    var step = 0
    while step < 120 {
        let result = mover.calculate_move(world, position, Math.Vec3(0.02, 0.0, 0.0), true)
        assert(result.position.x - position.x <= 0.0201)
        position = result.position
        stepped = stepped || result.stepped
        step++
    }
    print("convex stair height=$(height) ceiling=$(ceiling) x=$(position.x) y=$(position.y) stepped=$(stepped)")
    assert(stepped == expected)
    if expected { assert(position.x > 2.0 && Math.abs(position.y - height - 0.852) < 0.0001) }
    else { assert(position.x < 1.0 && position.y < 0.86) }
}
func walking(reverse:bool, yaw:float = 0.0) {
    var world = Physics.World3D()
    let pose = Physics.Transform3D(position:Math.Vec3(4.0, 0.0, -2.0), rotation:Math.Quat.angle_axis(yaw, Math.Vec3.up()))
    let floor_shape = wedge()
    var floor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed ..shape = floor_shape ..transform = pose)
    var mover = Physics.CharacterMover3D(Physics.CharacterMover3DSettings() ..step_height = 0.0)
    var position = pose.point(Math.Vec3(0.0, 0.6, -2.0))
    var speed = 2.0
    if reverse { position = pose.point(Math.Vec3(0.0, 1.5, 2.0)); speed = -2.0 }
    var oracle_y:float[] = [0.48184368, 0.599490821, 0.717138052, 0.834785104]
    var oracle_z:float[] = [-1.50980341, -1.03921509, -0.568626761, -0.0980384126]
    if reverse {
        oracle_y = [1.23404145, 1.10904133, 0.984041691, 0.859041452]
        oracle_z = [1.49898708, 0.998987556, 0.498988003, -0.00101218]
    }
    var grounded = false
    var velocity = Math.Vec3()
    var step = 0
    while step < 120 {
        let intent = pose.vector(Math.Vec3(0.0, 0.0, speed))
        velocity.x = intent.x; velocity.z = intent.z
        if grounded { velocity.y = 0.0 } else { velocity.y -= 9.81 / 120.0 }
        let result = mover.calculate_move(world, position, velocity.divide(120.0), grounded)
        if grounded {
            assert(Math.Vec2(result.position.x - position.x, result.position.z - position.z).length() <= Math.abs(speed) / 120.0 + 0.0001)
        }
        position = result.position
        velocity = result.clip_velocity(velocity)
        grounded = result.grounded
        let local_position = pose.inverse_point(position)
        assert(Math.abs(local_position.x) < 0.001)
        if step > 30 {
            assert(grounded)
            if let support = result.support() { assert(support.same_body(floor)) } else { assert(false) }
            let distance = Physics.Geometry3D.distance(capsule_at(position), Physics.ShapePlacement3D(floor_shape, pose))
            assert(distance.separation > 0.0018 && distance.separation < 0.0022)
            assert(result.ground_normal.nearly_equal(pose.vector(Math.Vec3(0.0, 1.0, -0.25).normalized()), 0.0002))
        }
        if step % 30 == 29 {
            assert(grounded)
            assert(Math.abs(local_position.y - oracle_y[step / 30]) < 0.005)
            assert(Math.abs(local_position.z - oracle_z[step / 30]) < 0.005)
            assert(Math.abs(local_position.y - 0.25 * local_position.z - 0.55 - 0.302 * Math.sqrt(1.0625)) < 0.0002)
            print("walk reverse=$(reverse) yaw=$(yaw) step=$(step + 1) y=$(local_position.y) z=$(local_position.z) grounded=$(grounded)") }
        step++
    }
    if reverse { assert(pose.inverse_point(position).z < 0.1) }
    else { assert(pose.inverse_point(position).z > -0.15) }
}
func steep() {
    var world = Physics.World3D()
    let shape = wedge(Math.sqrt(3.0))
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed ..shape = shape)
    var mover = Physics.CharacterMover3D(Physics.CharacterMover3DSettings() ..step_height = 0.0)
    let height = -Math.sqrt(3.0) + 0.55 + (0.3 + 0.002) * 2.0
    let position = Math.Vec3(0.0, height, -1.0)
    let horizontal = mover.calculate_move(world, position, Math.Vec3(0.0, 0.0, 0.1))
    assert(!horizontal.grounded && Math.abs(horizontal.position.y - height) < 0.0001)
    assert(horizontal.position.z < -0.999)
    let downhill = mover.calculate_move(world, position, Math.Vec3(0.0, -0.1, 0.0))
    assert(!downhill.grounded && downhill.position.y < height && downhill.position.z < -1.0)
    let mixed = mover.calculate_move(world, position, Math.Vec3(0.0, -0.01, 0.1))
    assert(!mixed.grounded && mixed.position.y <= height + 0.0001)
}
func filtering() {
    var world = Physics.World3D()
    var floor = obstacle(world, Math.Vec3(8.0, 1.0, 8.0), Physics.Transform3D(position:Math.Vec3(0.0, -0.5, 0.0)))
    var mover = Physics.CharacterMover3D()
    let landed = mover.calculate_move(world, Math.Vec3(0.0, 3.0, 0.0), Math.Vec3(0.0, -5.0, 0.0))
    floor.set_sensor(true)
    let sensor = mover.calculate_move(world, landed.position, Math.Vec3(0.0, -2.0, 0.0), true)
    assert(!sensor.grounded && sensor.support() == null && sensor.position.y < 0.0)
    floor.set_sensor(false)
    floor.set_enabled(false)
    let disabled = mover.calculate_move(world, landed.position, Math.Vec3(), true)
    assert(!disabled.grounded && disabled.support() == null)
    floor.set_enabled(true)
    floor.set_collision_filter(Physics.CollisionFilter3D(category_bits:2))
    var filtered = Physics.CharacterMover3D(Physics.CharacterMover3DSettings()
        ..filter = Physics.QueryFilter3D(mask_bits:1, include_sensors:false))
    let excluded = filtered.calculate_move(world, landed.position, Math.Vec3(), true)
    assert(!excluded.grounded && excluded.support() == null)
    let edge = mover.calculate_move(world, landed.position, Math.Vec3(5.0, 0.0, 0.0), true)
    assert(!edge.grounded && edge.support() == null && Math.abs(edge.position.x - 5.0) < 0.0001)
}
func equivalent_boxes() {
    var hull_world = Physics.World3D()
    var box_world = Physics.World3D()
    let pose = Physics.Transform3D(position:Math.Vec3(0.0, 0.0, 0.0), rotation:Math.Quat.angle_axis(0.35, Math.Vec3.up()))
    obstacle(hull_world, Math.Vec3(4.0, 2.0, 4.0), pose)
    obstacle(box_world, Math.Vec3(4.0, 2.0, 4.0), pose, false)
    var hull_mover = Physics.CharacterMover3D()
    var box_mover = Physics.CharacterMover3D()
    let starts:Math.Vec3[] = [Math.Vec3(0.0, 3.0, 0.0), Math.Vec3(-4.0, 1.0, 0.0), Math.Vec3(0.0, 1.75, 0.0)]
    let moves:Math.Vec3[] = [Math.Vec3(0.0, -5.0, 0.0), Math.Vec3(8.0, 0.0, 2.0), Math.Vec3()]
    var index = 0
    while index < starts.count() {
        let actual = hull_mover.calculate_move(hull_world, starts[index], moves[index])
        let expected = box_mover.calculate_move(box_world, starts[index], moves[index])
        print("equivalence index=$(index) convex=$(actual.position.x),$(actual.position.y),$(actual.position.z) box=$(expected.position.x),$(expected.position.y),$(expected.position.z)")
        assert(actual.position.nearly_equal(expected.position, 0.0002))
        assert(actual.grounded == expected.grounded && actual.stepped == expected.stepped)
        index++
    }
}
test "character slides on convex thin walls corners and ceilings" { walls() }
test "convex stair respects height ceiling and travel budget" { stairs(0.25, false, true); stairs(0.6, false, false); stairs(0.25, true, false) }
test "character walks a convex wedge in both directions" { walking(false); walking(true) }
test "character wedge path preserves yaw and support normals" { walking(false, 0.7); walking(true, 0.7) }
test "steep convex face blocks ascent but allows downhill gravity" { steep() }
test "character convex support respects sensors and disabled bodies" { filtering() }
test "convex and box character paths agree on identical solids" { equivalent_boxes() }
