use GFX.Physics
use STD.Math

func body_settings(position:Math.Vec3) Physics.RigidBody3DSettings {
    return Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.sphere(Physics.Sphere3D(0.01))
        ..transform=Physics.Transform3D(position) ..allow_sleep=false
        ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
        ..linear_damping=0.0 ..angular_damping=0.0 ..friction=0.0
}
func probe(world:Physics.World3D, position:Math.Vec3, width:float=0.4,
    tire:Physics.Tire3DSettings?=null, steering:float=0.0) Physics.WheeledVehicle3D {
    var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(body_settings(position),
        [Physics.Wheel3DSettings(Math.Vec3(),contact:Physics.WheelContact3D.cylinder(width),
            tire:tire,maximum_steering_angle:Math.half_pi(),maximum_slope_angle:0.0)]))
    vehicle.set_controls(steering:steering)
    return vehicle
}
func box(world:Physics.World3D, size:Math.Vec3, position:Math.Vec3) Physics.RigidBody3D {
    return world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.box(Physics.Box3D(size)) ..transform=Physics.Transform3D(position))
}

test "cylinder width reaches a lateral edge and narrow wheels miss" {
    for rate in [60,120] {
        let widths:float[]=[0.1,0.4]
        for width in widths {
            var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
            var ground=box(world,Math.Vec3(1.0,0.1,2.0),Math.Vec3(0.0,-0.05,0.0))
            var vehicle=probe(world,Math.Vec3(0.65,0.75,0.0),width)
            world.step(1.0/rate as float);let wheel=vehicle.wheel(0)
            assert((wheel.support()!=null)==(width>0.3))
            if width>0.3 {
                assert(wheel.support()!.same_body(ground));assert(Math.abs(wheel.length-0.45)<0.0001)
                assert(wheel.contact_normal.nearly_equal(Math.Vec3.up(),0.0001))
                assert(wheel.contact_point.x>=0.45 && wheel.contact_point.x<=0.50001)
            }
            assert(world.body_count()==2)
            world.destroy_wheeled_vehicle(vehicle);assert(!vehicle.is_valid() && world.body_count()==1)
        }
    }
}

test "cylinder steering changes the axle before its first contact search" {
    for rate in [60,120] {
        let inputs:float[]=[0.0,1.0]
        for input in inputs {
            var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
            box(world,Math.Vec3(1.0,0.1,2.0),Math.Vec3(0.0,-0.05,0.0))
            var vehicle=probe(world,Math.Vec3(0.75,0.75,0.0),steering:input)
            world.step(1.0/rate as float)
            assert((vehicle.wheel(0).support()!=null)==(input==1.0))
        }
    }
}

test "cylinder camber follows tire axes and does not apply ray slope filtering" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.plane(Physics.Plane3D()))
    let up=Math.Quat.angle_axis(0.4,Math.Vec3(0.0,0.0,1.0)).rotate(Math.Vec3.up())
    var vehicle=probe(world,Math.Vec3(0.0,0.8,0.0),tire:Physics.Tire3DSettings(up:up))
    world.step(1.0/120.0)
    assert(Math.abs(vehicle.wheel(0).length-(0.8-0.2*Math.sin(0.4)-0.3*Math.cos(0.4)))<0.0001)
    world.destroy_wheeled_vehicle(vehicle)
    let rotation=Math.Quat.angle_axis(Math.radians(20.0),Math.Vec3(0.0,0.0,1.0))
    var inclined=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    inclined.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..transform=Physics.Transform3D(rotation:rotation))
    var v=probe(inclined,Math.Vec3(0.0,0.8,0.0));inclined.step(1.0/120.0)
    assert(v.wheel(0).support()!=null)
    assert(v.wheel(0).contact_normal.nearly_equal(rotation.rotate(Math.Vec3.up()),0.0001))
}

test "initial cylindrical overlap selects the deepest compound leaf" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    let shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(3.0,0.1,3.0)))
    var ground=world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.compound(Physics.Compound3D([
            Physics.CompoundChild3D(1,shape,Physics.Transform3D(Math.Vec3(0.0,-0.05,0.0))),
            Physics.CompoundChild3D(2,shape,Physics.Transform3D(Math.Vec3(0.0,0.05,0.0)))])))
    var vehicle=probe(world,Math.Vec3(0.0,0.2,0.0));world.step(1.0/120.0)
    assert(vehicle.wheel(0).support()!.same_body(ground))
    assert(vehicle.wheel(0).length==0.0 && Math.abs(vehicle.wheel(0).contact_point.y-0.1)<0.0001)
}

test "cylindrical supports obey filters pause disable and destruction" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    var ground=box(world,Math.Vec3(5.0,0.1,5.0),Math.Vec3(0.0,-0.05,0.0))
    var sensor=box(world,Math.Vec3(5.0,0.1,5.0),Math.Vec3(0.0,0.1,0.0));sensor.set_sensor(true)
    var excluded=box(world,Math.Vec3(5.0,0.1,5.0),Math.Vec3(0.0,0.2,0.0));excluded.set_collision_filter(Physics.CollisionFilter3D(category_bits:2,mask_bits:0))
    var vehicle=probe(world,Math.Vec3(0.0,0.8,0.0));world.step(1.0/120.0)
    assert(vehicle.wheel(0).support()!.same_body(ground))
    let force=vehicle.wheel(0).normal_force;world.step(0.0);assert(vehicle.wheel(0).normal_force==force)
    ground.set_enabled(false);world.step(1.0/120.0);assert(vehicle.wheel(0).support()==null)
    vehicle.chassis().set_enabled(false);world.step(1.0/120.0);assert(vehicle.wheel(0).normal_force==0.0)
    world.destroy_wheeled_vehicle(vehicle);assert(!vehicle.is_valid())
}

test "cylindrical suspension exchanges equal opposite impulses with dynamic support" {
    for rate in [60,120] {
        var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
        var platform=world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(5.0,0.1,5.0)))
            ..mass_properties=Physics.MassProperties3D(200.0,Math.Vec3(100.0))
            ..allow_sleep=false ..linear_damping=0.0 ..angular_damping=0.0 ..friction=0.0)
        var config=body_settings(Math.Vec3(0.0,0.75,0.0))
        config.mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0),Math.Vec3(0.2,0.0,0.1))
        var wheels:Physics.Wheel3DSettings[]=[];let sides:float[]=[-1.0,1.0]
        for x in sides { for z in sides { wheels.append(Physics.Wheel3DSettings(Math.Vec3(x*0.6,0.0,z),contact:Physics.WheelContact3D.cylinder(0.4))) } }
        var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(config,wheels))
        var step=0
        while step<rate {
            world.step(1.0/rate as float)
            let momentum=platform.linear_velocity().multiply(200.0).add(vehicle.chassis().linear_velocity().multiply(100.0))
            let angular=platform.angular_velocity().multiply(100.0).add(vehicle.chassis().angular_velocity().multiply(100.0))
                .add(platform.world_center_of_mass().cross(platform.linear_velocity().multiply(200.0)))
                .add(vehicle.chassis().world_center_of_mass().cross(vehicle.chassis().linear_velocity().multiply(100.0)))
            assert(momentum.length()<0.002 && angular.length()<0.002)
            step++
        }
        assert(platform.position().y< -0.05 && vehicle.chassis().position().y>0.8)
    }
}
