use GFX.Physics
use STD.Math

func load_test(rate:int,constrained:bool,reversed:bool) {
    var world=Physics.World3D()
    let mass=200.0
    let settings=Physics.RigidBody3DSettings()
        ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(8.0,0.4,12.0)))
        ..transform=Physics.Transform3D(Math.Vec3(0.0,-0.2,0.0)) ..friction=1.0 ..allow_sleep=false
        ..linear_damping=0.0 ..angular_damping=0.0
        ..mass_properties=Physics.MassProperties3D(mass,Math.Vec3(mass*(0.16+144.0)/12.0,mass*(64.0+144.0)/12.0,mass*(64.0+0.16)/12.0))
    var selected:Physics.RigidBody3D?=null
    if reversed { selected=world.create_rigid_body(settings) }
    var floor=world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..transform=Physics.Transform3D(Math.Vec3(0.0,-0.4,0.0)) ..friction=0.0)
    if !reversed { selected=world.create_rigid_body(settings) }
    if constrained {
        var unrelated=world.create_rigid_body(Physics.RigidBody3DSettings()
            ..transform=Physics.Transform3D(Math.Vec3(50.0,10.0,50.0)) ..gravity_scale=0.0 ..allow_sleep=false
            ..collision_filter=Physics.CollisionFilter3D(mask_bits:0))
        var joint=world.create_fixed_constraint(floor,unrelated)
    }
    if let body=selected {
        var step=0
        while step<6*rate {
            body.apply_force(Math.Vec3(0.0,-981.0,0.0),body.transform().point(Math.Vec3(0.0,0.2,-2.0)))
            if step==2*rate { body.apply_impulse(Math.Vec3(0.0,0.0,400.0)) }
            if step==4*rate { body.apply_impulse(Math.Vec3(0.0,0.0,-400.0)) }
            world.step(1.0/rate as float);step++
            if step>5*rate {
                assert(Math.abs(body.position().y+0.2)<0.001)
                assert(body.linear_velocity().length()<0.005 && body.angular_velocity().length()<0.005)
                var contacts:Physics.Contact3D[]=[];world.write_contacts(contacts)
                assert(contacts.count()==1 && contacts[0].point_count()==4)
                assert(Math.abs(contacts[0].normal_impulse()*rate as float-2943.0)<1.0)
            }
        }
        assert(Math.abs(body.position().z-4.0)<0.001)
    } else { panic("missing loaded plane body") }
}

test "wide box preserves its plane contact patch under an eccentric load and sliding impulses" {
    for rate in [60,120] { for constrained in [false,true] { for reversed in [false,true] {
        load_test(rate,constrained,reversed)
    } } }
}

test "nearby plane face points permit approach before they carry a tilted box" {
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=Math.Vec3())
    var floor=world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=0.0)
    let angle=0.02
    var body=world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.4)))
        ..mass_properties=Physics.MassProperties3D(1.0,Math.Vec3(0.026666667))
        ..transform=Physics.Transform3D(Math.Vec3(0.0,0.2*(Math.cos(angle)+Math.sin(angle)),0.0),Math.Quat.angle_axis(angle,Math.Vec3.right()))
        ..linear_velocity=Math.Vec3(0.0,-0.01,0.0) ..linear_damping=0.0 ..angular_damping=0.0 ..allow_sleep=false)
    world.step(1.0/120.0)
    assert(body.angular_velocity().x< -0.001)
    var contacts:Physics.Contact3D[]=[];world.write_contacts(contacts)
    assert(contacts.count()==1 && contacts[0].point_count()==4)
    var points:Physics.ContactPoint3D[]=[];contacts[0].write_points(points)
    var approaching=0;var carrying=0
    for point in points {
        if point.position.y>0.001 { approaching++;assert(Math.abs(point.normal_impulse)<0.000001) }
        else if point.normal_impulse>0.000001 { carrying++ }
    }
    assert(approaching==2 && carrying==2)
}
