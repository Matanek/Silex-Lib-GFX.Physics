use GFX.Physics
use STD.Math

func advance_distance3d(world:Physics.World3D, steps:int) {
    var index = 0
    while index < steps {
        world.step(1.0 / 60.0)
        index++
    }
}

test "a fixed anchor holds a falling dynamic body at rigid length" {
    var world = Physics.World3D()
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 3.0, 0.0)))
    var weight = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 1.0, 0.0))
        ..allow_sleep = false)
    var tether = world.create_distance_constraint(
        anchor, weight, Physics.DistanceConstraint3DSettings(2.0))
    assert(world.distance_constraint_count() == 1)
    world.step(0.0)
    assert(tether.reaction_force().nearly_equal(Math.Vec3(), 0.000001))
    advance_distance3d(world, 120)
    assert(Math.abs(tether.current_length() - 2.0) < 0.002)
    assert(Math.abs(tether.reaction_force().y - weight.mass_properties().mass * 9.81) < 0.5)
    let reaction = tether.reaction_force()
    world.step(0.0)
    assert(tether.reaction_force().nearly_equal(reaction, 0.000001))
    world.destroy_distance_constraint(tether)
    assert(!tether.is_valid() && world.distance_constraint_count() == 0)
    let before = weight.position().y
    advance_distance3d(world, 10)
    assert(weight.position().y < before)
}

test "distance limits and body destruction invalidate only their joint" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var fixed = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(3.0, 0.0, 0.0))
        ..allow_sleep = false)
    var settings = Physics.DistanceConstraint3DSettings(2.0)
    settings.minimum_length = 1.0
    var joint = world.create_distance_constraint(fixed, moving, settings)
    advance_distance3d(world, 10)
    assert(joint.current_length() < 2.001 && joint.current_length() >= 1.0)
    let before_disabled = joint.current_length()
    joint.set_enabled(false)
    moving.set_linear_velocity(Math.Vec3(5.0, 0.0, 0.0))
    world.step(0.2)
    assert(joint.current_length() > before_disabled + 0.9)
    joint.set_limits(1.0, 2.0)
    joint.set_enabled(true)
    advance_distance3d(world, 30)
    assert(joint.current_length() <= 2.002)
    world.destroy_rigid_body(fixed)
    assert(!joint.is_valid() && world.distance_constraint_count() == 0)
}

test "unequal masses preserve their center while closing distance" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var light = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..mass_properties = Physics.MassProperties3D(1.0, Math.Vec3(0.4))
        ..allow_sleep = false)
    var heavy = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(4.0, 0.0, 0.0))
        ..mass_properties = Physics.MassProperties3D(4.0, Math.Vec3(1.6))
        ..allow_sleep = false)
    var joint = world.create_distance_constraint(
        light, heavy, Physics.DistanceConstraint3DSettings(2.0))
    advance_distance3d(world, 30)
    assert(Math.abs(joint.current_length() - 2.0) < 0.002)
    let center = (light.position().x + 4.0 * heavy.position().x) / 5.0
    assert(Math.abs(center - 3.2) < 0.0001)
    assert(light.position().x > 1.59 && heavy.position().x < 3.61)
}

test "off-center anchors transfer linear correction into rotation" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(2.5, 0.0, 0.0))
        ..allow_sleep = false)
    var settings = Physics.DistanceConstraint3DSettings(2.0)
    settings.second_local_anchor = Math.Vec3(0.0, 1.0, 0.0)
    var joint = world.create_distance_constraint(anchor, moving, settings)
    advance_distance3d(world, 60)
    assert(Math.abs(joint.current_length() - 2.0) < 0.003)
    assert(Math.abs(moving.rotation().z) > 0.01)
    assert(moving.position().x < 2.5)
}

test "distance and floor contacts act during the same step" {
    var world = Physics.World3D()
    var floor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(10.0, 1.0, 10.0))))
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 4.0, 0.0)))
    var weight = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 1.15, 0.0))
        ..allow_sleep = false)
    var joint = world.create_distance_constraint(
        anchor, weight, Physics.DistanceConstraint3DSettings(3.0))
    advance_distance3d(world, 120)
    assert(world.contact_count() >= 1)
    assert(weight.position().y > 0.99 && weight.position().y < 1.01)
    assert(Math.abs(joint.current_length() - 3.0) < 0.01)
    assert(floor.is_valid())
}

test "fixed distance supports sleeping and a command wakes the linked body" {
    var world = Physics.World3D()
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 3.0, 0.0)))
    var weight = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 1.0, 0.0)))
    var joint = world.create_distance_constraint(
        anchor, weight, Physics.DistanceConstraint3DSettings(2.0))
    advance_distance3d(world, 120)
    assert(!weight.is_awake())
    weight.apply_impulse(Math.Vec3(0.1, 0.0, 0.0))
    world.step(1.0 / 60.0)
    assert(weight.is_awake())
    assert(joint.current_length() < 2.01)
}

test "range stops outward motion at both exact boundaries" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    var body = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(2.0, 0.0, 0.0))
        ..allow_sleep = false)
    var settings = Physics.DistanceConstraint3DSettings(2.0)
    settings.minimum_length = 1.0
    var joint = world.create_distance_constraint(anchor, body, settings)
    body.set_linear_velocity(Math.Vec3(5.0, 0.0, 0.0))
    world.step(1.0 / 60.0)
    assert(joint.current_length() <= 2.001)
    body.set_transform(Physics.Transform3D(position:Math.Vec3(1.0, 0.0, 0.0)))
    body.set_linear_velocity(Math.Vec3(-5.0, 0.0, 0.0))
    world.step(1.0 / 60.0)
    assert(joint.current_length() >= 0.999)
}

test "waking one member reaches a linked dynamic chain" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var first = world.create_rigid_body()
    var middle = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(2.0, 0.0, 0.0)))
    var last = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(4.0, 0.0, 0.0)))
    world.create_distance_constraint(first, middle,
        Physics.DistanceConstraint3DSettings(2.0))
    world.create_distance_constraint(middle, last,
        Physics.DistanceConstraint3DSettings(2.0))
    advance_distance3d(world, 60)
    assert(!first.is_awake() && !middle.is_awake() && !last.is_awake())
    first.apply_impulse(Math.Vec3(0.0, 0.2, 0.0))
    world.step(1.0 / 60.0)
    assert(first.is_awake() && middle.is_awake() && last.is_awake())
}

test "kinematic anchor motion wakes a sleeping linked dynamic body" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.kinematic)
    var weight = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(2.0, 0.0, 0.0)))
    var joint = world.create_distance_constraint(anchor, weight,
        Physics.DistanceConstraint3DSettings(2.0))
    advance_distance3d(world, 60)
    assert(!weight.is_awake())
    anchor.move_kinematic(Physics.Transform3D(position:Math.Vec3(0.0, 1.0, 0.0)), 1.0)
    world.step(1.0 / 60.0)
    assert(weight.is_awake())
    assert(Math.abs(joint.current_length() - 2.0) < 0.01)
}

func orphan_distance3d() Physics.DistanceConstraint3D {
    var world = Physics.World3D()
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    var body = world.create_rigid_body()
    return world.create_distance_constraint(anchor, body,
        Physics.DistanceConstraint3DSettings(1.0))
}

test "world lifetime invalidates retained distance handles" {
    var joint = orphan_distance3d()
    assert(!joint.is_valid())
}
