use GFX.Physics
use STD.Math

// Sensors expose the contact candidate set without moving the reference poses.
test "world contacts match exhaustive distances for rotated mixed shapes" {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var bodies:Physics.RigidBody3D[] = []
    var index = 0
    while index < 24 {
        var body_type = Physics.BodyType3D.dynamic
        var shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(2.4, 0.2, 0.5)))
        if index % 4 == 1 {
            shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.35))
        } else if index % 4 == 2 {
            shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.2, 0.8))
        } else if index % 4 == 3 {
            body_type = Physics.BodyType3D.fixed
            shape = Physics.Shape3D.compound(Physics.Compound3D([
                Physics.CompoundChild3D(7,
                    Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.5))),
                    Physics.Transform3D(position:Math.Vec3(1.1, 0.0, 0.0))),
                Physics.CompoundChild3D(9,
                    Physics.Shape3D.sphere(Physics.Sphere3D(0.3)),
                    Physics.Transform3D(position:Math.Vec3(-0.7, 0.0, 0.0)))
            ]))
        }
        bodies.append(world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape = shape
            ..body_type = body_type
            ..is_sensor = true
            ..transform = Physics.Transform3D(
                position:Math.Vec3((index % 4) as float * 0.75,
                    ((index / 4) % 3) as float * 0.6,
                    (index / 12) as float * 0.7),
                rotation:Math.Quat.angle_axis(index as float * 0.37,
                    Math.Vec3(1.0, 2.0, 3.0).normalized())
            )))
        index++
    }
    world.step(1.0 / 60.0)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    var expected_count = 0
    var first = 0
    while first < bodies.count() {
        var second = first + 1
        while second < bodies.count() {
            let distance = Physics.Geometry3D.distance(
                Physics.ShapePlacement3D(bodies[first].shape(), bodies[first].transform()),
                Physics.ShapePlacement3D(bodies[second].shape(), bodies[second].transform())
            )
            var found = false
            for contact in contacts {
                if contact.first_body().same_body(bodies[first]) &&
                    contact.second_body().same_body(bodies[second]) {
                    assert(!found)
                    found = true
                    assert(Math.abs(contact.separation() - distance.separation) < 0.000001)
                }
            }
            let expected = distance.separation <= 0.000001 &&
                !(first % 4 == 3 && second % 4 == 3)
            assert(found == expected)
            if expected { expected_count++ }
            second++
        }
        first++
    }
    assert(expected_count > 10)
    assert(contacts.count() == expected_count)
}

test "box candidate pruning preserves the positive contact tolerance on every axis" {
    var axis = 0
    while axis < 3 {
        var direction = Math.Vec3.right()
        if axis == 1 { direction = Math.Vec3.up() }
        if axis == 2 { direction = Math.Vec3.back() }
        var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
        world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
            ..is_sensor = true)
        var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
            ..transform = Physics.Transform3D(position:direction.multiply(1.0000005)))
        world.step(1.0 / 60.0)
        assert(world.contact_count() == 1)
        moving.set_transform(Physics.Transform3D(position:direction.multiply(1.000002)))
        world.step(1.0 / 60.0)
        assert(world.contact_count() == 0)
        axis++
    }
}
