use GFX.Physics
use STD.Math

test "a tilted box has no support points floating above a broad floor" {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(8.0, 0.5, 8.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, -0.25, 0.0)))
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.8)))
        ..transform = Physics.Transform3D(
            position:Math.Vec3(0.0, 0.48, 0.0),
            rotation:Math.Quat.angle_axis(0.24, Math.Vec3.back())
        ))
    world.step(1.0 / 60.0)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts.count() == 1)
    assert(contacts[0].point_count() == 2)
    var points:Physics.ContactPoint3D[] = []
    contacts[0].write_points(points)
    for point in points {
        assert(Math.abs(point.position.y) < 0.02)
        assert(Math.abs(point.position.x) < 0.5)
        assert(Math.abs(point.position.z) < 0.5)
    }
}

test "tilted support uses the same manifold when the floor is second" {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.8)))
        ..transform = Physics.Transform3D(
            position:Math.Vec3(0.0, 0.48, 0.0),
            rotation:Math.Quat.angle_axis(0.24, Math.Vec3.back())
        ))
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(8.0, 0.5, 8.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, -0.25, 0.0)))
    world.step(1.0 / 60.0)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts.count() == 1)
    assert(contacts[0].point_count() == 2)
    var points:Physics.ContactPoint3D[] = []
    contacts[0].write_points(points)
    for point in points {
        assert(Math.abs(point.position.y) < 0.02)
        assert(Math.abs(point.position.x) < 0.5)
        assert(Math.abs(point.position.z) < 0.5)
    }
}

test "scene sized boxes settle on a broad floor" {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(8.0, 0.5, 8.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, -0.25, 0.0)))
    var bodies:Physics.RigidBody3D[] = []
    var index = 0
    while index < 3 {
        bodies.append(world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.8)))
            ..transform = Physics.Transform3D(
                position:Math.Vec3(index as float * 1.2 - 1.2,
                    2.4 + index as float * 1.2, 0.0),
                rotation:Math.Quat.angle_axis(
                    index as float * 0.12, Math.Vec3.back()
                )
            )))
        index++
    }
    var step = 0
    while step < 600 {
        world.step(1.0 / 60.0)
        step++
    }
    for body in bodies {
        let pose = body.position()
        let rotation = body.rotation()
        assert(Math.abs(pose.y - 0.4) < 0.02)
        assert(body.linear_velocity().length() < 0.02)
        assert(body.angular_velocity().length() < 0.02)
        let vertical = Math.max(
            Math.abs(rotation.rotate(Math.Vec3.right()).y),
            Math.max(
                Math.abs(rotation.rotate(Math.Vec3.up()).y),
                Math.abs(rotation.rotate(Math.Vec3.back()).y)
            )
        )
        assert(vertical > 0.98)
    }
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts.count() == 3)
    for contact in contacts {
        let center = contact.second_body().position()
        let point = contact.point()
        assert(Math.abs(point.x - center.x) < 0.6)
        assert(Math.abs(point.y) < 0.02)
        assert(Math.abs(point.z - center.z) < 0.6)
    }
}

test "a 128-box column does not sink through its floor" {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(24.0, 0.5, 24.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, -0.25, 0.0)))
    var bodies:Physics.RigidBody3D[] = []
    var index = 0
    while index < 128 {
        let column = index % 4
        let row = (index / 4) % 4
        let layer = index / 16
        bodies.append(world.create_rigid_body(Physics.RigidBody3DSettings()
            ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.3)))
            ..transform = Physics.Transform3D(position:Math.Vec3(
                (column as float - 1.5) * 0.31 + layer as float * 0.025,
                0.16 + layer as float * 0.31,
                (row as float - 1.5) * 0.31
            ))
            ..allow_sleep = false
            ..friction = 0.6))
        index++
    }
    var step = 0
    while step < 60 {
        world.step(1.0 / 60.0)
        step++
    }
    assert(world.contact_count() > 0)
    for body in bodies {
        assert(body.position().y >= 0.14)
    }
}
