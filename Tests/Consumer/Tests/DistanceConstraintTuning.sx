use GFX.Physics
use STD.Math

test "configure distance constraint softness independently of the spring" {
    let defaults = Physics.DistanceJoint2DSettings()
    assert(defaults.constraint_hertz == 60.0)
    assert(defaults.constraint_damping_ratio == 2.0)
    var world = Physics.World2D(gravity:Math.Vec2())
    var ground = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed)
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(1.0, 0.0))
    var joint = world.create_distance_joint(ground, body,
        Physics.DistanceJoint2DSettings()
            ..second_anchor = Math.Vec2(1.0, 0.0)
            ..length = 1.0
            ..constraint_hertz = 5.0
            ..constraint_damping_ratio = 4.0)
    assert(joint.constraint_hertz() == 5.0)
    assert(joint.constraint_damping_ratio() == 4.0)
    joint.set_spring(true, 7.0, 0.8)
    joint.set_limits(true, 0.5, 2.0)
    joint.set_motor(1.5, 20.0)
    joint.set_constraint_tuning(8.0, 3.0)
    assert(joint.constraint_hertz() == 8.0)
    assert(joint.constraint_damping_ratio() == 3.0)
    assert(joint.spring_enabled())
    assert(joint.spring_hertz() == 7.0)
    assert(joint.spring_damping_ratio() == 0.8)
    assert(joint.limits_enabled())
    assert(joint.minimum_length() == 0.5)
    assert(joint.maximum_length() == 2.0)
    assert(joint.motor_enabled())
    assert(joint.motor_speed() == 1.5)
    assert(joint.maximum_motor_force() == 20.0)
    joint.set_spring(false, 0.0, 0.0)
    joint.set_limits(false, 0.0, 2.0)
    joint.set_motor_enabled(false)
    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        step++
    }
    assert(!body.is_awake())
    joint.set_constraint_tuning(0.0, 0.0)
    assert(body.is_awake())
    assert(joint.constraint_hertz() == 0.0)
    assert(joint.constraint_damping_ratio() == 0.0)
}

test "report the distance reaction using the substep duration" {
    var substeps = 1
    while substeps <= 8 {
        var world = Physics.World2D(gravity:Math.Vec2(2.0, 0.0))
        var ground = world.create_rigid_body(Physics.RigidBody2DSettings()
            ..body_type = Physics.BodyType2D.fixed)
        var body = world.create_rigid_body(Physics.RigidBody2DSettings()
            ..position = Math.Vec2(1.0, 0.0)
            ..mass = 1.0
            ..allow_sleep = false)
        var joint = world.create_distance_joint(ground, body,
            Physics.DistanceJoint2DSettings()
                ..second_anchor = Math.Vec2(1.0, 0.0)
                ..length = 1.0)
        world.step(1.0 / 60.0, substeps)
        assert(Math.abs(joint.constraint_force().x + 2.0) < 0.002)
        assert(Math.abs(body.velocity().x) < 0.001)
        substeps *= 2
    }
}
