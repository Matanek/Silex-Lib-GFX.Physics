use GFX.Physics
use STD.Math
use STD.Threading

func first_collider(body:Physics.RigidBody2D) Physics.Collider2D {
    var colliders:Physics.Collider2D[] = []
    body.write_colliders(colliders)
    assert(colliders.count() > 0)
    return colliders[0]
}

func query_body(
    world:&Physics.World2D,
    label:str,
    shape:Physics.Shape2D,
    position:Math.Vec2,
    filter:Physics.CollisionFilter2D = Physics.CollisionFilter2D(),
    enabled:bool = true
) Physics.RigidBody2D {
    return world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = shape
        ..position = position
        ..collision_filter = filter
        ..debug_label = label
        ..is_enabled = enabled
    )
}

class ParallelQueryResults {
    var fractions:float[]

    func write(index:int, value:float) { self.fractions[index] = value }
}

struct ParallelWorldQueries:Threading.ParallelJob {
    var world:Physics.World2D
    var results:ParallelQueryResults

    func execute(start:int, end:int) {
        var index = start
        while index < end {
            var hit = self.world.ray_cast_closest(Physics.Ray2D(
                Math.Vec2(-4.0, index as float * 0.001),
                Math.Vec2(8.0, 0.0)
            ))
            self.results.write(index, hit.fraction)
            index++
        }
    }
}

test "query collider geometry in local and world space" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var body = query_body(
        world,
        "circle",
        Physics.Shape2D.circle(Physics.Circle2D(0.5)),
        Math.Vec2(2.0, 1.0)
    )
    var collider = first_collider(body)
    let bounds = collider.world_aabb()
    let local_hit = collider.ray_cast_local(Physics.Ray2D(
        Math.Vec2(-2.0, 0.0),
        Math.Vec2(4.0, 0.0)
    ))
    let mass = collider.mass_properties()

    assert(collider.transform().position == Math.Vec2(2.0, 1.0))
    assert(bounds.center().nearly_equal(Math.Vec2(2.0, 1.0), 0.000001))
    assert(bounds.half_size().nearly_equal(Math.Vec2(0.5), 0.000001))
    assert(body.world_aabb().center().nearly_equal(
        bounds.center(), 0.000001
    ))
    assert(collider.test_point(Math.Vec2(2.25, 1.0)))
    assert(!collider.test_point(Math.Vec2(3.0, 1.0)))
    assert(collider.closest_point(Math.Vec2(3.0, 1.0)).nearly_equal(
        Math.Vec2(2.5, 1.0), 0.0001
    ))
    assert(local_hit.hit)
    assert(
        Math.nearly_equal(local_hit.fraction, 0.375, 0.002),
        "local ray fraction=$(local_hit.fraction)"
    )
    assert(Math.nearly_equal(mass.mass, Math.pi() * 0.25, 0.0001))
    assert(mass.local_center == Math.Vec2())
    assert(Math.nearly_equal(
        mass.rotational_inertia,
        mass.mass * 0.125,
        0.0001
    ))
}

test "write AABB overlaps in stable collider creation order" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var first = query_body(world, "first",
        Physics.Shape2D.circle(Physics.Circle2D(0.5)), Math.Vec2(-2.0, 0.0))
    var removed = query_body(world, "removed",
        Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0))), Math.Vec2())
    var third = query_body(world, "third",
        Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(-0.5, 0.0), Math.Vec2(0.5, 0.0), 0.25
        )), Math.Vec2(2.0, 0.0))
    var stale = first_collider(removed)
    world.destroy_collider(stale)
    var replacement = world.create_collider(removed, Physics.Collider2DSettings()
        ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
            Math.Vec2(-0.4, -0.4), Math.Vec2(0.4, -0.4),
            Math.Vec2(0.4, 0.4), Math.Vec2(-0.4, 0.4)
        ]))
    )
    var hits:Physics.Collider2D[] = [first_collider(first)]
    let stats = world.write_aabb_overlaps(
        Physics.AABB2D(Math.Vec2(), Math.Vec2(4.0, 1.0)),
        hits
    )

    assert(!stale.is_valid())
    assert(replacement.is_valid())
    assert(hits.count() == 3)
    assert(hits[0].body().debug_label() == "first")
    assert(hits[1].body().debug_label() == "third")
    assert(hits[2].body().debug_label() == "removed")
    assert(stats.visited_count == 3)
    assert(stats.candidate_count == 3)
    assert(stats.hit_count == 3)
    assert(world.aabb_overlaps_any(Physics.AABB2D(
        Math.Vec2(2.0, 0.0), Math.Vec2(0.1)
    )))
    world.destroy_collider(replacement)
    assert(!hits[2].is_valid())
}

test "apply a distinct query filter and ignore disabled colliders" {
    let selectable = Physics.CollisionFilter2D(
        category_bits:0x2,
        mask_bits:0xffff_ffff_ffff_ffff
    )
    var world = Physics.World2D(gravity:Math.Vec2())
    query_body(world, "selected",
        Physics.Shape2D.polygon(Physics.Polygon2D([
            Math.Vec2(-0.5, -0.5), Math.Vec2(0.5, -0.5),
            Math.Vec2(0.5, 0.5), Math.Vec2(-0.5, 0.5)
        ], 0.05)), Math.Vec2(),
        filter:selectable)
    query_body(world, "disabled",
        Physics.Shape2D.circle(Physics.Circle2D(0.5)), Math.Vec2(),
        filter:selectable, enabled:false)
    let query = Physics.ShapePlacement2D(
        Physics.Shape2D.circle(Physics.Circle2D(0.75))
    )
    var hits:Physics.Collider2D[] = []
    let stats = world.write_shape_overlaps(
        query,
        hits,
        Physics.QueryFilter2D(category_bits:0x1, mask_bits:0x2)
    )

    assert(hits.count() == 1)
    assert(hits[0].body().debug_label() == "selected")
    assert(stats.visited_count == 2)
    assert(stats.candidate_count == 1)
    assert(stats.hit_count == 1)
    assert(world.shape_overlaps_any(query,
        Physics.QueryFilter2D(category_bits:0x1, mask_bits:0x2)))
    assert(!world.shape_overlaps_any(query,
        Physics.QueryFilter2D(category_bits:0x1, mask_bits:0x4)))
}

test "collect ray hits by creation and select the closest fraction" {
    var world = Physics.World2D(gravity:Math.Vec2())
    query_body(world, "far",
        Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0))), Math.Vec2(3.0, 0.0))
    query_body(world, "near",
        Physics.Shape2D.circle(Physics.Circle2D(0.5)), Math.Vec2(1.0, 0.0))
    query_body(world, "middle",
        Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(0.0, -0.4), Math.Vec2(0.0, 0.4), 0.2
        )), Math.Vec2(2.0, 0.0))
    query_body(world, "chain",
        Physics.Shape2D.chain(Physics.Chain2D([
            Math.Vec2(0.0, 2.0), Math.Vec2(0.0, 1.0),
            Math.Vec2(0.0, -1.0), Math.Vec2(0.0, -2.0)
        ])), Math.Vec2(4.0, 0.0))
    let ray = Physics.Ray2D(Math.Vec2(-1.0, 0.0), Math.Vec2(7.0, 0.0))
    var hits:Physics.WorldCastResult2D[] = []
    let stats = world.write_ray_casts(ray, hits)
    var closest = world.ray_cast_closest(ray)

    assert(hits.count() == 4)
    assert(hits[0].collider().body().debug_label() == "far")
    assert(hits[1].collider().body().debug_label() == "near")
    assert(hits[2].collider().body().debug_label() == "middle")
    assert(hits[3].collider().body().debug_label() == "chain")
    assert(closest.hit)
    assert(closest.collider().body().debug_label() == "near")
    assert(Math.nearly_equal(closest.fraction, 1.5 / 7.0, 0.002))
    assert(world.ray_cast_any(ray))
    assert(stats.hit_count == 4)
}

test "collect shape casts and retain the nearest collider" {
    var world = Physics.World2D(gravity:Math.Vec2())
    query_body(world, "far",
        Physics.Shape2D.segment(Physics.Segment2D(
            Math.Vec2(0.0, -1.0), Math.Vec2(0.0, 1.0)
        )), Math.Vec2(3.0, 0.0))
    query_body(world, "near",
        Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.5, 2.0))),
        Math.Vec2(1.0, 0.0))
    let moving = Physics.ShapePlacement2D(
        Physics.Shape2D.circle(Physics.Circle2D(0.25)),
        Physics.Transform2D(position:Math.Vec2(-1.0, 0.0))
    )
    var hits:Physics.WorldCastResult2D[] = []
    let stats = world.write_shape_casts(moving, Math.Vec2(6.0, 0.0), hits)
    var closest = world.shape_cast_closest(moving, Math.Vec2(6.0, 0.0))

    assert(hits.count() == 2)
    assert(hits[0].collider().body().debug_label() == "far")
    assert(hits[1].collider().body().debug_label() == "near")
    assert(closest.collider().body().debug_label() == "near")
    assert(closest.fraction < hits[0].fraction)
    assert(world.shape_cast_any(moving, Math.Vec2(6.0, 0.0)))
    assert(stats.hit_count == 2)
}

test "share resting world query structures across workers" {
    var world = Physics.World2D(gravity:Math.Vec2())
    query_body(world, "target",
        Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0, 4.0))), Math.Vec2())
    var fractions:float[] = []
    var index = 0
    while index < 128 { fractions.append(0.0); index++ }
    var results = ParallelQueryResults(fractions:fractions)
    var executor = Threading.Executor(worker_count:4)
    var shared = executor
    var done = shared.submit_parallel(
        128,
        ParallelWorldQueries(world:world, results:results)
    )
    done.complete()

    for fraction in results.fractions {
        assert(Math.nearly_equal(fraction, 0.4375, 0.002))
    }
}
