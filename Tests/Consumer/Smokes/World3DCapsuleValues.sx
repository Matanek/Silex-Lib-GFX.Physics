use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(10.0, 1.0, 10.0))))
    var capsule = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.capsule(Physics.Capsule3D(0.25, 0.5))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 1.25, 0.0)))
    var step = 0
    while step < 120 {
        world.step(1.0 / 60.0)
        step++
    }
    assert(world.contact_count() == 1)
    assert(Math.abs(capsule.position().y - 1.25) < 0.02)
    assert(!capsule.is_awake())
}
