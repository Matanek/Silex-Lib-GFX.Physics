use GFX.Physics
use STD.Math
use STD.Process
func selected(expected:str) bool {
    match Process.arguments() {
        success(arguments) => { for argument in arguments { if argument==expected { return true } } }
        failure(error) => { panic(error.detail) }
    }
    return false
}
func main() {
    var world = Physics.World3D()
    var fixed = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed)
    var body = world.create_rigid_body();var settings = Physics.ConeConstraint3DSettings()
    if selected("anchor") { settings.first_local_anchor = Math.Vec3(Math.sqrt(-1.0),0.0,0.0) }
    if selected("axis-zero") { settings.first_local_axis = Math.Vec3() }
    if selected("axis-nan") { settings.second_local_axis = Math.Vec3(Math.sqrt(-1.0),0.0,0.0) }
    if selected("angle-negative") { settings.half_angle = -0.1 }
    if selected("angle-range") { settings.half_angle = 4.0 }
    if selected("angle-nan") { settings.half_angle = Math.sqrt(-1.0) }
    if selected("same") { world.create_cone_constraint(body,body) }
    if selected("fixed-fixed") { world.create_cone_constraint(fixed,world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed)) }
    if selected("foreign") { var other = Physics.World3D();world.create_cone_constraint(fixed,other.create_rigid_body()) }
    var joint = world.create_cone_constraint(fixed,body,settings)
    if selected("mutation-anchors") { joint.set_anchors(Math.Vec3(),Math.Vec3(Math.sqrt(-1.0),0.0,0.0)) }
    if selected("mutation-axes") { joint.set_axes(Math.Vec3(),Math.Vec3(0.0,0.0,1.0)) }
    if selected("mutation-angle") { joint.set_half_angle(4.0) }
    if selected("stale") { world.destroy_cone_constraint(joint);world.create_cone_constraint(fixed,body);joint.angle() }
    if selected("foreign-destroy") { var other = Physics.World3D();other.destroy_cone_constraint(joint) }
    if selected("stale-mutation") { world.destroy_cone_constraint(joint);joint.set_half_angle(0.2) }
    panic("invalid cone operation was accepted")
}
