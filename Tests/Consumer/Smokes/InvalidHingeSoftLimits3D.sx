use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match Process.arguments() {
        success(arguments) => { for argument in arguments { if argument==expected { return true } } }
        failure(error) => { panic(error.detail) }
    }
    return false
}
func orphan() Physics.HingeConstraint3D {
    var world = Physics.World3D()
    return world.create_hinge_constraint(world.create_rigid_body(),world.create_rigid_body())
}
func main() {
    let nan = Math.sqrt(-1.0);let inf = 1.0/0.0
    if selected("stiffness-zero") { Physics.HingeLimitSpring3D(0.0,0.8) }
    if selected("stiffness-negative") { Physics.HingeLimitSpring3D(-1.0,0.8) }
    if selected("stiffness-nan") { Physics.HingeLimitSpring3D(nan,0.8) }
    if selected("stiffness-inf") { Physics.HingeLimitSpring3D(inf,0.8) }
    if selected("damping-negative") { Physics.HingeLimitSpring3D(1.6,-1.0) }
    if selected("damping-nan") { Physics.HingeLimitSpring3D(1.6,nan) }
    if selected("damping-inf") { Physics.HingeLimitSpring3D(1.6,inf) }
    var world = Physics.World3D()
    var hinge = world.create_hinge_constraint(world.create_rigid_body(),world.create_rigid_body())
    if selected("stale-set") { world.destroy_hinge_constraint(hinge);hinge.set_limit_spring(Physics.HingeLimitSpring3D(1.6,0.8)) }
    if selected("stale-read") { world.destroy_hinge_constraint(hinge);hinge.limit_torque() }
    if selected("orphan-set") { orphan().set_limit_spring(Physics.HingeLimitSpring3D(1.6,0.8)) }
    if selected("orphan-read") { orphan().limit_spring() }
    panic("invalid soft limit was accepted")
}
