use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match Process.arguments() {
        success(arguments) => {
            for argument in arguments { if argument == expected { return true } }
        }
        failure(error) => { panic(error.detail) }
    }
    return false
}

func orphan() Physics.RigidBody3D {
    var world = Physics.World3D()
    return world.create_rigid_body()
}

func main() {
    if selected("gravity") {
        Physics.World3D(Physics.World3DSettings()
            ..gravity = Math.Vec3(Math.sqrt(-1.0), 0.0, 0.0))
    }
    var world = Physics.World3D()
    if selected("density") {
        world.create_rigid_body(Physics.RigidBody3DSettings() ..density = 0.0)
    }
    if selected("mass") {
        world.create_rigid_body(Physics.RigidBody3DSettings()
            ..mass_properties = Physics.MassProperties3D(0.0, Math.Vec3()))
    }
    if selected("fixed-velocity") {
        world.create_rigid_body(Physics.RigidBody3DSettings()
            ..body_type = Physics.BodyType3D.fixed
            ..linear_velocity = Math.Vec3(1.0, 0.0, 0.0))
    }
    if selected("kinematic-mass") {
        world.create_rigid_body(Physics.RigidBody3DSettings()
            ..body_type = Physics.BodyType3D.kinematic
            ..mass_properties = Physics.MassProperties3D(1.0, Math.Vec3(1.0)))
    }
    if selected("friction") {
        world.create_rigid_body(Physics.RigidBody3DSettings() ..friction = -0.1)
    }
    if selected("restitution") {
        world.create_rigid_body(Physics.RigidBody3DSettings() ..restitution = 1.1)
    }
    if selected("sleep-threshold") {
        world.create_rigid_body(Physics.RigidBody3DSettings() ..sleep_threshold = -0.1)
    }
    var body = world.create_rigid_body()
    if selected("material-mutation") { body.set_material(-1.0, 0.0) }
    if selected("sleep-mutation") { body.set_sleep_threshold(-0.1) }
    if selected("delta") { world.step(-0.1) }
    if selected("impulse") { body.apply_impulse(Math.Vec3(Math.sqrt(-1.0), 0.0, 0.0)) }
    if selected("stale") {
        world.destroy_rigid_body(body)
        world.create_rigid_body()
        body.position()
    }
    if selected("orphan") { orphan().position() }
    if selected("foreign") {
        var other = Physics.World3D()
        other.destroy_rigid_body(body)
    }
    if selected("fixed") {
        var fixed = world.create_rigid_body(Physics.RigidBody3DSettings()
            ..body_type = Physics.BodyType3D.fixed)
        fixed.apply_impulse(Math.Vec3(1.0, 0.0, 0.0))
    }
    if selected("duration") {
        var mover = world.create_rigid_body(Physics.RigidBody3DSettings()
            ..body_type = Physics.BodyType3D.kinematic)
        mover.move_kinematic(Physics.Transform3D(), 0.0)
    }
    panic("invalid World3D operation was accepted")
}
