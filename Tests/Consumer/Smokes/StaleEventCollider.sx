use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World2D(gravity:Math.Vec2())
    var first = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..create_implicit_collider = false
    )
    var first_collider = world.create_collider(
        first,
        Physics.Collider2DSettings()..enable_contact_events = true
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(0.5, 0.0)
    )
    world.step(0.0)
    var events:Physics.ContactBeginEvent2D[] = []
    world.write_contact_begin_events(events)
    world.destroy_collider(first_collider)
    events[0].first_collider().set_material(Physics.PhysicsMaterial2D())
}
