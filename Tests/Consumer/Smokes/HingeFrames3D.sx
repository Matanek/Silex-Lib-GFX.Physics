use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    let first_rotation = Math.Quat.angle_axis(0.7,Math.Vec3(0.0,1.0,0.0))
    let second_rotation = Math.Quat.angle_axis(-0.4,Math.Vec3(1.0,0.0,0.0))
    let axis = first_rotation.rotate(Math.Vec3(0.0,0.0,1.0))
    let normal = first_rotation.rotate(Math.Vec3(1.0,0.0,0.0))
    var first = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
        ..transform = Physics.Transform3D(rotation:first_rotation)
        ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    var second = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(rotation:second_rotation)
        ..mass_properties = Physics.MassProperties3D(1.0,Math.Vec3(0.3,0.5,0.7),Math.Vec3(0.2,-0.1,0.1))
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    var hinge = world.create_hinge_constraint(first,second,Physics.HingeConstraint3DSettings()
        ..second_local_axis = second_rotation.conjugated().rotate(axis)
        ..second_local_normal = second_rotation.conjugated().rotate(normal)
        ..minimum_angle = -0.3 ..maximum_angle = 0.3)
    assert(hinge.axis_error() < 0.0001 && Math.abs(hinge.angle()) < 0.0001)
    second.set_angular_velocity(axis.multiply(2.0).add(normal.multiply(3.0)))
    var step = 0
    while step < 120 { world.step(1.0 / 60.0); step++ }
    assert(hinge.anchor_error().length() < 0.002 && hinge.axis_error() < 0.001)
    assert(Math.abs(hinge.angle() - 0.3) < 0.002)
    hinge.set_limits(-0.2,-0.2)
    step = 0
    while step < 120 { world.step(1.0 / 60.0); step++ }
    assert(hinge.anchor_error().length() < 0.002 && hinge.axis_error() < 0.001)
    assert(Math.abs(hinge.angle() + 0.2) < 0.002)
    var terrain_world = Physics.World3D()
    terrain_world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.plane(Physics.Plane3D(offset:-1.5)))
    var support = terrain_world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
        ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    var weight = terrain_world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
        ..transform = Physics.Transform3D(Math.Vec3(0.0,-1.0,0.0)) ..allow_sleep = false)
    var contact_hinge = terrain_world.create_hinge_constraint(support,weight,Physics.HingeConstraint3DSettings()
        ..second_local_anchor = Math.Vec3(0.0,1.0,0.0))
    weight.apply_impulse(Math.Vec3(0.3,0.0,0.4))
    var contacts = 0; step = 0
    while step < 240 { terrain_world.step(1.0 / 60.0); contacts += terrain_world.contact_count(); step++ }
    assert(contacts > 0 && weight.position().y >= -1.005)
    assert(contact_hinge.anchor_error().length() < 0.005 && contact_hinge.axis_error() < 0.001)
    print("hinge frames: rotated local axes, offset center, unequal inertia, locked angle and terrain contacts verified")
}
