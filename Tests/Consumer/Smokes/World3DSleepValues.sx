use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World3D()
    var floor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(10.0, 1.0, 10.0))))
    var box = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 1.0, 0.0)))
    var step = 0
    while step < 120 {
        world.step(1.0 / 60.0)
        step++
    }
    assert(!box.is_awake())
    let position = box.position()
    world.step(1.0 / 60.0)
    assert(box.position().nearly_equal(position, 0.000001))
    world.destroy_rigid_body(floor)
    assert(box.is_awake())
    world.step(1.0 / 60.0)
    assert(box.position().y < position.y)
}
