use GFX.Physics
use STD.Math
use STD.Process

func selected(name:str) bool {
    for argument in Process.arguments() { if argument==name { return true } }
    return false
}
func main() {
    var radius=0.3
    if selected("zero") { radius=0.0 }
    if selected("negative") { radius= -0.1 }
    if selected("nan") { radius=Math.sqrt(-1.0) }
    if selected("infinite") { radius=1.0/0.0 }
    if selected("zero-travel") { radius=0.6+0.3 }
    if selected("reverse-travel") { radius=1.0 }
    if selected("overflow") { radius=1.0e30 }
    if selected("underflow") { radius=1.0e-30 }
    Physics.Wheel3DSettings(Math.Vec3(),contact:Physics.WheelContact3D.sphere(radius))
    panic("invalid sphere contact was accepted")
}
