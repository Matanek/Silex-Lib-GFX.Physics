use GFX.Physics
use STD.Math
use STD.Process
func selected(value:str) bool { for arg in Process.arguments() { if arg==value { return true } }return false }
func main() {
    var left=0;var right=1;var stiffness=1000.0
    if selected("left-negative") { left= -1 }
    if selected("right-negative") { right= -1 }
    if selected("same-wheel") { right=0 }
    if selected("negative") { stiffness= -1.0 }
    if selected("nan") { stiffness=Math.sqrt(-1.0) }
    if selected("infinite") { stiffness=1.0/0.0 }
    if selected("overflow") { stiffness=3.0e38 }
    if selected("out-of-range") { right=2 }
    var bars:Physics.VehicleAntiRollBar3DSettings[]=[Physics.VehicleAntiRollBar3DSettings(left,right,stiffness)]
    if selected("overlap") { bars.append(Physics.VehicleAntiRollBar3DSettings(1,0)) }
    var wheels:Physics.Wheel3DSettings[]=[Physics.Wheel3DSettings(Math.Vec3(-0.6,0.0,0.0)),Physics.Wheel3DSettings(Math.Vec3(0.6,0.0,0.0))]
    if selected("overflow") { wheels=[Physics.Wheel3DSettings(Math.Vec3(-0.6,0.0,0.0),maximum_length:2.0),Physics.Wheel3DSettings(Math.Vec3(0.6,0.0,0.0),maximum_length:2.0)] }
    var config=Physics.WheeledVehicle3DSettings(Physics.RigidBody3DSettings(),wheels,anti_roll_bars:bars)
    if selected("read-negative") { config.anti_roll_bar(-1) }
    if selected("read-high") { config.anti_roll_bar(1) }
    panic("invalid anti-roll settings were accepted")
}
