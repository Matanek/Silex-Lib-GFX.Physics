use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument==expected { return true } } }
        failure(error) => { panic(error.detail) }
    }
    return false
}
func orphan() Physics.HingeConstraint3D {
    var world = Physics.World3D()
    return world.create_hinge_constraint(world.create_rigid_body(),world.create_rigid_body())
}
func main() {
    let nan = Math.sqrt(-1.0);let inf = 1.0/0.0
    if selected("angle-nan") { Physics.HingeMotor3D.position_and_velocity(nan,0.0,1.0,1.6,0.8) }
    if selected("angle-inf") { Physics.HingeMotor3D.position_and_velocity(inf,0.0,1.0,1.6,0.8) }
    if selected("angle-low") { Physics.HingeMotor3D.position_and_velocity(-4.0,0.0,1.0,1.6,0.8) }
    if selected("angle-high") { Physics.HingeMotor3D.position_and_velocity(4.0,0.0,1.0,1.6,0.8) }
    if selected("speed-nan") { Physics.HingeMotor3D.position_and_velocity(0.0,nan,1.0,1.6,0.8) }
    if selected("speed-inf") { Physics.HingeMotor3D.position_and_velocity(0.0,inf,1.0,1.6,0.8) }
    if selected("symmetric-negative") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,-1.0,1.6,0.8) }
    if selected("symmetric-nan") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,nan,1.6,0.8) }
    if selected("minimum-nan") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,nan,1.0,1.6,0.8) }
    if selected("minimum-inf") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,-inf,1.0,1.6,0.8) }
    if selected("maximum-nan") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,-1.0,nan,1.6,0.8) }
    if selected("maximum-inf") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,-1.0,inf,1.6,0.8) }
    if selected("reversed") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,-1.0,1.6,0.8) }
    if selected("stiffness-zero") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,0.0,0.8) }
    if selected("stiffness-negative") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,-1.0,0.8) }
    if selected("stiffness-nan") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,nan,0.8) }
    if selected("stiffness-inf") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,inf,0.8) }
    if selected("damping-negative") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,1.6,-1.0) }
    if selected("damping-nan") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,1.6,nan) }
    if selected("damping-inf") { Physics.HingeMotor3D.position_and_velocity(0.0,0.0,1.0,1.6,inf) }
    var world = Physics.World3D()
    var hinge = world.create_hinge_constraint(world.create_rigid_body(),world.create_rigid_body())
    if selected("stale") { world.destroy_hinge_constraint(hinge);hinge.set_motor(Physics.HingeMotor3D.position_and_velocity(0.0,0.0,-1.0,1.0,1.6,0.8)) }
    if selected("orphan") { orphan().set_motor(Physics.HingeMotor3D.position_and_velocity(0.0,0.0,0.0,1.0,1.6,0.8)) }
    panic("invalid combined motor was accepted")
}
