use GFX.Physics
use STD.Math

func cube() Physics.Shape3D {
    return Physics.Shape3D.convex(Physics.ConvexHull3D([
        Math.Vec3(-1.0, -1.0, -1.0), Math.Vec3(-1.0, -1.0, 1.0),
        Math.Vec3(-1.0, 1.0, -1.0), Math.Vec3(-1.0, 1.0, 1.0),
        Math.Vec3(1.0, -1.0, -1.0), Math.Vec3(1.0, -1.0, 1.0),
        Math.Vec3(1.0, 1.0, -1.0), Math.Vec3(1.0, 1.0, 1.0)]))
}
func main() {
    var world = Physics.World3D()
    var floor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed ..shape = cube())
    var box = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 2.0, 0.0)) ..allow_sleep = false)
    var step = 0
    while step < 180 { world.step(1.0 / 60.0); step++ }
    assert(Math.abs(box.position().y - 1.5) < 0.01)
    assert(box.angular_velocity().length() < 0.0001)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts.count() == 1 && contacts[0].point_count() == 4)
    box.set_transform(Physics.Transform3D(position:Math.Vec3(0.0, 2.0, 0.0)))
    box.set_continuous_collision(true)
    box.set_linear_velocity(Math.Vec3(0.0, -120.0, 0.0))
    world.set_gravity(Math.Vec3())
    world.step(1.0 / 60.0)
    assert(Math.abs(box.position().y - 1.5) < 0.001 && box.linear_velocity().length() < 0.001)
    let distance = Physics.Geometry3D.distance(Physics.ShapePlacement3D(box.shape(),
        Physics.Transform3D(position:Math.Vec3(0.0, 0.2, 0.0))), Physics.ShapePlacement3D(cube()))
    assert(Math.abs(distance.separation + 1.3) < 0.0001)
    assert(distance.normal.nearly_equal(Math.Vec3.up().negated(), 0.0001))
    print("Box convex native: four-point rest, CCD and solid inclusion verified")
}
