use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var body = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..mass_properties = Physics.MassProperties3D(
            2.0, Math.Vec3(1.0, 2.0, 4.0), Math.Vec3(1.0, 0.0, 0.0)
        ))
    body.apply_impulse(Math.Vec3(2.0, 0.0, 0.0))
    body.apply_angular_impulse(Math.Vec3(0.0, 0.0, 4.0))
    world.step(0.1)
    assert(body.world_center_of_mass().nearly_equal(Math.Vec3(1.1, 0.0, 0.0), 0.0001))
    assert(Math.abs(body.rotation().length_squared() - 1.0) < 0.00001)
    var mover = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.kinematic)
    let target = Physics.Transform3D(position:Math.Vec3(1.0, 2.0, 3.0))
    mover.move_kinematic(target, 0.1)
    world.step(0.1)
    assert(mover.position().nearly_equal(target.position, 0.00001))
    world.destroy_rigid_body(body)
    assert(!body.is_valid())
    print("world3d values ok")
}
