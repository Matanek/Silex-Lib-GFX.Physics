use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument == expected { return true } } }
        failure(error) => { panic(error.detail) }
    }
    return false
}
func orphan_slider() Physics.SliderConstraint3D {
    var world = Physics.World3D()
    return world.create_slider_constraint(world.create_rigid_body(),world.create_rigid_body())
}
func main() {
    var world = Physics.World3D()
    var support = world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed)
    var body = world.create_rigid_body()
    if selected("combined-position-nan") { Physics.SliderMotor3D.position_and_velocity(Math.sqrt(-1.0),0.3,-2.0,3.0,8.0,4.0) }
    if selected("combined-position-infinity") { Physics.SliderMotor3D.position_and_velocity(1.0/0.0,0.3,-2.0,3.0,8.0,4.0) }
    if selected("combined-speed-nan") { Physics.SliderMotor3D.position_and_velocity(0.75,Math.sqrt(-1.0),-2.0,3.0,8.0,4.0) }
    if selected("combined-speed-infinity") { Physics.SliderMotor3D.position_and_velocity(0.75,1.0/0.0,-2.0,3.0,8.0,4.0) }
    if selected("combined-minimum-nan") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,Math.sqrt(-1.0),3.0,8.0,4.0) }
    if selected("combined-minimum-infinity") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,1.0/0.0,3.0,8.0,4.0) }
    if selected("combined-maximum-nan") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,Math.sqrt(-1.0),8.0,4.0) }
    if selected("combined-maximum-infinity") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,1.0/0.0,8.0,4.0) }
    if selected("combined-stiffness-nan") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,3.0,Math.sqrt(-1.0),4.0) }
    if selected("combined-stiffness-infinity") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,3.0,1.0/0.0,4.0) }
    if selected("combined-damping-nan") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,3.0,8.0,Math.sqrt(-1.0)) }
    if selected("combined-damping-infinity") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,3.0,8.0,1.0/0.0) }
    if selected("combined-stiffness-zero") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,3.0,0.0,4.0) }
    if selected("combined-stiffness-negative") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,3.0,-1.0,4.0) }
    if selected("combined-damping-negative") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-2.0,3.0,8.0,-1.0) }
    if selected("combined-ordered") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,4.0,3.0,8.0,4.0) }
    if selected("combined-symmetric-negative") { Physics.SliderMotor3D.position_and_velocity(0.75,0.3,-1.0,8.0,4.0) }
    if selected("soft-stiffness-nan") { Physics.SliderLimitSpring3D(Math.sqrt(-1.0),1.0) }
    if selected("soft-stiffness-infinity") { Physics.SliderLimitSpring3D(1.0/0.0,1.0) }
    if selected("soft-stiffness-zero") { Physics.SliderLimitSpring3D(0.0,1.0) }
    if selected("soft-stiffness-negative") { Physics.SliderLimitSpring3D(-1.0,1.0) }
    if selected("soft-damping-nan") { Physics.SliderLimitSpring3D(1.0,Math.sqrt(-1.0)) }
    if selected("soft-damping-infinity") { Physics.SliderLimitSpring3D(1.0,1.0/0.0) }
    if selected("soft-damping-negative") { Physics.SliderLimitSpring3D(1.0,-1.0) }
    if selected("position-nan") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings()
        ..first_local_frame = Physics.Transform3D(Math.Vec3(Math.sqrt(-1.0),0.0,0.0))) }
    if selected("rotation-zero") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings()
        ..second_local_frame = Physics.Transform3D(rotation:Math.Quat(0.0,0.0,0.0,0.0))) }
    if selected("same") { world.create_slider_constraint(body,body) }
    if selected("fixed-kinematic") { world.create_slider_constraint(support,world.create_rigid_body(
        Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.kinematic)) }
    if selected("foreign") { var other = Physics.World3D(); world.create_slider_constraint(support,other.create_rigid_body()) }
    if selected("minimum-nan") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings() ..minimum_position = Math.sqrt(-1.0)) }
    if selected("maximum-infinity") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings() ..maximum_position = 1.0 / 0.0) }
    if selected("reversed") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings() ..minimum_position = 1.0 ..maximum_position = -1.0) }
    if selected("motor-speed-nan") { Physics.SliderMotor3D(Math.sqrt(-1.0), 2.0) }
    if selected("motor-speed-infinity") { Physics.SliderMotor3D(1.0 / 0.0, 2.0) }
    if selected("motor-force-nan") { Physics.SliderMotor3D(0.6, Math.sqrt(-1.0)) }
    if selected("motor-force-infinity") { Physics.SliderMotor3D(0.6, 1.0 / 0.0) }
    if selected("motor-force-negative") { Physics.SliderMotor3D(0.6, -1.0) }
    if selected("servo-position-nan") { Physics.SliderMotor3D.position(Math.sqrt(-1.0), 10.0, 8.0, 8.0) }
    if selected("servo-position-infinity") { Physics.SliderMotor3D.position(1.0 / 0.0, 10.0, 8.0, 8.0) }
    if selected("servo-force-nan") { Physics.SliderMotor3D.position(0.75, Math.sqrt(-1.0), 8.0, 8.0) }
    if selected("servo-force-infinity") { Physics.SliderMotor3D.position(0.75, 1.0 / 0.0, 8.0, 8.0) }
    if selected("servo-force-negative") { Physics.SliderMotor3D.position(0.75, -1.0, 8.0, 8.0) }
    if selected("servo-stiffness-nan") { Physics.SliderMotor3D.position(0.75, 10.0, Math.sqrt(-1.0), 8.0) }
    if selected("servo-stiffness-infinity") { Physics.SliderMotor3D.position(0.75, 10.0, 1.0 / 0.0, 8.0) }
    if selected("servo-stiffness-zero") { Physics.SliderMotor3D.position(0.75, 10.0, 0.0, 8.0) }
    if selected("servo-stiffness-negative") { Physics.SliderMotor3D.position(0.75, 10.0, -1.0, 8.0) }
    if selected("servo-damping-nan") { Physics.SliderMotor3D.position(0.75, 10.0, 8.0, Math.sqrt(-1.0)) }
    if selected("servo-damping-infinity") { Physics.SliderMotor3D.position(0.75, 10.0, 8.0, 1.0 / 0.0) }
    if selected("servo-damping-negative") { Physics.SliderMotor3D.position(0.75, 10.0, 8.0, -1.0) }
    if selected("friction-nan") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings() ..maximum_friction_force = Math.sqrt(-1.0)) }
    if selected("friction-infinity") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings() ..maximum_friction_force = 1.0 / 0.0) }
    if selected("friction-negative") { world.create_slider_constraint(support,body,Physics.SliderConstraint3DSettings() ..maximum_friction_force = -1.0) }
    var joint = world.create_slider_constraint(support,body)
    if selected("mutation-minimum") { joint.set_limits(Math.sqrt(-1.0), null) }
    if selected("mutation-maximum") { joint.set_limits(null, 1.0 / 0.0) }
    if selected("mutation-reversed") { joint.set_limits(2.0, 1.0) }
    if selected("mutation-frame") { joint.set_frames(Physics.Transform3D(),Physics.Transform3D(rotation:Math.Quat(0.0,0.0,0.0,2.0))) }
    if selected("stale") { world.destroy_slider_constraint(joint); world.create_slider_constraint(support,body); joint.anchor_error() }
    if selected("stale-mutation") { world.destroy_slider_constraint(joint); joint.set_frames(Physics.Transform3D(),Physics.Transform3D()) }
    if selected("foreign-destroy") { var other = Physics.World3D(); other.destroy_slider_constraint(joint) }
    if selected("orphan") { orphan_slider().reaction_torque() }
    if selected("stale-motor-read") { world.destroy_slider_constraint(joint); joint.motor() }
    if selected("stale-motor-set") { world.destroy_slider_constraint(joint); joint.set_motor(Physics.SliderMotor3D(0.6, 2.0)) }
    if selected("orphan-motor") { orphan_slider().motor_force() }
    if selected("mutation-friction-nan") { joint.set_maximum_friction_force(Math.sqrt(-1.0)) }
    if selected("mutation-friction-infinity") { joint.set_maximum_friction_force(1.0 / 0.0) }
    if selected("mutation-friction-negative") { joint.set_maximum_friction_force(-1.0) }
    if selected("stale-friction-read") { world.destroy_slider_constraint(joint);joint.maximum_friction_force() }
    if selected("stale-friction-force") { world.destroy_slider_constraint(joint);joint.friction_force() }
    if selected("stale-friction-set") { world.destroy_slider_constraint(joint);joint.set_maximum_friction_force(1.0) }
    if selected("orphan-friction") { orphan_slider().friction_force() }
    if selected("bounds-speed-nan") { Physics.SliderMotor3D(Math.sqrt(-1.0), -1.0, 1.0) }
    if selected("bounds-speed-infinity") { Physics.SliderMotor3D(1.0 / 0.0, -1.0, 1.0) }
    if selected("bounds-minimum-nan") { Physics.SliderMotor3D(0.0, Math.sqrt(-1.0), 1.0) }
    if selected("bounds-minimum-infinity") { Physics.SliderMotor3D(0.0, -1.0 / 0.0, 1.0) }
    if selected("bounds-maximum-nan") { Physics.SliderMotor3D(0.0, -1.0, Math.sqrt(-1.0)) }
    if selected("bounds-maximum-infinity") { Physics.SliderMotor3D(0.0, -1.0, 1.0 / 0.0) }
    if selected("bounds-ordered") { Physics.SliderMotor3D(0.0, 2.0, -1.0) }
    if selected("bounds-servo-position-nan") { Physics.SliderMotor3D.position(Math.sqrt(-1.0), -1.0, 1.0, 8.0, 8.0) }
    if selected("bounds-servo-position-infinity") { Physics.SliderMotor3D.position(1.0 / 0.0, -1.0, 1.0, 8.0, 8.0) }
    if selected("bounds-servo-minimum-nan") { Physics.SliderMotor3D.position(0.5, Math.sqrt(-1.0), 1.0, 8.0, 8.0) }
    if selected("bounds-servo-minimum-infinity") { Physics.SliderMotor3D.position(0.5, -1.0 / 0.0, 1.0, 8.0, 8.0) }
    if selected("bounds-servo-maximum-nan") { Physics.SliderMotor3D.position(0.5, -1.0, Math.sqrt(-1.0), 8.0, 8.0) }
    if selected("bounds-servo-maximum-infinity") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0 / 0.0, 8.0, 8.0) }
    if selected("bounds-servo-stiffness-nan") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0, Math.sqrt(-1.0), 8.0) }
    if selected("bounds-servo-stiffness-infinity") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0, 1.0 / 0.0, 8.0) }
    if selected("bounds-servo-stiffness-zero") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0, 0.0, 8.0) }
    if selected("bounds-servo-stiffness-negative") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0, -1.0, 8.0) }
    if selected("bounds-servo-damping-nan") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0, 8.0, Math.sqrt(-1.0)) }
    if selected("bounds-servo-damping-infinity") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0, 8.0, 1.0 / 0.0) }
    if selected("bounds-servo-damping-negative") { Physics.SliderMotor3D.position(0.5, -1.0, 1.0, 8.0, -1.0) }
    if selected("bounds-servo-ordered") { Physics.SliderMotor3D.position(0.5, 2.0, -1.0, 8.0, 8.0) }
    if selected("stale-soft-read") { world.destroy_slider_constraint(joint);joint.limit_spring() }
    if selected("stale-soft-set") { world.destroy_slider_constraint(joint);joint.set_limit_spring(null) }
    if selected("orphan-soft") { orphan_slider().limit_spring() }
    panic("invalid slider operation was accepted")
}
