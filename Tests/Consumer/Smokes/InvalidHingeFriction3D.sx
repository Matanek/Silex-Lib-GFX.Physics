use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument==expected { return true } } }
        failure(error) => { panic(error.detail) }
    }
    return false
}
func orphan() Physics.HingeConstraint3D {
    var world = Physics.World3D()
    return world.create_hinge_constraint(world.create_rigid_body(),world.create_rigid_body(),
        Physics.HingeConstraint3DSettings() ..maximum_friction_torque = 0.1)
}
func main() {
    let nan = Math.sqrt(-1.0)
    var world = Physics.World3D(); var first = world.create_rigid_body(); var second = world.create_rigid_body()
    if selected("create-negative") { world.create_hinge_constraint(first,second,Physics.HingeConstraint3DSettings() ..maximum_friction_torque = -1.0) }
    if selected("create-nan") { world.create_hinge_constraint(first,second,Physics.HingeConstraint3DSettings() ..maximum_friction_torque = nan) }
    var hinge = world.create_hinge_constraint(first,second)
    if selected("mutate-negative") { hinge.set_maximum_friction_torque(-1.0) }
    if selected("mutate-nan") { hinge.set_maximum_friction_torque(nan) }
    if selected("stale-read") { world.destroy_hinge_constraint(hinge); hinge.friction_torque() }
    if selected("stale-write") { world.destroy_hinge_constraint(hinge); hinge.set_maximum_friction_torque(0.1) }
    if selected("orphan-read") { orphan().maximum_friction_torque() }
    if selected("orphan-write") { orphan().set_maximum_friction_torque(0.1) }
    panic("invalid friction was accepted")
}
