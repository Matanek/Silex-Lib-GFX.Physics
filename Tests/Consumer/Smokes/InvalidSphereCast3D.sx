use GFX.Physics
use STD.Math
use STD.Process
func selected(expected:str) bool {
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument == expected { return true } } }
        failure(error) => { panic(error.detail) }
    }
    return false
}
func main() {
    var origin = Math.Vec3(); var translation = Math.Vec3.right()
    var overflow:float = 3.4028235e38; overflow *= 2.0
    if selected("zero") { translation = Math.Vec3() }
    if selected("origin") { origin = Math.Vec3(overflow, 0.0, 0.0) }
    if selected("translation") { translation = Math.Vec3(overflow, 0.0, 0.0) }
    if selected("squared") { translation = Math.Vec3(1.0e30, 0.0, 0.0) }
    if selected("nan") { origin = Math.Vec3(overflow - overflow, 0.0, 0.0) }
    if selected("radius") { Physics.Sphere3D(-1.0) }
    Physics.SphereCast3D(Physics.Sphere3D(0.5), origin, translation)
    panic("invalid sphere cast was accepted")
}
