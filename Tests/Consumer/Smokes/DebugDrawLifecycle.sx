use GFX.Physics
use STD.Math

func exercise_world(iteration:int) {
    var world = Physics.World2D(gravity:Math.Vec2())
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(1.0, 2.0)
        ..velocity = Math.Vec2(0.5, 0.0)
        ..allow_sleep = false
        ..debug_label = "body $(iteration)"
    )
    var retained = body
    var snapshot = Physics.World2DDebugSnapshot()
    let settings = Physics.World2DDebugSettings() ..labels = true
    var frame = 0
    while frame < 8 {
        world.step(1.0 / 60.0)
        world.write_debug_snapshot(settings, snapshot)
        assert(snapshot.label_count() == 1)
        assert(snapshot.label(0).text == "body $(iteration)")
        frame++
    }
    let growth = snapshot.storage_growth_count()
    world.write_debug_snapshot(settings, snapshot)
    assert(snapshot.storage_growth_count() == growth)
    var drawing = Physics.World2DDebug.canvas(snapshot)
    var scene_drawing = Physics.World2DDebug.scene_canvas(snapshot)
    let commands = drawing.command_count()
    assert(commands > 0)
    world.destroy_rigid_body(body)
    assert(!retained.is_valid())
    world = Physics.World2D(gravity:Math.Vec2())
    assert(drawing.command_count() == commands)
    assert(scene_drawing.revision() > 0)
    world.write_debug_snapshot(Physics.World2DDebugSettings() ..enabled = false, snapshot)
    assert(snapshot.label_count() == 0)
    assert(snapshot.line_count() == 0)
    assert(snapshot.circle_count() == 0)
}

func main() {
    // Warm the shared font cache before measuring repeated world lifetimes.
    exercise_world(0)
    print("lifecycle-warm")
    var iteration = 1
    while iteration <= 128 {
        exercise_world(iteration)
        if iteration == 16 || iteration == 64 || iteration == 128 {
            print("lifecycle-checkpoint ", iteration)
        }
        iteration++
    }
    print("debug-draw-lifecycle-ok")
}
