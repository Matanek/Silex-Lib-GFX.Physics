use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(10.0, 1.0, 10.0))))
    var box = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 1.0, 0.0)))
    var upper = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.0)))
        ..transform = Physics.Transform3D(position:Math.Vec3(0.0, 2.0, 0.0)))
    var step = 0
    while step < 120 {
        world.step(1.0 / 60.0)
        step++
    }
    assert(world.contact_count() == 2)
    assert(Math.abs(box.position().y - 1.0) < 0.02)
    assert(Math.abs(upper.position().y - 2.0) < 0.03)
    assert(box.linear_velocity().length() < 0.01)
    assert(upper.linear_velocity().length() < 0.01)
    var contacts:Physics.Contact3D[] = []
    world.write_contacts(contacts)
    assert(contacts.count() == 2)
    assert(contacts[0].point_count() == 4)
    assert(contacts[1].point_count() == 4)
}
