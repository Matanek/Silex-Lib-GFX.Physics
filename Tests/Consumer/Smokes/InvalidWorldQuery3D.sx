use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match Process.arguments() {
        success(arguments) => {
            for argument in arguments { if argument == expected { return true } }
        }
        failure(error) => { panic(error.detail) }
    }
    return false
}

func main() {
    var world = Physics.World3D()
    var body = world.create_rigid_body()
    var other = Physics.World3D()
    var foreign = other.create_rigid_body()
    let ray = Physics.Ray3D(Math.Vec3(-2.0, 0.0, 0.0), Math.Vec3(4.0, 0.0, 0.0))
    if selected("foreign-ray") { world.ray_cast(ray, foreign) }
    if selected("foreign-overlap") {
        var overlaps:Physics.WorldOverlap3D[] = []
        world.write_overlaps(Physics.ShapePlacement3D(
            Physics.Shape3D.sphere(Physics.Sphere3D())), overlaps, foreign)
    }
    world.destroy_rigid_body(body)
    if selected("stale-ray") { world.ray_cast(ray, body) }
    if selected("stale-all") {
        var hits:Physics.WorldRayHit3D[] = []
        world.write_ray_hits(ray, hits, body)
    }
    panic("invalid world query was accepted")
}
