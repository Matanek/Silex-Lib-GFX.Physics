use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match (try Process.arguments()) {
        success(arguments) => {
            for argument in arguments { if argument == expected { return true } }
        }
        failure(error) => { panic(error.detail) }
    }
    return false
}

func mesh() Physics.Shape3D {
    return Physics.Shape3D.mesh(Physics.TriangleMesh3D([
        Physics.Triangle3D(Math.Vec3(), Math.Vec3(0.0, 0.0, 2.0),
            Math.Vec3(2.0, 0.0, 0.0))
    ]))
}

func main() {
    if selected("empty") { Physics.TriangleMesh3D([]) }
    if selected("dynamic") {
        var world = Physics.World3D()
        world.create_rigid_body(Physics.RigidBody3DSettings() ..shape = mesh())
    }
    if selected("kinematic") {
        var world = Physics.World3D()
        world.create_rigid_body(Physics.RigidBody3DSettings()
            ..body_type = Physics.BodyType3D.kinematic ..shape = mesh())
    }
    if selected("compound") { Physics.CompoundChild3D(0, mesh()) }
    if selected("mutation") {
        var world = Physics.World3D()
        var body = world.create_rigid_body()
        body.set_shape(mesh())
    }
    panic("invalid mesh use was accepted")
}
