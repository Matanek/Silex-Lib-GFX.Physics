use GFX.Physics
use STD.Math
use STD.Process

func selected(expected:str) bool {
    match (try Process.arguments()) {
        success(arguments) => { for argument in arguments { if argument == expected { return true } } }
        failure(error) => { panic(error.detail) }
    }
    return false
}
func orphan() Physics.HingeConstraint3D {
    var world = Physics.World3D()
    return world.create_hinge_constraint(world.create_rigid_body(),world.create_rigid_body(),
        Physics.HingeConstraint3DSettings() ..motor = Physics.HingeMotor3D.position(0.5,10.0,1.0,1.0))
}
func main() {
    let nan = Math.sqrt(-1.0)
    if selected("angle-nan") { Physics.HingeMotor3D.position(nan,10.0,1.0,1.0) }
    if selected("angle-low") { Physics.HingeMotor3D.position(-4.0,10.0,1.0,1.0) }
    if selected("angle-high") { Physics.HingeMotor3D.position(4.0,10.0,1.0,1.0) }
    if selected("stiffness-zero") { Physics.HingeMotor3D.position(0.0,10.0,0.0,1.0) }
    if selected("stiffness-negative") { Physics.HingeMotor3D.position(0.0,10.0,-1.0,1.0) }
    if selected("stiffness-nan") { Physics.HingeMotor3D.position(0.0,10.0,nan,1.0) }
    if selected("damping-negative") { Physics.HingeMotor3D.position(0.0,10.0,1.0,-1.0) }
    if selected("damping-nan") { Physics.HingeMotor3D.position(0.0,10.0,1.0,nan) }
    if selected("torque-negative") { Physics.HingeMotor3D.position(0.0,-1.0,1.0,1.0) }
    if selected("torque-nan") { Physics.HingeMotor3D.position(0.0,nan,1.0,1.0) }
    var world = Physics.World3D()
    var hinge = world.create_hinge_constraint(world.create_rigid_body(),world.create_rigid_body(),Physics.HingeConstraint3DSettings())
    if selected("stale") { world.destroy_hinge_constraint(hinge); hinge.set_motor(Physics.HingeMotor3D.position(0.0,10.0,1.0,1.0)) }
    if selected("orphan") { orphan().motor_torque() }
    panic("invalid position motor was accepted")
}
