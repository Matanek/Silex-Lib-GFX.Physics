use GFX.Physics
use STD.Math
use STD.Process

func main() {
    match Process.arguments() {
        success(arguments) => {
            for argument in arguments {
                if argument == "radius" { Physics.Capsule3D(0.0, 0.5) }
                if argument == "height" { Physics.Capsule3D(0.25, 0.0) }
                if argument == "nan" {
                    Physics.Capsule3D(Math.sqrt(-1.0), 0.5)
                }
            }
        }
        failure(error) => { panic(error.detail) }
    }
    panic("invalid Capsule3D operation was accepted")
}
