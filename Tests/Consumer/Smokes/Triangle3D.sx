use GFX.Physics
use STD.Math

func main() {
    let surface = Physics.Shape3D.triangle(Physics.Triangle3D(
        Math.Vec3(), Math.Vec3(0.0, 0.0, 4.0), Math.Vec3(4.0, 0.0, 0.0)))
    let probe = Physics.ShapePlacement3D(
        Physics.Shape3D.sphere(Physics.Sphere3D(0.5)),
        Physics.Transform3D(position:Math.Vec3(1.0, 0.4, 1.0)))
    assert(Physics.Geometry3D.overlaps(probe, Physics.ShapePlacement3D(surface)))

    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed ..shape = surface)
    var sphere = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
        ..transform = Physics.Transform3D(position:Math.Vec3(1.0, 0.4, 1.0)))
    world.step(1.0 / 60.0)
    assert(world.contact_count() == 1)
    sphere.set_transform(Physics.Transform3D(position:Math.Vec3(1.0, -0.4, 1.0)))
    world.step(1.0 / 60.0)
    assert(world.contact_count() == 0)
}
