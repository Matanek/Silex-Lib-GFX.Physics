use GFX.Physics
use STD.Math

test "register a body in the broad phase" {
    var world = Physics.World2D()
    var body = world.create_rigid_body()

    assert(world.body_count() == 1)
    assert(body.position() == Math.Vec2())
}

test "integrate prescribed kinematic motion without gravity" {
    var world = Physics.World2D(gravity:Math.Vec2(0.0, -20.0))
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.kinematic
        ..velocity = Math.Vec2(2.0, 1.0)
        ..angular_velocity = 0.5
    )

    world.step(0.5)

    assert(body.body_type() == Physics.BodyType2D.kinematic)
    assert(body.position().nearly_equal(Math.Vec2(1.0, 0.5), 0.00001))
    assert(Math.abs(body.rotation() - 0.25) < 0.00001)
    assert(body.velocity() == Math.Vec2(2.0, 1.0))
    assert(body.is_awake())
}

test "push a dynamic circle with a kinematic wall" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var wall = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.kinematic
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.2, 2.0)))
        ..position = Math.Vec2(-0.6, 0.0)
        ..velocity = Math.Vec2(1.0, 0.0)
        ..friction = 0.8
    )
    var circle = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.2))
        ..allow_sleep = false
    )

    var step = 0
    while step < 60 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(wall.position().nearly_equal(Math.Vec2(-0.1, 0.0), 0.00001))
    assert(circle.position().x > 0.15)
    assert(circle.velocity().x > 0.5)
}

test "reduce separated bodies to no candidate pair" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var index = 0
    while index < 32 {
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..position = Math.Vec2(index as float * 2.0, 0.0)
        )
        index++
    }

    world.step(1.0 / 60.0)

    assert(world.body_count() == 32)
    assert(world.candidate_pair_count() == 0)
}

test "retain and remove persistent candidate pairs" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var fixed_body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(0.0, 0.5)
    )

    world.step(0.0)
    assert(world.candidate_pair_count() == 1)
    world.step(0.0)
    assert(world.candidate_pair_count() == 1)

    box.set_position(Math.Vec2(8.0, 0.5))
    world.step(0.0)
    assert(world.candidate_pair_count() == 0)

    var cycle = 0
    while cycle < 32 {
        box.set_position(Math.Vec2(0.0, 0.5))
        world.step(0.0)
        assert(world.candidate_pair_count() == 1)
        box.set_position(Math.Vec2(8.0, 0.5))
        world.step(0.0)
        assert(world.candidate_pair_count() == 0)
        cycle++
    }
    assert(fixed_body.position() == Math.Vec2(0.0, -0.5))
}

test "reuse a persistent general contact slot after separation" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
            Math.Vec2(-1.0, -0.2),
            Math.Vec2(1.0, -0.2),
            Math.Vec2(1.0, 0.2),
            Math.Vec2(-1.0, 0.2)
        ], 0.05))
    )
    var capsule = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(-0.5, 0.0),
            Math.Vec2(0.5, 0.0),
            0.25
        ))
        ..position = Math.Vec2(0.0, 0.35)
        ..gravity_scale = 0.0
        ..allow_sleep = false
    )

    world.step(0.0)
    assert(world.persistent_pair_count() == 1)
    assert(world.candidate_pair_slot_count() == 1)
    assert(world.contact_count() == 1)
    world.step(0.0)
    assert(world.candidate_pair_slot_count() == 1)

    capsule.set_position(Math.Vec2(0.0, 2.0))
    world.step(0.0)
    assert(world.persistent_pair_count() == 0)
    assert(world.candidate_pair_slot_count() == 1)
    capsule.set_position(Math.Vec2(0.0, 0.35))
    world.step(0.0)
    assert(world.persistent_pair_count() == 1)
    assert(world.candidate_pair_slot_count() == 1)
    assert(world.contact_count() == 1)
}

test "pack one general contact island and remove it from the active path" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var bodies:Physics.RigidBody2D[] = []
    var index = 0
    while index < 3 {
        bodies.append(world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.capsule(Physics.Capsule2D(
                Math.Vec2(-0.5, 0.0),
                Math.Vec2(0.5, 0.0),
                0.25
            ))
            ..position = Math.Vec2(index as float * 1.5, 0.0)
            ..gravity_scale = 0.0
            ..linear_damping = 8.0
            ..angular_damping = 8.0
        ))
        index++
    }

    world.step(1.0 / 60.0)
    assert(world.active_body_count() == 3)
    assert(world.active_island_count() == 1)
    assert(world.active_island_body_count() == 3)
    index = 0
    while index < 120 {
        world.step(1.0 / 60.0)
        index++
    }
    for body in bodies { assert(!body.is_awake()) }
    world.step(0.0)
    assert(world.active_body_count() == 0)
    assert(world.active_island_count() == 0)
    assert(world.active_island_body_count() == 0)
}

test "advance a dynamic body under gravity" {
    var world = Physics.World2D()
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(0.0, 10.0)
    )

    world.step(0.5)

    assert(body.velocity().nearly_equal(Math.Vec2(0.0, -4.905), 0.000001))
    assert(body.position().nearly_equal(Math.Vec2(0.0, 8.467188), 0.000001))
}

test "write dynamic body transforms into a reusable buffer" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..position = Math.Vec2(9.0, 9.0)
    )
    var first = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(1.0, 2.0)
        ..rotation = 0.25
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(3.0, 4.0)
        ..rotation = 0.5
    )
    var transforms = Physics.BodyTransformBuffer2D()

    world.write_dynamic_body_transforms(transforms)
    assert(transforms.count() == 2)
    assert(transforms.position(0) == Math.Vec2(1.0, 2.0))
    assert(transforms.rotation(0) == 0.25)
    assert(transforms.position(1) == Math.Vec2(3.0, 4.0))
    assert(transforms.rotation(1) == 0.5)

    first.set_position(Math.Vec2(5.0, 6.0))
    world.write_dynamic_body_transforms(transforms)
    assert(transforms.count() == 2)
    assert(transforms.position(0) == Math.Vec2(5.0, 6.0))
}

test "preserve explicit motion when gravity is disabled for a body" {
    var world = Physics.World2D()
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(2.0, 3.0)
        ..velocity = Math.Vec2(4.0, -2.0)
        ..gravity_scale = 0.0
    )

    world.step(0.25)

    assert(body.position().nearly_equal(Math.Vec2(3.0, 2.5), 0.000001))
    assert(body.velocity().nearly_equal(Math.Vec2(4.0, -2.0), 0.000001))
    assert(world.body_count() == 1)
}

test "rest a dynamic box on a fixed box" {
    var world = Physics.World2D()
    var ground = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 2.0)
    )

    var step = 0
    while step < 120 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(box.position().nearly_equal(Math.Vec2(0.0, 0.5), 0.001))
    assert(box.velocity().nearly_equal(Math.Vec2(), 0.001))
    assert(ground.position() == Math.Vec2(0.0, -0.5))
}

test "rest on a wide floor away from the world origin" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(12.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(4.0, 2.0)
    )

    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(box.position().nearly_equal(Math.Vec2(4.0, 0.5), 0.002))
    assert(box.velocity().nearly_equal(Math.Vec2(), 0.002))
}

test "put a resting body to sleep and wake it on mutation" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 0.5)
    )

    var step = 0
    while step < 120 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(!box.is_awake())
    assert(world.awake_body_count() == 0)
    box.set_velocity(Math.Vec2(1.0, 0.0))
    assert(box.is_awake())
}

test "keep a buried support asleep below an active neighbour" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    var buried = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 0.5)
    )
    var active = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 1.5)
        ..allow_sleep = false
    )

    var step = 0
    while step < 360 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(!buried.is_awake())
    assert(active.is_awake())
    let resting_position = buried.position()
    step = 0
    while step < 120 {
        world.step(1.0 / 120.0)
        step++
    }
    assert(buried.position().nearly_equal(resting_position, 0.00001))
}

test "keep dynamic boxes inside fixed container walls" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var left = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.2, 4.0)))
        ..position = Math.Vec2(-1.1, 0.0)
    )
    var right = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.2, 4.0)))
        ..position = Math.Vec2(1.1, 0.0)
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.4)))
        ..velocity = Math.Vec2(4.0, 0.0)
    )

    var step = 0
    while step < 60 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(box.position().x <= 0.801)
    assert(box.position().x >= -0.801)
    assert(left.body_type() == Physics.BodyType2D.fixed)
    assert(right.body_type() == Physics.BodyType2D.fixed)
}

test "return a fast body from a deep container boundary" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var boundary = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 4.0)))
        ..position = Math.Vec2(-3.0, 0.0)
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.4)))
        ..velocity = Math.Vec2(-20.0, 0.0)
    )

    world.step(0.1)
    world.step(0.0)
    world.step(0.0)

    assert(box.position().x >= -0.801)
    assert(box.velocity().x >= 0.0)
    assert(boundary.position() == Math.Vec2(-3.0, 0.0))
}

test "return a fast circle through its entry face" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 4.0)))
        ..position = Math.Vec2(3.0, 0.0)
    )
    var circle = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.2))
        ..velocity = Math.Vec2(40.0, 0.0)
    )

    world.step(0.1)
    world.step(0.0)
    world.step(0.0)
    world.step(0.0)

    assert(circle.position().x <= 0.806)
    assert(circle.velocity().x <= 0.0)
}

test "stack dynamic boxes on each other" {
    var world = Physics.World2D()
    var ground = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    var lower = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 0.5)
    )
    var upper = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 2.5)
    )

    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(lower.position().nearly_equal(Math.Vec2(0.0, 0.5), 0.002))
    assert(upper.position().nearly_equal(Math.Vec2(0.0, 1.5), 0.002))
    assert(ground.position() == Math.Vec2(0.0, -0.5))
}

test "integrate the rotation of a dynamic body" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..rotation = 0.25
        ..angular_velocity = 2.0
    )

    world.step(0.5)

    assert(Math.nearly_equal(box.rotation(), 1.25, 0.000001))
    assert(Math.nearly_equal(box.angular_velocity(), 2.0, 0.000001))
}

test "slow sliding motion through floor friction" {
    var world = Physics.World2D()
    var ground = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 0.5)
        ..velocity = Math.Vec2(2.0, 0.0)
        ..friction = 0.9
    )

    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(Math.abs(box.velocity().x) < 0.01)
    assert(Math.abs(box.angular_velocity()) < 0.01)
    assert(ground.velocity() == Math.Vec2())
}

test "resolve the floor contact of a rotated box" {
    var world = Physics.World2D()
    var ground = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var box = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 2.0)
        ..rotation = 0.35
        ..friction = 0.9
        ..angular_damping = 0.2
    )

    var step = 0
    while step < 360 {
        world.step(1.0 / 120.0)
        step++
    }

    let vertical_radius = 0.5 * (
        Math.abs(Math.sin(box.rotation())) + Math.abs(Math.cos(box.rotation()))
    )
    assert(box.position().y >= vertical_radius - 0.002)
    assert(!Math.nearly_equal(box.rotation(), 0.35, 0.01))
    assert(ground.rotation() == 0.0)
}

test "sleep a settled dense contact island" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var bodies:Physics.RigidBody2D[] = []
    var index = 0
    while index < 60 {
        let column = index % 10
        let row = index / 10
        bodies.append(world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.5)))
            ..position = Math.Vec2(
                (column as float - 4.5) * 0.52,
                0.25 + row as float * 0.52
            )
            ..rotation = ((index % 3) as float - 1.0) * 0.02
            ..friction = 0.8
        ))
        index++
    }

    var step = 0
    while step < 720 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(world.awake_body_count() == 0)
    for body in bodies {
        assert(!body.is_awake())
        assert(body.position().y >= 0.24)
    }
}

test "wake a sleeping contact island on a meaningful impact" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 0.5)
    )
    var upper = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 1.5)
    )

    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        step++
    }
    assert(!upper.is_awake())

    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 4.0)
        ..velocity = Math.Vec2(0.0, -4.0)
        ..allow_sleep = false
    )
    step = 0
    while step < 50 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(upper.is_awake())
}

test "retain the public circle shape of a rigid body" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var circle = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.35))
    )

    match circle.shape() {
        circle(shape) => { assert(Math.nearly_equal(shape.radius, 0.35)) }
        else => { panic("circle rigid body exposed another shape") }
    }
}

test "keep rotating circle broad phase bounds independent of rotation" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2()
        ..rotation = Math.pi() * 0.25
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(1.1, 0.0)
        ..rotation = -Math.pi() * 0.25
    )

    world.step(0.0)

    assert(world.candidate_pair_count() == 0)
    assert(world.contact_count() == 0)
}

test "rest a dynamic circle on a fixed box" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(8.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.8
    )
    var circle = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(0.0, 2.0)
        ..friction = 0.8
    )

    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(circle.position().nearly_equal(Math.Vec2(0.0, 0.5), 0.002))
    assert(circle.velocity().nearly_equal(Math.Vec2(), 0.002))
}

test "escape a near-coincident floor pair along the floor" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
    )
    var first = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.05))
        ..position = Math.Vec2(0.0, 0.05)
        ..allow_sleep = false
    )
    var second = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.05))
        ..position = Math.Vec2(0.0, 0.0505)
        ..allow_sleep = false
    )

    var correction_step = 0
    while correction_step < 30 {
        world.step(1.0 / 60.0)
        correction_step++
    }

    assert(second.position().subtract(first.position()).length() >= 0.095)
    assert(first.position().y >= 0.049)
    assert(second.position().y >= 0.049)
}

test "settle a dense circle pile without residual agitation" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(9.2, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var circles:Physics.RigidBody2D[] = []
    let radius = 0.05
    let diameter = radius * 2.0
    let spacing = diameter * 1.04
    var index = 0
    while index < 600 {
        let column = index % 40
        let row = index / 40
        circles.append(world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(radius))
            ..position = Math.Vec2(
                (column as float - 19.5) * spacing,
                radius + row as float * spacing
            )
            ..friction = 0.75
        ))
        index++
    }

    var step = 0
    while step < 600 {
        world.step(1.0 / 60.0)
        step++
    }

    assert(world.awake_body_count() == 0)
    for circle in circles {
        assert(!circle.is_awake())
        assert(circle.velocity() == Math.Vec2())
    }
    var maximum_overlap = 0.0
    var first = 0
    while first < circles.count() {
        var second = first + 1
        while second < circles.count() {
            let distance = circles[second].position()
                .subtract(circles[first].position())
                .length()
            maximum_overlap = Math.max(
                maximum_overlap,
                diameter - distance
            )
            second++
        }
        first++
    }
    assert(maximum_overlap <= 0.012)
}

test "settle a dense mixed pile without decompression" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var bodies:Physics.RigidBody2D[] = []
    var circles:Physics.RigidBody2D[] = []
    let size = 0.1
    let spacing = size * 1.04
    var index = 0
    while index < 240 {
        let column = index % 24
        let row = index / 24
        let position = Math.Vec2(
            (column as float - 11.5) * spacing,
            size * 0.5 + row as float * spacing
        )
        if index % 2 == 0 {
            var body = world.create_rigid_body(Physics.RigidBody2DSettings()
                ..shape = Physics.Shape2D.circle(Physics.Circle2D(size * 0.5))
                ..position = position
                ..friction = 0.75
            )
            circles.append(body)
            bodies.append(body)
        } else {
            var body = world.create_rigid_body(Physics.RigidBody2DSettings()
                ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(size)))
                ..position = position
                ..friction = 0.75
            )
            bodies.append(body)
        }
        index++
    }

    var step = 0
    while step < 600 {
        world.step(1.0 / 60.0)
        step++
    }

    assert(world.awake_body_count() <= 16)
    for body in bodies {
        assert(body.position().y >= 0.04)
        assert(body.position().y <= 1.2)
        assert(body.velocity().length() <= 0.1)
    }
    var maximum_circle_overlap = 0.0
    var first = 0
    while first < circles.count() {
        var second = first + 1
        while second < circles.count() {
            maximum_circle_overlap = Math.max(
                maximum_circle_overlap,
                size - circles[second].position()
                    .subtract(circles[first].position()).length()
            )
            second++
        }
        first++
    }
    assert(maximum_circle_overlap <= 0.012)
}

test "sleep quiet primitive depth below an active surface" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var bodies:Physics.RigidBody2D[] = []
    let size = 0.1
    var index = 0
    while index < 120 {
        let column = index % 12
        let row = index / 12
        var shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(size)))
        if index % 2 == 0 {
            shape = Physics.Shape2D.circle(Physics.Circle2D(size * 0.5))
        }
        bodies.append(world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = shape
            ..position = Math.Vec2(
                (column as float - 5.5) * 0.098,
                size * 0.5 + row as float * 0.098
            )
            ..friction = 0.75
        ))
        index++
    }

    var step = 0
    while step < 600 {
        bodies[115].set_angular_velocity(1.0)
        world.step(1.0 / 60.0)
        step++
    }

    var awake_depth = 0
    index = 0
    while index < 48 {
        if bodies[index].is_awake() { awake_depth++ }
        index++
    }
    assert(awake_depth <= 8)
    assert(world.awake_body_count() < 40)
}

test "remove circle overlap without waking a resting pair forever" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var first = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(-0.35, 0.0)
    )
    var second = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(0.35, 0.0)
    )

    var step = 0
    while step < 180 {
        world.step(1.0 / 60.0)
        step++
    }

    let distance = second.position().subtract(first.position()).length()
    assert(distance >= 0.995)
    assert(!first.is_awake())
    assert(!second.is_awake())
}

test "keep a sleeping circle column supporting a surface impact" {
    var world = Physics.World2D()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var supports:Physics.RigidBody2D[] = []
    var row = 0
    while row < 8 {
        supports.append(world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.05))
            ..position = Math.Vec2(0.0, 0.05 + row as float * 0.104)
            ..friction = 0.75
        ))
        row++
    }

    var step = 0
    while step < 600 {
        world.step(1.0 / 60.0)
        step++
    }
    for support in supports { assert(!support.is_awake()) }

    var impact = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.05))
        ..position = Math.Vec2(0.0, 1.2)
        ..velocity = Math.Vec2(0.0, -10.0)
        ..friction = 0.75
        ..allow_sleep = false
    )
    step = 0
    while step < 60 {
        world.step(1.0 / 60.0)
        step++
    }

    // The sleeping column is already a valid rigid support. The impact may
    // wake its exposed top, but must not walk downward one body per step.
    row = 0
    while row < supports.count() - 1 {
        assert(!supports[row].is_awake())
        row++
    }
    for support in supports {
        assert(impact.position().subtract(support.position()).length() >= 0.099)
    }
}

test "resolve circle against box when the circle was created first" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var circle = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.2))
        ..velocity = Math.Vec2(4.0, 0.0)
    )
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.2, 4.0)))
        ..position = Math.Vec2(1.1, 0.0)
    )

    var step = 0
    while step < 60 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(circle.position().x <= 0.801)
    assert(circle.velocity().x <= 0.001)
}

test "bounce one circle from another circle" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(0.0, 0.0)
        ..restitution = 1.0
    )
    var moving = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(-2.0, 0.0)
        ..velocity = Math.Vec2(2.0, 0.0)
        ..restitution = 1.0
        ..allow_sleep = false
    )

    var step = 0
    while step < 120 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(moving.velocity().x < -1.9)
    assert(moving.position().x < -1.0)
}

test "exchange velocity between two dynamic circles" {
    var world = Physics.World2D(gravity:Math.Vec2())
    var first = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(-1.0, 0.0)
        ..velocity = Math.Vec2(1.0, 0.0)
        ..restitution = 1.0
        ..allow_sleep = false
    )
    var second = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.5))
        ..position = Math.Vec2(1.0, 0.0)
        ..velocity = Math.Vec2(-1.0, 0.0)
        ..restitution = 1.0
        ..allow_sleep = false
    )

    var step = 0
    while step < 120 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(first.velocity().x < -0.99)
    assert(second.velocity().x > 0.99)
    assert(first.position().x < -0.99)
    assert(second.position().x > 0.99)
}

test "advance hundreds of bodies through the common broad phase" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.enable_parallelism(2)
    var first:Physics.RigidBody2D? = null
    var last:Physics.RigidBody2D? = null
    var index = 0
    while index < 300 {
        var body = world.create_rigid_body(Physics.RigidBody2DSettings()
            ..position = Math.Vec2(index as float * 2.0, 0.0)
            ..velocity = Math.Vec2(1.0, 0.0)
            ..allow_sleep = false
        )
        if index == 0 { first = body }
        if index == 299 { last = body }
        index++
    }

    world.step(0.25)

    if let body = first {
        assert(body.position().nearly_equal(Math.Vec2(0.25, 0.0), 0.000001))
    } else { panic("parallel test did not retain its first body") }
    if let body = last {
        assert(body.position().nearly_equal(Math.Vec2(598.25, 0.0), 0.000001))
    } else { panic("parallel test did not retain its last body") }
    assert(world.candidate_pair_count() == 0)
}

test "run the same Soft Step graph with one or four workers" {
    var direct = Physics.World2D()
    var parallel = Physics.World2D()
    direct.enable_parallelism(1)
    parallel.enable_parallelism(4)
    direct.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    parallel.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(4.0, 1.0)))
        ..position = Math.Vec2(0.0, -0.5)
        ..friction = 0.9
    )
    var direct_bodies:Physics.RigidBody2D[] = []
    var parallel_bodies:Physics.RigidBody2D[] = []
    let radius = 0.05
    let spacing = radius * 2.08
    var index = 0
    while index < 128 {
        let column = index % 16
        let row = index / 16
        let settings = Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(radius))
            ..position = Math.Vec2(
                (column as float - 7.5) * spacing,
                radius + row as float * spacing
            )
            ..friction = 0.75
            ..allow_sleep = false
        direct_bodies.append(direct.create_rigid_body(settings))
        parallel_bodies.append(parallel.create_rigid_body(settings))
        index++
    }

    var step = 0
    while step < 60 {
        direct.step(1.0 / 60.0)
        parallel.step(1.0 / 60.0)
        step++
    }

    assert(direct.soft_step_parallel_dispatch_count() == 0)
    assert(parallel.soft_step_parallel_dispatch_count() == 0)
    assert(direct.soft_step_stage_count() == parallel.soft_step_stage_count())
    index = 0
    while index < direct.soft_step_stage_count() {
        assert(direct.soft_step_stage_at(index) ==
            parallel.soft_step_stage_at(index))
        index++
    }
    index = 0
    while index < direct_bodies.count() {
        assert(direct_bodies[index].position().nearly_equal(
            parallel_bodies[index].position(),
            0.000001
        ))
        assert(direct_bodies[index].velocity().nearly_equal(
            parallel_bodies[index].velocity(),
            0.000001
        ))
        index++
    }
}

test "dispatch one conflict-free Soft Step color across four workers" {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.enable_parallelism(4)
    let pair_count = 4_100
    var pair = 0
    while pair < pair_count {
        let base_x = pair as float * 0.3
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.05))
            ..position = Math.Vec2(base_x, 0.0)
            ..allow_sleep = false
        )
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(0.05))
            ..position = Math.Vec2(base_x + 0.095, 0.0)
            ..allow_sleep = false
        )
        pair++
    }

    world.step(1.0 / 60.0)

    assert(world.soft_step_maximum_color_count() >= pair_count)
    assert(world.soft_step_parallel_dispatch_count() > 0)
}
