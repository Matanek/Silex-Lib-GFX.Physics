use GFX.Physics
use STD.Math

func print_pair(name:str, first:Physics.ShapePlacement2D, second:Physics.ShapePlacement2D, count:int) {
    let manifold = Physics.Geometry2D.manifold(first, second)
    let repeated = Physics.Geometry2D.manifold(first, second)
    let reversed = Physics.Geometry2D.manifold(second, first)
    assert(manifold.point_count() == count)
    assert(repeated.point_count() == count && reversed.point_count() == count)
    assert(manifold.normal.nearly_equal(Math.Vec2.up(), 0.0001))
    assert(reversed.normal.nearly_equal(Math.Vec2.down(), 0.0001))
    var index = 0
    while index < count {
        let point = manifold.points[index]
        assert(point.separation < 0.0)
        assert(point.point.nearly_equal(repeated.points[index].point, 0.0001))
        var found = false
        for other in reversed.points {
            if point.point.nearly_equal(other.point, 0.0001) && Math.nearly_equal(point.separation, other.separation, 0.0001) { found = true }
        }
        assert(found)
        index++
    }
    var first_index = 0
    var second_index = count - 1
    if manifold.points[first_index].point.x > manifold.points[second_index].point.x {
        first_index = count - 1
        second_index = 0
    }
    let left = manifold.points[first_index]
    if count == 1 {
        print("$(name) $(count) $(manifold.normal.x) $(manifold.normal.y) $(left.point.x) $(left.point.y) $(left.separation)")
    } else {
        let right = manifold.points[second_index]
        print("$(name) $(count) $(manifold.normal.x) $(manifold.normal.y) $(left.point.x) $(left.point.y) $(left.separation) $(right.point.x) $(right.point.y) $(right.separation)")
    }
}

func main() {
let circle = Physics.ShapePlacement2D(
    Physics.Shape2D.circle(Physics.Circle2D(1.0))
)
let box = Physics.ShapePlacement2D(
    Physics.Shape2D.box(Physics.Box2D(Math.Vec2(2.0))),
    Physics.Transform2D(position:Math.Vec2(4.0, 0.0))
)
let distance = Physics.Geometry2D.distance(circle, box)
print("distance $(distance.distance) $(distance.first_point.x) $(distance.first_point.y) $(distance.second_point.x) $(distance.second_point.y) $(distance.normal.x) $(distance.normal.y)")

let capsule = Physics.ShapePlacement2D(
    Physics.Shape2D.capsule(Physics.Capsule2D(
        Math.Vec2(-1.0, 0.0),
        Math.Vec2(1.0, 0.0),
        0.5
    ))
)
let manifold_circle = Physics.ShapePlacement2D(
    Physics.Shape2D.circle(Physics.Circle2D(0.75)),
    Physics.Transform2D(position:Math.Vec2(0.0, 1.0))
)
let manifold = Physics.Geometry2D.manifold(capsule, manifold_circle)
print("manifold $(manifold.point_count()) $(manifold.normal.x) $(manifold.normal.y) $(manifold.points[0].point.x) $(manifold.points[0].point.y) $(manifold.points[0].separation)")

let segment = Physics.ShapePlacement2D(Physics.Shape2D.segment(Physics.Segment2D(
    Math.Vec2(-2.0, 0.0), Math.Vec2(2.0, 0.0)
)))
let pair_circle = Physics.ShapePlacement2D(Physics.Shape2D.circle(Physics.Circle2D(0.5)),
    Physics.Transform2D(position:Math.Vec2(0.0, 0.4)))
let pair_capsule = Physics.ShapePlacement2D(Physics.Shape2D.capsule(Physics.Capsule2D(
    Math.Vec2(-0.75, 0.0), Math.Vec2(0.75, 0.0), 0.25
)), Physics.Transform2D(position:Math.Vec2(0.0, 0.6)))
let segment_capsule = Physics.ShapePlacement2D(Physics.Shape2D.capsule(Physics.Capsule2D(
    Math.Vec2(-0.5, 0.0), Math.Vec2(0.5, 0.0), 0.5
)), Physics.Transform2D(position:Math.Vec2(0.0, 0.4)))
print_pair("segment_circle", segment, pair_circle, 1)
print_pair("capsule_capsule", capsule, pair_capsule, 2)
print_pair("segment_capsule", segment, segment_capsule, 2)

let ray = Physics.Geometry2D.ray_cast(
    Physics.Ray2D(Math.Vec2(-3.0, 0.0), Math.Vec2(6.0, 0.0)),
    Physics.ShapePlacement2D(
        Physics.Shape2D.box(Physics.Box2D(Math.Vec2(2.0)))
    )
)
print("ray $(ray.hit) $(ray.fraction) $(ray.point.x) $(ray.point.y) $(ray.normal.x) $(ray.normal.y)")

let chain = Physics.ShapePlacement2D(
    Physics.Shape2D.chain(Physics.Chain2D([
        Math.Vec2(-3.0, 0.0),
        Math.Vec2(-2.0, 0.0),
        Math.Vec2(2.0, 0.0),
        Math.Vec2(3.0, 0.0)
    ]))
)
let chain_front = Physics.Geometry2D.ray_cast(
    Physics.Ray2D(Math.Vec2(0.0, -2.0), Math.Vec2(0.0, 4.0)),
    chain
)
print("chain_front $(chain_front.hit) $(chain_front.fraction) $(chain_front.normal.x) $(chain_front.normal.y)")
let chain_back = Physics.Geometry2D.ray_cast(
    Physics.Ray2D(Math.Vec2(0.0, 2.0), Math.Vec2(0.0, -4.0)),
    chain
)
print("chain_back $(chain_back.hit)")

let cast = Physics.Geometry2D.shape_cast(
    Physics.ShapePlacement2D(
        Physics.Shape2D.circle(Physics.Circle2D(0.5)),
        Physics.Transform2D(position:Math.Vec2(-3.0, 0.0))
    ),
    Math.Vec2(6.0, 0.0),
    Physics.ShapePlacement2D(
        Physics.Shape2D.box(Physics.Box2D(Math.Vec2(2.0)))
    )
)
print("shape_cast $(cast.hit) $(cast.fraction) $(cast.point.x) $(cast.point.y) $(cast.normal.x) $(cast.normal.y)")

let hull = Physics.Polygon2D([
    Math.Vec2(1.0, 1.0),
    Math.Vec2(-1.0, -1.0),
    Math.Vec2(-1.0, 1.0),
    Math.Vec2(1.0, -1.0),
    Math.Vec2(0.0, 0.0)
])
var area = 0.0
var index = 0
while index < hull.count() {
    let first = hull.vertex(index)
    let second = hull.vertex((index + 1) % hull.count())
    area += first.x * second.y - first.y * second.x
    index++
}
print("hull $(hull.count()) $(area)")
print("degenerate_hull 0")
}
