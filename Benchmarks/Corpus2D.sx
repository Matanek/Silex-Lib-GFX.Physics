use GFX.Physics
use STD.Math
use STD.Process
use STD.Time.Clock

func option_requested(expected:str) bool {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == expected { return true }
            }
        }
    }
    return false
}

func requested_worker_count() int {
    let workers_2 = option_requested("--workers-2")
    let workers_4 = option_requested("--workers-4")
    if workers_2 && workers_4 {
        panic("physics corpus accepts only one worker-count option")
    }
    if workers_2 { return 2 }
    if workers_4 { return 4 }
    return 1
}

func requested_substep_count() int {
    let substeps_1 = option_requested("--substeps-1")
    let substeps_2 = option_requested("--substeps-2")
    let substeps_8 = option_requested("--substeps-8")
    var selected = 0
    if substeps_1 { selected++ }
    if substeps_2 { selected++ }
    if substeps_8 { selected++ }
    if selected > 1 {
        panic("physics corpus accepts only one substep-count option")
    }
    if substeps_1 { return 1 }
    if substeps_2 { return 2 }
    if substeps_8 { return 8 }
    return 4
}

func create_fixed_box(
    world:&Physics.World2D,
    position:Math.Vec2,
    size:Math.Vec2,
    friction:float = 0.6
) {
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.box(Physics.Box2D(size))
        ..position = position
        ..friction = friction
    )
}

func measure(
    scenario:str,
    world:&Physics.World2D,
    first_body:int,
    body_count:int,
    step_count:int,
    delta:float,
    workers:int,
    substeps:int,
    circle_radius:float = 0.0
) {
    var clock = Clock()
    clock.tick()
    var step = 0
    while step < step_count {
        world.step(delta, substeps:substeps)
        step++
    }
    let elapsed_ms = clock.tick() * 1000.0

    var centroid_x = 0.0
    var centroid_y = 0.0
    var maximum_speed = 0.0
    var minimum_y = 1_000_000.0
    var signature = 0.0
    var index = 0
    while index < body_count {
        let body_index = first_body + index
        let position = world.body_position_at(body_index)
        let velocity = world.body_velocity_at(body_index)
        let angular_velocity = world.body_angular_velocity_at(body_index)
        centroid_x += position.x
        centroid_y += position.y
        maximum_speed = Math.max(maximum_speed, velocity.length())
        minimum_y = Math.min(minimum_y, position.y)
        signature += (index + 1) as float * (
            position.x + position.y * 3.0 + velocity.x * 5.0 +
            velocity.y * 7.0 + angular_velocity * 11.0
        )
        index++
    }
    if body_count > 0 {
        centroid_x /= body_count as float
        centroid_y /= body_count as float
    }

    var maximum_overlap_mm = -1.0
    if circle_radius > 0.0 {
        maximum_overlap_mm = 0.0
        let diameter = circle_radius * 2.0
        var first = 0
        while first < body_count {
            let first_position = world.body_position_at(first_body + first)
            var second = first + 1
            while second < body_count {
                let distance = world.body_position_at(first_body + second)
                    .subtract(first_position).length()
                maximum_overlap_mm = Math.max(
                    maximum_overlap_mm,
                    (diameter - distance) * 1_000.0
                )
                second++
            }
            first++
        }
    }

    var mode = "release"
    if option_requested("--debug-build") { mode = "debug" }
    print(
        "SILEX_PHYSICS_CORPUS schema=2 engine=silex-current " +
        "engine_version=gfx-physics-0.5.0 oracle_version=3.1.1 " +
        "oracle_revision=8c661469c9507d3ad6fbd2fea3f1aa71669c2fe3 " +
        "solver=soft-step substeps=$(substeps) scenario=$(scenario) " +
        "mode=$(mode) workers=$(workers) bodies=$(body_count) steps=$(step_count) dt=$(delta) " +
        "elapsed_ms=$(elapsed_ms) step_ms=$(elapsed_ms / step_count as float) " +
        "centroid_x=$(centroid_x) centroid_y=$(centroid_y) max_speed=$(maximum_speed) min_y=$(minimum_y) " +
        "max_overlap_mm=$(maximum_overlap_mm) awake=$(world.awake_body_count()) " +
        "contacts=$(world.collision_count()) state_signature=$(signature) memory_bytes=-1 " +
        "candidate_slots=$(world.candidate_pair_slot_count()) " +
        "persistent_pairs=$(world.persistent_pair_count()) " +
        "constraints=$(world.constraint_count()) " +
        "compact_constraints=$(world.compact_collision_count()) " +
        "parallel_dispatches=$(world.soft_step_parallel_dispatch_count()) " +
        "maximum_color_count=$(world.soft_step_maximum_color_count())"
    )
}

func enable_workers(world:&Physics.World2D, workers:int) {
    if workers > 1 { world.enable_parallelism(workers) }
}

func run_release_parity(workers:int, substeps:int) {
    var world = Physics.World2D()
    enable_workers(world, workers)
    create_fixed_box(world, Math.Vec2(0.0, -0.5), Math.Vec2(8.0, 1.0))
    let first_body = world.body_count()
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0)))
        ..position = Math.Vec2(0.0, 2.0)
    )
    measure(
        "release-parity",
        world,
        first_body,
        1,
        120,
        1.0 / 120.0,
        workers,
        substeps
    )
}

func run_sparse(body_count:int, workers:int, substeps:int) {
    var world = Physics.World2D(gravity:Math.Vec2())
    enable_workers(world, workers)
    let first_body = world.body_count()
    var index = 0
    while index < body_count {
        let column = index % 100
        let row = index / 100
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.5)))
            ..position = Math.Vec2(column as float * 1.25, row as float * 1.25)
            ..velocity = Math.Vec2(2.0, 0.25)
            ..allow_sleep = false
        )
        index++
    }
    measure(
        "sparse-$(body_count)",
        world,
        first_body,
        body_count,
        120,
        1.0 / 60.0,
        workers,
        substeps
    )
}

func run_pile(workers:int, substeps:int) {
    let body_count = 1_000
    let columns = 50
    var world = Physics.World2D()
    enable_workers(world, workers)
    create_fixed_box(world, Math.Vec2(0.0, -0.5), Math.Vec2(24.0, 1.0), 0.8)
    let first_body = world.body_count()
    var index = 0
    while index < body_count {
        let column = index % columns
        let row = index / columns
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(0.4)))
            ..position = Math.Vec2(
                (column as float - 24.5) * 0.405,
                0.2 + row as float * 0.405
            )
            ..rotation = ((index % 3) as float - 1.0) * 0.002
            ..friction = 0.75
            ..angular_damping = 0.12
        )
        index++
    }
    measure(
        "pile-1000",
        world,
        first_body,
        body_count,
        240,
        1.0 / 60.0,
        workers,
        substeps
    )
}

func create_container(world:&Physics.World2D, width:float, height:float) {
    let depth = 4.0
    let half_width = width * 0.5
    let half_height = height * 0.5
    let half_depth = depth * 0.5
    create_fixed_box(world, Math.Vec2(-half_width - half_depth, 0.0), Math.Vec2(depth, height), 0.9)
    create_fixed_box(world, Math.Vec2(half_width + half_depth, 0.0), Math.Vec2(depth, height), 0.9)
    create_fixed_box(world, Math.Vec2(0.0, -half_height - half_depth), Math.Vec2(width + depth * 2.0, depth), 0.9)
    create_fixed_box(world, Math.Vec2(0.0, half_height + half_depth), Math.Vec2(width + depth * 2.0, depth), 0.9)
}

func run_circle(body_count:int, workers:int, substeps:int) {
    var radius = 0.05
    var columns = 87
    if body_count > 2_000 {
        radius = 0.025
        columns = 170
    }
    let spacing = radius * 2.0 * 1.04
    let width = 9.2
    let height = 6.0
    let half_height = height * 0.5
    var world = Physics.World2D()
    enable_workers(world, workers)
    create_container(world, width, height)
    let first_body = world.body_count()
    var index = 0
    while index < body_count {
        let column = index % columns
        let row = index / columns
        world.create_rigid_body(Physics.RigidBody2DSettings()
            ..shape = Physics.Shape2D.circle(Physics.Circle2D(radius))
            ..position = Math.Vec2(
                (column as float - (columns - 1) as float * 0.5) * spacing,
                -half_height + radius * 1.05 + row as float * spacing
            )
            ..friction = 0.75
            ..angular_damping = 0.12
            ..allow_sleep = false
        )
        index++
    }
    measure(
        "circle-$(body_count)",
        world,
        first_body,
        body_count,
        300,
        1.0 / 60.0,
        workers,
        substeps,
        radius
    )
}

func main() {
    let workers = requested_worker_count()
    let substeps = requested_substep_count()
    if option_requested("--release-parity") {
        run_release_parity(workers, substeps)
        return
    }
    if option_requested("--sparse-1000") {
        run_sparse(1_000, workers, substeps)
        return
    }
    if option_requested("--sparse-5000") {
        run_sparse(5_000, workers, substeps)
        return
    }
    if option_requested("--sparse-10000") {
        run_sparse(10_000, workers, substeps)
        return
    }
    if option_requested("--pile-1000") {
        run_pile(workers, substeps)
        return
    }
    if option_requested("--circle-1800") {
        run_circle(1_800, workers, substeps)
        return
    }
    if option_requested("--circle-5000") {
        run_circle(5_000, workers, substeps)
        return
    }

    // Keep the no-argument smoke useful while CI selects each worker count in
    // a distinct process, so every world owns one executor lifetime.
    run_sparse(10_000, 1, substeps)
}
