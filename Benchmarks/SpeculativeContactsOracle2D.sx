use GFX.Physics
use STD.Math
use STD.Process
func shape(family:int, fixed:bool) Physics.Shape2D {
    if family==0 { return Physics.Shape2D.circle(Physics.Circle2D(0.5)) }
    if family==1 { return Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.0))) }
    if family==3 && fixed { return Physics.Shape2D.segment(Physics.Segment2D(Math.Vec2(-2.0,0.0),Math.Vec2(2.0,0.0))) }
    return Physics.Shape2D.capsule(Physics.Capsule2D(Math.Vec2(-0.25,0.0),Math.Vec2(0.25,0.0),0.5))
}
func run_case(family:int,gap_index:int,speed_index:int,substeps:int,timing:int,warm_start:bool) {
    let gaps:float[]=[0.004,0.01,0.019,0.021]
    let speeds:float[]=[0.0,-0.3,-3.0,-1.0]
    var height=1.0
    if family==3 { height=0.5 }
    let y=height+gaps[gap_index]
    let geometry=Physics.Geometry2D.manifold(Physics.ShapePlacement2D(shape(family,true)),
        Physics.ShapePlacement2D(shape(family,false),Physics.Transform2D(position:Math.Vec2(0.0,y))))
    var initial_separation=0.0
    if geometry.point_count()>0 { initial_separation=geometry.points[0].separation }
    var world=Physics.World2D(Physics.World2DSettings() ..gravity=Math.Vec2() ..continuous_collision_enabled=false ..contact_stiffness_hertz=40.0 ..warm_start_enabled=warm_start)
    world.create_rigid_body(Physics.RigidBody2DSettings() ..body_type=Physics.BodyType2D.fixed
        ..shape=shape(family,true) ..friction=0.0 ..enable_contact_events=true ..enable_hit_events=true)
    var body=world.create_rigid_body(Physics.RigidBody2DSettings() ..shape=shape(family,false)
        ..position=Math.Vec2(0.0,y) ..velocity=Math.Vec2(0.0,speeds[speed_index])
        ..allow_sleep=false ..fixed_rotation=true ..friction=0.0 ..enable_contact_events=true ..enable_hit_events=true)
    body.set_mass_properties(Physics.MassProperties2D(1.0,0.0))
    var step=0
    while step<6 {
        var delta=1.0/60.0
        if timing==1 { delta=1.0/600.0 }
        world.step(delta,substeps)
        var began:Physics.ContactBeginEvent2D[]=[]
        var ended:Physics.ContactEndEvent2D[]=[]
        var hits:Physics.ContactHitEvent2D[]=[]
        var contacts:Physics.Contact2D[]=[]
        world.write_contact_begin_events(began);world.write_contact_end_events(ended);world.write_contact_hit_events(hits);world.write_contacts(contacts)
        var points=0;var impulse=0.0;var separation=0.0
        for contact in contacts {
            let m=contact.manifold();points+=m.point_count()
            if m.point_count()>0 { separation=m.points[0].separation }
            for value in contact.normal_impulses() { impulse+=value }
        }
        print("spec_$(family)_$(gap_index)_$(speed_index)_$(substeps)_$(step)_$(timing) $(geometry.point_count()) $(initial_separation) $(body.position().y) $(body.velocity().y) $(began.count()) $(ended.count()) $(hits.count()) $(contacts.count()) $(points) $(separation) $(impulse)")
        step++
    }
}
func main() {
    var warm_start = true
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--no-warm-start" { warm_start = false }
            }
        }
    }
    for family in 0...4 { for gap in 0...4 { for speed in 0...4 { for timing in 0...2 {
        run_case(family,gap,speed,1,timing,warm_start);run_case(family,gap,speed,4,timing,warm_start)
    } } } }
}
