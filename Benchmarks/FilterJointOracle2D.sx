use GFX.Physics
use STD.Math

func pair_mask(pair:Physics.ContactPairSnapshot2D) int {
    if let id = pair.first().application_id {
        if id == 10 { return 1 }
        if id == 20 { return 2 }
    }
    panic("unknown filter contact surface")
}

func record(world:Physics.World2D, body:Physics.RigidBody2D, scene:int, stage:int) {
    var began:Physics.ContactBeginEvent2D[] = []
    var ended:Physics.ContactEndEvent2D[] = []
    var contacts:Physics.Contact2D[] = []
    world.write_contact_begin_events(began)
    world.write_contact_end_events(ended)
    world.write_contacts(contacts)
    var begin_mask = 0
    var end_mask = 0
    var contact_mask = 0
    var impulse = 0.0
    for event in began { begin_mask += pair_mask(event.pair()) }
    for event in ended { end_mask += pair_mask(event.pair()) }
    for contact in contacts {
        contact_mask += pair_mask(contact.pair())
        for value in contact.normal_impulses() { impulse += value }
    }
    print("filter_$(scene)_$(stage) $(began.count()) $(begin_mask) $(ended.count()) $(end_mask) $(contacts.count()) $(contact_mask) $(body.position().y) $(body.velocity().y) $(impulse)")
}

func scenario(scene:int) {
    var world = Physics.World2D(Physics.World2DSettings()
        ..gravity = Math.Vec2() ..continuous_collision_enabled = false
        ..contact_stiffness_hertz = 40.0)
    var ground = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed ..create_implicit_collider = false)
    for index in 0...2 {
        let x = -2.0 + index as float * 4.0
        world.create_collider(ground, Physics.Collider2DSettings()
            ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
                Math.Vec2(x - 0.5, -0.5), Math.Vec2(x + 0.5, -0.5),
                Math.Vec2(x + 0.5, 0.5), Math.Vec2(x - 0.5, 0.5)
            ]))
            ..application_id = (index + 1) as uint64 * 10
            ..enable_contact_events = true)
    }
    var body = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(6.0, 1.0)))
        ..position = Math.Vec2(0.0, 0.99) ..velocity = Math.Vec2(0.0, -2.0)
        ..fixed_rotation = true ..allow_sleep = false ..enable_contact_events = true)
    body.set_mass_properties(Physics.MassProperties2D(1.0, 0.0))
    var filter:Physics.FilterJoint2D? = null
    var motor:Physics.MotorJoint2D? = null
    if scene == 0 { filter = world.create_filter_joint(ground, body) }
    var stage = 0
    while stage < 8 {
        if stage == 1 {
            if scene == 1 { filter = world.create_filter_joint(ground, body) }
            if scene == 2 {
                motor = world.create_motor_joint(ground, body, Physics.MotorJoint2DSettings()
                    ..maximum_force = 0.0 ..maximum_torque = 0.0 ..collide_connected = false)
            }
            body.set_velocity(Math.Vec2(0.0, -2.0))
        }
        if stage == 2 {
            if let joint = motor { joint.set_collide_connected(true) }
            body.set_velocity(Math.Vec2(0.0, -2.0))
        }
        if stage == 3 {
            if let joint = motor { joint.set_collide_connected(false) }
            body.set_position(Math.Vec2(0.0, 3.0))
            body.set_velocity(Math.Vec2())
        }
        if stage == 4 {
            if let joint = motor { joint.set_collide_connected(false) }
            body.set_position(Math.Vec2(0.0, 0.99))
            body.set_velocity(Math.Vec2(0.0, -2.0))
        }
        if stage == 5 {
            if let joint = filter { world.destroy_joint(joint) }
            if let joint = motor { world.destroy_joint(joint) }
            body.set_velocity(Math.Vec2())
        }
        if stage == 6 { body.set_position(Math.Vec2(0.0, 3.0)); body.set_velocity(Math.Vec2()) }
        if stage == 7 { body.set_position(Math.Vec2(0.0, 0.99)); body.set_velocity(Math.Vec2(0.0, -2.0)) }
        world.step(0.001, 4)
        record(world, body, scene, stage)
        stage++
    }
}

func main() {
    for scene in 0...3 { scenario(scene) }
}
