use GFX.Physics.Box2D.Box2D
use GFX.Physics.Circle2D.Circle2D
use GFX.Physics.CollisionFilter2D.CollisionFilter2D
use GFX.Physics.Shape2D.Shape2D
use STD.Math

public enum BodyType2D {
    fixed
    dynamic
}

public struct RigidBody2DSettings {
    var body_type:BodyType2D
    var shape:Shape2D?
    var position:Math.Vec2
    var velocity:Math.Vec2
    var rotation:float
    var angular_velocity:float
    var gravity_scale:float
    var mass:float
    var restitution:float
    var friction:float
    var linear_damping:float
    var angular_damping:float
    var allow_sleep:bool
    var is_bullet:bool
    var is_sensor:bool
    var enable_move_events:bool
    var enable_contact_events:bool
    var enable_hit_events:bool
    var enable_sensor_events:bool
    var collision_filter:CollisionFilter2D

    init() {
        self.body_type = BodyType2D.dynamic
        self.shape = null
        self.position = Math.Vec2()
        self.velocity = Math.Vec2()
        self.rotation = 0.0
        self.angular_velocity = 0.0
        self.gravity_scale = 1.0
        self.mass = 1.0
        self.restitution = 0.0
        self.friction = 0.6
        self.linear_damping = 0.0
        self.angular_damping = 0.0
        self.allow_sleep = true
        self.is_bullet = false
        self.is_sensor = false
        self.enable_move_events = false
        self.enable_contact_events = false
        self.enable_hit_events = false
        self.enable_sensor_events = false
        self.collision_filter = CollisionFilter2D()
    }
}

package struct BodyId2D {
    let slot:int
    let generation:int

    init() {
        self.slot = -1
        self.generation = 0
    }

    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

package struct ShapeId2D {
    let slot:int
    let generation:int

    init() {
        self.slot = -1
        self.generation = 0
    }

    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

package class ShapeStore2D {
    var slot_generations:int[]
    var slot_dense_indices:int[]
    var dense_slots:int[]
    var free_slots:int[]
    var body_slots:int[]
    var shapes:Shape2D[]
    var next_body_shape_slots:int[]

    init() {
        self.slot_generations = []
        self.slot_dense_indices = []
        self.dense_slots = []
        self.free_slots = []
        self.body_slots = []
        self.shapes = []
        self.next_body_shape_slots = []
    }

    func count() int { return self.dense_slots.count() }

    func append(body_slot:int, shape:Shape2D, next_slot:int) ShapeId2D {
        var slot = self.slot_generations.count()
        if !self.free_slots.is_empty() {
            slot = self.free_slots.take_last()
        } else {
            self.slot_generations.append(1)
            self.slot_dense_indices.append(-1)
        }
        let dense_index = self.count()
        self.slot_dense_indices[slot] = dense_index
        self.dense_slots.append(slot)
        self.body_slots.append(body_slot)
        self.shapes.append(shape)
        self.next_body_shape_slots.append(next_slot)
        return ShapeId2D(slot, self.slot_generations[slot])
    }

    func require(id:ShapeId2D) int {
        if !self.contains(id) {
            panic("GFX.Physics shape handle no longer refers to a live shape")
        }
        return self.slot_dense_indices[id.slot]
    }

    func contains(id:ShapeId2D) bool {
        return id.slot >= 0 && id.slot < self.slot_generations.count() &&
            self.slot_generations[id.slot] == id.generation &&
            self.slot_dense_indices[id.slot] >= 0
    }

    func destroy(id:ShapeId2D) {
        let dense_index = self.require(id)
        let last = self.count() - 1
        if dense_index != last {
            self.dense_slots.swap(dense_index, last)
            self.body_slots.swap(dense_index, last)
            self.shapes.swap(dense_index, last)
            self.next_body_shape_slots.swap(dense_index, last)
            self.slot_dense_indices[self.dense_slots[dense_index]] = dense_index
        }
        self.dense_slots.take_last()
        self.body_slots.take_last()
        self.shapes.take_last()
        self.next_body_shape_slots.take_last()
        self.slot_dense_indices[id.slot] = -1
        self.slot_generations[id.slot]++
        self.free_slots.append(id.slot)
    }
}

struct ShapeMetrics2D {
    let kind:int
    let half_width:float
    let half_height:float
    let radius:float
    let sweep_radius_squared:float
    let inverse_inertia_factor:float
    let lower:Math.Vec2
    let upper:Math.Vec2

    init(
        kind:int,
        half_width:float,
        half_height:float,
        radius:float,
        sweep_radius_squared:float,
        inverse_inertia_factor:float,
        lower:Math.Vec2,
        upper:Math.Vec2
    ) {
        self.kind = kind
        self.half_width = half_width
        self.half_height = half_height
        self.radius = radius
        self.sweep_radius_squared = sweep_radius_squared
        self.inverse_inertia_factor = inverse_inertia_factor
        self.lower = lower
        self.upper = upper
    }
}

func shape_metrics(shape:Shape2D) ShapeMetrics2D {
    var kind = 2
    var radius = 0.0
    var lower = Math.Vec2(3.4028235e38)
    var upper = Math.Vec2(-3.4028235e38)
    var sweep_radius = 0.0
    var inverse_inertia_factor = 0.0
    match shape {
        box(value) => {
            if value.radius == 0.0 { kind = 0 }
            radius = value.radius
            let half = value.half_size()
            lower = Math.Vec2(-half.x - radius, -half.y - radius)
            upper = Math.Vec2(half.x + radius, half.y + radius)
            sweep_radius = Math.sqrt(half.x * half.x + half.y * half.y) +
                radius
            inverse_inertia_factor = 12.0 / (
                value.size.x * value.size.x + value.size.y * value.size.y
            )
        }
        capsule(value) => {
            radius = value.radius
            lower = Math.Vec2(
                Math.min(value.first.x, value.second.x) - radius,
                Math.min(value.first.y, value.second.y) - radius
            )
            upper = Math.Vec2(
                Math.max(value.first.x, value.second.x) + radius,
                Math.max(value.first.y, value.second.y) + radius
            )
            sweep_radius = Math.max(value.first.length(), value.second.length()) +
                radius
        }
        chain(value) => {
            kind = 3
            for point in value.points {
                lower.x = Math.min(lower.x, point.x)
                lower.y = Math.min(lower.y, point.y)
                upper.x = Math.max(upper.x, point.x)
                upper.y = Math.max(upper.y, point.y)
                sweep_radius = Math.max(sweep_radius, point.length())
            }
        }
        circle(value) => {
            kind = 1
            radius = value.radius
            lower = Math.Vec2(-radius)
            upper = Math.Vec2(radius)
            sweep_radius = radius
            inverse_inertia_factor = 2.0 / (radius * radius)
        }
        polygon(value) => {
            radius = value.radius
            for point in value.vertices {
                lower.x = Math.min(lower.x, point.x - radius)
                lower.y = Math.min(lower.y, point.y - radius)
                upper.x = Math.max(upper.x, point.x + radius)
                upper.y = Math.max(upper.y, point.y + radius)
                sweep_radius = Math.max(sweep_radius, point.length() + radius)
            }
        }
        segment(value) => {
            lower = Math.Vec2(
                Math.min(value.first.x, value.second.x),
                Math.min(value.first.y, value.second.y)
            )
            upper = Math.Vec2(
                Math.max(value.first.x, value.second.x),
                Math.max(value.first.y, value.second.y)
            )
            sweep_radius = Math.max(value.first.length(), value.second.length())
        }
    }
    let half = upper.subtract(lower).multiply(0.5)
    if inverse_inertia_factor == 0.0 && sweep_radius > 0.0 {
        inverse_inertia_factor = 2.0 / (sweep_radius * sweep_radius)
    }
    return ShapeMetrics2D(
        kind,
        half.x,
        half.y,
        radius,
        sweep_radius * sweep_radius,
        inverse_inertia_factor,
        lower,
        upper
    )
}

package class BodyStore2D {
    var slot_generations:int[]
    var slot_dense_indices:int[]
    var dense_slots:int[]
    var free_slots:int[]
    var shape_store:ShapeStore2D
    var first_shape_slots:int[]
    var shape_counts:int[]
    var body_types:BodyType2D[]
    var shapes:Shape2D[]
    var shape_kinds:int[]
    var half_widths:float[]
    var half_heights:float[]
    var radii:float[]
    var sweep_radii_squared:float[]
    var local_lower_x:float[]
    var local_lower_y:float[]
    var local_upper_x:float[]
    var local_upper_y:float[]
    var collision_filters:CollisionFilter2D[]
    var positions_x:float[]
    var positions_y:float[]
    var previous_positions_x:float[]
    var previous_positions_y:float[]
    var previous_rotations:float[]
    var velocities_x:float[]
    var velocities_y:float[]
    var rotations:float[]
    var rotation_cosines:float[]
    var rotation_sines:float[]
    var angular_velocities:float[]
    var gravity_scales:float[]
    var inverse_masses:float[]
    var inverse_inertias:float[]
    var restitutions:float[]
    var friction_roots:float[]
    var linear_dampings:float[]
    var angular_dampings:float[]
    var allow_sleep:bool[]
    var bullets:bool[]
    var sensors:bool[]
    var move_events_enabled:bool[]
    var contact_events_enabled:bool[]
    var hit_events_enabled:bool[]
    var sensor_events_enabled:bool[]
    var awake:bool[]
    var sleep_times:float[]
    var dirty_transforms:bool[]
    var world_locked:bool

    init() {
        self.slot_generations = []
        self.slot_dense_indices = []
        self.dense_slots = []
        self.free_slots = []
        self.shape_store = ShapeStore2D()
        self.first_shape_slots = []
        self.shape_counts = []
        self.body_types = []
        self.shapes = []
        self.shape_kinds = []
        self.half_widths = []
        self.half_heights = []
        self.radii = []
        self.sweep_radii_squared = []
        self.local_lower_x = []
        self.local_lower_y = []
        self.local_upper_x = []
        self.local_upper_y = []
        self.collision_filters = []
        self.positions_x = []
        self.positions_y = []
        self.previous_positions_x = []
        self.previous_positions_y = []
        self.previous_rotations = []
        self.velocities_x = []
        self.velocities_y = []
        self.rotations = []
        self.rotation_cosines = []
        self.rotation_sines = []
        self.angular_velocities = []
        self.gravity_scales = []
        self.inverse_masses = []
        self.inverse_inertias = []
        self.restitutions = []
        self.friction_roots = []
        self.linear_dampings = []
        self.angular_dampings = []
        self.allow_sleep = []
        self.bullets = []
        self.sensors = []
        self.move_events_enabled = []
        self.contact_events_enabled = []
        self.hit_events_enabled = []
        self.sensor_events_enabled = []
        self.awake = []
        self.sleep_times = []
        self.dirty_transforms = []
        self.world_locked = false
    }

    func count() int { return self.positions_x.count() }

    func append(settings:RigidBody2DSettings) BodyId2D {
        validate_settings(settings)
        let index = self.count()
        var slot = self.slot_generations.count()
        if !self.free_slots.is_empty() {
            slot = self.free_slots.take_last()
        } else {
            self.slot_generations.append(1)
            self.slot_dense_indices.append(-1)
        }
        self.slot_dense_indices[slot] = index
        self.dense_slots.append(slot)
        var selected_shape = Shape2D.box(Box2D())
        if let configured = settings.shape { selected_shape = configured }
        let metrics = shape_metrics(selected_shape)
        let shape_kind = metrics.kind
        let half_width = metrics.half_width
        let half_height = metrics.half_height
        let radius = metrics.radius
        let sweep_radius_squared = metrics.sweep_radius_squared
        if settings.body_type == BodyType2D.dynamic && shape_kind == 3 {
            panic("GFX.Physics.World2D requires chain body shapes to be fixed")
        }
        var inverse_mass = 0.0
        var inverse_inertia = 0.0
        if settings.body_type == BodyType2D.dynamic {
            inverse_mass = 1.0 / settings.mass
            inverse_inertia = metrics.inverse_inertia_factor / settings.mass
        }
        let shape_id = self.shape_store.append(slot, selected_shape, -1)
        self.first_shape_slots.append(shape_id.slot)
        self.shape_counts.append(1)
        self.body_types.append(settings.body_type)
        self.shapes.append(selected_shape)
        self.shape_kinds.append(shape_kind)
        self.half_widths.append(half_width)
        self.half_heights.append(half_height)
        self.radii.append(radius)
        self.sweep_radii_squared.append(sweep_radius_squared)
        self.local_lower_x.append(metrics.lower.x)
        self.local_lower_y.append(metrics.lower.y)
        self.local_upper_x.append(metrics.upper.x)
        self.local_upper_y.append(metrics.upper.y)
        self.collision_filters.append(settings.collision_filter)
        self.positions_x.append(settings.position.x)
        self.positions_y.append(settings.position.y)
        self.previous_positions_x.append(settings.position.x)
        self.previous_positions_y.append(settings.position.y)
        self.previous_rotations.append(settings.rotation)
        self.velocities_x.append(settings.velocity.x)
        self.velocities_y.append(settings.velocity.y)
        self.rotations.append(settings.rotation)
        self.rotation_cosines.append(Math.cos(settings.rotation))
        self.rotation_sines.append(Math.sin(settings.rotation))
        self.angular_velocities.append(settings.angular_velocity)
        self.gravity_scales.append(settings.gravity_scale)
        self.inverse_masses.append(inverse_mass)
        self.inverse_inertias.append(inverse_inertia)
        self.restitutions.append(settings.restitution)
        self.friction_roots.append(Math.sqrt(settings.friction))
        self.linear_dampings.append(settings.linear_damping)
        self.angular_dampings.append(settings.angular_damping)
        self.allow_sleep.append(settings.allow_sleep)
        self.bullets.append(settings.is_bullet)
        self.sensors.append(settings.is_sensor)
        self.move_events_enabled.append(settings.enable_move_events)
        self.contact_events_enabled.append(settings.enable_contact_events)
        self.hit_events_enabled.append(settings.enable_hit_events)
        self.sensor_events_enabled.append(settings.enable_sensor_events)
        self.awake.append(settings.body_type == BodyType2D.dynamic)
        self.sleep_times.append(0.0)
        self.dirty_transforms.append(true)
        return BodyId2D(slot, self.slot_generations[slot])
    }

    func require(id:BodyId2D) int {
        if !self.contains(id) {
            panic("GFX.Physics.RigidBody2D no longer refers to a live body")
        }
        return self.slot_dense_indices[id.slot]
    }

    func contains(id:BodyId2D) bool {
        return id.slot >= 0 && id.slot < self.slot_generations.count() &&
            self.slot_generations[id.slot] == id.generation &&
            self.slot_dense_indices[id.slot] >= 0
    }

    func shape_count(id:BodyId2D) int {
        return self.shape_counts[self.require(id)]
    }

    func body_id_at(index:int) BodyId2D {
        let slot = self.dense_slots[index]
        return BodyId2D(slot, self.slot_generations[slot])
    }

    func attach_shape(id:BodyId2D, shape:Shape2D) ShapeId2D {
        let index = self.require(id)
        let shape_id = self.shape_store.append(
            id.slot,
            shape,
            self.first_shape_slots[index]
        )
        self.first_shape_slots[index] = shape_id.slot
        self.shape_counts[index]++
        return shape_id
    }

    func destroy(id:BodyId2D) int {
        let dense_index = self.require(id)
        var shape_slot = self.first_shape_slots[dense_index]
        while shape_slot >= 0 {
            let shape_dense = self.shape_store.slot_dense_indices[shape_slot]
            let next_slot = self.shape_store.next_body_shape_slots[shape_dense]
            self.shape_store.destroy(ShapeId2D(
                shape_slot,
                self.shape_store.slot_generations[shape_slot]
            ))
            shape_slot = next_slot
        }

        let last = self.count() - 1
        if dense_index != last {
            self.swap_dense(dense_index, last)
            self.slot_dense_indices[self.dense_slots[dense_index]] = dense_index
        }
        self.take_last_dense()
        self.slot_dense_indices[id.slot] = -1
        self.slot_generations[id.slot]++
        self.free_slots.append(id.slot)
        return dense_index
    }

    func wake(index:int) {
        if self.body_types[index] == BodyType2D.fixed { return }
        self.awake[index] = true
        self.sleep_times[index] = 0.0
    }

    func require_mutable() {
        if self.world_locked {
            panic("GFX.Physics.World2D cannot be modified during step")
        }
    }

    func cache_rotation(index:int) {
        self.rotation_cosines[index] = Math.cos(self.rotations[index])
        self.rotation_sines[index] = Math.sin(self.rotations[index])
    }

    private func swap_dense(first:int, second:int) {
        self.dense_slots.swap(first, second)
        self.first_shape_slots.swap(first, second)
        self.shape_counts.swap(first, second)
        self.body_types.swap(first, second)
        self.shapes.swap(first, second)
        self.shape_kinds.swap(first, second)
        self.half_widths.swap(first, second)
        self.half_heights.swap(first, second)
        self.radii.swap(first, second)
        self.sweep_radii_squared.swap(first, second)
        self.local_lower_x.swap(first, second)
        self.local_lower_y.swap(first, second)
        self.local_upper_x.swap(first, second)
        self.local_upper_y.swap(first, second)
        self.collision_filters.swap(first, second)
        self.positions_x.swap(first, second)
        self.positions_y.swap(first, second)
        self.previous_positions_x.swap(first, second)
        self.previous_positions_y.swap(first, second)
        self.previous_rotations.swap(first, second)
        self.velocities_x.swap(first, second)
        self.velocities_y.swap(first, second)
        self.rotations.swap(first, second)
        self.rotation_cosines.swap(first, second)
        self.rotation_sines.swap(first, second)
        self.angular_velocities.swap(first, second)
        self.gravity_scales.swap(first, second)
        self.inverse_masses.swap(first, second)
        self.inverse_inertias.swap(first, second)
        self.restitutions.swap(first, second)
        self.friction_roots.swap(first, second)
        self.linear_dampings.swap(first, second)
        self.angular_dampings.swap(first, second)
        self.allow_sleep.swap(first, second)
        self.bullets.swap(first, second)
        self.sensors.swap(first, second)
        self.move_events_enabled.swap(first, second)
        self.contact_events_enabled.swap(first, second)
        self.hit_events_enabled.swap(first, second)
        self.sensor_events_enabled.swap(first, second)
        self.awake.swap(first, second)
        self.sleep_times.swap(first, second)
        self.dirty_transforms.swap(first, second)
    }

    private func take_last_dense() {
        self.dense_slots.take_last()
        self.first_shape_slots.take_last()
        self.shape_counts.take_last()
        self.body_types.take_last()
        self.shapes.take_last()
        self.shape_kinds.take_last()
        self.half_widths.take_last()
        self.half_heights.take_last()
        self.radii.take_last()
        self.sweep_radii_squared.take_last()
        self.local_lower_x.take_last()
        self.local_lower_y.take_last()
        self.local_upper_x.take_last()
        self.local_upper_y.take_last()
        self.collision_filters.take_last()
        self.positions_x.take_last()
        self.positions_y.take_last()
        self.previous_positions_x.take_last()
        self.previous_positions_y.take_last()
        self.previous_rotations.take_last()
        self.velocities_x.take_last()
        self.velocities_y.take_last()
        self.rotations.take_last()
        self.rotation_cosines.take_last()
        self.rotation_sines.take_last()
        self.angular_velocities.take_last()
        self.gravity_scales.take_last()
        self.inverse_masses.take_last()
        self.inverse_inertias.take_last()
        self.restitutions.take_last()
        self.friction_roots.take_last()
        self.linear_dampings.take_last()
        self.angular_dampings.take_last()
        self.allow_sleep.take_last()
        self.bullets.take_last()
        self.sensors.take_last()
        self.move_events_enabled.take_last()
        self.contact_events_enabled.take_last()
        self.hit_events_enabled.take_last()
        self.sensor_events_enabled.take_last()
        self.awake.take_last()
        self.sleep_times.take_last()
        self.dirty_transforms.take_last()
    }
}

public class RigidBody2D {
    private var store:BodyStore2D
    private let id:BodyId2D

    module init(store:BodyStore2D, id:BodyId2D) {
        self.store = store
        self.id = id
    }

    func is_valid() bool { return self.store.contains(self.id) }

    package func belongs_to(store:BodyStore2D) bool {
        return self.store == store
    }

    package func body_id() BodyId2D { return self.id }

    func body_type() BodyType2D {
        let index = self.store.require(self.id)
        return self.store.body_types[index]
    }

    func shape() Shape2D {
        let index = self.store.require(self.id)
        return self.store.shapes[index]
    }

    func position() Math.Vec2 {
        let index = self.store.require(self.id)
        return Math.Vec2(
            self.store.positions_x[index],
            self.store.positions_y[index]
        )
    }

    func velocity() Math.Vec2 {
        let index = self.store.require(self.id)
        return Math.Vec2(
            self.store.velocities_x[index],
            self.store.velocities_y[index]
        )
    }

    func rotation() float {
        return self.store.rotations[self.store.require(self.id)]
    }

    func angular_velocity() float {
        return self.store.angular_velocities[self.store.require(self.id)]
    }

    func gravity_scale() float {
        return self.store.gravity_scales[self.store.require(self.id)]
    }

    func is_bullet() bool {
        return self.store.bullets[self.store.require(self.id)]
    }

    func is_sensor() bool {
        return self.store.sensors[self.store.require(self.id)]
    }

    func is_awake() bool {
        return self.store.awake[self.store.require(self.id)]
    }

    func set_position(position:Math.Vec2) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        self.store.positions_x[index] = position.x
        self.store.positions_y[index] = position.y
        self.store.dirty_transforms[index] = true
        self.store.wake(index)
    }

    func set_velocity(velocity:Math.Vec2) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        self.store.velocities_x[index] = velocity.x
        self.store.velocities_y[index] = velocity.y
        self.store.wake(index)
    }

    func set_rotation(rotation:float) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        self.store.rotations[index] = rotation
        self.store.cache_rotation(index)
        self.store.dirty_transforms[index] = true
        self.store.wake(index)
    }

    func set_angular_velocity(velocity:float) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        self.store.angular_velocities[index] = velocity
        self.store.wake(index)
    }

    func set_gravity_scale(scale:float) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        self.store.gravity_scales[index] = scale
        self.store.wake(index)
    }

    func wake_up() {
        self.store.require_mutable()
        self.store.wake(self.store.require(self.id))
    }
}

func validate_settings(settings:RigidBody2DSettings) {
    if settings.mass <= 0.0 {
        panic("GFX.Physics.RigidBody2D requires a positive mass")
    }
    if settings.restitution < 0.0 || settings.restitution > 1.0 {
        panic("GFX.Physics.RigidBody2D restitution must be between zero and one")
    }
    if settings.friction < 0.0 {
        panic("GFX.Physics.RigidBody2D friction must be non-negative")
    }
    if settings.linear_damping < 0.0 || settings.angular_damping < 0.0 {
        panic("GFX.Physics.RigidBody2D damping must be non-negative")
    }
}
