use GFX.Physics.Box2D.Box2D
use GFX.Physics.Circle2D.Circle2D
use GFX.Physics.CollisionFilter2D.CollisionFilter2D
use GFX.Physics.Shape2D.Shape2D
use GFX.Physics.Transform2D.Transform2D
use STD.Math

public enum BodyType2D {
    fixed
    kinematic
    dynamic
}

public struct PhysicsMaterialId2D {
    private let current_value:uint64

    init(value:uint64 = 0) { self.current_value = value }

    func value() uint64 { return self.current_value }
}

public enum MaterialCombineMode2D {
    average
    geometric_mean
    minimum
    maximum
    multiply
}

public struct PhysicsMaterial2D {
    var friction:float
    var restitution:float
    var rolling_resistance:float
    var tangent_speed:float
    var application_id:PhysicsMaterialId2D
    var friction_combine:MaterialCombineMode2D
    var restitution_combine:MaterialCombineMode2D

    init() {
        self.friction = 0.6
        self.restitution = 0.0
        self.rolling_resistance = 0.0
        self.tangent_speed = 0.0
        self.application_id = PhysicsMaterialId2D()
        self.friction_combine = MaterialCombineMode2D.geometric_mean
        self.restitution_combine = MaterialCombineMode2D.maximum
    }
}

public struct MassProperties2D {
    let mass:float
    let local_center:Math.Vec2
    let rotational_inertia:float

    init(
        mass:float,
        rotational_inertia:float,
        local_center:Math.Vec2 = Math.Vec2()
    ) {
        if !finite_body_value(mass) || mass < 0.0 ||
            !finite_body_point(local_center) ||
            !finite_body_value(rotational_inertia) || rotational_inertia < 0.0
        {
            panic("GFX.Physics.MassProperties2D requires a non-negative finite mass and inertia with a finite center")
        }
        self.mass = mass
        self.local_center = local_center
        self.rotational_inertia = rotational_inertia
    }
}

public struct Collider2DSettings {
    var shape:Shape2D?
    var density:float
    var material:PhysicsMaterial2D
    var segment_materials:PhysicsMaterial2D[]
    var collision_filter:CollisionFilter2D
    var is_sensor:bool
    var enable_contact_events:bool
    var enable_hit_events:bool
    var enable_sensor_events:bool
    var enable_custom_filter:bool
    var enable_pre_solve:bool

    init() {
        self.shape = null
        self.density = 1.0
        self.material = PhysicsMaterial2D()
        self.segment_materials = []
        self.collision_filter = CollisionFilter2D()
        self.is_sensor = false
        self.enable_contact_events = false
        self.enable_hit_events = false
        self.enable_sensor_events = false
        self.enable_custom_filter = false
        self.enable_pre_solve = false
    }
}

public struct RigidBody2DSettings {
    var body_type:BodyType2D
    var shape:Shape2D?
    var position:Math.Vec2
    var velocity:Math.Vec2
    var rotation:float
    var angular_velocity:float
    var gravity_scale:float
    var mass:float
    var restitution:float
    var friction:float
    var linear_damping:float
    var angular_damping:float
    var sleep_threshold:float
    var allow_sleep:bool
    var fixed_rotation:bool
    var is_bullet:bool
    var is_enabled:bool
    var debug_label:str
    var is_sensor:bool
    var enable_move_events:bool
    var enable_contact_events:bool
    var enable_hit_events:bool
    var enable_sensor_events:bool
    var collision_filter:CollisionFilter2D
    var create_implicit_collider:bool

    init() {
        self.body_type = BodyType2D.dynamic
        self.shape = null
        self.position = Math.Vec2()
        self.velocity = Math.Vec2()
        self.rotation = 0.0
        self.angular_velocity = 0.0
        self.gravity_scale = 1.0
        self.mass = 0.0
        self.restitution = 0.0
        self.friction = 0.6
        self.linear_damping = 0.0
        self.angular_damping = 0.0
        self.sleep_threshold = 0.05
        self.allow_sleep = true
        self.fixed_rotation = false
        self.is_bullet = false
        self.is_enabled = true
        self.debug_label = ""
        self.is_sensor = false
        self.enable_move_events = false
        self.enable_contact_events = false
        self.enable_hit_events = false
        self.enable_sensor_events = false
        self.collision_filter = CollisionFilter2D()
        self.create_implicit_collider = true
    }
}

package struct BodyId2D {
    let slot:int
    let generation:int

    init() {
        self.slot = -1
        self.generation = 0
    }

    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

package struct ShapeId2D {
    let slot:int
    let generation:int

    init() {
        self.slot = -1
        self.generation = 0
    }

    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

package class ShapeStore2D {
    var slot_generations:int[]
    var slot_dense_indices:int[]
    var dense_slots:int[]
    var free_slots:int[]
    var body_slots:int[]
    var shapes:Shape2D[]
    var next_body_shape_slots:int[]
    var densities:float[]
    var materials:PhysicsMaterial2D[]
    var segment_material_offsets:int[]
    var segment_material_counts:int[]
    var segment_material_values:PhysicsMaterial2D[]
    var collision_filters:CollisionFilter2D[]
    var behavior_flags:uint8[]

    init() {
        self.slot_generations = []
        self.slot_dense_indices = []
        self.dense_slots = []
        self.free_slots = []
        self.body_slots = []
        self.shapes = []
        self.next_body_shape_slots = []
        self.densities = []
        self.materials = []
        self.segment_material_offsets = []
        self.segment_material_counts = []
        self.segment_material_values = []
        self.collision_filters = []
        self.behavior_flags = []
    }

    func count() int { return self.dense_slots.count() }

    func append(
        body_slot:int,
        settings:Collider2DSettings,
        next_slot:int
    ) ShapeId2D {
        var slot = self.slot_generations.count()
        if !self.free_slots.is_empty() {
            slot = self.free_slots.take_last()
        } else {
            self.slot_generations.append(1)
            self.slot_dense_indices.append(-1)
        }
        let dense_index = self.count()
        self.slot_dense_indices[slot] = dense_index
        self.dense_slots.append(slot)
        self.body_slots.append(body_slot)
        self.shapes.append(collider_settings_shape(settings))
        self.next_body_shape_slots.append(next_slot)
        self.densities.append(settings.density)
        self.materials.append(settings.material)
        let segment_material_count = settings.segment_materials.count()
        if segment_material_count == 0 {
            self.segment_material_offsets.append(-1)
        } else {
            self.segment_material_offsets.append(
                self.segment_material_values.count()
            )
            for material in settings.segment_materials {
                self.segment_material_values.append(material)
            }
        }
        self.segment_material_counts.append(segment_material_count)
        self.collision_filters.append(settings.collision_filter)
        var flags:uint8 = 0
        if settings.is_sensor { flags += 1 }
        if settings.enable_contact_events { flags += 2 }
        if settings.enable_hit_events { flags += 4 }
        if settings.enable_sensor_events { flags += 8 }
        if settings.enable_custom_filter { flags += 16 }
        if settings.enable_pre_solve { flags += 32 }
        self.behavior_flags.append(flags)
        return ShapeId2D(slot, self.slot_generations[slot])
    }

    func require(id:ShapeId2D) int {
        if !self.contains(id) {
            panic("GFX.Physics.Collider2D no longer refers to a live collider")
        }
        return self.slot_dense_indices[id.slot]
    }

    func contains(id:ShapeId2D) bool {
        return id.slot >= 0 && id.slot < self.slot_generations.count() &&
            self.slot_generations[id.slot] == id.generation &&
            self.slot_dense_indices[id.slot] >= 0
    }

    func destroy(id:ShapeId2D) {
        let dense_index = self.require(id)
        if self.segment_material_counts[dense_index] > 0 {
            self.replace_segment_materials(dense_index, [])
        }
        let last = self.count() - 1
        if dense_index != last {
            self.dense_slots.swap(dense_index, last)
            self.body_slots.swap(dense_index, last)
            self.shapes.swap(dense_index, last)
            self.next_body_shape_slots.swap(dense_index, last)
            self.densities.swap(dense_index, last)
            self.materials.swap(dense_index, last)
            self.segment_material_offsets.swap(dense_index, last)
            self.segment_material_counts.swap(dense_index, last)
            self.collision_filters.swap(dense_index, last)
            self.behavior_flags.swap(dense_index, last)
            self.slot_dense_indices[self.dense_slots[dense_index]] = dense_index
        }
        self.dense_slots.take_last()
        self.body_slots.take_last()
        self.shapes.take_last()
        self.next_body_shape_slots.take_last()
        self.densities.take_last()
        self.materials.take_last()
        self.segment_material_offsets.take_last()
        self.segment_material_counts.take_last()
        self.collision_filters.take_last()
        self.behavior_flags.take_last()
        self.slot_dense_indices[id.slot] = -1
        self.slot_generations[id.slot]++
        self.free_slots.append(id.slot)
    }

    func segment_material_count(dense:int) int {
        return self.segment_material_counts[dense]
    }

    func copy_segment_materials(dense:int) PhysicsMaterial2D[] {
        var result:PhysicsMaterial2D[] = []
        let offset = self.segment_material_offsets[dense]
        let count = self.segment_material_counts[dense]
        var index = 0
        while index < count {
            result.append(self.segment_material_values[offset + index])
            index++
        }
        return result
    }

    func contact_material(dense:int, feature:int) PhysicsMaterial2D {
        let count = self.segment_material_counts[dense]
        if count > 0 && feature >= 0 && feature < count {
            return self.segment_material_values[
                self.segment_material_offsets[dense] + feature
            ]
        }
        return self.materials[dense]
    }

    func replace_segment_materials(
        dense:int,
        materials:PhysicsMaterial2D[]
    ) {
        var rebuilt:PhysicsMaterial2D[] = []
        var collider = 0
        while collider < self.count() {
            let previous_offset = self.segment_material_offsets[collider]
            let previous_count = self.segment_material_counts[collider]
            self.segment_material_offsets[collider] = rebuilt.count()
            if collider == dense {
                self.segment_material_counts[collider] = materials.count()
                for material in materials { rebuilt.append(material) }
            } else {
                var material_index = 0
                while material_index < previous_count {
                    rebuilt.append(self.segment_material_values[
                        previous_offset + material_index
                    ])
                    material_index++
                }
            }
            if self.segment_material_counts[collider] == 0 {
                self.segment_material_offsets[collider] = -1
            }
            collider++
        }
        self.segment_material_values = rebuilt
    }
}

struct ShapeMetrics2D {
    let kind:int
    let half_width:float
    let half_height:float
    let radius:float
    let sweep_radius_squared:float
    let inverse_inertia_factor:float
    let lower:Math.Vec2
    let upper:Math.Vec2

    init(
        kind:int,
        half_width:float,
        half_height:float,
        radius:float,
        sweep_radius_squared:float,
        inverse_inertia_factor:float,
        lower:Math.Vec2,
        upper:Math.Vec2
    ) {
        self.kind = kind
        self.half_width = half_width
        self.half_height = half_height
        self.radius = radius
        self.sweep_radius_squared = sweep_radius_squared
        self.inverse_inertia_factor = inverse_inertia_factor
        self.lower = lower
        self.upper = upper
    }
}

func shape_metrics(shape:Shape2D) ShapeMetrics2D {
    var kind = 2
    var radius = 0.0
    var lower = Math.Vec2(3.4028235e38)
    var upper = Math.Vec2(-3.4028235e38)
    var sweep_radius = 0.0
    var inverse_inertia_factor = 0.0
    match shape {
        box(value) => {
            if value.radius == 0.0 { kind = 0 }
            radius = value.radius
            let half = value.half_size()
            lower = Math.Vec2(-half.x - radius, -half.y - radius)
            upper = Math.Vec2(half.x + radius, half.y + radius)
            sweep_radius = Math.sqrt(half.x * half.x + half.y * half.y) +
                radius
            inverse_inertia_factor = 12.0 / (
                value.size.x * value.size.x + value.size.y * value.size.y
            )
        }
        capsule(value) => {
            radius = value.radius
            lower = Math.Vec2(
                Math.min(value.first.x, value.second.x) - radius,
                Math.min(value.first.y, value.second.y) - radius
            )
            upper = Math.Vec2(
                Math.max(value.first.x, value.second.x) + radius,
                Math.max(value.first.y, value.second.y) + radius
            )
            sweep_radius = Math.max(value.first.length(), value.second.length()) +
                radius
        }
        chain(value) => {
            kind = 3
            for point in value.points {
                lower.x = Math.min(lower.x, point.x)
                lower.y = Math.min(lower.y, point.y)
                upper.x = Math.max(upper.x, point.x)
                upper.y = Math.max(upper.y, point.y)
                sweep_radius = Math.max(sweep_radius, point.length())
            }
        }
        circle(value) => {
            kind = 1
            radius = value.radius
            lower = Math.Vec2(-radius)
            upper = Math.Vec2(radius)
            sweep_radius = radius
            inverse_inertia_factor = 2.0 / (radius * radius)
        }
        polygon(value) => {
            radius = value.radius
            for point in value.vertices {
                lower.x = Math.min(lower.x, point.x - radius)
                lower.y = Math.min(lower.y, point.y - radius)
                upper.x = Math.max(upper.x, point.x + radius)
                upper.y = Math.max(upper.y, point.y + radius)
                sweep_radius = Math.max(sweep_radius, point.length() + radius)
            }
        }
        segment(value) => {
            lower = Math.Vec2(
                Math.min(value.first.x, value.second.x),
                Math.min(value.first.y, value.second.y)
            )
            upper = Math.Vec2(
                Math.max(value.first.x, value.second.x),
                Math.max(value.first.y, value.second.y)
            )
            sweep_radius = Math.max(value.first.length(), value.second.length())
            let length_squared = value.second.subtract(
                value.first
            ).length_squared()
            if length_squared > 0.0 {
                // A segment with a scalar fallback mass behaves as a thin rod:
                // I = m * L^2 / 12.
                inverse_inertia_factor = 12.0 / length_squared
            }
        }
    }
    let half = upper.subtract(lower).multiply(0.5)
    if inverse_inertia_factor == 0.0 && sweep_radius > 0.0 {
        inverse_inertia_factor = 2.0 / (sweep_radius * sweep_radius)
    }
    return ShapeMetrics2D(
        kind,
        half.x,
        half.y,
        radius,
        sweep_radius * sweep_radius,
        inverse_inertia_factor,
        lower,
        upper
    )
}

struct ShapeMass2D {
    let mass:float
    let center:Math.Vec2
    let inertia_about_origin:float

    init(
        mass:float = 0.0,
        center:Math.Vec2 = Math.Vec2(),
        inertia_about_origin:float = 0.0
    ) {
        self.mass = mass
        self.center = center
        self.inertia_about_origin = inertia_about_origin
    }
}

func shape_mass_properties(shape:Shape2D, density:float) ShapeMass2D {
    if density <= 0.0 { return ShapeMass2D() }
    match shape {
        box(value) => {
            let half = value.size.multiply(0.5)
            return polygon_mass_properties([
                Math.Vec2(-half.x, -half.y),
                Math.Vec2(half.x, -half.y),
                Math.Vec2(half.x, half.y),
                Math.Vec2(-half.x, half.y)
            ], value.radius, density)
        }
        capsule(value) => {
            let radius_squared = value.radius * value.radius
            let length = value.second.subtract(value.first).length()
            let length_squared = length * length
            let circle_mass = density * Math.pi() * radius_squared
            let box_mass = density * 2.0 * value.radius * length
            let mass = circle_mass + box_mass
            let center = value.first.add(value.second).multiply(0.5)
            let half_length = length * 0.5
            let half_circle_center = 4.0 * value.radius / (3.0 * Math.pi())
            let circle_inertia = circle_mass * (
                0.5 * radius_squared +
                half_length * half_length +
                2.0 * half_length * half_circle_center
            )
            let box_inertia = box_mass * (
                4.0 * radius_squared + length_squared
            ) / 12.0
            return ShapeMass2D(
                mass,
                center,
                circle_inertia + box_inertia + mass * center.length_squared()
            )
        }
        circle(value) => {
            let radius_squared = value.radius * value.radius
            let mass = density * Math.pi() * radius_squared
            return ShapeMass2D(mass, Math.Vec2(), mass * radius_squared * 0.5)
        }
        polygon(value) => {
            return polygon_mass_properties(
                value.vertices,
                value.radius,
                density
            )
        }
        chain(_) => { return ShapeMass2D() }
        segment(_) => { return ShapeMass2D() }
    }
}

// Rounded-polygon mass follows Box2D 3.1.1 src/geometry.c at 8c661469: its
// public radius is approximated by pushing each convex vertex along the
// averaged adjacent normals before integrating triangles.
func polygon_mass_properties(
    source:Math.Vec2[],
    radius:float,
    density:float
) ShapeMass2D {
    var vertices = source
    if radius > 0.0 {
        vertices = []
        var index = 0
        while index < source.count() {
            var previous = index - 1
            if index == 0 { previous = source.count() - 1 }
            let next = (index + 1) % source.count()
            let previous_edge = source[index].subtract(source[previous])
            let next_edge = source[next].subtract(source[index])
            let previous_normal = Math.Vec2(
                previous_edge.y,
                -previous_edge.x
            ).normalized()
            let next_normal = Math.Vec2(
                next_edge.y,
                -next_edge.x
            ).normalized()
            let middle = previous_normal.add(next_normal).normalized()
            vertices.append(source[index].add(
                middle.multiply(1.412 * radius)
            ))
            index++
        }
    }
    let reference = vertices[0]
    var area = 0.0
    var relative_center = Math.Vec2()
    var relative_inertia = 0.0
    var index = 1
    while index < vertices.count() - 1 {
        let first = vertices[index].subtract(reference)
        let second = vertices[index + 1].subtract(reference)
        let determinant = first.x * second.y - first.y * second.x
        let triangle_area = determinant * 0.5
        area += triangle_area
        relative_center = relative_center.add(
            first.add(second).multiply(triangle_area / 3.0)
        )
        relative_inertia += determinant / 12.0 * (
            first.x * first.x + second.x * first.x +
            second.x * second.x + first.y * first.y +
            second.y * first.y + second.y * second.y
        )
        index++
    }
    if area <= 0.0 { return ShapeMass2D() }
    relative_center = relative_center.divide(area)
    let center = reference.add(relative_center)
    let mass = density * area
    let inertia = density * relative_inertia + mass * (
        center.length_squared() - relative_center.length_squared()
    )
    return ShapeMass2D(mass, center, inertia)
}

package class BodyStore2D {
    var slot_generations:int[]
    var slot_dense_indices:int[]
    var dense_slots:int[]
    var free_slots:int[]
    var shape_store:ShapeStore2D
    var first_shape_slots:int[]
    var primary_shape_slots:int[]
    var shape_counts:int[]
    var body_types:BodyType2D[]
    var shapes:Shape2D[]
    var shape_kinds:int[]
    var half_widths:float[]
    var half_heights:float[]
    var radii:float[]
    var sweep_radii_squared:float[]
    var local_lower_x:float[]
    var local_lower_y:float[]
    var local_upper_x:float[]
    var local_upper_y:float[]
    var collision_filters:CollisionFilter2D[]
    var positions_x:float[]
    var positions_y:float[]
    var previous_positions_x:float[]
    var previous_positions_y:float[]
    var previous_rotations:float[]
    var velocities_x:float[]
    var velocities_y:float[]
    var rotations:float[]
    var rotation_cosines:float[]
    var rotation_sines:float[]
    var angular_velocities:float[]
    var gravity_scales:float[]
    var masses:float[]
    var inertias:float[]
    var inverse_masses:float[]
    var inverse_inertias:float[]
    var local_centers_x:float[]
    var local_centers_y:float[]
    var forces_x:float[]
    var forces_y:float[]
    var torques:float[]
    var restitutions:float[]
    var friction_roots:float[]
    var linear_dampings:float[]
    var angular_dampings:float[]
    var sleep_thresholds:float[]
    var allow_sleep:bool[]
    var fixed_rotations:bool[]
    var enabled:bool[]
    var debug_labels:str[]
    var mass_overridden:bool[]
    var behavior_flags:uint8[]
    var awake:bool[]
    var sleep_times:float[]
    var dirty_transforms:bool[]
    var world_locked:bool
    var topology_dirty:bool

    init() {
        self.slot_generations = []
        self.slot_dense_indices = []
        self.dense_slots = []
        self.free_slots = []
        self.shape_store = ShapeStore2D()
        self.first_shape_slots = []
        self.primary_shape_slots = []
        self.shape_counts = []
        self.body_types = []
        self.shapes = []
        self.shape_kinds = []
        self.half_widths = []
        self.half_heights = []
        self.radii = []
        self.sweep_radii_squared = []
        self.local_lower_x = []
        self.local_lower_y = []
        self.local_upper_x = []
        self.local_upper_y = []
        self.collision_filters = []
        self.positions_x = []
        self.positions_y = []
        self.previous_positions_x = []
        self.previous_positions_y = []
        self.previous_rotations = []
        self.velocities_x = []
        self.velocities_y = []
        self.rotations = []
        self.rotation_cosines = []
        self.rotation_sines = []
        self.angular_velocities = []
        self.gravity_scales = []
        self.masses = []
        self.inertias = []
        self.inverse_masses = []
        self.inverse_inertias = []
        self.local_centers_x = []
        self.local_centers_y = []
        self.forces_x = []
        self.forces_y = []
        self.torques = []
        self.restitutions = []
        self.friction_roots = []
        self.linear_dampings = []
        self.angular_dampings = []
        self.sleep_thresholds = []
        self.allow_sleep = []
        self.fixed_rotations = []
        self.enabled = []
        self.debug_labels = []
        self.mass_overridden = []
        self.behavior_flags = []
        self.awake = []
        self.sleep_times = []
        self.dirty_transforms = []
        self.world_locked = false
        self.topology_dirty = false
    }

    func count() int { return self.positions_x.count() }

    func append(settings:RigidBody2DSettings) BodyId2D {
        validate_settings(settings)
        let index = self.count()
        var slot = self.slot_generations.count()
        if !self.free_slots.is_empty() {
            slot = self.free_slots.take_last()
        } else {
            self.slot_generations.append(1)
            self.slot_dense_indices.append(-1)
        }
        self.slot_dense_indices[slot] = index
        self.dense_slots.append(slot)
        var selected_shape = Shape2D.box(Box2D())
        if let configured = settings.shape { selected_shape = configured }
        let metrics = shape_metrics(selected_shape)
        let shape_kind = metrics.kind
        let half_width = metrics.half_width
        let half_height = metrics.half_height
        let radius = metrics.radius
        let sweep_radius_squared = metrics.sweep_radius_squared
        if settings.body_type != BodyType2D.fixed && shape_kind == 3 {
            panic("GFX.Physics.World2D requires chain body shapes to be fixed")
        }
        var first_shape_slot = -1
        var primary_shape_slot = -1
        var shape_count = 0
        if settings.create_implicit_collider {
            let implicit_material = PhysicsMaterial2D()
                ..friction = settings.friction
                ..restitution = settings.restitution
            let collider_settings = Collider2DSettings()
                ..shape = selected_shape
                ..material = implicit_material
                ..collision_filter = settings.collision_filter
                ..is_sensor = settings.is_sensor
                ..enable_contact_events = settings.enable_contact_events
                ..enable_hit_events = settings.enable_hit_events
                ..enable_sensor_events = settings.enable_sensor_events
            validate_collider_settings(collider_settings)
            let shape_id = self.shape_store.append(
                slot,
                collider_settings,
                -1
            )
            first_shape_slot = shape_id.slot
            primary_shape_slot = shape_id.slot
            shape_count = 1
        }
        self.first_shape_slots.append(first_shape_slot)
        self.primary_shape_slots.append(primary_shape_slot)
        self.shape_counts.append(shape_count)
        self.body_types.append(settings.body_type)
        self.shapes.append(selected_shape)
        self.shape_kinds.append(shape_kind)
        self.half_widths.append(half_width)
        self.half_heights.append(half_height)
        self.radii.append(radius)
        self.sweep_radii_squared.append(sweep_radius_squared)
        self.local_lower_x.append(metrics.lower.x)
        self.local_lower_y.append(metrics.lower.y)
        self.local_upper_x.append(metrics.upper.x)
        self.local_upper_y.append(metrics.upper.y)
        self.collision_filters.append(settings.collision_filter)
        self.positions_x.append(settings.position.x)
        self.positions_y.append(settings.position.y)
        self.previous_positions_x.append(settings.position.x)
        self.previous_positions_y.append(settings.position.y)
        self.previous_rotations.append(settings.rotation)
        self.velocities_x.append(settings.velocity.x)
        self.velocities_y.append(settings.velocity.y)
        self.rotations.append(settings.rotation)
        self.rotation_cosines.append(Math.cos(settings.rotation))
        self.rotation_sines.append(Math.sin(settings.rotation))
        if settings.fixed_rotation {
            self.angular_velocities.append(0.0)
        } else {
            self.angular_velocities.append(settings.angular_velocity)
        }
        self.gravity_scales.append(settings.gravity_scale)
        self.masses.append(0.0)
        self.inertias.append(0.0)
        self.inverse_masses.append(0.0)
        self.inverse_inertias.append(0.0)
        self.local_centers_x.append(0.0)
        self.local_centers_y.append(0.0)
        self.forces_x.append(0.0)
        self.forces_y.append(0.0)
        self.torques.append(0.0)
        self.restitutions.append(settings.restitution)
        self.friction_roots.append(Math.sqrt(settings.friction))
        self.linear_dampings.append(settings.linear_damping)
        self.angular_dampings.append(settings.angular_damping)
        self.sleep_thresholds.append(settings.sleep_threshold)
        self.allow_sleep.append(settings.allow_sleep)
        self.fixed_rotations.append(settings.fixed_rotation)
        self.enabled.append(settings.is_enabled)
        self.debug_labels.append(settings.debug_label)
        self.mass_overridden.append(false)
        var behavior_flags:uint8 = 0
        if settings.is_bullet { behavior_flags += 1 }
        if settings.create_implicit_collider && settings.is_sensor {
            behavior_flags += 2
        }
        if settings.enable_move_events {
            behavior_flags += 4
        }
        if settings.create_implicit_collider && settings.enable_contact_events {
            behavior_flags += 8
        }
        if settings.create_implicit_collider && settings.enable_hit_events {
            behavior_flags += 16
        }
        if settings.create_implicit_collider && settings.enable_sensor_events {
            behavior_flags += 32
        }
        self.behavior_flags.append(behavior_flags)
        self.awake.append(
            settings.is_enabled && settings.body_type != BodyType2D.fixed
        )
        self.sleep_times.append(0.0)
        self.dirty_transforms.append(true)
        self.recompute_mass_from_colliders(index, false)
        if settings.mass > 0.0 {
            self.override_scalar_mass(index, settings.mass)
        }
        return BodyId2D(slot, self.slot_generations[slot])
    }

    func require(id:BodyId2D) int {
        if !self.contains(id) {
            panic("GFX.Physics.RigidBody2D no longer refers to a live body")
        }
        return self.slot_dense_indices[id.slot]
    }

    func contains(id:BodyId2D) bool {
        return id.slot >= 0 && id.slot < self.slot_generations.count() &&
            self.slot_generations[id.slot] == id.generation &&
            self.slot_dense_indices[id.slot] >= 0
    }

    func shape_count(id:BodyId2D) int {
        return self.shape_counts[self.require(id)]
    }

    func body_id_at(index:int) BodyId2D {
        let slot = self.dense_slots[index]
        return BodyId2D(slot, self.slot_generations[slot])
    }

    func world_center_at(index:int) Math.Vec2 {
        let cosine = self.rotation_cosines[index]
        let sine = self.rotation_sines[index]
        return Math.Vec2(
            self.positions_x[index] +
                cosine * self.local_centers_x[index] -
                sine * self.local_centers_y[index],
            self.positions_y[index] +
                sine * self.local_centers_x[index] +
                cosine * self.local_centers_y[index]
        )
    }

    func recompute_mass_from_colliders(
        body:int,
        adjust_velocity:bool = true
    ) {
        if self.mass_overridden[body] { return }
        var total_mass = 0.0
        var weighted_center = Math.Vec2()
        var inertia_about_origin = 0.0
        var slot = self.first_shape_slots[body]
        while slot >= 0 {
            let dense = self.shape_store.slot_dense_indices[slot]
            let properties = shape_mass_properties(
                self.shape_store.shapes[dense],
                self.shape_store.densities[dense]
            )
            total_mass += properties.mass
            weighted_center = weighted_center.add(
                properties.center.multiply(properties.mass)
            )
            inertia_about_origin += properties.inertia_about_origin
            slot = self.shape_store.next_body_shape_slots[dense]
        }
        var center = Math.Vec2()
        if total_mass > 0.0 {
            center = weighted_center.divide(total_mass)
        }
        let inertia = Math.max(
            0.0,
            inertia_about_origin - total_mass * center.length_squared()
        )
        self.apply_mass_properties(
            body,
            MassProperties2D(total_mass, inertia, center),
            adjust_velocity
        )
    }

    func set_mass_properties(body:int, properties:MassProperties2D) {
        self.apply_mass_properties(body, properties, true)
        self.mass_overridden[body] = true
        self.topology_dirty = true
        self.wake(body)
    }

    func reset_mass_from_colliders(body:int) {
        self.mass_overridden[body] = false
        self.recompute_mass_from_colliders(body)
        self.topology_dirty = true
        self.wake(body)
    }

    private func override_scalar_mass(body:int, mass:float) {
        var inertia = 0.0
        var center = Math.Vec2(
            self.local_centers_x[body],
            self.local_centers_y[body]
        )
        if self.masses[body] > 0.0 {
            inertia = self.inertias[body] * mass / self.masses[body]
        } else if self.shape_counts[body] > 0 {
            let factor = shape_metrics(
                self.shapes[body]
            ).inverse_inertia_factor
            if factor > 0.0 { inertia = mass / factor }
            match self.shapes[body] {
                segment(value) => {
                    center = value.first.add(value.second).multiply(0.5)
                }
                box(_) => {}
                capsule(_) => {}
                chain(_) => {}
                circle(_) => {}
                polygon(_) => {}
            }
        }
        self.apply_mass_properties(
            body,
            MassProperties2D(
                mass,
                inertia,
                center
            ),
            false
        )
        self.mass_overridden[body] = true
    }

    private func apply_mass_properties(
        body:int,
        properties:MassProperties2D,
        adjust_velocity:bool
    ) {
        let old_center = self.world_center_at(body)
        self.masses[body] = properties.mass
        self.inertias[body] = properties.rotational_inertia
        self.local_centers_x[body] = properties.local_center.x
        self.local_centers_y[body] = properties.local_center.y
        self.refresh_inverse_mass(body)
        if adjust_velocity {
            let new_center = self.world_center_at(body)
            let delta = new_center.subtract(old_center)
            let angular_velocity = self.angular_velocities[body]
            self.velocities_x[body] -= angular_velocity * delta.y
            self.velocities_y[body] += angular_velocity * delta.x
        }
    }

    func refresh_inverse_mass(body:int) {
        self.inverse_masses[body] = 0.0
        self.inverse_inertias[body] = 0.0
        if self.body_types[body] != BodyType2D.dynamic { return }
        if self.masses[body] > 0.0 {
            self.inverse_masses[body] = 1.0 / self.masses[body]
        }
        if !self.fixed_rotations[body] && self.inertias[body] > 0.0 {
            self.inverse_inertias[body] = 1.0 / self.inertias[body]
        }
    }

    func attach_shape(id:BodyId2D, shape:Shape2D) ShapeId2D {
        return self.attach_collider(
            id,
            Collider2DSettings() ..shape = shape
        )
    }

    func attach_collider(
        id:BodyId2D,
        settings:Collider2DSettings
    ) ShapeId2D {
        validate_collider_settings(settings)
        let index = self.require(id)
        let selected_shape = collider_settings_shape(settings)
        let metrics = shape_metrics(selected_shape)
        if self.body_types[index] != BodyType2D.fixed && metrics.kind == 3 {
            panic("GFX.Physics.World2D requires chain colliders to belong to fixed bodies")
        }
        let shape_id = self.shape_store.append(
            id.slot,
            settings,
            self.first_shape_slots[index]
        )
        self.first_shape_slots[index] = shape_id.slot
        self.shape_counts[index]++
        if self.primary_shape_slots[index] < 0 {
            self.primary_shape_slots[index] = shape_id.slot
            self.apply_primary_collider(index)
        } else {
            self.refresh_collider_flags(index)
        }
        self.recompute_mass_from_colliders(index)
        self.dirty_transforms[index] = true
        self.topology_dirty = true
        self.wake(index)
        return shape_id
    }

    func destroy_collider(id:ShapeId2D) {
        let dense = self.shape_store.require(id)
        let body_slot = self.shape_store.body_slots[dense]
        if body_slot < 0 || body_slot >= self.slot_dense_indices.count() ||
            self.slot_dense_indices[body_slot] < 0
        {
            panic("GFX.Physics.Collider2D no longer belongs to a live body")
        }
        let body = self.slot_dense_indices[body_slot]
        var previous_slot = -1
        var slot = self.first_shape_slots[body]
        while slot >= 0 && slot != id.slot {
            let current = self.shape_store.slot_dense_indices[slot]
            previous_slot = slot
            slot = self.shape_store.next_body_shape_slots[current]
        }
        if slot < 0 {
            panic("GFX.Physics.Collider2D is not attached to its body")
        }
        let next_slot = self.shape_store.next_body_shape_slots[dense]
        if previous_slot < 0 {
            self.first_shape_slots[body] = next_slot
        } else {
            let previous_dense = self.shape_store.slot_dense_indices[previous_slot]
            self.shape_store.next_body_shape_slots[previous_dense] = next_slot
        }
        self.shape_counts[body]--
        if self.primary_shape_slots[body] == id.slot {
            self.primary_shape_slots[body] = self.first_shape_slots[body]
        }
        self.shape_store.destroy(id)
        self.apply_primary_collider(body)
        self.recompute_mass_from_colliders(body)
        self.dirty_transforms[body] = true
        self.topology_dirty = true
        self.wake(body)
    }

    func set_collider_shape(id:ShapeId2D, shape:Shape2D) {
        let dense = self.shape_store.require(id)
        let body = self.slot_dense_indices[self.shape_store.body_slots[dense]]
        let metrics = shape_metrics(shape)
        if self.body_types[body] != BodyType2D.fixed && metrics.kind == 3 {
            panic("GFX.Physics.World2D requires chain colliders to belong to fixed bodies")
        }
        if self.shape_store.segment_material_count(dense) > 0 {
            match shape {
                chain(value) => {
                    if self.shape_store.segment_material_count(dense) !=
                        value.segment_count()
                    {
                        panic("GFX.Physics.Collider2D segment material count must match the chain segment count")
                    }
                }
                else => {
                    panic("GFX.Physics.Collider2D segment materials require a chain shape")
                }
            }
        }
        self.shape_store.shapes[dense] = shape
        if self.primary_shape_slots[body] == id.slot {
            self.apply_primary_collider(body)
        }
        self.recompute_mass_from_colliders(body)
        self.dirty_transforms[body] = true
        self.topology_dirty = true
        self.wake(body)
    }

    func set_collider_material(id:ShapeId2D, material:PhysicsMaterial2D) {
        validate_material(material)
        let dense = self.shape_store.require(id)
        self.shape_store.materials[dense] = material
        let body = self.slot_dense_indices[self.shape_store.body_slots[dense]]
        if self.primary_shape_slots[body] == id.slot {
            self.apply_primary_collider(body)
        }
        self.wake(body)
    }

    func set_collider_density(id:ShapeId2D, density:float) {
        if !finite_body_value(density) || density < 0.0 {
            panic("GFX.Physics.Collider2D density must be finite and non-negative")
        }
        let dense = self.shape_store.require(id)
        self.shape_store.densities[dense] = density
        let body = self.slot_dense_indices[self.shape_store.body_slots[dense]]
        self.recompute_mass_from_colliders(body)
        self.topology_dirty = true
        self.wake(body)
    }

    func set_collider_filter(id:ShapeId2D, filter:CollisionFilter2D) {
        let dense = self.shape_store.require(id)
        self.shape_store.collision_filters[dense] = filter
        let body = self.slot_dense_indices[self.shape_store.body_slots[dense]]
        if self.primary_shape_slots[body] == id.slot {
            self.apply_primary_collider(body)
        }
        self.topology_dirty = true
        self.wake(body)
    }

    func set_collider_sensor(id:ShapeId2D, sensor:bool) {
        let dense = self.shape_store.require(id)
        if sensor && (self.shape_store.behavior_flags[dense] & 1) == 0 {
            self.shape_store.behavior_flags[dense] += 1
        } else if !sensor && (self.shape_store.behavior_flags[dense] & 1) != 0 {
            self.shape_store.behavior_flags[dense] -= 1
        }
        let body = self.slot_dense_indices[self.shape_store.body_slots[dense]]
        self.refresh_collider_flags(body)
        self.topology_dirty = true
        self.wake(body)
    }

    func set_collider_event_options(
        id:ShapeId2D,
        contact_events:bool,
        hit_events:bool,
        sensor_events:bool
    ) {
        let dense = self.shape_store.require(id)
        var flags:uint8 = self.shape_store.behavior_flags[dense] & 49
        if contact_events { flags += 2 }
        if hit_events { flags += 4 }
        if sensor_events { flags += 8 }
        self.shape_store.behavior_flags[dense] = flags
        let body = self.slot_dense_indices[self.shape_store.body_slots[dense]]
        self.refresh_collider_flags(body)
        self.topology_dirty = true
    }

    func set_collider_segment_materials(
        id:ShapeId2D,
        materials:PhysicsMaterial2D[]
    ) {
        let dense = self.shape_store.require(id)
        validate_segment_materials(self.shape_store.shapes[dense], materials)
        for material in materials { validate_material(material) }
        self.shape_store.replace_segment_materials(dense, materials)
        self.topology_dirty = true
    }

    private func apply_primary_collider(body:int) {
        let slot = self.primary_shape_slots[body]
        if slot < 0 {
            let fallback = Shape2D.box(Box2D())
            let metrics = shape_metrics(fallback)
            self.shapes[body] = fallback
            self.apply_primary_metrics(body, metrics)
            self.collision_filters[body] = CollisionFilter2D()
            self.restitutions[body] = 0.0
            self.friction_roots[body] = Math.sqrt(0.6)
            self.refresh_collider_flags(body)
            return
        }
        let dense = self.shape_store.slot_dense_indices[slot]
        self.shapes[body] = self.shape_store.shapes[dense]
        self.apply_primary_metrics(body, shape_metrics(self.shapes[body]))
        self.collision_filters[body] = self.shape_store.collision_filters[dense]
        let material = self.shape_store.materials[dense]
        self.restitutions[body] = material.restitution
        self.friction_roots[body] = Math.sqrt(material.friction)
        self.refresh_collider_flags(body)
    }

    private func apply_primary_metrics(body:int, metrics:ShapeMetrics2D) {
        self.shape_kinds[body] = metrics.kind
        self.half_widths[body] = metrics.half_width
        self.half_heights[body] = metrics.half_height
        self.radii[body] = metrics.radius
        self.sweep_radii_squared[body] = metrics.sweep_radius_squared
        self.local_lower_x[body] = metrics.lower.x
        self.local_lower_y[body] = metrics.lower.y
        self.local_upper_x[body] = metrics.upper.x
        self.local_upper_y[body] = metrics.upper.y
    }

    private func refresh_collider_flags(body:int) {
        var flags:uint8 = self.behavior_flags[body] & 5
        var slot = self.first_shape_slots[body]
        while slot >= 0 {
            let dense = self.shape_store.slot_dense_indices[slot]
            let collider_flags = self.shape_store.behavior_flags[dense]
            if (collider_flags & 1) != 0 && (flags & 2) == 0 { flags += 2 }
            if (collider_flags & 2) != 0 && (flags & 8) == 0 { flags += 8 }
            if (collider_flags & 4) != 0 && (flags & 16) == 0 { flags += 16 }
            if (collider_flags & 8) != 0 && (flags & 32) == 0 { flags += 32 }
            slot = self.shape_store.next_body_shape_slots[dense]
        }
        self.behavior_flags[body] = flags
    }

    func destroy(id:BodyId2D) int {
        let dense_index = self.require(id)
        var shape_slot = self.first_shape_slots[dense_index]
        while shape_slot >= 0 {
            let shape_dense = self.shape_store.slot_dense_indices[shape_slot]
            let next_slot = self.shape_store.next_body_shape_slots[shape_dense]
            self.shape_store.destroy(ShapeId2D(
                shape_slot,
                self.shape_store.slot_generations[shape_slot]
            ))
            shape_slot = next_slot
        }

        let last = self.count() - 1
        if dense_index != last {
            self.swap_dense(dense_index, last)
            self.slot_dense_indices[self.dense_slots[dense_index]] = dense_index
        }
        self.take_last_dense()
        self.slot_dense_indices[id.slot] = -1
        self.slot_generations[id.slot]++
        self.free_slots.append(id.slot)
        return dense_index
    }

    func wake(index:int) {
        if self.body_types[index] == BodyType2D.fixed || !self.enabled[index] {
            return
        }
        self.awake[index] = true
        self.sleep_times[index] = 0.0
    }

    func require_mutable() {
        if self.world_locked {
            panic("GFX.Physics.World2D cannot be modified during step")
        }
    }

    func cache_rotation(index:int) {
        self.rotation_cosines[index] = Math.cos(self.rotations[index])
        self.rotation_sines[index] = Math.sin(self.rotations[index])
    }

    func clear_forces() {
        var index = 0
        while index < self.count() {
            self.forces_x[index] = 0.0
            self.forces_y[index] = 0.0
            self.torques[index] = 0.0
            index++
        }
    }

    private func swap_dense(first:int, second:int) {
        self.dense_slots.swap(first, second)
        self.first_shape_slots.swap(first, second)
        self.primary_shape_slots.swap(first, second)
        self.shape_counts.swap(first, second)
        self.body_types.swap(first, second)
        self.shapes.swap(first, second)
        self.shape_kinds.swap(first, second)
        self.half_widths.swap(first, second)
        self.half_heights.swap(first, second)
        self.radii.swap(first, second)
        self.sweep_radii_squared.swap(first, second)
        self.local_lower_x.swap(first, second)
        self.local_lower_y.swap(first, second)
        self.local_upper_x.swap(first, second)
        self.local_upper_y.swap(first, second)
        self.collision_filters.swap(first, second)
        self.positions_x.swap(first, second)
        self.positions_y.swap(first, second)
        self.previous_positions_x.swap(first, second)
        self.previous_positions_y.swap(first, second)
        self.previous_rotations.swap(first, second)
        self.velocities_x.swap(first, second)
        self.velocities_y.swap(first, second)
        self.rotations.swap(first, second)
        self.rotation_cosines.swap(first, second)
        self.rotation_sines.swap(first, second)
        self.angular_velocities.swap(first, second)
        self.gravity_scales.swap(first, second)
        self.masses.swap(first, second)
        self.inertias.swap(first, second)
        self.inverse_masses.swap(first, second)
        self.inverse_inertias.swap(first, second)
        self.local_centers_x.swap(first, second)
        self.local_centers_y.swap(first, second)
        self.forces_x.swap(first, second)
        self.forces_y.swap(first, second)
        self.torques.swap(first, second)
        self.restitutions.swap(first, second)
        self.friction_roots.swap(first, second)
        self.linear_dampings.swap(first, second)
        self.angular_dampings.swap(first, second)
        self.sleep_thresholds.swap(first, second)
        self.allow_sleep.swap(first, second)
        self.fixed_rotations.swap(first, second)
        self.enabled.swap(first, second)
        self.debug_labels.swap(first, second)
        self.mass_overridden.swap(first, second)
        self.behavior_flags.swap(first, second)
        self.awake.swap(first, second)
        self.sleep_times.swap(first, second)
        self.dirty_transforms.swap(first, second)
    }

    private func take_last_dense() {
        self.dense_slots.take_last()
        self.first_shape_slots.take_last()
        self.primary_shape_slots.take_last()
        self.shape_counts.take_last()
        self.body_types.take_last()
        self.shapes.take_last()
        self.shape_kinds.take_last()
        self.half_widths.take_last()
        self.half_heights.take_last()
        self.radii.take_last()
        self.sweep_radii_squared.take_last()
        self.local_lower_x.take_last()
        self.local_lower_y.take_last()
        self.local_upper_x.take_last()
        self.local_upper_y.take_last()
        self.collision_filters.take_last()
        self.positions_x.take_last()
        self.positions_y.take_last()
        self.previous_positions_x.take_last()
        self.previous_positions_y.take_last()
        self.previous_rotations.take_last()
        self.velocities_x.take_last()
        self.velocities_y.take_last()
        self.rotations.take_last()
        self.rotation_cosines.take_last()
        self.rotation_sines.take_last()
        self.angular_velocities.take_last()
        self.gravity_scales.take_last()
        self.masses.take_last()
        self.inertias.take_last()
        self.inverse_masses.take_last()
        self.inverse_inertias.take_last()
        self.local_centers_x.take_last()
        self.local_centers_y.take_last()
        self.forces_x.take_last()
        self.forces_y.take_last()
        self.torques.take_last()
        self.restitutions.take_last()
        self.friction_roots.take_last()
        self.linear_dampings.take_last()
        self.angular_dampings.take_last()
        self.sleep_thresholds.take_last()
        self.allow_sleep.take_last()
        self.fixed_rotations.take_last()
        self.enabled.take_last()
        self.debug_labels.take_last()
        self.mass_overridden.take_last()
        self.behavior_flags.take_last()
        self.awake.take_last()
        self.sleep_times.take_last()
        self.dirty_transforms.take_last()
    }
}

public class Collider2D {
    private var store:BodyStore2D
    private let id:ShapeId2D

    module init(store:BodyStore2D, id:ShapeId2D) {
        self.store = store
        self.id = id
    }

    func is_valid() bool { return self.store.shape_store.contains(self.id) }

    package func belongs_to(store:BodyStore2D) bool {
        return self.store == store
    }

    package func collider_id() ShapeId2D { return self.id }

    func body() RigidBody2D {
        let dense = self.store.shape_store.require(self.id)
        let slot = self.store.shape_store.body_slots[dense]
        return RigidBody2D(
            self.store,
            BodyId2D(slot, self.store.slot_generations[slot])
        )
    }

    func shape() Shape2D {
        return self.store.shape_store.shapes[
            self.store.shape_store.require(self.id)
        ]
    }

    func density() float {
        return self.store.shape_store.densities[
            self.store.shape_store.require(self.id)
        ]
    }

    func material() PhysicsMaterial2D {
        return self.store.shape_store.materials[
            self.store.shape_store.require(self.id)
        ]
    }

    func segment_materials() PhysicsMaterial2D[] {
        return self.store.shape_store.copy_segment_materials(
            self.store.shape_store.require(self.id)
        )
    }

    func collision_filter() CollisionFilter2D {
        return self.store.shape_store.collision_filters[
            self.store.shape_store.require(self.id)
        ]
    }

    func is_sensor() bool {
        return (self.store.shape_store.behavior_flags[
            self.store.shape_store.require(self.id)
        ] & 1) != 0
    }

    func contact_events_enabled() bool {
        return (self.store.shape_store.behavior_flags[
            self.store.shape_store.require(self.id)
        ] & 2) != 0
    }

    func hit_events_enabled() bool {
        return (self.store.shape_store.behavior_flags[
            self.store.shape_store.require(self.id)
        ] & 4) != 0
    }

    func sensor_events_enabled() bool {
        return (self.store.shape_store.behavior_flags[
            self.store.shape_store.require(self.id)
        ] & 8) != 0
    }

    func custom_filter_enabled() bool {
        return (self.store.shape_store.behavior_flags[
            self.store.shape_store.require(self.id)
        ] & 16) != 0
    }

    func pre_solve_enabled() bool {
        return (self.store.shape_store.behavior_flags[
            self.store.shape_store.require(self.id)
        ] & 32) != 0
    }

    func set_shape(shape:Shape2D) {
        self.store.require_mutable()
        self.store.set_collider_shape(self.id, shape)
    }

    func set_density(density:float) {
        self.store.require_mutable()
        self.store.set_collider_density(self.id, density)
    }

    func set_material(material:PhysicsMaterial2D) {
        self.store.require_mutable()
        self.store.set_collider_material(self.id, material)
    }

    func set_segment_materials(materials:PhysicsMaterial2D[]) {
        self.store.require_mutable()
        self.store.set_collider_segment_materials(self.id, materials)
    }

    func set_collision_filter(filter:CollisionFilter2D) {
        self.store.require_mutable()
        self.store.set_collider_filter(self.id, filter)
    }

    func set_sensor(sensor:bool) {
        self.store.require_mutable()
        self.store.set_collider_sensor(self.id, sensor)
    }

    func set_event_options(
        contact_events:bool,
        hit_events:bool,
        sensor_events:bool
    ) {
        self.store.require_mutable()
        self.store.set_collider_event_options(
            self.id,
            contact_events,
            hit_events,
            sensor_events
        )
    }

    func set_contact_policy_options(
        custom_filter:bool,
        pre_solve:bool
    ) {
        self.store.require_mutable()
        let dense = self.store.shape_store.require(self.id)
        var flags = self.store.shape_store.behavior_flags[dense] & 15
        if custom_filter { flags += 16 }
        if pre_solve { flags += 32 }
        self.store.shape_store.behavior_flags[dense] = flags
        let body = self.store.slot_dense_indices[
            self.store.shape_store.body_slots[dense]
        ]
        self.store.wake(body)
    }
}

public class RigidBody2D {
    private var store:BodyStore2D
    private let id:BodyId2D

    module init(store:BodyStore2D, id:BodyId2D) {
        self.store = store
        self.id = id
    }

    func is_valid() bool { return self.store.contains(self.id) }

    package func belongs_to(store:BodyStore2D) bool {
        return self.store == store
    }

    package func body_id() BodyId2D { return self.id }

    func body_type() BodyType2D {
        let index = self.store.require(self.id)
        return self.store.body_types[index]
    }

    func mass() float { return self.store.masses[self.store.require(self.id)] }

    func rotational_inertia() float {
        return self.store.inertias[self.store.require(self.id)]
    }

    func mass_properties() MassProperties2D {
        let index = self.store.require(self.id)
        return MassProperties2D(
            self.store.masses[index],
            self.store.inertias[index],
            Math.Vec2(
                self.store.local_centers_x[index],
                self.store.local_centers_y[index]
            )
        )
    }

    func local_center_of_mass() Math.Vec2 {
        let index = self.store.require(self.id)
        return Math.Vec2(
            self.store.local_centers_x[index],
            self.store.local_centers_y[index]
        )
    }

    func world_center_of_mass() Math.Vec2 {
        return self.store.world_center_at(self.store.require(self.id))
    }

    func shape() Shape2D {
        let index = self.store.require(self.id)
        if self.store.primary_shape_slots[index] < 0 {
            panic("GFX.Physics.RigidBody2D.shape requires at least one collider")
        }
        return self.store.shapes[index]
    }

    func collider_count() int { return self.store.shape_count(self.id) }

    func write_colliders(output:&Collider2D[]) {
        output.clear()
        let body = self.store.require(self.id)
        var slot = self.store.first_shape_slots[body]
        while slot >= 0 {
            let dense = self.store.shape_store.slot_dense_indices[slot]
            output.append(Collider2D(
                self.store,
                ShapeId2D(slot, self.store.shape_store.slot_generations[slot])
            ))
            slot = self.store.shape_store.next_body_shape_slots[dense]
        }
    }

    func position() Math.Vec2 {
        let index = self.store.require(self.id)
        return Math.Vec2(
            self.store.positions_x[index],
            self.store.positions_y[index]
        )
    }

    func velocity() Math.Vec2 {
        let index = self.store.require(self.id)
        return Math.Vec2(
            self.store.velocities_x[index],
            self.store.velocities_y[index]
        )
    }

    func rotation() float {
        return self.store.rotations[self.store.require(self.id)]
    }

    func angular_velocity() float {
        return self.store.angular_velocities[self.store.require(self.id)]
    }

    func gravity_scale() float {
        return self.store.gravity_scales[self.store.require(self.id)]
    }

    func linear_damping() float {
        return self.store.linear_dampings[self.store.require(self.id)]
    }

    func angular_damping() float {
        return self.store.angular_dampings[self.store.require(self.id)]
    }

    func sleep_threshold() float {
        return self.store.sleep_thresholds[self.store.require(self.id)]
    }

    func is_sleep_enabled() bool {
        return self.store.allow_sleep[self.store.require(self.id)]
    }

    func has_fixed_rotation() bool {
        return self.store.fixed_rotations[self.store.require(self.id)]
    }

    func is_enabled() bool {
        return self.store.enabled[self.store.require(self.id)]
    }

    func debug_label() str {
        return self.store.debug_labels[self.store.require(self.id)]
    }

    func is_bullet() bool {
        return (self.store.behavior_flags[self.store.require(self.id)] & 1) != 0
    }

    func is_sensor() bool {
        return (self.store.behavior_flags[self.store.require(self.id)] & 2) != 0
    }

    func is_awake() bool {
        return self.store.awake[self.store.require(self.id)]
    }

    func world_point(local_point:Math.Vec2) Math.Vec2 {
        let index = self.store.require(self.id)
        let cosine = self.store.rotation_cosines[index]
        let sine = self.store.rotation_sines[index]
        return Math.Vec2(
            self.store.positions_x[index] +
                cosine * local_point.x - sine * local_point.y,
            self.store.positions_y[index] +
                sine * local_point.x + cosine * local_point.y
        )
    }

    func local_point(world_point:Math.Vec2) Math.Vec2 {
        let index = self.store.require(self.id)
        let translated = world_point.subtract(Math.Vec2(
            self.store.positions_x[index],
            self.store.positions_y[index]
        ))
        let cosine = self.store.rotation_cosines[index]
        let sine = self.store.rotation_sines[index]
        return Math.Vec2(
            translated.x * cosine + translated.y * sine,
            translated.y * cosine - translated.x * sine
        )
    }

    func world_vector(local_vector:Math.Vec2) Math.Vec2 {
        let index = self.store.require(self.id)
        let cosine = self.store.rotation_cosines[index]
        let sine = self.store.rotation_sines[index]
        return Math.Vec2(
            local_vector.x * cosine - local_vector.y * sine,
            local_vector.x * sine + local_vector.y * cosine
        )
    }

    func local_vector(world_vector:Math.Vec2) Math.Vec2 {
        let index = self.store.require(self.id)
        let cosine = self.store.rotation_cosines[index]
        let sine = self.store.rotation_sines[index]
        return Math.Vec2(
            world_vector.x * cosine + world_vector.y * sine,
            world_vector.y * cosine - world_vector.x * sine
        )
    }

    func world_point_velocity(world_point:Math.Vec2) Math.Vec2 {
        let index = self.store.require(self.id)
        let radius = world_point.subtract(self.store.world_center_at(index))
        let angular = self.store.angular_velocities[index]
        return Math.Vec2(
            self.store.velocities_x[index] - angular * radius.y,
            self.store.velocities_y[index] + angular * radius.x
        )
    }

    func local_point_velocity(local_point:Math.Vec2) Math.Vec2 {
        return self.world_point_velocity(self.world_point(local_point))
    }

    func set_mass_properties(properties:MassProperties2D) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        if self.store.body_types[index] != BodyType2D.dynamic {
            panic("GFX.Physics.RigidBody2D mass overrides require a dynamic body")
        }
        self.store.set_mass_properties(index, properties)
    }

    func reset_mass_from_colliders() {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        if self.store.body_types[index] != BodyType2D.dynamic {
            panic("GFX.Physics.RigidBody2D mass recalculation requires a dynamic body")
        }
        self.store.reset_mass_from_colliders(index)
    }

    func set_body_type(body_type:BodyType2D) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        if self.store.body_types[index] == body_type { return }
        if body_type != BodyType2D.fixed {
            var slot = self.store.first_shape_slots[index]
            while slot >= 0 {
                let dense = self.store.shape_store.slot_dense_indices[slot]
                if shape_metrics(self.store.shape_store.shapes[dense]).kind == 3 {
                    panic("GFX.Physics.RigidBody2D chain colliders require a fixed body")
                }
                slot = self.store.shape_store.next_body_shape_slots[dense]
            }
        }
        self.store.body_types[index] = body_type
        self.store.refresh_inverse_mass(index)
        self.store.forces_x[index] = 0.0
        self.store.forces_y[index] = 0.0
        self.store.torques[index] = 0.0
        if body_type == BodyType2D.fixed {
            self.store.awake[index] = false
        } else {
            self.store.wake(index)
        }
        self.store.topology_dirty = true
    }

    func set_position(position:Math.Vec2) {
        self.store.require_mutable()
        if !finite_body_point(position) {
            panic("GFX.Physics.RigidBody2D position must be finite")
        }
        let index = self.store.require(self.id)
        self.store.positions_x[index] = position.x
        self.store.positions_y[index] = position.y
        self.store.dirty_transforms[index] = true
        self.store.wake(index)
    }

    func set_velocity(velocity:Math.Vec2) {
        self.store.require_mutable()
        if !finite_body_point(velocity) {
            panic("GFX.Physics.RigidBody2D velocity must be finite")
        }
        let index = self.store.require(self.id)
        if self.store.body_types[index] == BodyType2D.fixed {
            panic("GFX.Physics.RigidBody2D cannot set velocity on a fixed body")
        }
        self.store.velocities_x[index] = velocity.x
        self.store.velocities_y[index] = velocity.y
        self.store.wake(index)
    }

    func set_rotation(rotation:float) {
        self.store.require_mutable()
        if !finite_body_value(rotation) {
            panic("GFX.Physics.RigidBody2D rotation must be finite")
        }
        let index = self.store.require(self.id)
        self.store.rotations[index] = rotation
        self.store.cache_rotation(index)
        self.store.dirty_transforms[index] = true
        self.store.wake(index)
    }

    func set_angular_velocity(velocity:float) {
        self.store.require_mutable()
        if !finite_body_value(velocity) {
            panic("GFX.Physics.RigidBody2D angular velocity must be finite")
        }
        let index = self.store.require(self.id)
        if self.store.body_types[index] == BodyType2D.fixed ||
            self.store.fixed_rotations[index]
        {
            panic("GFX.Physics.RigidBody2D cannot rotate this body")
        }
        self.store.angular_velocities[index] = velocity
        self.store.wake(index)
    }

    func set_gravity_scale(scale:float) {
        self.store.require_mutable()
        if !finite_body_value(scale) {
            panic("GFX.Physics.RigidBody2D gravity scale must be finite")
        }
        let index = self.store.require(self.id)
        self.store.gravity_scales[index] = scale
        self.store.wake(index)
    }

    func set_linear_damping(damping:float) {
        self.store.require_mutable()
        if !finite_body_value(damping) || damping < 0.0 {
            panic("GFX.Physics.RigidBody2D linear damping must be finite and non-negative")
        }
        let index = self.store.require(self.id)
        self.store.linear_dampings[index] = damping
        self.store.wake(index)
    }

    func set_angular_damping(damping:float) {
        self.store.require_mutable()
        if !finite_body_value(damping) || damping < 0.0 {
            panic("GFX.Physics.RigidBody2D angular damping must be finite and non-negative")
        }
        let index = self.store.require(self.id)
        self.store.angular_dampings[index] = damping
        self.store.wake(index)
    }

    func set_sleep_threshold(threshold:float) {
        self.store.require_mutable()
        if !finite_body_value(threshold) || threshold < 0.0 {
            panic("GFX.Physics.RigidBody2D sleep threshold must be finite and non-negative")
        }
        let index = self.store.require(self.id)
        self.store.sleep_thresholds[index] = threshold
        self.store.wake(index)
    }

    func set_sleep_enabled(enabled:bool) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        self.store.allow_sleep[index] = enabled
        if !enabled { self.store.wake(index) }
        self.store.topology_dirty = true
    }

    func set_fixed_rotation(fixed:bool) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        self.store.fixed_rotations[index] = fixed
        if fixed { self.store.angular_velocities[index] = 0.0 }
        self.store.refresh_inverse_mass(index)
        self.store.wake(index)
    }

    func set_bullet(bullet:bool) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        let current = (self.store.behavior_flags[index] & 1) != 0
        if current == bullet { return }
        if bullet { self.store.behavior_flags[index] += 1 }
        else { self.store.behavior_flags[index] -= 1 }
        self.store.wake(index)
        self.store.topology_dirty = true
    }

    func set_enabled(enabled:bool) {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        if self.store.enabled[index] == enabled { return }
        self.store.enabled[index] = enabled
        self.store.forces_x[index] = 0.0
        self.store.forces_y[index] = 0.0
        self.store.torques[index] = 0.0
        if enabled { self.store.wake(index) }
        else {
            self.store.awake[index] = false
            self.store.sleep_times[index] = 0.0
        }
        self.store.topology_dirty = true
    }

    func set_debug_label(label:str) {
        self.store.require_mutable()
        self.store.debug_labels[self.store.require(self.id)] = label
    }

    func set_target_transform(target:Transform2D, duration:float) {
        self.store.require_mutable()
        if !finite_body_value(duration) || duration <= 0.0 {
            panic("GFX.Physics.RigidBody2D kinematic target duration must be finite and positive")
        }
        let index = self.store.require(self.id)
        if self.store.body_types[index] != BodyType2D.kinematic ||
            !self.store.enabled[index]
        {
            panic("GFX.Physics.RigidBody2D target transforms require an enabled kinematic body")
        }
        let local_center = Math.Vec2(
            self.store.local_centers_x[index],
            self.store.local_centers_y[index]
        )
        let target_center = target.point(local_center)
        let center = self.store.world_center_at(index)
        self.store.velocities_x[index] =
            (target_center.x - center.x) / duration
        self.store.velocities_y[index] =
            (target_center.y - center.y) / duration
        var angle = target.rotation - self.store.rotations[index]
        while angle > Math.pi() { angle -= Math.two_pi() }
        while angle < -Math.pi() { angle += Math.two_pi() }
        if self.store.fixed_rotations[index] {
            self.store.angular_velocities[index] = 0.0
        } else {
            self.store.angular_velocities[index] = angle / duration
        }
        self.store.wake(index)
    }

    func apply_force(
        force:Math.Vec2,
        point:Math.Vec2,
        wake:bool = true
    ) {
        if !finite_body_point(force) || !finite_body_point(point) {
            panic("GFX.Physics.RigidBody2D force and point must be finite")
        }
        let index = self.prepare_dynamic_action(wake)
        if !self.store.awake[index] { return }
        self.store.forces_x[index] += force.x
        self.store.forces_y[index] += force.y
        let radius = point.subtract(self.store.world_center_at(index))
        self.store.torques[index] += radius.x * force.y - radius.y * force.x
    }

    func apply_force_to_center(force:Math.Vec2, wake:bool = true) {
        if !finite_body_point(force) {
            panic("GFX.Physics.RigidBody2D force must be finite")
        }
        let index = self.prepare_dynamic_action(wake)
        if !self.store.awake[index] { return }
        self.store.forces_x[index] += force.x
        self.store.forces_y[index] += force.y
    }

    func apply_torque(torque:float, wake:bool = true) {
        if !finite_body_value(torque) {
            panic("GFX.Physics.RigidBody2D torque must be finite")
        }
        let index = self.prepare_dynamic_action(wake)
        if self.store.fixed_rotations[index] {
            panic("GFX.Physics.RigidBody2D torque requires free rotation")
        }
        if self.store.awake[index] { self.store.torques[index] += torque }
    }

    func apply_linear_impulse(
        impulse:Math.Vec2,
        point:Math.Vec2,
        wake:bool = true
    ) {
        if !finite_body_point(impulse) || !finite_body_point(point) {
            panic("GFX.Physics.RigidBody2D impulse and point must be finite")
        }
        let index = self.prepare_dynamic_action(wake)
        if !self.store.awake[index] { return }
        self.store.velocities_x[index] +=
            impulse.x * self.store.inverse_masses[index]
        self.store.velocities_y[index] +=
            impulse.y * self.store.inverse_masses[index]
        let radius = point.subtract(self.store.world_center_at(index))
        self.store.angular_velocities[index] +=
            (radius.x * impulse.y - radius.y * impulse.x) *
            self.store.inverse_inertias[index]
    }

    func apply_linear_impulse_to_center(
        impulse:Math.Vec2,
        wake:bool = true
    ) {
        if !finite_body_point(impulse) {
            panic("GFX.Physics.RigidBody2D impulse must be finite")
        }
        let index = self.prepare_dynamic_action(wake)
        if !self.store.awake[index] { return }
        self.store.velocities_x[index] +=
            impulse.x * self.store.inverse_masses[index]
        self.store.velocities_y[index] +=
            impulse.y * self.store.inverse_masses[index]
    }

    func apply_angular_impulse(impulse:float, wake:bool = true) {
        if !finite_body_value(impulse) {
            panic("GFX.Physics.RigidBody2D angular impulse must be finite")
        }
        let index = self.prepare_dynamic_action(wake)
        if self.store.fixed_rotations[index] {
            panic("GFX.Physics.RigidBody2D angular impulse requires free rotation")
        }
        if self.store.awake[index] {
            self.store.angular_velocities[index] +=
                impulse * self.store.inverse_inertias[index]
        }
    }

    private func prepare_dynamic_action(wake:bool) int {
        self.store.require_mutable()
        let index = self.store.require(self.id)
        if self.store.body_types[index] != BodyType2D.dynamic {
            panic("GFX.Physics.RigidBody2D physical actions require a dynamic body")
        }
        if !self.store.enabled[index] {
            panic("GFX.Physics.RigidBody2D physical actions require an enabled body")
        }
        if self.store.inverse_masses[index] <= 0.0 {
            panic("GFX.Physics.RigidBody2D physical actions require positive mass")
        }
        if wake { self.store.wake(index) }
        return index
    }

    func wake_up() {
        self.store.require_mutable()
        self.store.wake(self.store.require(self.id))
    }
}

func validate_settings(settings:RigidBody2DSettings) {
    if !finite_body_value(settings.mass) || settings.mass < 0.0 {
        panic("GFX.Physics.RigidBody2D mass override must be finite and non-negative")
    }
    if !finite_body_point(settings.position) ||
        !finite_body_point(settings.velocity) ||
        !finite_body_value(settings.rotation) ||
        !finite_body_value(settings.angular_velocity) ||
        !finite_body_value(settings.gravity_scale)
    {
        panic("GFX.Physics.RigidBody2D motion values must be finite")
    }
    if !finite_body_value(settings.restitution) ||
        settings.restitution < 0.0 || settings.restitution > 1.0
    {
        panic("GFX.Physics.RigidBody2D restitution must be between zero and one")
    }
    if !finite_body_value(settings.friction) || settings.friction < 0.0 {
        panic("GFX.Physics.RigidBody2D friction must be non-negative")
    }
    if !finite_body_value(settings.linear_damping) ||
        !finite_body_value(settings.angular_damping) ||
        settings.linear_damping < 0.0 || settings.angular_damping < 0.0
    {
        panic("GFX.Physics.RigidBody2D damping must be non-negative")
    }
    if !finite_body_value(settings.sleep_threshold) ||
        settings.sleep_threshold < 0.0
    {
        panic("GFX.Physics.RigidBody2D sleep threshold must be finite and non-negative")
    }
}

func validate_collider_settings(settings:Collider2DSettings) {
    if !finite_body_value(settings.density) || settings.density < 0.0 {
        panic("GFX.Physics.Collider2D density must be finite and non-negative")
    }
    validate_material(settings.material)
    for material in settings.segment_materials { validate_material(material) }
    validate_segment_materials(
        collider_settings_shape(settings),
        settings.segment_materials
    )
}

func collider_settings_shape(settings:Collider2DSettings) Shape2D {
    if let shape = settings.shape { return shape }
    return Shape2D.box(Box2D())
}

func validate_material(material:PhysicsMaterial2D) {
    if !finite_body_value(material.friction) || material.friction < 0.0 {
        panic("GFX.Physics.PhysicsMaterial2D friction must be finite and non-negative")
    }
    if !finite_body_value(material.restitution) ||
        material.restitution < 0.0 || material.restitution > 1.0
    {
        panic("GFX.Physics.PhysicsMaterial2D restitution must be between zero and one")
    }
    if !finite_body_value(material.rolling_resistance) ||
        material.rolling_resistance < 0.0
    {
        panic("GFX.Physics.PhysicsMaterial2D rolling resistance must be finite and non-negative")
    }
    if !finite_body_value(material.tangent_speed) {
        panic("GFX.Physics.PhysicsMaterial2D tangent speed must be finite")
    }
}

func validate_segment_materials(
    shape:Shape2D,
    materials:PhysicsMaterial2D[]
) {
    if materials.count() == 0 { return }
    match shape {
        chain(value) => {
            if materials.count() != value.segment_count() {
                panic("GFX.Physics.Collider2D segment material count must match the chain segment count")
            }
        }
        else => {
            panic("GFX.Physics.Collider2D segment materials require a chain shape")
        }
    }
}

func finite_body_value(value:float) bool {
    return value == value && (value == 0.0 || value + value != value)
}

func finite_body_point(value:Math.Vec2) bool {
    return finite_body_value(value.x) && finite_body_value(value.y)
}
