use GFX.Physics.Tire3D.Tire3DSettings
use GFX.Physics.RigidBody3D.RigidBody3D
use GFX.Physics.RigidBody3D.RigidBody3DSettings
use GFX.Physics.RigidBody3D.BodyState3D
use GFX.Physics.RigidBody3D.BodyStore3D
use GFX.Physics.RigidBody3D.BodyId3D
use GFX.Physics.RigidBody3D.BodyType3D
use GFX.Physics.RigidBody3D.finite_body3d_point
use GFX.Physics.RigidBody3D.finite_body3d_value
use GFX.Physics.Transform3D.Transform3D
use GFX.Physics.Geometry3D.Ray3D
use GFX.Physics.WorldQuery3D.WorldRayHit3D
use STD.Math

public struct Wheel3DSettings {
    let position:Math.Vec3
    let direction:Math.Vec3
    let radius:float
    let minimum_length:float
    let maximum_length:float
    let stiffness:float
    let damping:float
    let maximum_slope_angle:float
    let tire:Tire3DSettings?

    init(position:Math.Vec3, radius:float = 0.3, minimum_length:float = 0.2,
        maximum_length:float = 0.6, stiffness:float = 10000.0, damping:float = 1000.0,
        direction:Math.Vec3 = Math.Vec3(0.0,-1.0,0.0),
        maximum_slope_angle:float = Math.pi()/3.0, tire:Tire3DSettings?=null)
    {
        if !finite_body3d_point(position) || !finite_body3d_value(position.length_squared()) ||
            !finite_body3d_point(direction) || Math.abs(direction.length_squared()-1.0)>0.0001
        { panic("GFX.Physics.Wheel3DSettings requires a finite position and unit suspension direction") }
        if !finite_body3d_value(radius) || radius<=0.0 ||
            !finite_body3d_value(minimum_length) || minimum_length<0.0 ||
            !finite_body3d_value(maximum_length) || maximum_length<=0.0 || maximum_length<minimum_length ||
            !finite_body3d_value((maximum_length+radius)*(maximum_length+radius))
        { panic("GFX.Physics.Wheel3DSettings requires positive radius and ordered nonnegative finite suspension lengths") }
        if !finite_body3d_value(stiffness) || stiffness<=0.0 || !finite_body3d_value(damping) || damping<0.0 {
            panic("GFX.Physics.Wheel3DSettings requires positive finite stiffness and nonnegative finite damping")
        }
        if !finite_body3d_value(maximum_slope_angle) || maximum_slope_angle<0.0 || maximum_slope_angle>=Math.half_pi() {
            panic("GFX.Physics.Wheel3DSettings slope angle must be finite in [0, pi/2)")
        }
        self.position=position;self.direction=direction.normalized();self.radius=radius
        self.minimum_length=minimum_length;self.maximum_length=maximum_length
        self.stiffness=stiffness;self.damping=damping;self.maximum_slope_angle=maximum_slope_angle;self.tire=tire
    }
}

public class WheeledVehicle3DSettings {
    let chassis:RigidBody3DSettings
    private var wheels:Wheel3DSettings[]

    init(chassis:RigidBody3DSettings, wheels:Wheel3DSettings[]) {
        if chassis.body_type!=BodyType3D.dynamic { panic("GFX.Physics.WheeledVehicle3DSettings requires a dynamic chassis") }
        BodyState3D(chassis)
        if wheels.count()==0 { panic("GFX.Physics.WheeledVehicle3DSettings requires at least one wheel") }
        self.chassis=chassis
        var retained:Wheel3DSettings[]=[]
        for wheel in wheels { retained.append(wheel) }
        self.wheels=retained
    }
    func wheel_count() int { return self.wheels.count() }
    func wheel(index:int) Wheel3DSettings {
        if index<0 || index>=self.wheels.count() { panic("GFX.Physics.WheeledVehicle3D wheel index is out of range") }
        return self.wheels[index]
    }
}

public struct VehicleWheelState3D {
    let length:float
    let normal_force:float
    private var current_support:RigidBody3D?
    let contact_point:Math.Vec3
    let contact_normal:Math.Vec3

    let rotation_angle:float
    let angular_velocity:float
    let longitudinal_slip:float
    let lateral_slip:float
    let longitudinal_force:float
    let lateral_force:float
    let longitudinal_direction:Math.Vec3
    let lateral_direction:Math.Vec3

    package init(length:float, normal_force:float, support:RigidBody3D?, point:Math.Vec3, normal:Math.Vec3,
        angle:float, speed:float, longitudinal_slip:float, lateral_slip:float,
        longitudinal_force:float, lateral_force:float, longitudinal_direction:Math.Vec3, lateral_direction:Math.Vec3) {
        self.length=length;self.normal_force=normal_force;self.current_support=support
        self.contact_point=point;self.contact_normal=normal
        self.rotation_angle=angle;self.angular_velocity=speed
        self.longitudinal_slip=longitudinal_slip;self.lateral_slip=lateral_slip
        self.longitudinal_force=longitudinal_force;self.lateral_force=lateral_force
        self.longitudinal_direction=longitudinal_direction;self.lateral_direction=lateral_direction
    }
    func support() RigidBody3D? { return self.current_support }
}

class WheelSuspensionState3D {
    var support:BodyId3D?=null
    var length:float
    var point:Math.Vec3=Math.Vec3()
    var local_support_point:Math.Vec3=Math.Vec3()
    var normal:Math.Vec3=Math.Vec3()
    var chassis_radius:Math.Vec3=Math.Vec3()
    var support_radius:Math.Vec3=Math.Vec3()
    var inverse_mass:float=0.0
    var softness:float=0.0
    var bias:float=0.0
    var impulse:float=0.0
    var stop_impulse:float=0.0
    var inverse_delta:float=0.0
    var previous_support:BodyId3D?=null
    var previous_lateral_impulse:float=0.0
    var previous_inverse_delta:float=0.0
    var rotation_angle:float=0.0
    var angular_velocity:float=0.0
    var longitudinal_slip:float=0.0
    var lateral_slip:float=0.0
    var longitudinal_impulse:float=0.0
    var lateral_impulse:float=0.0
    var longitudinal_direction:Math.Vec3=Math.Vec3()
    var lateral_direction:Math.Vec3=Math.Vec3()
    var longitudinal_inverse_mass:float=0.0
    var lateral_inverse_mass:float=0.0
    var longitudinal_friction:float=0.0
    var lateral_friction:float=0.0
    var spring:bool=false
    var active:bool=false
    init(length:float) { self.length=length }
    func clear(length:float) {
        self.previous_support=self.support;self.previous_lateral_impulse=self.lateral_impulse;self.previous_inverse_delta=self.inverse_delta
        self.support=null;self.length=length;self.point=Math.Vec3();self.normal=Math.Vec3()
        self.impulse=0.0;self.stop_impulse=0.0;self.inverse_delta=0.0;self.active=false
        self.longitudinal_impulse=0.0;self.lateral_impulse=0.0
        self.longitudinal_slip=0.0;self.lateral_slip=0.0
        self.longitudinal_direction=Math.Vec3();self.lateral_direction=Math.Vec3()
        self.longitudinal_inverse_mass=0.0;self.lateral_inverse_mass=0.0
        self.longitudinal_friction=0.0;self.lateral_friction=0.0
    }
}

public class WheeledVehicle3D {
    private var store:BodyStore3D
    private let id:BodyId3D
    private var settings:WheeledVehicle3DSettings
    private var wheels:WheelSuspensionState3D[]

    package init(store:BodyStore3D, id:BodyId3D, settings:WheeledVehicle3DSettings) {
        self.store=store;self.id=id;self.settings=settings
        var wheels:WheelSuspensionState3D[]=[]
        var index=0
        while index<settings.wheel_count() { wheels.append(WheelSuspensionState3D(settings.wheel(index).maximum_length));index++ }
        self.wheels=wheels
    }
    func is_valid() bool { return self.store.contains(self.id) }
    private func require_valid() {
        if !self.is_valid() { panic("GFX.Physics.WheeledVehicle3D no longer refers to a live vehicle") }
    }
    func chassis() RigidBody3D { self.require_valid();return RigidBody3D(self.store,self.id) }
    func wheel_count() int { return self.settings.wheel_count() }
    func wheel_settings(index:int) Wheel3DSettings { self.require_valid();return self.settings.wheel(index) }
    func wheel(index:int) VehicleWheelState3D {
        self.require_valid();self.settings.wheel(index)
        var state=self.wheels[index];var support:RigidBody3D?=null
        if let id=state.support {
            if self.store.contains(id) { support=RigidBody3D(self.store,id) }
        }
        return VehicleWheelState3D(state.length,(state.impulse+state.stop_impulse)*state.inverse_delta,
            support,state.point,state.normal,state.rotation_angle,state.angular_velocity,
            state.longitudinal_slip,state.lateral_slip,state.longitudinal_impulse*state.inverse_delta,
            state.lateral_impulse*state.inverse_delta,state.longitudinal_direction,state.lateral_direction)
    }
    func set_wheel_angular_velocity(index:int, velocity:float) {
        self.store.require_mutable();self.require_valid()
        let wheel=self.settings.wheel(index)
        if wheel.tire==null { panic("GFX.Physics.WheeledVehicle3D wheel requires a tire to rotate") }
        if !finite_body3d_value(velocity) || !finite_body3d_value(velocity*velocity) ||
            !finite_body3d_value(velocity*wheel.radius*velocity*wheel.radius) {
            panic("GFX.Physics.WheeledVehicle3D wheel angular velocity must be finite and representable")
        }
        self.wheels[index].angular_velocity=velocity;self.store.require(self.id).wake()
    }
    package func prepare_tires(delta:float) {
        var chassis=self.store.require(self.id)
        if !chassis.is_enabled || !chassis.awake { return }
        var index=0
        for state in self.wheels {
            let wheel=self.settings.wheel(index)
            if let tire=wheel.tire {
                state.angular_velocity*=Math.max(0.0,1.0-tire.angular_damping*delta)
                state.rotation_angle=Math.remainder(state.rotation_angle+state.angular_velocity*delta,Math.two_pi())
                if let support=state.support {
                    var ground=self.store.require(support)
                    let forward=chassis.transform.vector(tire.forward)
                    let right=chassis.transform.vector(tire.forward.cross(tire.up).normalized())
                    var longitudinal=state.normal.cross(right)
                    if longitudinal.dot(forward)<0.0 { longitudinal=longitudinal.negated() }
                    if longitudinal.length_squared()<0.00000001 {
                        // Keep the requested forward sign when a cambered axle meets the normal.
                        longitudinal=forward.subtract(state.normal.multiply(forward.dot(state.normal)))
                    }
                    state.longitudinal_direction=longitudinal.normalized()
                    state.lateral_direction=state.longitudinal_direction.cross(state.normal).normalized()
                    let velocity=vehicle_point_velocity3d(chassis,state.chassis_radius).subtract(vehicle_point_velocity3d(ground,state.support_radius))
                    let tangent=velocity.subtract(state.normal.multiply(velocity.dot(state.normal)))
                    let speed=tangent.dot(state.longitudinal_direction)
                    state.longitudinal_slip=Math.abs(state.angular_velocity*wheel.radius-speed)/Math.max(0.001,Math.abs(speed))
                    let magnitude=tangent.length()
                    if magnitude>=0.001 { state.lateral_slip=Math.acos(Math.clamp(Math.abs(speed)/magnitude,0.0,1.0)) }
                    state.longitudinal_friction=Math.sqrt(tire.longitudinal_friction.coefficient(state.longitudinal_slip))*Math.sqrt(ground.friction)
                    state.lateral_friction=Math.sqrt(tire.lateral_friction.coefficient(state.lateral_slip))*Math.sqrt(ground.friction)
                    state.longitudinal_inverse_mass=vehicle_inverse_mass3d(chassis,ground,state.chassis_radius,state.support_radius,state.longitudinal_direction)
                    state.lateral_inverse_mass=vehicle_inverse_mass3d(chassis,ground,state.chassis_radius,state.support_radius,state.lateral_direction)
                    if state.previous_support!=null && state.previous_support! == support {
                        state.lateral_impulse=state.previous_lateral_impulse*state.previous_inverse_delta*delta
                    }
                }
            }
            index++
        }
    }
    package func warm_start_tires() {
        var chassis=self.store.require(self.id)
        for state in self.wheels {
            if state.active && state.support!=null && state.lateral_impulse!=0.0 {
                var ground=self.store.require(state.support!)
                apply_vehicle_pair_vector3d(chassis,ground,state,state.lateral_direction.multiply(state.lateral_impulse))
            }
        }
    }
    package func keep_awake_for_wheels() {
        var chassis=self.store.require(self.id)
        for state in self.wheels {
            if Math.abs(state.angular_velocity)>Math.radians(10.0) { chassis.sleep_time=0.0;return }
        }
    }
    private func solve_tire_velocities() {
        var chassis=self.store.require(self.id);var index=0
        for state in self.wheels {
            let wheel=self.settings.wheel(index)
            if state.active && state.support!=null {
                if let tire=wheel.tire {
                    var ground=self.store.require(state.support!)
                    let speed=vehicle_point_velocity3d(chassis,state.chassis_radius).subtract(vehicle_point_velocity3d(ground,state.support_radius)).dot(state.longitudinal_direction)
                    let capacity=state.longitudinal_friction*(state.impulse+state.stop_impulse)
                    let change=(state.angular_velocity-speed/wheel.radius)*tire.inertia/wheel.radius
                    let previous=state.longitudinal_impulse
                    state.longitudinal_impulse=Math.clamp(previous+change,-capacity,capacity)
                    let impulse=state.longitudinal_impulse-previous
                    apply_vehicle_pair_vector3d(chassis,ground,state,state.longitudinal_direction.multiply(impulse))
                    state.angular_velocity-=impulse*wheel.radius/tire.inertia
                }
            }
            index++
        }
        for state in self.wheels {
            if state.active && state.support!=null && state.lateral_inverse_mass>0.0 {
                var ground=self.store.require(state.support!)
                let speed=vehicle_point_velocity3d(chassis,state.chassis_radius).subtract(vehicle_point_velocity3d(ground,state.support_radius)).dot(state.lateral_direction)
                let capacity=state.lateral_friction*(state.impulse+state.stop_impulse)
                let previous=state.lateral_impulse
                state.lateral_impulse=Math.clamp(previous-speed/state.lateral_inverse_mass,-capacity,capacity)
                apply_vehicle_pair_vector3d(chassis,ground,state,state.lateral_direction.multiply(state.lateral_impulse-previous))
            }
        }
    }
    package func belongs_to(store:BodyStore3D) bool { return self.store==store }
    package func chassis_id() BodyId3D { return self.id }
    package func ray(index:int) Ray3D {
        var body=self.store.require(self.id);let wheel=self.settings.wheel(index)
        return Ray3D(body.transform.point(wheel.position),body.transform.vector(wheel.direction).multiply(wheel.maximum_length+wheel.radius))
    }
    package func clear_contacts() {
        var index=0
        while index<self.wheels.count() { self.wheels[index].clear(self.settings.wheel(index).maximum_length);index++ }
    }
    package func accept_contact(index:int, hit:WorldRayHit3D, delta:float) bool {
        var chassis=self.store.require(self.id);var ground=self.store.require(hit.body().body_id())
        let wheel=self.settings.wheel(index)
        let alignment=hit.normal().dot(chassis.transform.vector(wheel.direction).negated())
        if alignment<Math.cos(wheel.maximum_slope_angle) { return false }
        var state=self.wheels[index]
        state.support=hit.body().body_id();state.point=hit.point();state.normal=hit.normal()
        state.local_support_point=ground.transform.inverse_point(state.point)
        state.length=Math.max(0.0,(wheel.maximum_length+wheel.radius)*hit.fraction()-wheel.radius)
        state.chassis_radius=state.point.subtract(chassis.world_center())
        state.support_radius=state.point.subtract(ground.world_center())
        state.inverse_mass=vehicle_inverse_mass3d(chassis,ground,state.chassis_radius,state.support_radius,state.normal)
        state.spring=wheel.maximum_length> wheel.minimum_length
        let stiffness=wheel.stiffness/Math.max(0.1,alignment)
        let damping=wheel.damping/Math.max(0.1,alignment)
        state.softness=1.0/(delta*(damping+delta*stiffness))
        state.bias=(state.length-wheel.maximum_length)*delta*stiffness*state.softness
        state.inverse_delta=1.0/delta
        let moving_ground=ground.body_type==BodyType3D.kinematic &&
            (ground.linear_velocity.length_squared()>0.0 || ground.angular_velocity.length_squared()>0.0)
        if (ground.awake || moving_ground) && !chassis.awake { chassis.wake() }
        if chassis.awake && !ground.awake { ground.wake() }
        state.active=chassis.awake || ground.awake
        return true
    }
    package func forget_support(id:BodyId3D) {
        var index=0
        for state in self.wheels {
            if state.support!=null && state.support! == id {
                state.clear(self.settings.wheel(index).maximum_length)
                self.store.require(self.id).wake()
            }
            index++
        }
    }
    package func support_id(index:int) BodyId3D? { return self.wheels[index].support }
    package func wake_connected_bodies() {
        var chassis=self.store.require(self.id)
        if !chassis.is_enabled { return }
        for state in self.wheels {
            if let id=state.support {
                var ground=self.store.require(id)
                let moving=ground.body_type==BodyType3D.kinematic &&
                    (ground.linear_velocity.length_squared()>0.0 || ground.angular_velocity.length_squared()>0.0)
                if (ground.awake || moving) && !chassis.awake { chassis.wake() }
                if chassis.awake && !ground.awake { ground.wake() }
                state.active=chassis.awake || ground.awake
            }
        }
    }
    package func has_active_contact() bool {
        for wheel in self.wheels { if wheel.active { return true } }
        return false
    }
    package func solve_velocity() {
        var chassis=self.store.require(self.id);var index=0
        for state in self.wheels {
            if state.active && state.support!=null && state.inverse_mass>0.0 {
                var ground=self.store.require(state.support!)
                if state.spring {
                    let speed=vehicle_relative_speed3d(chassis,ground,state)
                    let previous=state.impulse
                    state.impulse=Math.max(0.0,previous-(speed+state.bias+state.softness*previous)/(state.inverse_mass+state.softness))
                    apply_vehicle_pair_impulse3d(chassis,ground,state,state.impulse-previous)
                }
                if state.length<self.settings.wheel(index).minimum_length {
                    let previous=state.stop_impulse
                    state.stop_impulse=Math.max(0.0,previous-vehicle_relative_speed3d(chassis,ground,state)/state.inverse_mass)
                    apply_vehicle_pair_impulse3d(chassis,ground,state,state.stop_impulse-previous)
                }
            }
            index++
        }
        self.solve_tire_velocities()
    }
    package func solve_position() {
        var chassis=self.store.require(self.id);var index=0
        for state in self.wheels {
            if state.active && state.support!=null {
                var ground=self.store.require(state.support!);let wheel=self.settings.wheel(index)
                let point=ground.transform.point(state.local_support_point)
                let limit=chassis.transform.point(wheel.position).add(chassis.transform.vector(wheel.direction).multiply(wheel.minimum_length+wheel.radius))
                let error=limit.subtract(point).dot(state.normal)
                if error<0.0 {
                    let first=point.subtract(chassis.world_center());let second=point.subtract(ground.world_center())
                    let inverse_mass=vehicle_inverse_mass3d(chassis,ground,first,second,state.normal)
                    if inverse_mass>0.0 {
                        let impulse=state.normal.multiply(Math.min(0.2,-0.2*error)/inverse_mass)
                        shift_vehicle_body3d(chassis,impulse,first)
                        shift_vehicle_body3d(ground,impulse.negated(),second)
                    }
                }
            }
            index++
        }
    }
}

func vehicle_inverse_mass3d(chassis:BodyState3D, ground:BodyState3D, first:Math.Vec3, second:Math.Vec3, normal:Math.Vec3) float {
    let a=first.cross(normal);let b=second.cross(normal)
    return chassis.inverse_mass+ground.inverse_mass+a.dot(chassis.inverse_inertia_times(a))+b.dot(ground.inverse_inertia_times(b))
}
func vehicle_relative_speed3d(chassis:BodyState3D, ground:BodyState3D, state:WheelSuspensionState3D) float {
    return chassis.linear_velocity.add(chassis.angular_velocity.cross(state.chassis_radius))
        .subtract(ground.linear_velocity.add(ground.angular_velocity.cross(state.support_radius))).dot(state.normal)
}
func vehicle_point_velocity3d(body:BodyState3D, radius:Math.Vec3) Math.Vec3 {
    return body.linear_velocity.add(body.angular_velocity.cross(radius))
}
func apply_vehicle_pair_impulse3d(chassis:BodyState3D, ground:BodyState3D, state:WheelSuspensionState3D, amount:float) {
    apply_vehicle_pair_vector3d(chassis,ground,state,state.normal.multiply(amount))
}
func apply_vehicle_pair_vector3d(chassis:BodyState3D, ground:BodyState3D, state:WheelSuspensionState3D, impulse:Math.Vec3) {
    chassis.linear_velocity=chassis.linear_velocity.add(impulse.multiply(chassis.inverse_mass))
    chassis.angular_velocity=chassis.angular_velocity.add(chassis.inverse_inertia_times(state.chassis_radius.cross(impulse)))
    ground.linear_velocity=ground.linear_velocity.subtract(impulse.multiply(ground.inverse_mass))
    ground.angular_velocity=ground.angular_velocity.subtract(ground.inverse_inertia_times(state.support_radius.cross(impulse)))
}
func shift_vehicle_body3d(body:BodyState3D, impulse:Math.Vec3, radius:Math.Vec3) {
    if body.inverse_mass==0.0 { return }
    let center=body.world_center().add(impulse.multiply(body.inverse_mass))
    let turn=body.inverse_inertia_times(radius.cross(impulse));let angle=turn.length()
    var rotation=body.transform.rotation
    if angle>0.0 { rotation=Math.Quat.angle_axis(angle,turn.divide(angle)).multiply(rotation).normalized() }
    body.transform=Transform3D(center.subtract(rotation.rotate(body.mass_properties.local_center)),rotation)
}
