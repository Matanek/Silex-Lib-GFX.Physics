use GFX.Physics.RigidBody3D.RigidBody3D
use GFX.Physics.RigidBody3D.BodyId3D
use STD.Math

public struct ContactPoint3D {
    let position:Math.Vec3
    let normal_impulse:float
    let tangent_impulse:Math.Vec3

    package init(position:Math.Vec3, normal_impulse:float, tangent_impulse:Math.Vec3) {
        self.position = position
        self.normal_impulse = normal_impulse
        self.tangent_impulse = tangent_impulse
    }
}

public class Contact3D {
    private let first_identity:BodyId3D
    private let second_identity:BodyId3D
    private let first_shape_revision:int
    private let second_shape_revision:int
    private let first_pose_revision:int
    private let second_pose_revision:int
    private var first:RigidBody3D
    private var second:RigidBody3D
    private var contact_normal:Math.Vec3
    private var contact_separation:float
    private var contact_point:Math.Vec3
    private var applied_normal_impulse:float
    private var applied_tangent_impulse:Math.Vec3
    private var combined_friction:float
    private var combined_restitution:float
    private var manifold_points:ContactPoint3D[]
    private var first_child:int
    private var second_child:int
    private var sensor_pair:bool

    package init(
        first:RigidBody3D,
        second:RigidBody3D,
        normal:Math.Vec3,
        separation:float,
        point:Math.Vec3,
        normal_impulse:float,
        tangent_impulse:Math.Vec3,
        friction:float,
        restitution:float,
        points:ContactPoint3D[],
        first_child_id:int,
        second_child_id:int,
        is_sensor:bool,
        first_revision:int,
        second_revision:int,
        first_pose_revision:int,
        second_pose_revision:int
    ) {
        self.first_identity = first.body_id()
        self.second_identity = second.body_id()
        self.first_shape_revision = first_revision
        self.second_shape_revision = second_revision
        self.first_pose_revision = first_pose_revision
        self.second_pose_revision = second_pose_revision
        self.first = first
        self.second = second
        self.contact_normal = normal
        self.contact_separation = separation
        self.contact_point = point
        self.applied_normal_impulse = normal_impulse
        self.applied_tangent_impulse = tangent_impulse
        self.combined_friction = friction
        self.combined_restitution = restitution
        self.manifold_points = points
        self.first_child = first_child_id
        self.second_child = second_child_id
        self.sensor_pair = is_sensor
    }

    // Immutable snapshot identities avoid copying handles during pair lookup.
    package func first_body_id() BodyId3D { return self.first_identity }
    package func second_body_id() BodyId3D { return self.second_identity }
    package func first_revision() int { return self.first_shape_revision }
    package func second_revision() int { return self.second_shape_revision }
    package func first_pose_version() int { return self.first_pose_revision }
    package func second_pose_version() int { return self.second_pose_revision }

    package func manifold_point(index:int) ContactPoint3D { return self.manifold_points[index] }

    func first_body() RigidBody3D { return self.first }
    func second_body() RigidBody3D { return self.second }
    func normal() Math.Vec3 { return self.contact_normal }
    func separation() float { return self.contact_separation }
    func point() Math.Vec3 { return self.contact_point }
    func normal_impulse() float { return self.applied_normal_impulse }
    func tangent_impulse() Math.Vec3 { return self.applied_tangent_impulse }
    func friction() float { return self.combined_friction }
    func restitution() float { return self.combined_restitution }
    func first_child_id() int { return self.first_child }
    func second_child_id() int { return self.second_child }
    func is_sensor() bool { return self.sensor_pair }
    func point_count() int { return self.manifold_points.count() }
    func write_points(output:&ContactPoint3D[]) {
        output.clear()
        for point in self.manifold_points { output.append(point) }
    }
}
