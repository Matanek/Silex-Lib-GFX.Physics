use GFX.Physics.RigidBody3D.BodyId3D
use GFX.Physics.RigidBody3D.BodyStore3D
use GFX.Physics.RigidBody3D.RigidBody3D
use GFX.Physics.RigidBody3D.finite_body3d_point
use GFX.Physics.RigidBody3D.finite_body3d_value
use GFX.Physics.PointConstraint3D.PointConstraintState3D
use GFX.Physics.PointConstraint3D.PointConstraint3DSettings
use GFX.Physics.Transform3D.Transform3D
use STD.Math

public struct ConeConstraint3DSettings {
    var first_local_anchor:Math.Vec3 = Math.Vec3()
    var second_local_anchor:Math.Vec3 = Math.Vec3()
    var first_local_axis:Math.Vec3 = Math.Vec3(0.0, 0.0, 1.0)
    var second_local_axis:Math.Vec3 = Math.Vec3(0.0, 0.0, 1.0)
    var half_angle:float = Math.pi() / 4.0
    var is_enabled:bool = true
    init() {}
}

package class ConeConstraintState3D {
    var point:PointConstraintState3D
    var first_local_axis:Math.Vec3
    var second_local_axis:Math.Vec3
    var half_angle:float
    var angular_impulse:Math.Vec3 = Math.Vec3()
    var limit_impulse:float = 0.0
    var rotation_axis:Math.Vec3

    init(first_id:BodyId3D, second_id:BodyId3D, settings:ConeConstraint3DSettings) {
        validate_cone_axis3d(settings.first_local_axis)
        validate_cone_axis3d(settings.second_local_axis)
        validate_cone_angle3d(settings.half_angle)
        var anchors = PointConstraint3DSettings()
        anchors.first_local_anchor = settings.first_local_anchor
        anchors.second_local_anchor = settings.second_local_anchor
        anchors.is_enabled = settings.is_enabled
        self.point = PointConstraintState3D(first_id, second_id, anchors)
        self.first_local_axis = settings.first_local_axis.normalized()
        self.second_local_axis = settings.second_local_axis.normalized()
        self.half_angle = settings.half_angle
        self.rotation_axis = cone_perpendicular3d(self.first_local_axis)
    }
    func reset() {
        self.point.impulse = Math.Vec3()
        self.point.inverse_delta = 0.0
        self.angular_impulse = Math.Vec3()
        self.limit_impulse = 0.0
    }
}

package struct ConeConstraintId3D {
    let slot:int
    let generation:int
    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

package class ConeConstraintStore3D {
    var bodies:BodyStore3D
    var slots:ConeConstraintState3D?[] = []
    var generations:int[] = []
    var free_slots:int[] = []
    var live_count:int = 0

    init(bodies:BodyStore3D) { self.bodies = bodies }

    func invalidate_all() {
        self.slots = []
        self.generations = []
        self.free_slots = []
        self.live_count = 0
    }

    func append(first:@RigidBody3D, second:@RigidBody3D,
        settings:ConeConstraint3DSettings) ConeConstraintId3D
    {
        self.bodies.require_mutable()
        if !first.belongs_to(self.bodies) || !second.belongs_to(self.bodies) {
            panic("GFX.Physics.ConeConstraint3D requires bodies from its world")
        }
        if first.same_body(second) {
            panic("GFX.Physics.ConeConstraint3D requires two distinct bodies")
        }
        var first_state = self.bodies.require(first.body_id())
        var second_state = self.bodies.require(second.body_id())
        if first_state.inverse_mass == 0.0 && second_state.inverse_mass == 0.0 {
            panic("GFX.Physics.ConeConstraint3D requires a dynamic body")
        }
        var state = ConeConstraintState3D(first.body_id(), second.body_id(), settings)
        var slot = self.slots.count()
        if self.free_slots.count() > 0 {
            slot = self.free_slots.take_last()
            self.slots[slot] = state
        } else {
            self.slots.append(state)
            self.generations.append(0)
        }
        self.live_count++
        first_state.wake()
        second_state.wake()
        return ConeConstraintId3D(slot, self.generations[slot])
    }

    func contains(id:ConeConstraintId3D) bool {
        return id.slot >= 0 && id.slot < self.slots.count() &&
            self.generations[id.slot] == id.generation && self.slots[id.slot] != null
    }

    func require(id:ConeConstraintId3D) ConeConstraintState3D {
        if !self.contains(id) {
            panic("GFX.Physics.ConeConstraint3D no longer refers to a live constraint")
        }
        return self.slots[id.slot]!
    }

    func destroy(id:ConeConstraintId3D) {
        self.bodies.require_mutable()
        var state = self.require(id)
        self.bodies.require(state.point.first_id).wake()
        self.bodies.require(state.point.second_id).wake()
        self.slots[id.slot] = null
        self.generations[id.slot]++
        self.free_slots.append(id.slot)
        self.live_count--
    }

    func destroy_for_body(body_id:BodyId3D) {
        var slot = 0
        while slot < self.slots.count() {
            if var state = self.slots[slot] {
                if same_cone_body_id3d(state.point.first_id, body_id) ||
                    same_cone_body_id3d(state.point.second_id, body_id)
                {
                    var other_id = state.point.first_id
                    if same_cone_body_id3d(state.point.first_id, body_id) {
                        other_id = state.point.second_id
                    }
                    self.bodies.require(other_id).wake()
                    self.slots[slot] = null
                    self.generations[slot]++
                    self.free_slots.append(slot)
                    self.live_count--
                }
            }
            slot++
        }
    }
}

public class ConeConstraint3D {
    private var store:ConeConstraintStore3D
    private let id:ConeConstraintId3D

    package init(store:ConeConstraintStore3D, id:ConeConstraintId3D) {
        self.store = store
        self.id = id
    }
    func is_valid() bool { return self.store.contains(self.id) }
    package func belongs_to(store:ConeConstraintStore3D) bool { return self.store == store }
    package func constraint_id() ConeConstraintId3D { return self.id }
    func first_body() RigidBody3D {
        return RigidBody3D(self.store.bodies, self.store.require(self.id).point.first_id)
    }
    func second_body() RigidBody3D {
        return RigidBody3D(self.store.bodies, self.store.require(self.id).point.second_id)
    }
    func is_enabled() bool { return self.store.require(self.id).point.is_enabled }
    func first_local_anchor() Math.Vec3 { return self.store.require(self.id).point.first_local_anchor }
    func second_local_anchor() Math.Vec3 { return self.store.require(self.id).point.second_local_anchor }
    func first_local_axis() Math.Vec3 { return self.store.require(self.id).first_local_axis }
    func second_local_axis() Math.Vec3 { return self.store.require(self.id).second_local_axis }
    func half_angle() float { return self.store.require(self.id).half_angle }
    func angle() float {
        var state = self.store.require(self.id)
        return cone_angle3d(self.store.bodies.require(state.point.first_id).transform,
            self.store.bodies.require(state.point.second_id).transform, state)
    }
    func anchor_error() Math.Vec3 {
        var state = self.store.require(self.id).point
        return self.store.bodies.require(state.second_id).transform.point(state.second_local_anchor).subtract(
            self.store.bodies.require(state.first_id).transform.point(state.first_local_anchor))
    }
    func reaction_force() Math.Vec3 {
        var state = self.store.require(self.id).point
        return state.impulse.multiply(state.inverse_delta)
    }
    func reaction_torque() Math.Vec3 {
        var state = self.store.require(self.id)
        return state.angular_impulse.multiply(state.point.inverse_delta)
    }
    private func invalidate_reaction(state:ConeConstraintState3D) {
        state.reset()
        self.store.bodies.require(state.point.first_id).wake()
        self.store.bodies.require(state.point.second_id).wake()
    }
    func set_enabled(enabled:bool) {
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.point.is_enabled = enabled
        self.invalidate_reaction(state)
    }
    func set_anchors(first:Math.Vec3, second:Math.Vec3) {
        if !finite_body3d_point(first) || !finite_body3d_point(second) {
            panic("GFX.Physics.ConeConstraint3D requires finite local anchors")
        }
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.point.first_local_anchor = first
        state.point.second_local_anchor = second
        self.invalidate_reaction(state)
    }
    func set_axes(first:Math.Vec3, second:Math.Vec3) {
        validate_cone_axis3d(first)
        validate_cone_axis3d(second)
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.first_local_axis = first.normalized()
        state.second_local_axis = second.normalized()
        state.rotation_axis = cone_perpendicular3d(self.store.bodies.require(state.point.first_id)
            .transform.vector(state.first_local_axis))
        self.invalidate_reaction(state)
    }
    func set_half_angle(angle:float) {
        validate_cone_angle3d(angle)
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.half_angle = angle
        self.invalidate_reaction(state)
    }
}
package func validate_cone_axis3d(axis:Math.Vec3) {
    if !finite_body3d_point(axis) || !finite_body3d_value(axis.length_squared()) ||
        axis.length_squared() <= 0.0000000001
    {
        panic("GFX.Physics.ConeConstraint3D requires finite nonzero axes")
    }
}
package func validate_cone_angle3d(angle:float) {
    if !finite_body3d_value(angle) || angle < 0.0 || angle > Math.pi() {
        panic("GFX.Physics.ConeConstraint3D requires a finite half-angle within [0, pi]")
    }
}
package func cone_perpendicular3d(axis:Math.Vec3) Math.Vec3 {
    var direction = Math.Vec3(1.0, 0.0, 0.0)
    if Math.abs(axis.x) > 0.9 { direction = Math.Vec3(0.0, 1.0, 0.0) }
    return axis.cross(direction).normalized()
}
package func cone_angle3d(first:Transform3D, second:Transform3D, state:ConeConstraintState3D) float {
    let a = first.vector(state.first_local_axis)
    let b = second.vector(state.second_local_axis)
    return Math.atan2(a.cross(b).length(), a.dot(b))
}
package func same_cone_body_id3d(first:BodyId3D, second:BodyId3D) bool {
    return first.slot == second.slot && first.generation == second.generation
}
