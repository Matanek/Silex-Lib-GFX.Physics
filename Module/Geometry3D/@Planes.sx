use GFX.Physics.Plane3D.Plane3D
use GFX.Physics.Shape3D.Shape3D
use GFX.Physics.Transform3D.Transform3D
use STD.Math

package func plane_shape3d(shape:Shape3D) bool {
    match shape { plane(_) => { return true }; else => { return false } }
}
struct PlaneFrame3D {
    let normal:Math.Vec3
    let origin:Math.Vec3
    init(normal:Math.Vec3, origin:Math.Vec3) { self.normal = normal; self.origin = origin }
}
func placed_plane3d(placement:ShapePlacement3D) PlaneFrame3D {
    match placement.shape() {
        plane(plane) => {
            let normal = placement.transform().vector(plane.normal)
            return PlaneFrame3D(normal.normalized(), placement.transform().point(plane.normal.multiply(plane.offset)))
        }
        else => { panic("GFX.Physics expected a plane") }
    }
}
package func plane_pair_distance3d(first:ShapePlacement3D, second:ShapePlacement3D) DistanceResult3D {
    if plane_shape3d(first.shape()) { return reversed_distance(volume_plane_distance3d(second, first)) }
    return volume_plane_distance3d(first, second)
}
func volume_plane_distance3d(volume:ShapePlacement3D, surface:ShapePlacement3D) DistanceResult3D {
    match volume.shape() {
        compound(compound) => { return compound_first_distance(compound, volume.transform(), surface) }
        mesh(mesh) => {
            var best = DistanceResult3D(Math.Vec3(), Math.Vec3(), Math.Vec3.up(), 3.4028235e38)
            var index = 0
            while index < mesh.triangle_count() {
                let next = volume_plane_distance3d(ShapePlacement3D(Shape3D.triangle(mesh.triangle(index)), volume.transform()), surface)
                if next.separation < best.separation { best = DistanceResult3D(next.first_point, next.second_point, next.normal, next.separation, index, -1) }
                index++
            }
            return best
        }
        plane(_) => { panic("GFX.Physics.Geometry3D does not provide plane/plane distance") }
        else => {}
    }
    let plane = placed_plane3d(surface)
    let point = support_support3d(SupportPlacement3D(support_volume3d(volume.shape()),
        volume.transform().position, volume.transform().rotation), plane.normal.negated())
    let separation = plane.normal.dot(point.subtract(plane.origin))
    return DistanceResult3D(point, point.subtract(plane.normal.multiply(separation)), plane.normal.negated(), separation)
}
func plane_ray_cast3d(ray:Ray3D, target:ShapePlacement3D) CastResult3D {
    let plane = placed_plane3d(target)
    let distance = plane.normal.dot(ray.origin.subtract(plane.origin))
    if distance <= 0.0 { return CastResult3D(ray.origin, plane.normal, 0.0) }
    let speed = ray.translation.dot(plane.normal)
    if speed >= 0.0 { return CastResult3D() }
    let fraction = -distance / speed
    if fraction > 1.0 { return CastResult3D() }
    return CastResult3D(ray.origin.add(ray.translation.multiply(fraction)), plane.normal, fraction)
}
func plane_shape_cast3d(cast:ShapeCast3D, target:ShapePlacement3D) CastResult3D {
    let distance = volume_plane_distance3d(cast.placement, target)
    let normal = distance.normal.negated()
    if distance.separation <= 0.0 { return CastResult3D(distance.second_point, normal, 0.0) }
    let speed = cast.translation.dot(normal)
    if speed >= 0.0 { return CastResult3D() }
    let fraction = -distance.separation / speed
    if fraction > 1.0 { return CastResult3D() }
    return CastResult3D(distance.second_point.add(cast.translation.multiply(fraction))
        .subtract(normal.multiply(speed * fraction)), normal, fraction)
}

// Actual exposed convex feature against an unbounded supporting plane.
// Feature construction occurs only for detected contacts, never for broad pairs.
package func plane_contact_points3d(volume:ShapePlacement3D, surface:ShapePlacement3D) Math.Vec3[] {
    let plane = placed_plane3d(surface)
    let direction = plane.normal.negated()
    let pose = volume.transform()
    var candidates:Math.Vec3[] = []
    if axial_shape3d(volume.shape()) { candidates = axial_contact_feature3d(volume, direction) }
    else {
        match volume.shape() {
            box(box) => {
                let signs:float[] = [-1.0,1.0]
                for x in signs { for y in signs { for z in signs {
                    candidates.append(pose.point(Math.Vec3(x,y,z).multiply(box.half_size())))
                } } }
            }
            convex(hull) => { var index = 0; while index < hull.vertex_count() { candidates.append(pose.point(hull.vertex(index))); index++ } }
            capsule(capsule) => {
                let axis = pose.inverse_vector(direction)
                let radial = axis.normalized().multiply(capsule.radius)
                candidates.append(pose.point(radial.add(Math.Vec3(0.0,-capsule.half_height,0.0))))
                candidates.append(pose.point(radial.add(Math.Vec3(0.0,capsule.half_height,0.0))))
            }
            else => { let distance = volume_plane_distance3d(volume,surface); return [distance.first_point.add(distance.second_point).multiply(0.5)] }
        }
    }
    let distance = volume_plane_distance3d(volume,surface)
    var points:Math.Vec3[] = []
    for point in candidates {
        let gap = plane.normal.dot(point.subtract(plane.origin))
        if Math.abs(gap - distance.separation) <= shape_cast_extent3d(volume.shape()) * 0.00001 {
            points.append(point.subtract(plane.normal.multiply(gap * 0.5)))
        }
    }
    if points.is_empty() { return [distance.first_point.add(distance.second_point).multiply(0.5)] }
    return points
}
