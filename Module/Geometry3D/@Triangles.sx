use GFX.Physics.Sphere3D.Sphere3D
use GFX.Physics.Transform3D.Transform3D
use GFX.Physics.Triangle3D.Triangle3D
use GFX.Physics.TriangleMesh3D.TriangleMesh3D
use STD.Math

func closest_triangle_point3d(point:Math.Vec3, triangle:Triangle3D) Math.Vec3 {
    let a = triangle.first
    let ab = triangle.second.subtract(a)
    let ac = triangle.third.subtract(a)
    let ap = point.subtract(a)
    let d1 = ab.dot(ap)
    let d2 = ac.dot(ap)
    if d1 <= 0.0 && d2 <= 0.0 { return a }

    let bp = point.subtract(triangle.second)
    let d3 = ab.dot(bp)
    let d4 = ac.dot(bp)
    if d3 >= 0.0 && d4 <= d3 { return triangle.second }

    let ab_region = d1 * d4 - d3 * d2
    if ab_region <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
        return a.add(ab.multiply(d1 / (d1 - d3)))
    }

    let cp = point.subtract(triangle.third)
    let d5 = ab.dot(cp)
    let d6 = ac.dot(cp)
    if d6 >= 0.0 && d5 <= d6 { return triangle.third }

    let ac_region = d5 * d2 - d1 * d6
    if ac_region <= 0.0 && d2 >= 0.0 && d6 <= 0.0 {
        return a.add(ac.multiply(d2 / (d2 - d6)))
    }

    let bc_region = d3 * d6 - d5 * d4
    if bc_region <= 0.0 && d4 - d3 >= 0.0 && d5 - d6 >= 0.0 {
        return triangle.second.add(triangle.third.subtract(triangle.second)
            .multiply((d4 - d3) / ((d4 - d3) + (d5 - d6))))
    }

    let inverse = 1.0 / (ab_region + ac_region + bc_region)
    return a.add(ab.multiply(ac_region * inverse))
        .add(ac.multiply(ab_region * inverse))
}

func sphere_triangle_distance(
    sphere:Sphere3D, sphere_transform:Transform3D,
    triangle:Triangle3D, triangle_transform:Transform3D
) DistanceResult3D {
    let center = triangle_transform.inverse_point(sphere_transform.position)
    let local_point = closest_triangle_point3d(center, triangle)
    let local_offset = local_point.subtract(center)
    let length = local_offset.length()
    var local_normal = triangle.normal().negated()
    if length > 0.0 { local_normal = local_offset.divide(length) }
    let normal = triangle_transform.vector(local_normal)
    return DistanceResult3D(
        sphere_transform.position.add(normal.multiply(sphere.radius)),
        triangle_transform.point(local_point), normal, length - sphere.radius
    )
}

package func sphere_triangle_front3d(
    sphere_transform:Transform3D,
    triangle:Triangle3D, triangle_transform:Transform3D
) bool {
    let center = triangle_transform.inverse_point(sphere_transform.position)
    return center.subtract(triangle.first).dot(triangle.normal()) >= 0.0
}

func ray_triangle_cast(ray:Ray3D, triangle:Triangle3D,
    transform:Transform3D) CastResult3D {
    let origin = transform.inverse_point(ray.origin)
    let direction = transform.inverse_vector(ray.translation)
    let face = triangle.normal()
    let denominator = face.dot(direction)
    if Math.abs(denominator) < 0.000000000001 { return CastResult3D() }
    let fraction = face.dot(triangle.first.subtract(origin)) / denominator
    if fraction < 0.0 || fraction > 1.0 { return CastResult3D() }
    let point = origin.add(direction.multiply(fraction))
    let closest = closest_triangle_point3d(point, triangle)
    if point.subtract(closest).length_squared() > 0.000000000001 {
        return CastResult3D()
    }
    var normal = face
    if denominator > 0.0 { normal = face.negated() }
    return CastResult3D(ray.origin.add(ray.translation.multiply(fraction)),
        transform.vector(normal), fraction)
}

func sphere_mesh_distance(
    sphere:Sphere3D, sphere_transform:Transform3D,
    mesh:TriangleMesh3D, mesh_transform:Transform3D,
    front_only:bool = false
) DistanceResult3D {
    var best = DistanceResult3D(Math.Vec3(), Math.Vec3(), Math.Vec3.up(),
        1000000000000.0)
    var index = 0
    while index < mesh.triangle_count() {
        let triangle = mesh.triangle(index)
        if !front_only || sphere_triangle_front3d(sphere_transform, triangle,
            mesh_transform) {
            let distance = sphere_triangle_distance(sphere, sphere_transform,
                triangle, mesh_transform)
            if distance.separation < best.separation {
                best = DistanceResult3D(distance.first_point, distance.second_point,
                    distance.normal, distance.separation, -1, index)
            }
        }
        index++
    }
    return best
}

package func sphere_mesh_front3d(
    sphere_transform:Transform3D,
    mesh:TriangleMesh3D, mesh_transform:Transform3D
) bool {
    var index = 0
    while index < mesh.triangle_count() {
        if sphere_triangle_front3d(sphere_transform, mesh.triangle(index),
            mesh_transform) { return true }
        index++
    }
    return false
}

func ray_mesh_cast(ray:Ray3D, mesh:TriangleMesh3D,
    transform:Transform3D) CastResult3D {
    var best = CastResult3D()
    var index = 0
    while index < mesh.triangle_count() {
        let hit = ray_triangle_cast(ray, mesh.triangle(index), transform)
        if hit.hit && (!best.hit || hit.fraction < best.fraction) {
            best = CastResult3D(hit.point, hit.normal, hit.fraction, index)
        }
        index++
    }
    return best
}
