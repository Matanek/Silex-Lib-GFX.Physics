package enum JointKind2D {
    distance
    filter
    motor
    mouse
    prismatic
    revolute
    weld
    wheel
}

package struct JointId2D {
    let slot:int
    let generation:int

    init() {
        self.slot = -1
        self.generation = 0
    }

    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

// Prepared once per step; springs also act during the relaxation pass.
package struct JointSoftness2D {
    var bias_rate:float
    var mass_scale:float
    var impulse_scale:float

    init(hertz:float, damping_ratio:float, delta:float) {
        self.bias_rate = 0.0
        self.mass_scale = 0.0
        self.impulse_scale = 0.0
        if hertz > 0.0 {
            let omega = 2.0 * 3.141592653589793 * hertz
            let a1 = 2.0 * damping_ratio + delta * omega
            let a2 = delta * omega * a1
            self.impulse_scale = 1.0 / (1.0 + a2)
            self.bias_rate = omega / a1
            self.mass_scale = a2 * self.impulse_scale
        }
    }
}

package struct JointConstraint2D {
    var application_id:uint64?
    var prepared_first_radius:Math.Vec2
    var prepared_second_radius:Math.Vec2
    var prepared_axis:Math.Vec2
    var prepared_center_delta:Math.Vec2
    var prepared_relative_angle:float
    var prepared_spring:JointSoftness2D
    var prepared_angular:JointSoftness2D
    var prepared_axial_mass:float
    var prepared_perpendicular_mass:float
    var constraint_bias_rate:float
    var constraint_mass_scale:float
    var constraint_impulse_scale:float
    var stable_order:int
    var kind:JointKind2D
    var first_body:BodyId2D
    var second_body:BodyId2D
    var first_anchor:Math.Vec2
    var second_anchor:Math.Vec2
    var local_axis:Math.Vec2
    var linear_target:Math.Vec2
    var reference_angle:float
    var scalar_target:float
    var minimum:float
    var maximum:float
    var constraint_hertz:float
    var constraint_damping_ratio:float
    var spring_hertz:float
    var spring_damping_ratio:float
    var angular_hertz:float
    var angular_damping_ratio:float
    var motor_speed:float
    var maximum_motor_force:float
    var maximum_motor_torque:float
    var correction_factor:float
    var spring_enabled:bool
    var limit_enabled:bool
    var motor_enabled:bool
    var collide_connected:bool
    var perpendicular_impulse:float
    var linear_impulse:Math.Vec2
    var axial_impulse:float
    var angular_impulse:float
    var motor_impulse:float
    var lower_impulse:float
    var upper_impulse:float
    var current_translation:float
    var current_speed:float
    var current_angle:float
    var reaction_force:Math.Vec2
    var reaction_torque:float
    var current_motor_force:float
    var current_motor_torque:float

    init(kind:JointKind2D, first_body:BodyId2D, second_body:BodyId2D) {
        self.application_id = null
        self.prepared_first_radius = Math.Vec2()
        self.prepared_second_radius = Math.Vec2()
        self.prepared_axis = Math.Vec2(1.0, 0.0)
        self.prepared_center_delta = Math.Vec2()
        self.prepared_relative_angle = 0.0
        self.prepared_spring = JointSoftness2D(0.0, 0.0, 0.0)
        self.prepared_angular = JointSoftness2D(0.0, 0.0, 0.0)
        self.prepared_axial_mass = 0.0
        self.prepared_perpendicular_mass = 0.0
        self.constraint_bias_rate = 0.0
        self.constraint_mass_scale = 0.0
        self.constraint_impulse_scale = 0.0
        self.stable_order = -1
        self.kind = kind
        self.first_body = first_body
        self.second_body = second_body
        self.first_anchor = Math.Vec2()
        self.second_anchor = Math.Vec2()
        self.local_axis = Math.Vec2(1.0, 0.0)
        self.linear_target = Math.Vec2()
        self.reference_angle = 0.0
        self.scalar_target = 0.0
        self.minimum = 0.0
        self.maximum = 0.0
        self.constraint_hertz = 60.0
        self.constraint_damping_ratio = 2.0
        self.spring_hertz = 0.0
        self.spring_damping_ratio = 0.0
        self.angular_hertz = 0.0
        self.angular_damping_ratio = 0.0
        self.motor_speed = 0.0
        self.maximum_motor_force = 0.0
        self.maximum_motor_torque = 0.0
        self.correction_factor = 0.3
        self.spring_enabled = false
        self.limit_enabled = false
        self.motor_enabled = false
        self.collide_connected = false
        self.perpendicular_impulse = 0.0
        self.linear_impulse = Math.Vec2()
        self.axial_impulse = 0.0
        self.angular_impulse = 0.0
        self.motor_impulse = 0.0
        self.lower_impulse = 0.0
        self.upper_impulse = 0.0
        self.current_translation = 0.0
        self.current_speed = 0.0
        self.current_angle = 0.0
        self.reaction_force = Math.Vec2()
        self.reaction_torque = 0.0
        self.current_motor_force = 0.0
        self.current_motor_torque = 0.0
    }
}

package class JointStore2D {
    var bodies:BodyStore2D
    var next_stable_order:int
    var slot_generations:int[]
    var slot_dense_indices:int[]
    var dense_slots:int[]
    var free_slots:int[]
    var joints:JointConstraint2D[]
    var colored_entries:int[]
    var color_counts:int[]
    var color_offsets:int[]
    var entry_colors:int[]

    init() {
        self.bodies = BodyStore2D()
        self.next_stable_order = 0
        self.slot_generations = []
        self.slot_dense_indices = []
        self.dense_slots = []
        self.free_slots = []
        self.joints = []
        self.colored_entries = []
        self.color_counts = []
        self.color_offsets = []
        self.entry_colors = []
    }

    init(bodies:BodyStore2D) {
        self.bodies = bodies
        self.next_stable_order = 0
        self.slot_generations = []
        self.slot_dense_indices = []
        self.dense_slots = []
        self.free_slots = []
        self.joints = []
        self.colored_entries = []
        self.color_counts = []
        self.color_offsets = []
        self.entry_colors = []
    }

    func count() int { return self.joints.count() }

    func clear_solver_impulses() {
        var index = 0
        while index < self.joints.count() {
            self.joints[index].perpendicular_impulse = 0.0
            self.joints[index].linear_impulse = Math.Vec2()
            self.joints[index].axial_impulse = 0.0
            self.joints[index].angular_impulse = 0.0
            self.joints[index].motor_impulse = 0.0
            self.joints[index].lower_impulse = 0.0
            self.joints[index].upper_impulse = 0.0
            index++
        }
    }

    func joint_at(index:int) Joint2D {
        let id = JointId2D(
            self.dense_slots[index],
            self.slot_generations[self.dense_slots[index]]
        )
        let kind = self.joints[index].kind
        if kind == JointKind2D.distance {
            return Joint2D.distance(DistanceJoint2D(self, id))
        }
        if kind == JointKind2D.filter {
            return Joint2D.filter(FilterJoint2D(self, id))
        }
        if kind == JointKind2D.motor {
            return Joint2D.motor(MotorJoint2D(self, id))
        }
        if kind == JointKind2D.mouse {
            return Joint2D.mouse(MouseJoint2D(self, id))
        }
        if kind == JointKind2D.prismatic {
            return Joint2D.prismatic(PrismaticJoint2D(self, id))
        }
        if kind == JointKind2D.revolute {
            return Joint2D.revolute(RevoluteJoint2D(self, id))
        }
        if kind == JointKind2D.weld {
            return Joint2D.weld(WeldJoint2D(self, id))
        }
        return Joint2D.wheel(WheelJoint2D(self, id))
    }

    func write_all(output:&Joint2D[]) {
        output.clear()
        var previous = -1
        while output.count() < self.joints.count() {
            var selected = -1
            var index = 0
            while index < self.joints.count() {
                let order = self.joints[index].stable_order
                if order > previous &&
                    (selected < 0 || order < self.joints[selected].stable_order)
                {
                    selected = index
                }
                index++
            }
            output.append(self.joint_at(selected))
            previous = self.joints[selected].stable_order
        }
    }

    func write_attached(body:BodyId2D, output:&Joint2D[]) {
        self.bodies.require(body)
        output.clear()
        var previous = -1
        while true {
            var selected = -1
            var index = 0
            while index < self.joints.count() {
                let joint = self.joints[index]
                let attached = joint.first_body.slot == body.slot ||
                    joint.second_body.slot == body.slot
                if attached && joint.stable_order > previous &&
                    (selected < 0 || joint.stable_order <
                        self.joints[selected].stable_order)
                {
                    selected = index
                }
                index++
            }
            if selected < 0 { return }
            output.append(self.joint_at(selected))
            previous = self.joints[selected].stable_order
        }
    }

    func append(joint:JointConstraint2D) JointId2D {
        var slot = self.slot_generations.count()
        if !self.free_slots.is_empty() {
            slot = self.free_slots.take_last()
        } else {
            self.slot_generations.append(1)
            self.slot_dense_indices.append(-1)
        }
        self.slot_dense_indices[slot] = self.joints.count()
        self.dense_slots.append(slot)
        var stored = joint
        stored.stable_order = self.next_stable_order
        self.next_stable_order++
        self.joints.append(stored)
        return JointId2D(slot, self.slot_generations[slot])
    }

    func contains(id:JointId2D) bool {
        return id.slot >= 0 && id.slot < self.slot_generations.count() &&
            self.slot_generations[id.slot] == id.generation &&
            self.slot_dense_indices[id.slot] >= 0
    }

    func require(id:JointId2D) int {
        if !self.contains(id) {
            panic("GFX.Physics joint handle no longer refers to a live joint")
        }
        return self.slot_dense_indices[id.slot]
    }

    func destroy(id:JointId2D) {
        let index = self.require(id)
        self.wake_joint(index)
        let last = self.joints.count() - 1
        if index != last {
            self.joints.swap(index, last)
            self.dense_slots.swap(index, last)
            self.slot_dense_indices[self.dense_slots[index]] = index
        }
        self.joints.take_last()
        self.dense_slots.take_last()
        self.slot_dense_indices[id.slot] = -1
        self.slot_generations[id.slot]++
        self.free_slots.append(id.slot)
    }

    func destroy_attached(body:BodyId2D) {
        var index = self.joints.count() - 1
        while index >= 0 {
            let joint = self.joints[index]
            if joint.first_body.slot == body.slot ||
                joint.second_body.slot == body.slot
            {
                let slot = self.dense_slots[index]
                self.destroy(JointId2D(slot, self.slot_generations[slot]))
            }
            index--
        }
    }

    func collision_allowed(first:BodyId2D, second:BodyId2D) bool {
        for joint in self.joints {
            if joint.collide_connected { continue }
            let direct = joint.first_body.slot == first.slot &&
                joint.second_body.slot == second.slot
            let reverse = joint.first_body.slot == second.slot &&
                joint.second_body.slot == first.slot
            if direct || reverse { return false }
        }
        return true
    }

    func reaction_force(id:JointId2D) Math.Vec2 {
        return self.joints[self.require(id)].reaction_force
    }

    func reaction_torque(id:JointId2D) float {
        return self.joints[self.require(id)].reaction_torque
    }

    func current_translation(id:JointId2D) float {
        return self.joints[self.require(id)].current_translation
    }

    func current_speed(id:JointId2D) float {
        return self.joints[self.require(id)].current_speed
    }

    func current_angle(id:JointId2D) float {
        return self.joints[self.require(id)].current_angle
    }

    func motor_force(id:JointId2D) float {
        return self.joints[self.require(id)].current_motor_force
    }

    func motor_torque(id:JointId2D) float {
        return self.joints[self.require(id)].current_motor_torque
    }

    func kind(id:JointId2D) JointKind2D {
        return self.joints[self.require(id)].kind
    }

    func application_id(id:JointId2D) uint64? {
        return self.joints[self.require(id)].application_id
    }

    func set_application_id(id:JointId2D, value:uint64?) {
        self.bodies.require_mutable()
        self.joints[self.require(id)].application_id = value
    }

    func first_body_handle(id:JointId2D) RigidBody2D {
        return RigidBody2D(self.bodies, self.first_body(id))
    }

    func second_body_handle(id:JointId2D) RigidBody2D {
        return RigidBody2D(self.bodies, self.second_body(id))
    }

    func first_anchor(id:JointId2D) Math.Vec2 {
        return self.joints[self.require(id)].first_anchor
    }

    func second_anchor(id:JointId2D) Math.Vec2 {
        return self.joints[self.require(id)].second_anchor
    }

    func local_axis(id:JointId2D) Math.Vec2 {
        return self.joints[self.require(id)].local_axis
    }

    func linear_target(id:JointId2D) Math.Vec2 {
        return self.joints[self.require(id)].linear_target
    }

    func reference_angle(id:JointId2D) float {
        return self.joints[self.require(id)].reference_angle
    }

    func scalar_target(id:JointId2D) float {
        return self.joints[self.require(id)].scalar_target
    }

    func minimum(id:JointId2D) float {
        return self.joints[self.require(id)].minimum
    }

    func maximum(id:JointId2D) float {
        return self.joints[self.require(id)].maximum
    }

    func constraint_hertz(id:JointId2D) float {
        return self.joints[self.require(id)].constraint_hertz
    }

    func constraint_damping_ratio(id:JointId2D) float {
        return self.joints[self.require(id)].constraint_damping_ratio
    }

    func set_constraint_tuning(id:JointId2D, hertz:float, damping_ratio:float) {
        self.bodies.require_mutable()
        if !finite_joint_value(hertz) || !finite_joint_value(damping_ratio) ||
            hertz < 0.0 || damping_ratio < 0.0
        {
            panic("GFX.Physics joint constraint tuning is invalid")
        }
        let index = self.require(id)
        self.joints[index].constraint_hertz = hertz
        self.joints[index].constraint_damping_ratio = damping_ratio
        self.wake_joint(index)
    }

    func spring_hertz(id:JointId2D) float {
        return self.joints[self.require(id)].spring_hertz
    }

    func spring_damping_ratio(id:JointId2D) float {
        return self.joints[self.require(id)].spring_damping_ratio
    }

    func angular_hertz(id:JointId2D) float {
        return self.joints[self.require(id)].angular_hertz
    }

    func angular_damping_ratio(id:JointId2D) float {
        return self.joints[self.require(id)].angular_damping_ratio
    }

    func motor_speed(id:JointId2D) float {
        return self.joints[self.require(id)].motor_speed
    }

    func maximum_motor_force(id:JointId2D) float {
        return self.joints[self.require(id)].maximum_motor_force
    }

    func maximum_motor_torque(id:JointId2D) float {
        return self.joints[self.require(id)].maximum_motor_torque
    }

    func correction_factor(id:JointId2D) float {
        return self.joints[self.require(id)].correction_factor
    }

    func spring_enabled(id:JointId2D) bool {
        return self.joints[self.require(id)].spring_enabled
    }

    func limit_enabled(id:JointId2D) bool {
        return self.joints[self.require(id)].limit_enabled
    }

    func motor_enabled(id:JointId2D) bool {
        return self.joints[self.require(id)].motor_enabled
    }

    func collide_connected(id:JointId2D) bool {
        return self.joints[self.require(id)].collide_connected
    }

    func separation(id:JointId2D) Math.Vec2 {
        let index = self.require(id)
        let joint = self.joints[index]
        let first = self.bodies.require(joint.first_body)
        let first_point = joint_world_point(
            self.bodies,
            first,
            joint.first_anchor
        )
        if joint.kind == JointKind2D.mouse {
            return joint.linear_target.subtract(first_point)
        }
        let second = self.bodies.require(joint.second_body)
        return joint_world_point(
            self.bodies,
            second,
            joint.second_anchor
        ).subtract(first_point)
    }

    func angular_separation(id:JointId2D) float {
        let joint = self.joints[self.require(id)]
        let first = self.bodies.require(joint.first_body)
        let second = self.bodies.require(joint.second_body)
        return self.bodies.rotations[second] -
            self.bodies.rotations[first] - joint.reference_angle
    }

    func set_target(id:JointId2D, target:Math.Vec2) {
        self.bodies.require_mutable()
        if !finite_joint_vector(target) {
            panic("GFX.Physics joint target must be finite")
        }
        let index = self.require(id)
        self.joints[index].linear_target = target
        self.wake_joint(index)
    }

    func set_motor(id:JointId2D, speed:float, maximum:float) {
        self.bodies.require_mutable()
        if !finite_joint_value(speed) || !finite_joint_value(maximum) ||
            maximum < 0.0
        {
            panic("GFX.Physics joint motor settings are invalid")
        }
        let index = self.require(id)
        self.joints[index].motor_speed = speed
        if self.joints[index].kind == JointKind2D.revolute ||
            self.joints[index].kind == JointKind2D.wheel
        {
            self.joints[index].maximum_motor_torque = maximum
        } else {
            self.joints[index].maximum_motor_force = maximum
        }
        self.joints[index].motor_enabled = maximum > 0.0
        self.wake_joint(index)
    }

    func set_motor_enabled(id:JointId2D, enabled:bool) {
        self.bodies.require_mutable()
        let index = self.require(id)
        self.joints[index].motor_enabled = enabled
        self.joints[index].motor_impulse = 0.0
        self.wake_joint(index)
    }

    func set_collide_connected(id:JointId2D, enabled:bool) {
        self.bodies.require_mutable()
        let index = self.require(id)
        if self.joints[index].kind == JointKind2D.filter && enabled {
            panic("GFX.Physics filter joints cannot enable connected collision")
        }
        self.joints[index].collide_connected = enabled
        let first = self.bodies.require(self.joints[index].first_body)
        let second = self.bodies.require(self.joints[index].second_body)
        self.bodies.dirty_transforms[first] = true
        self.bodies.dirty_transforms[second] = true
        self.wake_joint(index)
    }

    func set_local_anchors(
        id:JointId2D,
        first:Math.Vec2,
        second:Math.Vec2
    ) {
        self.bodies.require_mutable()
        if !finite_joint_vector(first) || !finite_joint_vector(second) {
            panic("GFX.Physics joint anchors must be finite")
        }
        let index = self.require(id)
        self.joints[index].first_anchor = first
        self.joints[index].second_anchor = second
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_local_axis(id:JointId2D, axis:Math.Vec2) {
        self.bodies.require_mutable()
        if !finite_joint_vector(axis) || axis.length() <= 0.000001 {
            panic("GFX.Physics joint axis must be finite and non-zero")
        }
        let index = self.require(id)
        self.joints[index].local_axis = axis.multiply(1.0 / axis.length())
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_scalar_target(id:JointId2D, target:float) {
        self.bodies.require_mutable()
        if !finite_joint_value(target) {
            panic("GFX.Physics joint scalar target must be finite")
        }
        let index = self.require(id)
        self.joints[index].scalar_target = target
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_reference_angle(id:JointId2D, angle:float) {
        self.bodies.require_mutable()
        if !finite_joint_value(angle) {
            panic("GFX.Physics joint reference angle must be finite")
        }
        let index = self.require(id)
        self.joints[index].reference_angle = angle
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_limits(id:JointId2D, enabled:bool, minimum:float, maximum:float) {
        self.bodies.require_mutable()
        if !finite_joint_value(minimum) || !finite_joint_value(maximum) ||
            minimum > maximum
        {
            panic("GFX.Physics joint limits are invalid")
        }
        let index = self.require(id)
        self.joints[index].minimum = minimum
        self.joints[index].maximum = maximum
        self.joints[index].limit_enabled = enabled
        self.joints[index].lower_impulse = 0.0
        self.joints[index].upper_impulse = 0.0
        self.wake_joint(index)
    }

    func set_spring(
        id:JointId2D,
        enabled:bool,
        hertz:float,
        damping_ratio:float
    ) {
        self.bodies.require_mutable()
        if !finite_joint_value(hertz) || !finite_joint_value(damping_ratio) ||
            hertz < 0.0 || damping_ratio < 0.0
        {
            panic("GFX.Physics joint spring settings are invalid")
        }
        let index = self.require(id)
        self.joints[index].spring_enabled = enabled
        self.joints[index].spring_hertz = hertz
        self.joints[index].spring_damping_ratio = damping_ratio
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_angular_spring(
        id:JointId2D,
        hertz:float,
        damping_ratio:float
    ) {
        self.bodies.require_mutable()
        if !finite_joint_value(hertz) || !finite_joint_value(damping_ratio) ||
            hertz < 0.0 || damping_ratio < 0.0
        {
            panic("GFX.Physics joint angular spring settings are invalid")
        }
        let index = self.require(id)
        self.joints[index].angular_hertz = hertz
        self.joints[index].angular_damping_ratio = damping_ratio
        self.joints[index].spring_enabled = hertz > 0.0 ||
            self.joints[index].spring_hertz > 0.0
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_motor_offsets(
        id:JointId2D,
        linear:Math.Vec2,
        angular:float
    ) {
        self.bodies.require_mutable()
        if !finite_joint_vector(linear) || !finite_joint_value(angular) {
            panic("GFX.Physics motor joint offsets must be finite")
        }
        let index = self.require(id)
        self.joints[index].linear_target = linear
        self.joints[index].reference_angle = angular
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_motor_maxima(id:JointId2D, force:float, torque:float) {
        self.bodies.require_mutable()
        if !finite_joint_value(force) || !finite_joint_value(torque) ||
            force < 0.0 || torque < 0.0
        {
            panic("GFX.Physics motor joint maxima are invalid")
        }
        let index = self.require(id)
        self.joints[index].maximum_motor_force = force
        self.joints[index].maximum_motor_torque = torque
        self.reset_impulses(index)
        self.wake_joint(index)
    }

    func set_correction_factor(id:JointId2D, factor:float) {
        self.bodies.require_mutable()
        if !finite_joint_value(factor) || factor < 0.0 || factor > 1.0 {
            panic("GFX.Physics motor joint correction factor must be in [0, 1]")
        }
        let index = self.require(id)
        self.joints[index].correction_factor = factor
        self.wake_joint(index)
    }

    func wake(id:JointId2D) {
        self.bodies.require_mutable()
        self.wake_joint(self.require(id))
    }

    func reset_impulses(index:int) {
        self.joints[index].perpendicular_impulse = 0.0
        self.joints[index].linear_impulse = Math.Vec2()
        self.joints[index].axial_impulse = 0.0
        self.joints[index].angular_impulse = 0.0
        self.joints[index].motor_impulse = 0.0
        self.joints[index].lower_impulse = 0.0
        self.joints[index].upper_impulse = 0.0
    }

    func first_body(id:JointId2D) BodyId2D {
        return self.joints[self.require(id)].first_body
    }

    func second_body(id:JointId2D) BodyId2D {
        return self.joints[self.require(id)].second_body
    }

    func wake_joint(index:int) {
        let joint = self.joints[index]
        if self.bodies.contains(joint.first_body) {
            self.bodies.wake(self.bodies.require(joint.first_body))
        }
        if self.bodies.contains(joint.second_body) {
            self.bodies.wake(self.bodies.require(joint.second_body))
        }
    }

    func propagate_wake() {
        var changed = true
        while changed {
            changed = false
            var index = 0
            while index < self.joints.count() {
                let joint = self.joints[index]
                if joint.kind == JointKind2D.filter ||
                    joint.first_body.slot == joint.second_body.slot
                {
                    index++
                    continue
                }
                let first = self.bodies.require(joint.first_body)
                let second = self.bodies.require(joint.second_body)
                if !self.bodies.enabled[first] || !self.bodies.enabled[second] {
                    index++
                    continue
                }
                if self.bodies.awake[first] &&
                    self.bodies.inverse_masses[second] > 0.0 &&
                    !self.bodies.awake[second]
                {
                    self.bodies.wake(second)
                    changed = true
                } else if self.bodies.awake[second] &&
                    self.bodies.inverse_masses[first] > 0.0 &&
                    !self.bodies.awake[first]
                {
                    self.bodies.wake(first)
                    changed = true
                }
                index++
            }
        }
    }

    func build_colors(body_masks:&uint32[]) {
        self.colored_entries.clear()
        self.color_counts.clear()
        self.color_offsets.clear()
        self.entry_colors.clear()
        var color = 0
        while color < 12 {
            self.color_counts.append(0)
            self.color_offsets.append(0)
            color++
        }
        self.color_offsets.append(0)

        var index = 0
        while index < self.joints.count() {
            let joint = self.joints[index]
            if joint.kind == JointKind2D.filter {
                self.entry_colors.append(-1)
                index++
                continue
            }
            let first = self.bodies.require(joint.first_body)
            let second = self.bodies.require(joint.second_body)
            if !self.bodies.enabled[first] || !self.bodies.enabled[second] {
                self.clear_impulses(index)
                self.entry_colors.append(-1)
                index++
                continue
            }
            var first_mask:uint32 = 0
            var second_mask:uint32 = 0
            if self.bodies.inverse_masses[first] > 0.0 &&
                self.bodies.awake[first]
            {
                first_mask = body_masks[first]
            }
            if second != first && self.bodies.inverse_masses[second] > 0.0 &&
                self.bodies.awake[second]
            {
                second_mask = body_masks[second]
            }
            color = 0
            var bit:uint32 = 1
            while color < 11 &&
                ((first_mask & bit) != 0 || (second_mask & bit) != 0)
            {
                color++
                bit = bit * 2
            }
            if color >= 11 { color = 11 }
            self.entry_colors.append(color)
            self.color_counts[color]++
            if color < 11 {
                if self.bodies.inverse_masses[first] > 0.0 &&
                    self.bodies.awake[first]
                {
                    body_masks[first] = body_masks[first] + bit
                }
                if second != first && self.bodies.inverse_masses[second] > 0.0 &&
                    self.bodies.awake[second]
                {
                    body_masks[second] = body_masks[second] + bit
                }
            }
            index++
        }

        var offset = 0
        color = 0
        while color < 12 {
            self.color_offsets[color] = offset
            offset += self.color_counts[color]
            color++
        }
        self.color_offsets[12] = offset
        if offset == 0 { return }
        index = 0
        while index < offset {
            self.colored_entries.append(0)
            index++
        }
        var cursors:int[] = []
        color = 0
        while color < 12 {
            cursors.append(self.color_offsets[color])
            color++
        }
        index = 0
        while index < self.joints.count() {
            color = self.entry_colors[index]
            if color >= 0 {
                self.colored_entries[cursors[color]] = index
                cursors[color]++
            }
            index++
        }
    }

    private func clear_impulses(index:int) {
        var joint = self.joints[index]
        joint.perpendicular_impulse = 0.0
        joint.linear_impulse = Math.Vec2()
        joint.axial_impulse = 0.0
        joint.angular_impulse = 0.0
        joint.motor_impulse = 0.0
        joint.lower_impulse = 0.0
        joint.upper_impulse = 0.0
        joint.reaction_force = Math.Vec2()
        joint.reaction_torque = 0.0
        joint.current_motor_force = 0.0
        joint.current_motor_torque = 0.0
        self.joints[index] = joint
    }

    func color_count(color:int) int { return self.color_counts[color] }
    func color_offset(color:int) int { return self.color_offsets[color] }

    // Box2D 3.1.1 joint softness and prepared geometry; see Box2D-NOTICE.txt.
    // Coefficients depend on the substep duration and settings, not on a
    // solver pass. Prepare once per step before any parallel color dispatch.
    func prepare_constraints(delta:float, inverse_delta:float) {
        var index = 0
        while index < self.joints.count() {
            if self.joints[index].kind == JointKind2D.distance ||
                self.joints[index].kind == JointKind2D.prismatic ||
                self.joints[index].kind == JointKind2D.revolute ||
                self.joints[index].kind == JointKind2D.weld ||
                self.joints[index].kind == JointKind2D.wheel {
                let hertz = Math.min(self.joints[index].constraint_hertz,
                    0.25 * inverse_delta)
                let common = JointSoftness2D(hertz,
                    self.joints[index].constraint_damping_ratio, delta)
                self.joints[index].constraint_bias_rate = common.bias_rate
                self.joints[index].constraint_mass_scale = common.mass_scale
                self.joints[index].constraint_impulse_scale = common.impulse_scale
                self.joints[index].prepared_spring = JointSoftness2D(
                    self.joints[index].spring_hertz,
                    self.joints[index].spring_damping_ratio, delta)
                self.joints[index].prepared_angular = JointSoftness2D(
                    self.joints[index].angular_hertz,
                    self.joints[index].angular_damping_ratio, delta)
            }
            if self.joints[index].kind == JointKind2D.distance ||
                self.joints[index].kind == JointKind2D.prismatic ||
                self.joints[index].kind == JointKind2D.wheel {
                let joint = self.joints[index]
                let first = self.bodies.require(joint.first_body)
                let second = self.bodies.require(joint.second_body)
                let first_radius = joint_world_vector(self.bodies, first,
                    joint.first_anchor.subtract(Math.Vec2(self.bodies.local_centers_x[first],
                        self.bodies.local_centers_y[first])))
                let second_radius = joint_world_vector(self.bodies, second,
                    joint.second_anchor.subtract(Math.Vec2(self.bodies.local_centers_x[second],
                        self.bodies.local_centers_y[second])))
                let separation = self.bodies.world_center_at(second).subtract(
                    self.bodies.world_center_at(first)).add(second_radius.subtract(first_radius))
                var applied_first_radius = separation.add(first_radius)
                var axis = joint_world_vector(self.bodies, first, joint.local_axis)
                if joint.kind == JointKind2D.distance {
                    applied_first_radius = first_radius
                    axis = Math.Vec2()
                    if separation.length() > 0.000001 {
                        axis = separation.multiply(1.0 / separation.length())
                    }
                }
                self.joints[index].prepared_axial_mass =
                    joint_pair_mass(self.bodies, first, second,
                        applied_first_radius, second_radius, axis)
                if joint.kind == JointKind2D.wheel {
                    let perpendicular = Math.Vec2(-axis.y, axis.x)
                    self.joints[index].prepared_perpendicular_mass =
                        joint_pair_mass(self.bodies, first, second,
                            applied_first_radius, second_radius, perpendicular)
                }
            }
            if self.joints[index].kind == JointKind2D.prismatic ||
                self.joints[index].kind == JointKind2D.revolute ||
                self.joints[index].kind == JointKind2D.weld {
                let first = self.bodies.require(self.joints[index].first_body)
                let second = self.bodies.require(self.joints[index].second_body)
                self.joints[index].prepared_relative_angle = joint_solver_atan(
                    self.bodies.rotation_sines[second] * self.bodies.rotation_cosines[first] -
                        self.bodies.rotation_cosines[second] * self.bodies.rotation_sines[first],
                    self.bodies.rotation_cosines[second] * self.bodies.rotation_cosines[first] +
                        self.bodies.rotation_sines[second] * self.bodies.rotation_sines[first])
            }
            let first = self.bodies.require(self.joints[index].first_body)
            let second = self.bodies.require(self.joints[index].second_body)
            self.joints[index].prepared_first_radius = joint_world_vector(self.bodies, first,
                self.joints[index].first_anchor.subtract(Math.Vec2(
                    self.bodies.local_centers_x[first], self.bodies.local_centers_y[first])))
            self.joints[index].prepared_second_radius = joint_world_vector(self.bodies, second,
                self.joints[index].second_anchor.subtract(Math.Vec2(
                    self.bodies.local_centers_x[second], self.bodies.local_centers_y[second])))
            self.joints[index].prepared_axis = joint_world_vector(
                self.bodies, first, self.joints[index].local_axis)
            self.joints[index].prepared_center_delta =
                self.bodies.world_center_at(second).subtract(self.bodies.world_center_at(first))
            index++
        }
    }

    func finish_step(inverse_delta:float) {
        var index = 0
        while index < self.joints.count() {
            var joint = self.joints[index]
            var axis_impulse = joint.axial_impulse
            // Box2D 3.1.1 reports prismatic/revolute reactions without their
            // spring impulse; distance, wheel and weld include it.
            if joint.kind == JointKind2D.prismatic { axis_impulse = 0.0 }
            if joint.kind != JointKind2D.revolute {
                axis_impulse += joint.lower_impulse - joint.upper_impulse
            }
            if joint.kind == JointKind2D.distance ||
                joint.kind == JointKind2D.prismatic
            {
                axis_impulse += joint.motor_impulse
            }
            var axis = joint_world_vector(
                self.bodies,
                self.bodies.require(joint.first_body),
                joint.local_axis
            )
            if joint.kind == JointKind2D.wheel { axis = joint.prepared_axis }
            if joint.kind == JointKind2D.distance {
                let first = self.bodies.require(joint.first_body)
                let second = self.bodies.require(joint.second_body)
                let delta = joint_world_point(
                    self.bodies,
                    second,
                    joint.second_anchor
                ).subtract(joint_world_point(
                    self.bodies,
                    first,
                    joint.first_anchor
                ))
                if delta.length() > 0.000001 {
                    axis = delta.multiply(1.0 / delta.length())
                }
            }
            var linear_impulse = joint.linear_impulse
            if joint.kind == JointKind2D.prismatic || joint.kind == JointKind2D.wheel {
                linear_impulse = Math.Vec2(-axis.y, axis.x).multiply(joint.perpendicular_impulse)
            }
            joint.reaction_force = linear_impulse.add(
                axis.multiply(axis_impulse)
            ).multiply(inverse_delta)
            var torque_impulse = joint.angular_impulse + 0.0
            if joint.kind == JointKind2D.revolute {
                torque_impulse = joint.lower_impulse - joint.upper_impulse
            }
            if joint.kind == JointKind2D.revolute ||
                joint.kind == JointKind2D.wheel
            {
                torque_impulse += joint.motor_impulse
            }
            joint.reaction_torque = torque_impulse * inverse_delta
            joint.current_motor_force = 0.0
            joint.current_motor_torque = 0.0
            if joint.kind == JointKind2D.distance ||
                joint.kind == JointKind2D.prismatic
            {
                joint.current_motor_force = joint.motor_impulse * inverse_delta
            }
            if joint.kind == JointKind2D.revolute ||
                joint.kind == JointKind2D.wheel
            {
                joint.current_motor_torque = joint.motor_impulse * inverse_delta
            }
            self.joints[index] = joint
            index++
        }
    }
}

struct WarmStartJoints2D:Threading.ParallelJob {
    var bodies:BodyStore2D
    var joints:JointStore2D
    var offset:int
    var count:int
    var reverse:bool

    func execute(start:int, end:int) {
        var item = start
        while item < end {
            var source = self.offset + item
            if self.reverse {
                source = self.offset + self.count - item - 1
            }
            let joint_index = self.joints.colored_entries[source]
            warm_start_joint(self.bodies, self.joints.joints[joint_index])
            item++
        }
    }
}

struct SolveJoints2D:Threading.ParallelJob {
    var bodies:BodyStore2D
    var joints:JointStore2D
    var offset:int
    var count:int
    var reverse:bool
    var inverse_delta:float
    var use_bias:bool

    func execute(start:int, end:int) {
        var item = start
        while item < end {
            var source = self.offset + item
            if self.reverse {
                source = self.offset + self.count - item - 1
            }
            let joint_index = self.joints.colored_entries[source]
            var joint = self.joints.joints[joint_index]
            solve_joint(
                self.bodies,
                joint,
                self.inverse_delta,
                self.use_bias
            )
            self.joints.joints[joint_index] = joint
            item++
        }
    }
}

func joint_world_point(
    bodies:BodyStore2D,
    index:int,
    local_value:Math.Vec2
) Math.Vec2 {
    let cosine = bodies.rotation_cosines[index]
    let sine = bodies.rotation_sines[index]
    return Math.Vec2(
        bodies.positions_x[index] + cosine * local_value.x -
            sine * local_value.y,
        bodies.positions_y[index] + sine * local_value.x +
            cosine * local_value.y
    )
}

func joint_world_vector(
    bodies:BodyStore2D,
    index:int,
    local_value:Math.Vec2
) Math.Vec2 {
    let cosine = bodies.rotation_cosines[index]
    let sine = bodies.rotation_sines[index]
    return Math.Vec2(
        cosine * local_value.x - sine * local_value.y,
        sine * local_value.x + cosine * local_value.y
    )
}

func joint_velocity_at(
    bodies:BodyStore2D,
    index:int,
    point:Math.Vec2
) Math.Vec2 {
    let center = bodies.world_center_at(index)
    let radius_x = point.x - center.x
    let radius_y = point.y - center.y
    return Math.Vec2(
        bodies.velocities_x[index] -
            bodies.angular_velocities[index] * radius_y,
        bodies.velocities_y[index] +
            bodies.angular_velocities[index] * radius_x
    )
}

func joint_cross(left:Math.Vec2, right:Math.Vec2) float {
    return left.x * right.y - left.y * right.x
}

func joint_inverse_mass_on_axis(
    bodies:BodyStore2D,
    index:int,
    point:Math.Vec2,
    axis:Math.Vec2
) float {
    if !bodies.awake[index] { return 0.0 }
    let radius = point.subtract(bodies.world_center_at(index))
    let arm = joint_cross(radius, axis)
    return bodies.inverse_masses[index] +
        arm * arm * bodies.inverse_inertias[index]
}

func apply_joint_impulse(
    bodies:BodyStore2D,
    index:int,
    impulse:Math.Vec2,
    point:Math.Vec2
) {
    if !bodies.awake[index] { return }
    bodies.velocities_x[index] += impulse.x * bodies.inverse_masses[index]
    bodies.velocities_y[index] += impulse.y * bodies.inverse_masses[index]
    let center = bodies.world_center_at(index)
    let radius_x = point.x - center.x
    let radius_y = point.y - center.y
    bodies.angular_velocities[index] +=
        (radius_x * impulse.y - radius_y * impulse.x) *
        bodies.inverse_inertias[index]
}

func joint_velocity_on_radius(bodies:BodyStore2D, index:int, radius:Math.Vec2) Math.Vec2 {
    return Math.Vec2(bodies.velocities_x[index] - bodies.angular_velocities[index] * radius.y,
        bodies.velocities_y[index] + bodies.angular_velocities[index] * radius.x)
}

func joint_pair_mass(bodies:BodyStore2D, first:int, second:int,
    first_radius:Math.Vec2, second_radius:Math.Vec2, axis:Math.Vec2) float {
    var mass = 0.0
    var first_inertia = 0.0
    var second_inertia = 0.0
    if bodies.awake[first] {
        mass += bodies.inverse_masses[first]
        first_inertia = bodies.inverse_inertias[first]
    }
    if bodies.awake[second] {
        mass += bodies.inverse_masses[second]
        second_inertia = bodies.inverse_inertias[second]
    }
    let first_arm = joint_cross(first_radius, axis)
    let second_arm = joint_cross(second_radius, axis)
    let inverse_mass = mass + first_inertia * first_arm * first_arm +
        second_inertia * second_arm * second_arm
    if inverse_mass <= 0.0 { return 0.0 }
    return 1.0 / inverse_mass
}

func apply_joint_radius_impulse(bodies:BodyStore2D, index:int,
    impulse:Math.Vec2, radius:Math.Vec2) {
    if !bodies.awake[index] { return }
    bodies.velocities_x[index] += impulse.x * bodies.inverse_masses[index]
    bodies.velocities_y[index] += impulse.y * bodies.inverse_masses[index]
    bodies.angular_velocities[index] += joint_cross(radius, impulse) * bodies.inverse_inertias[index]
}

func apply_joint_generalized_impulse(bodies:BodyStore2D, first:int, second:int,
    impulse:Math.Vec2, first_torque:float, second_torque:float) {
    if bodies.awake[first] {
        bodies.velocities_x[first] -= bodies.inverse_masses[first] * impulse.x
        bodies.velocities_y[first] -= bodies.inverse_masses[first] * impulse.y
        bodies.angular_velocities[first] -= bodies.inverse_inertias[first] * first_torque
    }
    if bodies.awake[second] {
        bodies.velocities_x[second] += bodies.inverse_masses[second] * impulse.x
        bodies.velocities_y[second] += bodies.inverse_masses[second] * impulse.y
        bodies.angular_velocities[second] += bodies.inverse_inertias[second] * second_torque
    }
}

func apply_joint_pair_impulse(
    bodies:BodyStore2D,
    first:int,
    second:int,
    impulse:Math.Vec2,
    first_point:Math.Vec2,
    second_point:Math.Vec2
) {
    apply_joint_radius_impulse(bodies, first, impulse.negated(), first_point)
    apply_joint_radius_impulse(bodies, second, impulse, second_point)
}

func clamped_joint_vector(value:Math.Vec2, maximum:float) Math.Vec2 {
    if maximum < 0.0 { return value }
    let length = value.length()
    if length <= maximum || length <= 0.000001 { return value }
    return value.multiply(maximum / length)
}

func joint_bias_rate(
    hertz:float,
    damping_ratio:float,
    inverse_delta:float,
    use_bias:bool
) float {
    if hertz > 0.0 {
        let omega = 2.0 * Math.pi() * hertz
        let damping_scale = 1.0 +
            2.0 * damping_ratio * omega / inverse_delta
        return Math.min(0.5 * inverse_delta, omega) / damping_scale
    }
    if use_bias { return 0.2 * inverse_delta }
    return 0.0
}

// Coupled point and prismatic constraints: Box2D 3.1.1 b2Solve22.
// Box2D's deterministic atan approximation defines its angular constraints.
// Keep public rotations in radians; only the solver uses this approximation.
func joint_solver_atan(y:float, x:float) float {
    let ax = Math.abs(x)
    let ay = Math.abs(y)
    let a = Math.min(ax, ay) / Math.max(ax, ay)
    let square = a * a
    let cube = square * a
    let fourth = square * square
    var result = 0.024840285 * fourth + 0.18681418
    let t = -0.094097948 * fourth - 0.33213072
    result = result * square + t
    result = result * cube + a
    if ay > ax { result = 1.57079637 - result }
    if x < 0.0 { result = 3.14159274 - result }
    if y < 0.0 { result = -result }
    return result
}

func unwind_joint_angle(radians:float) float {
    var result = Math.remainder(radians, 2.0 * Math.pi())
    if result < -Math.pi() { result += 2.0 * Math.pi() }
    if result > Math.pi() { result -= 2.0 * Math.pi() }
    return result
}

func solve_joint_matrix(xx:float, xy:float, yy:float, value:Math.Vec2) Math.Vec2 {
    let determinant = xx * yy - xy * xy
    if determinant == 0.0 { return Math.Vec2() }
    let inverse = 1.0 / determinant
    return Math.Vec2(inverse * (yy * value.x - xy * value.y),
        inverse * (xx * value.y - xy * value.x))
}

func solve_joint_point_pair(
    bodies:BodyStore2D,
    joint:&JointConstraint2D,
    first:int,
    second:int,
    target:Math.Vec2,
    hertz:float,
    damping_ratio:float,
    maximum_impulse:float,
    inverse_delta:float,
    use_bias:bool,
    prepared_bias_rate:float = -1.0,
    mass_scale:float = 1.0,
    impulse_scale:float = 0.0
) {
    let first_point = joint_step_vector(bodies, first, joint.prepared_first_radius)
    let second_point = joint_step_vector(bodies, second, joint.prepared_second_radius)
    let error = joint_anchor_separation(bodies, joint, first, second).subtract(target)
    let relative_velocity = joint_velocity_on_radius(
        bodies,
        second,
        second_point
    ).subtract(joint_velocity_on_radius(bodies, first, first_point))
    var bias_rate = prepared_bias_rate
    if bias_rate < 0.0 {
        bias_rate = joint_bias_rate(hertz, damping_ratio, inverse_delta, use_bias)
    }
    let first_radius = first_point
    let second_radius = second_point
    var first_mass = 0.0
    var second_mass = 0.0
    var first_inertia = 0.0
    var second_inertia = 0.0
    if bodies.awake[first] {
        first_mass = bodies.inverse_masses[first]
        first_inertia = bodies.inverse_inertias[first]
    }
    if bodies.awake[second] {
        second_mass = bodies.inverse_masses[second]
        second_inertia = bodies.inverse_inertias[second]
    }
    let mass = first_mass + second_mass
    let xx = mass + first_inertia * first_radius.y * first_radius.y +
        second_inertia * second_radius.y * second_radius.y
    let xy = -first_inertia * first_radius.x * first_radius.y -
        second_inertia * second_radius.x * second_radius.y
    let yy = mass + first_inertia * first_radius.x * first_radius.x +
        second_inertia * second_radius.x * second_radius.x
    let correction = solve_joint_matrix(xx, xy, yy,
        relative_velocity.add(error.multiply(bias_rate)))
    let increment = correction.multiply(-mass_scale).subtract(
        joint.linear_impulse.multiply(impulse_scale))
    let previous = Math.Vec2(
        joint.linear_impulse.x + 0.0,
        joint.linear_impulse.y + 0.0
    )
    joint.linear_impulse = clamped_joint_vector(
        previous.add(increment),
        maximum_impulse
    )
    var applied = increment
    if maximum_impulse >= 0.0 { applied = joint.linear_impulse.subtract(previous) }
    apply_joint_pair_impulse(
        bodies,
        first,
        second,
        applied,
        first_point,
        second_point
    )
}

func solve_joint_point_target(
    bodies:BodyStore2D,
    joint:&JointConstraint2D,
    body:int,
    maximum_impulse:float,
    inverse_delta:float,
    use_bias:bool
) {
    let point = joint_world_point(bodies, body, joint.first_anchor)
    let error = point.subtract(joint.linear_target)
    let velocity = joint_velocity_at(bodies, body, point)
    let bias_rate = joint_bias_rate(
        joint.spring_hertz,
        joint.spring_damping_ratio,
        inverse_delta,
        use_bias
    )
    let x_axis = Math.Vec2(1.0, 0.0)
    let y_axis = Math.Vec2(0.0, 1.0)
    let x_inverse_mass = joint_inverse_mass_on_axis(
        bodies,
        body,
        point,
        x_axis
    )
    let y_inverse_mass = joint_inverse_mass_on_axis(
        bodies,
        body,
        point,
        y_axis
    )
    var increment = Math.Vec2()
    if x_inverse_mass > 0.0 {
        increment.x = -(velocity.x + bias_rate * error.x) / x_inverse_mass
    }
    if y_inverse_mass > 0.0 {
        increment.y = -(velocity.y + bias_rate * error.y) / y_inverse_mass
    }
    let previous = Math.Vec2(
        joint.linear_impulse.x + 0.0,
        joint.linear_impulse.y + 0.0
    )
    joint.linear_impulse = clamped_joint_vector(
        previous.add(increment),
        maximum_impulse
    )
    apply_joint_impulse(
        bodies,
        body,
        joint.linear_impulse.subtract(previous),
        point
    )
}

func solve_joint_axis(
    bodies:BodyStore2D,
    first:int,
    second:int,
    first_point:Math.Vec2,
    second_point:Math.Vec2,
    axis:Math.Vec2,
    error:float,
    target_speed:float,
    previous:float,
    minimum:float?,
    maximum:float?,
    hertz:float,
    damping_ratio:float,
    inverse_delta:float,
    use_bias:bool,
    bias_rate:float = -1.0,
    mass_scale:float = 1.0,
    impulse_scale:float = 0.0,
    prepared_mass:float = -1.0
) float {
    var mass = prepared_mass
    if mass < 0.0 {
        mass = joint_pair_mass(bodies, first, second, first_point, second_point, axis)
    }
    if mass <= 0.0 { return previous }
    let linear_velocity = Math.Vec2(bodies.velocities_x[second] - bodies.velocities_x[first],
        bodies.velocities_y[second] - bodies.velocities_y[first])
    let relative_velocity = linear_velocity.dot(axis) +
        joint_cross(second_point, axis) * bodies.angular_velocities[second] -
        joint_cross(first_point, axis) * bodies.angular_velocities[first]
    var rate = bias_rate
    if rate < 0.0 {
        rate = joint_bias_rate(
            hertz,
            damping_ratio,
            inverse_delta,
            use_bias
        )
    }
    let bias = rate * error
    let increment = -mass_scale * mass *
        (relative_velocity - target_speed + bias) - impulse_scale * previous
    var accumulated = previous + increment
    var applied = increment + 0.0
    if let upper = maximum { accumulated = Math.min(accumulated, upper) }
    if let lower = minimum { accumulated = Math.max(accumulated, lower) }
    if minimum != null || maximum != null { applied = accumulated - previous }
    apply_joint_generalized_impulse(bodies, first, second, axis.multiply(applied),
        applied * joint_cross(first_point, axis), applied * joint_cross(second_point, axis))
    return accumulated
}

func solve_joint_angle(
    bodies:BodyStore2D,
    first:int,
    second:int,
    error:float,
    target_speed:float,
    previous:float,
    minimum:float?,
    maximum:float?,
    hertz:float,
    damping_ratio:float,
    inverse_delta:float,
    use_bias:bool,
    prepared_bias_rate:float = -1.0,
    mass_scale:float = 1.0,
    impulse_scale:float = 0.0
) float {
    var inverse_inertia = 0.0
    if bodies.awake[first] { inverse_inertia += bodies.inverse_inertias[first] }
    if bodies.awake[second] { inverse_inertia += bodies.inverse_inertias[second] }
    if inverse_inertia <= 0.0 { return previous }
    let relative_velocity = bodies.angular_velocities[second] -
        bodies.angular_velocities[first]
    var rate = prepared_bias_rate
    if rate < 0.0 { rate = joint_bias_rate(hertz, damping_ratio, inverse_delta, use_bias) }
    let bias = rate * error
    let increment = -mass_scale * (1.0 / inverse_inertia) *
        (relative_velocity - target_speed + bias) - impulse_scale * previous
    var accumulated = previous + increment
    var applied = increment + 0.0
    if let upper = maximum { accumulated = Math.min(accumulated, upper) }
    if let lower = minimum { accumulated = Math.max(accumulated, lower) }
    if minimum != null || maximum != null { applied = accumulated - previous }
    if bodies.awake[first] {
        bodies.angular_velocities[first] -=
            applied * bodies.inverse_inertias[first]
    }
    if bodies.awake[second] {
        bodies.angular_velocities[second] +=
            applied * bodies.inverse_inertias[second]
    }
    return accumulated
}

func warm_start_joint(bodies:BodyStore2D, joint:JointConstraint2D) {
    if joint.kind == JointKind2D.filter { return }
    let first = bodies.require(joint.first_body)
    let second = bodies.require(joint.second_body)
    if joint.kind == JointKind2D.mouse {
        apply_joint_impulse(bodies, first, joint.linear_impulse,
            joint_world_point(bodies, first, joint.first_anchor))
        return
    }
    let first_radius = joint_step_vector(bodies, first, joint.prepared_first_radius)
    let second_radius = joint_step_vector(bodies, second, joint.prepared_second_radius)
    let separation = joint_anchor_separation(bodies, joint, first, second)
    var axis = joint_step_vector(bodies, first, joint.prepared_axis)
    if joint.kind == JointKind2D.distance {
        axis = Math.Vec2()
        if separation.length() > 0.000001 { axis = separation.multiply(1.0 / separation.length()) }
    }
    var axial = joint.axial_impulse + 0.0
    if joint.kind == JointKind2D.prismatic { axial += joint.motor_impulse }
    if joint.kind != JointKind2D.revolute {
        axial += joint.lower_impulse
        axial -= joint.upper_impulse
    }
    if joint.kind == JointKind2D.distance { axial += joint.motor_impulse }
    var angular = joint.angular_impulse + 0.0
    if joint.kind == JointKind2D.revolute || joint.kind == JointKind2D.wheel {
        angular += joint.motor_impulse
    }
    if joint.kind == JointKind2D.revolute {
        angular += joint.lower_impulse
        angular -= joint.upper_impulse
    }
    var impulse = joint.linear_impulse.add(axis.multiply(axial))
    var first_torque = joint_cross(first_radius, impulse) + angular
    var second_torque = joint_cross(second_radius, impulse) + angular
    if joint.kind == JointKind2D.prismatic || joint.kind == JointKind2D.wheel {
        let perpendicular = Math.Vec2(-axis.y, axis.x)
        let applied_first_radius = separation.add(first_radius)
        impulse = axis.multiply(axial).add(perpendicular.multiply(joint.perpendicular_impulse))
        first_torque = axial * joint_cross(applied_first_radius, axis) +
            joint.perpendicular_impulse * joint_cross(applied_first_radius, perpendicular) + angular
        second_torque = axial * joint_cross(second_radius, axis) +
            joint.perpendicular_impulse * joint_cross(second_radius, perpendicular) + angular
    }
    if bodies.awake[first] {
        bodies.velocities_x[first] -= bodies.inverse_masses[first] * impulse.x
        bodies.velocities_y[first] -= bodies.inverse_masses[first] * impulse.y
        bodies.angular_velocities[first] -= bodies.inverse_inertias[first] * first_torque
    }
    if bodies.awake[second] {
        bodies.velocities_x[second] += bodies.inverse_masses[second] * impulse.x
        bodies.velocities_y[second] += bodies.inverse_masses[second] * impulse.y
        bodies.angular_velocities[second] += bodies.inverse_inertias[second] * second_torque
    }
}

// Independent unilateral limits preserve spring and motor impulses.
func solve_joint_axis_limits(bodies:BodyStore2D, joint:&JointConstraint2D,
    first:int, second:int, first_point:Math.Vec2, second_point:Math.Vec2,
    axis:Math.Vec2, translation:float, inverse_delta:float, use_bias:bool) {
    var rigid_bias = 0.0
    var rigid_mass = 1.0
    var rigid_impulse = 0.0
    if use_bias {
        rigid_bias = joint.constraint_bias_rate
        rigid_mass = joint.constraint_mass_scale
        rigid_impulse = joint.constraint_impulse_scale
    }
    let lower = translation - joint.minimum
    var lower_bias = rigid_bias
    var lower_mass = rigid_mass
    var lower_impulse = rigid_impulse
    if lower > 0.0 {
        lower_bias = inverse_delta
        lower_mass = 1.0
        lower_impulse = 0.0
    }
    joint.lower_impulse = solve_joint_axis(bodies, first, second,
        first_point, second_point, axis, lower, 0.0,
        joint.lower_impulse, 0.0, null,
        0.0, 0.0, inverse_delta, use_bias, lower_bias, lower_mass, lower_impulse,
        joint.prepared_axial_mass)
    let upper = joint.maximum - translation
    var upper_bias = rigid_bias
    var upper_mass = rigid_mass
    var upper_impulse = rigid_impulse
    if upper > 0.0 {
        upper_bias = inverse_delta
        upper_mass = 1.0
        upper_impulse = 0.0
    }
    joint.upper_impulse = solve_joint_axis(bodies, first, second,
        first_point, second_point, axis.negated(), upper, 0.0,
        joint.upper_impulse, 0.0, null,
        0.0, 0.0, inverse_delta, use_bias, upper_bias, upper_mass, upper_impulse,
        joint.prepared_axial_mass)
}

func joint_step_vector(bodies:BodyStore2D, index:int, vector:Math.Vec2) Math.Vec2 {
    let cosine = bodies.step_rotation_cosines[index]
    let sine = bodies.step_rotation_sines[index]
    return Math.Vec2(cosine * vector.x - sine * vector.y,
        sine * vector.x + cosine * vector.y)
}

func joint_step_displacement(bodies:BodyStore2D, index:int) Math.Vec2 {
    if !bodies.awake[index] { return Math.Vec2() }
    return Math.Vec2(bodies.step_displacements_x[index], bodies.step_displacements_y[index])
}

func joint_anchor_separation(bodies:BodyStore2D, joint:JointConstraint2D,
    first:int, second:int) Math.Vec2 {
    let first_radius = joint_step_vector(bodies, first, joint.prepared_first_radius)
    let second_radius = joint_step_vector(bodies, second, joint.prepared_second_radius)
    let displacement = joint_step_displacement(bodies, second).subtract(
        joint_step_displacement(bodies, first))
    if joint.kind == JointKind2D.prismatic || joint.kind == JointKind2D.wheel {
        return displacement.add(joint.prepared_center_delta).add(second_radius.subtract(first_radius))
    }
    return joint.prepared_center_delta.add(displacement.add(second_radius.subtract(first_radius)))
}

func solve_joint(
    bodies:BodyStore2D,
    joint:&JointConstraint2D,
    inverse_delta:float,
    use_bias:bool
) {
    if joint.kind == JointKind2D.filter { return }
    let first = bodies.require(joint.first_body)
    let second = bodies.require(joint.second_body)
    let delta = 1.0 / inverse_delta
    if joint.kind == JointKind2D.mouse {
        solve_joint_point_target(
            bodies,
            joint,
            first,
            joint.maximum_motor_force * delta,
            inverse_delta,
            use_bias
        )
        return
    }

    let first_point = joint_step_vector(bodies, first, joint.prepared_first_radius)
    let second_point = joint_step_vector(bodies, second, joint.prepared_second_radius)
    let anchor_delta = joint_anchor_separation(bodies, joint, first, second)

    var rigid_bias = 0.0
    var rigid_mass = 1.0
    var rigid_impulse = 0.0
    if use_bias {
        rigid_bias = joint.constraint_bias_rate
        rigid_mass = joint.constraint_mass_scale
        rigid_impulse = joint.constraint_impulse_scale
    }

    if joint.kind == JointKind2D.distance {
        var axis = Math.Vec2()
        let length = anchor_delta.length()
        if length > 0.000001 { axis = anchor_delta.multiply(1.0 / length) }
        joint.current_translation = length
        joint.current_speed = joint_velocity_on_radius(bodies, second, second_point).subtract(
            joint_velocity_on_radius(bodies, first, first_point)).dot(axis)
        if joint.spring_enabled && (joint.minimum < joint.maximum || !joint.limit_enabled) {
            if joint.spring_hertz > 0.0 {
                let next_impulse = solve_joint_axis(bodies, first, second,
                    first_point, second_point, axis, length - joint.scalar_target, 0.0,
                    joint.axial_impulse, null, null,
                    0.0, 0.0, inverse_delta, use_bias,
                    joint.prepared_spring.bias_rate, joint.prepared_spring.mass_scale, joint.prepared_spring.impulse_scale,
                    joint.prepared_axial_mass)
                joint.axial_impulse = next_impulse
            }
            if joint.limit_enabled {
                solve_joint_axis_limits(bodies, joint, first, second, first_point,
                    second_point, axis, length, inverse_delta, use_bias)
            }
            if joint.motor_enabled {
                let maximum = joint.maximum_motor_force * delta
                joint.motor_impulse = solve_joint_axis(bodies, first, second,
                    first_point, second_point, axis, 0.0, joint.motor_speed,
                    joint.motor_impulse, -maximum, maximum, 0.0, 0.0, inverse_delta,
                    false, 0.0, 1.0, 0.0, joint.prepared_axial_mass)
            }
        } else {
            joint.axial_impulse = solve_joint_axis(bodies, first, second,
                first_point, second_point, axis, length - joint.scalar_target, 0.0,
                joint.axial_impulse, null, null,
                0.0, 0.0, inverse_delta, use_bias,
                rigid_bias, rigid_mass, rigid_impulse, joint.prepared_axial_mass)
        }
        return
    }

    if joint.kind == JointKind2D.motor {
        let target = joint_world_vector(bodies, first, joint.linear_target)
        solve_joint_point_pair(
            bodies,
            joint,
            first,
            second,
            target,
            0.0,
            0.0,
            joint.maximum_motor_force * delta,
            inverse_delta * joint.correction_factor,
            true
        )
        let angular_error = bodies.rotations[second] -
            bodies.rotations[first] - joint.reference_angle
        joint.angular_impulse = solve_joint_angle(
            bodies,
            first,
            second,
            angular_error,
            0.0,
            joint.angular_impulse,
            -joint.maximum_motor_torque * delta,
            joint.maximum_motor_torque * delta,
            0.0,
            0.0,
            inverse_delta * joint.correction_factor,
            true
        )
        joint.current_angle = angular_error
        return
    }

    let angle_delta = joint_solver_atan(
        bodies.step_rotation_sines[second] * bodies.step_rotation_cosines[first] -
            bodies.step_rotation_cosines[second] * bodies.step_rotation_sines[first],
        bodies.step_rotation_cosines[second] * bodies.step_rotation_cosines[first] +
            bodies.step_rotation_sines[second] * bodies.step_rotation_sines[first])
    let relative_angle = angle_delta +
        unwind_joint_angle(joint.prepared_relative_angle - joint.reference_angle)
    joint.current_angle = relative_angle

    if joint.kind == JointKind2D.weld {
        var angular_bias = rigid_bias
        var angular_mass = rigid_mass
        var angular_impulse = rigid_impulse
        if joint.angular_hertz > 0.0 {
            angular_bias = joint.prepared_angular.bias_rate
            angular_mass = joint.prepared_angular.mass_scale
            angular_impulse = joint.prepared_angular.impulse_scale
        }
        joint.angular_impulse = solve_joint_angle(bodies, first, second,
            relative_angle, 0.0, joint.angular_impulse,
            null, null, 0.0, 0.0, inverse_delta, use_bias,
            angular_bias, angular_mass, angular_impulse)
        var point_bias = rigid_bias
        var point_mass = rigid_mass
        var point_impulse = rigid_impulse
        if joint.spring_hertz > 0.0 {
            point_bias = joint.prepared_spring.bias_rate
            point_mass = joint.prepared_spring.mass_scale
            point_impulse = joint.prepared_spring.impulse_scale
        }
        solve_joint_point_pair(bodies, joint, first, second, Math.Vec2(),
            0.0, 0.0, -1.0, inverse_delta, use_bias, point_bias, point_mass, point_impulse)
        return
    }

    if joint.kind == JointKind2D.revolute {
        if joint.spring_enabled {
            let next_impulse = solve_joint_angle(bodies, first, second,
                unwind_joint_angle(relative_angle + joint.reference_angle - joint.scalar_target), 0.0, joint.angular_impulse,
                null, null, 0.0, 0.0, inverse_delta, use_bias,
                joint.prepared_spring.bias_rate, joint.prepared_spring.mass_scale, joint.prepared_spring.impulse_scale)
            joint.angular_impulse = next_impulse
        }
        if joint.motor_enabled {
            let maximum = joint.maximum_motor_torque * delta
            joint.motor_impulse = solve_joint_angle(bodies, first, second,
                0.0, joint.motor_speed, joint.motor_impulse, -maximum, maximum,
                0.0, 0.0, inverse_delta, false, 0.0)
        }
        if joint.limit_enabled {
            let lower = relative_angle - joint.minimum
            var lower_bias = rigid_bias
            var lower_mass = rigid_mass
            var lower_impulse = rigid_impulse
            if lower > 0.0 {
                lower_bias = inverse_delta
                lower_mass = 1.0
                lower_impulse = 0.0
            }
            joint.lower_impulse = solve_joint_angle(bodies, first, second,
                lower, 0.0, joint.lower_impulse, 0.0, null,
                0.0, 0.0, inverse_delta, use_bias, lower_bias, lower_mass, lower_impulse)
            let upper = joint.maximum - relative_angle
            var upper_bias = rigid_bias
            var upper_mass = rigid_mass
            var upper_impulse = rigid_impulse
            if upper > 0.0 {
                upper_bias = inverse_delta
                upper_mass = 1.0
                upper_impulse = 0.0
            }
            joint.upper_impulse = solve_joint_angle(bodies, second, first,
                upper, 0.0, joint.upper_impulse, 0.0, null,
                0.0, 0.0, inverse_delta, use_bias, upper_bias, upper_mass, upper_impulse)
        }
        solve_joint_point_pair(bodies, joint, first, second, Math.Vec2(),
            0.0, 0.0, -1.0, inverse_delta, use_bias, rigid_bias, rigid_mass, rigid_impulse)
        return
    }

    var axis = joint_step_vector(bodies, first, joint.prepared_axis)
    let line_first_point = anchor_delta.add(first_point)
    let perpendicular = Math.Vec2(-axis.y, axis.x)
    let translation = anchor_delta.dot(axis)
    joint.current_translation = translation
    joint.current_speed = joint_velocity_on_radius(
        bodies,
        second,
        second_point
    ).subtract(joint_velocity_on_radius(
        bodies,
        first,
        first_point
    )).dot(axis)
    if joint.kind == JointKind2D.wheel && joint.motor_enabled {
        let maximum = joint.maximum_motor_torque * delta
        joint.motor_impulse = solve_joint_angle(bodies, first, second,
            0.0, joint.motor_speed, joint.motor_impulse, -maximum, maximum,
            0.0, 0.0, inverse_delta, false, 0.0)
    }
    if joint.spring_enabled {
        let next_impulse = solve_joint_axis(bodies, first, second,
            line_first_point, second_point, axis, translation - joint.scalar_target, 0.0,
            joint.axial_impulse, null, null,
            0.0, 0.0, inverse_delta, use_bias,
            joint.prepared_spring.bias_rate, joint.prepared_spring.mass_scale, joint.prepared_spring.impulse_scale, joint.prepared_axial_mass)
        joint.axial_impulse = next_impulse
    }
    if joint.kind == JointKind2D.prismatic && joint.motor_enabled {
        let maximum = joint.maximum_motor_force * delta
        joint.motor_impulse = solve_joint_axis(bodies, first, second,
            line_first_point, second_point, axis, 0.0, joint.motor_speed,
            joint.motor_impulse, -maximum, maximum, 0.0, 0.0, inverse_delta,
            false, 0.0, 1.0, 0.0, joint.prepared_axial_mass)
    }
    if joint.limit_enabled {
        solve_joint_axis_limits(bodies, joint, first, second, line_first_point,
            second_point, axis, translation, inverse_delta, use_bias)
    }

    if joint.kind == JointKind2D.prismatic {
        let first_radius = line_first_point
        let second_radius = second_point
        let first_arm = joint_cross(first_radius, perpendicular)
        let second_arm = joint_cross(second_radius, perpendicular)
        var first_mass = 0.0
        var second_mass = 0.0
        var first_inertia = 0.0
        var second_inertia = 0.0
        if bodies.awake[first] {
            first_mass = bodies.inverse_masses[first]
            first_inertia = bodies.inverse_inertias[first]
        }
        if bodies.awake[second] {
            second_mass = bodies.inverse_masses[second]
            second_inertia = bodies.inverse_inertias[second]
        }
        let xx = first_mass + second_mass + first_inertia * first_arm * first_arm +
            second_inertia * second_arm * second_arm
        let xy = first_inertia * first_arm + second_inertia * second_arm
        var yy = first_inertia + second_inertia
        if yy == 0.0 { yy = 1.0 }
        let linear_velocity = Math.Vec2(bodies.velocities_x[second] - bodies.velocities_x[first],
            bodies.velocities_y[second] - bodies.velocities_y[first])
        let velocity = linear_velocity.dot(perpendicular) +
            second_arm * bodies.angular_velocities[second] -
            first_arm * bodies.angular_velocities[first]
        let angular_velocity = bodies.angular_velocities[second] -
            bodies.angular_velocities[first]
        let correction = solve_joint_matrix(xx, xy, yy, Math.Vec2(
            velocity + rigid_bias * anchor_delta.dot(perpendicular),
            angular_velocity + rigid_bias * relative_angle))
        let previous = joint.perpendicular_impulse + 0.0
        let linear = -rigid_mass * correction.x - rigid_impulse * previous
        let angular = -rigid_mass * correction.y - rigid_impulse * joint.angular_impulse
        joint.perpendicular_impulse = previous + linear
        joint.angular_impulse += angular
        apply_joint_generalized_impulse(bodies, first, second, perpendicular.multiply(linear),
            linear * first_arm + angular, linear * second_arm + angular)
    } else {
        let previous = joint.perpendicular_impulse + 0.0
        let next = solve_joint_axis(bodies, first, second, line_first_point, second_point,
            perpendicular, anchor_delta.dot(perpendicular), 0.0, previous,
            null, null, 0.0, 0.0, inverse_delta, use_bias,
            rigid_bias, rigid_mass, rigid_impulse, joint.prepared_perpendicular_mass)
        joint.perpendicular_impulse = next
    }

}

public class DistanceJoint2D {
