use GFX.Physics.RigidBody2D.BodyId2D
use GFX.Physics.RigidBody2D.BodyStore2D
use STD.Math
use STD.Threading

public struct DistanceJoint2DSettings {
    var first_anchor:Math.Vec2
    var second_anchor:Math.Vec2
    var length:float
    var spring_hertz:float
    var spring_damping_ratio:float
    var minimum_length:float
    var maximum_length:float
    var motor_speed:float
    var maximum_motor_force:float
    var spring_enabled:bool
    var limit_enabled:bool
    var motor_enabled:bool
    var collide_connected:bool

    init() {
        self.first_anchor = Math.Vec2()
        self.second_anchor = Math.Vec2()
        self.length = -1.0
        self.spring_hertz = 0.0
        self.spring_damping_ratio = 0.0
        self.minimum_length = 0.0
        self.maximum_length = 1_000_000.0
        self.motor_speed = 0.0
        self.maximum_motor_force = 0.0
        self.spring_enabled = false
        self.limit_enabled = false
        self.motor_enabled = false
        self.collide_connected = false
    }
}

public struct MotorJoint2DSettings {
    var linear_offset:Math.Vec2
    var angular_offset:float
    var maximum_force:float
    var maximum_torque:float
    var correction_factor:float
    var collide_connected:bool

    init() {
        self.linear_offset = Math.Vec2()
        self.angular_offset = 0.0
        self.maximum_force = 1.0
        self.maximum_torque = 1.0
        self.correction_factor = 0.3
        self.collide_connected = false
    }
}

public struct MouseJoint2DSettings {
    var target:Math.Vec2
    var spring_hertz:float
    var spring_damping_ratio:float
    var maximum_force:float

    init() {
        self.target = Math.Vec2()
        self.spring_hertz = 5.0
        self.spring_damping_ratio = 0.7
        self.maximum_force = 1.0
    }
}

public struct FilterJoint2DSettings {
    init() {}
}

