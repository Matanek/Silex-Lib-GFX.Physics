    func constraint_damping_ratio() float {
        return self.store.constraint_damping_ratio(self.id)
    }
    func set_constraint_tuning(hertz:float, damping_ratio:float) {
        self.store.set_constraint_tuning(self.id, hertz, damping_ratio)
    }
    func constraint_force() Math.Vec2 { return self.store.reaction_force(self.id) }
    func constraint_torque() float { return self.store.reaction_torque(self.id) }
    func separation() Math.Vec2 { return self.store.separation(self.id) }
    func angular_separation() float {
        return self.store.angular_separation(self.id)
    }
    func linear_hertz() float { return self.store.spring_hertz(self.id) }
    func linear_damping_ratio() float {
        return self.store.spring_damping_ratio(self.id)
    }
    func angular_hertz() float { return self.store.angular_hertz(self.id) }
    func angular_damping_ratio() float {
        return self.store.angular_damping_ratio(self.id)
    }
    func set_linear_spring(hertz:float, damping_ratio:float) {
        self.store.set_spring(self.id, hertz > 0.0, hertz, damping_ratio)
    }
    func set_angular_spring(hertz:float, damping_ratio:float) {
        self.store.set_angular_spring(self.id, hertz, damping_ratio)
    }
    package func belongs_to(store:JointStore2D) bool { return self.store == store }
    package func joint_id() JointId2D { return self.id }
}

public class WheelJoint2D {
    private var store:JointStore2D
    private let id:JointId2D

    package init(store:JointStore2D, id:JointId2D) {
        self.store = store
        self.id = id
    }

    func application_id() uint64? { return self.store.application_id(self.id) }
    func set_application_id(value:uint64?) {
        self.store.set_application_id(self.id, value)
    }
    func is_valid() bool { return self.store.contains(self.id) }
    func first_body() RigidBody2D { return self.store.first_body_handle(self.id) }
    func second_body() RigidBody2D { return self.store.second_body_handle(self.id) }
    func first_local_anchor() Math.Vec2 { return self.store.first_anchor(self.id) }
    func second_local_anchor() Math.Vec2 { return self.store.second_anchor(self.id) }
    func set_local_anchors(first:Math.Vec2, second:Math.Vec2) {
        self.store.set_local_anchors(self.id, first, second)
    }
    func local_axis() Math.Vec2 { return self.store.local_axis(self.id) }
    func set_local_axis(axis:Math.Vec2) { self.store.set_local_axis(self.id, axis) }
    func collide_connected() bool { return self.store.collide_connected(self.id) }
    func set_collide_connected(enabled:bool) {
        self.store.set_collide_connected(self.id, enabled)
    }
    func wake_bodies() { self.store.wake(self.id) }
    func constraint_hertz() float { return self.store.constraint_hertz(self.id) }
    func constraint_damping_ratio() float {
        return self.store.constraint_damping_ratio(self.id)
    }
    func set_constraint_tuning(hertz:float, damping_ratio:float) {
        self.store.set_constraint_tuning(self.id, hertz, damping_ratio)
    }
    func constraint_force() Math.Vec2 { return self.store.reaction_force(self.id) }
    func constraint_torque() float { return self.store.reaction_torque(self.id) }
    func separation() Math.Vec2 { return self.store.separation(self.id) }
    func angular_separation() float {
        return self.store.angular_separation(self.id)
    }
    func translation() float { return self.store.current_translation(self.id) }
    func speed() float { return self.store.current_speed(self.id) }
    func lower_translation() float { return self.store.minimum(self.id) }
    func upper_translation() float { return self.store.maximum(self.id) }
    func limits_enabled() bool { return self.store.limit_enabled(self.id) }
    func set_limits(enabled:bool, lower:float, upper:float) {
        self.store.set_limits(self.id, enabled, lower, upper)
    }
    func spring_enabled() bool { return self.store.spring_enabled(self.id) }
    func spring_hertz() float { return self.store.spring_hertz(self.id) }
    func spring_damping_ratio() float {
        return self.store.spring_damping_ratio(self.id)
    }
    func set_spring(enabled:bool, hertz:float, damping_ratio:float) {
        self.store.set_spring(self.id, enabled, hertz, damping_ratio)
    }
    func motor_enabled() bool { return self.store.motor_enabled(self.id) }
    func motor_speed() float { return self.store.motor_speed(self.id) }
    func maximum_motor_torque() float {
        return self.store.maximum_motor_torque(self.id)
    }
    func motor_torque() float { return self.store.motor_torque(self.id) }
    func set_motor(speed:float, maximum_torque:float) {
        self.store.set_motor(self.id, speed, maximum_torque)
    }
    func set_motor_enabled(enabled:bool) {
        self.store.set_motor_enabled(self.id, enabled)
    }
    package func belongs_to(store:JointStore2D) bool { return self.store == store }
    package func joint_id() JointId2D { return self.id }
}

public enum Joint2D {
    distance(DistanceJoint2D)
    filter(FilterJoint2D)
    motor(MotorJoint2D)
    mouse(MouseJoint2D)
    prismatic(PrismaticJoint2D)
    revolute(RevoluteJoint2D)
    weld(WeldJoint2D)
    wheel(WheelJoint2D)
}

func finite_joint_value(value:float) bool {
    return value == value && value > -1.0e30 && value < 1.0e30
}

func finite_joint_vector(value:Math.Vec2) bool {
    return finite_joint_value(value.x) && finite_joint_value(value.y)
}
