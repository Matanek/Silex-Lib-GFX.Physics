use GFX.Physics.RigidBody2D.BodyId2D
use GFX.Physics.RigidBody2D.BodyStore2D
use GFX.Physics.RigidBody2D.RigidBody2D
use GFX.Physics.RigidBody2D.Collider2D
use GFX.Physics.ContactPolicy2D.ColliderSnapshot2D
use GFX.Physics.ContactPolicy2D.ContactPairSnapshot2D
use GFX.Physics.Geometry2D.Manifold2D
use GFX.Physics.Transform2D.Transform2D
use STD.Math

public struct BodyMoveEvent2D {
    private var store:BodyStore2D
    private var body_id:BodyId2D
    private var current_transform:Transform2D
    private var current_fell_asleep:bool

    package init(
        store:BodyStore2D,
        body_id:BodyId2D,
        transform:Transform2D,
        fell_asleep:bool
    ) {
        self.store = store
        self.body_id = body_id
        self.current_transform = transform
        self.current_fell_asleep = fell_asleep
    }

    func body() RigidBody2D { return RigidBody2D(self.store, self.body_id) }
    func transform() Transform2D { return self.current_transform }
    func fell_asleep() bool { return self.current_fell_asleep }
}

public struct ContactBeginEvent2D {
    private var current_pair:ContactPairSnapshot2D
    private var current_manifold:Manifold2D

    package init(
        pair:ContactPairSnapshot2D,
        manifold:Manifold2D
    ) {
        self.current_pair = pair
        self.current_manifold = manifold
    }

    func pair() ContactPairSnapshot2D { return self.current_pair }
    func first_collider() Collider2D { return self.current_pair.first().collider() }
    func second_collider() Collider2D { return self.current_pair.second().collider() }
    func first_body() RigidBody2D { return self.current_pair.first().body() }
    func second_body() RigidBody2D { return self.current_pair.second().body() }
    func manifold() Manifold2D { return self.current_manifold }
}

public struct ContactEndEvent2D {
    private var current_pair:ContactPairSnapshot2D

    package init(pair:ContactPairSnapshot2D) {
        self.current_pair = pair
    }

    func pair() ContactPairSnapshot2D { return self.current_pair }
    func first_collider() Collider2D { return self.current_pair.first().collider() }
    func second_collider() Collider2D { return self.current_pair.second().collider() }
    func first_body() RigidBody2D { return self.current_pair.first().body() }
    func second_body() RigidBody2D { return self.current_pair.second().body() }
}

public struct ContactHitEvent2D {
    private var current_pair:ContactPairSnapshot2D
    private var current_point:Math.Vec2
    private var current_normal:Math.Vec2
    private var current_approach_speed:float

    package init(
        pair:ContactPairSnapshot2D,
        point:Math.Vec2,
        normal:Math.Vec2,
        approach_speed:float
    ) {
        self.current_pair = pair
        self.current_point = point
        self.current_normal = normal
        self.current_approach_speed = approach_speed
    }

    func pair() ContactPairSnapshot2D { return self.current_pair }
    func first_collider() Collider2D { return self.current_pair.first().collider() }
    func second_collider() Collider2D { return self.current_pair.second().collider() }
    func first_body() RigidBody2D { return self.current_pair.first().body() }
    func second_body() RigidBody2D { return self.current_pair.second().body() }
    func point() Math.Vec2 { return self.current_point }
    func normal() Math.Vec2 { return self.current_normal }
    func approach_speed() float { return self.current_approach_speed }
}

public struct SensorBeginEvent2D {
    private var current_sensor:ColliderSnapshot2D
    private var current_visitor:ColliderSnapshot2D

    package init(
        sensor:ColliderSnapshot2D,
        visitor:ColliderSnapshot2D
    ) {
        self.current_sensor = sensor
        self.current_visitor = visitor
    }

    func sensor() ColliderSnapshot2D { return self.current_sensor }
    func visitor() ColliderSnapshot2D { return self.current_visitor }
    func sensor_collider() Collider2D { return self.current_sensor.collider() }
    func visitor_collider() Collider2D { return self.current_visitor.collider() }
    func sensor_body() RigidBody2D { return self.current_sensor.body() }
    func visitor_body() RigidBody2D { return self.current_visitor.body() }
}

