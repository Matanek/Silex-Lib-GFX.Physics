use GFX.Physics.RigidBody2D.BodyId2D
use GFX.Physics.RigidBody2D.BodyStore2D
use GFX.Physics.RigidBody2D.RigidBody2D
use GFX.Physics.Geometry2D.Manifold2D
use GFX.Physics.Transform2D.Transform2D
use STD.Math

public struct BodyMoveEvent2D {
    private var store:BodyStore2D
    private var body_id:BodyId2D
    private var current_transform:Transform2D
    private var current_fell_asleep:bool

    package init(
        store:BodyStore2D,
        body_id:BodyId2D,
        transform:Transform2D,
        fell_asleep:bool
    ) {
        self.store = store
        self.body_id = body_id
        self.current_transform = transform
        self.current_fell_asleep = fell_asleep
    }

    func body() RigidBody2D { return RigidBody2D(self.store, self.body_id) }
    func transform() Transform2D { return self.current_transform }
    func fell_asleep() bool { return self.current_fell_asleep }
}

public struct ContactBeginEvent2D {
    private var store:BodyStore2D
    private var first_id:BodyId2D
    private var second_id:BodyId2D
    private var current_manifold:Manifold2D

    package init(
        store:BodyStore2D,
        first_id:BodyId2D,
        second_id:BodyId2D,
        manifold:Manifold2D
    ) {
        self.store = store
        self.first_id = first_id
        self.second_id = second_id
        self.current_manifold = manifold
    }

    func first_body() RigidBody2D {
        return RigidBody2D(self.store, self.first_id)
    }
    func second_body() RigidBody2D {
        return RigidBody2D(self.store, self.second_id)
    }
    func manifold() Manifold2D { return self.current_manifold }
}

public struct ContactEndEvent2D {
    private var store:BodyStore2D
    private var first_id:BodyId2D
    private var second_id:BodyId2D

    package init(
        store:BodyStore2D,
        first_id:BodyId2D,
        second_id:BodyId2D
    ) {
        self.store = store
        self.first_id = first_id
        self.second_id = second_id
    }

    func first_body() RigidBody2D {
        return RigidBody2D(self.store, self.first_id)
    }
    func second_body() RigidBody2D {
        return RigidBody2D(self.store, self.second_id)
    }
}

public struct ContactHitEvent2D {
    private var store:BodyStore2D
    private var first_id:BodyId2D
    private var second_id:BodyId2D
    private var current_point:Math.Vec2
    private var current_normal:Math.Vec2
    private var current_approach_speed:float

    package init(
        store:BodyStore2D,
        first_id:BodyId2D,
        second_id:BodyId2D,
        point:Math.Vec2,
        normal:Math.Vec2,
        approach_speed:float
    ) {
        self.store = store
        self.first_id = first_id
        self.second_id = second_id
        self.current_point = point
        self.current_normal = normal
        self.current_approach_speed = approach_speed
    }

    func first_body() RigidBody2D {
        return RigidBody2D(self.store, self.first_id)
    }
    func second_body() RigidBody2D {
        return RigidBody2D(self.store, self.second_id)
    }
    func point() Math.Vec2 { return self.current_point }
    func normal() Math.Vec2 { return self.current_normal }
    func approach_speed() float { return self.current_approach_speed }
}

public struct SensorBeginEvent2D {
    private var store:BodyStore2D
    private var sensor_id:BodyId2D
    private var visitor_id:BodyId2D

    package init(
        store:BodyStore2D,
        sensor_id:BodyId2D,
        visitor_id:BodyId2D
    ) {
        self.store = store
        self.sensor_id = sensor_id
        self.visitor_id = visitor_id
    }

    func sensor_body() RigidBody2D {
        return RigidBody2D(self.store, self.sensor_id)
    }
    func visitor_body() RigidBody2D {
        return RigidBody2D(self.store, self.visitor_id)
    }
}

