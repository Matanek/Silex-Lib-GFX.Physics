public struct SensorOverlap2D {
    private var current_sensor:ColliderSnapshot2D
    private var current_visitor:ColliderSnapshot2D

    package init(sensor:ColliderSnapshot2D, visitor:ColliderSnapshot2D) {
        self.current_sensor = sensor
        self.current_visitor = visitor
    }

    func sensor() ColliderSnapshot2D { return self.current_sensor }
    func visitor() ColliderSnapshot2D { return self.current_visitor }
    func sensor_collider() Collider2D { return self.current_sensor.collider() }
    func visitor_collider() Collider2D { return self.current_visitor.collider() }
    func sensor_body() RigidBody2D { return self.current_sensor.body() }
    func visitor_body() RigidBody2D { return self.current_visitor.body() }
}
