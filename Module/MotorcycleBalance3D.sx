use GFX.Physics.RigidBody3D.BodyState3D
use GFX.Physics.RigidBody3D.finite_body3d_value
use STD.Math

public struct MotorcycleBalance3DSettings {
    let maximum_lean_angle:float
    let stiffness:float
    let damping:float
    let integral_gain:float
    let integral_decay:float
    let smoothing:float
    init(maximum_lean_angle:float=Math.pi()/4.0,stiffness:float=5000.0,damping:float=1000.0,
        integral_gain:float=0.0,integral_decay:float=4.0,smoothing:float=0.8) {
        if !finite_body3d_value(maximum_lean_angle) || maximum_lean_angle<0.0 || maximum_lean_angle>=Math.half_pi() {
            panic("GFX.Physics.MotorcycleBalance3DSettings requires a maximum lean angle in [0, pi/2)")
        }
        let gains:float[]=[stiffness,damping,integral_gain,integral_decay]
        for value in gains {
            if !finite_body3d_value(value) || value<0.0 || !finite_body3d_value(value*value) {
                panic("GFX.Physics.MotorcycleBalance3DSettings requires nonnegative finite representable gains and decay")
            }
        }
        if !finite_body3d_value(smoothing) || smoothing<0.0 || smoothing>1.0 {
            panic("GFX.Physics.MotorcycleBalance3DSettings smoothing must be finite in [0, 1]")
        }
        self.maximum_lean_angle=maximum_lean_angle;self.stiffness=stiffness;self.damping=damping
        self.integral_gain=integral_gain;self.integral_decay=integral_decay;self.smoothing=smoothing
    }
}

package class MotorcycleLean3D {
    var settings:MotorcycleBalance3DSettings
    let local_forward:Math.Vec3
    let local_up:Math.Vec3
    let wheelbase:float
    var enabled:bool=true
    var steering_limit:bool=true
    var target:Math.Vec3=Math.Vec3()
    var integral:float=0.0
    private var applied:float=0.0
    private var delta:float=0.0
    private var world_up:Math.Vec3
    private var speed_squared:float=0.0
    private var steering_factor:float=0.0
    private var forward:Math.Vec3=Math.Vec3(0.0,0.0,1.0)
    private var angular_response:Math.Vec3=Math.Vec3()
    private var target_error:float=0.0
    init(settings:MotorcycleBalance3DSettings,forward:Math.Vec3,up:Math.Vec3,wheelbase:float) {
        self.settings=settings;self.local_forward=forward;self.local_up=up;self.world_up=up;self.wheelbase=wheelbase
    }
    func prepare(body:BodyState3D,impulse:Math.Vec3,gravity:Math.Vec3,delta:float) {
        self.delta=delta;self.applied=0.0
        if gravity.length_squared()>0.0 { self.world_up=gravity.negated().normalized() }
        let forward=body.transform.vector(self.local_forward)
        self.forward=forward;self.angular_response=body.inverse_inertia_times(forward)
        if self.enabled {
            let desired=lean_unit3d(impulse,self.world_up)
            self.target=self.target.multiply(self.settings.smoothing).add(desired.multiply(1.0-self.settings.smoothing))
            self.target=lean_unit3d(self.target.subtract(forward.multiply(self.target.dot(forward))),self.world_up)
            let vertical=lean_unit3d(self.world_up.subtract(forward.multiply(self.world_up.dot(forward))),self.world_up)
            let angle=lean_angle3d(self.target,vertical,forward)
            if Math.abs(angle)>self.settings.maximum_lean_angle {
                var direction=1.0;if angle<0.0 { direction= -1.0 }
                self.target=Math.Quat.angle_axis(direction*self.settings.maximum_lean_angle,forward).rotate(vertical)
            }
        } else { self.target=self.world_up;self.integral=0.0 }
        self.target_error=lean_angle3d(self.target,body.transform.vector(self.local_up),forward)
        if self.enabled && body.awake { self.integral+=self.target_error*delta }
        let speed=body.linear_velocity.dot(forward);self.speed_squared=speed*speed
        self.steering_factor=self.wheelbase*Math.tan(self.settings.maximum_lean_angle)*gravity.length()
    }
    func steering(input:float,maximum:float,axis:Math.Vec3) float {
        var angle=Math.abs(input)*Math.abs(maximum)
        let caster=Math.abs(axis.dot(self.local_up))
        if self.steering_limit && self.speed_squared>0.000001 && caster>0.000001 {
            let limit=Math.asin(Math.clamp(self.steering_factor/(self.speed_squared*caster),0.0,1.0))
            angle=Math.min(angle,limit)
        }
        if maximum<0.0 { angle= -angle }
        if input<0.0 { return angle }
        return -angle
    }
    func solve(body:BodyState3D,supported:bool,weighted_arm:Math.Vec3,total_load:float) {
        if !self.enabled || !body.is_enabled || !body.awake { return }
        if !supported {
            self.integral*=Math.max(0.0,1.0-self.settings.integral_decay*self.delta);return
        }
        let velocity=body.angular_velocity.dot(self.forward)
        let impulse=(self.settings.stiffness*self.target_error-self.settings.damping*velocity+self.settings.integral_gain*self.integral)*self.delta
        let previous_velocity=body.angular_velocity
        body.angular_velocity=body.angular_velocity.add(self.angular_response.multiply(impulse-self.applied))
        self.applied=impulse
        let change=body.angular_velocity.subtract(previous_velocity)
        body.linear_velocity=body.linear_velocity.subtract(change.cross(weighted_arm).multiply(1.0/total_load))
    }
}

func lean_unit3d(value:Math.Vec3,fallback:Math.Vec3) Math.Vec3 {
    if value.length_squared()>0.0 { return value.normalized() }
    return fallback
}
func lean_angle3d(target:Math.Vec3,up:Math.Vec3,forward:Math.Vec3) float {
    var direction= -1.0;if target.cross(up).dot(forward)<0.0 { direction=1.0 }
    return direction*Math.acos(Math.clamp(target.dot(up),-1.0,1.0))
}
