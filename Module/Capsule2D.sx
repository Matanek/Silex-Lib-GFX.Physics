use STD.Math

public struct Capsule2D {
    let first:Math.Vec2
    let second:Math.Vec2
    let radius:float

    init(first:Math.Vec2, second:Math.Vec2, radius:float) {
        if !finite_point(first) || !finite_point(second) ||
            !finite_capsule_value(radius) || radius <= 0.0
        {
            panic("GFX.Physics.Capsule2D requires finite endpoints and a positive radius")
        }
        if first.subtract(second).length_squared() <= 0.000000000001 {
            panic("GFX.Physics.Capsule2D requires two distinct endpoints")
        }
        self.first = first
        self.second = second
        self.radius = radius
    }
}

func finite_point(point:Math.Vec2) bool {
    return finite_capsule_value(point.x) && finite_capsule_value(point.y)
}

func finite_capsule_value(value:float) bool {
    return value == value && (value == 0.0 || value + value != value)
}
