use GFX.Physics.Box3D.Box3D
use GFX.Physics.Capsule3D.Capsule3D
use GFX.Physics.Transform3D.Transform3D
use STD.Math

struct BoxFace3D {
    let axis:int
    let sign:float
    let alignment:float
    let corners:Math.Vec3[]

    init(axis:int, sign:float, alignment:float, corners:Math.Vec3[]) {
        self.axis = axis
        self.sign = sign
        self.alignment = alignment
        self.corners = corners
    }
}

package func box_box_contact_points(
    first:Box3D,
    first_transform:Transform3D,
    second:Box3D,
    second_transform:Transform3D,
    normal:Math.Vec3,
    witness:Math.Vec3
) Math.Vec3[] {
    let first_face = box_face3d(first, first_transform, normal)
    let second_face = box_face3d(second, second_transform, normal.negated())
    if first_face.alignment >= second_face.alignment &&
        first_face.alignment >= 0.7
    {
        return clipped_box_face3d(
            first, first_transform, first_face,
            second_face.corners, witness
        )
    }
    if second_face.alignment >= 0.7 {
        return clipped_box_face3d(
            second, second_transform, second_face,
            first_face.corners, witness
        )
    }
    return [witness]
}

func clipped_box_face3d(
    reference:Box3D,
    reference_transform:Transform3D,
    reference_face:BoxFace3D,
    incident:Math.Vec3[],
    witness:Math.Vec3
) Math.Vec3[] {
    let half = reference.half_size()
    let first_side = (reference_face.axis + 1) % 3
    let second_side = (reference_face.axis + 2) % 3
    var polygon = clip_box_face3d(
        incident, reference_transform, first_side,
        component3d(half, first_side)
    )
    polygon = clip_box_face3d(
        polygon, reference_transform, first_side,
        -component3d(half, first_side), false
    )
    polygon = clip_box_face3d(
        polygon, reference_transform, second_side,
        component3d(half, second_side)
    )
    polygon = clip_box_face3d(
        polygon, reference_transform, second_side,
        -component3d(half, second_side), false
    )
    let outward = reference_transform.vector(
        box_axis3d(reference_face.axis)
    ).multiply(reference_face.sign)
    var points:Math.Vec3[] = []
    for vertex in polygon {
        let local_vertex = reference_transform.inverse_point(vertex)
        let depth = reference_face.sign * component3d(local_vertex, reference_face.axis) -
            component3d(half, reference_face.axis)
        if depth <= 0.0001 {
            append_unique_contact3d(
                points, vertex.subtract(outward.multiply(depth * 0.5))
            )
        }
    }
    if points.count() == 0 { points.append(witness) }
    if points.count() > 4 {
        let first_axis = reference_transform.vector(box_axis3d(first_side))
        let second_axis = reference_transform.vector(box_axis3d(second_side))
        var reduced:Math.Vec3[] = []
        var index = 0
        while index < 4 {
            let first_sign = corner_sign3d(index % 2)
            let second_sign = corner_sign3d(index / 2)
            let direction = first_axis.multiply(first_sign).add(
                second_axis.multiply(second_sign)
            )
            var best = points[0]
            var best_projection = best.dot(direction)
            for candidate in points {
                let projection = candidate.dot(direction)
                if projection > best_projection {
                    best = candidate
                    best_projection = projection
                }
            }
            append_unique_contact3d(reduced, best)
            index++
        }
        return reduced
    }
    return points
}

func clip_box_face3d(
    polygon:Math.Vec3[],
    transform:Transform3D,
    axis:int,
    limit:float,
    keep_less:bool = true
) Math.Vec3[] {
    var result:Math.Vec3[] = []
    if polygon.is_empty() { return result }
    var previous = polygon[polygon.count() - 1]
    var previous_value = component3d(transform.inverse_point(previous), axis)
    var previous_inside = previous_value <= limit
    if !keep_less { previous_inside = previous_value >= limit }
    for current in polygon {
        let current_value = component3d(transform.inverse_point(current), axis)
        var current_inside = current_value <= limit
        if !keep_less { current_inside = current_value >= limit }
        if current_inside != previous_inside {
            let fraction = (limit - previous_value) /
                (current_value - previous_value)
            result.append(previous.add(current.subtract(previous).multiply(fraction)))
        }
        if current_inside { result.append(current) }
        previous = current
        previous_value = current_value
        previous_inside = current_inside
    }
    return result
}

func component3d(value:Math.Vec3, axis:int) float {
    if axis == 0 { return value.x }
    if axis == 1 { return value.y }
    return value.z
}

package func capsule_capsule_contact_points(
    first:Capsule3D, first_transform:Transform3D,
    second:Capsule3D, second_transform:Transform3D,
    normal:Math.Vec3, witness:Math.Vec3
) Math.Vec3[] {
    var points:Math.Vec3[] = []
    let first_axis = first_transform.vector(Math.Vec3.up())
    let second_axis = second_transform.vector(Math.Vec3.up())
    if Math.abs(first_axis.dot(second_axis)) < 0.95 ||
        Math.abs(first_axis.dot(normal)) > 0.1
    {
        points.append(witness)
        return points
    }
    let second_low = second_transform.position.subtract(
        second_axis.multiply(second.half_height)
    ).subtract(first_transform.position).dot(first_axis)
    let second_high = second_transform.position.add(
        second_axis.multiply(second.half_height)
    ).subtract(first_transform.position).dot(first_axis)
    let lower = Math.max(-first.half_height, Math.min(second_low, second_high))
    let upper = Math.min(first.half_height, Math.max(second_low, second_high))
    if upper - lower < 0.01 {
        points.append(witness)
        return points
    }
    let offsets:float[] = [lower, upper]
    for offset in offsets {
        let first_center = first_transform.position.add(first_axis.multiply(offset))
        let second_fraction = Math.clamp(
            first_center.subtract(second_transform.position).dot(second_axis),
            -second.half_height, second.half_height
        )
        let second_center = second_transform.position.add(
            second_axis.multiply(second_fraction)
        )
        points.append(first_center.add(normal.multiply(first.radius)).add(
            second_center.subtract(normal.multiply(second.radius))
        ).multiply(0.5))
    }
    return points
}

func box_face3d(box:Box3D, transform:Transform3D, normal:Math.Vec3) BoxFace3D {
    var selected_axis = 0
    var alignment = 0.0
    var sign = 1.0
    var axis = 0
    while axis < 3 {
        let projection = transform.vector(box_axis3d(axis)).dot(normal)
        if Math.abs(projection) > alignment {
            alignment = Math.abs(projection)
            selected_axis = axis
            if projection < 0.0 { sign = -1.0 } else { sign = 1.0 }
        }
        axis++
    }
    let half = box.half_size()
    var corners:Math.Vec3[] = []
    var index = 0
    let winding:int[] = [0, 1, 3, 2]
    while index < 4 {
        var local_point = Math.Vec3()
        let first_sign = corner_sign3d(winding[index] % 2)
        let second_sign = corner_sign3d(winding[index] / 2)
        if selected_axis == 0 {
            local_point = Math.Vec3(sign * half.x, first_sign * half.y, second_sign * half.z)
        } else if selected_axis == 1 {
            local_point = Math.Vec3(first_sign * half.x, sign * half.y, second_sign * half.z)
        } else {
            local_point = Math.Vec3(first_sign * half.x, second_sign * half.y, sign * half.z)
        }
        corners.append(transform.point(local_point))
        index++
    }
    return BoxFace3D(selected_axis, sign, alignment, corners)
}

func append_unique_contact3d(points:&Math.Vec3[], point:Math.Vec3) {
    for existing in points {
        if existing.distance(point) < 0.0001 { return }
    }
    points.append(point)
}

func box_axis3d(axis:int) Math.Vec3 {
    if axis == 0 { return Math.Vec3.right() }
    if axis == 1 { return Math.Vec3.up() }
    return Math.Vec3.back()
}

func corner_sign3d(bit:int) float {
    if bit == 0 { return -1.0 }
    return 1.0
}
