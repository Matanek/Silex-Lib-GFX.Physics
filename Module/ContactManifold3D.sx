use GFX.Physics.ConvexHull3D.ConvexHull3D
use GFX.Physics.Box3D.Box3D
use GFX.Physics.Capsule3D.Capsule3D
use GFX.Physics.Geometry3D.ShapePlacement3D
use GFX.Physics.Geometry3D.contact_distance3d
use GFX.Physics.Geometry3D.box_triangle_distance
use GFX.Physics.Geometry3D.shape_triangle_front3d
use GFX.Physics.Triangle3D.Triangle3D
use GFX.Physics.Sphere3D.Sphere3D
use GFX.Physics.Shape3D.Shape3D
use GFX.Physics.Transform3D.Transform3D
use STD.Math

struct BoxFace3D {
    let axis:int
    let sign:float
    let alignment:float
    let corners:Math.Vec3[]

    init(axis:int, sign:float, alignment:float, corners:Math.Vec3[]) {
        self.axis = axis
        self.sign = sign
        self.alignment = alignment
        self.corners = corners
    }
}

package func box_box_contact_points(
    first:Box3D,
    first_transform:Transform3D,
    second:Box3D,
    second_transform:Transform3D,
    normal:Math.Vec3,
    witness:Math.Vec3
) Math.Vec3[] {
    let first_face = box_face3d(first, first_transform, normal)
    let second_face = box_face3d(second, second_transform, normal.negated())
    if first_face.alignment >= second_face.alignment &&
        first_face.alignment >= 0.7
    {
        return clipped_box_face3d(
            first, first_transform, first_face,
            second_face.corners, witness
        )
    }
    if second_face.alignment >= 0.7 {
        return clipped_box_face3d(
            second, second_transform, second_face,
            first_face.corners, witness
        )
    }
    return [witness]
}

// One boundary polygon, independent of the hull's triangulation diagonals.
package func box_convex_contact_points(box:Box3D, transform:Transform3D,
    hull:ConvexHull3D, hull_transform:Transform3D,
    normal:Math.Vec3, witness:Math.Vec3) Math.Vec3[] {
    let box_face = box_face3d(box, transform, normal)
    var face = 0
    var alignment = -1.0
    var index = 0
    while index < hull.face_count() {
        let candidate = hull_transform.vector(hull.face_normal(index)).dot(normal.negated())
        if candidate > alignment { alignment = candidate; face = index }
        index++
    }
    if box_face.alignment >= alignment && box_face.alignment > 0.99999 {
        var polygon:Math.Vec3[] = []
        for point in hull.face_polygon(face) { polygon.append(hull_transform.point(point)) }
        return clipped_box_face3d(box, transform, box_face, polygon, witness)
    }
    if alignment < 0.99999 { return [witness] }
    return clipped_convex_face3d(hull, hull_transform, face, box_face.corners, witness)
}

func convex_face3d(hull:ConvexHull3D, transform:Transform3D, direction:Math.Vec3) int {
    var face = 0; var best = -1.0; var index = 0
    while index < hull.face_count() {
        let alignment = transform.vector(hull.face_normal(index)).dot(direction)
        if alignment > best { best = alignment; face = index }
        index++
    }
    return face
}

package func convex_convex_contact_points(first:ConvexHull3D, first_transform:Transform3D,
    second:ConvexHull3D, second_transform:Transform3D,
    normal:Math.Vec3, witness:Math.Vec3) Math.Vec3[] {
    let first_face = convex_face3d(first, first_transform, normal)
    let second_face = convex_face3d(second, second_transform, normal.negated())
    let first_alignment = first_transform.vector(first.face_normal(first_face)).dot(normal)
    let second_alignment = second_transform.vector(second.face_normal(second_face)).dot(normal.negated())
    if first_alignment >= second_alignment && first_alignment >= 0.99999 {
        var polygon:Math.Vec3[] = []
        for point in second.face_polygon(second_face) { polygon.append(second_transform.point(point)) }
        return clipped_convex_face3d(first, first_transform, first_face, polygon, witness)
    }
    if second_alignment >= 0.99999 {
        var polygon:Math.Vec3[] = []
        for point in first.face_polygon(first_face) { polygon.append(first_transform.point(point)) }
        return clipped_convex_face3d(second, second_transform, second_face, polygon, witness)
    }
    return [witness]
}

func clipped_convex_face3d(hull:ConvexHull3D, hull_transform:Transform3D,
    face:int, incident:Math.Vec3[], witness:Math.Vec3) Math.Vec3[] {
    let outward = hull_transform.vector(hull.face_normal(face))
    let origin = hull_transform.point(hull.face_origin(face))
    var polygon:Math.Vec3[] = []
    for point in hull.face_polygon(face) { polygon.append(hull_transform.point(point)) }
    var clipped = incident
    var index = 0
    while index < polygon.count() {
        let point = polygon[index]
        let edge = polygon[(index + 1) % polygon.count()].subtract(point)
        clipped = clip_contact_plane3d(clipped, point, edge.cross(outward).normalized())
        index++
    }
    var points:Math.Vec3[] = []
    for point in clipped {
        let depth = point.subtract(origin).dot(outward)
        if depth <= 0.0001 {
            append_unique_contact3d(points, point.subtract(outward.multiply(depth * 0.5)))
        }
    }
    if points.is_empty() { return [witness] }
    let tangent = polygon[1].subtract(polygon[0]).normalized()
    return reduce_contact_points3d(points, tangent, outward.cross(tangent))
}

// Clip a parallel capsule axis to the actual face polygon, including when
// both caps extend past its edges. Evaluated once per nearby contact pair.
package func capsule_convex_contact_points(capsule:Capsule3D, transform:Transform3D,
    hull:ConvexHull3D, hull_transform:Transform3D,
    normal:Math.Vec3, witness:Math.Vec3) Math.Vec3[] {
    let axial = hull_transform.inverse_vector(transform.vector(Math.Vec3.up()))
    let inward = hull_transform.inverse_vector(normal)
    if Math.abs(axial.dot(inward)) > 0.001 { return [witness] }
    var face = 0; var alignment = -1.0; var index = 0
    while index < hull.face_count() {
        let candidate = hull.face_normal(index).dot(inward.negated())
        if candidate > alignment { alignment = candidate; face = index }
        index++
    }
    if alignment < 0.99999 { return [witness] }
    let outward = hull.face_normal(face)
    let center = hull_transform.inverse_point(transform.position)
    let first = center.subtract(axial.multiply(capsule.half_height))
    let direction = axial.multiply(2.0 * capsule.half_height)
    let polygon = hull.face_polygon(face)
    var lower = 0.0; var upper = 1.0; index = 0
    while index < polygon.count() {
        let origin = polygon[index]
        let side = polygon[(index + 1) % polygon.count()].subtract(origin).cross(outward).normalized()
        let distance = first.subtract(origin).dot(side)
        let speed = direction.dot(side)
        if Math.abs(speed) < 0.000000001 {
            if distance > 0.000001 { return [witness] }
        } else {
            let fraction = -distance / speed
            if speed < 0.0 { lower = Math.max(lower, fraction) }
            else { upper = Math.min(upper, fraction) }
            if lower > upper { return [witness] }
        }
        index++
    }
    if upper - lower < 0.000001 { return [witness] }
    var points:Math.Vec3[] = []
    let fractions:float[] = [lower, upper]
    for fraction in fractions {
        let point = first.add(direction.multiply(fraction)).add(inward.multiply(capsule.radius))
        let depth = point.subtract(hull.face_origin(face)).dot(outward)
        points.append(hull_transform.point(point.subtract(outward.multiply(depth * 0.5))))
    }
    return points
}

func clip_contact_plane3d(polygon:Math.Vec3[], origin:Math.Vec3,
    normal:Math.Vec3) Math.Vec3[] {
    var result:Math.Vec3[] = []
    if polygon.is_empty() { return result }
    var previous = polygon[polygon.count() - 1]
    var previous_value = previous.subtract(origin).dot(normal)
    for current in polygon {
        let value = current.subtract(origin).dot(normal)
        if (value <= 0.0) != (previous_value <= 0.0) {
            let fraction = previous_value / (previous_value - value)
            result.append(previous.add(current.subtract(previous).multiply(fraction)))
        }
        if value <= 0.0 { result.append(current) }
        previous = current; previous_value = value
    }
    return result
}

func clipped_box_face3d(
    reference:Box3D,
    reference_transform:Transform3D,
    reference_face:BoxFace3D,
    incident:Math.Vec3[],
    witness:Math.Vec3
) Math.Vec3[] {
    let half = reference.half_size()
    let first_side = (reference_face.axis + 1) % 3
    let second_side = (reference_face.axis + 2) % 3
    var polygon = clip_box_face3d(
        incident, reference_transform, first_side,
        component3d(half, first_side)
    )
    polygon = clip_box_face3d(
        polygon, reference_transform, first_side,
        -component3d(half, first_side), false
    )
    polygon = clip_box_face3d(
        polygon, reference_transform, second_side,
        component3d(half, second_side)
    )
    polygon = clip_box_face3d(
        polygon, reference_transform, second_side,
        -component3d(half, second_side), false
    )
    let outward = reference_transform.vector(
        box_axis3d(reference_face.axis)
    ).multiply(reference_face.sign)
    var points:Math.Vec3[] = []
    for vertex in polygon {
        let local_vertex = reference_transform.inverse_point(vertex)
        let depth = reference_face.sign * component3d(local_vertex, reference_face.axis) -
            component3d(half, reference_face.axis)
        if depth <= 0.0001 {
            append_unique_contact3d(
                points, vertex.subtract(outward.multiply(depth * 0.5))
            )
        }
    }
    if points.count() == 0 { points.append(witness) }
    return reduce_contact_points3d(points,
        reference_transform.vector(box_axis3d(first_side)),
        reference_transform.vector(box_axis3d(second_side)))
}

func reduce_contact_points3d(points:Math.Vec3[],
    first_axis:Math.Vec3, second_axis:Math.Vec3) Math.Vec3[] {
    if points.count() > 4 {
        var reduced:Math.Vec3[] = []
        var index = 0
        while index < 4 {
            let first_sign = corner_sign3d(index % 2)
            let second_sign = corner_sign3d(index / 2)
            let direction = first_axis.multiply(first_sign).add(
                second_axis.multiply(second_sign)
            )
            var best = points[0]
            var best_projection = best.dot(direction)
            for candidate in points {
                let projection = candidate.dot(direction)
                if projection > best_projection {
                    best = candidate
                    best_projection = projection
                }
            }
            append_unique_contact3d(reduced, best)
            index++
        }
        return reduced
    }
    return points
}

func clip_box_face3d(
    polygon:Math.Vec3[],
    transform:Transform3D,
    axis:int,
    limit:float,
    keep_less:bool = true
) Math.Vec3[] {
    var result:Math.Vec3[] = []
    if polygon.is_empty() { return result }
    var previous = polygon[polygon.count() - 1]
    var previous_value = component3d(transform.inverse_point(previous), axis)
    var previous_inside = previous_value <= limit
    if !keep_less { previous_inside = previous_value >= limit }
    for current in polygon {
        let current_value = component3d(transform.inverse_point(current), axis)
        var current_inside = current_value <= limit
        if !keep_less { current_inside = current_value >= limit }
        if current_inside != previous_inside {
            let fraction = (limit - previous_value) /
                (current_value - previous_value)
            result.append(previous.add(current.subtract(previous).multiply(fraction)))
        }
        if current_inside { result.append(current) }
        previous = current
        previous_value = current_value
        previous_inside = current_inside
    }
    return result
}

func component3d(value:Math.Vec3, axis:int) float {
    if axis == 0 { return value.x }
    if axis == 1 { return value.y }
    return value.z
}

package func box_surface_contact_points(box:Box3D, transform:Transform3D,
    surface:ShapePlacement3D, normal:Math.Vec3, witness:Math.Vec3) Math.Vec3[] {
    let face = box_face3d(box, transform, normal)
    if face.alignment < 0.7 { return [witness] }
    var points:Math.Vec3[] = []
    match surface.shape() {
        triangle(triangle) => {
            append_box_triangle_contacts3d(points, box, transform, face,
                triangle, surface.transform(), normal, witness)
        }
        mesh(mesh) => {
            var index = 0
            while index < mesh.triangle_count() {
                append_box_triangle_contacts3d(points, box, transform, face,
                    mesh.triangle(index), surface.transform(), normal, witness)
                index++
            }
        }
        convex(_) => {}
        sphere(_) => {}
        box(_) => {}
        capsule(_) => {}
        compound(_) => {}
    }
    if points.is_empty() { return [witness] }
    return reduce_contact_points3d(points,
        transform.vector(box_axis3d((face.axis + 1) % 3)),
        transform.vector(box_axis3d((face.axis + 2) % 3)))
}

func append_box_triangle_contacts3d(points:&Math.Vec3[], box:Box3D,
    transform:Transform3D, face:BoxFace3D, triangle:Triangle3D,
    surface_transform:Transform3D, normal:Math.Vec3, witness:Math.Vec3) {
    if !shape_triangle_front3d(transform, triangle, surface_transform) { return }
    let distance = box_triangle_distance(box, transform, triangle, surface_transform, true)
    if distance.separation > 0.000001 || distance.normal.dot(normal) < 0.99999 { return }
    let center = distance.first_point.add(distance.second_point).multiply(0.5)
    if Math.abs(center.subtract(witness).dot(normal)) > 0.00001 { return }
    let polygon:Math.Vec3[] = [surface_transform.point(triangle.first),
        surface_transform.point(triangle.second), surface_transform.point(triangle.third)]
    let clipped = clipped_box_face3d(box, transform, face, polygon, witness)
    for point in clipped { append_unique_contact3d(points, point) }
}

// Only an axis parallel to the selected surface needs two cap witnesses.
// The two extra queries run once during manifold generation, never per solver
// iteration. Keep the single witness at edges or across different face normals.
package func capsule_surface_contact_points(
    capsule:Capsule3D, transform:Transform3D, surface:ShapePlacement3D,
    normal:Math.Vec3, witness:Math.Vec3
) Math.Vec3[] {
    let axis = transform.vector(Math.Vec3.up())
    if Math.abs(axis.dot(normal)) > 0.001 { return [witness] }
    let shape = Shape3D.sphere(Sphere3D(capsule.radius))
    let first = contact_distance3d(ShapePlacement3D(shape, Transform3D(
        position:transform.position.subtract(axis.multiply(capsule.half_height)))), surface)
    let second = contact_distance3d(ShapePlacement3D(shape, Transform3D(
        position:transform.position.add(axis.multiply(capsule.half_height)))), surface)
    if first.normal.dot(normal) < 0.99999 || second.normal.dot(normal) < 0.99999 ||
        Math.abs(first.separation - second.separation) > 0.00001 ||
        Math.abs(first.first_point.add(first.second_point).multiply(0.5)
            .subtract(witness).dot(normal)) > 0.00001 {
        return [witness]
    }
    return [first.first_point.add(first.second_point).multiply(0.5),
        second.first_point.add(second.second_point).multiply(0.5)]
}

package func capsule_capsule_contact_points(
    first:Capsule3D, first_transform:Transform3D,
    second:Capsule3D, second_transform:Transform3D,
    normal:Math.Vec3, witness:Math.Vec3
) Math.Vec3[] {
    var points:Math.Vec3[] = []
    let first_axis = first_transform.vector(Math.Vec3.up())
    let second_axis = second_transform.vector(Math.Vec3.up())
    if Math.abs(first_axis.dot(second_axis)) < 0.95 ||
        Math.abs(first_axis.dot(normal)) > 0.1
    {
        points.append(witness)
        return points
    }
    let second_low = second_transform.position.subtract(
        second_axis.multiply(second.half_height)
    ).subtract(first_transform.position).dot(first_axis)
    let second_high = second_transform.position.add(
        second_axis.multiply(second.half_height)
    ).subtract(first_transform.position).dot(first_axis)
    let lower = Math.max(-first.half_height, Math.min(second_low, second_high))
    let upper = Math.min(first.half_height, Math.max(second_low, second_high))
    if upper - lower < 0.01 {
        points.append(witness)
        return points
    }
    let offsets:float[] = [lower, upper]
    for offset in offsets {
        let first_center = first_transform.position.add(first_axis.multiply(offset))
        let second_fraction = Math.clamp(
            first_center.subtract(second_transform.position).dot(second_axis),
            -second.half_height, second.half_height
        )
        let second_center = second_transform.position.add(
            second_axis.multiply(second_fraction)
        )
        points.append(first_center.add(normal.multiply(first.radius)).add(
            second_center.subtract(normal.multiply(second.radius))
        ).multiply(0.5))
    }
    return points
}

func box_face3d(box:Box3D, transform:Transform3D, normal:Math.Vec3) BoxFace3D {
    var selected_axis = 0
    var alignment = 0.0
    var sign = 1.0
    var axis = 0
    while axis < 3 {
        let projection = transform.vector(box_axis3d(axis)).dot(normal)
        if Math.abs(projection) > alignment {
            alignment = Math.abs(projection)
            selected_axis = axis
            if projection < 0.0 { sign = -1.0 } else { sign = 1.0 }
        }
        axis++
    }
    let half = box.half_size()
    var corners:Math.Vec3[] = []
    var index = 0
    let winding:int[] = [0, 1, 3, 2]
    while index < 4 {
        var local_point = Math.Vec3()
        let first_sign = corner_sign3d(winding[index] % 2)
        let second_sign = corner_sign3d(winding[index] / 2)
        if selected_axis == 0 {
            local_point = Math.Vec3(sign * half.x, first_sign * half.y, second_sign * half.z)
        } else if selected_axis == 1 {
            local_point = Math.Vec3(first_sign * half.x, sign * half.y, second_sign * half.z)
        } else {
            local_point = Math.Vec3(first_sign * half.x, second_sign * half.y, sign * half.z)
        }
        corners.append(transform.point(local_point))
        index++
    }
    return BoxFace3D(selected_axis, sign, alignment, corners)
}

func append_unique_contact3d(points:&Math.Vec3[], point:Math.Vec3) {
    for existing in points {
        if existing.distance(point) < 0.0001 { return }
    }
    points.append(point)
}

func box_axis3d(axis:int) Math.Vec3 {
    if axis == 0 { return Math.Vec3.right() }
    if axis == 1 { return Math.Vec3.up() }
    return Math.Vec3.back()
}

func corner_sign3d(bit:int) float {
    if bit == 0 { return -1.0 }
    return 1.0
}
