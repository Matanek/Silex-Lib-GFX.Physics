use STD.Math

public struct Box3D {
    let size:Math.Vec3

    init(size:Math.Vec3 = Math.Vec3(1.0)) {
        if !finite_box3d_value(size.x) || !finite_box3d_value(size.y) ||
            !finite_box3d_value(size.z) ||
            size.x <= 0.0 || size.y <= 0.0 || size.z <= 0.0
        {
            panic("GFX.Physics.Box3D requires finite positive dimensions")
        }
        self.size = size
    }

    func half_size() Math.Vec3 { return self.size.multiply(0.5) }
}

func finite_box3d_value(value:float) bool {
    return value == value && (value == 0.0 || value + value != value)
}
