use GFX.Physics.RigidBody3D.BodyId3D
use GFX.Physics.RigidBody3D.BodyStore3D
use GFX.Physics.RigidBody3D.RigidBody3D
use GFX.Physics.Transform3D.Transform3D
use GFX.Physics.RigidBody3D.finite_body3d_value
use STD.Math

public struct SliderMotor3D {
    let speed:float
    let minimum_force:float
    let maximum_force:float
    let target_position:float?
    let stiffness:float
    let damping:float

    init(speed:float, maximum_force:float) {
        if !finite_body3d_value(speed) || !finite_body3d_value(maximum_force) || maximum_force < 0.0 {
            panic("GFX.Physics.SliderMotor3D requires finite speed and nonnegative finite maximum force")
        }
        self.speed = speed
        self.minimum_force = -maximum_force
        self.maximum_force = maximum_force
        self.target_position = null
        self.stiffness = 0.0
        self.damping = 0.0
    }

    init(speed:float, minimum_force:float, maximum_force:float) {
        if !finite_body3d_value(speed) || !finite_body3d_value(minimum_force) ||
            !finite_body3d_value(maximum_force) || minimum_force > maximum_force
        {
            panic("GFX.Physics.SliderMotor3D requires finite speed and ordered finite force bounds")
        }
        self.speed = speed
        self.minimum_force = minimum_force
        self.maximum_force = maximum_force
        self.target_position = null
        self.stiffness = 0.0
        self.damping = 0.0
    }

    static func position(position:float, maximum_force:float, stiffness:float, damping:float) SliderMotor3D {
        return SliderMotor3D(position, maximum_force, stiffness, damping)
    }

    static func position(position:float, minimum_force:float, maximum_force:float,
        stiffness:float, damping:float) SliderMotor3D
    {
        return SliderMotor3D(position, minimum_force, maximum_force, stiffness, damping)
    }

    static func position_and_velocity(position:float, speed:float, maximum_force:float,
        stiffness:float, damping:float) SliderMotor3D
    {
        return SliderMotor3D(position, speed, -maximum_force, maximum_force, stiffness, damping)
    }

    static func position_and_velocity(position:float, speed:float, minimum_force:float,
        maximum_force:float, stiffness:float, damping:float) SliderMotor3D
    {
        return SliderMotor3D(position, speed, minimum_force, maximum_force, stiffness, damping)
    }

    private init(position:float, speed:float, minimum_force:float, maximum_force:float,
        stiffness:float, damping:float)
    {
        if !finite_body3d_value(position) || !finite_body3d_value(speed) ||
            !finite_body3d_value(minimum_force) || !finite_body3d_value(maximum_force) ||
            minimum_force > maximum_force || !finite_body3d_value(stiffness) || stiffness <= 0.0 ||
            !finite_body3d_value(damping) || damping < 0.0
        {
            panic("GFX.Physics.SliderMotor3D.position_and_velocity requires finite position and speed, ordered finite force bounds, positive finite stiffness and nonnegative finite damping")
        }
        self.speed = speed
        self.minimum_force = minimum_force
        self.maximum_force = maximum_force
        self.target_position = position
        self.stiffness = stiffness
        self.damping = damping
    }

    private init(position:float, minimum_force:float, maximum_force:float, stiffness:float, damping:float) {
        if !finite_body3d_value(position) || !finite_body3d_value(minimum_force) ||
            !finite_body3d_value(maximum_force) || minimum_force > maximum_force ||
            !finite_body3d_value(stiffness) || stiffness <= 0.0 ||
            !finite_body3d_value(damping) || damping < 0.0
        {
            panic("GFX.Physics.SliderMotor3D.position requires finite position, ordered finite force bounds, positive finite stiffness and nonnegative finite damping")
        }
        self.speed = 0.0
        self.minimum_force = minimum_force
        self.maximum_force = maximum_force
        self.target_position = position
        self.stiffness = stiffness
        self.damping = damping
    }

    private init(position:float, maximum_force:float, stiffness:float, damping:float) {
        if !finite_body3d_value(position) || !finite_body3d_value(maximum_force) || maximum_force < 0.0 ||
            !finite_body3d_value(stiffness) || stiffness <= 0.0 ||
            !finite_body3d_value(damping) || damping < 0.0
        {
            panic("GFX.Physics.SliderMotor3D.position requires finite position, nonnegative finite maximum force, positive finite stiffness and nonnegative finite damping")
        }
        self.speed = 0.0
        self.minimum_force = -maximum_force
        self.maximum_force = maximum_force
        self.target_position = position
        self.stiffness = stiffness
        self.damping = damping
    }
}

public struct SliderLimitSpring3D {
    let stiffness:float
    let damping:float

    init(stiffness:float, damping:float) {
        if !finite_body3d_value(stiffness) || stiffness <= 0.0 ||
            !finite_body3d_value(damping) || damping < 0.0
        {
            panic("GFX.Physics.SliderLimitSpring3D requires positive finite stiffness and nonnegative finite damping")
        }
        self.stiffness = stiffness
        self.damping = damping
    }
}

public struct SliderConstraint3DSettings {
    var first_local_frame:Transform3D = Transform3D()
    var second_local_frame:Transform3D = Transform3D()
    var motor:SliderMotor3D? = null
    var maximum_friction_force:float = 0.0
    var minimum_position:float? = null
    var maximum_position:float? = null
    var limit_spring:SliderLimitSpring3D? = null
    var is_enabled:bool = true
    init() {}
}

package struct SliderConstraintId3D {
    let slot:int
    let generation:int
    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

package class SliderConstraintState3D {
    let first_id:BodyId3D
    let second_id:BodyId3D
    var first_local_anchor:Math.Vec3
    var second_local_anchor:Math.Vec3
    var first_local_rotation:Math.Quat
    var second_local_rotation:Math.Quat
    var minimum_position:float?
    var maximum_position:float?
    var limit_spring:SliderLimitSpring3D?
    var limit_error:float = 0.0
    var motor:SliderMotor3D?
    var motor_impulse:float = 0.0
    var maximum_friction_force:float
    var friction_impulse:float = 0.0
    var motor_error:float = 0.0
    var limit_side:int = 0
    var limit_impulse:float = 0.0
    var angular_impulse:Math.Vec3 = Math.Vec3()
    var is_enabled:bool
    var impulse:Math.Vec3 = Math.Vec3()
    var inverse_delta:float = 0.0

    init(first_id:BodyId3D, second_id:BodyId3D, settings:SliderConstraint3DSettings) {
        validate_slider_limits3d(settings.minimum_position, settings.maximum_position)
        validate_slider_friction3d(settings.maximum_friction_force)
        self.maximum_friction_force = settings.maximum_friction_force
        self.motor = settings.motor
        self.minimum_position = settings.minimum_position
        self.maximum_position = settings.maximum_position
        self.limit_spring = settings.limit_spring
        self.first_id = first_id
        self.second_id = second_id
        self.first_local_anchor = settings.first_local_frame.position
        self.second_local_anchor = settings.second_local_frame.position
        self.first_local_rotation = settings.first_local_frame.rotation
        self.second_local_rotation = settings.second_local_frame.rotation
        self.is_enabled = settings.is_enabled
    }
}

package class SliderConstraintStore3D {
    var bodies:BodyStore3D
    var slots:SliderConstraintState3D?[] = []
    var generations:int[] = []
    var free_slots:int[] = []
    var live_count:int = 0

    init(bodies:BodyStore3D) { self.bodies = bodies }

    func invalidate_all() {
        self.slots = []
        self.generations = []
        self.free_slots = []
        self.live_count = 0
    }

    func append(first:@RigidBody3D, second:@RigidBody3D,
        settings:SliderConstraint3DSettings) SliderConstraintId3D
    {
        self.bodies.require_mutable()
        if !first.belongs_to(self.bodies) || !second.belongs_to(self.bodies) {
            panic("GFX.Physics.SliderConstraint3D requires bodies from its world")
        }
        if first.same_body(second) {
            panic("GFX.Physics.SliderConstraint3D requires two distinct bodies")
        }
        var first_state = self.bodies.require(first.body_id())
        var second_state = self.bodies.require(second.body_id())
        if first_state.inverse_mass == 0.0 && second_state.inverse_mass == 0.0 {
            panic("GFX.Physics.SliderConstraint3D requires a dynamic body")
        }
        var state = SliderConstraintState3D(first.body_id(), second.body_id(), settings)
        var slot = self.slots.count()
        if self.free_slots.count() > 0 {
            slot = self.free_slots.take_last()
            self.slots[slot] = state
        } else {
            self.slots.append(state)
            self.generations.append(0)
        }
        self.live_count++
        first_state.wake()
        second_state.wake()
        return SliderConstraintId3D(slot, self.generations[slot])
    }

    func contains(id:SliderConstraintId3D) bool {
        return id.slot >= 0 && id.slot < self.slots.count() &&
            self.generations[id.slot] == id.generation && self.slots[id.slot] != null
    }

    func require(id:SliderConstraintId3D) SliderConstraintState3D {
        if !self.contains(id) {
            panic("GFX.Physics.SliderConstraint3D no longer refers to a live constraint")
        }
        return self.slots[id.slot]!
    }

    func destroy(id:SliderConstraintId3D) {
        self.bodies.require_mutable()
        var state = self.require(id)
        self.bodies.require(state.first_id).wake()
        self.bodies.require(state.second_id).wake()
        self.slots[id.slot] = null
        self.generations[id.slot]++
        self.free_slots.append(id.slot)
        self.live_count--
    }

    func destroy_for_body(body_id:BodyId3D) {
        var slot = 0
        while slot < self.slots.count() {
            if var state = self.slots[slot] {
                if same_slider_body_id3d(state.first_id, body_id) ||
                    same_slider_body_id3d(state.second_id, body_id)
                {
                    var other_id = state.first_id
                    if same_slider_body_id3d(state.first_id, body_id) {
                        other_id = state.second_id
                    }
                    self.bodies.require(other_id).wake()
                    self.slots[slot] = null
                    self.generations[slot]++
                    self.free_slots.append(slot)
                    self.live_count--
                }
            }
            slot++
        }
    }
}

public class SliderConstraint3D {
    private var store:SliderConstraintStore3D
    private let id:SliderConstraintId3D

    package init(store:SliderConstraintStore3D, id:SliderConstraintId3D) {
        self.store = store
        self.id = id
    }

    func is_valid() bool { return self.store.contains(self.id) }
    package func belongs_to(store:SliderConstraintStore3D) bool {
        return self.store == store
    }
    package func constraint_id() SliderConstraintId3D { return self.id }
    func first_body() RigidBody3D {
        return RigidBody3D(self.store.bodies, self.store.require(self.id).first_id)
    }
    func second_body() RigidBody3D {
        return RigidBody3D(self.store.bodies, self.store.require(self.id).second_id)
    }
    func is_enabled() bool { return self.store.require(self.id).is_enabled }
    func first_local_frame() Transform3D {
        var state = self.store.require(self.id)
        return Transform3D(state.first_local_anchor, state.first_local_rotation)
    }
    func second_local_frame() Transform3D {
        var state = self.store.require(self.id)
        return Transform3D(state.second_local_anchor, state.second_local_rotation)
    }
    func angular_error() Math.Vec3 {
        var state = self.store.require(self.id)
        return slider_angular_error3d(self.store.bodies.require(state.first_id).transform,
            self.store.bodies.require(state.second_id).transform, state)
    }
    func reaction_torque() Math.Vec3 {
        var state = self.store.require(self.id)
        return state.angular_impulse.multiply(state.inverse_delta)
    }
    func anchor_error() Math.Vec3 {
        var state = self.store.require(self.id)
        var first = self.store.bodies.require(state.first_id)
        var second = self.store.bodies.require(state.second_id)
        let offset = second.transform.point(state.second_local_anchor).subtract(first.transform.point(state.first_local_anchor))
        let axis = slider_axis3d(first.transform, state)
        return offset.subtract(axis.multiply(offset.dot(axis)))
    }
    func reaction_force() Math.Vec3 {
        var state = self.store.require(self.id)
        return state.impulse.multiply(state.inverse_delta)
    }
    func position() float {
        var state = self.store.require(self.id)
        return slider_position3d(self.store.bodies.require(state.first_id).transform,
            self.store.bodies.require(state.second_id).transform, state)
    }
    func speed() float {
        var state = self.store.require(self.id)
        var first = self.store.bodies.require(state.first_id)
        var second = self.store.bodies.require(state.second_id)
        let point = second.transform.point(state.second_local_anchor)
        let first_radius = point.subtract(first.world_center())
        let second_radius = point.subtract(second.world_center())
        return second.linear_velocity.add(second.angular_velocity.cross(second_radius))
            .subtract(first.linear_velocity.add(first.angular_velocity.cross(first_radius)))
            .dot(slider_axis3d(first.transform, state))
    }
    func maximum_friction_force() float { return self.store.require(self.id).maximum_friction_force }
    func friction_force() float {
        var state = self.store.require(self.id)
        return state.friction_impulse * state.inverse_delta
    }
    func set_maximum_friction_force(force:float) {
        validate_slider_friction3d(force)
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.maximum_friction_force = force
        self.reset_reaction(state)
    }
    func motor() SliderMotor3D? { return self.store.require(self.id).motor }
    func motor_force() float {
        var state = self.store.require(self.id)
        return state.motor_impulse * state.inverse_delta
    }
    func set_motor(motor:SliderMotor3D?) {
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.motor = motor
        self.reset_reaction(state)
    }
    func minimum_position() float? { return self.store.require(self.id).minimum_position }
    func maximum_position() float? { return self.store.require(self.id).maximum_position }
    func limit_spring() SliderLimitSpring3D? { return self.store.require(self.id).limit_spring }
    func set_limit_spring(spring:SliderLimitSpring3D?) {
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.limit_spring = spring
        self.reset_reaction(state)
    }
    func limit_force() float {
        var state = self.store.require(self.id)
        return state.limit_impulse * state.inverse_delta
    }
    func set_limits(minimum:float?, maximum:float?) {
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        validate_slider_limits3d(minimum, maximum)
        state.minimum_position = minimum
        state.maximum_position = maximum
        self.reset_reaction(state)
    }
    func set_frames(first:Transform3D, second:Transform3D) {
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.first_local_anchor = first.position
        state.second_local_anchor = second.position
        state.first_local_rotation = first.rotation
        state.second_local_rotation = second.rotation
        self.reset_reaction(state)
    }
    private func reset_reaction(state:SliderConstraintState3D) {
        state.motor_impulse = 0.0
        state.friction_impulse = 0.0
        state.motor_error = 0.0
        state.limit_side = 0
        state.limit_error = 0.0
        state.limit_impulse = 0.0
        state.impulse = Math.Vec3()
        state.angular_impulse = Math.Vec3()
        state.inverse_delta = 0.0
        self.store.bodies.require(state.first_id).wake()
        self.store.bodies.require(state.second_id).wake()
    }
    func set_enabled(enabled:bool) {
        self.store.bodies.require_mutable()
        var state = self.store.require(self.id)
        state.is_enabled = enabled
        self.reset_reaction(state)
    }
}

package func same_slider_body_id3d(first:BodyId3D, second:BodyId3D) bool {
    return first.slot == second.slot && first.generation == second.generation
}

package func slider_angular_error3d(first:Transform3D, second:Transform3D,
    state:SliderConstraintState3D) Math.Vec3
{
    let first_rotation = first.rotation.multiply(state.first_local_rotation)
    let second_rotation = second.rotation.multiply(state.second_local_rotation)
    let difference = second_rotation.multiply(first_rotation.conjugated()).normalized()
    var axis = Math.Vec3(difference.x, difference.y, difference.z)
    if difference.w < 0.0 { axis = axis.negated() }
    let length = axis.length()
    if length <= 0.00000001 { return Math.Vec3() }
    return axis.multiply(2.0 * Math.atan2(length, Math.abs(difference.w)) / length)
}

func validate_slider_friction3d(force:float) {
    if !finite_body3d_value(force) || force < 0.0 {
        panic("GFX.Physics.SliderConstraint3D requires nonnegative finite maximum friction force")
    }
}

func validate_slider_limits3d(minimum:float?, maximum:float?) {
    if let lower = minimum {
        if !finite_body3d_value(lower) { panic("GFX.Physics.SliderConstraint3D requires ordered finite position limits") }
    }
    if let upper = maximum {
        if !finite_body3d_value(upper) { panic("GFX.Physics.SliderConstraint3D requires ordered finite position limits") }
        if let lower = minimum {
            if lower > upper { panic("GFX.Physics.SliderConstraint3D requires ordered finite position limits") }
        }
    }
}

package func slider_axis3d(first:Transform3D, state:SliderConstraintState3D) Math.Vec3 {
    return first.rotation.multiply(state.first_local_rotation).rotate(Math.Vec3(1.0, 0.0, 0.0))
}

package func slider_position3d(first:Transform3D, second:Transform3D,
    state:SliderConstraintState3D) float
{
    return second.point(state.second_local_anchor).subtract(first.point(state.first_local_anchor))
        .dot(slider_axis3d(first, state))
}
