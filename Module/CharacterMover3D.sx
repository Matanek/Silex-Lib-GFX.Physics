use GFX.Physics.Geometry3D.contact_distance3d
use GFX.Physics.Geometry3D.front_triangle_contact3d
use GFX.Physics.Capsule3D.Capsule3D
use GFX.Physics.CharacterContact3D.CharacterContact3D
use GFX.Physics.CollisionFilter3D.QueryFilter3D
use GFX.Physics.CollisionFilter3D.CollisionFilter3D
use GFX.Physics.Geometry3D.ShapePlacement3D
use GFX.Physics.Geometry3D.CastResult3D
use GFX.Physics.Shape3D.Shape3D
use GFX.Physics.Transform3D.Transform3D
use GFX.Physics.World3D.World3D
use GFX.Physics.World3D.CharacterShape3D
use GFX.Physics.RigidBody3D.BodyType3D
use GFX.Physics.RigidBody3D.RigidBody3D
use GFX.Physics.RigidBody3D.finite_body3d_value
use GFX.Physics.RigidBody3D.finite_body3d_point
use STD.Math

public struct CharacterMover3DSettings {
    var radius:float = 0.3
    var half_height:float = 0.55
    var max_slope_angle:float = 0.78539816
    var step_height:float = 0.4
    var step_forward:float = 0.18
    var floor_snap:float = 0.5
    var skin:float = 0.002
    var filter:QueryFilter3D
    var mass:float = 70.0
    var max_push_force:float = 100.0
    init() { self.filter = QueryFilter3D(include_sensors:false) }
}

public struct CharacterMoveResult3D {
    let position:Math.Vec3
    let grounded:bool
    let ground_normal:Math.Vec3
    let stepped:bool
    private var current_support:RigidBody3D?
    private let planes:Math.Vec3[]
    private var contacts:CharacterContact3D[]

    package init(position:Math.Vec3, grounded:bool, ground_normal:Math.Vec3,
        stepped:bool, support:RigidBody3D?, planes:Math.Vec3[], contacts:CharacterContact3D[] = []) {
        self.position = position
        self.grounded = grounded
        self.ground_normal = ground_normal
        self.stepped = stepped
        self.current_support = support
        self.planes = planes
        self.contacts = contacts
    }

    func support() RigidBody3D? { return self.current_support }
    func contact_count() int { return self.contacts.count() }
    func contact(index:int) CharacterContact3D { return self.contacts[index] }

    func clip_velocity(velocity:Math.Vec3) Math.Vec3 {
        return clip_planes(velocity, self.planes)
    }
}

local struct CharacterCast3D {
    let result:CastResult3D
    let candidate_index:int

    init(result:CastResult3D, candidate_index:int) {
        self.result = result
        self.candidate_index = candidate_index
    }
}

// Virtual upright capsule. Position is the capsule centre; gameplay owns
// velocity, gravity, jumping and the eye offset. No rigid body is registered.
public class CharacterMover3D {
    private var settings:CharacterMover3DSettings
    private var shape:Shape3D
    private let slope_cos:float
    private var candidates:CharacterShape3D[]
    private var previous_support:RigidBody3D?
    private var previous_support_pose:Transform3D
    private var previous_support_normal:Math.Vec3
    private var previous_contacts:CharacterContact3D[]
    private var excluded_body:RigidBody3D? = null
    private var pair_filter:CollisionFilter3D? = null

    init(settings:CharacterMover3DSettings = CharacterMover3DSettings()) {
        if !finite_body3d_value(settings.max_slope_angle) ||
            settings.max_slope_angle <= 0.0 || settings.max_slope_angle >= Math.pi() / 2.0 ||
            !finite_body3d_value(settings.step_height) || settings.step_height < 0.0 ||
            !finite_body3d_value(settings.step_forward) || settings.step_forward < 0.0 ||
            !finite_body3d_value(settings.floor_snap) || settings.floor_snap < 0.0 ||
            !finite_body3d_value(settings.skin) || settings.skin <= 0.0 || settings.skin >= settings.radius {
            panic("GFX.Physics.CharacterMover3D requires finite valid slope, step, snap and skin settings")
        }
        if !finite_body3d_value(settings.mass) || settings.mass < 0.0 ||
            !finite_body3d_value(settings.max_push_force) || settings.max_push_force < 0.0 {
            panic("GFX.Physics.CharacterMover3D requires finite non-negative mass and push force")
        }
        self.shape = Shape3D.capsule(Capsule3D(settings.radius, settings.half_height))
        self.settings = settings
        self.slope_cos = Math.cos(settings.max_slope_angle)
        self.candidates = []
        self.previous_support = null
        self.previous_support_pose = Transform3D()
        self.previous_support_normal = Math.Vec3.up()
        self.previous_contacts = []
    }

    package func attach_body(body:RigidBody3D) {
        self.excluded_body = body
        self.pair_filter = body.collision_filter()
    }
    private func allows_support(body:RigidBody3D) bool {
        if let filter = self.pair_filter { return filter.allows(body.collision_filter()) }
        return true
    }

    func capsule() Capsule3D {
        return Capsule3D(self.settings.radius, self.settings.half_height)
    }

    // Keep the bottom of the capsule fixed. A rejected shape leaves both the
    // movement history and current capsule unchanged.
    func try_resize(world:@World3D, position:Math.Vec3, capsule:Capsule3D) Math.Vec3? {
        if !finite_body3d_point(position) || capsule.radius <= self.settings.skin {
            panic("GFX.Physics.CharacterMover3D.try_resize requires a finite position and radius greater than skin")
        }
        let height = capsule.radius + capsule.half_height
        let current_height = self.settings.radius + self.settings.half_height
        let proposed_position = position.add(Math.Vec3(0.0, height - current_height, 0.0))
        if !finite_body3d_point(proposed_position) {
            panic("GFX.Physics.CharacterMover3D.try_resize requires a finite resulting position")
        }
        let proposed = Shape3D.capsule(capsule)
        let placement = ShapePlacement3D(proposed, Transform3D(proposed_position))
        let extent = Math.Vec3(capsule.radius, height, capsule.radius)
        var candidates:CharacterShape3D[] = []
        world.character_shapes(proposed_position.subtract(extent), proposed_position.add(extent),
            self.settings.filter, candidates, self.excluded_body, self.pair_filter)
        for target in candidates {
            if front_triangle_contact3d(placement, target.placement) &&
                contact_distance3d(placement, target.placement).separation < -0.00001 {
                return null
            }
        }
        self.settings.radius = capsule.radius
        self.settings.half_height = capsule.half_height
        self.shape = proposed
        self.candidates = []
        return proposed_position
    }

    // The application owns position; discard old support history when it
    // teleports or reuses the mover for a different logical character.
    func reset() {
        self.previous_support = null
        self.previous_support_pose = Transform3D()
        self.previous_support_normal = Math.Vec3.up()
        self.previous_contacts = []
        self.candidates = []
    }

    func calculate_move(world:@World3D, position:Math.Vec3,
        translation:Math.Vec3, was_grounded:bool = false) CharacterMoveResult3D {
        return self.solve_move(world, position, translation, was_grounded, false)
    }

    func move(world:@World3D, position:Math.Vec3, translation:Math.Vec3,
        delta:float, was_grounded:bool = false) CharacterMoveResult3D {
        if !finite_body3d_value(delta) || delta < 0.0 ||
            !finite_body3d_point(position) || !finite_body3d_point(translation) {
            panic("GFX.Physics.CharacterMover3D.move requires finite motion and non-negative duration")
        }
        if delta == 0.0 {
            var support:RigidBody3D? = null
            if let previous = self.previous_support {
                if was_grounded && world.valid_character_support(previous, self.settings.filter) && self.allows_support(previous) { support = previous }
            }
            return CharacterMoveResult3D(position, support != null, self.previous_support_normal, false, support, [], self.previous_contacts)
        }
        if !finite_body3d_point(translation.divide(delta)) ||
            !finite_body3d_value(self.settings.max_push_force * delta) ||
            !finite_body3d_value(self.settings.mass * world.gravity().length() * delta) {
            panic("GFX.Physics.CharacterMover3D.move requires finite velocity and impulse budgets")
        }
        var result = self.solve_move(world, position, translation, was_grounded, true)
        self.apply_interactions(world, result, translation, delta)
        return result
    }

    private func solve_move(world:@World3D, position:Math.Vec3,
        translation:Math.Vec3, was_grounded:bool, carry_dynamic:bool) CharacterMoveResult3D {
        if !finite_body3d_point(position) || !finite_body3d_point(translation) {
            panic("GFX.Physics.CharacterMover3D requires finite position and translation")
        }
        var carried_position = position
        if was_grounded {
            if let support = self.previous_support {
                if world.valid_character_support(support, self.settings.filter) && self.allows_support(support) &&
                    (support.body_type() == BodyType3D.kinematic ||
                        (carry_dynamic && support.body_type() == BodyType3D.dynamic)) {
                    carried_position = support.transform().point(
                        self.previous_support_pose.inverse_point(position))
                }
            }
        }
        let reach = self.settings.radius + self.settings.half_height +
            self.settings.step_height + self.settings.floor_snap +
            self.settings.step_forward + translation.length() +
            carried_position.subtract(position).length() + 0.1
        var candidates = self.candidates
        world.character_shapes(position.subtract(Math.Vec3(reach)),
            position.add(Math.Vec3(reach)), self.settings.filter, candidates, self.excluded_body, self.pair_filter)
        if carry_dynamic && self.settings.filter.include_sensors {
            var solids:CharacterShape3D[] = []
            for candidate in candidates { if !candidate.is_sensor { solids.append(candidate) } }
            self.candidates = solids
        } else { self.candidates = candidates }
        let start = self.recover(position)
        var planes:Math.Vec3[] = []
        var current = self.slide(start, carried_position.subtract(start).add(translation), planes)
        var stepped = false
        var step_normal = Math.Vec3.up()
        var support_index = -1
        let horizontal = Math.Vec3(translation.x, 0.0, translation.z)
        let length = horizontal.length()
        // Only grounded, non-jumping motion may use stairs. The complete lifted
        // capsule must fit, and a walkable landing must improve forward progress.
        if was_grounded && translation.y <= 0.0 && length > 0.00001 && self.settings.step_height > 0.0 {
            let direction = horizontal.divide(length)
            let progress = current.subtract(start).dot(direction)
            if progress < length - 0.0001 {
                let up = Math.Vec3(0.0, self.settings.step_height, 0.0)
                let ceiling = self.cast(start, up)
                if !ceiling.result.hit {
                    let raised = start.add(up)
                    let forward = horizontal
                    var step_planes:Math.Vec3[] = []
                    let across = self.slide(raised, forward, step_planes)
                    let down = Math.Vec3(0.0, -(self.settings.step_height + self.settings.floor_snap), 0.0)
                    let landing = self.cast(across, down)
                    var support = landing
                    var support_height = across.y + down.y * landing.result.fraction
                    // A short step can land on the capsule's rounded edge. Look
                    // ahead to qualify the tread, but never spend that distance
                    // as movement: the committed pose uses only the input budget.
                    if landing.result.hit && landing.result.normal.y > 0.0 &&
                        landing.result.normal.y < self.slope_cos &&
                        self.settings.step_forward > length {
                        var probe_planes:Math.Vec3[] = []
                        let probe = self.slide(raised, direction.multiply(self.settings.step_forward), probe_planes)
                        support = self.cast(probe, down)
                        support_height = probe.y + down.y * support.result.fraction
                    }
                    if landing.result.hit && landing.result.normal.y > 0.0 &&
                        support.result.hit && support.result.normal.y >= self.slope_cos {
                        let target = across.add(down.multiply(landing.result.fraction))
                        let rise = target.y - start.y
                        // Ground beyond a rock's side is not a stair tread:
                        // the qualified support must reach the edge contact height.
                        if support_height >= target.y - self.settings.skin &&
                            rise > self.settings.skin && rise <= self.settings.step_height + self.settings.skin &&
                            target.subtract(start).dot(direction) > progress + 0.0001 {
                            current = target
                            planes = step_planes
                            step_normal = support.result.normal
                            support_index = landing.candidate_index
                            // Step height is positional correction, not launch
                            // velocity from projecting onto the sampled edge.
                            planes.append(Math.Vec3.up())
                            stepped = true
                        }
                    }
                }
            }
        }
        var grounded = stepped
        var normal = step_normal
        if translation.y <= 0.0 {
            var snap = self.settings.skin * 3.0
            if was_grounded { snap = Math.max(snap, self.settings.floor_snap) }
            let down = Math.Vec3(0.0, -snap, 0.0)
            let floor = self.cast(current, down)
            if floor.result.hit && floor.result.normal.y >= self.slope_cos {
                current = current.add(down.multiply(floor.result.fraction))
                grounded = true
                normal = floor.result.normal
                support_index = floor.candidate_index
                if stepped { planes.append(Math.Vec3.up()) }
                else { planes.append(normal) }
            }
        }
        var support_body:RigidBody3D? = null
        if grounded && support_index >= 0 {
            var body = world.character_body(self.candidates[support_index].body_id)
            support_body = body
            self.previous_support_pose = body.transform()
        }
        self.previous_support = support_body
        self.previous_support_normal = normal
        var contacts:CharacterContact3D[] = []
        let placement = ShapePlacement3D(self.shape, Transform3D(current))
        for target in candidates {
            if !front_triangle_contact3d(placement, target.placement) { continue }
            let distance = contact_distance3d(placement, target.placement)
            if distance.separation <= self.settings.skin + 0.00002 {
                var body = world.character_body(target.body_id)
                contacts.append(CharacterContact3D(body, distance.second_point,
                    distance.normal.negated(), distance.separation))
            }
        }
        self.previous_contacts = contacts
        return CharacterMoveResult3D(current, grounded, normal, stepped, support_body, planes, contacts)
    }

    private func apply_interactions(world:@World3D, result:CharacterMoveResult3D,
        translation:Math.Vec3, delta:float) {
        let velocity = translation.divide(delta)
        var affected:RigidBody3D[] = []
        var spent:float[] = []
        var shares:int[] = []
        var index = 0
        while index < result.contact_count() {
            let contact = result.contact(index)
            var body = contact.body()
            if body.body_type() == BodyType3D.dynamic && !body.is_sensor() {
                var selected = -1
                var other = 0
                while other < affected.count() {
                    if affected[other].same_body(body) { selected = other; break }
                    other++
                }
                if selected < 0 {
                    selected = affected.count(); affected.append(body); spent.append(0.0)
                    var count = 0; var target = 0
                    while target < result.contact_count() {
                        if result.contact(target).body().same_body(body) { count++ }
                        target++
                    }
                    shares.append(count)
                }
                let normal = contact.normal.negated()
                let closing = velocity.subtract(body.velocity_at(contact.position)).dot(normal)
                let change = 0.9 * closing - 0.4 * Math.min(contact.separation, 0.0) / delta
                let inverse_mass = body.inverse_mass_at(contact.position, normal)
                let budget = Math.min(self.settings.max_push_force * delta / shares[selected] as float,
                    Math.max(0.0, self.settings.max_push_force * delta - spent[selected]))
                if change > 0.0 && inverse_mass > 0.0 && budget > 0.0 {
                    var impulse = normal.multiply(Math.min(change / inverse_mass, budget))
                    // Support weight is transferred below, separately from the push budget.
                    if impulse.y < 0.0 { impulse.y = 0.0 }
                    if impulse.length_squared() > 0.0 {
                        body.apply_impulse(impulse, contact.position)
                        spent[selected] += impulse.length()
                    }
                }
            }
            index++
        }
        if result.grounded && self.settings.mass > 0.0 {
            if var support = result.support() {
                if support.body_type() == BodyType3D.dynamic && !support.is_sensor() {
                    let gravity = world.gravity()
                    let length = gravity.length()
                    let projection = result.ground_normal.dot(gravity)
                    if length > 0.0 && projection < 0.0 {
                        var point = result.position.subtract(Math.Vec3(0.0,
                            self.settings.radius + self.settings.half_height, 0.0))
                        var contact_index = 0
                        while contact_index < result.contact_count() {
                            let contact = result.contact(contact_index)
                            if contact.body().same_body(support) && contact.normal.dot(result.ground_normal) > 0.99 {
                                point = contact.position; break
                            }
                            contact_index++
                        }
                        support.apply_impulse(gravity.multiply(-self.settings.mass * projection / length * delta), point)
                    }
                }
            }
        }
    }

    private func recover(position:Math.Vec3) Math.Vec3 {
        var current = position
        var pass = 0
        while pass < 8 {
            var corrected = false
            for target in self.candidates {
                let placement = ShapePlacement3D(self.shape, Transform3D(position:current))
                if !front_triangle_contact3d(placement, target.placement) { continue }
                let distance = contact_distance3d(placement, target.placement)
                if distance.separation < -0.00001 {
                    current = current.subtract(distance.normal.multiply(
                        Math.min(-distance.separation + self.settings.skin, self.settings.radius)))
                    corrected = true
                }
            }
            if !corrected { break }
            pass++
        }
        return current
    }

    private func slide(position:Math.Vec3, translation:Math.Vec3,
        planes:&Math.Vec3[]) Math.Vec3 {
        var current = position
        var remaining = translation
        var pass = 0
        while pass < 8 && remaining.length_squared() > 0.0000000001 {
            let hit = self.cast(current, remaining)
            if !hit.result.hit { return current.add(remaining) }
            current = current.add(remaining.multiply(hit.result.fraction))
            var normal = hit.result.normal
            // A steep face cannot turn horizontal input into upward motion.
            // Gravity is still allowed to slide down the actual face.
            if normal.y > 0.0 && normal.y < self.slope_cos && translation.y >= -0.00001 {
                normal = Math.Vec3(normal.x, 0.0, normal.z).normalized()
            }
            planes.append(normal)
            if hit.result.normal.y > 0.0 && hit.result.normal.y < self.slope_cos && translation.y < -0.00001 {
                // A downward request must not acquire lift from horizontal input
                // on a steep face. Keep the real plane for downhill sliding.
                planes.append(Math.Vec3(0.0, -1.0, 0.0))
            }
            remaining = clip_planes(remaining.multiply(1.0 - hit.result.fraction), planes)
            pass++
        }
        return current
    }

    private func cast(position:Math.Vec3, translation:Math.Vec3) CharacterCast3D {
        var closest = CharacterCast3D(CastResult3D(), -1)
        var index = 0
        while index < self.candidates.count() {
            let target = self.candidates[index]
            var fraction = 0.0
            var iteration = 0
            while iteration < 32 {
                let at = position.add(translation.multiply(fraction))
                let placement = ShapePlacement3D(self.shape, Transform3D(position:at))
                if !front_triangle_contact3d(placement, target.placement) { break }
                let distance = contact_distance3d(placement, target.placement)
                let approaching = translation.dot(distance.normal)
                // Match clip_planes: a residual it treats as tangent must not
                // become another zero-fraction contact and stall the slide.
                if approaching <= 0.000001 { break }
                if distance.separation <= self.settings.skin + 0.00001 {
                    if !closest.result.hit || fraction < closest.result.fraction {
                        closest = CharacterCast3D(CastResult3D(distance.second_point,
                            distance.normal.negated(), fraction), index)
                    }
                    break
                }
                if iteration == 31 {
                    // Exhaustion stops at the last proven free pose rather than
                    // accepting unchecked remaining motion through a thin shape.
                    if !closest.result.hit || fraction < closest.result.fraction {
                        closest = CharacterCast3D(CastResult3D(distance.second_point,
                            distance.normal.negated(), fraction), index)
                    }
                    break
                }
                fraction += (distance.separation - self.settings.skin) / approaching
                if fraction > 1.0 || (closest.result.hit && fraction > closest.result.fraction) { break }
                iteration++
            }
            index++
        }
        return closest
    }
}

func clip_planes(vector:Math.Vec3, planes:@Math.Vec3[]) Math.Vec3 {
    var clipped = vector
    var pass = 0
    while pass < 8 {
        var changed = false
        for normal in planes {
            let inward = clipped.dot(normal)
            if inward < -0.000001 {
                clipped = clipped.subtract(normal.multiply(inward))
                changed = true
            }
        }
        if !changed { break }
        pass++
    }
    return clipped
}
