use STD.Math

public struct Box2D {
    let size:Math.Vec2
    let radius:float

    init(size:Math.Vec2 = Math.Vec2(1.0), radius:float = 0.0) {
        if size.x <= 0.0 || size.y <= 0.0 {
            panic("GFX.Physics.Box2D requires positive dimensions")
        }
        if !finite_box_value(size.x) || !finite_box_value(size.y) ||
            !finite_box_value(radius) || radius < 0.0 ||
            radius > Math.min(size.x, size.y) * 0.5
        {
            panic("GFX.Physics.Box2D requires a finite corner radius within its half extents")
        }
        self.size = size
        self.radius = radius
    }

    module func half_size() Math.Vec2 { return self.size.multiply(0.5) }
}

func finite_box_value(value:float) bool {
    return value == value && (value == 0.0 || value + value != value)
}
