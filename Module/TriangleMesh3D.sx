use GFX.Physics.HeightGridData3D.HeightGridData3D
use GFX.Physics.Triangle3D.Triangle3D
use STD.Math

public enum HeightGridDiagonal3D {
    column_to_row
    first_to_opposite
}

public class TriangleMesh3D {
    private var triangles:Triangle3D[]
    private var grid:HeightGridData3D?

    init(triangles:Triangle3D[]) {
        if triangles.count() == 0 {
            panic("GFX.Physics.TriangleMesh3D requires at least one triangle")
        }
        self.grid = null
        self.triangles = []
        for triangle in triangles { self.triangles.append(triangle) }
    }

    static func from_height_grid(
        columns:int, rows:int, heights:float[],
        column_spacing:float, row_spacing:float,
        holes:bool[] = [],
        diagonal:HeightGridDiagonal3D = HeightGridDiagonal3D.column_to_row
    ) TriangleMesh3D {
        return TriangleMesh3D(HeightGridData3D(columns, rows, heights, column_spacing, row_spacing, holes, diagonal))
    }

    package init(triangles:HeightGridData3D) { self.triangles = []; self.grid = triangles }

    func triangle_count() int {
        if let grid = self.grid { return grid.triangle_count() }
        return self.triangles.count()
    }
    func triangle(index:int) Triangle3D {
        if let grid = self.grid { return grid.triangle(index) }
        return self.triangles[index]
    }
}
