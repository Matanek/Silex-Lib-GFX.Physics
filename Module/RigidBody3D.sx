use GFX.Physics.ConvexHull3D.ConvexHull3D
use GFX.Physics.Box3D.Box3D
use GFX.Physics.Shape3D.Shape3D
use GFX.Physics.Sphere3D.Sphere3D
use GFX.Physics.Transform3D.Transform3D
use GFX.Physics.CollisionFilter3D.CollisionFilter3D
use STD.Math

public enum BodyType3D {
    fixed
    kinematic
    dynamic
}

public struct MassProperties3D {
    let mass:float
    let local_center:Math.Vec3
    let local_inertia:Math.Vec3
    let inertia_tensor:Math.Mat3

    init(mass:float, local_inertia:Math.Vec3, local_center:Math.Vec3 = Math.Vec3()) {
        if !finite_body3d_value(mass) || mass < 0.0 ||
            !finite_body3d_point(local_center) || !finite_body3d_point(local_inertia) ||
            local_inertia.x < 0.0 || local_inertia.y < 0.0 || local_inertia.z < 0.0
        {
            panic("GFX.Physics.MassProperties3D requires finite non-negative mass and inertia")
        }
        self.mass = mass
        self.local_center = local_center
        self.local_inertia = local_inertia
        self.inertia_tensor = diagonal_inertia3d(local_inertia)
    }

    init(mass:float, local_inertia:Math.Mat3, local_center:Math.Vec3 = Math.Vec3()) {
        let inertia_tensor = local_inertia
        let scale = Math.max(Math.abs(inertia_tensor.x.x),
            Math.max(Math.abs(inertia_tensor.y.y), Math.abs(inertia_tensor.z.z)))
        if !finite_body3d_value(mass) || mass <= 0.0 ||
            !finite_body3d_point(local_center) || !finite_inertia3d(inertia_tensor) ||
            scale <= 0.0 {
            panic("GFX.Physics.MassProperties3D requires a positive symmetric inertia tensor")
        }
        let normalized = inertia_tensor.multiply(1.0 / scale)
        if Math.abs(inertia_tensor.x.y - inertia_tensor.y.x) > 0.00001 * scale ||
            Math.abs(inertia_tensor.x.z - inertia_tensor.z.x) > 0.00001 * scale ||
            Math.abs(inertia_tensor.y.z - inertia_tensor.z.y) > 0.00001 * scale ||
            inertia_tensor.x.x <= 0.0 ||
            normalized.x.x * normalized.y.y -
                normalized.x.y * normalized.y.x <= 0.0 ||
            normalized.determinant() <= 0.0
        {
            panic("GFX.Physics.MassProperties3D requires a positive symmetric inertia tensor")
        }
        self.mass = mass
        self.local_center = local_center
        self.local_inertia = Math.Vec3(inertia_tensor.x.x,
            inertia_tensor.y.y, inertia_tensor.z.z)
        self.inertia_tensor = inertia_tensor
    }
}

public struct RigidBody3DSettings {
    var body_type:BodyType3D
    var shape:Shape3D
    var transform:Transform3D
    var linear_velocity:Math.Vec3
    var angular_velocity:Math.Vec3
    var density:float
    var mass_properties:MassProperties3D?
    var gravity_scale:float
    var linear_damping:float
    var angular_damping:float
    var friction:float
    var restitution:float
    var collision_filter:CollisionFilter3D
    var is_sensor:bool
    var continuous_collision:bool
    var is_enabled:bool
    var allow_sleep:bool
    var sleep_threshold:float

    init() {
        self.body_type = BodyType3D.dynamic
        self.shape = Shape3D.sphere(Sphere3D())
        self.transform = Transform3D()
        self.linear_velocity = Math.Vec3()
        self.angular_velocity = Math.Vec3()
        self.density = 1.0
        self.mass_properties = null
        self.gravity_scale = 1.0
        self.linear_damping = 0.0
        self.angular_damping = 0.0
        self.friction = 0.6
        self.restitution = 0.0
        self.collision_filter = CollisionFilter3D()
        self.is_sensor = false
        self.continuous_collision = false
        self.is_enabled = true
        self.allow_sleep = true
        self.sleep_threshold = 0.05
    }
}

package struct BodyId3D {
    let slot:int
    let generation:int
    init(slot:int, generation:int) {
        self.slot = slot
        self.generation = generation
    }
}

package class BodyState3D {
    var body_type:BodyType3D
    var shape:Shape3D
    var shape_revision:int
    var transform:Transform3D
    var linear_velocity:Math.Vec3
    var angular_velocity:Math.Vec3
    var force:Math.Vec3
    var torque:Math.Vec3
    var mass_properties:MassProperties3D
    var inverse_mass:float
    var inverse_inertia:Math.Vec3
    var inverse_inertia_tensor:Math.Mat3
    var has_cross_inertia:bool
    var density:float
    var gravity_scale:float
    var linear_damping:float
    var angular_damping:float
    var friction:float
    var restitution:float
    var collision_filter:CollisionFilter3D
    var is_sensor:bool
    var continuous_collision:bool
    var is_enabled:bool
    var allow_sleep:bool
    var sleep_threshold:float
    var awake:bool
    var sleep_time:float
    var target:Transform3D?
    var target_remaining:float

    init(settings:RigidBody3DSettings) {
        if !finite_body3d_point(settings.linear_velocity) ||
            !finite_body3d_point(settings.angular_velocity) ||
            !finite_body3d_value(settings.density) || settings.density <= 0.0 ||
            !finite_body3d_value(settings.gravity_scale) ||
            !finite_body3d_value(settings.linear_damping) || settings.linear_damping < 0.0 ||
            !finite_body3d_value(settings.angular_damping) || settings.angular_damping < 0.0 ||
            !finite_body3d_value(settings.sleep_threshold) || settings.sleep_threshold < 0.0
        {
            panic("GFX.Physics.RigidBody3DSettings requires finite motion, density, damping and sleep threshold")
        }
        validate_material3d(settings.friction, settings.restitution)
        match settings.shape {
            compound(_) => {}
            sphere(_) => {}
            box(_) => {}
            capsule(_) => {}
            triangle(_) => {
                if settings.body_type != BodyType3D.fixed {
                    panic("GFX.Physics.Triangle3D requires a fixed body")
                }
            }
            convex(_) => {}
            mesh(_) => {
                if settings.body_type != BodyType3D.fixed {
                    panic("GFX.Physics.TriangleMesh3D requires a fixed body")
                }
            }
            cylinder(_) => {}
            tapered_cylinder(_) => {}
            tapered_capsule(_) => {}
        }
        if settings.body_type == BodyType3D.fixed &&
            (settings.linear_velocity.length_squared() > 0.0 ||
                settings.angular_velocity.length_squared() > 0.0)
        {
            panic("GFX.Physics.RigidBody3DSettings fixed body requires zero velocity")
        }
        if settings.body_type != BodyType3D.dynamic && settings.mass_properties != null {
            panic("GFX.Physics.RigidBody3DSettings mass override requires a dynamic body")
        }
        if settings.body_type != BodyType3D.dynamic && settings.continuous_collision {
            panic("GFX.Physics continuous collision requires a dynamic body")
        }
        self.body_type = settings.body_type
        self.shape = settings.shape
        self.shape_revision = 0
        self.transform = Transform3D(settings.transform.position, settings.transform.rotation)
        self.linear_velocity = settings.linear_velocity
        self.angular_velocity = settings.angular_velocity
        self.force = Math.Vec3()
        self.torque = Math.Vec3()
        var properties = MassProperties3D(0.0, Math.Vec3())
        if let selected = settings.mass_properties {
            properties = selected
        } else if settings.body_type == BodyType3D.dynamic {
            properties = shape_mass_properties3d(settings.shape, settings.density)
        }
        if settings.body_type == BodyType3D.dynamic {
            require_dynamic_mass3d(properties)
            self.mass_properties = properties
            self.inverse_mass = 1.0 / properties.mass
            self.inverse_inertia = Math.Vec3(
                1.0 / properties.local_inertia.x,
                1.0 / properties.local_inertia.y,
                1.0 / properties.local_inertia.z
            )
            self.inverse_inertia_tensor = invert_inertia3d(properties.inertia_tensor)
            self.has_cross_inertia = cross_inertia3d(properties.inertia_tensor)
        } else {
            self.mass_properties = MassProperties3D(0.0, Math.Vec3())
            self.inverse_mass = 0.0
            self.inverse_inertia = Math.Vec3()
            self.inverse_inertia_tensor = Math.Mat3.zero()
            self.has_cross_inertia = false
        }
        self.density = settings.density
        self.gravity_scale = settings.gravity_scale
        self.linear_damping = settings.linear_damping
        self.angular_damping = settings.angular_damping
        self.friction = settings.friction
        self.restitution = settings.restitution
        self.collision_filter = settings.collision_filter
        self.is_sensor = settings.is_sensor
        self.continuous_collision = settings.continuous_collision
        self.is_enabled = settings.is_enabled
        self.allow_sleep = settings.allow_sleep
        self.sleep_threshold = settings.sleep_threshold
        self.awake = settings.is_enabled && settings.body_type == BodyType3D.dynamic
        self.sleep_time = 0.0
        self.target = null
        self.target_remaining = 0.0
    }

    func world_center() Math.Vec3 {
        return self.transform.point(self.mass_properties.local_center)
    }

    func apply_dynamic_mass_properties(properties:MassProperties3D) {
        require_dynamic_mass3d(properties)
        let previous_center = self.world_center()
        self.mass_properties = properties
        self.inverse_mass = 1.0 / properties.mass
        self.inverse_inertia = Math.Vec3(
            1.0 / properties.local_inertia.x,
            1.0 / properties.local_inertia.y,
            1.0 / properties.local_inertia.z
        )
        self.inverse_inertia_tensor = invert_inertia3d(properties.inertia_tensor)
        self.has_cross_inertia = cross_inertia3d(properties.inertia_tensor)
        self.linear_velocity = self.linear_velocity.add(
            self.angular_velocity.cross(self.world_center().subtract(previous_center))
        )
        self.wake()
    }

    func wake() {
        if self.body_type == BodyType3D.dynamic && self.is_enabled {
            self.awake = true
            self.sleep_time = 0.0
        }
    }

    func inverse_inertia_times(world_vector:Math.Vec3) Math.Vec3 {
        if self.body_type != BodyType3D.dynamic { return Math.Vec3() }
        // A scalar inertia tensor is invariant under rotation (cubes/spheres,
        // or any custom mass properties with equal principal moments).
        if !self.has_cross_inertia &&
            self.inverse_inertia.x == self.inverse_inertia.y &&
            self.inverse_inertia.y == self.inverse_inertia.z {
            return world_vector.multiply(self.inverse_inertia.x)
        }
        let local_vector = self.transform.rotation.conjugated().rotate(world_vector)
        if self.has_cross_inertia {
            return self.transform.rotation.rotate(
                self.inverse_inertia_tensor.multiply(local_vector))
        }
        return self.transform.rotation.rotate(local_vector.multiply(self.inverse_inertia))
    }

    func inertia_times(world_vector:Math.Vec3) Math.Vec3 {
        let local_vector = self.transform.rotation.conjugated().rotate(world_vector)
        if self.has_cross_inertia {
            return self.transform.rotation.rotate(
                self.mass_properties.inertia_tensor.multiply(local_vector))
        }
        return self.transform.rotation.rotate(local_vector.multiply(self.mass_properties.local_inertia))
    }
}

package class BodyStore3D {
    var slots:BodyState3D?[] = []
    var generations:int[] = []
    var free_slots:int[] = []
    var live_count:int = 0
    var locked:bool = false

    func invalidate_all() {
        self.slots = []
        self.generations = []
        self.free_slots = []
        self.live_count = 0
    }

    func require_mutable() {
        if self.locked { panic("GFX.Physics.World3D cannot be modified during step") }
    }

    func append(settings:RigidBody3DSettings) BodyId3D {
        self.require_mutable()
        var state = BodyState3D(settings)
        var slot = self.slots.count()
        if self.free_slots.count() > 0 {
            slot = self.free_slots.take_last()
            self.slots[slot] = state
        } else {
            self.slots.append(state)
            self.generations.append(0)
        }
        self.live_count++
        return BodyId3D(slot, self.generations[slot])
    }

    func contains(id:BodyId3D) bool {
        return id.slot >= 0 && id.slot < self.slots.count() &&
            self.generations[id.slot] == id.generation && self.slots[id.slot] != null
    }

    func require(id:BodyId3D) BodyState3D {
        if !self.contains(id) {
            panic("GFX.Physics.RigidBody3D no longer refers to a live body")
        }
        return self.slots[id.slot]!
    }

    func destroy(id:BodyId3D) {
        self.require_mutable()
        self.require(id)
        self.slots[id.slot] = null
        self.generations[id.slot]++
        self.free_slots.append(id.slot)
        self.live_count--
    }

    func wake_all() {
        for slot in self.slots {
            if var state = slot { state.wake() }
        }
    }
}

public class RigidBody3D {
    private var store:BodyStore3D
    private let id:BodyId3D

    package init(store:BodyStore3D, id:BodyId3D) {
        self.store = store
        self.id = id
    }

    func is_valid() bool { return self.store.contains(self.id) }
    func same_body(other:@RigidBody3D) bool {
        return self.store == other.store && self.id.slot == other.id.slot &&
            self.id.generation == other.id.generation
    }
    package func belongs_to(store:BodyStore3D) bool { return self.store == store }
    package func body_id() BodyId3D { return self.id }
    func body_type() BodyType3D { return self.store.require(self.id).body_type }
    func shape() Shape3D { return self.store.require(self.id).shape }
    func transform() Transform3D { return self.store.require(self.id).transform }
    func position() Math.Vec3 { return self.transform().position }
    func rotation() Math.Quat { return self.transform().rotation }
    func linear_velocity() Math.Vec3 { return self.store.require(self.id).linear_velocity }
    func angular_velocity() Math.Vec3 { return self.store.require(self.id).angular_velocity }
    func mass_properties() MassProperties3D { return self.store.require(self.id).mass_properties }
    func world_center_of_mass() Math.Vec3 { return self.store.require(self.id).world_center() }
    func is_enabled() bool { return self.store.require(self.id).is_enabled }
    func friction() float { return self.store.require(self.id).friction }
    func restitution() float { return self.store.require(self.id).restitution }
    func collision_filter() CollisionFilter3D {
        return self.store.require(self.id).collision_filter
    }
    func is_sensor() bool { return self.store.require(self.id).is_sensor }
    func continuous_collision() bool {
        return self.store.require(self.id).continuous_collision
    }
    func is_awake() bool { return self.store.require(self.id).awake }
    func is_sleep_enabled() bool { return self.store.require(self.id).allow_sleep }
    func sleep_threshold() float { return self.store.require(self.id).sleep_threshold }

    func wake_up() {
        self.store.require_mutable()
        self.store.require(self.id).wake()
    }

    func set_sleep_enabled(enabled:bool) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        state.allow_sleep = enabled
        if !enabled { state.wake() }
    }

    func set_sleep_threshold(threshold:float) {
        if !finite_body3d_value(threshold) || threshold < 0.0 {
            panic("GFX.Physics.RigidBody3D sleep threshold must be finite and non-negative")
        }
        self.store.require_mutable()
        var state = self.store.require(self.id)
        state.sleep_threshold = threshold
        state.wake()
    }

    func set_material(friction:float, restitution:float) {
        validate_material3d(friction, restitution)
        self.store.require_mutable()
        var state = self.store.require(self.id)
        state.friction = friction
        state.restitution = restitution
        self.store.wake_all()
    }

    func set_collision_filter(filter:CollisionFilter3D) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        state.collision_filter = filter
        self.store.wake_all()
    }

    func set_sensor(enabled:bool) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        state.is_sensor = enabled
        self.store.wake_all()
    }

    func set_continuous_collision(enabled:bool) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        if enabled && state.body_type != BodyType3D.dynamic {
            panic("GFX.Physics continuous collision requires a dynamic body")
        }
        state.continuous_collision = enabled
        state.wake()
    }

    func set_enabled(enabled:bool) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        state.is_enabled = enabled
        self.store.wake_all()
        if !enabled { state.awake = false }
    }

    func set_transform(transform:Transform3D) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        state.transform = Transform3D(transform.position, transform.rotation)
        state.target = null
        state.target_remaining = 0.0
        self.store.wake_all()
    }

    func set_shape(shape:Shape3D) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        match shape {
            triangle(_) => {
                if state.body_type != BodyType3D.fixed {
                    panic("GFX.Physics.Triangle3D requires a fixed body")
                }
            }
            convex(_) => {}
            mesh(_) => {
                if state.body_type != BodyType3D.fixed {
                    panic("GFX.Physics.TriangleMesh3D requires a fixed body")
                }
            }
            sphere(_) => {}
            box(_) => {}
            capsule(_) => {}
            compound(_) => {}
            cylinder(_) => {}
            tapered_cylinder(_) => {}
            tapered_capsule(_) => {}
        }
        var properties = MassProperties3D(0.0, Math.Vec3())
        if state.body_type == BodyType3D.dynamic {
            properties = shape_mass_properties3d(shape, state.density)
            require_dynamic_mass3d(properties)
        }
        state.shape = shape
        state.shape_revision++
        if state.body_type == BodyType3D.dynamic {
            state.apply_dynamic_mass_properties(properties)
        }
        self.store.wake_all()
    }

    func set_linear_velocity(velocity:Math.Vec3) {
        if !finite_body3d_point(velocity) { panic("GFX.Physics.RigidBody3D requires finite linear velocity") }
        self.store.require_mutable()
        var state = self.store.require(self.id)
        if state.body_type == BodyType3D.fixed { panic("GFX.Physics.RigidBody3D fixed body cannot move") }
        state.linear_velocity = velocity
        state.target = null
        state.wake()
    }

    func set_angular_velocity(velocity:Math.Vec3) {
        if !finite_body3d_point(velocity) { panic("GFX.Physics.RigidBody3D requires finite angular velocity") }
        self.store.require_mutable()
        var state = self.store.require(self.id)
        if state.body_type == BodyType3D.fixed { panic("GFX.Physics.RigidBody3D fixed body cannot rotate") }
        state.angular_velocity = velocity
        state.target = null
        state.wake()
    }

    func set_mass_properties(properties:MassProperties3D) {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        if state.body_type != BodyType3D.dynamic {
            panic("GFX.Physics.RigidBody3D mass override requires a dynamic body")
        }
        state.apply_dynamic_mass_properties(properties)
    }

    private func dynamic_state() BodyState3D {
        self.store.require_mutable()
        var state = self.store.require(self.id)
        if state.body_type != BodyType3D.dynamic {
            panic("GFX.Physics.RigidBody3D force and impulse require a dynamic body")
        }
        state.wake()
        return state
    }

    func apply_force(force:Math.Vec3, point:Math.Vec3? = null) {
        if !finite_body3d_point(force) { panic("GFX.Physics.RigidBody3D requires finite force") }
        if let world_point = point {
            if !finite_body3d_point(world_point) { panic("GFX.Physics.RigidBody3D requires finite force point") }
        }
        var state = self.dynamic_state()
        state.force = state.force.add(force)
        if let world_point = point {
            state.torque = state.torque.add(world_point.subtract(state.world_center()).cross(force))
        }
    }

    func apply_torque(torque:Math.Vec3) {
        if !finite_body3d_point(torque) { panic("GFX.Physics.RigidBody3D requires finite torque") }
        var state = self.dynamic_state()
        state.torque = state.torque.add(torque)
    }

    func apply_impulse(impulse:Math.Vec3, point:Math.Vec3? = null) {
        if !finite_body3d_point(impulse) { panic("GFX.Physics.RigidBody3D requires finite impulse") }
        if let world_point = point {
            if !finite_body3d_point(world_point) { panic("GFX.Physics.RigidBody3D requires finite impulse point") }
        }
        var state = self.dynamic_state()
        state.linear_velocity = state.linear_velocity.add(impulse.multiply(state.inverse_mass))
        if let world_point = point {
            let angular_impulse = world_point.subtract(state.world_center()).cross(impulse)
            state.angular_velocity = state.angular_velocity.add(
                state.inverse_inertia_times(angular_impulse)
            )
        }
    }

    func apply_angular_impulse(impulse:Math.Vec3) {
        if !finite_body3d_point(impulse) { panic("GFX.Physics.RigidBody3D requires finite angular impulse") }
        var state = self.dynamic_state()
        state.angular_velocity = state.angular_velocity.add(state.inverse_inertia_times(impulse))
    }

    func move_kinematic(target:Transform3D, duration:float) {
        if !finite_body3d_value(duration) || duration <= 0.0 {
            panic("GFX.Physics.RigidBody3D kinematic duration must be finite and positive")
        }
        self.store.require_mutable()
        var state = self.store.require(self.id)
        if state.body_type != BodyType3D.kinematic {
            panic("GFX.Physics.RigidBody3D kinematic target requires a kinematic body")
        }
        let selected = Transform3D(target.position, target.rotation)
        let linear_velocity = selected.position.subtract(state.transform.position).divide(duration)
        var delta = selected.rotation.multiply(state.transform.rotation.conjugated())
        if delta.w < 0.0 { delta = delta.multiply(-1.0) }
        let imaginary = Math.Vec3(delta.x, delta.y, delta.z)
        let sine = imaginary.length()
        var angular_velocity = Math.Vec3()
        if sine > 0.000001 {
            angular_velocity = imaginary.multiply(
                2.0 * Math.atan2(sine, delta.w) / (sine * duration)
            )
        }
        if !finite_body3d_point(linear_velocity) || !finite_body3d_point(angular_velocity) {
            panic("GFX.Physics.RigidBody3D kinematic target exceeds finite velocity")
        }
        state.linear_velocity = linear_velocity
        state.angular_velocity = angular_velocity
        state.target = selected
        state.target_remaining = duration
        self.store.wake_all()
    }
}

package func finite_body3d_value(value:float) bool {
    return value == value && (value == 0.0 || value + value != value)
}

package func finite_body3d_point(value:Math.Vec3) bool {
    return finite_body3d_value(value.x) && finite_body3d_value(value.y) &&
        finite_body3d_value(value.z)
}

func validate_material3d(friction:float, restitution:float) {
    if !finite_body3d_value(friction) || friction < 0.0 ||
        !finite_body3d_value(restitution) || restitution < 0.0 || restitution > 1.0
    {
        panic("GFX.Physics.RigidBody3D material requires finite non-negative friction and restitution in [0, 1]")
    }
}

package func require_dynamic_mass3d(properties:MassProperties3D) {
    if properties.mass <= 0.0 || properties.local_inertia.x <= 0.0 ||
        properties.local_inertia.y <= 0.0 || properties.local_inertia.z <= 0.0
    {
        panic("GFX.Physics.RigidBody3D dynamic mass and principal inertia must be positive")
    }
}

package func shape_mass_properties3d(shape:Shape3D, density:float) MassProperties3D {
    match shape {
        triangle(_) => { return MassProperties3D(0.0, Math.Vec3()) }
        mesh(_) => { return MassProperties3D(0.0, Math.Vec3()) }
        convex(hull) => { return convex_mass_properties3d(hull, density) }
        sphere(value) => {
            let mass = density * (4.0 / 3.0) * Math.pi() * value.radius * value.radius * value.radius
            let inertia = 0.4 * mass * value.radius * value.radius
            return MassProperties3D(mass, Math.Vec3(inertia))
        }
        box(value) => {
            let mass = density * value.size.x * value.size.y * value.size.z
            let scale = mass / 12.0
            return MassProperties3D(mass, Math.Vec3(
                scale * (value.size.y * value.size.y + value.size.z * value.size.z),
                scale * (value.size.x * value.size.x + value.size.z * value.size.z),
                scale * (value.size.x * value.size.x + value.size.y * value.size.y)
            ))
        }
        capsule(value) => {
            let radius_squared = value.radius * value.radius
            let cylinder_length = 2.0 * value.half_height
            let cylinder_mass = density * Math.pi() * radius_squared * cylinder_length
            let caps_mass = density * (4.0 / 3.0) * Math.pi() *
                radius_squared * value.radius
            let axial = 0.5 * cylinder_mass * radius_squared +
                0.4 * caps_mass * radius_squared
            let transverse = cylinder_mass *
                (3.0 * radius_squared + cylinder_length * cylinder_length) / 12.0 +
                caps_mass * (
                    0.4 * radius_squared + value.half_height * value.half_height +
                    0.75 * value.half_height * value.radius
                )
            return MassProperties3D(
                cylinder_mass + caps_mass,
                Math.Vec3(transverse, axial, transverse)
            )
        }
        compound(compound) => {
            var total_mass = 0.0
            var weighted_center = Math.Vec3()
            var index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                let properties = shape_mass_properties3d(child.shape, density)
                total_mass += properties.mass
                weighted_center = weighted_center.add(
                    child.transform.point(properties.local_center).multiply(properties.mass))
                index++
            }
            let center = weighted_center.divide(total_mass)
            var tensor = Math.Mat3.zero()
            index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                let properties = shape_mass_properties3d(child.shape, density)
                let basis = rotation_inertia3d(child.transform.rotation)
                tensor = tensor.add(basis.multiply(properties.inertia_tensor)
                    .multiply(basis.transposed()))
                let offset = child.transform.point(properties.local_center).subtract(center)
                tensor = tensor.add(parallel_axis_inertia3d(properties.mass, offset))
                index++
            }
            return MassProperties3D(total_mass, tensor, center)
        }
        cylinder(value) => { return axial_solid_mass3d(value.half_height, value.radius, value.radius, false, density) }
        tapered_cylinder(value) => { return axial_solid_mass3d(value.half_height, value.top_radius, value.bottom_radius, false, density) }
        tapered_capsule(value) => { return axial_solid_mass3d(value.half_height, value.top_radius, value.bottom_radius, true, density) }
    }
}

func diagonal_inertia3d(diagonal:Math.Vec3) Math.Mat3 {
    return Math.Mat3(Math.Vec3(diagonal.x, 0.0, 0.0),
        Math.Vec3(0.0, diagonal.y, 0.0), Math.Vec3(0.0, 0.0, diagonal.z))
}

func rotation_inertia3d(rotation:Math.Quat) Math.Mat3 {
    return Math.Mat3(rotation.rotate(Math.Vec3(1.0, 0.0, 0.0)),
        rotation.rotate(Math.Vec3(0.0, 1.0, 0.0)),
        rotation.rotate(Math.Vec3(0.0, 0.0, 1.0)))
}

func parallel_axis_inertia3d(mass:float, offset:Math.Vec3) Math.Mat3 {
    return Math.Mat3(
        Math.Vec3(mass * (offset.y * offset.y + offset.z * offset.z),
            -mass * offset.x * offset.y, -mass * offset.x * offset.z),
        Math.Vec3(-mass * offset.y * offset.x,
            mass * (offset.x * offset.x + offset.z * offset.z),
            -mass * offset.y * offset.z),
        Math.Vec3(-mass * offset.z * offset.x, -mass * offset.z * offset.y,
            mass * (offset.x * offset.x + offset.y * offset.y))
    )
}

func finite_inertia3d(tensor:Math.Mat3) bool {
    return finite_body3d_point(tensor.x) && finite_body3d_point(tensor.y) &&
        finite_body3d_point(tensor.z)
}

func cross_inertia3d(tensor:Math.Mat3) bool {
    return tensor.x.y != 0.0 || tensor.x.z != 0.0 || tensor.y.x != 0.0 ||
        tensor.y.z != 0.0 || tensor.z.x != 0.0 || tensor.z.y != 0.0
}

func invert_inertia3d(tensor:Math.Mat3) Math.Mat3 {
    if !cross_inertia3d(tensor) {
        return diagonal_inertia3d(Math.Vec3(1.0 / tensor.x.x,
            1.0 / tensor.y.y, 1.0 / tensor.z.z))
    }
    let scale = Math.max(tensor.x.x, Math.max(tensor.y.y, tensor.z.z))
    let normalized = tensor.multiply(1.0 / scale)
    let row0 = normalized.row(0)
    let row1 = normalized.row(1)
    let row2 = normalized.row(2)
    let first = row1.cross(row2)
    let second = row2.cross(row0)
    let third = row0.cross(row1)
    return Math.Mat3(first, second, third).multiply(1.0 / (row0.dot(first) * scale))
}

// Cold body creation/shape replacement only. Normalize around an interior point
// before integrating tetrahedra, then integrate centered second moments directly
// to avoid subtracting large origin moments for translated small solids.
func convex_mass_properties3d(hull:ConvexHull3D, density:float) MassProperties3D {
    let anchor = hull.vertex(0)
    var offset = Math.Vec3()
    var scale = 0.0
    var index = 0
    while index < hull.vertex_count() {
        let delta = hull.vertex(index).subtract(anchor)
        offset = offset.add(delta.divide(hull.vertex_count() as float))
        scale = Math.max(scale, delta.length())
        index++
    }
    var volume = 0.0
    var first_moment = Math.Vec3()
    index = 0
    while index < hull.triangle_count() {
        let triangle = hull.triangle(index)
        let a = triangle.first.subtract(anchor).subtract(offset).divide(scale)
        let b = triangle.second.subtract(anchor).subtract(offset).divide(scale)
        let c = triangle.third.subtract(anchor).subtract(offset).divide(scale)
        let tetra_volume = a.dot(b.cross(c)) / 6.0
        volume += tetra_volume
        first_moment = first_moment.add(a.add(b).add(c).multiply(tetra_volume * 0.25))
        index++
    }
    let center = first_moment.divide(volume)
    var second_moment = Math.Mat3.zero()
    index = 0
    while index < hull.triangle_count() {
        let triangle = hull.triangle(index)
        let a = triangle.first.subtract(anchor).subtract(offset).divide(scale)
        let b = triangle.second.subtract(anchor).subtract(offset).divide(scale)
        let c = triangle.third.subtract(anchor).subtract(offset).divide(scale)
        let tetra_volume = a.dot(b.cross(c)) / 6.0
        let first = a.subtract(center)
        let second = b.subtract(center)
        let third = c.subtract(center)
        let fourth = center.negated()
        let sum = first.add(second).add(third).add(fourth)
        second_moment = second_moment.add(outer_moment3d(first)
            .add(outer_moment3d(second)).add(outer_moment3d(third))
            .add(outer_moment3d(fourth)).add(outer_moment3d(sum))
            .multiply(tetra_volume / 20.0))
        index++
    }
    let mass = density * volume * scale * scale * scale
    let inertia_scale = mass * scale * scale / volume
    let tensor = Math.Mat3(
        Math.Vec3(second_moment.y.y + second_moment.z.z,
            -second_moment.x.y, -second_moment.x.z),
        Math.Vec3(-second_moment.y.x, second_moment.x.x + second_moment.z.z,
            -second_moment.y.z),
        Math.Vec3(-second_moment.z.x, -second_moment.z.y,
            second_moment.x.x + second_moment.y.y)).multiply(inertia_scale)
    return MassProperties3D(mass, tensor, anchor.add(offset).add(center.multiply(scale)))
}

func outer_moment3d(point:Math.Vec3) Math.Mat3 {
    return Math.Mat3(point.multiply(point.x), point.multiply(point.y), point.multiply(point.z))
}

struct AxialMoments3D {
    let area:float
    let first:float
    let second:float
    let radial:float
    init(area:float, first:float, second:float, radial:float) {
        self.area = area; self.first = first; self.second = second; self.radial = radial
    }
    func add(other:AxialMoments3D) AxialMoments3D {
        return AxialMoments3D(self.area + other.area, self.first + other.first,
            self.second + other.second, self.radial + other.radial)
    }
}
// Integrate r(t)^2 = a + b*t + c*t^2 on y = start + length*t.
// All three solids have polynomial circular sections, including spherical caps.
func axial_section_moments3d(start:float, length:float, a:float, b:float, c:float) AxialMoments3D {
    let area = a + b / 2.0 + c / 3.0
    let moment = a / 2.0 + b / 3.0 + c / 4.0
    let second = a / 3.0 + b / 4.0 + c / 5.0
    let radial = a * a + a * b + (b * b + 2.0 * a * c) / 3.0 + b * c / 2.0 + c * c / 5.0
    return AxialMoments3D(length * area, length * (start * area + length * moment),
        length * (start * start * area + 2.0 * start * length * moment + length * length * second), length * radial)
}
func axial_solid_mass3d(half_height:float, top_radius:float, bottom_radius:float,
    rounded:bool, density:float) MassProperties3D {
    if rounded && Math.abs(top_radius - bottom_radius) >= 2.0 * half_height {
        var radius = top_radius; var center = half_height
        if bottom_radius > radius { radius = bottom_radius; center = -half_height }
        let mass = density * (4.0 / 3.0) * Math.pi() * radius * radius * radius
        let inertia = 0.4 * mass * radius * radius
        return MassProperties3D(mass, diagonal_inertia3d(Math.Vec3(inertia)), Math.Vec3(0.0, center, 0.0))
    }
    let scale = half_height + Math.max(top_radius, bottom_radius)
    let height = half_height / scale; let top = top_radius / scale; let bottom = bottom_radius / scale
    var moments = AxialMoments3D(0.0, 0.0, 0.0, 0.0)
    if rounded {
        let alpha = (bottom - top) / (2.0 * height)
        let cosine = Math.sqrt(1.0 - alpha * alpha)
        let bottom_y = -height + bottom * alpha; let top_y = height + top * alpha
        let lower_start = -height - bottom; let lower_length = bottom_y - lower_start
        let upper_length = height + top - top_y
        moments = axial_section_moments3d(lower_start, lower_length, 0.0, 2.0 * bottom * lower_length, -lower_length * lower_length)
        moments = moments.add(axial_section_moments3d(top_y, upper_length,
            top * top * (1.0 - alpha * alpha), -2.0 * top * alpha * upper_length, -upper_length * upper_length))
        let first_radius = bottom * cosine; let delta = (top - bottom) * cosine
        moments = moments.add(axial_section_moments3d(bottom_y, top_y - bottom_y,
            first_radius * first_radius, 2.0 * first_radius * delta, delta * delta))
    } else {
        let delta = top - bottom
        moments = axial_section_moments3d(-height, 2.0 * height, bottom * bottom, 2.0 * bottom * delta, delta * delta)
    }
    let volume_scale = density * Math.pi() * scale * scale * scale
    let inertia_scale = volume_scale * scale * scale
    let mass = volume_scale * moments.area
    let axial = inertia_scale * moments.radial * 0.5
    let transverse = inertia_scale * (moments.radial * 0.25 + moments.second - moments.first * moments.first / moments.area)
    return MassProperties3D(mass, diagonal_inertia3d(Math.Vec3(transverse, axial, transverse)),
        Math.Vec3(0.0, scale * moments.first / moments.area, 0.0))
}
