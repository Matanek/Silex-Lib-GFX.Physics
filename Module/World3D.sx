public struct World3DSettings {
    var gravity:Math.Vec3
    init() { self.gravity = Math.Vec3(0.0, -9.81, 0.0) }
}

package struct CharacterShape3D {
    let body_id:BodyId3D
    let placement:ShapePlacement3D

    init(body_id:BodyId3D, placement:ShapePlacement3D) {
        self.body_id = body_id
        self.placement = placement
    }
}

public class World3D {
    private var store:BodyStore3D
    private var distance_constraints:DistanceConstraintStore3D
    private var fixed_constraints:FixedConstraintStore3D
    private var point_constraints:PointConstraintStore3D
    private var hinge_constraints:HingeConstraintStore3D
    private var current_gravity:Math.Vec3
    private var contacts:Contact3D[]
    private var contact_begins:Contact3D[]
    private var contact_ends:Contact3D[]
    private var pending_contact_ends:Contact3D[]

    drop {
        self.distance_constraints.invalidate_all()
        self.fixed_constraints.invalidate_all()
        self.point_constraints.invalidate_all()
        self.hinge_constraints.invalidate_all()
        self.store.invalidate_all()
    }

    init(settings:World3DSettings = World3DSettings()) {
        if !finite_body3d_point(settings.gravity) {
            panic("GFX.Physics.World3D requires finite gravity")
        }
        self.store = BodyStore3D()
        self.distance_constraints = DistanceConstraintStore3D(self.store)
        self.fixed_constraints = FixedConstraintStore3D(self.store)
        self.point_constraints = PointConstraintStore3D(self.store)
        self.hinge_constraints = HingeConstraintStore3D(self.store)
        self.current_gravity = settings.gravity
        self.contacts = []
        self.contact_begins = []
        self.contact_ends = []
        self.pending_contact_ends = []
    }

    func gravity() Math.Vec3 { return self.current_gravity }

    func set_gravity(gravity:Math.Vec3) {
        if !finite_body3d_point(gravity) {
            panic("GFX.Physics.World3D requires finite gravity")
        }
        self.store.require_mutable()
        self.current_gravity = gravity
        self.store.wake_all()
    }

    func body_count() int { return self.store.live_count }
    func distance_constraint_count() int { return self.distance_constraints.live_count }
    func fixed_constraint_count() int { return self.fixed_constraints.live_count }
    func point_constraint_count() int { return self.point_constraints.live_count }
    func hinge_constraint_count() int { return self.hinge_constraints.live_count }
    func contact_count() int { return self.contacts.count() }

    func write_contacts(output:&Contact3D[]) {
        output.clear()
        for contact in self.contacts { output.append(contact) }
    }

    func write_contact_begin_events(output:&Contact3D[]) {
        output.clear()
        for contact in self.contact_begins { output.append(contact) }
    }

    func write_contact_end_events(output:&Contact3D[]) {
        output.clear()
        for contact in self.contact_ends { output.append(contact) }
    }

    func create_rigid_body(settings:RigidBody3DSettings = RigidBody3DSettings()) RigidBody3D {
        let id = self.store.append(settings)
        return RigidBody3D(self.store, id)
    }

    func create_distance_constraint(
        first:RigidBody3D, second:RigidBody3D,
        settings:DistanceConstraint3DSettings
    ) DistanceConstraint3D {
        let id = self.distance_constraints.append(first, second, settings)
        return DistanceConstraint3D(self.distance_constraints, id)
    }

    func destroy_distance_constraint(constraint:DistanceConstraint3D) {
        self.store.require_mutable()
        if !constraint.belongs_to(self.distance_constraints) {
            panic("GFX.Physics.World3D cannot destroy a constraint owned by another world")
        }
        self.distance_constraints.destroy(constraint.constraint_id())
    }

    func create_fixed_constraint(first:@RigidBody3D, second:@RigidBody3D,
        settings:FixedConstraint3DSettings? = null) FixedConstraint3D
    {
        var chosen = FixedConstraint3DSettings()
        if let explicit = settings { chosen = explicit }
        else {
            let first_pose = first.transform()
            let second_pose = second.transform()
            chosen.second_local_frame = Transform3D(second_pose.inverse_point(first_pose.position),
                second_pose.rotation.conjugated().multiply(first_pose.rotation).normalized())
        }
        let id = self.fixed_constraints.append(first, second, chosen)
        return FixedConstraint3D(self.fixed_constraints, id)
    }

    func destroy_fixed_constraint(constraint:@FixedConstraint3D) {
        self.store.require_mutable()
        if !constraint.belongs_to(self.fixed_constraints) {
            panic("GFX.Physics.World3D cannot destroy a constraint owned by another world")
        }
        self.fixed_constraints.destroy(constraint.constraint_id())
    }

    func create_point_constraint(
        first:RigidBody3D, second:RigidBody3D,
        settings:PointConstraint3DSettings = PointConstraint3DSettings()
    ) PointConstraint3D {
        let id = self.point_constraints.append(first, second, settings)
        return PointConstraint3D(self.point_constraints, id)
    }

    func destroy_point_constraint(constraint:PointConstraint3D) {
        self.store.require_mutable()
        if !constraint.belongs_to(self.point_constraints) {
            panic("GFX.Physics.World3D cannot destroy a constraint owned by another world")
        }
        self.point_constraints.destroy(constraint.constraint_id())
    }

    func create_hinge_constraint(
        first:RigidBody3D, second:RigidBody3D,
        settings:HingeConstraint3DSettings = HingeConstraint3DSettings()
    ) HingeConstraint3D {
        let id = self.hinge_constraints.append(first, second, settings)
        return HingeConstraint3D(self.hinge_constraints, id)
    }

    func destroy_hinge_constraint(constraint:HingeConstraint3D) {
        self.store.require_mutable()
        if !constraint.belongs_to(self.hinge_constraints) {
            panic("GFX.Physics.World3D cannot destroy a constraint owned by another world")
        }
        self.hinge_constraints.destroy(constraint.constraint_id())
    }

    func destroy_rigid_body(body:RigidBody3D) {
        self.store.require_mutable()
        if !body.belongs_to(self.store) {
            panic("GFX.Physics.World3D cannot destroy a body owned by another world")
        }
        for contact in self.contacts {
            if contact.first_body().same_body(body) {
                self.store.require(contact.second_body_id()).wake()
                self.pending_contact_ends.append(contact)
            }
            if contact.second_body().same_body(body) {
                self.store.require(contact.first_body_id()).wake()
                self.pending_contact_ends.append(contact)
            }
        }
        self.distance_constraints.destroy_for_body(body.body_id())
        self.fixed_constraints.destroy_for_body(body.body_id())
        self.point_constraints.destroy_for_body(body.body_id())
        self.hinge_constraints.destroy_for_body(body.body_id())
        self.store.destroy(body.body_id())
        var retained:Contact3D[] = []
        for contact in self.contacts {
            if !contact.first_body().same_body(body) &&
                !contact.second_body().same_body(body)
            {
                retained.append(contact)
            }
        }
        self.contacts = retained
    }

    func write_bodies(output:&RigidBody3D[]) {
        output.clear()
        var slot = 0
        while slot < self.store.slots.count() {
            if self.store.slots[slot] != null {
                output.append(RigidBody3D(
                    self.store,
                    BodyId3D(slot, self.store.generations[slot])
                ))
            }
            slot++
        }
    }

    private func ignored_query_slot(ignore_body:RigidBody3D?) int {
        if let excluded = ignore_body {
            if !excluded.belongs_to(self.store) || !excluded.is_valid() {
                panic("GFX.Physics.World3D query requires a live ignored body from this world")
            }
            return excluded.body_id().slot
        }
        return -1
    }

    func shape_cast(
        cast:ShapeCast3D, ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) WorldCastHit3D? {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        var nearest:WorldCastHit3D? = null
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let hit = Geometry3D.shape_cast(
                            cast, ShapePlacement3D(state.shape, state.transform)
                        )
                        if hit.hit {
                            if let previous = nearest {
                                if hit.fraction < previous.fraction() {
                                    nearest = WorldCastHit3D(RigidBody3D(
                                        self.store, BodyId3D(slot, self.store.generations[slot])
                                    ), hit)
                                }
                            } else {
                                nearest = WorldCastHit3D(RigidBody3D(
                                    self.store, BodyId3D(slot, self.store.generations[slot])
                                ), hit)
                            }
                        }
                    }
                }
            }
            slot++
        }
        return nearest
    }

    func sphere_cast(
        cast:SphereCast3D, ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) WorldSphereHit3D? {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        var nearest:WorldSphereHit3D? = null
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let hit = Geometry3D.sphere_cast(
                            cast, ShapePlacement3D(state.shape, state.transform)
                        )
                        if hit.hit {
                            if let previous = nearest {
                                if hit.fraction < previous.fraction() {
                                    nearest = WorldSphereHit3D(RigidBody3D(
                                        self.store, BodyId3D(slot, self.store.generations[slot])
                                    ), hit)
                                }
                            } else {
                                nearest = WorldSphereHit3D(RigidBody3D(
                                    self.store, BodyId3D(slot, self.store.generations[slot])
                                ), hit)
                            }
                        }
                    }
                }
            }
            slot++
        }
        return nearest
    }

    func ray_cast(
        ray:Ray3D, ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) WorldRayHit3D? {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        var nearest:WorldRayHit3D? = null
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let hit = Geometry3D.ray_cast(
                            ray, ShapePlacement3D(state.shape, state.transform)
                        )
                        if hit.hit {
                            if let previous = nearest {
                                if hit.fraction < previous.fraction() {
                                    nearest = WorldRayHit3D(RigidBody3D(
                                        self.store, BodyId3D(slot, self.store.generations[slot])
                                    ), hit)
                                }
                            } else {
                                nearest = WorldRayHit3D(RigidBody3D(
                                    self.store, BodyId3D(slot, self.store.generations[slot])
                                ), hit)
                            }
                        }
                    }
                }
            }
            slot++
        }
        return nearest
    }

    func write_ray_hits(
        ray:Ray3D, output:&WorldRayHit3D[], ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        output.clear()
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let hit = Geometry3D.ray_cast(
                            ray, ShapePlacement3D(state.shape, state.transform)
                        )
                        if hit.hit {
                            output.append(WorldRayHit3D(RigidBody3D(
                                self.store, BodyId3D(slot, self.store.generations[slot])
                            ), hit))
                        }
                    }
                }
            }
            slot++
        }
        var index = 1
        while index < output.count() {
            var current = index
            while current > 0 && output[current - 1].fraction() > output[current].fraction() {
                output.swap(current - 1, current)
                current--
            }
            index++
        }
    }

    func write_overlaps(
        query:ShapePlacement3D, output:&WorldOverlap3D[],
        ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        output.clear()
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let target = ShapePlacement3D(state.shape, state.transform)
                        if Geometry3D.overlaps(query, target) {
                            let distance = Geometry3D.distance(query, target)
                            output.append(WorldOverlap3D(RigidBody3D(
                                self.store, BodyId3D(slot, self.store.generations[slot])
                            ), distance.first_child_id, distance.second_child_id))
                        }
                    }
                }
            }
            slot++
        }
    }

    // Snapshot nearby leaves once per character move, shared by all slide/stair
    // sweeps. Character queries never retain a body's mutable state across moves.
    package func character_shapes(lower:Math.Vec3, upper:Math.Vec3,
        filter:QueryFilter3D, output:&CharacterShape3D[]) {
        output.clear()
        var slot = 0
        while slot < self.store.slots.count() {
            if let state = self.store.slots[slot] {
                if state.is_enabled && filter.allows(state.collision_filter, state.is_sensor) {
                    if plane_shape3d(state.shape) {
                        append_character_shapes3d(state.shape, state.transform, BodyId3D(slot,self.store.generations[slot]),output)
                        slot++; continue
                    }
                    let extent = broad_extent3d(state.shape, state.transform, shape_bounding_radius3d(state.shape))
                    let lo = state.transform.position.subtract(extent)
                    let hi = state.transform.position.add(extent)
                    if hi.x >= lower.x && lo.x <= upper.x &&
                        hi.y >= lower.y && lo.y <= upper.y &&
                        hi.z >= lower.z && lo.z <= upper.z {
                        append_character_shapes3d(state.shape, state.transform,
                            BodyId3D(slot, self.store.generations[slot]), output)
                    }
                }
            }
            slot++
        }
    }

    package func character_body(id:BodyId3D) RigidBody3D {
        return RigidBody3D(self.store, id)
    }

    package func valid_character_support(body:RigidBody3D, filter:QueryFilter3D) bool {
        if !body.belongs_to(self.store) || !body.is_valid() { return false }
        return body.is_enabled() && filter.allows(body.collision_filter(), body.is_sensor())
    }

    func step(delta:float) {
        if !finite_body3d_value(delta) || delta < 0.0 {
            panic("GFX.Physics.World3D.step requires a finite non-negative delta")
        }
        self.store.require_mutable()
        if delta == 0.0 { return }
        self.store.locked = true
        self.wake_constraint_islands()
        self.wake_contact_islands()
        var has_continuous_body = false
        for state in self.store.slots {
            if let body = state {
                if body.is_enabled && body.awake &&
                    body.body_type == BodyType3D.dynamic &&
                    body.continuous_collision
                {
                    has_continuous_body = true
                }
            }
        }
        var previous_poses:Transform3D[] = []
        if has_continuous_body {
            for state in self.store.slots {
                if let body = state {
                    previous_poses.append(body.transform)
                } else {
                    previous_poses.append(Transform3D())
                }
            }
        }
        self.reset_constraint_reactions(delta)
        for slot in self.store.slots {
            if var state = slot {
                if state.is_enabled && state.body_type == BodyType3D.dynamic && state.awake {
                    integrate_dynamic_velocity3d(state, self.current_gravity, delta)
                }
                state.force = Math.Vec3()
                state.torque = Math.Vec3()
            }
        }
        self.warm_start_fixed_constraints(delta)
        // Rigid attachments and powered joints act before pose integration.
        // The contact sweep continues with the same accumulated impulses.
        if self.has_active_hinge_motor() || self.has_active_fixed_constraint() {
            var iteration = 0
            while iteration < 12 {
                self.solve_constraint_velocities(delta, iteration % 2 == 1)
                iteration++
            }
        }
        for slot in self.store.slots {
            if var state = slot {
                if state.is_enabled {
                    match state.body_type {
                        fixed => {}
                        kinematic => { integrate_kinematic3d(state, delta) }
                        dynamic => { if state.awake { advance_pose3d(state, delta) } }
                    }
                }
            }
        }
        if has_continuous_body { self.apply_continuous_motion(previous_poses) }
        var continuous_poses:Transform3D[] = []
        if has_continuous_body {
            for state in self.store.slots {
                if let body = state {
                    continuous_poses.append(body.transform)
                } else {
                    continuous_poses.append(Transform3D())
                }
            }
        }
        self.detect_and_resolve_contacts(delta)
        if has_continuous_body {
            self.emit_continuous_sensor_events(previous_poses, continuous_poses)
        }
        self.update_sleep(delta)
        self.store.locked = false
    }

    private func apply_continuous_motion(previous_poses:Transform3D[]) {
        var moving_slot = 0
        while moving_slot < self.store.slots.count() {
            if var moving = self.store.slots[moving_slot] {
                if moving.is_enabled && moving.awake &&
                    moving.body_type == BodyType3D.dynamic &&
                    moving.continuous_collision && !moving.is_sensor
                {
                    var first_fraction = 2.0
                    var best_position:Math.Vec3? = null
                    let moving_end = moving.transform
                    var target_slot = 0
                    while target_slot < self.store.slots.count() {
                        if target_slot != moving_slot {
                            if var target = self.store.slots[target_slot] {
                                if target.is_enabled && !target.is_sensor &&
                                    moving.collision_filter.allows(target.collision_filter)
                                {
                                    let fraction = continuous_fraction3d(
                                        moving.shape, previous_poses[moving_slot],
                                        moving_end, target.shape,
                                        previous_poses[target_slot], target.transform
                                    )
                                    if let hit = fraction {
                                        if hit < first_fraction {
                                            first_fraction = hit
                                            let relative_start = previous_poses[moving_slot]
                                                .position.subtract(
                                                    previous_poses[target_slot].position
                                                )
                                            let relative_motion = moving_end.position
                                                .subtract(previous_poses[moving_slot].position)
                                                .subtract(target.transform.position.subtract(
                                                    previous_poses[target_slot].position
                                                ))
                                            best_position = target.transform.position
                                                .add(relative_start)
                                                .add(relative_motion.multiply(
                                                    Math.min(1.0, hit + 0.000001)
                                                ))
                                        }
                                    }
                                }
                            }
                        }
                        target_slot++
                    }
                    if let position = best_position {
                        moving.transform = Transform3D(position, moving_end.rotation)
                    }
                }
            }
            moving_slot++
        }
    }

    private func emit_continuous_sensor_events(
        previous_poses:Transform3D[], continuous_poses:Transform3D[]
    ) {
        var first_slot = 0
        while first_slot < self.store.slots.count() {
            if var first = self.store.slots[first_slot] {
                if first.is_enabled {
                    var second_slot = first_slot + 1
                    while second_slot < self.store.slots.count() {
                        if var second = self.store.slots[second_slot] {
                            if second.is_enabled && (first.is_sensor || second.is_sensor) &&
                                first.collision_filter.allows(second.collision_filter) &&
                                ((first.body_type == BodyType3D.dynamic &&
                                    first.continuous_collision && first.awake) ||
                                    (second.body_type == BodyType3D.dynamic &&
                                        second.continuous_collision && second.awake))
                            {
                                let initial = motion_distance3d(
                                    ShapePlacement3D(first.shape, previous_poses[first_slot]),
                                    ShapePlacement3D(second.shape, previous_poses[second_slot]),
                                    previous_poses[first_slot], previous_poses[second_slot]
                                )
                                let final = motion_distance3d(
                                    ShapePlacement3D(first.shape, continuous_poses[first_slot]),
                                    ShapePlacement3D(second.shape, continuous_poses[second_slot]),
                                    previous_poses[first_slot], previous_poses[second_slot]
                                )
                                if initial.separation > 0.000001 &&
                                    final.separation > 0.000001
                                {
                                    let fraction = continuous_fraction3d(
                                        first.shape, previous_poses[first_slot],
                                        continuous_poses[first_slot], second.shape,
                                        previous_poses[second_slot],
                                        continuous_poses[second_slot]
                                    )
                                    if let hit = fraction {
                                        let first_motion = continuous_poses[first_slot]
                                            .position.subtract(previous_poses[first_slot].position)
                                        let second_motion = continuous_poses[second_slot]
                                            .position.subtract(previous_poses[second_slot].position)
                                        let first_pose = Transform3D(
                                            previous_poses[first_slot].position.add(
                                                first_motion.multiply(hit)
                                            ), previous_poses[first_slot].rotation
                                        )
                                        let second_pose = Transform3D(
                                            previous_poses[second_slot].position.add(
                                                second_motion.multiply(hit)
                                            ), previous_poses[second_slot].rotation
                                        )
                                        let witness = motion_distance3d(
                                            ShapePlacement3D(first.shape, first_pose),
                                            ShapePlacement3D(second.shape, second_pose),
                                            previous_poses[first_slot], previous_poses[second_slot]
                                        )
                                        var contact = Contact3D(
                                            RigidBody3D(self.store, BodyId3D(
                                                first_slot, self.store.generations[first_slot]
                                            )),
                                            RigidBody3D(self.store, BodyId3D(
                                                second_slot, self.store.generations[second_slot]
                                            )),
                                            witness.normal, witness.separation,
                                            witness.first_point.add(witness.second_point)
                                                .multiply(0.5),
                                            0.0, Math.Vec3(), 0.0, 0.0, [],
                                            witness.first_child_id, witness.second_child_id,
                                            true, first.shape_revision, second.shape_revision
                                        )
                                        self.contact_begins.append(contact)
                                        self.contact_ends.append(contact)
                                    }
                                }
                            }
                        }
                        second_slot++
                    }
                }
            }
            first_slot++
        }
    }

    private func reset_constraint_reactions(delta:float) {
        for slot in self.distance_constraints.slots {
            if var constraint = slot {
                constraint.axial_impulse = 0.0
                constraint.reaction_axis = Math.Vec3()
                constraint.inverse_delta = 0.0
            }
        }
        for slot in self.fixed_constraints.slots {
            if var constraint = slot {
                constraint.warm_linear = constraint.impulse.multiply(delta * constraint.inverse_delta)
                constraint.warm_angular = constraint.angular_impulse.multiply(delta * constraint.inverse_delta)
                constraint.impulse = Math.Vec3()
                constraint.angular_impulse = Math.Vec3()
                constraint.inverse_delta = 0.0
            }
        }
        for slot in self.point_constraints.slots {
            if var constraint = slot {
                constraint.impulse = Math.Vec3()
                constraint.inverse_delta = 0.0
            }
        }
        for slot in self.hinge_constraints.slots {
            if var constraint = slot { constraint.reset() }
        }
    }

    private func warm_start_fixed_constraints(delta:float) {
        for slot in self.fixed_constraints.slots {
            if var constraint = slot {
                if constraint.is_enabled {
                    var first = self.store.require(constraint.first_id)
                    var second = self.store.require(constraint.second_id)
                    if first.is_enabled && second.is_enabled && (first.awake || second.awake) {
                        let first_radius = first.transform.point(constraint.first_local_anchor).subtract(first.world_center())
                        let second_radius = second.transform.point(constraint.second_local_anchor).subtract(second.world_center())
                        apply_contact_impulse3d(first, second, first_radius, second_radius, constraint.warm_linear)
                        apply_hinge_angular_impulse3d(first, second, constraint.warm_angular)
                        constraint.impulse = constraint.warm_linear
                        constraint.angular_impulse = constraint.warm_angular
                        constraint.inverse_delta = 1.0 / delta
                    }
                }
            }
        }
    }

    private func has_active_fixed_constraint() bool {
        for slot in self.fixed_constraints.slots {
            if let constraint = slot {
                if constraint.is_enabled {
                    var first = self.store.require(constraint.first_id)
                    var second = self.store.require(constraint.second_id)
                    if first.is_enabled && second.is_enabled && (first.awake || second.awake) { return true }
                }
            }
        }
        return false
    }

    private func has_active_hinge_motor() bool {
        for slot in self.hinge_constraints.slots {
            if let constraint = slot {
                if constraint.point.is_enabled {
                    if let motor = constraint.motor {
                        if motor.maximum_torque > 0.0 {
                            var first = self.store.require(constraint.point.first_id)
                            var second = self.store.require(constraint.point.second_id)
                            if first.is_enabled && second.is_enabled && (first.awake || second.awake) { return true }
                        }
                    }
                }
            }
        }
        return false
    }

    private func solve_constraint_velocities(delta:float, reverse:bool) {
        var constraint_index = 0
        while constraint_index < self.distance_constraints.slots.count() {
            var selected = constraint_index
            if reverse {
                selected = self.distance_constraints.slots.count() - 1 - constraint_index
            }
            if var constraint = self.distance_constraints.slots[selected] {
                if constraint.is_enabled {
                    var first = self.store.require(constraint.first_id)
                    var second = self.store.require(constraint.second_id)
                    if first.is_enabled && second.is_enabled &&
                        (first.awake || second.awake)
                    {
                        solve_distance_velocity3d(first, second, constraint, delta)
                    }
                }
            }
            constraint_index++
        }
        constraint_index = 0
        while constraint_index < self.fixed_constraints.slots.count() {
            var selected = constraint_index
            if reverse {
                selected = self.fixed_constraints.slots.count() - 1 - constraint_index
            }
            if var constraint = self.fixed_constraints.slots[selected] {
                if constraint.is_enabled {
                    var first = self.store.require(constraint.first_id)
                    var second = self.store.require(constraint.second_id)
                    if first.is_enabled && second.is_enabled &&
                        (first.awake || second.awake)
                    {
                        solve_fixed_velocity3d(first, second, constraint, delta)
                    }
                }
            }
            constraint_index++
        }
        constraint_index = 0
        while constraint_index < self.point_constraints.slots.count() {
            var selected = constraint_index
            if reverse {
                selected = self.point_constraints.slots.count() - 1 - constraint_index
            }
            if var constraint = self.point_constraints.slots[selected] {
                if constraint.is_enabled {
                    var first = self.store.require(constraint.first_id)
                    var second = self.store.require(constraint.second_id)
                    if first.is_enabled && second.is_enabled &&
                        (first.awake || second.awake)
                    {
                        solve_point_velocity3d(first, second, constraint, delta)
                    }
                }
            }
            constraint_index++
        }
        constraint_index = 0
        while constraint_index < self.hinge_constraints.slots.count() {
            var selected = constraint_index
            if reverse {
                selected = self.hinge_constraints.slots.count() - 1 - constraint_index
            }
            if var constraint = self.hinge_constraints.slots[selected] {
                if constraint.point.is_enabled {
                    var first = self.store.require(constraint.point.first_id)
                    var second = self.store.require(constraint.point.second_id)
                    if first.is_enabled && second.is_enabled &&
                        (first.awake || second.awake)
                    {
                        solve_hinge_velocity3d(first, second, constraint, delta)
                    }
                }
            }
            constraint_index++
        }
    }

    private func wake_constraint_islands() {
        var pass = 0
        while pass < self.distance_constraints.live_count + self.point_constraints.live_count + self.hinge_constraints.live_count + self.fixed_constraints.live_count {
            for slot in self.distance_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled {
                            if first.body_type == BodyType3D.kinematic &&
                                (first.linear_velocity.length_squared() > 0.0 ||
                                    first.angular_velocity.length_squared() > 0.0)
                            {
                                second.wake()
                            }
                            if second.body_type == BodyType3D.kinematic &&
                                (second.linear_velocity.length_squared() > 0.0 ||
                                    second.angular_velocity.length_squared() > 0.0)
                            {
                                first.wake()
                            }
                            if first.awake && !second.awake { second.wake() }
                            if second.awake && !first.awake { first.wake() }
                        }
                    }
                }
            }
            for slot in self.fixed_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled {
                            if first.body_type == BodyType3D.kinematic &&
                                (first.linear_velocity.length_squared() > 0.0 ||
                                    first.angular_velocity.length_squared() > 0.0)
                            {
                                second.wake()
                            }
                            if second.body_type == BodyType3D.kinematic &&
                                (second.linear_velocity.length_squared() > 0.0 ||
                                    second.angular_velocity.length_squared() > 0.0)
                            {
                                first.wake()
                            }
                            if first.awake && !second.awake { second.wake() }
                            if second.awake && !first.awake { first.wake() }
                        }
                    }
                }
            }
            for slot in self.point_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled {
                            if first.body_type == BodyType3D.kinematic &&
                                (first.linear_velocity.length_squared() > 0.0 ||
                                    first.angular_velocity.length_squared() > 0.0)
                            {
                                second.wake()
                            }
                            if second.body_type == BodyType3D.kinematic &&
                                (second.linear_velocity.length_squared() > 0.0 ||
                                    second.angular_velocity.length_squared() > 0.0)
                            {
                                first.wake()
                            }
                            if first.awake && !second.awake { second.wake() }
                            if second.awake && !first.awake { first.wake() }
                        }
                    }
                }
            }
            for slot in self.hinge_constraints.slots {
                if var constraint = slot {
                    if constraint.point.is_enabled {
                        var first = self.store.require(constraint.point.first_id)
                        var second = self.store.require(constraint.point.second_id)
                        if first.is_enabled && second.is_enabled {
                            if let motor = constraint.motor {
                                if motor.maximum_torque > 0.0 && motor.speed != 0.0 {
                                    first.wake()
                                    second.wake()
                                }
                            }
                            if first.body_type == BodyType3D.kinematic &&
                                (first.linear_velocity.length_squared() > 0.0 ||
                                    first.angular_velocity.length_squared() > 0.0)
                            {
                                second.wake()
                            }
                            if second.body_type == BodyType3D.kinematic &&
                                (second.linear_velocity.length_squared() > 0.0 ||
                                    second.angular_velocity.length_squared() > 0.0)
                            {
                                first.wake()
                            }
                            if first.awake && !second.awake { second.wake() }
                            if second.awake && !first.awake { first.wake() }
                        }
                    }
                }
            }
            pass++
        }
    }

    private func wake_contact_islands() {
        var changed = true
        while changed {
            changed = false
            for contact in self.contacts {
                if contact.is_sensor() { continue }
                var first = self.store.require(contact.first_body_id())
                var second = self.store.require(contact.second_body_id())
                if !first.is_enabled || !second.is_enabled { continue }
                if first.body_type == BodyType3D.dynamic && first.awake &&
                    second.body_type == BodyType3D.dynamic && !second.awake
                {
                    second.wake()
                    changed = true
                }
                if second.body_type == BodyType3D.dynamic && second.awake &&
                    first.body_type == BodyType3D.dynamic && !first.awake
                {
                    first.wake()
                    changed = true
                }
            }
        }
    }

    private func detect_and_resolve_contacts(delta:float) {
        var previous_contacts:Contact3D[] = []
        for contact in self.contacts { previous_contacts.append(contact) }
        self.contacts.clear()
        self.contact_begins.clear()
        self.contact_ends.clear()
        for contact in self.pending_contact_ends {
            self.contact_ends.append(contact)
        }
        self.pending_contact_ends.clear()
        var pairs:ContactPairState3D[] = []
        let candidates = broadphase_pairs3d(self.store)
        for broad_pair in candidates {
            let first_slot = broad_pair.first
            let second_slot = broad_pair.second
            if var first = self.store.slots[first_slot] {
                if first.is_enabled {
                    if var second = self.store.slots[second_slot] {
                        if second.is_enabled &&
                            first.collision_filter.allows(second.collision_filter) &&
                            (first.body_type == BodyType3D.dynamic ||
                                second.body_type == BodyType3D.dynamic ||
                                ((first.is_sensor || second.is_sensor) &&
                                    (first.body_type == BodyType3D.kinematic ||
                                        second.body_type == BodyType3D.kinematic)))
                        {
                            let first_id = BodyId3D(
                                first_slot, self.store.generations[first_slot])
                            let second_id = BodyId3D(
                                second_slot, self.store.generations[second_slot])
                            if is_compound3d(first.shape) || is_compound3d(second.shape) ||
                                supports_mesh_manifolds3d(first.shape, second.shape) {
                                var distances:DistanceResult3D[] = []
                                write_leaf_contacts3d(
                                    ShapePlacement3D(first.shape, first.transform),
                                    ShapePlacement3D(second.shape, second.transform),
                                    -1, -1, distances)
                                // Canonical child order also fixes solver order,
                                // independent of the compound's construction order.
                                Sort.sort<DistanceResult3D>(
                                    &distances[0:distances.count()], leaf_contact_before3d)
                                for distance in distances {
                                    append_contact_pair3d(first, second,
                                        first_id, second_id, distance, false,
                                        previous_contacts, pairs)
                                }
                            } else {
                                let first_placement = ShapePlacement3D(first.shape, first.transform)
                                let second_placement = ShapePlacement3D(second.shape, second.transform)
                                if !front_triangle_contact3d(first_placement, second_placement) {
                                    continue
                                }
                                let first_radius = primitive_sphere_radius3d(first.shape)
                                let second_radius = primitive_sphere_radius3d(second.shape)
                                let sphere_pair = first_radius > 0.0 && second_radius > 0.0
                                var distance = DistanceResult3D(
                                    Math.Vec3(), Math.Vec3(), Math.Vec3(), 0.0)
                                if sphere_pair {
                                    distance = sphere_centers_distance3d(
                                        first.transform.position, first_radius,
                                        second.transform.position, second_radius)
                                } else {
                                    distance = contact_distance3d(first_placement, second_placement)
                                }
                                append_contact_pair3d(first, second,
                                    first_id, second_id, distance, sphere_pair,
                                    previous_contacts, pairs)
                            }
                        }
                    }
                }
            }
        }
        for var pair in pairs {
            if !pair.active { continue }
            let previous_index = pair.previous_index
            if previous_index >= 0 {
                var previous = previous_contacts[previous_index]
                if !previous.is_sensor() &&
                    previous.first_child_id() == pair.first_child_id &&
                    previous.second_child_id() == pair.second_child_id &&
                    previous.normal().dot(pair.normal) > 0.95 {
                    warm_contact_points3d(
                        pair.first, pair.second, pair.normal, pair.friction,
                        pair.constraints, previous
                    )
                }
            }
        }
        // A multi-point face must settle its normal support before friction
        // reacts to transient angular slip from individual point updates.
        var normal_iteration = 0
        while normal_iteration < 4 {
            for var pair in pairs {
                if pair.active && pair.friction > 0.0 && pair.constraints.count() > 1
                {
                    for constraint in pair.constraints {
                        solve_contact_point3d(
                            pair.first, pair.second, pair.normal, pair.friction,
                            constraint, false
                        )
                    }
                }
            }
            normal_iteration++
        }
        var iteration = 0
        while iteration < 12 {
            var pair_index = 0
            while pair_index < pairs.count() {
                var selected_pair = pair_index
                if iteration % 2 == 1 {
                    selected_pair = pairs.count() - 1 - pair_index
                }
                var pair = pairs[selected_pair]
                if !pair.active {
                    pair_index++
                    continue
                }
                if pair.direct_spheres {
                    solve_sphere_point3d(pair.first, pair.second, pair.normal,
                        pair.friction, pair.constraints[0])
                    pair_index++
                    continue
                }
                var point_index = 0
                while point_index < pair.constraints.count() {
                    var selected_point = point_index
                    if iteration % 2 == 1 {
                        selected_point = pair.constraints.count() - 1 - point_index
                    }
                    solve_contact_point3d(
                        pair.first, pair.second, pair.normal, pair.friction,
                        pair.constraints[selected_point]
                    )
                    point_index++
                }
                pair_index++
            }
            self.solve_constraint_velocities(delta, iteration % 2 == 1)
            iteration++
        }
        for var pair in pairs {
            var normal_impulse = 0.0
            var tangent_impulse = Math.Vec3()
            var public_points:ContactPoint3D[] = []
            for constraint in pair.constraints {
                normal_impulse += constraint.normal_impulse
                tangent_impulse = tangent_impulse.add(constraint.tangent_impulse)
                public_points.append(ContactPoint3D(
                    constraint.point, constraint.normal_impulse,
                    constraint.tangent_impulse
                ))
            }
            self.contacts.append(Contact3D(
                RigidBody3D(self.store, pair.first_id),
                RigidBody3D(self.store, pair.second_id),
                pair.normal, pair.separation, pair.point,
                normal_impulse, tangent_impulse,
                pair.friction, pair.restitution, public_points,
                pair.first_child_id, pair.second_child_id, pair.is_sensor,
                pair.first.shape_revision, pair.second.shape_revision
            ))
        }
        var position_iteration = 0
        while position_iteration < 4 {
            for slot in self.distance_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_distance_position3d(first, second, constraint)
                        }
                    }
                }
            }
            for slot in self.fixed_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_fixed_position3d(first, second, constraint)
                        }
                    }
                }
            }
            for slot in self.point_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_point_position3d(first, second, constraint)
                        }
                    }
                }
            }
            for slot in self.hinge_constraints.slots {
                if var constraint = slot {
                    if constraint.point.is_enabled {
                        var first = self.store.require(constraint.point.first_id)
                        var second = self.store.require(constraint.point.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_hinge_position3d(first, second, constraint)
                        }
                    }
                }
            }
            var pair_index = pairs.count()
            while pair_index > 0 {
                pair_index--
                var pair = pairs[pair_index]
                if pair.active {
                    if pair.first_sphere_radius > 0.0 && pair.second_sphere_radius > 0.0 {
                        correct_sphere_pair3d(pair)
                        continue
                    }
                    var first_shape = contact_placement3d(
                        pair.first, pair.first_child_id
                    )
                    var second_shape = contact_placement3d(
                        pair.second, pair.second_child_id
                    )
                    if supports_mesh_manifolds3d(first_shape.shape(), second_shape.shape()) {
                        first_shape = mesh_contact_face3d(first_shape, pair.first_child_id)
                        second_shape = mesh_contact_face3d(second_shape, pair.second_child_id)
                    }
                    let distance = contact_separation3d(first_shape, second_shape)
                    if distance.separation < 0.0 {
                        correct_contact3d(
                            pair.first, pair.second,
                            contact_normal3d(first_shape, second_shape,
                                distance.normal),
                            distance.separation
                        )
                    }
                }
            }
            position_iteration++
        }
        // Both snapshots are ordered by body slots and child IDs. Merge once to emit
        // transitions instead of searching each complete array again.
        var current_index = 0
        var previous_index = 0
        while current_index < self.contacts.count() ||
            previous_index < previous_contacts.count() {
            if previous_index >= previous_contacts.count() {
                self.contact_begins.append(self.contacts[current_index])
                current_index++
            } else if current_index >= self.contacts.count() {
                self.contact_ends.append(previous_contacts[previous_index])
                previous_index++
            } else {
                var current = self.contacts[current_index]
                var previous = previous_contacts[previous_index]
                if contact_before3d(current, previous) {
                    self.contact_begins.append(current)
                    current_index++
                } else if contact_before3d(previous, current) {
                    self.contact_ends.append(previous)
                    previous_index++
                } else {
                    if !same_contact_identity3d(previous, current) {
                        self.contact_begins.append(current)
                        self.contact_ends.append(previous)
                    }
                    current_index++
                    previous_index++
                }
            }
        }
    }

    private func update_sleep(delta:float) {
        var sleep_candidate = false
        var slot = 0
        while slot < self.store.slots.count() {
            if var state = self.store.slots[slot] {
                if state.body_type == BodyType3D.dynamic && state.is_enabled && state.awake {
                    if state.allow_sleep &&
                        state.linear_velocity.length() <= state.sleep_threshold &&
                        state.angular_velocity.length() <= state.sleep_threshold
                    {
                        state.sleep_time += delta
                        if state.sleep_time >= 0.5 { sleep_candidate = true }
                    } else {
                        state.sleep_time = 0.0
                    }
                }
            }
            slot++
        }
        if !sleep_candidate { return }
        // Build connectivity once. Fixed supports do not join separate islands.
        var islands = SleepIslands3D(self.store)
        for contact in self.contacts {
            if !contact.is_sensor() {
                islands.connect(contact.first_body_id().slot,
                    contact.second_body_id().slot, self.store)
            }
        }
        for constraint_slot in self.distance_constraints.slots {
            if let constraint = constraint_slot {
                if constraint.is_enabled {
                    islands.connect(constraint.first_id.slot,
                        constraint.second_id.slot, self.store)
                }
            }
        }
        for constraint_slot in self.fixed_constraints.slots {
            if let constraint = constraint_slot {
                if constraint.is_enabled {
                    islands.connect(constraint.first_id.slot,
                        constraint.second_id.slot, self.store)
                }
            }
        }
        for constraint_slot in self.point_constraints.slots {
            if let constraint = constraint_slot {
                if constraint.is_enabled {
                    islands.connect(constraint.first_id.slot,
                        constraint.second_id.slot, self.store)
                }
            }
        }
        for constraint_slot in self.hinge_constraints.slots {
            if let constraint = constraint_slot {
                if constraint.point.is_enabled {
                    islands.connect(constraint.point.first_id.slot,
                        constraint.point.second_id.slot, self.store)
                }
            }
        }
        islands.apply(self.store, self.current_gravity)
    }
}

func is_compound3d(shape:Shape3D) bool {
    match shape {
        compound(_) => { return true }
        box(_) => {}
        sphere(_) => {}
        capsule(_) => {}
        triangle(_) => {}
        mesh(_) => {}
        convex(_) => {}
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => {}
    }
    return false
}

func supports_mesh_manifolds3d(first:Shape3D, second:Shape3D) bool {
    if axial_shape3d(first) {
        match second { mesh(_) => { return true }
            else => {} }
    }
    if axial_shape3d(second) {
        match first { mesh(_) => { return true }
            else => {} }
    }
    match first {
        box(_) => {
            match second {
                mesh(_) => { return true }
                else => {}
            }
        }
        convex(_) => {
            match second {
                mesh(_) => { return true }
                else => {}
            }
        }
        mesh(_) => {
            match second {
                box(_) => { return true }
                convex(_) => { return true }
                else => {}
            }
        }
        else => {}
    }
    return false
}

func mesh_contact_face3d(placement:ShapePlacement3D, child_id:int) ShapePlacement3D {
    match placement.shape() {
        mesh(mesh) => {
            return ShapePlacement3D(
                Shape3D.triangle(mesh.triangle(child_id)), placement.transform())
        }
        else => {}
    }
    return placement
}

func write_surface_pairs3d(first:ShapePlacement3D, second:ShapePlacement3D,
    output:&DistanceResult3D[]) {
    if axial_shape3d(first.shape()) {
        write_axial_mesh_contacts3d(first, second, output); return
    }
    if axial_shape3d(second.shape()) {
        var reversed:DistanceResult3D[] = []
        write_axial_mesh_contacts3d(second, first, reversed)
        for contact in reversed {
            output.append(DistanceResult3D(contact.second_point, contact.first_point,
                contact.normal.negated(), contact.separation, contact.second_child_id, -1))
        }
        return
    }
    match first.shape() {
        box(box) => {
            match second.shape() {
                mesh(mesh) => {
                    write_box_mesh_contacts3d(
                        box, first.transform(), mesh, second.transform(), output)
                }
                else => {}
            }
        }
        mesh(mesh) => {
            match second.shape() {
                box(box) => {
                    var reversed:DistanceResult3D[] = []
                    write_box_mesh_contacts3d(box, second.transform(), mesh, first.transform(), reversed)
                    for contact in reversed {
                        output.append(DistanceResult3D(contact.second_point, contact.first_point,
                            contact.normal.negated(), contact.separation, contact.second_child_id, -1))
                    }
                }
                convex(hull) => {
                    var reversed:DistanceResult3D[] = []
                    write_convex_mesh_contacts3d(hull, second.transform(), mesh, first.transform(), reversed)
                    for contact in reversed {
                        output.append(DistanceResult3D(contact.second_point, contact.first_point,
                            contact.normal.negated(), contact.separation, contact.second_child_id, -1))
                    }
                }
                else => {}
            }
        }
        convex(hull) => {
            match second.shape() {
                mesh(mesh) => { write_convex_mesh_contacts3d(hull, first.transform(), mesh, second.transform(), output) }
                else => {}
            }
        }
        else => {}
    }
}

// Compound leaves and distinct mesh support planes, once per detection pass.
// Child poses change with their parent, so distances cannot persist across steps.
func write_leaf_contacts3d(
    first:ShapePlacement3D, second:ShapePlacement3D,
    first_child_id:int, second_child_id:int, output:&DistanceResult3D[]
) {
    match first.shape() {
        compound(compound) => {
            var index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                write_leaf_contacts3d(ShapePlacement3D(child.shape,
                    compound_child_transform(first.transform(), child)), second,
                    child.id, second_child_id, output)
                index++
            }
            return
        }
        box(_) => {}
        sphere(_) => {}
        capsule(_) => {}
        triangle(_) => {}
        mesh(_) => {}
        convex(_) => {}
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => {}
    }
    match second.shape() {
        compound(compound) => {
            var index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                write_leaf_contacts3d(first, ShapePlacement3D(child.shape,
                    compound_child_transform(second.transform(), child)),
                    first_child_id, child.id, output)
                index++
            }
            return
        }
        box(_) => {}
        sphere(_) => {}
        capsule(_) => {}
        triangle(_) => {}
        mesh(_) => {}
        convex(_) => {}
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => {}
    }
    if supports_mesh_manifolds3d(first.shape(), second.shape()) {
        var contacts:DistanceResult3D[] = []
        write_surface_pairs3d(first, second, contacts)
        for contact in contacts {
            var resolved_first = first_child_id
            var resolved_second = second_child_id
            if resolved_first < 0 { resolved_first = contact.first_child_id }
            if resolved_second < 0 { resolved_second = contact.second_child_id }
            output.append(DistanceResult3D(contact.first_point, contact.second_point,
                contact.normal, contact.separation, resolved_first, resolved_second))
        }
        return
    }
    if !front_triangle_contact3d(first, second) { return }
    let distance = contact_distance3d(first, second)
    if distance.separation <= 0.000001 {
        var resolved_first = first_child_id
        var resolved_second = second_child_id
        if resolved_first < 0 { resolved_first = distance.first_child_id }
        if resolved_second < 0 { resolved_second = distance.second_child_id }
        output.append(DistanceResult3D(distance.first_point, distance.second_point,
            distance.normal, distance.separation, resolved_first, resolved_second))
    }
}

func leaf_contact_before3d(first:@DistanceResult3D, second:@DistanceResult3D) bool {
    if first.first_child_id != second.first_child_id {
        return first.first_child_id < second.first_child_id
    }
    return first.second_child_id < second.second_child_id
}

func contact_key_before3d(
    first_slot:int, second_slot:int, first_child:int, second_child:int,
    other_first_slot:int, other_second_slot:int, other_first_child:int, other_second_child:int
) bool {
    if first_slot != other_first_slot { return first_slot < other_first_slot }
    if second_slot != other_second_slot { return second_slot < other_second_slot }
    if first_child != other_first_child { return first_child < other_first_child }
    return second_child < other_second_child
}

func contact_before3d(first:@Contact3D, second:@Contact3D) bool {
    return contact_key_before3d(
        first.first_body_id().slot, first.second_body_id().slot,
        first.first_child_id(), first.second_child_id(),
        second.first_body_id().slot, second.second_body_id().slot,
        second.first_child_id(), second.second_child_id())
}

// One manifold per leaf/support pair; public distance queries still select
// the nearest child. Other primitive pairs keep their direct path.
func append_contact_pair3d(
    first:BodyState3D, second:BodyState3D,
    first_id:BodyId3D, second_id:BodyId3D,
    distance:DistanceResult3D, sphere_pair:bool,
    previous_contacts:@Contact3D[], pairs:&ContactPairState3D[]
) {
    if distance.separation > 0.000001 { return }
    var normal = distance.normal
    var point = distance.first_point.add(
        distance.second_point
    ).multiply(0.5)
    let sensor_pair = first.is_sensor || second.is_sensor
    var points:Math.Vec3[] = []
    if sphere_pair {
        if !sensor_pair { points.append(point) }
    } else {
        let first_contact_shape = contact_placement3d(
            first, distance.first_child_id)
        let second_contact_shape = contact_placement3d(
            second, distance.second_child_id)
        normal = contact_normal3d(
            first_contact_shape, second_contact_shape, normal)
        if !sensor_pair {
            points = contact_points3d(
                first_contact_shape, second_contact_shape,
                normal, point)
        }
    }
    if !sphere_pair && !points.is_empty() {
        point = Math.Vec3()
        for candidate in points {
            point = point.add(candidate)
        }
        point = point.divide(points.count() as float)
    }
    var friction = 0.0
    var restitution = 0.0
    if !sensor_pair {
        friction = Math.sqrt(first.friction) *
            Math.sqrt(second.friction)
        restitution = Math.max(
            first.restitution, second.restitution
        )
    }
    var constraints:ContactPointState3D[] = []
    for candidate in points {
        constraints.append(ContactPointState3D(
            candidate, first, second, normal, restitution
        ))
    }
    var had_previous = false
    var previous_index = contact_index_at_pair3d(
        previous_contacts, first_id, second_id,
        distance.first_child_id, distance.second_child_id
    )
    if previous_index >= 0 {
        var previous = previous_contacts[previous_index]
        if previous.first_revision() != first.shape_revision ||
            previous.second_revision() != second.shape_revision {
            previous_index = -1
        } else if previous.first_child_id() ==
            distance.first_child_id &&
            previous.second_child_id() ==
                distance.second_child_id &&
            previous.is_sensor() == sensor_pair {
            had_previous = true
        }
    }
    if !sensor_pair {
        if !had_previous ||
            (first.body_type == BodyType3D.kinematic &&
                (first.linear_velocity.length_squared() > 0.0 ||
                    first.angular_velocity.length_squared() > 0.0)) ||
            (second.body_type == BodyType3D.kinematic &&
                (second.linear_velocity.length_squared() > 0.0 ||
                    second.angular_velocity.length_squared() > 0.0))
        {
            first.wake()
            second.wake()
        } else {
            if first.awake && !second.awake { second.wake() }
            if second.awake && !first.awake { first.wake() }
        }
    }
    let active = !sensor_pair &&
        (first.awake || second.awake)
    pairs.append(ContactPairState3D(
        first, second,
        first_id, second_id,
        normal, distance.separation, point,
        friction, restitution, constraints, active,
        distance.first_child_id, distance.second_child_id,
        sensor_pair, previous_index
    ))
}

func same_contact_identity3d(first:Contact3D, second:Contact3D) bool {
    return first.first_body().same_body(second.first_body()) &&
        first.second_body().same_body(second.second_body()) &&
        first.first_revision() == second.first_revision() &&
        first.second_revision() == second.second_revision() &&
        first.first_child_id() == second.first_child_id() &&
        first.second_child_id() == second.second_child_id() &&
        first.is_sensor() == second.is_sensor()
}

// Rebuilt from the current contacts/constraints only when sleep is eligible.
// Union by size and path compression keep traversal proportional to the graph.
class SleepIslands3D {
    var parents:int[] = []
    var sizes:int[] = []
    var supports:bool[] = []

    init(store:@BodyStore3D) {
        var slot = 0
        while slot < store.slots.count() {
            var parent = -1
            if let body = store.slots[slot] {
                if body.is_enabled && body.awake &&
                    body.body_type == BodyType3D.dynamic { parent = slot }
            }
            self.parents.append(parent)
            self.sizes.append(1)
            self.supports.append(false)
            slot++
        }
    }

    func root(slot:int) int {
        var current = slot
        while self.parents[current] != current {
            let parent = self.parents[current]
            self.parents[current] = self.parents[parent]
            current = self.parents[current]
        }
        return current
    }

    func connect(first:int, second:int, store:@BodyStore3D) {
        let first_active = self.parents[first] >= 0
        let second_active = self.parents[second] >= 0
        if first_active && second_active {
            var first_root = self.root(first)
            var second_root = self.root(second)
            if first_root == second_root { return }
            if self.sizes[first_root] < self.sizes[second_root] {
                let previous = first_root
                first_root = second_root
                second_root = previous
            }
            self.parents[second_root] = first_root
            self.sizes[first_root] += self.sizes[second_root]
        } else if first_active {
            if let support = store.slots[second] {
                if support.is_enabled && support.body_type != BodyType3D.dynamic {
                    self.supports[first] = true
                }
            }
        } else if second_active {
            if let support = store.slots[first] {
                if support.is_enabled && support.body_type != BodyType3D.dynamic {
                    self.supports[second] = true
                }
            }
        }
    }

    func apply(store:@BodyStore3D, gravity:Math.Vec3) {
        var ready:bool[] = []
        var gravity_free:bool[] = []
        var supported:bool[] = []
        var slot = 0
        while slot < self.parents.count() {
            ready.append(true)
            gravity_free.append(true)
            supported.append(false)
            slot++
        }
        slot = 0
        while slot < self.parents.count() {
            if self.parents[slot] >= 0 {
                let root = self.root(slot)
                if let body = store.slots[slot] {
                    if !body.allow_sleep || body.sleep_time < 0.5 { ready[root] = false }
                    if gravity.multiply(body.gravity_scale).length_squared() > 0.0 {
                        gravity_free[root] = false
                    }
                }
                if self.supports[slot] { supported[root] = true }
            }
            slot++
        }
        slot = 0
        while slot < self.parents.count() {
            if self.parents[slot] >= 0 {
                let root = self.root(slot)
                if var body = store.slots[slot] {
                    if !supported[root] && !gravity_free[root] {
                        body.sleep_time = 0.0
                    } else if ready[root] {
                        body.awake = false
                        body.linear_velocity = Math.Vec3()
                        body.angular_velocity = Math.Vec3()
                    }
                }
            }
            slot++
        }
    }
}

func warm_contact_points3d(
    first:&BodyState3D,
    second:&BodyState3D,
    normal:Math.Vec3,
    friction:float,
    constraints:ContactPointState3D[],
    previous:Contact3D
) {
    if previous.point_count() != constraints.count() { return }
    var index = 0
    while index < constraints.count() {
        var constraint = constraints[index]
        let old = previous.manifold_point(index)
        if old.position.distance(constraint.point) < 0.1 {
            constraint.normal_impulse = old.normal_impulse
            // The previous impulse belongs to the previous tangent plane.
            // Reproject when the normal rotates so friction cannot add support.
            constraint.tangent_impulse = old.tangent_impulse.subtract(
                normal.multiply(old.tangent_impulse.dot(normal))
            )
            let tangent_length = constraint.tangent_impulse.length()
            let maximum = friction * constraint.normal_impulse
            if tangent_length > maximum {
                constraint.tangent_impulse = constraint.tangent_impulse.normalized().multiply(
                    maximum
                )
            }
            let first_radius = constraint.first_radius
            let second_radius = constraint.second_radius
            apply_contact_impulse3d(
                first, second, first_radius, second_radius,
                normal.multiply(constraint.normal_impulse).add(
                    constraint.tangent_impulse
                )
            )
        }
        index++
    }
}

class ContactPairState3D {
    var first:BodyState3D
    var second:BodyState3D
    let first_id:BodyId3D
    let second_id:BodyId3D
    let normal:Math.Vec3
    let separation:float
    let point:Math.Vec3
    let friction:float
    let restitution:float
    var constraints:ContactPointState3D[]
    let active:bool
    let first_child_id:int
    let second_child_id:int
    let is_sensor:bool
    let previous_index:int
    let first_sphere_radius:float
    let second_sphere_radius:float
    let direct_spheres:bool

    init(
        first:BodyState3D, second:BodyState3D,
        first_id:BodyId3D, second_id:BodyId3D,
        normal:Math.Vec3, separation:float, point:Math.Vec3,
        friction:float, restitution:float,
        constraints:ContactPointState3D[], active:bool,
        first_child_id:int, second_child_id:int, is_sensor:bool, previous_index:int
    ) {
        self.first = first
        self.second = second
        self.first_id = first_id
        self.second_id = second_id
        self.normal = normal
        self.separation = separation
        self.point = point
        self.friction = friction
        self.restitution = restitution
        self.constraints = constraints
        self.active = active
        self.first_child_id = first_child_id
        self.second_child_id = second_child_id
        self.is_sensor = is_sensor
        self.previous_index = previous_index
        self.first_sphere_radius = primitive_sphere_radius3d(first.shape)
        self.second_sphere_radius = primitive_sphere_radius3d(second.shape)
        self.direct_spheres = self.first_sphere_radius > 0.0 &&
            self.second_sphere_radius > 0.0 &&
            first.mass_properties.local_center.length_squared() == 0.0 &&
            second.mass_properties.local_center.length_squared() == 0.0 &&
            !first.has_cross_inertia && !second.has_cross_inertia &&
            first.inverse_inertia.x == first.inverse_inertia.y &&
            first.inverse_inertia.y == first.inverse_inertia.z &&
            second.inverse_inertia.x == second.inverse_inertia.y &&
            second.inverse_inertia.y == second.inverse_inertia.z
    }
}

func primitive_sphere_radius3d(shape:Shape3D) float {
    match shape {
        sphere(sphere) => { return sphere.radius }
        box(_) => {}
        capsule(_) => {}
        compound(_) => {}
        triangle(_) => {}
        mesh(_) => {}
        convex(_) => {}
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => {}
    }
    return 0.0
}

func correct_sphere_pair3d(pair:ContactPairState3D) {
    // Position iterations only need center separation. No shape placement,
    // witnesses, child lookup or sphere orientation participates in this case.
    let offset = pair.second.transform.position.subtract(pair.first.transform.position)
    let length = offset.length()
    let separation = length - pair.first_sphere_radius - pair.second_sphere_radius
    if separation >= 0.0 { return }
    var normal = Math.Vec3.right()
    if length > 0.0 { normal = offset.divide(length) }
    correct_contact3d(pair.first, pair.second, normal, separation)
}

func contact_placement3d(state:BodyState3D, child_id:int) ShapePlacement3D {
    match state.shape {
        compound(compound) => {
            var index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                if child.id == child_id {
                    return ShapePlacement3D(
                        child.shape,
                        compound_child_transform(state.transform, child)
                    )
                }
                index++
            }
            panic("GFX.Physics.World3D contact child id is missing")
        }
        sphere(_) => {}
        box(_) => {}
        capsule(_) => {}
        triangle(_) => {}
        mesh(_) => {}
        convex(_) => {}
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => {}
    }
    return ShapePlacement3D(state.shape, state.transform)
}

func contact_points3d(
    first:ShapePlacement3D,
    second:ShapePlacement3D,
    normal:Math.Vec3,
    witness:Math.Vec3
) Math.Vec3[] {
    if plane_shape3d(first.shape()) { return plane_surface_contact_points(second, first, normal) }
    if plane_shape3d(second.shape()) { return plane_surface_contact_points(first, second, normal) }
    if axial_shape3d(first.shape()) { return axial_surface_contact_points(first, second, normal, witness) }
    if axial_shape3d(second.shape()) { return axial_surface_contact_points(second, first, normal.negated(), witness) }
    match first.shape() {
        box(first_box) => {
            match second.shape() {
                box(second_box) => {
                    return box_box_contact_points(
                        first_box, first.transform(), second_box, second.transform(),
                        normal, witness
                    )
                }
                sphere(_) => {}
                capsule(_) => {}
                compound(_) => {}
                triangle(_) => {
                    return box_surface_contact_points(first_box, first.transform(), second, normal, witness)
                }
                mesh(_) => {
                    return box_surface_contact_points(first_box, first.transform(), second, normal, witness)
                }
                convex(hull) => { return box_convex_contact_points(first_box, first.transform(), hull, second.transform(), normal, witness) }
                cylinder(_) => {}
                tapered_cylinder(_) => {}
                tapered_capsule(_) => {}
                plane(_) => {}
            }
        }
        sphere(_) => {}
        compound(_) => {}
        capsule(first_capsule) => {
            match second.shape() {
                capsule(second_capsule) => {
                    return capsule_capsule_contact_points(
                        first_capsule, first.transform(),
                        second_capsule, second.transform(),
                        normal, witness
                    )
                }
                sphere(_) => {}
                box(_) => {}
                compound(_) => {}
                triangle(_) => {
                    return capsule_surface_contact_points(first_capsule, first.transform(),
                        second, normal, witness)
                }
                mesh(_) => {
                    return capsule_surface_contact_points(first_capsule, first.transform(),
                        second, normal, witness)
                }
                convex(hull) => { return capsule_convex_contact_points(first_capsule, first.transform(), hull, second.transform(), normal, witness) }
                cylinder(_) => {}
                tapered_cylinder(_) => {}
                tapered_capsule(_) => {}
                plane(_) => {}
            }
        }
        triangle(triangle) => {
            match second.shape() {
                capsule(capsule) => {
                    return capsule_surface_contact_points(capsule, second.transform(),
                        first, normal.negated(), witness)
                }
                sphere(_) => {}
                box(box) => {
                    return box_surface_contact_points(box, second.transform(), first, normal.negated(), witness)
                }
                compound(_) => {}
                triangle(_) => {}
                mesh(_) => {}
                convex(hull) => { return convex_triangle_contact_points(hull, second.transform(), triangle, first.transform(), normal.negated(), witness) }
                cylinder(_) => {}
                tapered_cylinder(_) => {}
                tapered_capsule(_) => {}
                plane(_) => {}
            }
        }
        mesh(_) => {
            match second.shape() {
                capsule(capsule) => {
                    return capsule_surface_contact_points(capsule, second.transform(),
                        first, normal.negated(), witness)
                }
                sphere(_) => {}
                box(box) => {
                    return box_surface_contact_points(box, second.transform(), first, normal.negated(), witness)
                }
                compound(_) => {}
                triangle(_) => {}
                mesh(_) => {}
                convex(hull) => { return convex_mesh_contact_points(hull, second.transform(), first, normal.negated(), witness) }
                cylinder(_) => {}
                tapered_cylinder(_) => {}
                tapered_capsule(_) => {}
                plane(_) => {}
            }
        }
        convex(hull) => {
            match second.shape() {
                capsule(capsule) => { return capsule_convex_contact_points(capsule, second.transform(), hull, first.transform(), normal.negated(), witness) }
                box(box) => { return box_convex_contact_points(box, second.transform(), hull, first.transform(), normal.negated(), witness) }
                convex(other) => { return convex_convex_contact_points(hull, first.transform(), other, second.transform(), normal, witness) }
                triangle(triangle) => { return convex_triangle_contact_points(hull, first.transform(), triangle, second.transform(), normal, witness) }
                mesh(_) => { return convex_mesh_contact_points(hull, first.transform(), second, normal, witness) }
                else => {}
            }
        }
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => {}
    }
    return [witness]
}

func contact_normal3d(
    first:ShapePlacement3D,
    second:ShapePlacement3D,
    geometric_normal:Math.Vec3
) Math.Vec3 {
    match first.shape() {
        sphere(_) => {
            match second.shape() {
                box(box) => {
                    if inside_box3d(first.transform().position, box, second.transform()) {
                        return geometric_normal.negated()
                    }
                }
                sphere(_) => {}
                capsule(_) => {}
                compound(_) => {}
                triangle(_) => {}
                mesh(_) => {}
                convex(hull) => {
                    if inside_convex3d(first.transform().position, hull, second.transform()) { return geometric_normal.negated() }
                }
                cylinder(_) => {}
                tapered_cylinder(_) => {}
                tapered_capsule(_) => {}
                plane(_) => {}
            }
        }
        box(box) => {
            match second.shape() {
                sphere(_) => {
                    if inside_box3d(second.transform().position, box, first.transform()) {
                        return geometric_normal.negated()
                    }
                }
                capsule(_) => {
                    if inside_box3d(second.transform().position, box, first.transform()) {
                        return geometric_normal.negated()
                    }
                }
                box(_) => {}
                compound(_) => {}
                triangle(_) => {}
                mesh(_) => {}
                convex(_) => {}
                cylinder(_) => {}
                tapered_cylinder(_) => {}
                tapered_capsule(_) => {}
                plane(_) => {}
            }
        }
        capsule(_) => {
            match second.shape() {
                box(box) => {
                    if inside_box3d(first.transform().position, box, second.transform()) {
                        return geometric_normal.negated()
                    }
                }
                sphere(_) => {}
                capsule(_) => {}
                compound(_) => {}
                triangle(_) => {}
                mesh(_) => {}
                convex(_) => {}
                cylinder(_) => {}
                tapered_cylinder(_) => {}
                tapered_capsule(_) => {}
                plane(_) => {}
            }
        }
        compound(_) => {}
        triangle(_) => {}
        mesh(_) => {}
        convex(hull) => {
            match second.shape() {
                sphere(_) => {
                    if inside_convex3d(second.transform().position, hull, first.transform()) { return geometric_normal.negated() }
                }
                else => {}
            }
        }
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => {}
    }
    return geometric_normal
}

func inside_box3d(point:Math.Vec3, box:Box3D, transform:Transform3D) bool {
    let local_point = transform.inverse_point(point)
    let half = box.half_size()
    return Math.abs(local_point.x) <= half.x &&
        Math.abs(local_point.y) <= half.y &&
        Math.abs(local_point.z) <= half.z
}

class ContactPointState3D {
    var point:Math.Vec3
    var normal_impulse:float
    var tangent_impulse:Math.Vec3
    var bounce_speed:float
    let first_radius:Math.Vec3
    let second_radius:Math.Vec3
    let normal_inverse_mass:float

    init(
        point:Math.Vec3,
        first:BodyState3D,
        second:BodyState3D,
        normal:Math.Vec3,
        restitution:float
    ) {
        self.point = point
        self.normal_impulse = 0.0
        self.tangent_impulse = Math.Vec3()
        self.bounce_speed = 0.0
        let first_radius = point.subtract(first.world_center())
        let second_radius = point.subtract(second.world_center())
        // Poses and inertia stay fixed throughout all velocity iterations.
        self.first_radius = first_radius
        self.second_radius = second_radius
        self.normal_inverse_mass = contact_inverse_mass3d(
            first, second, first_radius, second_radius, normal
        )
        let approach_speed = contact_relative_velocity3d(
            first, second, first_radius, second_radius
        ).dot(normal)
        if approach_speed < -1.0 {
            self.bounce_speed = -approach_speed * restitution
        }
    }
}

func contact_inverse_mass3d(
    first:@BodyState3D,
    second:@BodyState3D,
    first_radius:Math.Vec3,
    second_radius:Math.Vec3,
    axis:Math.Vec3
) float {
    let first_arm = first_radius.cross(axis)
    let second_arm = second_radius.cross(axis)
    return first.inverse_mass + second.inverse_mass +
        first.inverse_inertia_times(first_arm).cross(first_radius).dot(axis) +
        second.inverse_inertia_times(second_arm).cross(second_radius).dot(axis)
}

func apply_contact_impulse3d(
    first:&BodyState3D,
    second:&BodyState3D,
    first_radius:Math.Vec3,
    second_radius:Math.Vec3,
    impulse:Math.Vec3
) {
    if first.inverse_mass > 0.0 {
        first.linear_velocity = first.linear_velocity.subtract(
            impulse.multiply(first.inverse_mass)
        )
        first.angular_velocity = first.angular_velocity.subtract(
            first.inverse_inertia_times(first_radius.cross(impulse))
        )
    }
    if second.inverse_mass > 0.0 {
        second.linear_velocity = second.linear_velocity.add(
            impulse.multiply(second.inverse_mass)
        )
        second.angular_velocity = second.angular_velocity.add(
            second.inverse_inertia_times(second_radius.cross(impulse))
        )
    }
}

func contact_relative_velocity3d(
    first:@BodyState3D,
    second:@BodyState3D,
    first_radius:Math.Vec3,
    second_radius:Math.Vec3
) Math.Vec3 {
    let first_velocity = first.linear_velocity.add(
        first.angular_velocity.cross(first_radius)
    )
    let second_velocity = second.linear_velocity.add(
        second.angular_velocity.cross(second_radius)
    )
    return second_velocity.subtract(first_velocity)
}

func distance_axis3d(
    first:@BodyState3D, second:@BodyState3D,
    constraint:DistanceConstraintState3D
) Math.Vec3 {
    let separation = second.transform.point(constraint.second_local_anchor).subtract(
        first.transform.point(constraint.first_local_anchor)
    )
    if separation.length_squared() <= 0.000000000001 {
        return Math.Vec3(1.0, 0.0, 0.0)
    }
    return separation.normalized()
}

func distance_error3d(length:float, constraint:DistanceConstraintState3D) float {
    if length < constraint.minimum_length {
        return length - constraint.minimum_length
    }
    if length > constraint.maximum_length {
        return length - constraint.maximum_length
    }
    return 0.0
}

func solve_distance_velocity3d(
    first:&BodyState3D, second:&BodyState3D,
    constraint:DistanceConstraintState3D, delta:float
) {
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    let length = first_point.distance(second_point)
    let error = distance_error3d(length, constraint)
    if length > constraint.minimum_length &&
        length < constraint.maximum_length
    {
        return
    }
    let axis = distance_axis3d(first, second, constraint)
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = contact_inverse_mass3d(
        first, second, first_radius, second_radius, axis
    )
    if inverse_mass <= 0.0 { return }
    let speed = contact_relative_velocity3d(
        first, second, first_radius, second_radius
    ).dot(axis)
    var bias = Math.max(-10.0, Math.min(10.0, 0.2 * error / delta))
    var softness = 0.0
    if constraint.spring_hertz > 0.0 {
        let effective_mass = 1.0 / inverse_mass
        let omega = 2.0 * Math.pi() * constraint.spring_hertz
        let stiffness = effective_mass * omega * omega
        let damping = 2.0 * effective_mass * constraint.spring_damping_ratio * omega
        softness = 1.0 / (delta * (damping + delta * stiffness))
        bias = delta * stiffness * softness * error
    }
    let previous = constraint.axial_impulse
    var accumulated = previous - (speed + bias + softness * previous) /
        (inverse_mass + softness)
    if constraint.minimum_length != constraint.maximum_length {
        if length <= constraint.minimum_length {
            accumulated = Math.max(0.0, accumulated)
        } else {
            accumulated = Math.min(0.0, accumulated)
        }
    }
    constraint.axial_impulse = accumulated
    constraint.reaction_axis = axis
    constraint.inverse_delta = 1.0 / delta
    apply_contact_impulse3d(
        first, second, first_radius, second_radius,
        axis.multiply(accumulated - previous)
    )
}

func solve_distance_position3d(
    first:BodyState3D, second:BodyState3D,
    constraint:DistanceConstraintState3D
) {
    if constraint.spring_hertz > 0.0 { return }
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    let error = distance_error3d(first_point.distance(second_point), constraint)
    if Math.abs(error) < 0.00001 { return }
    let axis = distance_axis3d(first, second, constraint)
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = contact_inverse_mass3d(
        first, second, first_radius, second_radius, axis
    )
    if inverse_mass <= 0.0 { return }
    let impulse = axis.multiply(-Math.max(-0.2, Math.min(0.2, error)) /
        inverse_mass)
    shift_distance_body3d(first, impulse.negated(), first_radius)
    shift_distance_body3d(second, impulse, second_radius)
}

func shift_distance_body3d(
    state:BodyState3D, impulse:Math.Vec3, radius:Math.Vec3
) {
    if state.inverse_mass == 0.0 { return }
    let center = state.world_center().add(impulse.multiply(state.inverse_mass))
    let rotation_vector = state.inverse_inertia_times(radius.cross(impulse))
    var rotation = state.transform.rotation
    let angle = rotation_vector.length()
    if angle > 0.0 {
        rotation = Math.Quat.angle_axis(angle, rotation_vector.divide(angle))
            .multiply(rotation).normalized()
    }
    state.transform = Transform3D(
        center.subtract(rotation.rotate(state.mass_properties.local_center)), rotation
    )
}

func point_effective_column3d(
    first:@BodyState3D, second:@BodyState3D,
    first_radius:Math.Vec3, second_radius:Math.Vec3,
    axis:Math.Vec3
) Math.Vec3 {
    return axis.multiply(first.inverse_mass + second.inverse_mass).add(
        first.inverse_inertia_times(first_radius.cross(axis)).cross(first_radius)
    ).add(
        second.inverse_inertia_times(second_radius.cross(axis)).cross(second_radius)
    )
}

func point_inverse_mass3d(
    first:@BodyState3D, second:@BodyState3D,
    first_radius:Math.Vec3, second_radius:Math.Vec3
) Math.Mat3 {
    return Math.Mat3(
        point_effective_column3d(
            first, second, first_radius, second_radius, Math.Vec3(1.0, 0.0, 0.0)
        ),
        point_effective_column3d(
            first, second, first_radius, second_radius, Math.Vec3(0.0, 1.0, 0.0)
        ),
        point_effective_column3d(
            first, second, first_radius, second_radius, Math.Vec3(0.0, 0.0, 1.0)
        )
    )
}

func solve_point_velocity3d(
    first:&BodyState3D, second:&BodyState3D,
    constraint:PointConstraintState3D, delta:float
) {
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = point_inverse_mass3d(
        first, second, first_radius, second_radius
    )
    if Math.abs(inverse_mass.determinant()) <= Math.epsilon() { return }
    let speed = contact_relative_velocity3d(
        first, second, first_radius, second_radius
    )
    var bias = second_point.subtract(first_point).multiply(0.2 / delta)
    if bias.length_squared() > 100.0 { bias = bias.normalized().multiply(10.0) }
    let impulse = inverse_mass.inverted().multiply(speed.add(bias)).negated()
    constraint.impulse = constraint.impulse.add(impulse)
    constraint.inverse_delta = 1.0 / delta
    apply_contact_impulse3d(first, second, first_radius, second_radius, impulse)
}

func solve_point_position3d(
    first:BodyState3D, second:BodyState3D,
    constraint:PointConstraintState3D
) {
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    var error = second_point.subtract(first_point)
    if error.length_squared() < 0.0000000001 { return }
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = point_inverse_mass3d(
        first, second, first_radius, second_radius
    )
    if Math.abs(inverse_mass.determinant()) <= Math.epsilon() { return }
    if error.length_squared() > 0.04 {
        error = error.normalized().multiply(0.2)
    }
    let impulse = inverse_mass.inverted().multiply(error).negated()
    shift_distance_body3d(first, impulse.negated(), first_radius)
    shift_distance_body3d(second, impulse, second_radius)
}

// A centered isotropic sphere has no normal torque and one tangent mass.
func solve_sphere_point3d(
    first:BodyState3D, second:BodyState3D, normal:Math.Vec3,
    friction:float, constraint:ContactPointState3D
) {
    let inverse_mass = first.inverse_mass + second.inverse_mass
    if inverse_mass <= 0.0 { return }
    let first_arm = constraint.first_radius.dot(normal)
    let second_arm = constraint.second_radius.dot(normal)
    let relative = second.linear_velocity.subtract(first.linear_velocity).add(
        second.angular_velocity.multiply(second_arm).subtract(
            first.angular_velocity.multiply(first_arm)).cross(normal))
    let approach = relative.dot(normal)
    let previous_normal = constraint.normal_impulse
    let normal_impulse = Math.max(0.0,
        previous_normal + (constraint.bounce_speed - approach) / inverse_mass)
    constraint.normal_impulse = normal_impulse
    let previous_tangent = constraint.tangent_impulse
    var tangent_impulse = previous_tangent
    if friction > 0.0 {
        let sliding = relative.subtract(normal.multiply(approach))
        let inverse_tangent = inverse_mass +
            first_arm * first_arm * first.inverse_inertia.x +
            second_arm * second_arm * second.inverse_inertia.x
        tangent_impulse = previous_tangent.subtract(sliding.divide(inverse_tangent))
        let maximum = friction * normal_impulse
        let tangent_length = tangent_impulse.length()
        if tangent_length > maximum {
            tangent_impulse = tangent_impulse.multiply(maximum / tangent_length)
        }
    }
    constraint.tangent_impulse = tangent_impulse
    let tangent_delta = tangent_impulse.subtract(previous_tangent)
    let impulse = normal.multiply(normal_impulse - previous_normal).add(tangent_delta)
    if first.inverse_mass > 0.0 {
        first.linear_velocity = first.linear_velocity.subtract(impulse.multiply(first.inverse_mass))
        first.angular_velocity = first.angular_velocity.subtract(
            normal.cross(tangent_delta).multiply(first_arm * first.inverse_inertia.x))
    }
    if second.inverse_mass > 0.0 {
        second.linear_velocity = second.linear_velocity.add(impulse.multiply(second.inverse_mass))
        second.angular_velocity = second.angular_velocity.add(
            normal.cross(tangent_delta).multiply(second_arm * second.inverse_inertia.x))
    }
}

func solve_contact_point3d(
    first:&BodyState3D,
    second:&BodyState3D,
    normal:Math.Vec3,
    friction:float,
    constraint:ContactPointState3D,
    apply_friction:bool = true
) {
    let first_radius = constraint.first_radius
    let second_radius = constraint.second_radius
    let approach_speed = contact_relative_velocity3d(
        first, second, first_radius, second_radius
    ).dot(normal)
    let inverse_effective_mass = constraint.normal_inverse_mass
    if inverse_effective_mass <= 0.0 { return }
    let previous_normal = constraint.normal_impulse
    constraint.normal_impulse = Math.max(
        0.0,
        previous_normal +
            (constraint.bounce_speed - approach_speed) / inverse_effective_mass
    )
    let normal_delta = constraint.normal_impulse - previous_normal
    if normal_delta != 0.0 {
        apply_contact_impulse3d(
            first, second, first_radius, second_radius,
            normal.multiply(normal_delta)
        )
    }
    if apply_friction && friction > 0.0 {
        let after_normal = contact_relative_velocity3d(
            first, second, first_radius, second_radius
        )
        let sliding = after_normal.subtract(normal.multiply(after_normal.dot(normal)))
        let sliding_speed = sliding.length()
        let previous_tangent = constraint.tangent_impulse
        var new_tangent = previous_tangent
        if sliding_speed > 0.000001 {
            let tangent = sliding.divide(sliding_speed)
            let tangent_inverse_mass = contact_inverse_mass3d(
                first, second, first_radius, second_radius, tangent
            )
            if tangent_inverse_mass > 0.0 {
                new_tangent = previous_tangent.subtract(
                    tangent.multiply(sliding_speed / tangent_inverse_mass)
                )
            }
        }
        let maximum = friction * constraint.normal_impulse
        if new_tangent.length() > maximum {
            new_tangent = new_tangent.normalized().multiply(maximum)
        }
        constraint.tangent_impulse = new_tangent
        let tangent_delta = new_tangent.subtract(previous_tangent)
        if tangent_delta.length() > 0.0 {
            apply_contact_impulse3d(
                first, second, first_radius, second_radius, tangent_delta
            )
        }
    }
}

func correct_contact3d(
    first:BodyState3D,
    second:BodyState3D,
    normal:Math.Vec3,
    separation:float
) {
    if separation >= 0.0 { return }
    let total_inverse_mass = first.inverse_mass + second.inverse_mass
    if total_inverse_mass <= 0.0 { return }
    let correction = normal.multiply(-separation / total_inverse_mass)
    first.transform = Transform3D(
        first.transform.position.subtract(correction.multiply(first.inverse_mass)),
        first.transform.rotation
    )
    second.transform = Transform3D(
        second.transform.position.add(correction.multiply(second.inverse_mass)),
        second.transform.rotation
    )
}

func integrate_kinematic3d(state:BodyState3D, delta:float) {
    if let target = state.target {
        if delta >= state.target_remaining {
            state.transform = target
            state.linear_velocity = Math.Vec3()
            state.angular_velocity = Math.Vec3()
            state.target = null
            state.target_remaining = 0.0
            return
        }
        state.target_remaining -= delta
    }
    advance_pose3d(state, delta)
}

func integrate_dynamic_velocity3d(
    state:BodyState3D,
    gravity:Math.Vec3,
    delta:float
) {
    let acceleration = gravity.multiply(state.gravity_scale).add(
        state.force.multiply(state.inverse_mass)
    )
    state.linear_velocity = state.linear_velocity.add(acceleration.multiply(delta))
    let angular_momentum = state.inertia_times(state.angular_velocity)
    let effective_torque = state.torque.subtract(
        state.angular_velocity.cross(angular_momentum)
    )
    state.angular_velocity = state.angular_velocity.add(
        state.inverse_inertia_times(effective_torque).multiply(delta)
    )
    state.linear_velocity = state.linear_velocity.divide(1.0 + state.linear_damping * delta)
    state.angular_velocity = state.angular_velocity.divide(1.0 + state.angular_damping * delta)
}

func advance_pose3d(state:BodyState3D, delta:float) {
    let center = state.world_center().add(state.linear_velocity.multiply(delta))
    var next_rotation = state.transform.rotation
    let angular_speed = state.angular_velocity.length()
    if angular_speed > 0.0 {
        let turn = Math.Quat.angle_axis(
            angular_speed * delta,
            state.angular_velocity.divide(angular_speed)
        )
        next_rotation = turn.multiply(next_rotation).normalized()
    }
    state.transform = Transform3D(
        center.subtract(next_rotation.rotate(state.mass_properties.local_center)),
        next_rotation
    )
}

struct BroadProxy3D {
    let slot:int
    let position:Math.Vec3
    let radius:float
    let lower:Math.Vec3
    let upper:Math.Vec3

    init(slot:int, position:Math.Vec3, radius:float, extent:Math.Vec3) {
        self.slot = slot
        self.position = position
        self.radius = radius
        self.lower = position.subtract(extent)
        self.upper = position.add(extent)
    }
}

struct BroadPair3D {
    let first:int
    let second:int

    init(first:int, second:int) {
        self.first = first
        self.second = second
    }
}

func broad_proxy_before3d(first:@BroadProxy3D, second:@BroadProxy3D) bool {
    if first.lower.x < second.lower.x { return true }
    if first.lower.x > second.lower.x { return false }
    return first.slot < second.slot
}

func broad_pair_before3d(first:@BroadPair3D, second:@BroadPair3D) bool {
    if first.first < second.first { return true }
    if first.first > second.first { return false }
    return first.second < second.second
}

// Tight world-axis bounds reject separated boxes before exact distance queries.
// Triangle and mesh bounds include every local vertex; other shapes keep conservative
// sphere bounds, including child offsets.
func broad_extent3d(shape:Shape3D, transform:Transform3D, radius:float) Math.Vec3 {
    match shape {
        triangle(triangle) => {
            let first = transform.vector(triangle.first)
            let second = transform.vector(triangle.second)
            let third = transform.vector(triangle.third)
            return Math.Vec3(
                Math.max(Math.abs(first.x), Math.max(Math.abs(second.x), Math.abs(third.x))),
                Math.max(Math.abs(first.y), Math.max(Math.abs(second.y), Math.abs(third.y))),
                Math.max(Math.abs(first.z), Math.max(Math.abs(second.z), Math.abs(third.z)))
            )
        }
        mesh(mesh) => {
            var extent = Math.Vec3()
            var index = 0
            while index < mesh.triangle_count() {
                let triangle = mesh.triangle(index)
                let first = transform.vector(triangle.first)
                let second = transform.vector(triangle.second)
                let third = transform.vector(triangle.third)
                extent = Math.Vec3(
                    Math.max(extent.x, Math.max(Math.abs(first.x),
                        Math.max(Math.abs(second.x), Math.abs(third.x)))),
                    Math.max(extent.y, Math.max(Math.abs(first.y),
                        Math.max(Math.abs(second.y), Math.abs(third.y)))),
                    Math.max(extent.z, Math.max(Math.abs(first.z),
                        Math.max(Math.abs(second.z), Math.abs(third.z))))
                )
                index++
            }
            return extent
        }
        box(box) => {
            let half = box.half_size()
            let x = transform.vector(Math.Vec3(half.x, 0.0, 0.0))
            let y = transform.vector(Math.Vec3(0.0, half.y, 0.0))
            let z = transform.vector(Math.Vec3(0.0, 0.0, half.z))
            return Math.Vec3(
                Math.abs(x.x) + Math.abs(y.x) + Math.abs(z.x),
                Math.abs(x.y) + Math.abs(y.y) + Math.abs(z.y),
                Math.abs(x.z) + Math.abs(y.z) + Math.abs(z.z)
            )
        }
        sphere(_) => {}
        capsule(_) => {}
        compound(_) => {
            let bounds = shape_pose_bounds3d(shape, Transform3D(Math.Vec3(), transform.rotation))
            return Math.Vec3(Math.max(Math.abs(bounds.lower.x), Math.abs(bounds.upper.x)),
                Math.max(Math.abs(bounds.lower.y), Math.abs(bounds.upper.y)),
                Math.max(Math.abs(bounds.lower.z), Math.abs(bounds.upper.z)))
        }
        convex(_) => {}
        cylinder(_) => {}
        tapered_cylinder(_) => {}
        tapered_capsule(_) => {}
        plane(_) => { panic("GFX.Physics an infinite plane has no finite extent") }
    }
    return Math.Vec3(radius)
}

struct GridEntry3D {
    let proxy:int
    let x:int
    let y:int
    let z:int
    let next:int
    init(proxy:int, x:int, y:int, z:int, next:int) {
        self.proxy = proxy
        self.x = x
        self.y = y
        self.z = z
        self.next = next
    }
}

func grid_bucket3d(x:int, y:int, z:int, count:int) int {
    let value = (x * 73856093 + y * 19349663 + z * 83492791) % count
    if value < 0 { return value + count }
    return value
}

func append_broad_pair3d(first:BroadProxy3D, second:BroadProxy3D, pairs:&BroadPair3D[]) {
    if first.upper.x + 0.000001 < second.lower.x ||
        second.upper.x + 0.000001 < first.lower.x ||
        first.upper.y + 0.000001 < second.lower.y ||
        second.upper.y + 0.000001 < first.lower.y ||
        first.upper.z + 0.000001 < second.lower.z ||
        second.upper.z + 0.000001 < first.lower.z { return }
    if !bounding_spheres_overlap3d(first.position, first.radius,
        second.position, second.radius) { return }
    if first.slot < second.slot {
        pairs.append(BroadPair3D(first.slot, second.slot))
    } else {
        pairs.append(BroadPair3D(second.slot, first.slot))
    }
}

func grid_pairs3d(proxies:@BroadProxy3D[], cell_size:float) BroadPair3D[] {
    var heads:int[] = []
    let bucket_count = proxies.count() * 2 + 1
    var bucket = 0
    while bucket < bucket_count { heads.append(-1); bucket++ }
    var entries:GridEntry3D[] = []
    var large:int[] = []
    var pairs:BroadPair3D[] = []
    var index = 0
    while index < proxies.count() {
        let proxy = proxies[index]
        let scaled = proxy.position.divide(cell_size)
        if proxy.radius * 2.0 + 0.000002 <= cell_size &&
            Math.abs(scaled.x) < 1000000000.0 &&
            Math.abs(scaled.y) < 1000000000.0 &&
            Math.abs(scaled.z) < 1000000000.0 {
            let x = Math.floor(scaled.x) as int
            let y = Math.floor(scaled.y) as int
            let z = Math.floor(scaled.z) as int
            var dx = -1
            while dx <= 1 {
                var dy = -1
                while dy <= 1 {
                    var dz = -1
                    while dz <= 1 {
                        let nx = x + dx
                        let ny = y + dy
                        let nz = z + dz
                        var entry_index = heads[grid_bucket3d(nx, ny, nz, bucket_count)]
                        while entry_index >= 0 {
                            let entry = entries[entry_index]
                            if entry.x == nx && entry.y == ny && entry.z == nz {
                                append_broad_pair3d(proxies[entry.proxy], proxy, pairs)
                            }
                            entry_index = entry.next
                        }
                        dz++
                    }
                    dy++
                }
                dx++
            }
            for other in large { append_broad_pair3d(proxies[other], proxy, pairs) }
            let slot = grid_bucket3d(x, y, z, bucket_count)
            entries.append(GridEntry3D(index, x, y, z, heads[slot]))
            heads[slot] = entries.count() - 1
        } else {
            var other = 0
            while other < index {
                append_broad_pair3d(proxies[other], proxy, pairs)
                other++
            }
            large.append(index)
        }
        index++
    }
    Sort.sort<BroadPair3D>(&pairs[0:pairs.count()], broad_pair_before3d)
    return pairs
}

func broadphase_pairs3d(store:@BodyStore3D) BroadPair3D[] {
    var proxies:BroadProxy3D[] = []
    var plane_slots:int[] = []
    var slot = 0
    while slot < store.slots.count() {
        if var body = store.slots[slot] {
            if body.is_enabled && plane_shape3d(body.shape) { plane_slots.append(slot) }
            if body.is_enabled && !plane_shape3d(body.shape) {
                let radius = shape_bounding_radius3d(body.shape)
                proxies.append(BroadProxy3D(slot, body.transform.position,
                    radius, broad_extent3d(body.shape, body.transform, radius)))
            }
        }
        slot++
    }
    if proxies.count() >= 128 {
        var dynamic_radius = 0.0
        for proxy in proxies {
            if let body = store.slots[proxy.slot] {
                if body.body_type == BodyType3D.dynamic {
                    dynamic_radius = Math.max(dynamic_radius, proxy.radius)
                }
            }
        }
        if dynamic_radius > 0.0 && dynamic_radius < 1000000.0 {
            return include_plane_pairs3d(store, plane_slots, grid_pairs3d(proxies, dynamic_radius * 2.0 + 0.000002))
        }
    }
    Sort.sort<BroadProxy3D>(&proxies[0:proxies.count()],
        broad_proxy_before3d)
    var pairs:BroadPair3D[] = []
    // The proxies are sorted by their lower X bound. Walk each overlapping
    // interval directly instead of copying the active set for every proxy.
    var first_index = 0
    while first_index < proxies.count() {
        let previous = proxies[first_index]
        var second_index = first_index + 1
        while second_index < proxies.count() {
            let proxy = proxies[second_index]
            if previous.upper.x + 0.000001 < proxy.lower.x { break }
            if previous.upper.y + 0.000001 >= proxy.lower.y &&
                proxy.upper.y + 0.000001 >= previous.lower.y &&
                previous.upper.z + 0.000001 >= proxy.lower.z &&
                proxy.upper.z + 0.000001 >= previous.lower.z &&
                bounding_spheres_overlap3d(previous.position, previous.radius,
                    proxy.position, proxy.radius) {
                if previous.slot < proxy.slot {
                    pairs.append(BroadPair3D(previous.slot, proxy.slot))
                } else {
                    pairs.append(BroadPair3D(proxy.slot, previous.slot))
                }
            }
            second_index++
        }
        first_index++
    }
    Sort.sort<BroadPair3D>(&pairs[0:pairs.count()], broad_pair_before3d)
    return include_plane_pairs3d(store, plane_slots, pairs)
}

// Contacts are ordered by body slots, then by the two child IDs.
func contact_index_at_pair3d(
    contacts:@Contact3D[], first:BodyId3D, second:BodyId3D,
    first_child_id:int, second_child_id:int
) int {
    var lower = 0
    var upper = contacts.count()
    while lower < upper {
        let middle = lower + (upper - lower) / 2
        let candidate = contacts[middle]
        let first_slot = candidate.first_body_id().slot
        let second_slot = candidate.second_body_id().slot
        if contact_key_before3d(first_slot, second_slot,
            candidate.first_child_id(), candidate.second_child_id(),
            first.slot, second.slot, first_child_id, second_child_id) {
            lower = middle + 1
        } else {
            upper = middle
        }
    }
    if lower < contacts.count() {
        let candidate = contacts[lower]
        let first_id = candidate.first_body_id()
        let second_id = candidate.second_body_id()
        if first_id.slot == first.slot &&
            first_id.generation == first.generation &&
            second_id.slot == second.slot &&
            second_id.generation == second.generation &&
            candidate.first_child_id() == first_child_id &&
            candidate.second_child_id() == second_child_id {
            return lower
        }
    }
    return -1
}

func shape_bounding_radius3d(shape:Shape3D) float {
    match shape {
        plane(_) => { panic("GFX.Physics an infinite plane has no bounding radius") }
        triangle(triangle) => {
            return Math.max(triangle.first.length(), Math.max(
                triangle.second.length(), triangle.third.length()))
        }
        convex(hull) => {
            var radius = 0.0
            var index = 0
            while index < hull.triangle_count() {
                let triangle = hull.triangle(index)
                radius = Math.max(radius, Math.max(triangle.first.length(), Math.max(triangle.second.length(), triangle.third.length())))
                index++
            }
            return radius
        }
        mesh(mesh) => {
            var radius = 0.0
            var index = 0
            while index < mesh.triangle_count() {
                let triangle = mesh.triangle(index)
                radius = Math.max(radius, Math.max(triangle.first.length(),
                    Math.max(triangle.second.length(), triangle.third.length())))
                index++
            }
            return radius
        }
        sphere(sphere) => { return sphere.radius }
        box(box) => { return box.half_size().length() }
        capsule(capsule) => { return capsule.half_height + capsule.radius }
        compound(compound) => {
            var radius = 0.0
            var index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                radius = Math.max(radius,
                    child.transform.position.length() +
                    shape_bounding_radius3d(child.shape))
                index++
            }
            return radius
        }
        cylinder(value) => { return value.radius + value.half_height }
        tapered_cylinder(value) => { let radius = Math.max(value.top_radius, value.bottom_radius); return radius + value.half_height }
        tapered_capsule(value) => { return value.half_height + Math.max(value.top_radius, value.bottom_radius) }
    }
}

func bounding_spheres_overlap3d(
    first:Math.Vec3, first_radius:float,
    second:Math.Vec3, second_radius:float
) bool {
    let extent = first_radius + second_radius + 0.000001
    return first.subtract(second).length_squared() <= extent * extent
}

// Conservative bounds of the translation-only CCD path. The hull's actual
// vertices retain local offsets; the search holds both beginning rotations.
struct ShapeBounds3D {
    let lower:Math.Vec3
    let upper:Math.Vec3
    init(lower:Math.Vec3, upper:Math.Vec3) { self.lower = lower; self.upper = upper }
}

// Compound bounds compose leaf poses before bounding them. A translated hull
// may cancel its child's local translation; bounding each offset separately
// would turn separated assemblies into expensive exact CCD candidates.
func shape_pose_bounds3d(shape:Shape3D, pose:Transform3D) ShapeBounds3D {
    match shape {
        compound(compound) => {
            let first = compound.child(0)
            var bounds = shape_pose_bounds3d(first.shape, compound_child_transform(pose, first))
            var index = 1
            while index < compound.child_count() {
                let child = compound.child(index)
                let next = shape_pose_bounds3d(child.shape, compound_child_transform(pose, child))
                bounds = ShapeBounds3D(
                    Math.Vec3(Math.min(bounds.lower.x, next.lower.x), Math.min(bounds.lower.y, next.lower.y), Math.min(bounds.lower.z, next.lower.z)),
                    Math.Vec3(Math.max(bounds.upper.x, next.upper.x), Math.max(bounds.upper.y, next.upper.y), Math.max(bounds.upper.z, next.upper.z)))
                index++
            }
            return bounds
        }
        convex(hull) => {
            var lower = pose.point(hull.vertex(0)); var upper = lower; var index = 1
            while index < hull.vertex_count() {
                let point = pose.point(hull.vertex(index))
                lower = Math.Vec3(Math.min(lower.x, point.x), Math.min(lower.y, point.y), Math.min(lower.z, point.z))
                upper = Math.Vec3(Math.max(upper.x, point.x), Math.max(upper.y, point.y), Math.max(upper.z, point.z))
                index++
            }
            return ShapeBounds3D(lower, upper)
        }
        else => {}
    }
    let extent = broad_extent3d(shape, pose, shape_bounding_radius3d(shape))
    return ShapeBounds3D(pose.position.subtract(extent), pose.position.add(extent))
}

func linear_sweep_bounds3d(shape:Shape3D, start:Transform3D, end:Transform3D) ShapeBounds3D {
    // The exact CCD search holds the beginning rotations for both shapes.
    let bounds = shape_pose_bounds3d(shape, start)
    let motion = end.position.subtract(start.position)
    return ShapeBounds3D(
        bounds.lower.add(Math.Vec3(Math.min(0.0, motion.x), Math.min(0.0, motion.y), Math.min(0.0, motion.z))),
        bounds.upper.add(Math.Vec3(Math.max(0.0, motion.x), Math.max(0.0, motion.y), Math.max(0.0, motion.z))))
}

func linear_sweeps_overlap3d(first:@ShapeBounds3D, second:@ShapeBounds3D) bool {
    return first.upper.x + 0.000001 >= second.lower.x && second.upper.x + 0.000001 >= first.lower.x &&
        first.upper.y + 0.000001 >= second.lower.y && second.upper.y + 0.000001 >= first.lower.y &&
        first.upper.z + 0.000001 >= second.lower.z && second.upper.z + 0.000001 >= first.lower.z
}

func continuous_fraction3d(
    moving_shape:Shape3D,
    moving_start:Transform3D,
    moving_end:Transform3D,
    target_shape:Shape3D,
    target_start:Transform3D,
    target_end:Transform3D
) float? {
    let moving_translation = moving_end.position.subtract(moving_start.position)
    let target_translation = target_end.position.subtract(target_start.position)
    let relative_speed = moving_translation.subtract(target_translation).length()
    if relative_speed <= 0.000001 { return null }
    if !plane_shape3d(moving_shape) && !plane_shape3d(target_shape) {
        let moving_proxy = linear_sweep_bounds3d(moving_shape, moving_start, moving_end)
        let target_proxy = linear_sweep_bounds3d(target_shape, target_start, target_end)
        if !linear_sweeps_overlap3d(moving_proxy, target_proxy) { return null }
    }
    let initial = motion_distance3d(
        ShapePlacement3D(moving_shape, moving_start),
        ShapePlacement3D(target_shape, target_start), moving_start, target_start
    )
    if initial.separation <= 0.000001 { return null }
    var fraction = 0.0
    var iteration = 0
    while iteration < 32 && fraction <= 1.0 {
        let moving_pose = Transform3D(
            moving_start.position.add(moving_translation.multiply(fraction)),
            moving_start.rotation
        )
        let target_pose = Transform3D(
            target_start.position.add(target_translation.multiply(fraction)),
            target_start.rotation
        )
        let distance = motion_distance3d(
            ShapePlacement3D(moving_shape, moving_pose),
            ShapePlacement3D(target_shape, target_pose), moving_start, target_start
        )
        if distance.separation <= 0.000001 {
            // The search margin locates the impact, but is also the solver's
            // contact threshold. Close the remaining gap along the approach
            // instead of leaving the clipped pose on that rounding boundary.
            let closing = moving_translation.subtract(target_translation).dot(distance.normal)
            if distance.separation > 0.0 && closing > 0.0 {
                return Math.min(1.0, fraction + distance.separation / closing)
            }
            return fraction
        }
        fraction += distance.separation / relative_speed
        iteration++
    }
    return null
}

func append_character_shapes3d(shape:Shape3D, transform:Transform3D,
    body_id:BodyId3D, output:&CharacterShape3D[]) {
    match shape {
        compound(compound) => {
            var index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                index++
                append_character_shapes3d(child.shape,
                    compound_child_transform(transform, child), body_id, output)
            }
        }
        box(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        sphere(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        capsule(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        triangle(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        mesh(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        convex(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        cylinder(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        tapered_cylinder(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        tapered_capsule(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
        plane(_) => { output.append(CharacterShape3D(body_id, ShapePlacement3D(shape, transform))) }
    }
}

// Infinite surfaces bypass finite proxies. Keep canonical slot ordering in
// both the grid and sweep branches; no artificial extent enters either path.
func include_plane_pairs3d(store:@BodyStore3D, plane_slots:int[], pairs:BroadPair3D[]) BroadPair3D[] {
    if plane_slots.is_empty() { return pairs }
    var result = pairs
    for slot in plane_slots {
        var other_slot = 0
        while other_slot < store.slots.count() {
            if let other = store.slots[other_slot] {
                if other.is_enabled && !plane_shape3d(other.shape) {
                    if slot < other_slot { result.append(BroadPair3D(slot,other_slot)) }
                    else { result.append(BroadPair3D(other_slot,slot)) }
                }
            }
            other_slot++
        }
    }
    Sort.sort<BroadPair3D>(&result[0:result.count()], broad_pair_before3d)
    return result
}
func hinge_axis_error3d(first:@BodyState3D, second:@BodyState3D,
    state:HingeConstraintState3D) Math.Vec3
{
    let axis = first.transform.vector(state.first_local_axis)
    let other = second.transform.vector(state.second_local_axis)
    let cross = axis.cross(other)
    let length = cross.length()
    if length > 0.000001 {
        return cross.multiply(Math.atan2(length, axis.dot(other)) / length)
    }
    if axis.dot(other) < 0.0 {
        return first.transform.vector(state.first_local_normal).multiply(Math.pi())
    }
    return Math.Vec3()
}

func hinge_angular_mass3d(first:@BodyState3D, second:@BodyState3D, axis:Math.Vec3) float {
    return axis.dot(first.inverse_inertia_times(axis).add(second.inverse_inertia_times(axis)))
}

func apply_hinge_angular_impulse3d(first:&BodyState3D, second:&BodyState3D, impulse:Math.Vec3) {
    first.angular_velocity = first.angular_velocity.subtract(first.inverse_inertia_times(impulse))
    second.angular_velocity = second.angular_velocity.add(second.inverse_inertia_times(impulse))
}

func solve_hinge_motor_velocity3d(first:&BodyState3D, second:&BodyState3D,
    state:HingeConstraintState3D, axis:Math.Vec3, delta:float)
{
    if let motor = state.motor {
        if motor.maximum_torque == 0.0 { return }
        let first_radius = first.transform.point(state.point.first_local_anchor).subtract(first.world_center())
        let second_radius = second.transform.point(state.point.second_local_anchor).subtract(second.world_center())
        let point_mass = point_inverse_mass3d(first, second, first_radius, second_radius)
        if Math.abs(point_mass.determinant()) <= Math.epsilon() { return }
        let coupling = first.inverse_inertia_times(axis).cross(first_radius)
            .add(second.inverse_inertia_times(axis).cross(second_radius))
        let point_response = point_mass.inverted().multiply(coupling)
        let inverse_mass = hinge_angular_mass3d(first, second, axis) - coupling.dot(point_response)
        if inverse_mass <= 0.000000001 { return }
        let speed = second.angular_velocity.subtract(first.angular_velocity).dot(axis)
        let maximum_impulse = motor.maximum_torque * delta
        let previous = state.motor_impulse
        state.motor_impulse = Math.clamp(previous + (motor.speed - speed) / inverse_mass,
            -maximum_impulse, maximum_impulse)
        let change = state.motor_impulse - previous
        let angular_impulse = axis.multiply(change)
        let anchor_impulse = point_response.multiply(-change)
        apply_hinge_angular_impulse3d(first, second, angular_impulse)
        apply_contact_impulse3d(first, second, first_radius, second_radius, anchor_impulse)
        state.angular_impulse = state.angular_impulse.add(angular_impulse)
        state.point.impulse = state.point.impulse.add(anchor_impulse)
    }
}

func solve_hinge_velocity3d(first:&BodyState3D, second:&BodyState3D,
    state:HingeConstraintState3D, delta:float)
{
    solve_point_velocity3d(first, second, state.point, delta)
    let axis = first.transform.vector(state.first_local_axis)
    let normal = first.transform.vector(state.first_local_normal)
    let tangent = axis.cross(normal)
    let error = hinge_axis_error3d(first, second, state)
    var row = 0
    while row < 2 {
        var direction = normal
        if row == 1 { direction = tangent }
        let mass = hinge_angular_mass3d(first, second, direction)
        if mass > 0.000000001 {
            let speed = second.angular_velocity.subtract(first.angular_velocity).dot(direction)
            let bias = Math.clamp(error.dot(direction) * 0.2 / delta, -10.0, 10.0)
            let impulse = direction.multiply(-(speed + bias) / mass)
            apply_hinge_angular_impulse3d(first, second, impulse)
            state.angular_impulse = state.angular_impulse.add(impulse)
        }
        row++
    }
    let mass = hinge_angular_mass3d(first, second, axis)
    if mass <= 0.000000001 { return }
    solve_hinge_motor_velocity3d(first, second, state, axis, delta)
    if state.minimum_angle == -Math.pi() && state.maximum_angle == Math.pi() { return }
    let angle = hinge_angle3d(first.transform, second.transform, state)
    row = 0
    while row < 2 {
        let speed = second.angular_velocity.subtract(first.angular_velocity).dot(axis)
        var error_angle = angle - state.minimum_angle
        var previous = state.lower_impulse
        if row == 1 { error_angle = angle - state.maximum_angle; previous = state.upper_impulse }
        var factor = 1.0
        if (row == 0 && error_angle < 0.0) || (row == 1 && error_angle > 0.0) ||
            state.minimum_angle == state.maximum_angle { factor = 0.2 }
        let bias = Math.clamp(error_angle * factor / delta, -10.0, 10.0)
        var accumulated = previous - (speed + bias) / mass
        if state.minimum_angle != state.maximum_angle {
            if row == 0 { accumulated = Math.max(0.0, accumulated) }
            else { accumulated = Math.min(0.0, accumulated) }
        }
        if row == 0 { state.lower_impulse = accumulated }
        else { state.upper_impulse = accumulated }
        let impulse = axis.multiply(accumulated - previous)
        apply_hinge_angular_impulse3d(first, second, impulse)
        state.angular_impulse = state.angular_impulse.add(impulse)
        if state.minimum_angle == state.maximum_angle { return }
        row++
    }
}

func shift_hinge_rotation3d(body:BodyState3D, impulse:Math.Vec3) {
    if body.inverse_mass == 0.0 { return }
    let center = body.world_center()
    let vector = body.inverse_inertia_times(impulse)
    let angle = vector.length()
    if angle <= 0.0 { return }
    let rotation = Math.Quat.angle_axis(angle, vector.divide(angle))
        .multiply(body.transform.rotation).normalized()
    body.transform = Transform3D(center.subtract(rotation.rotate(body.mass_properties.local_center)), rotation)
}

func solve_hinge_position3d(first:BodyState3D, second:BodyState3D,
    state:HingeConstraintState3D)
{
    var row = 0
    while row < 3 {
        let axis = first.transform.vector(state.first_local_axis)
        let normal = first.transform.vector(state.first_local_normal)
        var direction = normal
        var error = hinge_axis_error3d(first, second, state).dot(normal)
        if row == 1 {
            direction = axis.cross(normal)
            error = hinge_axis_error3d(first, second, state).dot(direction)
        } else if row == 2 {
            direction = axis
            let angle = hinge_angle3d(first.transform, second.transform, state)
            error = angle - Math.clamp(angle, state.minimum_angle, state.maximum_angle)
        }
        let mass = hinge_angular_mass3d(first, second, direction)
        if mass > 0.000000001 && Math.abs(error) > 0.000001 {
            let impulse = direction.multiply(-Math.clamp(error, -0.2, 0.2) * 0.8 / mass)
            shift_hinge_rotation3d(first, impulse.negated())
            shift_hinge_rotation3d(second, impulse)
        }
        row++
    }
    solve_point_position3d(first, second, state.point)
}

struct FixedImpulse3D {
    let linear:Math.Vec3
    let angular:Math.Vec3
    init(linear:Math.Vec3, angular:Math.Vec3) { self.linear = linear; self.angular = angular }
}

// Mobility matrices can be nonsingular below the general Mat3 epsilon.
func fixed_inverse3d(matrix:Math.Mat3) Math.Mat3 {
    let first = matrix.row(0)
    let second = matrix.row(1)
    let third = matrix.row(2)
    let determinant = first.dot(second.cross(third))
    if determinant == 0.0 { return Math.Mat3.zero() }
    return Math.Mat3(second.cross(third), third.cross(first), first.cross(second))
        .multiply(1.0 / determinant)
}

func fixed_coupling_column3d(first:@BodyState3D, second:@BodyState3D,
    first_radius:Math.Vec3, second_radius:Math.Vec3, axis:Math.Vec3) Math.Vec3
{
    return first.inverse_inertia_times(axis).cross(first_radius)
        .add(second.inverse_inertia_times(axis).cross(second_radius))
}

func fixed_impulse3d(first:@BodyState3D, second:@BodyState3D,
    first_radius:Math.Vec3, second_radius:Math.Vec3,
    linear_error:Math.Vec3, angular_error:Math.Vec3) FixedImpulse3D
{
    let x = Math.Vec3(1.0, 0.0, 0.0)
    let y = Math.Vec3(0.0, 1.0, 0.0)
    let z = Math.Vec3(0.0, 0.0, 1.0)
    let point_inverse = fixed_inverse3d(point_inverse_mass3d(first, second, first_radius, second_radius))
    let angular_mass = Math.Mat3(
        first.inverse_inertia_times(x).add(second.inverse_inertia_times(x)),
        first.inverse_inertia_times(y).add(second.inverse_inertia_times(y)),
        first.inverse_inertia_times(z).add(second.inverse_inertia_times(z)))
    let coupling = Math.Mat3(
        fixed_coupling_column3d(first, second, first_radius, second_radius, x),
        fixed_coupling_column3d(first, second, first_radius, second_radius, y),
        fixed_coupling_column3d(first, second, first_radius, second_radius, z))
    // Eliminate the linear block while preserving its angular coupling.
    let response = point_inverse.multiply(coupling)
    let schur = angular_mass.subtract(coupling.transposed().multiply(response))
    let angular = fixed_inverse3d(schur).multiply(angular_error.subtract(
        coupling.transposed().multiply(point_inverse.multiply(linear_error)))).negated()
    let linear = point_inverse.multiply(linear_error.add(coupling.multiply(angular))).negated()
    return FixedImpulse3D(linear, angular)
}

func fixed_bounded_error3d(error:Math.Vec3, maximum:float) Math.Vec3 {
    if error.length_squared() > maximum * maximum { return error.normalized().multiply(maximum) }
    return error
}

func solve_fixed_velocity3d(first:&BodyState3D, second:&BodyState3D,
    state:FixedConstraintState3D, delta:float)
{
    let first_point = first.transform.point(state.first_local_anchor)
    let second_point = second.transform.point(state.second_local_anchor)
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let linear_bias = fixed_bounded_error3d(second_point.subtract(first_point).multiply(0.2 / delta), 10.0)
    let angular_bias = fixed_bounded_error3d(fixed_angular_error3d(first.transform, second.transform, state)
        .multiply(0.2 / delta), 10.0)
    let impulse = fixed_impulse3d(first, second, first_radius, second_radius,
        contact_relative_velocity3d(first, second, first_radius, second_radius).add(linear_bias),
        second.angular_velocity.subtract(first.angular_velocity).add(angular_bias))
    apply_contact_impulse3d(first, second, first_radius, second_radius, impulse.linear)
    apply_hinge_angular_impulse3d(first, second, impulse.angular)
    state.impulse = state.impulse.add(impulse.linear)
    state.angular_impulse = state.angular_impulse.add(impulse.angular)
    state.inverse_delta = 1.0 / delta
}

func solve_fixed_position3d(first:BodyState3D, second:BodyState3D,
    state:FixedConstraintState3D)
{
    let first_point = first.transform.point(state.first_local_anchor)
    let second_point = second.transform.point(state.second_local_anchor)
    let linear_error = fixed_bounded_error3d(second_point.subtract(first_point), 0.2)
    let angular_error = fixed_bounded_error3d(fixed_angular_error3d(first.transform, second.transform, state), 0.2)
    if linear_error.length_squared() < 0.0000000001 && angular_error.length_squared() < 0.0000000001 { return }
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let impulse = fixed_impulse3d(first, second, first_radius, second_radius,
        linear_error.multiply(0.8), angular_error.multiply(0.8))
    shift_fixed_body3d(first, impulse.linear.negated(), impulse.angular.negated(), first_radius)
    shift_fixed_body3d(second, impulse.linear, impulse.angular, second_radius)
}

func shift_fixed_body3d(body:BodyState3D, linear:Math.Vec3, angular:Math.Vec3, radius:Math.Vec3) {
    if body.inverse_mass == 0.0 { return }
    let center = body.world_center().add(linear.multiply(body.inverse_mass))
    // Sum both moments before changing orientation or evaluating world inertia again.
    let vector = body.inverse_inertia_times(radius.cross(linear).add(angular))
    let angle = vector.length()
    var rotation = body.transform.rotation
    if angle > 0.0 {
        rotation = Math.Quat.angle_axis(angle, vector.divide(angle)).multiply(rotation).normalized()
    }
    body.transform = Transform3D(center.subtract(rotation.rotate(body.mass_properties.local_center)), rotation)
}
