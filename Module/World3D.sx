use GFX.Physics.Box3D.Box3D
use GFX.Physics.ContactManifold3D.box_box_contact_points
use GFX.Physics.ContactManifold3D.capsule_capsule_contact_points
use GFX.Physics.Contact3D.Contact3D
use GFX.Physics.Contact3D.ContactPoint3D
use GFX.Physics.DistanceConstraint3D.DistanceConstraint3D
use GFX.Physics.DistanceConstraint3D.DistanceConstraint3DSettings
use GFX.Physics.DistanceConstraint3D.DistanceConstraintState3D
use GFX.Physics.DistanceConstraint3D.DistanceConstraintStore3D
use GFX.Physics.PointConstraint3D.PointConstraint3D
use GFX.Physics.PointConstraint3D.PointConstraint3DSettings
use GFX.Physics.PointConstraint3D.PointConstraintState3D
use GFX.Physics.PointConstraint3D.PointConstraintStore3D
use GFX.Physics.Geometry3D.Geometry3D
use GFX.Physics.Geometry3D.ShapePlacement3D
use GFX.Physics.Geometry3D.compound_child_transform
use GFX.Physics.RigidBody3D.BodyId3D
use GFX.Physics.RigidBody3D.BodyState3D
use GFX.Physics.RigidBody3D.BodyStore3D
use GFX.Physics.RigidBody3D.BodyType3D
use GFX.Physics.RigidBody3D.RigidBody3D
use GFX.Physics.RigidBody3D.RigidBody3DSettings
use GFX.Physics.RigidBody3D.finite_body3d_point
use GFX.Physics.RigidBody3D.finite_body3d_value
use GFX.Physics.Transform3D.Transform3D
use GFX.Physics.Shape3D.Shape3D
use GFX.Physics.Geometry3D.Ray3D
use GFX.Physics.WorldQuery3D.WorldRayHit3D
use GFX.Physics.WorldQuery3D.WorldOverlap3D
use GFX.Physics.CollisionFilter3D.QueryFilter3D
use STD.Math

public struct World3DSettings {
    var gravity:Math.Vec3
    init() { self.gravity = Math.Vec3(0.0, -9.81, 0.0) }
}

public class World3D {
    private var store:BodyStore3D
    private var distance_constraints:DistanceConstraintStore3D
    private var point_constraints:PointConstraintStore3D
    private var current_gravity:Math.Vec3
    private var contacts:Contact3D[]
    private var contact_begins:Contact3D[]
    private var contact_ends:Contact3D[]
    private var pending_contact_ends:Contact3D[]

    drop {
        self.distance_constraints.invalidate_all()
        self.point_constraints.invalidate_all()
        self.store.invalidate_all()
    }

    init(settings:World3DSettings = World3DSettings()) {
        if !finite_body3d_point(settings.gravity) {
            panic("GFX.Physics.World3D requires finite gravity")
        }
        self.store = BodyStore3D()
        self.distance_constraints = DistanceConstraintStore3D(self.store)
        self.point_constraints = PointConstraintStore3D(self.store)
        self.current_gravity = settings.gravity
        self.contacts = []
        self.contact_begins = []
        self.contact_ends = []
        self.pending_contact_ends = []
    }

    func gravity() Math.Vec3 { return self.current_gravity }

    func set_gravity(gravity:Math.Vec3) {
        if !finite_body3d_point(gravity) {
            panic("GFX.Physics.World3D requires finite gravity")
        }
        self.store.require_mutable()
        self.current_gravity = gravity
        self.store.wake_all()
    }

    func body_count() int { return self.store.live_count }
    func distance_constraint_count() int { return self.distance_constraints.live_count }
    func point_constraint_count() int { return self.point_constraints.live_count }
    func contact_count() int { return self.contacts.count() }

    func write_contacts(output:&Contact3D[]) {
        output.clear()
        for contact in self.contacts { output.append(contact) }
    }

    func write_contact_begin_events(output:&Contact3D[]) {
        output.clear()
        for contact in self.contact_begins { output.append(contact) }
    }

    func write_contact_end_events(output:&Contact3D[]) {
        output.clear()
        for contact in self.contact_ends { output.append(contact) }
    }

    func create_rigid_body(settings:RigidBody3DSettings = RigidBody3DSettings()) RigidBody3D {
        let id = self.store.append(settings)
        return RigidBody3D(self.store, id)
    }

    func create_distance_constraint(
        first:RigidBody3D, second:RigidBody3D,
        settings:DistanceConstraint3DSettings
    ) DistanceConstraint3D {
        let id = self.distance_constraints.append(first, second, settings)
        return DistanceConstraint3D(self.distance_constraints, id)
    }

    func destroy_distance_constraint(constraint:DistanceConstraint3D) {
        self.store.require_mutable()
        if !constraint.belongs_to(self.distance_constraints) {
            panic("GFX.Physics.World3D cannot destroy a constraint owned by another world")
        }
        self.distance_constraints.destroy(constraint.constraint_id())
    }

    func create_point_constraint(
        first:RigidBody3D, second:RigidBody3D,
        settings:PointConstraint3DSettings = PointConstraint3DSettings()
    ) PointConstraint3D {
        let id = self.point_constraints.append(first, second, settings)
        return PointConstraint3D(self.point_constraints, id)
    }

    func destroy_point_constraint(constraint:PointConstraint3D) {
        self.store.require_mutable()
        if !constraint.belongs_to(self.point_constraints) {
            panic("GFX.Physics.World3D cannot destroy a constraint owned by another world")
        }
        self.point_constraints.destroy(constraint.constraint_id())
    }

    func destroy_rigid_body(body:RigidBody3D) {
        self.store.require_mutable()
        if !body.belongs_to(self.store) {
            panic("GFX.Physics.World3D cannot destroy a body owned by another world")
        }
        for contact in self.contacts {
            if contact.first_body().same_body(body) {
                self.store.require(contact.second_body().body_id()).wake()
                self.pending_contact_ends.append(contact)
            }
            if contact.second_body().same_body(body) {
                self.store.require(contact.first_body().body_id()).wake()
                self.pending_contact_ends.append(contact)
            }
        }
        self.distance_constraints.destroy_for_body(body.body_id())
        self.point_constraints.destroy_for_body(body.body_id())
        self.store.destroy(body.body_id())
        var retained:Contact3D[] = []
        for contact in self.contacts {
            if !contact.first_body().same_body(body) &&
                !contact.second_body().same_body(body)
            {
                retained.append(contact)
            }
        }
        self.contacts = retained
    }

    func write_bodies(output:&RigidBody3D[]) {
        output.clear()
        var slot = 0
        while slot < self.store.slots.count() {
            if self.store.slots[slot] != null {
                output.append(RigidBody3D(
                    self.store,
                    BodyId3D(slot, self.store.generations[slot])
                ))
            }
            slot++
        }
    }

    private func ignored_query_slot(ignore_body:RigidBody3D?) int {
        if let excluded = ignore_body {
            if !excluded.belongs_to(self.store) || !excluded.is_valid() {
                panic("GFX.Physics.World3D query requires a live ignored body from this world")
            }
            return excluded.body_id().slot
        }
        return -1
    }

    func ray_cast(
        ray:Ray3D, ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) WorldRayHit3D? {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        var nearest:WorldRayHit3D? = null
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let hit = Geometry3D.ray_cast(
                            ray, ShapePlacement3D(state.shape, state.transform)
                        )
                        if hit.hit {
                            if let previous = nearest {
                                if hit.fraction < previous.fraction() {
                                    nearest = WorldRayHit3D(RigidBody3D(
                                        self.store, BodyId3D(slot, self.store.generations[slot])
                                    ), hit)
                                }
                            } else {
                                nearest = WorldRayHit3D(RigidBody3D(
                                    self.store, BodyId3D(slot, self.store.generations[slot])
                                ), hit)
                            }
                        }
                    }
                }
            }
            slot++
        }
        return nearest
    }

    func write_ray_hits(
        ray:Ray3D, output:&WorldRayHit3D[], ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        output.clear()
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let hit = Geometry3D.ray_cast(
                            ray, ShapePlacement3D(state.shape, state.transform)
                        )
                        if hit.hit {
                            output.append(WorldRayHit3D(RigidBody3D(
                                self.store, BodyId3D(slot, self.store.generations[slot])
                            ), hit))
                        }
                    }
                }
            }
            slot++
        }
        var index = 1
        while index < output.count() {
            var current = index
            while current > 0 && output[current - 1].fraction() > output[current].fraction() {
                output.swap(current - 1, current)
                current--
            }
            index++
        }
    }

    func write_overlaps(
        query:ShapePlacement3D, output:&WorldOverlap3D[],
        ignore_body:RigidBody3D? = null,
        filter:QueryFilter3D = QueryFilter3D()
    ) {
        let ignored_slot = self.ignored_query_slot(ignore_body)
        output.clear()
        var slot = 0
        while slot < self.store.slots.count() {
            if slot != ignored_slot {
                if var state = self.store.slots[slot] {
                    if state.is_enabled && filter.allows(
                        state.collision_filter, state.is_sensor
                    ) {
                        let target = ShapePlacement3D(state.shape, state.transform)
                        if Geometry3D.overlaps(query, target) {
                            let distance = Geometry3D.distance(query, target)
                            output.append(WorldOverlap3D(RigidBody3D(
                                self.store, BodyId3D(slot, self.store.generations[slot])
                            ), distance.first_child_id, distance.second_child_id))
                        }
                    }
                }
            }
            slot++
        }
    }

    func step(delta:float) {
        if !finite_body3d_value(delta) || delta < 0.0 {
            panic("GFX.Physics.World3D.step requires a finite non-negative delta")
        }
        self.store.require_mutable()
        if delta == 0.0 { return }
        self.store.locked = true
        self.wake_constraint_islands()
        var has_continuous_body = false
        for state in self.store.slots {
            if let body = state {
                if body.is_enabled && body.awake &&
                    body.body_type == BodyType3D.dynamic &&
                    body.continuous_collision
                {
                    has_continuous_body = true
                }
            }
        }
        var previous_poses:Transform3D[] = []
        if has_continuous_body {
            for state in self.store.slots {
                if let body = state {
                    previous_poses.append(body.transform)
                } else {
                    previous_poses.append(Transform3D())
                }
            }
        }
        var slot = 0
        while slot < self.store.slots.count() {
            if var state = self.store.slots[slot] {
                if state.is_enabled {
                    match state.body_type {
                        fixed => {}
                        kinematic => { integrate_kinematic3d(state, delta) }
                        dynamic => {
                            if state.awake {
                                integrate_dynamic3d(state, self.current_gravity, delta)
                            }
                        }
                    }
                }
                state.force = Math.Vec3()
                state.torque = Math.Vec3()
            }
            slot++
        }
        if has_continuous_body { self.apply_continuous_motion(previous_poses) }
        var continuous_poses:Transform3D[] = []
        if has_continuous_body {
            for state in self.store.slots {
                if let body = state {
                    continuous_poses.append(body.transform)
                } else {
                    continuous_poses.append(Transform3D())
                }
            }
        }
        self.detect_and_resolve_contacts(delta)
        if has_continuous_body {
            self.emit_continuous_sensor_events(previous_poses, continuous_poses)
        }
        self.update_sleep(delta)
        self.store.locked = false
    }

    private func apply_continuous_motion(previous_poses:Transform3D[]) {
        var moving_slot = 0
        while moving_slot < self.store.slots.count() {
            if var moving = self.store.slots[moving_slot] {
                if moving.is_enabled && moving.awake &&
                    moving.body_type == BodyType3D.dynamic &&
                    moving.continuous_collision && !moving.is_sensor
                {
                    var first_fraction = 2.0
                    var best_position:Math.Vec3? = null
                    let moving_end = moving.transform
                    var target_slot = 0
                    while target_slot < self.store.slots.count() {
                        if target_slot != moving_slot {
                            if var target = self.store.slots[target_slot] {
                                if target.is_enabled && !target.is_sensor &&
                                    moving.collision_filter.allows(target.collision_filter)
                                {
                                    let fraction = continuous_fraction3d(
                                        moving.shape, previous_poses[moving_slot],
                                        moving_end, target.shape,
                                        previous_poses[target_slot], target.transform
                                    )
                                    if let hit = fraction {
                                        if hit < first_fraction {
                                            first_fraction = hit
                                            let relative_start = previous_poses[moving_slot]
                                                .position.subtract(
                                                    previous_poses[target_slot].position
                                                )
                                            let relative_motion = moving_end.position
                                                .subtract(previous_poses[moving_slot].position)
                                                .subtract(target.transform.position.subtract(
                                                    previous_poses[target_slot].position
                                                ))
                                            best_position = target.transform.position
                                                .add(relative_start)
                                                .add(relative_motion.multiply(
                                                    Math.min(1.0, hit + 0.000001)
                                                ))
                                        }
                                    }
                                }
                            }
                        }
                        target_slot++
                    }
                    if let position = best_position {
                        moving.transform = Transform3D(position, moving_end.rotation)
                    }
                }
            }
            moving_slot++
        }
    }

    private func emit_continuous_sensor_events(
        previous_poses:Transform3D[], continuous_poses:Transform3D[]
    ) {
        var first_slot = 0
        while first_slot < self.store.slots.count() {
            if var first = self.store.slots[first_slot] {
                if first.is_enabled {
                    var second_slot = first_slot + 1
                    while second_slot < self.store.slots.count() {
                        if var second = self.store.slots[second_slot] {
                            if second.is_enabled && (first.is_sensor || second.is_sensor) &&
                                first.collision_filter.allows(second.collision_filter) &&
                                ((first.body_type == BodyType3D.dynamic &&
                                    first.continuous_collision && first.awake) ||
                                    (second.body_type == BodyType3D.dynamic &&
                                        second.continuous_collision && second.awake))
                            {
                                let initial = Geometry3D.distance(
                                    ShapePlacement3D(first.shape, previous_poses[first_slot]),
                                    ShapePlacement3D(second.shape, previous_poses[second_slot])
                                )
                                let final = Geometry3D.distance(
                                    ShapePlacement3D(first.shape, continuous_poses[first_slot]),
                                    ShapePlacement3D(second.shape, continuous_poses[second_slot])
                                )
                                if initial.separation > 0.000001 &&
                                    final.separation > 0.000001
                                {
                                    let fraction = continuous_fraction3d(
                                        first.shape, previous_poses[first_slot],
                                        continuous_poses[first_slot], second.shape,
                                        previous_poses[second_slot],
                                        continuous_poses[second_slot]
                                    )
                                    if let hit = fraction {
                                        let first_motion = continuous_poses[first_slot]
                                            .position.subtract(previous_poses[first_slot].position)
                                        let second_motion = continuous_poses[second_slot]
                                            .position.subtract(previous_poses[second_slot].position)
                                        let first_pose = Transform3D(
                                            previous_poses[first_slot].position.add(
                                                first_motion.multiply(hit)
                                            ), previous_poses[first_slot].rotation
                                        )
                                        let second_pose = Transform3D(
                                            previous_poses[second_slot].position.add(
                                                second_motion.multiply(hit)
                                            ), previous_poses[second_slot].rotation
                                        )
                                        let witness = Geometry3D.distance(
                                            ShapePlacement3D(first.shape, first_pose),
                                            ShapePlacement3D(second.shape, second_pose)
                                        )
                                        var contact = Contact3D(
                                            RigidBody3D(self.store, BodyId3D(
                                                first_slot, self.store.generations[first_slot]
                                            )),
                                            RigidBody3D(self.store, BodyId3D(
                                                second_slot, self.store.generations[second_slot]
                                            )),
                                            witness.normal, witness.separation,
                                            witness.first_point.add(witness.second_point)
                                                .multiply(0.5),
                                            0.0, Math.Vec3(), 0.0, 0.0, [],
                                            witness.first_child_id, witness.second_child_id,
                                            true
                                        )
                                        self.contact_begins.append(contact)
                                        self.contact_ends.append(contact)
                                    }
                                }
                            }
                        }
                        second_slot++
                    }
                }
            }
            first_slot++
        }
    }

    private func wake_constraint_islands() {
        var pass = 0
        while pass < self.distance_constraints.live_count + self.point_constraints.live_count {
            for slot in self.distance_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled {
                            if first.body_type == BodyType3D.kinematic &&
                                (first.linear_velocity.length_squared() > 0.0 ||
                                    first.angular_velocity.length_squared() > 0.0)
                            {
                                second.wake()
                            }
                            if second.body_type == BodyType3D.kinematic &&
                                (second.linear_velocity.length_squared() > 0.0 ||
                                    second.angular_velocity.length_squared() > 0.0)
                            {
                                first.wake()
                            }
                            if first.awake && !second.awake { second.wake() }
                            if second.awake && !first.awake { first.wake() }
                        }
                    }
                }
            }
            for slot in self.point_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled {
                            if first.body_type == BodyType3D.kinematic &&
                                (first.linear_velocity.length_squared() > 0.0 ||
                                    first.angular_velocity.length_squared() > 0.0)
                            {
                                second.wake()
                            }
                            if second.body_type == BodyType3D.kinematic &&
                                (second.linear_velocity.length_squared() > 0.0 ||
                                    second.angular_velocity.length_squared() > 0.0)
                            {
                                first.wake()
                            }
                            if first.awake && !second.awake { second.wake() }
                            if second.awake && !first.awake { first.wake() }
                        }
                    }
                }
            }
            pass++
        }
    }

    private func detect_and_resolve_contacts(delta:float) {
        var previous_contacts:Contact3D[] = []
        for contact in self.contacts { previous_contacts.append(contact) }
        self.contacts.clear()
        self.contact_begins.clear()
        self.contact_ends.clear()
        for contact in self.pending_contact_ends {
            self.contact_ends.append(contact)
        }
        self.pending_contact_ends.clear()
        var pairs:ContactPairState3D[] = []
        var first_slot = 0
        while first_slot < self.store.slots.count() {
            if var first = self.store.slots[first_slot] {
                if first.is_enabled {
                    var second_slot = first_slot + 1
                    while second_slot < self.store.slots.count() {
                        if var second = self.store.slots[second_slot] {
                            if second.is_enabled &&
                                first.collision_filter.allows(second.collision_filter) &&
                                (first.body_type == BodyType3D.dynamic ||
                                    second.body_type == BodyType3D.dynamic ||
                                    ((first.is_sensor || second.is_sensor) &&
                                        (first.body_type == BodyType3D.kinematic ||
                                            second.body_type == BodyType3D.kinematic)))
                            {
                                let distance = Geometry3D.distance(
                                    ShapePlacement3D(first.shape, first.transform),
                                    ShapePlacement3D(second.shape, second.transform)
                                )
                                if distance.separation <= 0.000001 {
                                    let first_contact_shape = contact_placement3d(
                                        first, distance.first_child_id
                                    )
                                    let second_contact_shape = contact_placement3d(
                                        second, distance.second_child_id
                                    )
                                    let normal = contact_normal3d(
                                        first_contact_shape, second_contact_shape,
                                        distance.normal
                                    )
                                    var point = distance.first_point.add(
                                        distance.second_point
                                    ).multiply(0.5)
                                    let sensor_pair = first.is_sensor || second.is_sensor
                                    var points:Math.Vec3[] = []
                                    if !sensor_pair {
                                        points = contact_points3d(
                                            first_contact_shape, second_contact_shape,
                                            normal, point
                                        )
                                    }
                                    if !points.is_empty() {
                                        point = Math.Vec3()
                                        for candidate in points {
                                            point = point.add(candidate)
                                        }
                                        point = point.divide(points.count() as float)
                                    }
                                    var friction = 0.0
                                    var restitution = 0.0
                                    if !sensor_pair {
                                        friction = Math.sqrt(first.friction) *
                                            Math.sqrt(second.friction)
                                        restitution = Math.max(
                                            first.restitution, second.restitution
                                        )
                                    }
                                    var constraints:ContactPointState3D[] = []
                                    for candidate in points {
                                        constraints.append(ContactPointState3D(
                                            candidate, first, second, normal, restitution
                                        ))
                                    }
                                    let first_id = BodyId3D(
                                        first_slot, self.store.generations[first_slot]
                                    )
                                    let second_id = BodyId3D(
                                        second_slot, self.store.generations[second_slot]
                                    )
                                    var had_previous = false
                                    for previous in previous_contacts {
                                        if previous.first_body().same_body(
                                            RigidBody3D(self.store, first_id)
                                        ) && previous.second_body().same_body(
                                            RigidBody3D(self.store, second_id)
                                        ) && previous.first_child_id() ==
                                            distance.first_child_id &&
                                            previous.second_child_id() ==
                                                distance.second_child_id &&
                                            previous.is_sensor() == sensor_pair {
                                            had_previous = true
                                        }
                                    }
                                    if !sensor_pair {
                                        if !had_previous ||
                                            (first.body_type == BodyType3D.kinematic &&
                                                (first.linear_velocity.length_squared() > 0.0 ||
                                                    first.angular_velocity.length_squared() > 0.0)) ||
                                            (second.body_type == BodyType3D.kinematic &&
                                                (second.linear_velocity.length_squared() > 0.0 ||
                                                    second.angular_velocity.length_squared() > 0.0))
                                        {
                                            first.wake()
                                            second.wake()
                                        } else {
                                            if first.awake && !second.awake { second.wake() }
                                            if second.awake && !first.awake { first.wake() }
                                        }
                                    }
                                    let active = !sensor_pair &&
                                        (first.awake || second.awake)
                                    pairs.append(ContactPairState3D(
                                        first, second,
                                        first_id, second_id,
                                        normal, distance.separation, point,
                                        friction, restitution, constraints, active,
                                        distance.first_child_id, distance.second_child_id,
                                        sensor_pair
                                    ))
                                }
                            }
                        }
                        second_slot++
                    }
                }
            }
            first_slot++
        }
        for var pair in pairs {
            if !pair.active { continue }
            for previous in previous_contacts {
                if previous.first_body().same_body(
                    RigidBody3D(self.store, pair.first_id)
                ) && previous.second_body().same_body(
                    RigidBody3D(self.store, pair.second_id)
                ) && !previous.is_sensor() &&
                    previous.first_child_id() == pair.first_child_id &&
                    previous.second_child_id() == pair.second_child_id &&
                    previous.normal().dot(pair.normal) > 0.95 {
                    warm_contact_points3d(
                        pair.first, pair.second, pair.normal, pair.friction,
                        pair.constraints, previous
                    )
                }
            }
        }
        for slot in self.distance_constraints.slots {
            if var constraint = slot {
                constraint.axial_impulse = 0.0
                constraint.reaction_axis = Math.Vec3()
                constraint.inverse_delta = 0.0
            }
        }
        for slot in self.point_constraints.slots {
            if var constraint = slot {
                constraint.impulse = Math.Vec3()
                constraint.inverse_delta = 0.0
            }
        }
        // A multi-point face must settle its normal support before friction
        // reacts to transient angular slip from individual point updates.
        var normal_iteration = 0
        while normal_iteration < 4 {
            for var pair in pairs {
                if pair.active && pair.friction > 0.0 && pair.constraints.count() > 1
                {
                    for constraint in pair.constraints {
                        solve_contact_point3d(
                            pair.first, pair.second, pair.normal, pair.friction,
                            constraint, false
                        )
                    }
                }
            }
            normal_iteration++
        }
        var iteration = 0
        while iteration < 12 {
            var pair_index = 0
            while pair_index < pairs.count() {
                var selected_pair = pair_index
                if iteration % 2 == 1 {
                    selected_pair = pairs.count() - 1 - pair_index
                }
                var pair = pairs[selected_pair]
                if !pair.active {
                    pair_index++
                    continue
                }
                var point_index = 0
                while point_index < pair.constraints.count() {
                    var selected_point = point_index
                    if iteration % 2 == 1 {
                        selected_point = pair.constraints.count() - 1 - point_index
                    }
                    solve_contact_point3d(
                        pair.first, pair.second, pair.normal, pair.friction,
                        pair.constraints[selected_point]
                    )
                    point_index++
                }
                pair_index++
            }
            var constraint_index = 0
            while constraint_index < self.distance_constraints.slots.count() {
                var selected = constraint_index
                if iteration % 2 == 1 {
                    selected = self.distance_constraints.slots.count() - 1 - constraint_index
                }
                if var constraint = self.distance_constraints.slots[selected] {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_distance_velocity3d(first, second, constraint, delta)
                        }
                    }
                }
                constraint_index++
            }
            constraint_index = 0
            while constraint_index < self.point_constraints.slots.count() {
                var selected = constraint_index
                if iteration % 2 == 1 {
                    selected = self.point_constraints.slots.count() - 1 - constraint_index
                }
                if var constraint = self.point_constraints.slots[selected] {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_point_velocity3d(first, second, constraint, delta)
                        }
                    }
                }
                constraint_index++
            }
            iteration++
        }
        for var pair in pairs {
            var normal_impulse = 0.0
            var tangent_impulse = Math.Vec3()
            var public_points:ContactPoint3D[] = []
            for constraint in pair.constraints {
                normal_impulse += constraint.normal_impulse
                tangent_impulse = tangent_impulse.add(constraint.tangent_impulse)
                public_points.append(ContactPoint3D(
                    constraint.point, constraint.normal_impulse,
                    constraint.tangent_impulse
                ))
            }
            if pair.active {
                correct_contact3d(
                    pair.first, pair.second, pair.normal, pair.separation
                )
            }
            self.contacts.append(Contact3D(
                RigidBody3D(self.store, pair.first_id),
                RigidBody3D(self.store, pair.second_id),
                pair.normal, pair.separation, pair.point,
                normal_impulse, tangent_impulse,
                pair.friction, pair.restitution, public_points,
                pair.first_child_id, pair.second_child_id, pair.is_sensor
            ))
        }
        var position_iteration = 0
        while position_iteration < 4 {
            for slot in self.distance_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_distance_position3d(first, second, constraint)
                        }
                    }
                }
            }
            for slot in self.point_constraints.slots {
                if var constraint = slot {
                    if constraint.is_enabled {
                        var first = self.store.require(constraint.first_id)
                        var second = self.store.require(constraint.second_id)
                        if first.is_enabled && second.is_enabled &&
                            (first.awake || second.awake)
                        {
                            solve_point_position3d(first, second, constraint)
                        }
                    }
                }
            }
            position_iteration++
        }
        for contact in self.contacts {
            var was_present = false
            for previous in previous_contacts {
                if same_contact_identity3d(previous, contact) {
                    was_present = true
                }
            }
            if !was_present { self.contact_begins.append(contact) }
        }
        for previous in previous_contacts {
            var is_present = false
            for contact in self.contacts {
                if same_contact_identity3d(previous, contact) {
                    is_present = true
                }
            }
            if !is_present { self.contact_ends.append(previous) }
        }
    }

    private func update_sleep(delta:float) {
        var slot = 0
        while slot < self.store.slots.count() {
            if var state = self.store.slots[slot] {
                if state.body_type == BodyType3D.dynamic && state.is_enabled && state.awake {
                    if state.allow_sleep &&
                        state.linear_velocity.length() <= state.sleep_threshold &&
                        state.angular_velocity.length() <= state.sleep_threshold
                    {
                        state.sleep_time += delta
                    } else {
                        state.sleep_time = 0.0
                    }
                }
            }
            slot++
        }
        var handled:int[] = []
        slot = 0
        while slot < self.store.slots.count() {
            if var state = self.store.slots[slot] {
                if state.body_type == BodyType3D.dynamic && state.is_enabled &&
                    state.awake && !contains_contact_slot3d(handled, slot)
                {
                    var members:int[] = [slot]
                    var index = 0
                    while index < members.count() {
                        let current = members[index]
                        for contact in self.contacts {
                            if contact.is_sensor() { continue }
                            let first_id = contact.first_body().body_id()
                            let second_id = contact.second_body().body_id()
                            var neighbor = -1
                            if first_id.slot == current { neighbor = second_id.slot }
                            if second_id.slot == current { neighbor = first_id.slot }
                            if neighbor >= 0 &&
                                !contains_contact_slot3d(members, neighbor)
                            {
                                if var connected = self.store.slots[neighbor] {
                                    if connected.body_type == BodyType3D.dynamic &&
                                        connected.is_enabled && connected.awake
                                    {
                                        members.append(neighbor)
                                    }
                                }
                            }
                        }
                        for constraint_slot in self.distance_constraints.slots {
                            if var constraint = constraint_slot {
                                if constraint.is_enabled {
                                    var neighbor = -1
                                    if constraint.first_id.slot == current {
                                        neighbor = constraint.second_id.slot
                                    }
                                    if constraint.second_id.slot == current {
                                        neighbor = constraint.first_id.slot
                                    }
                                    if neighbor >= 0 &&
                                        !contains_contact_slot3d(members, neighbor)
                                    {
                                        if var connected = self.store.slots[neighbor] {
                                            if connected.body_type == BodyType3D.dynamic &&
                                                connected.is_enabled && connected.awake
                                            {
                                                members.append(neighbor)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        for constraint_slot in self.point_constraints.slots {
                            if var constraint = constraint_slot {
                                if constraint.is_enabled {
                                    var neighbor = -1
                                    if constraint.first_id.slot == current {
                                        neighbor = constraint.second_id.slot
                                    }
                                    if constraint.second_id.slot == current {
                                        neighbor = constraint.first_id.slot
                                    }
                                    if neighbor >= 0 &&
                                        !contains_contact_slot3d(members, neighbor)
                                    {
                                        if var connected = self.store.slots[neighbor] {
                                            if connected.body_type == BodyType3D.dynamic &&
                                                connected.is_enabled && connected.awake
                                            {
                                                members.append(neighbor)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        index++
                    }
                    var ready = true
                    var gravity_free = true
                    var supported = false
                    for member in members {
                        handled.append(member)
                        if var connected = self.store.slots[member] {
                            if !connected.allow_sleep || connected.sleep_time < 0.5 {
                                ready = false
                            }
                            if self.current_gravity.multiply(
                                connected.gravity_scale
                            ).length_squared() > 0.0 {
                                gravity_free = false
                            }
                        }
                        for contact in self.contacts {
                            if contact.is_sensor() { continue }
                            let first_id = contact.first_body().body_id()
                            let second_id = contact.second_body().body_id()
                            var other = -1
                            if first_id.slot == member { other = second_id.slot }
                            if second_id.slot == member { other = first_id.slot }
                            if other >= 0 {
                                if var support = self.store.slots[other] {
                                    if support.body_type != BodyType3D.dynamic {
                                        supported = true
                                    }
                                }
                            }
                        }
                        for constraint_slot in self.distance_constraints.slots {
                            if var constraint = constraint_slot {
                                if constraint.is_enabled {
                                    var other = -1
                                    if constraint.first_id.slot == member {
                                        other = constraint.second_id.slot
                                    }
                                    if constraint.second_id.slot == member {
                                        other = constraint.first_id.slot
                                    }
                                    if other >= 0 {
                                        if var support = self.store.slots[other] {
                                            if support.is_enabled &&
                                                support.body_type != BodyType3D.dynamic
                                            {
                                                supported = true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        for constraint_slot in self.point_constraints.slots {
                            if var constraint = constraint_slot {
                                if constraint.is_enabled {
                                    var other = -1
                                    if constraint.first_id.slot == member {
                                        other = constraint.second_id.slot
                                    }
                                    if constraint.second_id.slot == member {
                                        other = constraint.first_id.slot
                                    }
                                    if other >= 0 {
                                        if var support = self.store.slots[other] {
                                            if support.is_enabled &&
                                                support.body_type != BodyType3D.dynamic
                                            {
                                                supported = true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if !supported && !gravity_free {
                        for member in members {
                            if var connected = self.store.slots[member] {
                                connected.sleep_time = 0.0
                            }
                        }
                    } else if ready {
                        for member in members {
                            if var connected = self.store.slots[member] {
                                connected.awake = false
                                connected.linear_velocity = Math.Vec3()
                                connected.angular_velocity = Math.Vec3()
                            }
                        }
                    }
                }
            }
            slot++
        }
    }
}

func same_contact_identity3d(first:Contact3D, second:Contact3D) bool {
    return first.first_body().same_body(second.first_body()) &&
        first.second_body().same_body(second.second_body()) &&
        first.first_child_id() == second.first_child_id() &&
        first.second_child_id() == second.second_child_id() &&
        first.is_sensor() == second.is_sensor()
}

func contains_contact_slot3d(slots:int[], selected:int) bool {
    for slot in slots { if slot == selected { return true } }
    return false
}

func warm_contact_points3d(
    first:BodyState3D,
    second:BodyState3D,
    normal:Math.Vec3,
    friction:float,
    constraints:ContactPointState3D[],
    previous:Contact3D
) {
    var old_points:ContactPoint3D[] = []
    previous.write_points(old_points)
    if old_points.count() != constraints.count() { return }
    var index = 0
    while index < constraints.count() {
        var constraint = constraints[index]
        let old = old_points[index]
        if old.position.distance(constraint.point) < 0.1 {
            constraint.normal_impulse = old.normal_impulse
            constraint.tangent_impulse = old.tangent_impulse
            let tangent_length = constraint.tangent_impulse.length()
            let maximum = friction * constraint.normal_impulse
            if tangent_length > maximum {
                constraint.tangent_impulse = constraint.tangent_impulse.normalized().multiply(
                    maximum
                )
            }
            let first_radius = constraint.point.subtract(first.world_center())
            let second_radius = constraint.point.subtract(second.world_center())
            apply_contact_impulse3d(
                first, second, first_radius, second_radius,
                normal.multiply(constraint.normal_impulse).add(
                    constraint.tangent_impulse
                )
            )
        }
        index++
    }
}

class ContactPairState3D {
    var first:BodyState3D
    var second:BodyState3D
    let first_id:BodyId3D
    let second_id:BodyId3D
    let normal:Math.Vec3
    let separation:float
    let point:Math.Vec3
    let friction:float
    let restitution:float
    var constraints:ContactPointState3D[]
    let active:bool
    let first_child_id:int
    let second_child_id:int
    let is_sensor:bool

    init(
        first:BodyState3D, second:BodyState3D,
        first_id:BodyId3D, second_id:BodyId3D,
        normal:Math.Vec3, separation:float, point:Math.Vec3,
        friction:float, restitution:float,
        constraints:ContactPointState3D[], active:bool,
        first_child_id:int, second_child_id:int, is_sensor:bool
    ) {
        self.first = first
        self.second = second
        self.first_id = first_id
        self.second_id = second_id
        self.normal = normal
        self.separation = separation
        self.point = point
        self.friction = friction
        self.restitution = restitution
        self.constraints = constraints
        self.active = active
        self.first_child_id = first_child_id
        self.second_child_id = second_child_id
        self.is_sensor = is_sensor
    }
}

func contact_placement3d(state:BodyState3D, child_id:int) ShapePlacement3D {
    match state.shape {
        compound(compound) => {
            var index = 0
            while index < compound.child_count() {
                let child = compound.child(index)
                if child.id == child_id {
                    return ShapePlacement3D(
                        child.shape,
                        compound_child_transform(state.transform, child)
                    )
                }
                index++
            }
            panic("GFX.Physics.World3D contact child id is missing")
        }
        sphere(_) => {}
        box(_) => {}
        capsule(_) => {}
    }
    return ShapePlacement3D(state.shape, state.transform)
}

func contact_points3d(
    first:ShapePlacement3D,
    second:ShapePlacement3D,
    normal:Math.Vec3,
    witness:Math.Vec3
) Math.Vec3[] {
    match first.shape() {
        box(first_box) => {
            match second.shape() {
                box(second_box) => {
                    return box_box_contact_points(
                        first_box, first.transform(), second_box, second.transform(),
                        normal, witness
                    )
                }
                sphere(_) => {}
                capsule(_) => {}
                compound(_) => {}
            }
        }
        sphere(_) => {}
        compound(_) => {}
        capsule(first_capsule) => {
            match second.shape() {
                capsule(second_capsule) => {
                    return capsule_capsule_contact_points(
                        first_capsule, first.transform(),
                        second_capsule, second.transform(),
                        normal, witness
                    )
                }
                sphere(_) => {}
                box(_) => {}
                compound(_) => {}
            }
        }
    }
    return [witness]
}

func contact_normal3d(
    first:ShapePlacement3D,
    second:ShapePlacement3D,
    geometric_normal:Math.Vec3
) Math.Vec3 {
    match first.shape() {
        sphere(_) => {
            match second.shape() {
                box(box) => {
                    if inside_box3d(first.transform().position, box, second.transform()) {
                        return geometric_normal.negated()
                    }
                }
                sphere(_) => {}
                capsule(_) => {}
                compound(_) => {}
            }
        }
        box(box) => {
            match second.shape() {
                sphere(_) => {
                    if inside_box3d(second.transform().position, box, first.transform()) {
                        return geometric_normal.negated()
                    }
                }
                capsule(_) => {
                    if inside_box3d(second.transform().position, box, first.transform()) {
                        return geometric_normal.negated()
                    }
                }
                box(_) => {}
                compound(_) => {}
            }
        }
        capsule(_) => {
            match second.shape() {
                box(box) => {
                    if inside_box3d(first.transform().position, box, second.transform()) {
                        return geometric_normal.negated()
                    }
                }
                sphere(_) => {}
                capsule(_) => {}
                compound(_) => {}
            }
        }
        compound(_) => {}
    }
    return geometric_normal
}

func inside_box3d(point:Math.Vec3, box:Box3D, transform:Transform3D) bool {
    let local_point = transform.inverse_point(point)
    let half = box.half_size()
    return Math.abs(local_point.x) <= half.x &&
        Math.abs(local_point.y) <= half.y &&
        Math.abs(local_point.z) <= half.z
}

class ContactPointState3D {
    var point:Math.Vec3
    var normal_impulse:float
    var tangent_impulse:Math.Vec3
    var bounce_speed:float

    init(
        point:Math.Vec3,
        first:BodyState3D,
        second:BodyState3D,
        normal:Math.Vec3,
        restitution:float
    ) {
        self.point = point
        self.normal_impulse = 0.0
        self.tangent_impulse = Math.Vec3()
        self.bounce_speed = 0.0
        let first_radius = point.subtract(first.world_center())
        let second_radius = point.subtract(second.world_center())
        let approach_speed = contact_relative_velocity3d(
            first, second, first_radius, second_radius
        ).dot(normal)
        if approach_speed < -1.0 {
            self.bounce_speed = -approach_speed * restitution
        }
    }
}

func contact_inverse_mass3d(
    first:BodyState3D,
    second:BodyState3D,
    first_radius:Math.Vec3,
    second_radius:Math.Vec3,
    axis:Math.Vec3
) float {
    let first_arm = first_radius.cross(axis)
    let second_arm = second_radius.cross(axis)
    return first.inverse_mass + second.inverse_mass +
        first.inverse_inertia_times(first_arm).cross(first_radius).dot(axis) +
        second.inverse_inertia_times(second_arm).cross(second_radius).dot(axis)
}

func apply_contact_impulse3d(
    first:BodyState3D,
    second:BodyState3D,
    first_radius:Math.Vec3,
    second_radius:Math.Vec3,
    impulse:Math.Vec3
) {
    first.linear_velocity = first.linear_velocity.subtract(
        impulse.multiply(first.inverse_mass)
    )
    second.linear_velocity = second.linear_velocity.add(
        impulse.multiply(second.inverse_mass)
    )
    first.angular_velocity = first.angular_velocity.subtract(
        first.inverse_inertia_times(first_radius.cross(impulse))
    )
    second.angular_velocity = second.angular_velocity.add(
        second.inverse_inertia_times(second_radius.cross(impulse))
    )
}

func contact_relative_velocity3d(
    first:BodyState3D,
    second:BodyState3D,
    first_radius:Math.Vec3,
    second_radius:Math.Vec3
) Math.Vec3 {
    let first_velocity = first.linear_velocity.add(
        first.angular_velocity.cross(first_radius)
    )
    let second_velocity = second.linear_velocity.add(
        second.angular_velocity.cross(second_radius)
    )
    return second_velocity.subtract(first_velocity)
}

func distance_axis3d(
    first:BodyState3D, second:BodyState3D,
    constraint:DistanceConstraintState3D
) Math.Vec3 {
    let separation = second.transform.point(constraint.second_local_anchor).subtract(
        first.transform.point(constraint.first_local_anchor)
    )
    if separation.length_squared() <= 0.000000000001 {
        return Math.Vec3(1.0, 0.0, 0.0)
    }
    return separation.normalized()
}

func distance_error3d(length:float, constraint:DistanceConstraintState3D) float {
    if length < constraint.minimum_length {
        return length - constraint.minimum_length
    }
    if length > constraint.maximum_length {
        return length - constraint.maximum_length
    }
    return 0.0
}

func solve_distance_velocity3d(
    first:BodyState3D, second:BodyState3D,
    constraint:DistanceConstraintState3D, delta:float
) {
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    let length = first_point.distance(second_point)
    let error = distance_error3d(length, constraint)
    if length > constraint.minimum_length &&
        length < constraint.maximum_length
    {
        return
    }
    let axis = distance_axis3d(first, second, constraint)
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = contact_inverse_mass3d(
        first, second, first_radius, second_radius, axis
    )
    if inverse_mass <= 0.0 { return }
    let speed = contact_relative_velocity3d(
        first, second, first_radius, second_radius
    ).dot(axis)
    var bias = Math.max(-10.0, Math.min(10.0, 0.2 * error / delta))
    var softness = 0.0
    if constraint.spring_hertz > 0.0 {
        let effective_mass = 1.0 / inverse_mass
        let omega = 2.0 * Math.pi() * constraint.spring_hertz
        let stiffness = effective_mass * omega * omega
        let damping = 2.0 * effective_mass * constraint.spring_damping_ratio * omega
        softness = 1.0 / (delta * (damping + delta * stiffness))
        bias = delta * stiffness * softness * error
    }
    let previous = constraint.axial_impulse
    var accumulated = previous - (speed + bias + softness * previous) /
        (inverse_mass + softness)
    if constraint.minimum_length != constraint.maximum_length {
        if length <= constraint.minimum_length {
            accumulated = Math.max(0.0, accumulated)
        } else {
            accumulated = Math.min(0.0, accumulated)
        }
    }
    constraint.axial_impulse = accumulated
    constraint.reaction_axis = axis
    constraint.inverse_delta = 1.0 / delta
    apply_contact_impulse3d(
        first, second, first_radius, second_radius,
        axis.multiply(accumulated - previous)
    )
}

func solve_distance_position3d(
    first:BodyState3D, second:BodyState3D,
    constraint:DistanceConstraintState3D
) {
    if constraint.spring_hertz > 0.0 { return }
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    let error = distance_error3d(first_point.distance(second_point), constraint)
    if Math.abs(error) < 0.00001 { return }
    let axis = distance_axis3d(first, second, constraint)
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = contact_inverse_mass3d(
        first, second, first_radius, second_radius, axis
    )
    if inverse_mass <= 0.0 { return }
    let impulse = axis.multiply(-Math.max(-0.2, Math.min(0.2, error)) /
        inverse_mass)
    shift_distance_body3d(first, impulse.negated(), first_radius)
    shift_distance_body3d(second, impulse, second_radius)
}

func shift_distance_body3d(
    state:BodyState3D, impulse:Math.Vec3, radius:Math.Vec3
) {
    if state.inverse_mass == 0.0 { return }
    let center = state.world_center().add(impulse.multiply(state.inverse_mass))
    let rotation_vector = state.inverse_inertia_times(radius.cross(impulse))
    var rotation = state.transform.rotation
    let angle = rotation_vector.length()
    if angle > 0.0 {
        rotation = Math.Quat.angle_axis(angle, rotation_vector.divide(angle))
            .multiply(rotation).normalized()
    }
    state.transform = Transform3D(
        center.subtract(rotation.rotate(state.mass_properties.local_center)), rotation
    )
}

func point_effective_column3d(
    first:BodyState3D, second:BodyState3D,
    first_radius:Math.Vec3, second_radius:Math.Vec3,
    axis:Math.Vec3
) Math.Vec3 {
    return axis.multiply(first.inverse_mass + second.inverse_mass).add(
        first.inverse_inertia_times(first_radius.cross(axis)).cross(first_radius)
    ).add(
        second.inverse_inertia_times(second_radius.cross(axis)).cross(second_radius)
    )
}

func point_inverse_mass3d(
    first:BodyState3D, second:BodyState3D,
    first_radius:Math.Vec3, second_radius:Math.Vec3
) Math.Mat3 {
    return Math.Mat3(
        point_effective_column3d(
            first, second, first_radius, second_radius, Math.Vec3(1.0, 0.0, 0.0)
        ),
        point_effective_column3d(
            first, second, first_radius, second_radius, Math.Vec3(0.0, 1.0, 0.0)
        ),
        point_effective_column3d(
            first, second, first_radius, second_radius, Math.Vec3(0.0, 0.0, 1.0)
        )
    )
}

func solve_point_velocity3d(
    first:BodyState3D, second:BodyState3D,
    constraint:PointConstraintState3D, delta:float
) {
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = point_inverse_mass3d(
        first, second, first_radius, second_radius
    )
    if Math.abs(inverse_mass.determinant()) <= Math.epsilon() { return }
    let speed = contact_relative_velocity3d(
        first, second, first_radius, second_radius
    )
    var bias = second_point.subtract(first_point).multiply(0.2 / delta)
    if bias.length_squared() > 100.0 { bias = bias.normalized().multiply(10.0) }
    let impulse = inverse_mass.inverted().multiply(speed.add(bias)).negated()
    constraint.impulse = constraint.impulse.add(impulse)
    constraint.inverse_delta = 1.0 / delta
    apply_contact_impulse3d(first, second, first_radius, second_radius, impulse)
}

func solve_point_position3d(
    first:BodyState3D, second:BodyState3D,
    constraint:PointConstraintState3D
) {
    let first_point = first.transform.point(constraint.first_local_anchor)
    let second_point = second.transform.point(constraint.second_local_anchor)
    var error = second_point.subtract(first_point)
    if error.length_squared() < 0.0000000001 { return }
    let first_radius = first_point.subtract(first.world_center())
    let second_radius = second_point.subtract(second.world_center())
    let inverse_mass = point_inverse_mass3d(
        first, second, first_radius, second_radius
    )
    if Math.abs(inverse_mass.determinant()) <= Math.epsilon() { return }
    if error.length_squared() > 0.04 {
        error = error.normalized().multiply(0.2)
    }
    let impulse = inverse_mass.inverted().multiply(error).negated()
    shift_distance_body3d(first, impulse.negated(), first_radius)
    shift_distance_body3d(second, impulse, second_radius)
}

func solve_contact_point3d(
    first:BodyState3D,
    second:BodyState3D,
    normal:Math.Vec3,
    friction:float,
    constraint:ContactPointState3D,
    apply_friction:bool = true
) {
    let first_radius = constraint.point.subtract(first.world_center())
    let second_radius = constraint.point.subtract(second.world_center())
    let approach_speed = contact_relative_velocity3d(
        first, second, first_radius, second_radius
    ).dot(normal)
    let inverse_effective_mass = contact_inverse_mass3d(
        first, second, first_radius, second_radius, normal
    )
    if inverse_effective_mass <= 0.0 { return }
    let previous_normal = constraint.normal_impulse
    constraint.normal_impulse = Math.max(
        0.0,
        previous_normal +
            (constraint.bounce_speed - approach_speed) / inverse_effective_mass
    )
    let normal_delta = constraint.normal_impulse - previous_normal
    if normal_delta != 0.0 {
        apply_contact_impulse3d(
            first, second, first_radius, second_radius,
            normal.multiply(normal_delta)
        )
    }
    if apply_friction && friction > 0.0 {
        let after_normal = contact_relative_velocity3d(
            first, second, first_radius, second_radius
        )
        let sliding = after_normal.subtract(normal.multiply(after_normal.dot(normal)))
        let sliding_speed = sliding.length()
        let previous_tangent = constraint.tangent_impulse
        var new_tangent = previous_tangent
        if sliding_speed > 0.000001 {
            let tangent = sliding.divide(sliding_speed)
            let tangent_inverse_mass = contact_inverse_mass3d(
                first, second, first_radius, second_radius, tangent
            )
            if tangent_inverse_mass > 0.0 {
                new_tangent = previous_tangent.subtract(
                    tangent.multiply(sliding_speed / tangent_inverse_mass)
                )
            }
        }
        let maximum = friction * constraint.normal_impulse
        if new_tangent.length() > maximum {
            new_tangent = new_tangent.normalized().multiply(maximum)
        }
        constraint.tangent_impulse = new_tangent
        let tangent_delta = new_tangent.subtract(previous_tangent)
        if tangent_delta.length() > 0.0 {
            apply_contact_impulse3d(
                first, second, first_radius, second_radius, tangent_delta
            )
        }
    }
}

func correct_contact3d(
    first:BodyState3D,
    second:BodyState3D,
    normal:Math.Vec3,
    separation:float
) {
    if separation >= 0.0 { return }
    let total_inverse_mass = first.inverse_mass + second.inverse_mass
    if total_inverse_mass <= 0.0 { return }
    let correction = normal.multiply(-separation / total_inverse_mass)
    first.transform = Transform3D(
        first.transform.position.subtract(correction.multiply(first.inverse_mass)),
        first.transform.rotation
    )
    second.transform = Transform3D(
        second.transform.position.add(correction.multiply(second.inverse_mass)),
        second.transform.rotation
    )
}

func integrate_kinematic3d(state:BodyState3D, delta:float) {
    if let target = state.target {
        if delta >= state.target_remaining {
            state.transform = target
            state.linear_velocity = Math.Vec3()
            state.angular_velocity = Math.Vec3()
            state.target = null
            state.target_remaining = 0.0
            return
        }
        state.target_remaining -= delta
    }
    advance_pose3d(state, delta)
}

func integrate_dynamic3d(
    state:BodyState3D,
    gravity:Math.Vec3,
    delta:float
) {
    let acceleration = gravity.multiply(state.gravity_scale).add(
        state.force.multiply(state.inverse_mass)
    )
    state.linear_velocity = state.linear_velocity.add(acceleration.multiply(delta))
    let angular_momentum = state.inertia_times(state.angular_velocity)
    let effective_torque = state.torque.subtract(
        state.angular_velocity.cross(angular_momentum)
    )
    state.angular_velocity = state.angular_velocity.add(
        state.inverse_inertia_times(effective_torque).multiply(delta)
    )
    state.linear_velocity = state.linear_velocity.divide(1.0 + state.linear_damping * delta)
    state.angular_velocity = state.angular_velocity.divide(1.0 + state.angular_damping * delta)
    advance_pose3d(state, delta)
}

func advance_pose3d(state:BodyState3D, delta:float) {
    let center = state.world_center().add(state.linear_velocity.multiply(delta))
    var next_rotation = state.transform.rotation
    let angular_speed = state.angular_velocity.length()
    if angular_speed > 0.0 {
        let turn = Math.Quat.angle_axis(
            angular_speed * delta,
            state.angular_velocity.divide(angular_speed)
        )
        next_rotation = turn.multiply(next_rotation).normalized()
    }
    state.transform = Transform3D(
        center.subtract(next_rotation.rotate(state.mass_properties.local_center)),
        next_rotation
    )
}

func continuous_fraction3d(
    moving_shape:Shape3D,
    moving_start:Transform3D,
    moving_end:Transform3D,
    target_shape:Shape3D,
    target_start:Transform3D,
    target_end:Transform3D
) float? {
    let moving_translation = moving_end.position.subtract(moving_start.position)
    let target_translation = target_end.position.subtract(target_start.position)
    let relative_speed = moving_translation.subtract(target_translation).length()
    if relative_speed <= 0.000001 { return null }
    let initial = Geometry3D.distance(
        ShapePlacement3D(moving_shape, moving_start),
        ShapePlacement3D(target_shape, target_start)
    )
    if initial.separation <= 0.000001 { return null }
    var fraction = 0.0
    var iteration = 0
    while iteration < 32 && fraction <= 1.0 {
        let moving_pose = Transform3D(
            moving_start.position.add(moving_translation.multiply(fraction)),
            moving_start.rotation
        )
        let target_pose = Transform3D(
            target_start.position.add(target_translation.multiply(fraction)),
            target_start.rotation
        )
        let separation = Geometry3D.distance(
            ShapePlacement3D(moving_shape, moving_pose),
            ShapePlacement3D(target_shape, target_pose)
        ).separation
        if separation <= 0.000001 { return fraction }
        fraction += separation / relative_speed
        iteration++
    }
    return null
}
