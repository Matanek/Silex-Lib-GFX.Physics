    func destroy_joint(joint:DistanceJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }
    func destroy_joint(joint:FilterJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }
    func destroy_joint(joint:MotorJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }
    func destroy_joint(joint:MouseJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }
    func destroy_joint(joint:PrismaticJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }
    func destroy_joint(joint:RevoluteJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }
    func destroy_joint(joint:WeldJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }
    func destroy_joint(joint:WheelJoint2D) {
        self.destroy_joint_id(joint.belongs_to(self.joints), joint.joint_id())
    }

    func destroy_rigid_body(body:RigidBody2D) {
        self.store.require_mutable()
        if !body.belongs_to(self.store) {
            panic("GFX.Physics.World2D cannot destroy a body owned by another world")
        }
        let id = body.body_id()
        let index = self.store.require(id)
        self.joints.destroy_attached(id)
        self.swap_remove_world_body(index)
        self.store.destroy(id)
        self.rebuild_after_body_destruction()
    }

    private func require_joint_body(body:RigidBody2D) int {
        self.store.require_mutable()
        if !body.belongs_to(self.store) {
            panic("GFX.Physics.World2D cannot join a body owned by another world")
        }
        return self.store.require(body.body_id())
    }

    private func require_distinct_joint_bodies(
        first:RigidBody2D,
        second:RigidBody2D
    ) {
        if first.body_id().slot == second.body_id().slot {
            panic("GFX.Physics joint bodies must be distinct")
        }
    }

    private func finish_joint_creation(
        first:int,
        second:int,
        joint:JointConstraint2D
    ) {
        self.store.wake(first)
        if second != first { self.store.wake(second) }
        if !joint.collide_connected {
            self.invalidate_candidate_between(first, second)
        }
    }

    private func destroy_joint_id(owned:bool, id:JointId2D) {
        self.store.require_mutable()
        if !owned {
            panic("GFX.Physics.World2D cannot destroy a joint owned by another world")
        }
        let first_id = self.joints.first_body(id)
        let second_id = self.joints.second_body(id)
        var first = -1
        var second = -1
        if self.store.contains(first_id) { first = self.store.require(first_id) }
        if self.store.contains(second_id) { second = self.store.require(second_id) }
        self.joints.destroy(id)
        if first >= 0 && self.store.enabled[first] {
            self.broad_phase.touch_proxy(self.proxies[first])
        }
        if second >= 0 && second != first && self.store.enabled[second] {
            self.broad_phase.touch_proxy(self.proxies[second])
        }
    }

    private func invalidate_candidate_between(first:int, second:int) {
        if first == second { return }
        var pair = BodyPair2D(first, second)
        if first > second { pair = BodyPair2D(second, first) }
        var index = 0
        while index < self.candidate_bodies.count() {
            if self.candidate_enabled[index] {
                let current = self.candidate_bodies[index]
                if current.first == pair.first && current.second == pair.second {
                    self.candidate_pair_keys.remove(current)
                    self.candidate_enabled[index] = false
                    if self.free_candidate_count ==
                        self.free_candidate_slots.count()
                    {
                        self.free_candidate_slots.append(index)
                    } else {
                        self.free_candidate_slots[self.free_candidate_count] = index
                    }
                    self.free_candidate_count++
                    return
                }
            }
            index++
        }
    }

    func step(delta:float, substeps:int = 4) {
        if !finite_world_value(delta) || delta < 0.0 {
            panic("GFX.Physics.World2D.step requires a finite non-negative delta")
        }
        if substeps < 1 {
            panic("GFX.Physics.World2D.step requires a positive substep count")
        }
        self.store.require_mutable()
        if self.store.topology_dirty {
            self.rebuild_after_body_destruction()
        }
        self.begin_step_events()
        self.store.world_locked = true
        var profile_clock = Clock()
        if self.profiling_enabled { profile_clock.tick() }
        for kinematic in self.non_dynamic_bodies {
            if self.store.body_types[kinematic] == BodyType2D.kinematic {
                begin_soft_step_motion(self.store, kinematic)
                integrate_body_position(self.store, kinematic, delta)
            }
        }
        self.dynamic_grid_active = self.maximum_dynamic_shape_radius > 0.0
        self.joints.propagate_wake()
        self.rebuild_active_bodies()
        var index = 0
        while index < self.store.count() {
            self.stable_for_sleep[index] = true
            self.severe_for_sleep[index] = false
            if !self.store.enabled[index] {
                index++
                continue
            }
            self.contact_wake_cooldowns[index] = Math.max(
                0.0,
                self.contact_wake_cooldowns[index] - delta
            )
            var previous_x = self.store.positions_x[index]
            var previous_y = self.store.positions_y[index]
            if self.store.body_types[index] == BodyType2D.dynamic &&
                self.store.awake[index]
            {
                previous_x = self.store.previous_positions_x[index]
                previous_y = self.store.previous_positions_y[index]
            } else if !self.store.dirty_transforms[index] {
                index++
                continue
            }
            let bounds = body_bounds(self.store, index)
            self.tight_bounds[index] = bounds
            if !self.dynamic_grid_active {
                self.broad_phase.move_proxy(
                    self.proxies[index],
                    bounds,
                    Math.Vec2(
                        self.store.positions_x[index] - previous_x,
                        self.store.positions_y[index] - previous_y
                    )
                )
            }
            self.store.dirty_transforms[index] = false
            index++
        }
        if self.current_continuous_collision_enabled &&
            self.dynamic_grid_active &&
            self.maximum_dynamic_circle_radius > 0.0
        {
            self.clip_fast_circles_against_sleeping_pile()
        }
        if self.profiling_enabled {
            self.current_step_profile.motion_ms = profile_clock.tick() * 1000.0
        }
        if self.dynamic_grid_active {
            self.current_moved_proxy_count = 0
            self.collect_dynamic_grid_pairs()
        } else {
            self.current_moved_proxy_count = self.broad_phase.moved_proxy_count()
            if var executor = self.parallel_executor {
                collect_pairs_parallel(
                    self.broad_phase,
                    self.discovered_pairs,
                    executor
                )
            } else {
                self.broad_phase.collect_pairs(self.discovered_pairs)
            }
        }
        self.current_discovered_pair_count = self.discovered_pairs.count()
        if self.profiling_enabled {
            self.current_pair_collection_ms = profile_clock.tick() * 1000.0
        }
        self.update_candidate_pairs(self.discovered_pairs)
        if self.profiling_enabled {
            self.current_pair_maintenance_ms = profile_clock.tick() * 1000.0
        }
        self.refresh_general_contacts()
        self.wake_direct_impacts()
        self.update_active_pairs()
        self.collect_discrete_hit_events()
        self.current_candidate_pair_count = self.active_pairs.count()
        if self.profiling_enabled {
            self.current_pair_filter_ms = profile_clock.tick() * 1000.0
            self.current_step_profile.broad_phase_ms =
                self.current_pair_collection_ms +
                self.current_pair_maintenance_ms +
                self.current_pair_filter_ms
        }
        self.solve_collisions(self.active_pairs, delta, substeps)
        if self.current_continuous_collision_enabled {
            self.solve_continuous_motion()
        }
        if self.profiling_enabled {
            self.current_step_profile.solve_ms = profile_clock.tick() * 1000.0
        }
        self.update_sleep(delta)
        self.collect_contact_events()
        self.collect_sensor_events()
        self.collect_body_move_events()
        if self.profiling_enabled {
            self.current_step_profile.sleep_ms = profile_clock.tick() * 1000.0
            self.current_step_profile.total_ms =
                self.current_step_profile.motion_ms +
                self.current_step_profile.broad_phase_ms +
                self.current_step_profile.solve_ms +
                self.current_step_profile.sleep_ms
        }
        self.store.clear_forces()
        self.store.world_locked = false
    }

    private func begin_step_events() {
        self.body_move_events.clear()
        self.contact_begin_events.clear()
        self.contact_end_events.clear()
        self.contact_hit_events.clear()
        self.sensor_begin_events.clear()
        self.sensor_end_events.clear()
        self.previous_touching_pairs.clear()
        self.current_ccd_body_count = 0
        self.current_ccd_pair_test_count = 0

        if self.hit_event_body_count > 0 { self.hit_pair_keys.clear() }
        if self.contact_event_body_count > 0 {
            self.previous_touching_keys.clear()
            self.current_touching_keys.clear()
            var candidate = 0
            while candidate < self.candidate_pairs.count() {
                if self.candidate_enabled[candidate] &&
                    self.candidate_pairs[candidate].contact_count > 0
                {
                    let pair = self.candidate_bodies[candidate]
                    if pair_contact_events_enabled(self.store, pair) {
                        self.previous_touching_pairs.append(pair)
                        self.previous_touching_keys.add(pair)
                    }
                }
                candidate++
            }
        }

        self.step_start_awake.clear()
        if self.move_event_body_count > 0 {
            var body = 0
            while body < self.store.count() {
                self.step_start_awake.append(self.store.awake[body])
                body++
            }
        }
    }

    private func collect_discrete_hit_events() {
        if self.hit_event_body_count == 0 { return }
        for candidate in self.active_pairs {
            let pair = self.candidate_bodies[candidate]
            if pair_is_sensor(self.store, pair) ||
                !pair_hit_events_enabled(self.store, pair)
            {
                continue
            }
            let manifold = contact_manifold(
                self.store,
                pair.first,
                pair.second
            )
            if manifold.point_count() == 0 { continue }
            let point = manifold.points[0].point
            let relative = velocity_at(self.store, pair.second, point)
                .subtract(velocity_at(self.store, pair.first, point))
            let approach_speed = -relative.dot(manifold.normal)
            if approach_speed >= self.current_hit_event_threshold {
                self.append_contact_hit_event(
                    pair,
                    point,
                    manifold.normal,
                    approach_speed
                )
            }
        }
    }

    private func solve_continuous_motion() {
        var mover = 0
        while mover < self.store.count() {
            if !self.store.enabled[mover] ||
                self.store.body_types[mover] != BodyType2D.dynamic ||
                !self.store.awake[mover]
            {
                mover++
                continue
            }
            let is_bullet = (self.store.behavior_flags[mover] & 1) != 0
            let motion = body_position(self.store, mover).subtract(Math.Vec2(
                self.store.previous_positions_x[mover],
                self.store.previous_positions_y[mover]
            ))
            let angular_motion = self.store.rotations[mover] -
                self.store.previous_rotations[mover]
            let sweep_radius = Math.sqrt(
                self.store.sweep_radii_squared[mover]
            )
            let surface_motion = motion.length() +
                Math.abs(angular_motion) * sweep_radius
            let minimum_extent = body_minimum_continuous_extent(
                self.store,
                mover
            )
            // Box2D can rely on speculative contacts up to half the minimum
            // extent. This solver has no speculative contact row yet, so start
            // the sweep at the quarter-extent allowance used for chain CCD.
            var requires_sweep = surface_motion > 0.25 * minimum_extent
            if !requires_sweep {
                for possible_target in self.non_dynamic_bodies {
                    if self.store.enabled[possible_target] &&
                        self.store.body_types[possible_target] ==
                            BodyType2D.kinematic &&
                        continuous_pair_requires_sweep(
                            self.store,
                            mover,
                            possible_target
                        )
                    {
                        requires_sweep = true
                        break
                    }
                }
            }
            if !requires_sweep {
                mover++
                continue
            }
            self.current_ccd_body_count++
            var earliest = ContinuousHit2D()
            var earliest_target = -1
            var target = 0
            while target < self.store.count() {
                if target == mover || !self.store.enabled[target] {
                    target++
                    continue
                }
                if self.store.body_types[target] == BodyType2D.dynamic {
                    if !is_bullet {
                        target++
                        continue
                    }
                    if (self.store.behavior_flags[target] & 1) != 0 &&
                        target < mover
                    {
                        target++
                        continue
                    }
                }
                if !continuous_pair_requires_sweep(
                    self.store,
                    mover,
                    target
                ) {
                    target++
                    continue
                }
                let pair = ordered_body_pair(mover, target)
                if !self.store.collision_filters[pair.first].allows(
                    self.store.collision_filters[pair.second]
                ) || !self.joints.collision_allowed(
                    self.store.body_id_at(pair.first),
                    self.store.body_id_at(pair.second)
                ) {
                    target++
                    continue
                }
                self.current_ccd_pair_test_count++
                let hit = continuous_pair_hit(self.store, mover, target)
                if !hit.hit {
                    target++
                    continue
                }
                if pair_is_sensor(self.store, pair) {
                    let finishes_overlapping = Geometry2D.overlaps(
                        body_placement(self.store, pair.first),
                        body_placement(self.store, pair.second)
                    )
                    if !self.sensor_pair_keys.contains(pair) &&
                        !finishes_overlapping
                    {
                        self.append_sensor_begin_events(pair)
                        self.append_sensor_end_events(pair)
                    }
                } else if !earliest.hit || hit.fraction < earliest.fraction {
                    earliest = hit
                    earliest_target = target
                }
                target++
            }
            if earliest_target >= 0 {
                self.apply_continuous_hit(mover, earliest_target, earliest)
            }
            mover++
        }
    }

    private func apply_continuous_hit(
        mover:int,
        target:int,
        hit:ContinuousHit2D
    ) {
        let start = Math.Vec2(
            self.store.previous_positions_x[mover],
            self.store.previous_positions_y[mover]
        )
        let finish = body_position(self.store, mover)
        let motion = finish.subtract(start)
        let start_rotation = self.store.previous_rotations[mover]
        let rotation_motion = self.store.rotations[mover] - start_rotation
        let fraction = Math.min(1.0, hit.fraction + 0.00001)
        self.store.positions_x[mover] = start.x + motion.x * fraction
        self.store.positions_y[mover] = start.y + motion.y * fraction
        self.store.rotations[mover] = start_rotation + rotation_motion * fraction
        self.store.cache_rotation(mover)
        let approach = -velocity_at(self.store, mover, hit.point)
            .subtract(velocity_at(self.store, target, hit.point))
            .dot(hit.normal)
        let mover_radius = hit.point.subtract(
            self.store.world_center_at(mover)
        )
        if self.store.body_types[target] == BodyType2D.dynamic &&
            !self.store.awake[target]
        {
            self.store.wake(target)
        }
        let target_radius = hit.point.subtract(
            self.store.world_center_at(target)
        )
        let mover_arm = cross(mover_radius, hit.normal)
        let target_arm = cross(target_radius, hit.normal)
        let denominator = self.store.inverse_masses[mover] +
            self.store.inverse_masses[target] +
            mover_arm * mover_arm * self.store.inverse_inertias[mover] +
            target_arm * target_arm * self.store.inverse_inertias[target]
        let normal_velocity = velocity_at(self.store, mover, hit.point)
            .subtract(velocity_at(self.store, target, hit.point))
            .dot(hit.normal)
        if normal_velocity < 0.0 && denominator > 0.0 {
            var restitution = 0.0
            if normal_velocity < -self.current_restitution_threshold {
                restitution = Math.max(
                    self.store.restitutions[mover],
                    self.store.restitutions[target]
                )
            }
            let magnitude = -(1.0 + restitution) * normal_velocity /
                denominator
            let impulse = hit.normal.multiply(magnitude)
            self.store.velocities_x[mover] +=
                impulse.x * self.store.inverse_masses[mover]
            self.store.velocities_y[mover] +=
                impulse.y * self.store.inverse_masses[mover]
            self.store.angular_velocities[mover] +=
                cross(mover_radius, impulse) *
                self.store.inverse_inertias[mover]
            self.store.velocities_x[target] -=
                impulse.x * self.store.inverse_masses[target]
            self.store.velocities_y[target] -=
                impulse.y * self.store.inverse_masses[target]
            self.store.angular_velocities[target] -=
                cross(target_radius, impulse) *
                self.store.inverse_inertias[target]
        }
        self.store.dirty_transforms[mover] = true
        self.tight_bounds[mover] = body_bounds(self.store, mover)

        let pair = ordered_body_pair(mover, target)
        self.insert_candidate_pair(pair)
        self.refresh_event_contact(pair)
        if approach >= self.current_hit_event_threshold &&
            pair_hit_events_enabled(self.store, pair)
        {
            var normal = hit.normal
            if pair.first == mover { normal = normal.negated() }
            self.append_contact_hit_event(
                pair,
                hit.point,
                normal,
                approach
            )
        }
    }

    private func refresh_event_contact(expected:BodyPair2D) {
        var index = 0
        while index < self.candidate_pairs.count() {
            if !self.candidate_enabled[index] ||
                self.candidate_bodies[index].first != expected.first ||
                self.candidate_bodies[index].second != expected.second
            {
                index++
                continue
            }
            let pair = self.candidate_bodies[index]
            let manifold = contact_manifold(
                self.store,
                pair.first,
                pair.second
            )
            if manifold.point_count() == 0 {
                self.candidate_pairs[index].contact_count = 0
                return
            }
            self.candidate_pairs[index].normal = manifold.normal
            self.candidate_pairs[index].first_contact =
                body_contact_cache_point(
                    self.store,
                    pair.first,
                    manifold.points[0].point
                )
            self.candidate_pairs[index].second_contact =
                self.candidate_pairs[index].first_contact
            if manifold.point_count() > 1 {
                self.candidate_pairs[index].second_contact =
                    body_contact_cache_point(
                        self.store,
                        pair.first,
                        manifold.points[1].point
                    )
            }
            self.candidate_pairs[index].contact_count = manifold.point_count()
            return
        }
    }

    private func collect_contact_events() {
        if self.contact_event_body_count == 0 { return }
        self.current_touching_keys.clear()
        var index = 0
        while index < self.candidate_pairs.count() {
            if !self.candidate_enabled[index] ||
                self.candidate_pairs[index].contact_count <= 0
            {
                index++
                continue
            }
            let pair = self.candidate_bodies[index]
            if !pair_contact_events_enabled(self.store, pair) {
                index++
                continue
            }
            self.current_touching_keys.add(pair)
            if !self.previous_touching_keys.contains(pair) {
                self.append_contact_begin_event(pair)
            }
            index++
        }
        for pair in self.previous_touching_pairs {
            if !self.current_touching_keys.contains(pair) {
                self.append_contact_end_event(pair)
            }
        }
    }

    private func collect_sensor_events() {
        self.current_sensor_pairs.clear()
        self.current_sensor_pair_keys.clear()
        if self.sensor_event_body_count == 0 {
            self.sensor_pairs.clear()
            self.sensor_pair_keys.clear()
            return
        }
        var sensor = 0
        while sensor < self.store.count() {
            if !self.store.enabled[sensor] ||
                (self.store.behavior_flags[sensor] & 2) == 0 ||
                (self.store.behavior_flags[sensor] & 32) == 0
            {
                sensor++
                continue
            }
            var other = 0
            while other < self.store.count() {
                if other == sensor || !self.store.enabled[other] {
                    other++
                    continue
                }
                let pair = ordered_body_pair(sensor, other)
                if self.current_sensor_pair_keys.contains(pair) {
                    other++
                    continue
                }
                if self.joints.collision_allowed(
                    self.store.body_id_at(pair.first),
                    self.store.body_id_at(pair.second)
                ) && sensor_pair_overlaps(self.store, sensor, other) {
                    self.current_sensor_pairs.append(pair)
                    self.current_sensor_pair_keys.add(pair)
                    if !self.sensor_pair_keys.contains(pair) {
                        self.append_sensor_begin_events(pair)
                    }
                }
                other++
            }
            sensor++
        }
        for pair in self.sensor_pairs {
            if !self.current_sensor_pair_keys.contains(pair) {
                self.append_sensor_end_events(pair)
            }
        }
        self.sensor_pairs.clear()
        self.sensor_pair_keys.clear()
        for pair in self.current_sensor_pairs {
            self.sensor_pairs.append(pair)
            self.sensor_pair_keys.add(pair)
        }
    }

    private func collect_body_move_events() {
        if self.move_event_body_count == 0 { return }
        var body = 0
        while body < self.store.count() {
            if !self.store.enabled[body] ||
                self.store.body_types[body] == BodyType2D.fixed
            {
                body++
                continue
            }
            if (self.store.behavior_flags[body] & 4) == 0 {
                body++
                continue
            }
            let moved = Math.abs(
                self.store.positions_x[body] -
                    self.store.previous_positions_x[body]
            ) > 0.000000001 || Math.abs(
                self.store.positions_y[body] -
                    self.store.previous_positions_y[body]
            ) > 0.000000001 || Math.abs(
                self.store.rotations[body] - self.store.previous_rotations[body]
            ) > 0.000000001
            let fell_asleep = self.step_start_awake[body] &&
                !self.store.awake[body]
            if moved || fell_asleep {
                self.body_move_events.append(BodyMoveEvent2D(
                    self.store,
                    self.store.body_id_at(body),
                    Transform2D(
                        position:body_position(self.store, body),
                        rotation:self.store.rotations[body]
                    ),
                    fell_asleep
                ))
            }
            body++
        }
    }

    private func append_contact_begin_event(pair:BodyPair2D) {
        let stable = stable_body_pair(self.store, pair)
        let manifold = contact_manifold(
            self.store,
            stable.first,
            stable.second
        )
        self.contact_begin_events.append(ContactBeginEvent2D(
            self.store,
            self.store.body_id_at(stable.first),
            self.store.body_id_at(stable.second),
            manifold
        ))
    }

    private func append_contact_end_event(pair:BodyPair2D) {
        let stable = stable_body_pair(self.store, pair)
        self.contact_end_events.append(ContactEndEvent2D(
            self.store,
            self.store.body_id_at(stable.first),
            self.store.body_id_at(stable.second)
        ))
    }

    private func append_contact_hit_event(
        pair:BodyPair2D,
        point:Math.Vec2,
        normal:Math.Vec2,
        approach_speed:float
    ) {
        if self.hit_pair_keys.contains(pair) { return }
        self.hit_pair_keys.add(pair)
        let stable = stable_body_pair(self.store, pair)
        var stable_normal = normal
        if stable.first != pair.first { stable_normal = normal.negated() }
        self.contact_hit_events.append(ContactHitEvent2D(
            self.store,
            self.store.body_id_at(stable.first),
            self.store.body_id_at(stable.second),
            point,
            stable_normal,
            approach_speed
        ))
    }

    private func append_sensor_begin_events(pair:BodyPair2D) {
        if (self.store.behavior_flags[pair.first] & 2) != 0 &&
            (self.store.behavior_flags[pair.first] & 32) != 0
        {
            self.sensor_begin_events.append(SensorBeginEvent2D(
                self.store,
                self.store.body_id_at(pair.first),
                self.store.body_id_at(pair.second)
            ))
        }
        if (self.store.behavior_flags[pair.second] & 2) != 0 &&
            (self.store.behavior_flags[pair.second] & 32) != 0
        {
            self.sensor_begin_events.append(SensorBeginEvent2D(
                self.store,
                self.store.body_id_at(pair.second),
                self.store.body_id_at(pair.first)
            ))
        }
    }

    private func append_sensor_end_events(pair:BodyPair2D) {
        if (self.store.behavior_flags[pair.first] & 2) != 0 &&
            (self.store.behavior_flags[pair.first] & 32) != 0
        {
            self.sensor_end_events.append(SensorEndEvent2D(
                self.store,
                self.store.body_id_at(pair.first),
                self.store.body_id_at(pair.second)
            ))
        }
        if (self.store.behavior_flags[pair.second] & 2) != 0 &&
            (self.store.behavior_flags[pair.second] & 32) != 0
        {
            self.sensor_end_events.append(SensorEndEvent2D(
                self.store,
                self.store.body_id_at(pair.second),
                self.store.body_id_at(pair.first)
            ))
        }
    }

    private func swap_remove_world_body(index:int) {
        let last = self.store.count() - 1
        if index != last {
            self.proxies.swap(index, last)
            self.tight_bounds.swap(index, last)
            self.circle_grid_next.swap(index, last)
            self.circle_grid_cell_x.swap(index, last)
            self.circle_grid_cell_y.swap(index, last)
            self.direct_wake_pending.swap(index, last)
            self.contact_wake_cooldowns.swap(index, last)
            self.support_grace.swap(index, last)
            self.load_grace.swap(index, last)
            self.stable_for_sleep.swap(index, last)
            self.severe_for_sleep.swap(index, last)
            self.sleep_parents.swap(index, last)
            self.sleep_eligible.swap(index, last)
            self.sleep_motion_squared.swap(index, last)
            self.island_body_counts.swap(index, last)
            self.island_ready_counts.swap(index, last)
            self.island_can_sleep.swap(index, last)
            self.island_write_offsets.swap(index, last)
        }
        self.proxies.take_last()
        self.tight_bounds.take_last()
        self.circle_grid_next.take_last()
        self.circle_grid_cell_x.take_last()
        self.circle_grid_cell_y.take_last()
        self.direct_wake_pending.take_last()
        self.contact_wake_cooldowns.take_last()
        self.support_grace.take_last()
        self.load_grace.take_last()
        self.stable_for_sleep.take_last()
        self.severe_for_sleep.take_last()
        self.sleep_parents.take_last()
        self.sleep_eligible.take_last()
        self.sleep_motion_squared.take_last()
        self.island_body_counts.take_last()
        self.island_ready_counts.take_last()
        self.island_can_sleep.take_last()
        self.island_write_offsets.take_last()
    }

    private func rebuild_after_body_destruction() {
        self.broad_phase = BroadPhase2D()
        self.non_dynamic_bodies.clear()
        self.circle_grid_heads.clear()
        self.circle_grid_stamps.clear()
        self.circle_grid_generation = 0
        self.maximum_dynamic_shape_radius = 0.0
        self.maximum_dynamic_circle_radius = 0.0
        self.dynamic_grid_active = false
        self.dynamic_grid_eligible = true
        self.sleep_enabled_body_count = 0
        self.bullet_body_count = 0
        self.move_event_body_count = 0
        self.contact_event_body_count = 0
        self.hit_event_body_count = 0
        self.sensor_event_body_count = 0

        var index = 0
        while index < self.store.count() {
            let bounds = body_bounds(self.store, index)
            self.tight_bounds[index] = bounds
            self.proxies[index] = -1
            self.circle_grid_next[index] = -1
            self.circle_grid_cell_x[index] = 0
            self.circle_grid_cell_y[index] = 0
            self.direct_wake_pending[index] = false
            self.sleep_parents[index] = index
            self.store.dirty_transforms[index] = false
            if !self.store.enabled[index] {
                index++
                continue
            }
            self.proxies[index] = self.broad_phase.create_proxy(bounds, index)
            if (self.store.behavior_flags[index] & 1) != 0 {
                self.bullet_body_count++
            }
            if (self.store.behavior_flags[index] & 4) != 0 {
                self.move_event_body_count++
            }
            if (self.store.behavior_flags[index] & 8) != 0 {
                self.contact_event_body_count++
            }
            if (self.store.behavior_flags[index] & 16) != 0 {
                self.hit_event_body_count++
            }
            if (self.store.behavior_flags[index] & 2) != 0 &&
                (self.store.behavior_flags[index] & 32) != 0
            {
                self.sensor_event_body_count++
            }
            if self.store.body_types[index] != BodyType2D.dynamic {
                self.non_dynamic_bodies.append(index)
            } else {
                if self.store.shape_counts[index] != 1 ||
                    self.store.shape_kinds[index] != 1 ||
                    Math.abs(self.store.local_centers_x[index]) > 0.000000001 ||
                    Math.abs(self.store.local_centers_y[index]) > 0.000000001
                {
                    self.dynamic_grid_eligible = false
                }
                let shape_radius = body_maximum_sweep_radius(
                    self.store,
                    index
                )
                self.maximum_dynamic_shape_radius = Math.max(
                    self.maximum_dynamic_shape_radius,
                    shape_radius
                )
                if self.store.shape_counts[index] == 1 &&
                    self.store.shape_kinds[index] == 1
                {
                    self.maximum_dynamic_circle_radius = Math.max(
                        self.maximum_dynamic_circle_radius,
                        self.store.radii[index]
                    )
                }
                if self.store.allow_sleep[index] {
                    self.sleep_enabled_body_count++
                }
            }
            index++
        }

        self.discovered_pairs.clear()
        self.new_candidate_pairs.clear()
        self.candidate_bodies.clear()
        self.candidate_enabled.clear()
        self.candidate_pairs.clear()
        self.candidate_pair_keys = PairSet2D()
        self.free_candidate_slots.clear()
        self.free_candidate_count = 0
        self.active_pairs.clear()
        var constraints = self.soft_constraints
        constraints.collisions.clear()
        constraints.compact_collisions.clear()
        constraints.compact_impulses.clear()
        constraints.entries.clear()
        self.direct_wake_bodies.clear()
        self.active_bodies.clear()
        self.active_island_roots.clear()
        self.active_island_offsets.clear()
        self.active_island_bodies.clear()
        self.current_candidate_pair_count = 0
        self.current_moved_proxy_count = self.broad_phase.moved_proxy_count()
        self.current_discovered_pair_count = 0
        self.sensor_pairs.clear()
        self.sensor_pair_keys.clear()
        self.current_sensor_pairs.clear()
        self.current_sensor_pair_keys.clear()
        self.store.topology_dirty = false
    }

    private func update_sleep(delta:float) {
        if !self.current_sleep_enabled { return }
        if self.sleep_enabled_body_count == 0 { return }
        let sleep_delay = 0.5
        let sleep_quorum_numerator = 19
        let sleep_quorum_denominator = 20
        var index = 0
        while index < self.store.count() {
            self.support_grace[index] = Math.max(
                0.0,
                self.support_grace[index] - delta
            )
            self.load_grace[index] = Math.max(
                0.0,
                self.load_grace[index] - delta
            )
            self.sleep_parents[index] = index
            self.sleep_eligible[index] = false
            self.sleep_motion_squared[index] = 0.0
            self.island_body_counts[index] = 0
            self.island_ready_counts[index] = 0
            self.island_can_sleep[index] = true
            index++
        }
        var collision_index = 0
        while collision_index < self.soft_constraints.collisions.count() {
            let collision = self.soft_constraints.collisions[collision_index]
            let first = collision.first_body
            let second = collision.second_body
            let offset = body_position(self.store, second).subtract(
                body_position(self.store, first)
            )
            let penetration = overlap_on_axis(
                self.store,
                first,
                second,
                offset,
                collision.normal
            )
            if penetration > 0.001 {
                self.stable_for_sleep[first] = false
                self.stable_for_sleep[second] = false
            }
            if penetration > 0.01 {
                self.severe_for_sleep[first] = true
                self.severe_for_sleep[second] = true
            }
            let height_delta = self.store.positions_y[second] -
                self.store.positions_y[first]
            if height_delta > 0.05 {
                self.load_grace[first] = 0.25
                self.support_grace[second] = 0.25
            } else if height_delta < -0.05 {
                self.load_grace[second] = 0.25
                self.support_grace[first] = 0.25
            }
            collision_index++
        }
        collision_index = 0
        while collision_index < self.soft_constraints.compact_collisions.count() {
            let collision = self.soft_constraints.compact_collisions[collision_index]
            let first = collision.first_body
            let second = collision.second_body
            let height_delta = self.store.positions_y[second] -
                self.store.positions_y[first]
            if height_delta > 0.05 {
                self.load_grace[first] = 0.25
                self.support_grace[second] = 0.25
            } else if height_delta < -0.05 {
                self.load_grace[second] = 0.25
                self.support_grace[first] = 0.25
            }
            collision_index++
        }
        var joint_index = 0
        while joint_index < self.joints.joints.count() {
            let joint = self.joints.joints[joint_index]
            if joint.kind != JointKind2D.filter &&
                joint.first_body.slot != joint.second_body.slot
            {
                let first = self.store.require(joint.first_body)
                let second = self.store.require(joint.second_body)
                if self.store.body_types[first] == BodyType2D.dynamic &&
                    self.store.body_types[second] == BodyType2D.dynamic &&
                    self.store.enabled[first] && self.store.enabled[second] &&
                    self.store.awake[first] && self.store.awake[second] &&
                    self.store.allow_sleep[first] &&
                    self.store.allow_sleep[second]
                {
                    self.union_sleep_bodies(first, second)
                }
            }
            joint_index++
        }
        var candidate_index = 0
        while candidate_index < self.candidate_pairs.count() {
            if !self.candidate_enabled[candidate_index] ||
                self.candidate_pairs[candidate_index].contact_count == 0
            {
                candidate_index++
                continue
            }
            let pair = self.candidate_bodies[candidate_index]
            if primitive_contact_pair(self.store, pair) {
                candidate_index++
                continue
            }
            let first = pair.first
            let second = pair.second
            let height_delta = self.store.positions_y[second] -
                self.store.positions_y[first]
            if height_delta > 0.05 {
                self.load_grace[first] = 0.25
                self.support_grace[second] = 0.25
            } else if height_delta < -0.05 {
                self.load_grace[second] = 0.25
                self.support_grace[first] = 0.25
            }
            if self.store.body_types[first] == BodyType2D.dynamic &&
                self.store.body_types[second] == BodyType2D.dynamic &&
                self.store.enabled[first] && self.store.enabled[second] &&
                self.store.awake[first] && self.store.awake[second] &&
                self.store.allow_sleep[first] && self.store.allow_sleep[second]
            {
                self.union_sleep_bodies(first, second)
            }
            candidate_index++
        }
        index = 0
        while index < self.store.count() {
            if self.store.enabled[index] &&
                self.store.body_types[index] == BodyType2D.dynamic
            {
                if !self.store.allow_sleep[index] {
                    self.store.sleep_times[index] = 0.0
                    self.store.awake[index] = true
                } else if self.store.awake[index] {
                    let linear_speed_squared =
                        self.store.velocities_x[index] *
                            self.store.velocities_x[index] +
                        self.store.velocities_y[index] *
                            self.store.velocities_y[index]
                    let sweep_radius_squared =
                        self.store.sweep_radii_squared[index]
                    let angular_speed = self.store.angular_velocities[index]
                    let surface_motion_squared = linear_speed_squared +
                        angular_speed * angular_speed * sweep_radius_squared
                    let rest_threshold = self.store.sleep_thresholds[index]
                    let rest_motion_threshold_squared =
                        rest_threshold * rest_threshold
                    let significant_threshold = rest_threshold * 2.0
                    let significant_motion_threshold_squared =
                        significant_threshold * significant_threshold
                    self.sleep_motion_squared[index] = surface_motion_squared
                    if surface_motion_squared > significant_motion_threshold_squared {
                        self.store.sleep_times[index] = 0.0
                    } else if surface_motion_squared > rest_motion_threshold_squared {
                        self.store.sleep_times[index] = Math.max(
                            0.0,
                            self.store.sleep_times[index] - delta * 0.25
                        )
                    } else {
                        self.store.sleep_times[index] += delta
                        self.sleep_eligible[index] = true
                    }
                }
            }
            index++
        }
        if self.dynamic_grid_active && self.dynamic_grid_eligible &&
            self.maximum_dynamic_circle_radius > 0.0
        {
            var requires_sleep_audit = false
            index = 0
            while index < self.store.count() {
                if self.store.body_types[index] == BodyType2D.dynamic &&
                    self.store.enabled[index] &&
                    self.store.awake[index] &&
                    self.sleep_eligible[index] &&
                    self.store.sleep_times[index] >= sleep_delay
                {
                    requires_sleep_audit = true
                    break
                }
                index++
            }
            if requires_sleep_audit {
                self.audit_circle_sleep_stability()
            }
        }
        index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic &&
                self.store.enabled[index] &&
                self.store.awake[index]
            {
                let significant_threshold =
                    self.store.sleep_thresholds[index] * 2.0
                let significant_motion_threshold_squared =
                    significant_threshold * significant_threshold
                let root = self.find_sleep_root(index)
                self.island_body_counts[root]++
                if self.sleep_eligible[index] &&
                    self.store.sleep_times[index] >= sleep_delay
                {
                    self.island_ready_counts[root]++
                }
                if !self.store.allow_sleep[index] ||
                    self.severe_for_sleep[index] ||
                    self.sleep_motion_squared[index] >
                        significant_motion_threshold_squared
                {
                    self.island_can_sleep[root] = false
                }
            }
            index++
        }
        self.build_active_island_layout()
        var island = 0
        while island < self.active_island_roots.count() {
            let root = self.active_island_roots[island]
            if self.island_can_sleep[root] &&
                self.island_ready_counts[root] * sleep_quorum_denominator >=
                    self.island_body_counts[root] * sleep_quorum_numerator
            {
                var body_offset = self.active_island_offsets[island]
                let body_end = self.active_island_offsets[island + 1]
                while body_offset < body_end {
                    let body = self.active_island_bodies[body_offset]
                    self.store.velocities_x[body] = 0.0
                    self.store.velocities_y[body] = 0.0
                    self.store.angular_velocities[body] = 0.0
                    self.store.awake[body] = false
                    body_offset++
                }
            }
            island++
        }
    }

    private func rebuild_active_bodies() {
        self.active_bodies.clear()
        var slot = 0
        while slot < self.store.slot_dense_indices.count() {
            let body = self.store.slot_dense_indices[slot]
            if body >= 0 &&
                self.store.enabled[body] &&
                self.store.body_types[body] == BodyType2D.dynamic &&
                self.store.awake[body]
            {
                self.active_bodies.append(body)
            }
            slot++
        }
    }

    private func build_active_island_layout() {
        self.active_island_roots.clear()
        self.active_island_offsets.clear()
        self.active_island_bodies.clear()
        self.active_island_offsets.append(0)
        var slot = 0
        while slot < self.store.slot_dense_indices.count() {
            let body = self.store.slot_dense_indices[slot]
            if body >= 0 &&
                self.store.enabled[body] &&
                self.store.body_types[body] == BodyType2D.dynamic &&
                self.store.awake[body]
            {
                let root = self.find_sleep_root(body)
                if root == body && self.island_body_counts[root] > 0 {
                    self.active_island_roots.append(root)
                    self.active_island_offsets.append(
                        self.active_island_offsets[
                            self.active_island_offsets.count() - 1
                        ] + self.island_body_counts[root]
                    )
                }
            }
            slot++
        }
        var body_offset = 0
        while body_offset < self.active_island_offsets[
            self.active_island_offsets.count() - 1
        ] {
            self.active_island_bodies.append(0)
            body_offset++
        }
        var island = 0
        while island < self.active_island_roots.count() {
            self.island_write_offsets[self.active_island_roots[island]] =
                self.active_island_offsets[island]
            island++
        }
        slot = 0
        while slot < self.store.slot_dense_indices.count() {
            let body = self.store.slot_dense_indices[slot]
            if body >= 0 &&
                self.store.enabled[body] &&
                self.store.body_types[body] == BodyType2D.dynamic &&
                self.store.awake[body]
            {
                let root = self.find_sleep_root(body)
                let destination = self.island_write_offsets[root]
                self.active_island_bodies[destination] = body
                self.island_write_offsets[root]++
            }
            slot++
        }
    }

    private func audit_circle_sleep_stability() {
        var body = 0
        while body < self.store.count() {
            self.tight_bounds[body] = body_bounds(self.store, body)
            body++
        }
        self.collect_dynamic_grid_pairs()
        for pair in self.discovered_pairs {
            if self.store.shape_kinds[pair.first] != 1 ||
                self.store.shape_kinds[pair.second] != 1
            {
                continue
            }
            let combined_radius = self.store.radii[pair.first] +
                self.store.radii[pair.second]
            // Soft Step intentionally permits a small compliant overlap. The
            // 12 mm bound is the accepted circle-corpus gate and matches the
            // pinned Box2D 3.1.1 oracle instead of the former projection
            // solver's tighter but algorithm-specific 5 mm residue.
            let minimum_distance = combined_radius - 0.012
            let severe_distance = combined_radius - 0.012
            let offset_x = self.store.positions_x[pair.second] -
                self.store.positions_x[pair.first]
            let offset_y = self.store.positions_y[pair.second] -
                self.store.positions_y[pair.first]
            if offset_x * offset_x + offset_y * offset_y <
                minimum_distance * minimum_distance
            {
                self.stable_for_sleep[pair.first] = false
                self.stable_for_sleep[pair.second] = false
            }
            if offset_x * offset_x + offset_y * offset_y <
                severe_distance * severe_distance
            {
                self.severe_for_sleep[pair.first] = true
                self.severe_for_sleep[pair.second] = true
            }
        }
    }

    private func find_sleep_root(body:int) int {
        var root = body
        while self.sleep_parents[root] != root {
            root = self.sleep_parents[root]
        }
        var current = body
        while self.sleep_parents[current] != current {
            let parent = self.sleep_parents[current]
            self.sleep_parents[current] = root
            current = parent
        }
        return root
    }

    private func union_sleep_bodies(first:int, second:int) {
        var first_root = self.find_sleep_root(first)
        var second_root = self.find_sleep_root(second)
        if first_root == second_root { return }
        if self.store.dense_slots[first_root] >
            self.store.dense_slots[second_root]
        {
            let swapped = first_root
            first_root = second_root
            second_root = swapped
        }
        self.sleep_parents[second_root] = first_root
    }

    private func update_candidate_pairs(discovered:@BodyPair2D[]) {
        var profile_clock = Clock()
        if self.profiling_enabled { profile_clock.tick() }
        var index = self.candidate_pairs.count() - 1
        while index >= 0 {
            if !self.candidate_enabled[index] {
                index--
                continue
            }
            let pair = self.candidate_bodies[index]
            var overlaps = self.broad_phase.proxies_overlap(
                self.proxies[pair.first],
                self.proxies[pair.second]
            )
            if self.dynamic_grid_active {
                overlaps = self.tight_bounds[pair.first].overlaps(
                    self.tight_bounds[pair.second]
                )
            }
            if overlaps && !self.joints.collision_allowed(
                self.store.body_id_at(pair.first),
                self.store.body_id_at(pair.second)
            ) {
                overlaps = false
            }
            if !overlaps {
                self.candidate_pair_keys.remove(pair)
                self.candidate_enabled[index] = false
                if self.free_candidate_count ==
                    self.free_candidate_slots.count()
                {
                    self.free_candidate_slots.append(index)
                } else {
                    self.free_candidate_slots[self.free_candidate_count] = index
                }
                self.free_candidate_count++
            }
            index--
        }
        if self.profiling_enabled {
            self.current_pair_removal_ms = profile_clock.tick() * 1000.0
        }
        self.new_candidate_pairs.clear()
        for pair in discovered {
            if !self.candidate_pair_keys.contains(pair) {
                self.new_candidate_pairs.append(pair)
            }
        }
        if self.profiling_enabled {
            self.current_pair_discovery_ms = profile_clock.tick() * 1000.0
        }
        if self.profiling_enabled {
            self.current_pair_sort_ms = profile_clock.tick() * 1000.0
        }
        for pair in self.new_candidate_pairs { self.insert_candidate_pair(pair) }
        if self.profiling_enabled {
            self.current_pair_insertion_ms = profile_clock.tick() * 1000.0
        }
    }

    private func collect_dynamic_grid_pairs() {
        self.discovered_pairs.clear()
        self.ensure_circle_grid_capacity()
        self.circle_grid_generation++
        let generation = self.circle_grid_generation
        let cell_size = self.maximum_dynamic_shape_radius * 2.0 + 0.02
        let inverse_cell_size = 1.0 / cell_size
        var body = 0
        while body < self.store.count() {
            if !self.store.enabled[body] ||
                self.store.body_types[body] != BodyType2D.dynamic
            {
                body++
                continue
            }
            let cell_x = Math.floor(
                self.store.positions_x[body] * inverse_cell_size
            ) as int
            let cell_y = Math.floor(
                self.store.positions_y[body] * inverse_cell_size
            ) as int
            let bucket = circle_grid_bucket(
                cell_x,
                cell_y,
                self.circle_grid_heads.count()
            )
            if self.circle_grid_stamps[bucket] != generation {
                self.circle_grid_stamps[bucket] = generation
                self.circle_grid_heads[bucket] = -1
            }
            self.circle_grid_cell_x[body] = cell_x
            self.circle_grid_cell_y[body] = cell_y
            self.circle_grid_next[body] = self.circle_grid_heads[bucket]
            self.circle_grid_heads[bucket] = body
            body++
        }

        body = 0
        while body < self.store.count() {
            if !self.store.enabled[body] ||
                self.store.body_types[body] != BodyType2D.dynamic
            {
                body++
                continue
            }
            let cell_x = self.circle_grid_cell_x[body]
            let cell_y = self.circle_grid_cell_y[body]
            var offset_y = -1
            while offset_y <= 0 {
                var offset_x = -1
                var maximum_offset_x = 1
                if offset_y == 0 { maximum_offset_x = 0 }
                while offset_x <= maximum_offset_x {
                    let expected_x = cell_x + offset_x
                    let expected_y = cell_y + offset_y
                    let bucket = circle_grid_bucket(
                        expected_x,
                        expected_y,
                        self.circle_grid_heads.count()
                    )
                    if self.circle_grid_stamps[bucket] == generation {
                        var other = self.circle_grid_heads[bucket]
                        while other >= 0 {
                            if self.circle_grid_cell_x[other] == expected_x &&
                                self.circle_grid_cell_y[other] == expected_y &&
                                (offset_x != 0 || offset_y != 0 || other < body) &&
                                (self.tight_bounds[other].overlaps(
                                    self.tight_bounds[body]
                                ) || speculative_circle_pair(
                                    self.store,
                                    other,
                                    body
                                ))
                            {
                                var first = other
                                var second = body
                                if first > second {
                                    first = body
                                    second = other
                                }
                                self.discovered_pairs.append(
                                    BodyPair2D(first, second)
                                )
                            }
                            other = self.circle_grid_next[other]
                        }
                    }
                    offset_x++
                }
                offset_y++
            }
            for fixed_body in self.non_dynamic_bodies {
                if self.tight_bounds[fixed_body].overlaps(
                    self.tight_bounds[body]
                ) {
                    var first = fixed_body
                    var second = body
                    if first > second {
                        first = body
                        second = fixed_body
                    }
                    self.discovered_pairs.append(BodyPair2D(first, second))
                }
            }
            body++
        }
    }

    private func clip_fast_circles_against_sleeping_pile() {
        // A 5 cm-radius ball falling at 10 m/s travels farther than its
        // diameter during one 60 Hz step. Build a grid containing only rigid
        // sleeping supports, then retain the earliest swept circle contact for
        // each fast awake circle before ordinary discrete contact generation.
        self.ensure_circle_grid_capacity()
        self.circle_grid_generation++
        let generation = self.circle_grid_generation
        let cell_size = self.maximum_dynamic_circle_radius * 2.0
        let inverse_cell_size = 1.0 / cell_size
        var body = 0
        while body < self.store.count() {
            if !self.store.enabled[body] ||
                self.store.body_types[body] != BodyType2D.dynamic ||
                self.store.shape_kinds[body] != 1 ||
                self.store.awake[body] ||
                (self.store.behavior_flags[body] & 2) != 0
            {
                body++
                continue
            }
            let cell_x = Math.floor(
                self.store.positions_x[body] * inverse_cell_size
            ) as int
            let cell_y = Math.floor(
                self.store.positions_y[body] * inverse_cell_size
            ) as int
            let bucket = circle_grid_bucket(
                cell_x,
                cell_y,
                self.circle_grid_heads.count()
            )
            if self.circle_grid_stamps[bucket] != generation {
                self.circle_grid_stamps[bucket] = generation
                self.circle_grid_heads[bucket] = -1
            }
            self.circle_grid_cell_x[body] = cell_x
            self.circle_grid_cell_y[body] = cell_y
            self.circle_grid_next[body] = self.circle_grid_heads[bucket]
            self.circle_grid_heads[bucket] = body
            body++
        }

        body = 0
        while body < self.store.count() {
            if !self.store.enabled[body] ||
                self.store.body_types[body] != BodyType2D.dynamic ||
                self.store.shape_kinds[body] != 1 ||
                !self.store.awake[body] ||
                (self.store.behavior_flags[body] & 2) != 0
            {
                body++
                continue
            }
            let start_x = self.store.previous_positions_x[body]
            let start_y = self.store.previous_positions_y[body]
            let motion_x = self.store.positions_x[body] - start_x
            let motion_y = self.store.positions_y[body] - start_y
            let motion_squared = motion_x * motion_x + motion_y * motion_y
            let radius = self.store.radii[body]
            if motion_squared <= radius * radius * 0.25 {
                body++
                continue
            }

            let sweep_radius = radius + self.maximum_dynamic_circle_radius
            let minimum_x = Math.floor(
                (Math.min(start_x, self.store.positions_x[body]) -
                    sweep_radius) * inverse_cell_size
            ) as int
            let maximum_x = Math.floor(
                (Math.max(start_x, self.store.positions_x[body]) +
                    sweep_radius) * inverse_cell_size
            ) as int
            let minimum_y = Math.floor(
                (Math.min(start_y, self.store.positions_y[body]) -
                    sweep_radius) * inverse_cell_size
            ) as int
            let maximum_y = Math.floor(
                (Math.max(start_y, self.store.positions_y[body]) +
                    sweep_radius) * inverse_cell_size
            ) as int
            var earliest = 2.0
            var target = -1
            var cell_y = minimum_y
            while cell_y <= maximum_y {
                var cell_x = minimum_x
                while cell_x <= maximum_x {
                    let bucket = circle_grid_bucket(
                        cell_x,
                        cell_y,
                        self.circle_grid_heads.count()
                    )
                    if self.circle_grid_stamps[bucket] == generation {
                        var other = self.circle_grid_heads[bucket]
                        while other >= 0 {
                            if self.circle_grid_cell_x[other] == cell_x &&
                                self.circle_grid_cell_y[other] == cell_y
                            {
                                let combined_radius = radius +
                                    self.store.radii[other]
                                let relative_x = start_x -
                                    self.store.positions_x[other]
                                let relative_y = start_y -
                                    self.store.positions_y[other]
                                let c = relative_x * relative_x +
                                    relative_y * relative_y -
                                    combined_radius * combined_radius
                                if c > 0.0 {
                                    let b = 2.0 * (
                                        relative_x * motion_x +
                                        relative_y * motion_y
                                    )
                                    let discriminant = b * b -
                                        4.0 * motion_squared * c
                                    if discriminant >= 0.0 {
                                        let time = (-b -
                                            Math.sqrt(discriminant)) /
                                            (2.0 * motion_squared)
                                        if time >= 0.0 && time <= 1.0 &&
                                            time < earliest
                                        {
                                            earliest = time
                                            target = other
                                        }
                                    }
                                }
                            }
                            other = self.circle_grid_next[other]
                        }
                    }
                    cell_x++
                }
                cell_y++
            }
            if target >= 0 {
                let travel = Math.sqrt(motion_squared)
                let contact_time = Math.min(
                    1.0,
                    earliest + 0.0001 / travel
                )
                self.store.positions_x[body] = start_x +
                    motion_x * contact_time
                self.store.positions_y[body] = start_y +
                    motion_y * contact_time
                self.tight_bounds[body] = body_bounds(self.store, body)
                self.store.dirty_transforms[body] = true
            }
            body++
        }
    }

    private func ensure_circle_grid_capacity() {
        let required = Math.max(8, self.store.count() * 2)
        if self.circle_grid_heads.count() >= required { return }
        var capacity = 8
        while capacity < required { capacity *= 2 }
        self.circle_grid_heads.clear()
        self.circle_grid_stamps.clear()
        var index = 0
        while index < capacity {
            self.circle_grid_heads.append(-1)
            self.circle_grid_stamps.append(0)
            index++
        }
        self.circle_grid_generation = 0
    }

    private func wake_direct_impacts() {
        // Wake decisions use one immutable awake-state snapshot. Applying a
        // wake immediately while walking candidate pairs made the result
        // depend on pair order and allowed a surface impact to propagate down
        // a sleeping pile before its supporting contacts were solved.
        for body in self.direct_wake_bodies {
            self.direct_wake_pending[body] = false
        }
        self.direct_wake_bodies.clear()

        var candidate_index = 0
        while candidate_index < self.candidate_pairs.count() {
            if !self.candidate_enabled[candidate_index] {
                candidate_index++
                continue
            }
            let pair = self.candidate_bodies[candidate_index]
            if !primitive_contact_pair(self.store, pair) {
                self.collect_general_direct_wake(candidate_index, pair)
                candidate_index++
                continue
            }
            if self.store.awake[pair.first] == self.store.awake[pair.second]
            {
                candidate_index++
                continue
            }
            var sleeping = pair.first
            if self.store.awake[pair.first] { sleeping = pair.second }
            var awake_body = pair.second
            if self.store.awake[pair.first] { awake_body = pair.first }
            if self.store.body_types[sleeping] != BodyType2D.dynamic ||
                self.contact_wake_cooldowns[awake_body] > 0.0 ||
                !self.tight_bounds[pair.first].overlaps(
                    self.tight_bounds[pair.second]
                )
            {
                candidate_index++
                continue
            }

            var cache = ContactPair2D()
            if let collision = build_collision(
                self.store,
                pair.first,
                pair.second,
                candidate_index,
                cache,
                false
            ) {
                let offset = body_position(self.store, pair.second).subtract(
                    body_position(self.store, pair.first)
                )
                let penetration = overlap_on_axis(
                    self.store,
                    pair.first,
                    pair.second,
                    offset,
                    collision.normal
                )
                let relative_velocity = velocity_at(
                    self.store,
                    pair.second,
                    collision.contacts.first
                ).subtract(velocity_at(
                    self.store,
                    pair.first,
                    collision.contacts.first
                ))
                if (relative_velocity.dot(collision.normal) < -0.35 ||
                        penetration > 0.01) &&
                    !self.direct_wake_pending[sleeping]
                {
                    self.direct_wake_pending[sleeping] = true
                    self.direct_wake_bodies.append(sleeping)
                }
            }
            candidate_index++
        }

        for body in self.direct_wake_bodies {
            self.store.wake(body)
            // A body awakened by contact must first resolve against the
            // sleeping support that was added to this step. Until that short
            // interval expires it cannot recursively wake the next layer.
            self.contact_wake_cooldowns[body] = 0.5
        }
    }

    private func collect_general_direct_wake(
        candidate_index:int,
        pair:BodyPair2D
    ) {
        if self.candidate_pairs[candidate_index].contact_count == 0 ||
            self.store.awake[pair.first] == self.store.awake[pair.second]
        {
            return
        }
        var sleeping = pair.first
        if self.store.awake[pair.first] { sleeping = pair.second }
        var awake_body = pair.second
        if self.store.awake[pair.first] { awake_body = pair.first }
        if self.store.body_types[sleeping] != BodyType2D.dynamic ||
            self.contact_wake_cooldowns[awake_body] > 0.0
        {
            return
        }
        let manifold = contact_manifold(
            self.store,
            pair.first,
            pair.second
        )
        if manifold.point_count() == 0 { return }
        var penetration = 0.0
        for point in manifold.points {
            penetration = Math.max(penetration, -point.separation)
        }
        let point = manifold.points[0].point
        let relative_velocity = velocity_at(
            self.store,
            pair.second,
            point
        ).subtract(velocity_at(
            self.store,
            pair.first,
            point
        ))
        if (relative_velocity.dot(manifold.normal) < -0.35 ||
                penetration > 0.01) &&
            !self.direct_wake_pending[sleeping]
        {
            self.direct_wake_pending[sleeping] = true
            self.direct_wake_bodies.append(sleeping)
        }
    }

    private func update_active_pairs() {
        self.active_pairs.clear()
        var index = 0
        while index < self.candidate_pairs.count() {
            if !self.candidate_enabled[index] {
                index++
                continue
            }
            let pair = self.candidate_bodies[index]
            if !self.store.awake[pair.first] && !self.store.awake[pair.second]
            {
                index++
                continue
            }
            if self.tight_bounds[pair.first].overlaps(
                self.tight_bounds[pair.second]
            ) || speculative_circle_pair(
                self.store,
                pair.first,
                pair.second
            ) {
                self.active_pairs.append(index)
            }
            index++
        }
    }

    private func insert_candidate_pair(pair:BodyPair2D) {
        if self.candidate_pair_keys.contains(pair) { return }
        if self.store.inverse_masses[pair.first] +
            self.store.inverse_masses[pair.second] <= 0.0
        {
            return
        }
        if !body_pair_has_solid_collider_pair(self.store, pair) {
            return
        }
        if !self.joints.collision_allowed(
            self.store.body_id_at(pair.first),
            self.store.body_id_at(pair.second)
        ) {
            return
        }
        self.candidate_pair_keys.add(pair)
        if self.free_candidate_count > 0 {
            self.free_candidate_count--
            let slot = self.free_candidate_slots[self.free_candidate_count]
            self.candidate_bodies[slot] = pair
            self.candidate_enabled[slot] = true
            self.candidate_pairs[slot] = ContactPair2D()
        } else {
            self.candidate_bodies.append(pair)
            self.candidate_enabled.append(true)
            self.candidate_pairs.append(ContactPair2D())
        }
    }

    private func refresh_general_contacts() {
        var index = 0
        while index < self.candidate_pairs.count() {
            if !self.candidate_enabled[index] {
                index++
                continue
            }
            let pair = self.candidate_bodies[index]
            if primitive_contact_pair(self.store, pair) {
                index++
                continue
            }
            let manifold = contact_manifold(
                self.store,
                pair.first,
                pair.second
            )
            if manifold.point_count() == 0 {
                self.candidate_pairs[index] = ContactPair2D()
                index++
                continue
            }
            let previous = self.candidate_pairs[index]
            var current = ContactPair2D()
            current.normal = manifold.normal
            current.first_contact =
                body_contact_cache_point(
                    self.store,
                    pair.first,
                    manifold.points[0].point
                )
            current.second_contact = current.first_contact
            if manifold.point_count() > 1 {
                current.second_contact =
                    body_contact_cache_point(
                        self.store,
                        pair.first,
                        manifold.points[1].point
                    )
            }
            current.contact_count = manifold.point_count()
            current.first_awake =
                self.store.awake[pair.first]
            current.second_awake =
                self.store.awake[pair.second]
            if previous.contact_count == manifold.point_count() &&
                previous.normal.dot(manifold.normal) > 0.98
            {
                // Retain the current cache slot and its contact identity. The
                // solver impulses remain zero until the Soft Step milestone.
                current.normal_impulse_first =
                    previous.normal_impulse_first
                current.normal_impulse_second =
                    previous.normal_impulse_second
                current.tangent_impulse_first =
                    previous.tangent_impulse_first
                current.tangent_impulse_second =
                    previous.tangent_impulse_second
                current.rolling_impulse = previous.rolling_impulse
            }
            self.candidate_pairs[index] = current
            index++
        }
    }

    private func build_constraint_colors() {
        var constraints = self.soft_constraints
        self.constraint_body_color_masks.clear()
        var body = 0
        while body < self.store.count() {
            self.constraint_body_color_masks.append(0 as uint32)
            body++
        }
        self.constraint_color_counts.clear()
        self.constraint_color_offsets.clear()
        self.constraint_color_cursors.clear()
        var color = 0
        while color < 12 {
            self.constraint_color_counts.append(0)
            self.constraint_color_offsets.append(0)
            self.constraint_color_cursors.append(0)
            color++
        }
        self.constraint_color_offsets.append(0)
        self.constraint_entry_colors.clear()

        var source = 0
        while source < constraints.entries.count() {
            let entry = constraints.entries[source]
            var first = 0
            var second = 0
            if entry >= 0 {
                first = constraints.compact_collisions[entry].first_body
                second = constraints.compact_collisions[entry].second_body
            } else {
                first = constraints.collisions[-entry - 1].first_body
                second = constraints.collisions[-entry - 1].second_body
            }
            var first_mask:uint32 = 0
            var second_mask:uint32 = 0
            if solver_inverse_mass(self.store, first) > 0.0 {
                first_mask = self.constraint_body_color_masks[first]
            }
            if solver_inverse_mass(self.store, second) > 0.0 {
                second_mask = self.constraint_body_color_masks[second]
            }
            color = 0
            var bit:uint32 = 1
            while color < 11 &&
                ((first_mask & bit) != 0 || (second_mask & bit) != 0)
            {
                color++
                bit = bit * 2
            }
            if color >= 11 { color = 11 }
            self.constraint_entry_colors.append(color)
            self.constraint_color_counts[color]++
            if color < 11 {
                if solver_inverse_mass(self.store, first) > 0.0 {
                    self.constraint_body_color_masks[first] =
                        self.constraint_body_color_masks[first] + bit
                }
                if solver_inverse_mass(self.store, second) > 0.0 {
                    self.constraint_body_color_masks[second] =
                        self.constraint_body_color_masks[second] + bit
                }
            }
            source++
        }

        var offset = 0
        color = 0
        while color < 12 {
            self.constraint_color_offsets[color] = offset
            self.constraint_color_cursors[color] = offset
            offset += self.constraint_color_counts[color]
            color++
        }
        self.constraint_color_offsets[12] = offset
        constraints.colored_entries.clear()
        source = 0
        while source < constraints.entries.count() {
            constraints.colored_entries.append(0)
            source++
        }
        source = 0
        while source < constraints.entries.count() {
            color = self.constraint_entry_colors[source]
            let target = self.constraint_color_cursors[color]
            constraints.colored_entries[target] = constraints.entries[source]
            self.constraint_color_cursors[color]++
            source++
        }
        self.joints.build_colors(self.constraint_body_color_masks)
    }

    private func execute_begin_soft_step_bodies() {
        let count = self.active_bodies.count()
        var job = BeginSoftStepBodies2D(
            store:self.store,
            active_bodies:self.active_bodies
        )
        if self.parallel_enabled &&
            count >= soft_step_body_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func execute_integrate_soft_step_velocities(
        delta:float
    ) {
        let count = self.active_bodies.count()
        var job = IntegrateSoftStepVelocities2D(
            store:self.store,
            active_bodies:self.active_bodies,
            gravity:self.current_gravity,
            delta:delta,
            maximum_linear_speed:self.current_maximum_linear_speed
        )
        if self.parallel_enabled &&
            count >= soft_step_body_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func execute_integrate_soft_step_positions(delta:float) {
        let count = self.active_bodies.count()
        var job = IntegrateSoftStepPositions2D(
            store:self.store,
            active_bodies:self.active_bodies,
            delta:delta
        )
        if self.parallel_enabled &&
            count >= soft_step_body_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func execute_warm_start_color(color:int) {
        let offset = self.constraint_color_offsets[color]
        let count = self.constraint_color_counts[color]
        if count == 0 { return }
        var job = WarmStartSoftConstraints2D(
            store:self.store,
            state:self.soft_constraints,
            offset:offset,
            count:count,
            reverse:false
        )
        if self.parallel_enabled && color < 11 &&
            count >= soft_step_constraint_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func execute_warm_start_joint_color(color:int) {
        let count = self.joints.color_count(color)
        if count == 0 { return }
        var job = WarmStartJoints2D(
            bodies:self.store,
            joints:self.joints,
            offset:self.joints.color_offset(color),
            count:count,
            reverse:false
        )
        if self.parallel_enabled && color < 11 &&
            count >= soft_step_constraint_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func execute_solve_color(
        color:int,
        contact_softness:ContactSoftness2D,
        static_softness:ContactSoftness2D,
        inverse_delta:float,
        use_bias:bool,
        solve_friction:bool,
        reverse:bool
    ) {
        let offset = self.constraint_color_offsets[color]
        let count = self.constraint_color_counts[color]
        if count == 0 { return }
        var job = SolveSoftConstraints2D(
            store:self.store,
            state:self.soft_constraints,
            offset:offset,
            count:count,
            reverse:reverse,
            contact_softness:contact_softness,
            static_softness:static_softness,
            inverse_delta:inverse_delta,
            use_bias:use_bias,
            solve_friction:solve_friction
        )
        if self.parallel_enabled && color < 11 &&
            count >= soft_step_constraint_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func execute_solve_joint_color(
        color:int,
        inverse_delta:float,
        use_bias:bool,
        reverse:bool
    ) {
        let count = self.joints.color_count(color)
        if count == 0 { return }
        var job = SolveJoints2D(
            bodies:self.store,
            joints:self.joints,
            offset:self.joints.color_offset(color),
            count:count,
            reverse:reverse,
            inverse_delta:inverse_delta,
            use_bias:use_bias
        )
        if self.parallel_enabled && color < 11 &&
            count >= soft_step_constraint_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func execute_restitution_color(color:int) {
        let offset = self.constraint_color_offsets[color]
        let count = self.constraint_color_counts[color]
        if count == 0 { return }
        var job = RestitutionSoftConstraints2D(
            store:self.store,
            state:self.soft_constraints,
            offset:offset,
            threshold:self.current_restitution_threshold
        )
        if self.parallel_enabled && color < 11 &&
            count >= soft_step_constraint_parallel_threshold()
        {
            if var executor = self.parallel_executor {
                var shared = executor
                shared.submit_parallel(count, job).complete()
                self.current_soft_step_parallel_dispatch_count++
                return
            }
        }
        job.execute(0, count)
    }

    private func solve_collisions(
        pairs:@int[],
        delta:float,
        substep_count:int
    ) {
        var profile_clock = Clock()
        if self.profiling_enabled { profile_clock.tick() }
        self.current_soft_step_stages.clear()
        self.current_soft_step_parallel_dispatch_count = 0
        var store = self.store
        var constraints = self.soft_constraints
        constraints.collisions.clear()
        constraints.compact_collisions.clear()
        constraints.compact_impulses.clear()
        constraints.entries.clear()
        if !self.current_warm_start_enabled {
            self.joints.clear_solver_impulses()
        }
        for candidate_index in pairs {
            let pair = self.candidate_bodies[candidate_index]
            var contact_cache = self.candidate_pairs[candidate_index]
            if !self.current_warm_start_enabled ||
                (store.body_types[pair.first] == BodyType2D.dynamic &&
                    !store.awake[pair.first]) ||
                (store.body_types[pair.second] == BodyType2D.dynamic &&
                    !store.awake[pair.second]) ||
                self.direct_wake_pending[pair.first] ||
                self.direct_wake_pending[pair.second]
            {
                // A sleeping body has had its velocity cleared. Reapplying an
                // impulse cached before sleep can release the former stack
                // load into the one awake body and wake the whole pile.
                contact_cache = ContactPair2D()
            }
            var collision_found = false
            if store.shape_counts[pair.first] == 1 &&
                store.shape_counts[pair.second] == 1 &&
                store.shape_kinds[pair.first] == 1 &&
                store.shape_kinds[pair.second] == 1 &&
                Math.abs(store.local_centers_x[pair.first]) <= 0.000000001 &&
                Math.abs(store.local_centers_y[pair.first]) <= 0.000000001 &&
                Math.abs(store.local_centers_x[pair.second]) <= 0.000000001 &&
                Math.abs(store.local_centers_y[pair.second]) <= 0.000000001 &&
                primary_material(store, pair.first).rolling_resistance == 0.0 &&
                primary_material(store, pair.second).rolling_resistance == 0.0 &&
                primary_material(store, pair.first).tangent_speed == 0.0 &&
                primary_material(store, pair.second).tangent_speed == 0.0 &&
                store.awake[pair.first] && store.awake[pair.second] &&
                store.inverse_masses[pair.first] > 0.0 &&
                store.inverse_masses[pair.second] > 0.0
            {
                if let collision = build_compact_circle_collision(
                    store,
                    pair.first,
                    pair.second,
                    candidate_index,
                    contact_cache
                ) {
                    let index = constraints.compact_collisions.count()
                    constraints.compact_collisions.append(collision)
                    constraints.compact_impulses.append(
                        CompactCircleImpulses2D(
                            collision.normal_impulse,
                            collision.tangent_impulse
                        )
                    )
                    constraints.entries.append(index)
                    collision_found = true
                }
            } else if let collision = build_solver_collision(
                store,
                pair,
                candidate_index,
                contact_cache
            ) {
                let index = constraints.collisions.count()
                constraints.collisions.append(collision)
                constraints.entries.append(-index - 1)
                collision_found = true
            }
            if !collision_found {
                self.candidate_pairs[candidate_index].contact_count = 0
                self.candidate_pairs[candidate_index].normal_impulse_first = 0.0
                self.candidate_pairs[candidate_index].normal_impulse_second = 0.0
                self.candidate_pairs[candidate_index].tangent_impulse_first = 0.0
                self.candidate_pairs[candidate_index].tangent_impulse_second = 0.0
                self.candidate_pairs[candidate_index].rolling_impulse = 0.0
            }
        }
        if self.profiling_enabled {
            self.current_collision_build_ms = profile_clock.tick() * 1000.0
        }
        self.build_constraint_colors()
        self.current_soft_step_stages.append(1)
        self.execute_begin_soft_step_bodies()
        self.current_soft_step_stages.append(2)
        var collision_index = 0
        if delta > 0.0 {
            let substep_delta = delta / substep_count as float
            let inverse_substep_delta = 1.0 / substep_delta
            let contact_softness = make_contact_softness(
                self.current_contact_stiffness_hertz,
                self.current_contact_damping_ratio,
                substep_delta,
                inverse_substep_delta,
                self.current_maximum_correction_speed
            )
            let static_softness = make_contact_softness(
                2.0 * self.current_contact_stiffness_hertz,
                self.current_contact_damping_ratio,
                substep_delta,
                inverse_substep_delta,
                self.current_maximum_correction_speed
            )
            var substep = 0
            while substep < substep_count {
                self.execute_integrate_soft_step_velocities(substep_delta)
                self.current_soft_step_stages.append(3)
                var color = 0
                if self.current_warm_start_enabled {
                    while color < 12 {
                        self.execute_warm_start_color(color)
                        self.execute_warm_start_joint_color(color)
                        color++
                    }
                }
                self.current_soft_step_stages.append(4)
                var solve_iteration = 0
                while solve_iteration < 2 {
                    var color_step = 1
                    color = 0
                    if solve_iteration % 2 == 1 {
                        color = 11
                        color_step = -1
                    }
                    while color >= 0 && color < 12 {
                        self.execute_solve_color(
                            color,
                            contact_softness,
                            static_softness,
                            inverse_substep_delta,
                            true,
                            solve_iteration == 1,
                            solve_iteration % 2 == 1
                        )
                        self.execute_solve_joint_color(
                            color,
                            inverse_substep_delta,
                            true,
                            solve_iteration % 2 == 1
                        )
                        color += color_step
                    }
                    self.current_soft_step_stages.append(5)
                    solve_iteration++
                }
                self.execute_integrate_soft_step_positions(substep_delta)
                self.current_soft_step_stages.append(6)
                color = 0
                while color < 12 {
                    self.execute_solve_color(
                        color,
                        contact_softness,
                        static_softness,
                        inverse_substep_delta,
                        false,
                        false,
                        false
                    )
                    self.execute_solve_joint_color(
                        color,
                        inverse_substep_delta,
                        false,
                        false
                    )
                    color++
                }
                self.current_soft_step_stages.append(7)
                substep++
            }
            var color = 0
            while color < 12 {
                self.execute_restitution_color(color)
                color++
            }
            self.current_soft_step_stages.append(8)
            self.current_soft_step_stages.append(9)
            self.joints.finish_step(1.0 / delta)
        } else {
            self.joints.finish_step(0.0)
        }
        if self.profiling_enabled {
            self.current_collision_warm_start_ms = 0.0
            self.current_collision_velocity_ms = profile_clock.tick() * 1000.0
            self.current_collision_position_ms = 0.0
        }
        self.current_soft_step_stages.append(10)
        collision_index = 0
        while collision_index < constraints.entries.count() {
            let entry = constraints.entries[collision_index]
            if entry >= 0 {
                let collision = constraints.compact_collisions[entry]
                let impulses = constraints.compact_impulses[entry]
                let cache = collision.cache_index
                self.candidate_pairs[cache].normal = collision.normal
                self.candidate_pairs[cache].first_contact =
                    collision.first_contact
                self.candidate_pairs[cache].contact_count = 1
                self.candidate_pairs[cache].normal_impulse_first =
                    impulses.normal
                self.candidate_pairs[cache].normal_impulse_second = 0.0
                self.candidate_pairs[cache].tangent_impulse_first =
                    impulses.tangent
                self.candidate_pairs[cache].tangent_impulse_second = 0.0
                self.candidate_pairs[cache].rolling_impulse = 0.0
                self.candidate_pairs[cache].first_awake =
                    store.awake[collision.first_body]
                self.candidate_pairs[cache].second_awake =
                    store.awake[collision.second_body]
            } else {
                let collision = constraints.collisions[-entry - 1]
                let cache = collision.cache_index
                self.candidate_pairs[cache].normal = collision.normal
                self.candidate_pairs[cache].first_contact =
                    body_contact_cache_point(
                        store,
                        collision.first_body,
                        collision.contacts.first
                    )
                self.candidate_pairs[cache].second_contact =
                    body_contact_cache_point(
                        store,
                        collision.first_body,
                        collision.contacts.second
                    )
                self.candidate_pairs[cache].contact_count =
                    collision.contacts.count
                self.candidate_pairs[cache].normal_impulse_first =
                    collision.normal_impulse_first
                self.candidate_pairs[cache].normal_impulse_second =
                    collision.normal_impulse_second
                self.candidate_pairs[cache].tangent_impulse_first =
                    collision.tangent_impulse_first
                self.candidate_pairs[cache].tangent_impulse_second =
                    collision.tangent_impulse_second
                self.candidate_pairs[cache].rolling_impulse =
                    collision.rolling_impulse
                self.candidate_pairs[cache].first_awake =
                    store.awake[collision.first_body]
                self.candidate_pairs[cache].second_awake =
                    store.awake[collision.second_body]
            }
            collision_index++
        }
        if self.profiling_enabled {
            self.current_collision_cache_ms = profile_clock.tick() * 1000.0
        }
    }

    private func enforce_non_dynamic_box_boundaries() {
        var circle = 0
        while circle < self.store.count() {
            if self.store.body_types[circle] != BodyType2D.dynamic ||
                self.store.shape_kinds[circle] != 1 ||
                !self.store.awake[circle]
            {
                circle++
                continue
            }
            for fixed_body in self.non_dynamic_bodies {
                if (self.store.behavior_flags[circle] & 2) != 0 ||
                    (self.store.behavior_flags[fixed_body] & 2) != 0
                {
                    continue
                }
                if self.store.shape_kinds[fixed_body] != 0 { continue }
                if !self.tight_bounds[fixed_body].overlaps(
                    self.tight_bounds[circle]
                ) { continue }
                self.enforce_circle_outside_fixed_box(circle, fixed_body)
            }
            circle++
        }
    }

    private func enforce_circle_outside_fixed_box(circle:int, box:int) {
        let box_x = self.store.positions_x[box]
        let box_y = self.store.positions_y[box]
        let cosine = self.store.rotation_cosines[box]
        let sine = self.store.rotation_sines[box]
        let offset_x = self.store.positions_x[circle] - box_x
        let offset_y = self.store.positions_y[circle] - box_y
        var local_x:float = offset_x * cosine + offset_y * sine
        var local_y:float = offset_y * cosine - offset_x * sine
        let half_width = self.store.half_widths[box]
        let half_height = self.store.half_heights[box]
        if Math.abs(local_x) >= half_width ||
            Math.abs(local_y) >= half_height
        {
            return
        }

        let previous_offset_x = self.store.previous_positions_x[circle] - box_x
        let previous_offset_y = self.store.previous_positions_y[circle] - box_y
        let previous_local_x =
            previous_offset_x * cosine + previous_offset_y * sine
        let previous_local_y =
            previous_offset_y * cosine - previous_offset_x * sine
        let previous_outside_x = Math.abs(previous_local_x) - half_width
        let previous_outside_y = Math.abs(previous_local_y) - half_height
        var normal_local_x:float = 0.0
        var normal_local_y:float = 0.0
        if previous_outside_x > 0.0 || previous_outside_y > 0.0 {
            if previous_outside_x > previous_outside_y {
                normal_local_x = 1.0
                if previous_local_x < 0.0 { normal_local_x = -1.0 }
            } else {
                normal_local_y = 1.0
                if previous_local_y < 0.0 { normal_local_y = -1.0 }
            }
        } else {
            let distance_x = half_width - Math.abs(local_x)
            let distance_y = half_height - Math.abs(local_y)
            if distance_x < distance_y {
                normal_local_x = 1.0
                if local_x < 0.0 { normal_local_x = -1.0 }
            } else {
                normal_local_y = 1.0
                if local_y < 0.0 { normal_local_y = -1.0 }
            }
        }

        let radius = self.store.radii[circle]
        if normal_local_x != 0.0 {
            local_x = normal_local_x * (half_width + radius + 0.00025)
        } else {
            local_y = normal_local_y * (half_height + radius + 0.00025)
        }
        self.store.positions_x[circle] =
            box_x + cosine * local_x - sine * local_y
        self.store.positions_y[circle] =
            box_y + sine * local_x + cosine * local_y
        let normal_x = cosine * normal_local_x - sine * normal_local_y
        let normal_y = sine * normal_local_x + cosine * normal_local_y
        let inward_velocity = self.store.velocities_x[circle] * normal_x +
            self.store.velocities_y[circle] * normal_y
        if inward_velocity < 0.0 {
            self.store.velocities_x[circle] -= inward_velocity * normal_x
            self.store.velocities_y[circle] -= inward_velocity * normal_y
        }
        self.store.dirty_transforms[circle] = true
    }

}

func ordered_body_pair(first:int, second:int) BodyPair2D {
    if first < second { return BodyPair2D(first, second) }
    return BodyPair2D(second, first)
}

func finite_world_value(value:float) bool {
    return value == value && (value == 0.0 || value + value != value)
}

func require_non_negative_world_value(value:float, message:str) {
    if !finite_world_value(value) || value < 0.0 { panic(message) }
}

func require_positive_world_value(value:float, message:str) {
    if !finite_world_value(value) || value <= 0.0 { panic(message) }
}

func validate_world_settings(settings:World2DSettings) {
    if !finite_world_value(settings.gravity.x) ||
        !finite_world_value(settings.gravity.y)
    {
        panic("GFX.Physics.World2DSettings gravity must be finite")
    }
    require_non_negative_world_value(
        settings.restitution_threshold,
        "GFX.Physics.World2DSettings restitution threshold must be finite and non-negative"
    )
    require_non_negative_world_value(
        settings.hit_event_threshold,
        "GFX.Physics.World2DSettings hit event threshold must be finite and non-negative"
    )
    require_non_negative_world_value(
        settings.contact_stiffness_hertz,
        "GFX.Physics.World2DSettings contact stiffness must be finite and non-negative"
    )
    require_non_negative_world_value(
        settings.contact_damping_ratio,
        "GFX.Physics.World2DSettings contact damping ratio must be finite and non-negative"
    )
    require_non_negative_world_value(
        settings.maximum_correction_speed,
        "GFX.Physics.World2DSettings maximum correction speed must be finite and non-negative"
    )
    require_positive_world_value(
        settings.maximum_linear_speed,
        "GFX.Physics.World2DSettings maximum linear speed must be finite and positive"
    )
}

func stable_body_pair(store:BodyStore2D, pair:BodyPair2D) BodyPair2D {
    if store.dense_slots[pair.first] < store.dense_slots[pair.second] {
        return pair
    }
    return BodyPair2D(pair.second, pair.first)
}

func pair_is_sensor(store:BodyStore2D, pair:BodyPair2D) bool {
    if store.shape_counts[pair.first] == 1 &&
        store.shape_counts[pair.second] == 1
    {
        return (store.behavior_flags[pair.first] & 2) != 0 ||
            (store.behavior_flags[pair.second] & 2) != 0
    }
    return !body_pair_has_solid_collider_pair(store, pair)
}

func pair_contact_events_enabled(
    store:BodyStore2D,
    pair:BodyPair2D
) bool {
    return (store.behavior_flags[pair.first] & 8) != 0 ||
        (store.behavior_flags[pair.second] & 8) != 0
}

func pair_hit_events_enabled(store:BodyStore2D, pair:BodyPair2D) bool {
    return (store.behavior_flags[pair.first] & 16) != 0 ||
        (store.behavior_flags[pair.second] & 16) != 0
}

func continuous_pair_requires_sweep(
    store:BodyStore2D,
    mover:int,
    target:int
) bool {
    let mover_motion = body_position(store, mover).subtract(Math.Vec2(
        store.previous_positions_x[mover],
        store.previous_positions_y[mover]
    ))
    var target_motion = Math.Vec2()
    var target_rotation_motion = 0.0
    if store.body_types[target] != BodyType2D.fixed {
        target_motion = body_position(store, target).subtract(Math.Vec2(
            store.previous_positions_x[target],
            store.previous_positions_y[target]
        ))
        target_rotation_motion = store.rotations[target] -
            store.previous_rotations[target]
    }
    let relative_motion = mover_motion.subtract(target_motion)
    let mover_rotation_motion = store.rotations[mover] -
        store.previous_rotations[mover]
    let surface_motion = relative_motion.length() +
        Math.abs(mover_rotation_motion) *
            body_maximum_sweep_radius(store, mover) +
        Math.abs(target_rotation_motion) *
            body_maximum_sweep_radius(store, target)
    return surface_motion > 0.25 * body_minimum_continuous_extent(
        store,
        mover
    )
}

func continuous_pair_hit(
    store:BodyStore2D,
    mover:int,
    target:int
) ContinuousHit2D {
    let pair = ordered_body_pair(mover, target)
    let sensor_pair = pair_is_sensor(store, pair)
    var earliest = ContinuousHit2D()
    var mover_slot = store.first_shape_slots[mover]
    while mover_slot >= 0 {
        let mover_dense = store.shape_store.slot_dense_indices[mover_slot]
        let mover_sensor =
            (store.shape_store.behavior_flags[mover_dense] & 1) != 0
        var target_slot = store.first_shape_slots[target]
        while target_slot >= 0 {
            let target_dense = store.shape_store.slot_dense_indices[
                target_slot
            ]
            let target_sensor =
                (store.shape_store.behavior_flags[target_dense] & 1) != 0
            if (sensor_pair || (!mover_sensor && !target_sensor)) &&
                store.shape_store.collision_filters[mover_dense].allows(
                    store.shape_store.collision_filters[target_dense]
                )
            {
                let hit = continuous_pair_hit_for_shapes(
                    store,
                    mover,
                    target,
                    store.shape_store.shapes[mover_dense],
                    store.shape_store.collision_filters[mover_dense],
                    store.shape_store.shapes[target_dense],
                    store.shape_store.collision_filters[target_dense]
                )
                if hit.hit && (!earliest.hit || hit.fraction < earliest.fraction) {
                    earliest = hit
                }
            }
            target_slot = store.shape_store.next_body_shape_slots[target_dense]
        }
        mover_slot = store.shape_store.next_body_shape_slots[mover_dense]
    }
    return earliest
}

func continuous_pair_hit_for_shapes(
    store:BodyStore2D,
    mover:int,
    target:int,
    mover_shape:Shape2D,
    mover_filter:CollisionFilter2D,
    target_shape:Shape2D,
    target_filter:CollisionFilter2D
) ContinuousHit2D {
    let mover_start = Transform2D(
        position:Math.Vec2(
            store.previous_positions_x[mover],
            store.previous_positions_y[mover]
        ),
        rotation:store.previous_rotations[mover]
    )
    var target_start_position = Math.Vec2(
        store.previous_positions_x[target],
        store.previous_positions_y[target]
    )
    var target_start_rotation = store.previous_rotations[target]
    if store.body_types[target] == BodyType2D.fixed {
        target_start_position = body_position(store, target)
        target_start_rotation = store.rotations[target]
    }
    let target_start = Transform2D(
        position:target_start_position,
        rotation:target_start_rotation
    )
    let mover_motion = body_position(store, mover).subtract(
        mover_start.position
    )
    let target_motion = body_position(store, target).subtract(
        target_start.position
    )
    let mover_rotation_motion = store.rotations[mover] - mover_start.rotation
    let target_rotation_motion = store.rotations[target] - target_start.rotation
    let mover_placement = ShapePlacement2D(
        mover_shape,
        mover_start,
        mover_filter
    )
    let target_placement = ShapePlacement2D(
        target_shape,
        target_start,
        target_filter
    )
    if Geometry2D.overlaps(mover_placement, target_placement) {
        return ContinuousHit2D()
    }
    if Math.abs(mover_rotation_motion) <= 0.000001 &&
        Math.abs(target_rotation_motion) <= 0.000001
    {
        let cast = Geometry2D.shape_cast(
            mover_placement,
            mover_motion.subtract(target_motion),
            target_placement
        )
        if cast.hit {
            return ContinuousHit2D(
                cast.fraction,
                cast.point.add(target_motion.multiply(cast.fraction)),
                cast.normal
            )
        }
        return ContinuousHit2D()
    }

    var sample_count = (
        Math.floor(
            (Math.abs(mover_rotation_motion) +
                Math.abs(target_rotation_motion)) * 16.0
        ) as int
    ) + 4
    if sample_count < 8 { sample_count = 8 }
    if sample_count > 64 { sample_count = 64 }
    var previous_fraction = 0.0
    var sample = 1
    while sample <= sample_count {
        let fraction = sample as float / sample_count as float
        let moving = continuous_placement_at(
            mover_shape,
            mover_filter,
            mover_start,
            mover_motion,
            mover_rotation_motion,
            fraction
        )
        let other = continuous_placement_at(
            target_shape,
            target_filter,
            target_start,
            target_motion,
            target_rotation_motion,
            fraction
        )
        if Geometry2D.overlaps(moving, other) {
            var lower = previous_fraction
            var upper = fraction
            var iteration = 0
            while iteration < 12 {
                let middle = (lower + upper) * 0.5
                if Geometry2D.overlaps(
                    continuous_placement_at(
                        mover_shape,
                        mover_filter,
                        mover_start,
                        mover_motion,
                        mover_rotation_motion,
                        middle
                    ),
                    continuous_placement_at(
                        target_shape,
                        target_filter,
                        target_start,
                        target_motion,
                        target_rotation_motion,
                        middle
                    )
                ) {
                    upper = middle
                } else {
                    lower = middle
                }
                iteration++
            }
            let hit_mover = continuous_placement_at(
                mover_shape,
                mover_filter,
                mover_start,
                mover_motion,
                mover_rotation_motion,
                upper
            )
            let hit_target = continuous_placement_at(
                target_shape,
                target_filter,
                target_start,
                target_motion,
                target_rotation_motion,
                upper
            )
            let manifold = Geometry2D.manifold(hit_target, hit_mover)
            if manifold.point_count() > 0 {
                return ContinuousHit2D(
                    upper,
                    manifold.points[0].point,
                    manifold.normal
                )
            }
            var normal = hit_mover.transform().position.subtract(
                hit_target.transform().position
            )
            if normal.length_squared() <= 0.000000001 {
                normal = Math.Vec2.right()
            } else {
                normal = normal.normalized()
            }
            return ContinuousHit2D(
                upper,
                hit_mover.transform().position.add(
                    hit_target.transform().position
                ).multiply(0.5),
                normal
            )
        }
        previous_fraction = fraction
        sample++
    }
    return ContinuousHit2D()
}

func continuous_placement_at(
    shape:Shape2D,
    filter:CollisionFilter2D,
    start:Transform2D,
    motion:Math.Vec2,
    rotation_motion:float,
    fraction:float
) ShapePlacement2D {
    return ShapePlacement2D(
        shape,
        Transform2D(
            position:start.position.add(motion.multiply(fraction)),
            rotation:start.rotation + rotation_motion * fraction
        ),
        filter
    )
}

func begin_soft_step_motion(store:BodyStore2D, index:int) {
    store.previous_positions_x[index] = store.positions_x[index]
    store.previous_positions_y[index] = store.positions_y[index]
    store.previous_rotations[index] = store.rotations[index]
}

func integrate_body_velocity(
    store:BodyStore2D,
    gravity:Math.Vec2,
    index:int,
    delta:float,
    maximum_linear_speed:float
) {
    store.velocities_x[index] +=
        (gravity.x * store.gravity_scales[index] +
            store.forces_x[index] * store.inverse_masses[index]) * delta
    store.velocities_y[index] +=
        (gravity.y * store.gravity_scales[index] +
            store.forces_y[index] * store.inverse_masses[index]) * delta
    store.angular_velocities[index] +=
        store.torques[index] * store.inverse_inertias[index] * delta
    let linear_scale = 1.0 / (
        1.0 + store.linear_dampings[index] * delta
    )
    store.velocities_x[index] *= linear_scale
    store.velocities_y[index] *= linear_scale
    let speed_squared =
        store.velocities_x[index] * store.velocities_x[index] +
        store.velocities_y[index] * store.velocities_y[index]
    let maximum_squared = maximum_linear_speed * maximum_linear_speed
    if speed_squared > maximum_squared {
        let scale = maximum_linear_speed / Math.sqrt(speed_squared)
        store.velocities_x[index] *= scale
        store.velocities_y[index] *= scale
    }
    store.angular_velocities[index] *= 1.0 / (
        1.0 + store.angular_dampings[index] * delta
    )
}

func ordered_query_colliders(store:BodyStore2D) int[] {
    var ordered:int[] = []
    var dense = 0
    while dense < store.shape_store.count() {
        var destination = ordered.count()
        ordered.append(dense)
        while destination > 0 &&
            store.shape_store.creation_ids[ordered[destination - 1]] >
                store.shape_store.creation_ids[dense]
        {
            ordered[destination] = ordered[destination - 1]
            destination--
        }
        ordered[destination] = dense
        dense++
    }
    return ordered
}

func query_collider_body(store:BodyStore2D, dense:int) int {
    return store.slot_dense_indices[store.shape_store.body_slots[dense]]
}

func query_collider_enabled(store:BodyStore2D, dense:int) bool {
    return store.enabled[query_collider_body(store, dense)]
}

func query_collider_handle(store:BodyStore2D, dense:int) Collider2D {
    let slot = store.shape_store.dense_slots[dense]
    return Collider2D(
        store,
        ShapeId2D(slot, store.shape_store.slot_generations[slot])
    )
}

func query_collider_placement(
    store:BodyStore2D,
    dense:int
) ShapePlacement2D {
    let body = query_collider_body(store, dense)
    return ShapePlacement2D(
        store.shape_store.shapes[dense],
        Transform2D(
            position:body_position(store, body),
            rotation:store.rotations[body]
        )
    )
}

func query_collider_bounds(store:BodyStore2D, dense:int) AABB2D {
    return Geometry2D.aabb(query_collider_placement(store, dense))
}

func ray_query_bounds(ray:Ray2D) AABB2D {
    let finish = ray.origin.add(ray.translation.multiply(ray.max_fraction))
    let lower = Math.Vec2(
        Math.min(ray.origin.x, finish.x),
        Math.min(ray.origin.y, finish.y)
    )
    let upper = Math.Vec2(
        Math.max(ray.origin.x, finish.x),
        Math.max(ray.origin.y, finish.y)
    )
    return AABB2D(lower, upper, true)
}

func shape_cast_query_bounds(
    moving:ShapePlacement2D,
    translation:Math.Vec2,
    max_fraction:float
) AABB2D {
    if !finite_world_value(translation.x) ||
        !finite_world_value(translation.y) ||
        !finite_world_value(max_fraction) || max_fraction <= 0.0
    {
        panic("GFX.Physics.World2D shape cast requires finite motion and a positive maximum fraction")
    }
    let start = Geometry2D.aabb(moving)
    let displacement = translation.multiply(max_fraction)
    let finish = AABB2D(
        start.center().add(displacement),
        start.half_size()
    )
    return AABB2D(
        Math.Vec2(
            Math.min(start.lower.x, finish.lower.x),
            Math.min(start.lower.y, finish.lower.y)
        ),
        Math.Vec2(
            Math.max(start.upper.x, finish.upper.x),
            Math.max(start.upper.y, finish.upper.y)
        ),
        true
    )
}

func integrate_body_position(
    store:BodyStore2D,
    index:int,
    delta:float
) {
    var center = store.world_center_at(index)
    center.x += store.velocities_x[index] * delta
    center.y += store.velocities_y[index] * delta
    if store.angular_velocities[index] != 0.0 {
        store.rotations[index] += store.angular_velocities[index] * delta
        store.cache_rotation(index)
    }
    let cosine = store.rotation_cosines[index]
    let sine = store.rotation_sines[index]
    store.positions_x[index] = center.x -
        cosine * store.local_centers_x[index] +
        sine * store.local_centers_y[index]
    store.positions_y[index] = center.y -
        sine * store.local_centers_x[index] -
        cosine * store.local_centers_y[index]
    store.dirty_transforms[index] = true
}

func body_bounds(store:BodyStore2D, index:int) AABB2D {
    if store.shape_counts[index] == 0 {
        return AABB2D(body_position(store, index), Math.Vec2())
    }
    if store.shape_counts[index] == 1 {
        return primary_body_bounds(store, index)
    }
    var slot = store.first_shape_slots[index]
    var lower = Math.Vec2(3.4028235e38)
    var upper = Math.Vec2(-3.4028235e38)
    while slot >= 0 {
        let dense = store.shape_store.slot_dense_indices[slot]
        let bounds = collider_bounds(store, index, dense)
        lower.x = Math.min(lower.x, bounds.lower.x)
        lower.y = Math.min(lower.y, bounds.lower.y)
        upper.x = Math.max(upper.x, bounds.upper.x)
        upper.y = Math.max(upper.y, bounds.upper.y)
        slot = store.shape_store.next_body_shape_slots[dense]
    }
    return AABB2D(lower, upper, true)
}

func primary_body_bounds(store:BodyStore2D, index:int) AABB2D {
    if store.shape_kinds[index] == 1 {
        return AABB2D(
            body_position(store, index),
            Math.Vec2(store.radii[index])
        )
    }
    if store.shape_kinds[index] == 0 {
        let cosine = Math.abs(store.rotation_cosines[index])
        let sine = Math.abs(store.rotation_sines[index])
        return AABB2D(
            body_position(store, index),
            Math.Vec2(
                store.half_widths[index] * cosine +
                    store.half_heights[index] * sine,
                store.half_widths[index] * sine +
                    store.half_heights[index] * cosine
            )
        )
    }
    return transformed_local_bounds(
        store,
        index,
        store.local_lower_x[index],
        store.local_lower_y[index],
        store.local_upper_x[index],
        store.local_upper_y[index]
    )
}

func body_maximum_sweep_radius(store:BodyStore2D, body:int) float {
    var maximum = 0.0
    var slot = store.first_shape_slots[body]
    while slot >= 0 {
        let dense = store.shape_store.slot_dense_indices[slot]
        maximum = Math.max(
            maximum,
            Math.sqrt(shape_metrics(
                store.shape_store.shapes[dense]
            ).sweep_radius_squared)
        )
        slot = store.shape_store.next_body_shape_slots[dense]
    }
    return maximum
}

func body_minimum_continuous_extent(
    store:BodyStore2D,
    body:int
) float {
    var minimum = 3.4028235e38
    var slot = store.first_shape_slots[body]
    while slot >= 0 {
        let dense = store.shape_store.slot_dense_indices[slot]
        let metrics = shape_metrics(store.shape_store.shapes[dense])
        var extent = Math.min(
            (metrics.upper.x - metrics.lower.x) * 0.5,
            (metrics.upper.y - metrics.lower.y) * 0.5
        )
        if metrics.radius > 0.0 {
            extent = Math.min(extent, metrics.radius)
        }
        minimum = Math.min(minimum, extent)
        slot = store.shape_store.next_body_shape_slots[dense]
    }
    if minimum == 3.4028235e38 { return 0.0 }
    return minimum
}

func collider_bounds(
    store:BodyStore2D,
    body:int,
    collider_dense:int
) AABB2D {
    let metrics = shape_metrics(store.shape_store.shapes[collider_dense])
    if metrics.kind == 1 {
        return AABB2D(
            body_position(store, body),
            Math.Vec2(metrics.radius)
        )
    }
    return transformed_local_bounds(
        store,
        body,
        metrics.lower.x,
        metrics.lower.y,
        metrics.upper.x,
        metrics.upper.y
    )
}

func transformed_local_bounds(
    store:BodyStore2D,
    body:int,
    lower_x:float,
    lower_y:float,
    upper_x:float,
    upper_y:float
) AABB2D {
    let cosine = store.rotation_cosines[body]
    let sine = store.rotation_sines[body]
    let position = body_position(store, body)
    let first = Math.Vec2(
        position.x + cosine * lower_x - sine * lower_y,
        position.y + sine * lower_x + cosine * lower_y
    )
    let second = Math.Vec2(
        position.x + cosine * upper_x - sine * lower_y,
        position.y + sine * upper_x + cosine * lower_y
    )
    let third = Math.Vec2(
        position.x + cosine * upper_x - sine * upper_y,
        position.y + sine * upper_x + cosine * upper_y
    )
    let fourth = Math.Vec2(
        position.x + cosine * lower_x - sine * upper_y,
        position.y + sine * lower_x + cosine * upper_y
    )
    return AABB2D(
        Math.Vec2(
            Math.min(Math.min(first.x, second.x), Math.min(third.x, fourth.x)),
            Math.min(Math.min(first.y, second.y), Math.min(third.y, fourth.y))
        ),
        Math.Vec2(
            Math.max(Math.max(first.x, second.x), Math.max(third.x, fourth.x)),
            Math.max(Math.max(first.y, second.y), Math.max(third.y, fourth.y))
        ),
        true
    )
}

func primitive_contact_pair(store:BodyStore2D, pair:BodyPair2D) bool {
    return store.shape_counts[pair.first] == 1 &&
        store.shape_counts[pair.second] == 1 &&
        store.shape_kinds[pair.first] <= 1 &&
        store.shape_kinds[pair.second] <= 1
}

func body_placement(store:BodyStore2D, index:int) ShapePlacement2D {
    return ShapePlacement2D(
        store.shapes[index],
        Transform2D(
            position:body_position(store, index),
            rotation:store.rotations[index]
        ),
        store.collision_filters[index]
    )
}

func contact_manifold(
    store:BodyStore2D,
    first_body:int,
    second_body:int
) Manifold2D {
    if store.shape_counts[first_body] == 1 &&
        store.shape_counts[second_body] == 1
    {
        return Geometry2D.manifold(
            body_placement(store, first_body),
            body_placement(store, second_body)
        )
    }
    var selected = Manifold2D()
    var selected_separation = 3.4028235e38
    var first_slot = store.first_shape_slots[first_body]
    while first_slot >= 0 {
        let first_dense = store.shape_store.slot_dense_indices[first_slot]
        if (store.shape_store.behavior_flags[first_dense] & 1) == 0 {
            var second_slot = store.first_shape_slots[second_body]
            while second_slot >= 0 {
                let second_dense = store.shape_store.slot_dense_indices[second_slot]
                if (store.shape_store.behavior_flags[second_dense] & 1) == 0 &&
                    store.shape_store.collision_filters[first_dense].allows(
                        store.shape_store.collision_filters[second_dense]
                    )
                {
                    let manifold = Geometry2D.manifold(
                        collider_placement(store, first_body, first_dense),
                        collider_placement(store, second_body, second_dense)
                    )
                    if manifold.point_count() > 0 {
                        let separation = manifold_minimum_separation(manifold)
                        if separation < selected_separation {
                            selected = manifold
                            selected_separation = separation
                        }
                    }
                }
                second_slot = store.shape_store.next_body_shape_slots[
                    second_dense
                ]
            }
        }
        first_slot = store.shape_store.next_body_shape_slots[first_dense]
    }
    return selected
}

func manifold_minimum_separation(manifold:Manifold2D) float {
    var separation = manifold.points[0].separation
    if manifold.point_count() > 1 {
        separation = Math.min(separation, manifold.points[1].separation)
    }
    return separation
}

func solid_contact(
    store:BodyStore2D,
    first_body:int,
    second_body:int
) SolidContact2D? {
    var selected:SolidContact2D? = null
    var selected_separation = 3.4028235e38
    var first_slot = store.first_shape_slots[first_body]
    while first_slot >= 0 {
        let first_dense = store.shape_store.slot_dense_indices[first_slot]
        if (store.shape_store.behavior_flags[first_dense] & 1) == 0 {
            var second_slot = store.first_shape_slots[second_body]
            while second_slot >= 0 {
                let second_dense = store.shape_store.slot_dense_indices[second_slot]
                if (store.shape_store.behavior_flags[second_dense] & 1) == 0 &&
                    store.shape_store.collision_filters[first_dense].allows(
                        store.shape_store.collision_filters[second_dense]
                    )
                {
                    let manifold = Geometry2D.manifold(
                        collider_placement(store, first_body, first_dense),
                        collider_placement(store, second_body, second_dense)
                    )
                    if manifold.point_count() > 0 {
                        let separation = manifold_minimum_separation(manifold)
                        if separation < selected_separation {
                            let first_metrics = shape_metrics(
                                store.shape_store.shapes[first_dense]
                            )
                            let second_metrics = shape_metrics(
                                store.shape_store.shapes[second_dense]
                            )
                            selected = SolidContact2D(
                                manifold,
                                store.shape_store.contact_material(
                                    first_dense,
                                    manifold.first_feature
                                ),
                                store.shape_store.contact_material(
                                    second_dense,
                                    manifold.second_feature
                                ),
                                first_metrics.radius,
                                second_metrics.radius,
                                first_metrics.kind != 1,
                                second_metrics.kind != 1
                            )
                            selected_separation = separation
                        }
                    }
                }
                second_slot = store.shape_store.next_body_shape_slots[
                    second_dense
                ]
            }
        }
        first_slot = store.shape_store.next_body_shape_slots[first_dense]
    }
    return selected
}

func build_solver_collision(
    store:BodyStore2D,
    pair:BodyPair2D,
    cache_index:int,
    cache:ContactPair2D
) Collision2D? {
    if primitive_contact_pair(store, pair) {
        if let collision = build_collision(
            store,
            pair.first,
            pair.second,
            cache_index,
            cache,
            false
        ) {
            var result = collision
            apply_collision_materials(
                result,
                primary_material(store, pair.first),
                primary_material(store, pair.second),
                store.radii[pair.first],
                store.radii[pair.second]
            )
            return result
        }
        return null
    }
    let inverse_mass = solver_inverse_mass(store, pair.first) +
        solver_inverse_mass(store, pair.second)
    if inverse_mass <= 0.0 { return null }
    if let contact = solid_contact(store, pair.first, pair.second) {
        let manifold = contact.manifold
        var points = ContactPoints2D(
            manifold.points[0].point,
            manifold.points[0].separation
        )
        if manifold.point_count() > 1 {
            points = ContactPoints2D(
                manifold.points[0].point,
                manifold.points[0].separation,
                manifold.points[1].point,
                manifold.points[1].separation
            )
        }
        var collision = Collision2D(
            store,
            pair.first,
            pair.second,
            manifold.normal,
            points,
            manifold.points[0].separation,
            cache_index,
            cache
        )
        collision.first_anchor_rotates = contact.first_anchor_rotates
        collision.second_anchor_rotates = contact.second_anchor_rotates
        collision.first_anchor_a = soft_step_contact_anchor(
            store,
            pair.first,
            points.first,
            contact.first_anchor_rotates
        )
        collision.first_anchor_b = soft_step_contact_anchor(
            store,
            pair.second,
            points.first,
            contact.second_anchor_rotates
        )
        collision.second_anchor_a = soft_step_contact_anchor(
            store,
            pair.first,
            points.second,
            contact.first_anchor_rotates
        )
        collision.second_anchor_b = soft_step_contact_anchor(
            store,
            pair.second,
            points.second,
            contact.second_anchor_rotates
        )
        collision.base_separation_first = points.first_separation
        collision.base_separation_second = points.second_separation
        prepare_collision_constraints(store, collision)
        apply_collision_materials(
            collision,
            contact.first_material,
            contact.second_material,
            contact.first_radius,
            contact.second_radius
        )
        return collision
    }
    return null
}

func apply_collision_materials(
    collision:&Collision2D,
    first:PhysicsMaterial2D,
    second:PhysicsMaterial2D,
    first_radius:float,
    second_radius:float
) {
    collision.restitution = Math.max(first.restitution, second.restitution)
    collision.combined_friction = Math.sqrt(
        first.friction * second.friction
    )
    collision.rolling_resistance = Math.max(
        first.rolling_resistance,
        second.rolling_resistance
    ) * Math.max(first_radius, second_radius)
    collision.tangent_speed = first.tangent_speed + second.tangent_speed
}

func collider_placement(
    store:BodyStore2D,
    body:int,
    collider_dense:int
) ShapePlacement2D {
    return ShapePlacement2D(
        store.shape_store.shapes[collider_dense],
        Transform2D(
            position:body_position(store, body),
            rotation:store.rotations[body]
        ),
        store.shape_store.collision_filters[collider_dense]
    )
}

func primary_material(store:BodyStore2D, body:int) PhysicsMaterial2D {
    let slot = store.primary_shape_slots[body]
    return store.shape_store.materials[
        store.shape_store.slot_dense_indices[slot]
    ]
}

func body_pair_has_solid_collider_pair(
    store:BodyStore2D,
    pair:BodyPair2D
) bool {
    if store.shape_counts[pair.first] == 1 &&
        store.shape_counts[pair.second] == 1
    {
        return (store.behavior_flags[pair.first] & 2) == 0 &&
            (store.behavior_flags[pair.second] & 2) == 0 &&
            store.collision_filters[pair.first].allows(
                store.collision_filters[pair.second]
            )
    }
    var first_slot = store.first_shape_slots[pair.first]
    while first_slot >= 0 {
        let first_dense = store.shape_store.slot_dense_indices[first_slot]
        if (store.shape_store.behavior_flags[first_dense] & 1) == 0 {
            var second_slot = store.first_shape_slots[pair.second]
            while second_slot >= 0 {
                let second_dense = store.shape_store.slot_dense_indices[second_slot]
                if (store.shape_store.behavior_flags[second_dense] & 1) == 0 &&
                    store.shape_store.collision_filters[first_dense].allows(
                        store.shape_store.collision_filters[second_dense]
                    )
                {
                    return true
                }
                second_slot = store.shape_store.next_body_shape_slots[second_dense]
            }
        }
        first_slot = store.shape_store.next_body_shape_slots[first_dense]
    }
    return false
}

func sensor_pair_overlaps(
    store:BodyStore2D,
    sensor_body:int,
    other_body:int
) bool {
    if store.shape_counts[sensor_body] == 1 &&
        store.shape_counts[other_body] == 1
    {
        return (store.behavior_flags[sensor_body] & 2) != 0 &&
            (store.behavior_flags[sensor_body] & 32) != 0 &&
            Geometry2D.overlaps(
                body_placement(store, sensor_body),
                body_placement(store, other_body)
            )
    }
    var sensor_slot = store.first_shape_slots[sensor_body]
    while sensor_slot >= 0 {
        let sensor_dense = store.shape_store.slot_dense_indices[sensor_slot]
        let sensor_flags = store.shape_store.behavior_flags[sensor_dense]
        if (sensor_flags & 1) != 0 && (sensor_flags & 8) != 0 {
            var other_slot = store.first_shape_slots[other_body]
            while other_slot >= 0 {
                let other_dense = store.shape_store.slot_dense_indices[other_slot]
                if store.shape_store.collision_filters[sensor_dense].allows(
                    store.shape_store.collision_filters[other_dense]
                ) && Geometry2D.overlaps(
                    collider_placement(store, sensor_body, sensor_dense),
                    collider_placement(store, other_body, other_dense)
                ) {
                    return true
                }
                other_slot = store.shape_store.next_body_shape_slots[other_dense]
            }
        }
        sensor_slot = store.shape_store.next_body_shape_slots[sensor_dense]
    }
    return false
}

func build_collision(
    store:BodyStore2D,
    first_body:int,
    second_body:int,
    cache_index:int,
    cache:ContactPair2D,
    wake_contacts:bool = true
) Collision2D? {
    let first_kind = store.shape_kinds[first_body]
    let second_kind = store.shape_kinds[second_body]
    if first_kind == 0 && second_kind == 0 {
        return build_box_collision(
            store,
            first_body,
            second_body,
            cache_index,
            cache,
            wake_contacts
        )
    }
    if first_kind == 1 && second_kind == 1 {
        return build_circle_collision(
            store,
            first_body,
            second_body,
            cache_index,
            cache
        )
    }
    if first_kind == 1 {
        return build_circle_box_collision(
            store,
            first_body,
            second_body,
            true,
            cache_index,
            cache,
            wake_contacts
        )
    }
    return build_circle_box_collision(
        store,
        second_body,
        first_body,
        false,
        cache_index,
        cache,
        wake_contacts
    )
}

func build_circle_collision(
    store:BodyStore2D,
    first_body:int,
    second_body:int,
    cache_index:int,
    cache:ContactPair2D
) Collision2D? {
    let inverse_mass = store.inverse_masses[first_body] +
        store.inverse_masses[second_body]
    if inverse_mass <= 0.0 { return null }

    let offset_x = store.positions_x[second_body] -
        store.positions_x[first_body]
    let offset_y = store.positions_y[second_body] -
        store.positions_y[first_body]
    let distance_squared = offset_x * offset_x + offset_y * offset_y
    let combined_radius = store.radii[first_body] + store.radii[second_body]
    let speculative_radius = combined_radius + 0.02
    if distance_squared > speculative_radius * speculative_radius { return null }

    var distance = 0.0
    if distance_squared > 0.000000000001 {
        distance = Math.sqrt(distance_squared)
    }
    var separation_normal = circle_contact_normal(
        store,
        first_body,
        second_body,
        offset_x,
        offset_y,
        distance,
        combined_radius
    )
    if distance <= combined_radius * 0.2 && cache.contact_count == 1 &&
        cache.normal.dot(cache.normal) > 0.5
    {
        separation_normal = cache.normal
        if offset_x * separation_normal.x +
            offset_y * separation_normal.y < 0.0
        {
            separation_normal = separation_normal.negated()
        }
    }
    let normal_x = separation_normal.x
    let normal_y = separation_normal.y
    let penetration = combined_radius - distance
    let normal = Math.Vec2(normal_x, normal_y)
    let contact = Math.Vec2(
        (store.positions_x[first_body] + normal_x * store.radii[first_body] +
            store.positions_x[second_body] -
            normal_x * store.radii[second_body]) * 0.5,
        (store.positions_y[first_body] + normal_y * store.radii[first_body] +
            store.positions_y[second_body] -
            normal_y * store.radii[second_body]) * 0.5
    )
    // Dynamic circle wake-up is staged before active-pair filtering. Keeping
    // it out of constraint construction makes wake propagation independent of
    // candidate order and gives a newly awakened surface body its sleeping
    // support contacts in this same step.
    var collision = Collision2D(
        store,
        first_body,
        second_body,
        normal,
        ContactPoints2D(contact),
        -penetration,
        cache_index,
        cache,
        true
    )
    prepare_circle_collision_constraints(store, collision)
    return collision
}

func build_compact_circle_collision(
    store:BodyStore2D,
    first_body:int,
    second_body:int,
    cache_index:int,
    cache:ContactPair2D
) CompactCircleCollision2D? {
    let offset_x = store.positions_x[second_body] -
        store.positions_x[first_body]
    let offset_y = store.positions_y[second_body] -
        store.positions_y[first_body]
    let distance_squared = offset_x * offset_x + offset_y * offset_y
    let combined_radius = store.radii[first_body] + store.radii[second_body]
    let speculative_radius = combined_radius + 0.02
    if distance_squared > speculative_radius * speculative_radius { return null }

    var distance = 0.0
    if distance_squared > 0.000000000001 {
        distance = Math.sqrt(distance_squared)
    }
    var separation_normal = circle_contact_normal(
        store,
        first_body,
        second_body,
        offset_x,
        offset_y,
        distance,
        combined_radius
    )
    if distance <= combined_radius * 0.2 && cache.contact_count == 1 &&
        cache.normal.dot(cache.normal) > 0.5
    {
        separation_normal = cache.normal
        if offset_x * separation_normal.x +
            offset_y * separation_normal.y < 0.0
        {
            separation_normal = separation_normal.negated()
        }
    }
    let normal_x = separation_normal.x
    let normal_y = separation_normal.y
    let normal = Math.Vec2(normal_x, normal_y)
    let contact = Math.Vec2(
        (store.positions_x[first_body] + normal_x * store.radii[first_body] +
            store.positions_x[second_body] -
            normal_x * store.radii[second_body]) * 0.5,
        (store.positions_y[first_body] + normal_y * store.radii[first_body] +
            store.positions_y[second_body] -
            normal_y * store.radii[second_body]) * 0.5
    )

    var normal_impulse = 0.0
    var tangent_impulse = 0.0
    let local_x = contact.x - store.positions_x[first_body]
    let local_y = contact.y - store.positions_y[first_body]
    let delta_x = cache.first_contact.x - local_x
    let delta_y = cache.first_contact.y - local_y
    let cache_distance_limit = combined_radius * 0.1
    if cache.contact_count == 1 &&
        cache.first_awake == store.awake[first_body] &&
        cache.second_awake == store.awake[second_body] &&
        cache.normal.x * normal_x + cache.normal.y * normal_y > 0.995 &&
        delta_x * delta_x + delta_y * delta_y <=
            cache_distance_limit * cache_distance_limit
    {
        normal_impulse = cache.normal_impulse_first
        tangent_impulse = cache.tangent_impulse_first
    }

    let first_inverse_mass = store.inverse_masses[first_body]
    let second_inverse_mass = store.inverse_masses[second_body]
    let inverse_mass = first_inverse_mass + second_inverse_mass
    let tangent_x = -normal_y
    let tangent_y = normal_x
    let first_radius_x = contact.x - store.positions_x[first_body]
    let first_radius_y = contact.y - store.positions_y[first_body]
    let second_radius_x = contact.x - store.positions_x[second_body]
    let second_radius_y = contact.y - store.positions_y[second_body]
    let first_tangent_arm =
        first_radius_x * tangent_y - first_radius_y * tangent_x
    let second_tangent_arm =
        second_radius_x * tangent_y - second_radius_y * tangent_x
    let tangent_denominator = inverse_mass +
        first_tangent_arm * first_tangent_arm *
            store.inverse_inertias[first_body] +
        second_tangent_arm * second_tangent_arm *
            store.inverse_inertias[second_body]
    let relative_normal_velocity =
        (store.velocities_x[second_body] -
            store.velocities_x[first_body]) * normal_x +
        (store.velocities_y[second_body] -
            store.velocities_y[first_body]) * normal_y
    return CompactCircleCollision2D(
        first_body:first_body,
        second_body:second_body,
        normal:normal,
        first_contact:Math.Vec2(local_x, local_y),
        cache_index:cache_index,
        normal_impulse:normal_impulse,
        tangent_impulse:tangent_impulse,
        normal_mass:1.0 / inverse_mass,
        tangent_mass:1.0 / tangent_denominator,
        first_tangent_arm:first_tangent_arm,
        second_tangent_arm:second_tangent_arm,
        base_separation:distance - combined_radius,
        initial_normal_offset:offset_x * normal_x + offset_y * normal_y,
        initial_normal_velocity:relative_normal_velocity,
        restitution:Math.min(
            store.restitutions[first_body],
            store.restitutions[second_body]
        ),
        combined_friction:store.friction_roots[first_body] *
            store.friction_roots[second_body]
    )
}

func build_circle_box_collision(
    store:BodyStore2D,
    circle_body:int,
    box_body:int,
    circle_is_first:bool,
    cache_index:int,
    cache:ContactPair2D,
    wake_contacts:bool = true
) Collision2D? {
    let inverse_mass = store.inverse_masses[circle_body] +
        store.inverse_masses[box_body]
    if inverse_mass <= 0.0 { return null }

    let circle_position = body_position(store, circle_body)
    let box_position = body_position(store, box_body)
    let offset_x = circle_position.x - box_position.x
    let offset_y = circle_position.y - box_position.y
    let cosine = store.rotation_cosines[box_body]
    let sine = store.rotation_sines[box_body]
    let local_x = offset_x * cosine + offset_y * sine
    let local_y = offset_y * cosine - offset_x * sine
    var closest_x = Math.max(
        -store.half_widths[box_body],
        Math.min(local_x, store.half_widths[box_body])
    )
    var closest_y = Math.max(
        -store.half_heights[box_body],
        Math.min(local_y, store.half_heights[box_body])
    )
    let delta_x = local_x - closest_x
    let delta_y = local_y - closest_y
    let distance_squared = delta_x * delta_x + delta_y * delta_y
    let radius = store.radii[circle_body]
    let speculative_radius = radius + 0.02
    if distance_squared > speculative_radius * speculative_radius { return null }

    var normal_local_x = 0.0
    var normal_local_y = 0.0
    var penetration = 0.0
    var circle_surface_direction = -1.0
    if distance_squared > 0.000000000001 {
        let distance = Math.sqrt(distance_squared)
        normal_local_x = delta_x / distance
        normal_local_y = delta_y / distance
        penetration = radius - distance
    } else {
        circle_surface_direction = 1.0
        var retained_face = false
        if cache.contact_count == 1 {
            var cached_x:float = cache.normal.x + 0.0
            var cached_y:float = cache.normal.y + 0.0
            if circle_is_first {
                cached_x = -cached_x
                cached_y = -cached_y
            }
            let cached_local_x = cached_x * cosine + cached_y * sine
            let cached_local_y = cached_y * cosine - cached_x * sine
            if Math.abs(cached_local_x) > Math.abs(cached_local_y) {
                normal_local_x = 1.0
                if cached_local_x < 0.0 { normal_local_x = -1.0 }
            } else {
                normal_local_y = 1.0
                if cached_local_y < 0.0 { normal_local_y = -1.0 }
            }
            retained_face = true
        } else {
            let previous_offset_x =
                store.previous_positions_x[circle_body] - box_position.x
            let previous_offset_y =
                store.previous_positions_y[circle_body] - box_position.y
            let previous_local_x =
                previous_offset_x * cosine + previous_offset_y * sine
            let previous_local_y =
                previous_offset_y * cosine - previous_offset_x * sine
            let outside_x = Math.abs(previous_local_x) -
                store.half_widths[box_body]
            let outside_y = Math.abs(previous_local_y) -
                store.half_heights[box_body]
            if outside_x > 0.0 || outside_y > 0.0 {
                if outside_x > outside_y {
                    normal_local_x = 1.0
                    if previous_local_x < 0.0 { normal_local_x = -1.0 }
                } else {
                    normal_local_y = 1.0
                    if previous_local_y < 0.0 { normal_local_y = -1.0 }
                }
                retained_face = true
            }
        }
        if !retained_face {
            let distance_x = store.half_widths[box_body] - Math.abs(local_x)
            let distance_y = store.half_heights[box_body] - Math.abs(local_y)
            if distance_x < distance_y {
                normal_local_x = 1.0
                if local_x < 0.0 { normal_local_x = -1.0 }
            } else {
                normal_local_y = 1.0
                if local_y < 0.0 { normal_local_y = -1.0 }
            }
        }
        if normal_local_x != 0.0 {
            closest_x = normal_local_x * store.half_widths[box_body]
            closest_y = local_y
            penetration = radius + store.half_widths[box_body] -
                normal_local_x * local_x
        } else {
            closest_x = local_x
            closest_y = normal_local_y * store.half_heights[box_body]
            penetration = radius + store.half_heights[box_body] -
                normal_local_y * local_y
        }
    }

    let box_to_circle = Math.Vec2(
        cosine * normal_local_x - sine * normal_local_y,
        sine * normal_local_x + cosine * normal_local_y
    )
    let box_surface = Math.Vec2(
        box_position.x + cosine * closest_x - sine * closest_y,
        box_position.y + sine * closest_x + cosine * closest_y
    )
    let circle_surface = circle_position.add(
        box_to_circle.multiply(radius * circle_surface_direction)
    )
    let contact = box_surface.add(circle_surface).multiply(0.5)
    var first_body = box_body
    var second_body = circle_body
    var normal = box_to_circle
    if circle_is_first {
        first_body = circle_body
        second_body = box_body
        normal = box_to_circle.negated()
    }
    if wake_contacts {
        wake_for_contact(
            store,
            first_body,
            second_body,
            normal,
            contact,
            penetration
        )
    }
    var collision = Collision2D(
        store,
        first_body,
        second_body,
        normal,
        ContactPoints2D(contact),
        -penetration,
        cache_index,
        cache
    )
    prepare_collision_constraints(store, collision)
    return collision
}

struct ContactPoints2D {
    let first:Math.Vec2
    let second:Math.Vec2
    let first_separation:float
    let second_separation:float
    let count:int

    init() {
        self.first = Math.Vec2()
        self.second = Math.Vec2()
        self.first_separation = 0.0
        self.second_separation = 0.0
        self.count = 0
    }

    init(first:Math.Vec2) {
        self.first = first
        self.second = first
        self.first_separation = 0.0
        self.second_separation = 0.0
        self.count = 1
    }

    init(first:Math.Vec2, second:Math.Vec2) {
        self.first = first
        self.second = second
        self.first_separation = 0.0
        self.second_separation = 0.0
        self.count = 2
    }

    init(first:Math.Vec2, second:float) {
        self.first = first
        self.second = first
        self.first_separation = second
        self.second_separation = second
        self.count = 1
    }

    init(
        first:Math.Vec2,
        second:float,
        third:Math.Vec2,
        fourth:float
    ) {
        self.first = first
        self.second = third
        self.first_separation = second
        self.second_separation = fourth
        self.count = 2
    }
}

struct Collision2D {
    let first_body:int
    let second_body:int
    let normal:Math.Vec2
    let contacts:ContactPoints2D
    let cache_index:int
    var first_anchor_rotates:bool
    var second_anchor_rotates:bool
    var normal_impulse_first:float
    var normal_impulse_second:float
    var tangent_impulse_first:float
    var tangent_impulse_second:float
    var normal_mass_first:float
    var normal_mass_second:float
    var tangent_mass_first:float
    var tangent_mass_second:float
    var normal_denominator_first:float
    var normal_denominator_second:float
    var first_anchor_a:Math.Vec2
    var first_anchor_b:Math.Vec2
    var second_anchor_a:Math.Vec2
    var second_anchor_b:Math.Vec2
    var base_separation_first:float
    var base_separation_second:float
    var initial_normal_velocity_first:float
    var initial_normal_velocity_second:float
    var restitution:float
    var total_normal_impulse_first:float
    var total_normal_impulse_second:float
    var normal_coupling:float
    var normal_determinant:float
    var combined_friction:float
    var rolling_resistance:float
    var tangent_speed:float
    var rolling_mass:float
    var rolling_impulse:float

    init() {
        self.first_body = 0
        self.second_body = 0
        self.normal = Math.Vec2()
        self.contacts = ContactPoints2D()
        self.cache_index = 0
        self.first_anchor_rotates = false
        self.second_anchor_rotates = false
        self.normal_impulse_first = 0.0
        self.normal_impulse_second = 0.0
        self.tangent_impulse_first = 0.0
        self.tangent_impulse_second = 0.0
        self.normal_mass_first = 0.0
        self.normal_mass_second = 0.0
        self.tangent_mass_first = 0.0
        self.tangent_mass_second = 0.0
        self.normal_denominator_first = 0.0
        self.normal_denominator_second = 0.0
        self.first_anchor_a = Math.Vec2()
        self.first_anchor_b = Math.Vec2()
        self.second_anchor_a = Math.Vec2()
        self.second_anchor_b = Math.Vec2()
        self.base_separation_first = 0.0
        self.base_separation_second = 0.0
        self.initial_normal_velocity_first = 0.0
        self.initial_normal_velocity_second = 0.0
        self.restitution = 0.0
        self.total_normal_impulse_first = 0.0
        self.total_normal_impulse_second = 0.0
        self.normal_coupling = 0.0
        self.normal_determinant = 0.0
        self.combined_friction = 0.0
        self.rolling_resistance = 0.0
        self.tangent_speed = 0.0
        self.rolling_mass = 0.0
        self.rolling_impulse = 0.0
    }

    init(
        store:BodyStore2D,
        first_body:int,
        second_body:int,
        normal:Math.Vec2,
        contacts:ContactPoints2D,
        separation:float,
        cache_index:int,
        cache:ContactPair2D
    ) {
        self.first_body = first_body
        self.second_body = second_body
        self.normal = normal
        self.contacts = contacts
        self.cache_index = cache_index
        self.first_anchor_rotates = store.shape_kinds[first_body] != 1
        self.second_anchor_rotates = store.shape_kinds[second_body] != 1
        let first_local_contact = body_contact_cache_point(
            store,
            first_body,
            contacts.first
        )
        let second_local_contact = body_contact_cache_point(
            store,
            first_body,
            contacts.second
        )
        let first_contact_delta = cache.first_contact.subtract(
            first_local_contact
        )
        let second_contact_delta = cache.second_contact.subtract(
            second_local_contact
        )
        let contact_threshold_squared = 0.0004
        if cache.contact_count == contacts.count &&
            cache.first_awake == store.awake[first_body] &&
            cache.second_awake == store.awake[second_body] &&
            cache.normal.dot(normal) > 0.98 &&
            first_contact_delta.dot(first_contact_delta) <= contact_threshold_squared &&
            (contacts.count == 1 ||
                second_contact_delta.dot(second_contact_delta) <=
                    contact_threshold_squared)
        {
            self.normal_impulse_first = cache.normal_impulse_first
            self.normal_impulse_second = cache.normal_impulse_second
            self.tangent_impulse_first = cache.tangent_impulse_first
            self.tangent_impulse_second = cache.tangent_impulse_second
            self.rolling_impulse = cache.rolling_impulse
        } else {
            self.normal_impulse_first = 0.0
            self.normal_impulse_second = 0.0
            self.tangent_impulse_first = 0.0
            self.tangent_impulse_second = 0.0
            self.rolling_impulse = 0.0
        }
        self.normal_mass_first = 0.0
        self.normal_mass_second = 0.0
        self.tangent_mass_first = 0.0
        self.tangent_mass_second = 0.0
        self.normal_denominator_first = 0.0
        self.normal_denominator_second = 0.0
        self.first_anchor_a = soft_step_contact_anchor(
            store,
            first_body,
            contacts.first,
            self.first_anchor_rotates
        )
        self.first_anchor_b = soft_step_contact_anchor(
            store,
            second_body,
            contacts.first,
            self.second_anchor_rotates
        )
        self.second_anchor_a = soft_step_contact_anchor(
            store,
            first_body,
            contacts.second,
            self.first_anchor_rotates
        )
        self.second_anchor_b = soft_step_contact_anchor(
            store,
            second_body,
            contacts.second,
            self.second_anchor_rotates
        )
        self.base_separation_first = separation
        self.base_separation_second = separation
        self.initial_normal_velocity_first = 0.0
        self.initial_normal_velocity_second = 0.0
        self.restitution = Math.min(
            store.restitutions[first_body],
            store.restitutions[second_body]
        )
        self.total_normal_impulse_first = 0.0
        self.total_normal_impulse_second = 0.0
        self.normal_coupling = 0.0
        self.normal_determinant = 0.0
        self.combined_friction = 0.0
        self.rolling_resistance = 0.0
        self.tangent_speed = 0.0
        self.rolling_mass = 0.0
    }

    init(
        store:BodyStore2D,
        first_body:int,
        second_body:int,
        normal:Math.Vec2,
        contacts:ContactPoints2D,
        separation:float,
        cache_index:int,
        cache:ContactPair2D,
        circle_contact:bool
    ) {
        self.first_body = first_body
        self.second_body = second_body
        self.normal = normal
        self.contacts = contacts
        self.cache_index = cache_index
        self.first_anchor_rotates = store.shape_kinds[first_body] != 1
        self.second_anchor_rotates = store.shape_kinds[second_body] != 1
        let local_x = contacts.first.x - store.positions_x[first_body]
        let local_y = contacts.first.y - store.positions_y[first_body]
        let delta_x = cache.first_contact.x - local_x
        let delta_y = cache.first_contact.y - local_y
        if cache.contact_count == 1 &&
            cache.first_awake == store.awake[first_body] &&
            cache.second_awake == store.awake[second_body] &&
            cache.normal.x * normal.x + cache.normal.y * normal.y > 0.98 &&
            delta_x * delta_x + delta_y * delta_y <= 0.0004
        {
            self.normal_impulse_first = cache.normal_impulse_first
            self.tangent_impulse_first = cache.tangent_impulse_first
            self.rolling_impulse = cache.rolling_impulse
        } else {
            self.normal_impulse_first = 0.0
            self.tangent_impulse_first = 0.0
            self.rolling_impulse = 0.0
        }
        self.normal_impulse_second = 0.0
        self.tangent_impulse_second = 0.0
        self.normal_mass_first = 0.0
        self.normal_mass_second = 0.0
        self.tangent_mass_first = 0.0
        self.tangent_mass_second = 0.0
        self.normal_denominator_first = 0.0
        self.normal_denominator_second = 0.0
        self.first_anchor_a = soft_step_contact_anchor(
            store,
            first_body,
            contacts.first,
            self.first_anchor_rotates
        )
        self.first_anchor_b = soft_step_contact_anchor(
            store,
            second_body,
            contacts.first,
            self.second_anchor_rotates
        )
        self.second_anchor_a = self.first_anchor_a
        self.second_anchor_b = self.first_anchor_b
        self.base_separation_first = separation
        self.base_separation_second = separation
        self.initial_normal_velocity_first = 0.0
        self.initial_normal_velocity_second = 0.0
        self.restitution = Math.min(
            store.restitutions[first_body],
            store.restitutions[second_body]
        )
        self.total_normal_impulse_first = 0.0
        self.total_normal_impulse_second = 0.0
        self.normal_coupling = 0.0
        self.normal_determinant = 0.0
        self.combined_friction = 0.0
        self.rolling_resistance = 0.0
        self.tangent_speed = 0.0
        self.rolling_mass = 0.0
    }
}

struct ContactSoftness2D {
    let bias_rate:float
    let mass_scale:float
    let impulse_scale:float
    let maximum_correction_speed:float

    init(
        bias_rate:float,
        mass_scale:float,
        impulse_scale:float,
        maximum_correction_speed:float
    ) {
        self.bias_rate = bias_rate
        self.mass_scale = mass_scale
        self.impulse_scale = impulse_scale
        self.maximum_correction_speed = maximum_correction_speed
    }
}

struct BeginSoftStepBodies2D:Threading.ParallelJob {
    var store:BodyStore2D
    var active_bodies:ActiveBodySet2D

    func execute(start:int, end:int) {
        var store = self.store
        var active_bodies = self.active_bodies
        var item = start
        while item < end {
            begin_soft_step_motion(
                store,
                active_bodies.body_at(item)
            )
            item++
        }
    }
}

struct IntegrateSoftStepVelocities2D:Threading.ParallelJob {
    var store:BodyStore2D
    var active_bodies:ActiveBodySet2D
    var gravity:Math.Vec2
    var delta:float
    var maximum_linear_speed:float

    func execute(start:int, end:int) {
        var store = self.store
        var active_bodies = self.active_bodies
        let gravity = self.gravity
        let delta = self.delta
        var item = start
        while item < end {
            integrate_body_velocity(
                store,
                gravity,
                active_bodies.body_at(item),
                delta,
                self.maximum_linear_speed
            )
            item++
        }
    }
}

struct IntegrateSoftStepPositions2D:Threading.ParallelJob {
    var store:BodyStore2D
    var active_bodies:ActiveBodySet2D
    var delta:float

    func execute(start:int, end:int) {
        var store = self.store
        var active_bodies = self.active_bodies
        let delta = self.delta
        var item = start
        while item < end {
            integrate_body_position(
                store,
                active_bodies.body_at(item),
                delta
            )
            item++
        }
    }
}

struct WarmStartSoftConstraints2D:Threading.ParallelJob {
    var store:BodyStore2D
    var state:SoftStepConstraintState2D
    var offset:int
    var count:int
    var reverse:bool

    func execute(start:int, end:int) {
        var store = self.store
        var state = self.state
        let offset = self.offset
        let count = self.count
        let reverse = self.reverse
        var item = start
        while item < end {
            var source = offset + item
            if reverse {
                source = offset + count - item - 1
            }
            let entry = state.colored_entries[source]
            if entry >= 0 {
                let collision = state.compact_collisions[entry]
                let impulses = state.compact_impulses[entry]
                warm_start_compact_circle_collision(
                    store,
                    collision,
                    impulses
                )
            } else {
                let collision = state.collisions[-entry - 1]
                warm_start_soft_collision(
                    store,
                    collision
                )
            }
            item++
        }
    }
}

struct SolveSoftConstraints2D:Threading.ParallelJob {
    var store:BodyStore2D
    var state:SoftStepConstraintState2D
    var offset:int
    var count:int
    var reverse:bool
    var contact_softness:ContactSoftness2D
    var static_softness:ContactSoftness2D
    var inverse_delta:float
    var use_bias:bool
    var solve_friction:bool

    func execute(start:int, end:int) {
        var store = self.store
        var state = self.state
        let body_count = store.count()
        let compact_count = state.compact_impulses.count()
        solve_soft_constraint_range(
            store,
            state,
            &store.velocities_x[0:body_count],
            &store.velocities_y[0:body_count],
            &store.angular_velocities[0:body_count],
            &state.compact_impulses[0:compact_count],
            self.offset,
            self.count,
            self.reverse,
            self.contact_softness,
            self.static_softness,
            self.inverse_delta,
            self.use_bias,
            self.solve_friction,
            start,
            end
        )
    }
}

func solve_soft_constraint_range(
    store:BodyStore2D,
    state:SoftStepConstraintState2D,
    velocities_x:&float[..],
    velocities_y:&float[..],
    angular_velocities:&float[..],
    compact_impulses:&CompactCircleImpulses2D[..],
    offset:int,
    count:int,
    reverse:bool,
    contact_softness:ContactSoftness2D,
    static_softness:ContactSoftness2D,
    inverse_delta:float,
    use_bias:bool,
    solve_friction:bool,
    start:int,
    end:int
) {
    var item = start
    while item < end {
            if item + 4 <= end {
                var source_first = offset + item
                var source_second = source_first + 1
                var source_third = source_first + 2
                var source_fourth = source_first + 3
                if reverse {
                    source_first = offset + count - item - 1
                    source_second = source_first - 1
                    source_third = source_first - 2
                    source_fourth = source_first - 3
                }
                let entry_first = state.colored_entries[source_first]
                let entry_second = state.colored_entries[source_second]
                let entry_third = state.colored_entries[source_third]
                let entry_fourth = state.colored_entries[source_fourth]
                if entry_first >= 0 && entry_second >= 0 &&
                    entry_third >= 0 && entry_fourth >= 0
                {
                    let first_collision =
                        state.compact_collisions[entry_first]
                    let second_collision =
                        state.compact_collisions[entry_second]
                    let third_collision =
                        state.compact_collisions[entry_third]
                    let fourth_collision =
                        state.compact_collisions[entry_fourth]
                    var first_impulses =
                        compact_impulses[entry_first]
                    var second_impulses =
                        compact_impulses[entry_second]
                    var third_impulses =
                        compact_impulses[entry_third]
                    var fourth_impulses =
                        compact_impulses[entry_fourth]
                    solve_soft_compact_circle_four_normals(
                        store,
                        velocities_x,
                        velocities_y,
                        first_collision,
                        second_collision,
                        third_collision,
                        fourth_collision,
                        first_impulses,
                        second_impulses,
                        third_impulses,
                        fourth_impulses,
                        contact_softness,
                        inverse_delta,
                        use_bias
                    )
                    if solve_friction {
                        solve_soft_compact_circle_friction(
                            store,
                            velocities_x,
                            velocities_y,
                            angular_velocities,
                            first_collision,
                            first_impulses
                        )
                        solve_soft_compact_circle_friction(
                            store,
                            velocities_x,
                            velocities_y,
                            angular_velocities,
                            second_collision,
                            second_impulses
                        )
                        solve_soft_compact_circle_friction(
                            store,
                            velocities_x,
                            velocities_y,
                            angular_velocities,
                            third_collision,
                            third_impulses
                        )
                        solve_soft_compact_circle_friction(
                            store,
                            velocities_x,
                            velocities_y,
                            angular_velocities,
                            fourth_collision,
                            fourth_impulses
                        )
                    }
                    compact_impulses[entry_first] = first_impulses
                    compact_impulses[entry_second] = second_impulses
                    compact_impulses[entry_third] = third_impulses
                    compact_impulses[entry_fourth] = fourth_impulses
                    item += 4
                    continue
                }
            }
            var source = offset + item
            if reverse {
                source = offset + count - item - 1
            }
            let entry = state.colored_entries[source]
            if entry >= 0 {
                let collision = state.compact_collisions[entry]
                var impulses = compact_impulses[entry]
                solve_soft_compact_circle(
                    store,
                    velocities_x,
                    velocities_y,
                    collision,
                    impulses,
                    contact_softness,
                    inverse_delta,
                    use_bias
                )
                if solve_friction {
                    solve_soft_compact_circle_friction(
                        store,
                        velocities_x,
                        velocities_y,
                        angular_velocities,
                        collision,
                        impulses
                    )
                }
                compact_impulses[entry] = impulses
            } else {
                var collision = state.collisions[-entry - 1]
                var softness = contact_softness
                let first = collision.first_body
                let second = collision.second_body
                if !store.awake[first] || !store.awake[second] ||
                    store.inverse_masses[first] <= 0.0 ||
                    store.inverse_masses[second] <= 0.0
                {
                    softness = static_softness
                }
                solve_soft_collision(
                    store,
                    collision,
                    softness,
                    inverse_delta,
                    use_bias,
                    false,
                    solve_friction
                )
                state.collisions[-entry - 1] = collision
            }
        item++
    }
}

struct RestitutionSoftConstraints2D:Threading.ParallelJob {
    var store:BodyStore2D
    var state:SoftStepConstraintState2D
    var offset:int
    var threshold:float

    func execute(start:int, end:int) {
        var store = self.store
        var state = self.state
        let offset = self.offset
        var item = start
        while item < end {
            let entry = state.colored_entries[offset + item]
            if entry >= 0 {
                let collision = state.compact_collisions[entry]
                var impulses = state.compact_impulses[entry]
                apply_soft_compact_restitution(
                    store,
                    collision,
                    impulses,
                    self.threshold
                )
                state.compact_impulses[entry] = impulses
            } else {
                var collision = state.collisions[-entry - 1]
                apply_soft_collision_restitution(
                    store,
                    collision,
                    self.threshold
                )
                state.collisions[-entry - 1] = collision
            }
            item++
        }
    }
}

func make_contact_softness(
    requested_hertz:float,
    damping_ratio:float,
    delta:float,
    inverse_delta:float,
    maximum_correction_speed:float
) ContactSoftness2D {
    let hertz = requested_hertz
    if hertz <= 0.0 {
        return ContactSoftness2D(
            0.0,
            0.0,
            0.0,
            maximum_correction_speed
        )
    }
    let omega = 2.0 * Math.pi() * hertz
    let a1 = 2.0 * damping_ratio + delta * omega
    let a2 = delta * omega * a1
    let a3 = 1.0 / (1.0 + a2)
    return ContactSoftness2D(
        omega / a1,
        a2 * a3,
        a3,
        maximum_correction_speed
    )
}

func build_box_collision(
    store:BodyStore2D,
    first_body:int,
    second_body:int,
    cache_index:int,
    cache:ContactPair2D,
    wake_contacts:bool = true
) Collision2D? {
    let inverse_mass = store.inverse_masses[first_body] +
        store.inverse_masses[second_body]
    if inverse_mass <= 0.0 { return null }

    let offset = body_position(store, second_body).subtract(
        body_position(store, first_body)
    )
    var normal = body_axis_x(store, first_body)
    var penetration = overlap_on_axis(store, first_body, second_body, offset, normal)
    if penetration < -0.02 { return null }

    let first_y = body_axis_y(store, first_body)
    let first_y_overlap = overlap_on_axis(
        store,
        first_body,
        second_body,
        offset,
        first_y
    )
    if first_y_overlap < -0.02 { return null }
    if first_y_overlap < penetration {
        normal = first_y
        penetration = first_y_overlap
    }

    let second_x = body_axis_x(store, second_body)
    let second_x_overlap = overlap_on_axis(
        store,
        first_body,
        second_body,
        offset,
        second_x
    )
    if second_x_overlap < -0.02 { return null }
    if second_x_overlap < penetration {
        normal = second_x
        penetration = second_x_overlap
    }

    let second_y = body_axis_y(store, second_body)
    let second_y_overlap = overlap_on_axis(
        store,
        first_body,
        second_body,
        offset,
        second_y
    )
    if second_y_overlap < -0.02 { return null }
    if second_y_overlap < penetration {
        normal = second_y
        penetration = second_y_overlap
    }

    if offset.dot(normal) < 0.0 { normal = normal.negated() }
    let contacts = contact_points(store, first_body, second_body, normal)
    if wake_contacts {
        wake_for_contact(
            store,
            first_body,
            second_body,
            normal,
            contacts.first,
            penetration
        )
    }
    var collision = Collision2D(
        store,
        first_body,
        second_body,
        normal,
        contacts,
        -penetration,
        cache_index,
        cache
    )
    collision.base_separation_first = contacts.first_separation
    collision.base_separation_second = contacts.second_separation
    prepare_collision_constraints(store, collision)
    return collision
}

func prepare_collision_constraints(
    store:BodyStore2D,
    collision:&Collision2D
) {
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    let normal = Math.Vec2(collision.normal.x, collision.normal.y)
    let tangent = Math.Vec2(-normal.y, normal.x)
    let first_inverse_mass = solver_inverse_mass(store, first)
    let second_inverse_mass = solver_inverse_mass(store, second)
    let first_inverse_inertia = solver_inverse_inertia(store, first)
    let second_inverse_inertia = solver_inverse_inertia(store, second)
    let inverse_mass = first_inverse_mass + second_inverse_mass
    let first_position = store.world_center_at(first)
    let second_position = store.world_center_at(second)
    let first_contact = Math.Vec2(
        collision.contacts.first.x,
        collision.contacts.first.y
    )
    let first_radius = first_contact.subtract(first_position)
    let second_radius = first_contact.subtract(second_position)
    let first_normal_arm = cross(first_radius, normal)
    let second_normal_arm = cross(second_radius, normal)
    let first_tangent_arm = cross(first_radius, tangent)
    let second_tangent_arm = cross(second_radius, tangent)
    let normal_denominator = inverse_mass +
        first_normal_arm * first_normal_arm * first_inverse_inertia +
        second_normal_arm * second_normal_arm * second_inverse_inertia
    let tangent_denominator = inverse_mass +
        first_tangent_arm * first_tangent_arm * first_inverse_inertia +
        second_tangent_arm * second_tangent_arm * second_inverse_inertia
    collision.normal_denominator_first = normal_denominator
    collision.normal_mass_first = 1.0 / normal_denominator
    collision.tangent_mass_first = 1.0 / tangent_denominator
    collision.combined_friction = store.friction_roots[first] *
        store.friction_roots[second]
    let rolling_denominator = first_inverse_inertia + second_inverse_inertia
    if rolling_denominator > 0.0 {
        collision.rolling_mass = 1.0 / rolling_denominator
    }
    let first_normal_velocity = velocity_at(
        store,
        second,
        first_contact
    ).subtract(velocity_at(store, first, first_contact)).dot(normal)
    collision.initial_normal_velocity_first = first_normal_velocity

    if collision.contacts.count == 2 {
        let contact = Math.Vec2(
            collision.contacts.second.x,
            collision.contacts.second.y
        )
        let first_second_radius = contact.subtract(first_position)
        let second_second_radius = contact.subtract(second_position)
        let first_second_normal_arm = cross(first_second_radius, normal)
        let second_second_normal_arm = cross(second_second_radius, normal)
        let first_second_tangent_arm = cross(first_second_radius, tangent)
        let second_second_tangent_arm = cross(second_second_radius, tangent)
        let second_normal_denominator = inverse_mass +
            first_second_normal_arm * first_second_normal_arm *
                first_inverse_inertia +
            second_second_normal_arm * second_second_normal_arm *
                second_inverse_inertia
        let second_tangent_denominator = inverse_mass +
            first_second_tangent_arm * first_second_tangent_arm *
                first_inverse_inertia +
            second_second_tangent_arm * second_second_tangent_arm *
                second_inverse_inertia
        collision.normal_denominator_second = second_normal_denominator
        collision.normal_mass_second = 1.0 / second_normal_denominator
        collision.tangent_mass_second = 1.0 / second_tangent_denominator
        let coupling = inverse_mass +
            first_normal_arm * first_second_normal_arm *
                first_inverse_inertia +
            second_normal_arm * second_second_normal_arm *
                second_inverse_inertia
        collision.normal_coupling = coupling
        collision.normal_determinant =
            normal_denominator * second_normal_denominator -
            coupling * coupling
        let second_normal_velocity = velocity_at(
            store,
            second,
            contact
        ).subtract(velocity_at(store, first, contact)).dot(normal)
        collision.initial_normal_velocity_second = second_normal_velocity
    }
}

func prepare_circle_collision_constraints(
    store:BodyStore2D,
    collision:&Collision2D
) {
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    let normal_x:float = collision.normal.x + 0.0
    let normal_y:float = collision.normal.y + 0.0
    let tangent_x = -normal_y
    let tangent_y = normal_x
    let contact_x:float = collision.contacts.first.x + 0.0
    let contact_y:float = collision.contacts.first.y + 0.0
    let first_center = store.world_center_at(first)
    let second_center = store.world_center_at(second)
    let first_radius_x = contact_x - first_center.x
    let first_radius_y = contact_y - first_center.y
    let second_radius_x = contact_x - second_center.x
    let second_radius_y = contact_y - second_center.y
    let first_inverse_mass = solver_inverse_mass(store, first)
    let second_inverse_mass = solver_inverse_mass(store, second)
    let inverse_mass = first_inverse_mass + second_inverse_mass
    let first_normal_arm =
        first_radius_x * normal_y - first_radius_y * normal_x
    let second_normal_arm =
        second_radius_x * normal_y - second_radius_y * normal_x
    let first_tangent_arm =
        first_radius_x * tangent_y - first_radius_y * tangent_x
    let second_tangent_arm =
        second_radius_x * tangent_y - second_radius_y * tangent_x
    let tangent_denominator = inverse_mass +
        first_tangent_arm * first_tangent_arm *
            solver_inverse_inertia(store, first) +
        second_tangent_arm * second_tangent_arm *
            solver_inverse_inertia(store, second)
    let normal_denominator = inverse_mass +
        first_normal_arm * first_normal_arm *
            solver_inverse_inertia(store, first) +
        second_normal_arm * second_normal_arm *
            solver_inverse_inertia(store, second)
    collision.normal_denominator_first = normal_denominator
    collision.normal_mass_first = 1.0 / normal_denominator
    collision.tangent_mass_first = 1.0 / tangent_denominator
    collision.combined_friction = store.friction_roots[first] *
        store.friction_roots[second]
    let rolling_denominator = solver_inverse_inertia(store, first) +
        solver_inverse_inertia(store, second)
    if rolling_denominator > 0.0 {
        collision.rolling_mass = 1.0 / rolling_denominator
    }
    let relative_normal_velocity = velocity_at(
        store,
        second,
        Math.Vec2(contact_x, contact_y)
    ).subtract(velocity_at(
        store,
        first,
        Math.Vec2(contact_x, contact_y)
    )).dot(Math.Vec2(normal_x, normal_y))
    collision.initial_normal_velocity_first = relative_normal_velocity
}

func contact_anchor_vector(
    store:BodyStore2D,
    body:int,
    local_point:Math.Vec2,
    rotates:bool
) Math.Vec2 {
    if !rotates { return local_point }
    let cosine = store.rotation_cosines[body]
    let sine = store.rotation_sines[body]
    return Math.Vec2(
        local_point.x * cosine - local_point.y * sine,
        local_point.x * sine + local_point.y * cosine
    )
}

func soft_step_contact_anchor(
    store:BodyStore2D,
    body:int,
    point:Math.Vec2,
    rotates:bool
) Math.Vec2 {
    if !rotates {
        return point.subtract(store.world_center_at(body))
    }
    return body_contact_cache_point(store, body, point)
}

func apply_soft_contact_impulse(
    store:BodyStore2D,
    first:int,
    second:int,
    first_anchor:Math.Vec2,
    second_anchor:Math.Vec2,
    impulse:Math.Vec2
) {
    var first_inverse_mass = 0.0
    var first_inverse_inertia = 0.0
    if store.awake[first] {
        first_inverse_mass = store.inverse_masses[first]
        first_inverse_inertia = store.inverse_inertias[first]
    }
    var second_inverse_mass = 0.0
    var second_inverse_inertia = 0.0
    if store.awake[second] {
        second_inverse_mass = store.inverse_masses[second]
        second_inverse_inertia = store.inverse_inertias[second]
    }
    if first_inverse_mass > 0.0 || first_inverse_inertia > 0.0 {
        store.velocities_x[first] -= impulse.x * first_inverse_mass
        store.velocities_y[first] -= impulse.y * first_inverse_mass
        store.angular_velocities[first] -= cross(first_anchor, impulse) *
            first_inverse_inertia
    }
    if second_inverse_mass > 0.0 || second_inverse_inertia > 0.0 {
        store.velocities_x[second] += impulse.x * second_inverse_mass
        store.velocities_y[second] += impulse.y * second_inverse_mass
        store.angular_velocities[second] += cross(second_anchor, impulse) *
            second_inverse_inertia
    }
}

func soft_relative_velocity(
    store:BodyStore2D,
    first:int,
    second:int,
    first_anchor:Math.Vec2,
    second_anchor:Math.Vec2
) Math.Vec2 {
    return Math.Vec2(
        store.velocities_x[second] -
            store.angular_velocities[second] * second_anchor.y -
            store.velocities_x[first] +
            store.angular_velocities[first] * first_anchor.y,
        store.velocities_y[second] +
            store.angular_velocities[second] * second_anchor.x -
            store.velocities_y[first] -
            store.angular_velocities[first] * first_anchor.x
    )
}

func soft_contact_separation(
    store:BodyStore2D,
    collision:@Collision2D,
    first_anchor:Math.Vec2,
    second_anchor:Math.Vec2,
    base_separation:float
) float {
    let center_offset = store.world_center_at(
        collision.second_body
    ).subtract(store.world_center_at(collision.first_body))
    return base_separation + center_offset.add(
        second_anchor.subtract(first_anchor)
    ).dot(collision.normal)
}

func warm_start_soft_collision(
    store:BodyStore2D,
    collision:@Collision2D
) {
    warm_start_soft_rolling(store, collision)
    if collision.contacts.count == 1 {
        warm_start_soft_single_collision(store, collision)
        return
    }
    warm_start_soft_collision_point(store, collision, false)
    if collision.contacts.count > 1 {
        warm_start_soft_collision_point(store, collision, true)
    }
}

func warm_start_soft_rolling(
    store:BodyStore2D,
    collision:@Collision2D
) {
    let impulse = collision.rolling_impulse
    if impulse == 0.0 { return }
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    if store.awake[first] {
        store.angular_velocities[first] -=
            impulse * store.inverse_inertias[first]
    }
    if store.awake[second] {
        store.angular_velocities[second] +=
            impulse * store.inverse_inertias[second]
    }
}

func warm_start_soft_single_collision(
    store:BodyStore2D,
    collision:@Collision2D
) {
    let normal_impulse = collision.normal_impulse_first
    let tangent_impulse = collision.tangent_impulse_first
    if normal_impulse == 0.0 && tangent_impulse == 0.0 { return }
    let first = collision.first_body
    let second = collision.second_body
    var first_anchor_x:float = collision.first_anchor_a.x + 0.0
    var first_anchor_y:float = collision.first_anchor_a.y + 0.0
    if collision.first_anchor_rotates {
        let cosine = store.rotation_cosines[first]
        let sine = store.rotation_sines[first]
        let local_x = first_anchor_x
        let local_y = first_anchor_y
        first_anchor_x = local_x * cosine - local_y * sine
        first_anchor_y = local_x * sine + local_y * cosine
    }
    var second_anchor_x:float = collision.first_anchor_b.x + 0.0
    var second_anchor_y:float = collision.first_anchor_b.y + 0.0
    if collision.second_anchor_rotates {
        let cosine = store.rotation_cosines[second]
        let sine = store.rotation_sines[second]
        let local_x = second_anchor_x
        let local_y = second_anchor_y
        second_anchor_x = local_x * cosine - local_y * sine
        second_anchor_y = local_x * sine + local_y * cosine
    }
    let impulse_x = collision.normal.x * normal_impulse -
        collision.normal.y * tangent_impulse
    let impulse_y = collision.normal.y * normal_impulse +
        collision.normal.x * tangent_impulse
    var first_inverse_mass = 0.0
    var first_inverse_inertia = 0.0
    if store.awake[first] {
        first_inverse_mass = store.inverse_masses[first]
        first_inverse_inertia = store.inverse_inertias[first]
    }
    var second_inverse_mass = 0.0
    var second_inverse_inertia = 0.0
    if store.awake[second] {
        second_inverse_mass = store.inverse_masses[second]
        second_inverse_inertia = store.inverse_inertias[second]
    }
    store.velocities_x[first] -= impulse_x * first_inverse_mass
    store.velocities_y[first] -= impulse_y * first_inverse_mass
    store.angular_velocities[first] -=
        (first_anchor_x * impulse_y - first_anchor_y * impulse_x) *
        first_inverse_inertia
    store.velocities_x[second] += impulse_x * second_inverse_mass
    store.velocities_y[second] += impulse_y * second_inverse_mass
    store.angular_velocities[second] +=
        (second_anchor_x * impulse_y - second_anchor_y * impulse_x) *
        second_inverse_inertia
}

func warm_start_soft_collision_point(
    store:BodyStore2D,
    collision:@Collision2D,
    second_contact:bool
) {
    var first_local = Math.Vec2(
        collision.first_anchor_a.x,
        collision.first_anchor_a.y
    )
    var second_local = Math.Vec2(
        collision.first_anchor_b.x,
        collision.first_anchor_b.y
    )
    var normal_impulse = collision.normal_impulse_first + 0.0
    var tangent_impulse = collision.tangent_impulse_first + 0.0
    if second_contact {
        first_local = Math.Vec2(
            collision.second_anchor_a.x,
            collision.second_anchor_a.y
        )
        second_local = Math.Vec2(
            collision.second_anchor_b.x,
            collision.second_anchor_b.y
        )
        normal_impulse = collision.normal_impulse_second + 0.0
        tangent_impulse = collision.tangent_impulse_second + 0.0
    }
    if normal_impulse == 0.0 && tangent_impulse == 0.0 { return }
    let first_anchor = contact_anchor_vector(
        store,
        collision.first_body,
        first_local,
        collision.first_anchor_rotates
    )
    let second_anchor = contact_anchor_vector(
        store,
        collision.second_body,
        second_local,
        collision.second_anchor_rotates
    )
    let tangent = Math.Vec2(-collision.normal.y, collision.normal.x)
    let impulse = collision.normal.multiply(normal_impulse).add(
        tangent.multiply(tangent_impulse)
    )
    apply_soft_contact_impulse(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor,
        second_anchor,
        impulse
    )
}

func solve_soft_collision(
    store:BodyStore2D,
    collision:&Collision2D,
    softness:ContactSoftness2D,
    inverse_delta:float,
    use_bias:bool,
    reverse_points:bool = false,
    solve_friction:bool = true
) {
    if collision.contacts.count == 1 {
        solve_soft_single_collision(
            store,
            collision,
            softness,
            inverse_delta,
            use_bias,
            solve_friction
        )
        return
    }
    let solved_block = collision.contacts.count > 1 &&
        solve_soft_collision_block_normals(
            store,
            collision,
            softness,
            inverse_delta,
            use_bias
        )
    if !solved_block && reverse_points && collision.contacts.count > 1 {
        solve_soft_collision_point(
            store,
            collision,
            softness,
            inverse_delta,
            use_bias,
            true
        )
    }
    if !solved_block {
        solve_soft_collision_point(
            store,
            collision,
            softness,
            inverse_delta,
            use_bias,
            false
        )
        if collision.contacts.count > 1 && !reverse_points {
            solve_soft_collision_point(
                store,
                collision,
                softness,
                inverse_delta,
                use_bias,
                true
            )
        }
    }
    if solve_friction {
        if reverse_points && collision.contacts.count > 1 {
            solve_soft_collision_friction_point(store, collision, true)
        }
        solve_soft_collision_friction_point(store, collision, false)
        if collision.contacts.count > 1 && !reverse_points {
            solve_soft_collision_friction_point(store, collision, true)
        }
        solve_soft_rolling_friction(store, collision)
    }
}

func solve_soft_single_collision(
    store:BodyStore2D,
    collision:&Collision2D,
    softness:ContactSoftness2D,
    inverse_delta:float,
    use_bias:bool,
    solve_friction:bool
) {
    // Scalar projection of the general one-point equations below. Keep its
    // bias, accumulated impulses and friction limits in exact lockstep.
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    let normal_x:float = collision.normal.x + 0.0
    let normal_y:float = collision.normal.y + 0.0
    let base_separation:float = collision.base_separation_first + 0.0
    let normal_mass:float = collision.normal_mass_first + 0.0
    let tangent_mass:float = collision.tangent_mass_first + 0.0
    let combined_friction:float = collision.combined_friction + 0.0
    let previous_normal:float = collision.normal_impulse_first + 0.0
    let previous_tangent:float = collision.tangent_impulse_first + 0.0
    var first_anchor_x:float = collision.first_anchor_a.x + 0.0
    var first_anchor_y:float = collision.first_anchor_a.y + 0.0
    if collision.first_anchor_rotates {
        let cosine = store.rotation_cosines[first]
        let sine = store.rotation_sines[first]
        let local_x = first_anchor_x
        let local_y = first_anchor_y
        first_anchor_x = local_x * cosine - local_y * sine
        first_anchor_y = local_x * sine + local_y * cosine
    }
    var second_anchor_x:float = collision.first_anchor_b.x + 0.0
    var second_anchor_y:float = collision.first_anchor_b.y + 0.0
    if collision.second_anchor_rotates {
        let cosine = store.rotation_cosines[second]
        let sine = store.rotation_sines[second]
        let local_x = second_anchor_x
        let local_y = second_anchor_y
        second_anchor_x = local_x * cosine - local_y * sine
        second_anchor_y = local_x * sine + local_y * cosine
    }
    let first_center = store.world_center_at(first)
    let second_center = store.world_center_at(second)
    let separation = base_separation +
        (second_center.x - first_center.x +
            second_anchor_x - first_anchor_x) * normal_x +
        (second_center.y - first_center.y +
            second_anchor_y - first_anchor_y) * normal_y
    var velocity_bias = 0.0
    var mass_scale = 1.0
    var impulse_scale = 0.0
    if separation > 0.0 {
        velocity_bias = separation * inverse_delta
    } else if use_bias {
        velocity_bias = Math.max(
            softness.bias_rate * separation,
            -softness.maximum_correction_speed
        )
        mass_scale = softness.mass_scale
        impulse_scale = softness.impulse_scale
    }
    var relative_x:float = store.velocities_x[second] -
        store.angular_velocities[second] * second_anchor_y -
        store.velocities_x[first] +
        store.angular_velocities[first] * first_anchor_y
    var relative_y:float = store.velocities_y[second] +
        store.angular_velocities[second] * second_anchor_x -
        store.velocities_y[first] -
        store.angular_velocities[first] * first_anchor_x
    let normal_velocity = relative_x * normal_x + relative_y * normal_y
    let increment = -normal_mass * mass_scale *
        (normal_velocity + velocity_bias) -
        impulse_scale * previous_normal
    let accumulated_normal = Math.max(previous_normal + increment, 0.0)
    let applied_normal = accumulated_normal - previous_normal
    let normal_impulse_x = normal_x * applied_normal
    let normal_impulse_y = normal_y * applied_normal
    var first_inverse_mass = 0.0
    var first_inverse_inertia = 0.0
    if store.awake[first] {
        first_inverse_mass = store.inverse_masses[first]
        first_inverse_inertia = store.inverse_inertias[first]
    }
    var second_inverse_mass = 0.0
    var second_inverse_inertia = 0.0
    if store.awake[second] {
        second_inverse_mass = store.inverse_masses[second]
        second_inverse_inertia = store.inverse_inertias[second]
    }
    store.velocities_x[first] -= normal_impulse_x * first_inverse_mass
    store.velocities_y[first] -= normal_impulse_y * first_inverse_mass
    store.angular_velocities[first] -=
        (first_anchor_x * normal_impulse_y -
            first_anchor_y * normal_impulse_x) * first_inverse_inertia
    store.velocities_x[second] += normal_impulse_x * second_inverse_mass
    store.velocities_y[second] += normal_impulse_y * second_inverse_mass
    store.angular_velocities[second] +=
        (second_anchor_x * normal_impulse_y -
            second_anchor_y * normal_impulse_x) * second_inverse_inertia
    collision.normal_impulse_first = accumulated_normal
    collision.total_normal_impulse_first += accumulated_normal
    if !solve_friction { return }

    relative_x = store.velocities_x[second] -
        store.angular_velocities[second] * second_anchor_y -
        store.velocities_x[first] +
        store.angular_velocities[first] * first_anchor_y
    relative_y = store.velocities_y[second] +
        store.angular_velocities[second] * second_anchor_x -
        store.velocities_y[first] -
        store.angular_velocities[first] * first_anchor_x
    let tangent_velocity = relative_y * normal_x - relative_x * normal_y +
        collision.tangent_speed
    let tangent_increment = -tangent_mass * tangent_velocity
    let friction_limit = combined_friction * accumulated_normal
    let accumulated_tangent = Math.max(
        -friction_limit,
        Math.min(previous_tangent + tangent_increment, friction_limit)
    )
    let applied_tangent = accumulated_tangent - previous_tangent
    let tangent_impulse_x = -normal_y * applied_tangent
    let tangent_impulse_y = normal_x * applied_tangent
    store.velocities_x[first] -= tangent_impulse_x * first_inverse_mass
    store.velocities_y[first] -= tangent_impulse_y * first_inverse_mass
    store.angular_velocities[first] -=
        (first_anchor_x * tangent_impulse_y -
            first_anchor_y * tangent_impulse_x) * first_inverse_inertia
    store.velocities_x[second] += tangent_impulse_x * second_inverse_mass
    store.velocities_y[second] += tangent_impulse_y * second_inverse_mass
    store.angular_velocities[second] +=
        (second_anchor_x * tangent_impulse_y -
            second_anchor_y * tangent_impulse_x) * second_inverse_inertia
    collision.tangent_impulse_first = accumulated_tangent
    solve_soft_rolling_friction(store, collision)
}

func solve_soft_collision_block_normals(
    store:BodyStore2D,
    collision:&Collision2D,
    softness:ContactSoftness2D,
    inverse_delta:float,
    use_bias:bool
) bool {
    let determinant:float = collision.normal_determinant + 0.0
    let first_denominator:float =
        collision.normal_denominator_first + 0.0
    let second_denominator:float =
        collision.normal_denominator_second + 0.0
    let coupling:float = collision.normal_coupling + 0.0
    if determinant <= 0.00000001 { return false }
    let first_anchor_a = contact_anchor_vector(
        store,
        collision.first_body,
        collision.first_anchor_a,
        collision.first_anchor_rotates
    )
    let first_anchor_b = contact_anchor_vector(
        store,
        collision.second_body,
        collision.first_anchor_b,
        collision.second_anchor_rotates
    )
    let second_anchor_a = contact_anchor_vector(
        store,
        collision.first_body,
        collision.second_anchor_a,
        collision.first_anchor_rotates
    )
    let second_anchor_b = contact_anchor_vector(
        store,
        collision.second_body,
        collision.second_anchor_b,
        collision.second_anchor_rotates
    )
    let first_separation = soft_contact_separation(
        store,
        collision,
        first_anchor_a,
        first_anchor_b,
        collision.base_separation_first
    )
    let second_separation = soft_contact_separation(
        store,
        collision,
        second_anchor_a,
        second_anchor_b,
        collision.base_separation_second
    )
    var first_bias = 0.0
    var second_bias = 0.0
    var first_mass_scale = 1.0
    var second_mass_scale = 1.0
    var first_impulse_scale = 0.0
    var second_impulse_scale = 0.0
    if first_separation > 0.0 {
        first_bias = first_separation * inverse_delta
    } else if use_bias {
        first_bias = Math.max(
            softness.bias_rate * first_separation,
            -softness.maximum_correction_speed
        )
        first_mass_scale = softness.mass_scale
        first_impulse_scale = softness.impulse_scale
    }
    if second_separation > 0.0 {
        second_bias = second_separation * inverse_delta
    } else if use_bias {
        second_bias = Math.max(
            softness.bias_rate * second_separation,
            -softness.maximum_correction_speed
        )
        second_mass_scale = softness.mass_scale
        second_impulse_scale = softness.impulse_scale
    }
    let first_velocity = soft_relative_velocity(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor_a,
        first_anchor_b
    ).dot(collision.normal)
    let second_velocity = soft_relative_velocity(
        store,
        collision.first_body,
        collision.second_body,
        second_anchor_a,
        second_anchor_b
    ).dot(collision.normal)
    let first_term = first_velocity + first_bias
    let second_term = second_velocity + second_bias
    let first_previous:float = collision.normal_impulse_first + 0.0
    let second_previous:float = collision.normal_impulse_second + 0.0
    let first_increment = -first_mass_scale * (
        second_denominator * first_term - coupling * second_term
    ) / determinant - first_impulse_scale * first_previous
    let second_increment = -second_mass_scale * (
        first_denominator * second_term - coupling * first_term
    ) / determinant - second_impulse_scale * second_previous
    let first_accumulated = first_previous + first_increment
    let second_accumulated = second_previous + second_increment
    if first_accumulated < 0.0 || second_accumulated < 0.0 { return false }
    apply_soft_contact_impulse(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor_a,
        first_anchor_b,
        collision.normal.multiply(first_increment)
    )
    apply_soft_contact_impulse(
        store,
        collision.first_body,
        collision.second_body,
        second_anchor_a,
        second_anchor_b,
        collision.normal.multiply(second_increment)
    )
    collision.normal_impulse_first = first_accumulated
    collision.normal_impulse_second = second_accumulated
    collision.total_normal_impulse_first += first_accumulated
    collision.total_normal_impulse_second += second_accumulated
    return true
}

func solve_soft_collision_point(
    store:BodyStore2D,
    collision:&Collision2D,
    softness:ContactSoftness2D,
    inverse_delta:float,
    use_bias:bool,
    second_contact:bool
) {
    var first_local = Math.Vec2(
        collision.first_anchor_a.x,
        collision.first_anchor_a.y
    )
    var second_local = Math.Vec2(
        collision.first_anchor_b.x,
        collision.first_anchor_b.y
    )
    var base_separation = collision.base_separation_first + 0.0
    var normal_mass = collision.normal_mass_first + 0.0
    var previous_normal = collision.normal_impulse_first + 0.0
    if second_contact {
        first_local = Math.Vec2(
            collision.second_anchor_a.x,
            collision.second_anchor_a.y
        )
        second_local = Math.Vec2(
            collision.second_anchor_b.x,
            collision.second_anchor_b.y
        )
        base_separation = collision.base_separation_second + 0.0
        normal_mass = collision.normal_mass_second + 0.0
        previous_normal = collision.normal_impulse_second + 0.0
    }
    let first_anchor = contact_anchor_vector(
        store,
        collision.first_body,
        first_local,
        collision.first_anchor_rotates
    )
    let second_anchor = contact_anchor_vector(
        store,
        collision.second_body,
        second_local,
        collision.second_anchor_rotates
    )
    let separation = soft_contact_separation(
        store,
        collision,
        first_anchor,
        second_anchor,
        base_separation
    )
    var velocity_bias = 0.0
    var mass_scale = 1.0
    var impulse_scale = 0.0
    if separation > 0.0 {
        velocity_bias = separation * inverse_delta
    } else if use_bias {
        velocity_bias = Math.max(
            softness.bias_rate * separation,
            -softness.maximum_correction_speed
        )
        mass_scale = softness.mass_scale
        impulse_scale = softness.impulse_scale
    }
    let relative = soft_relative_velocity(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor,
        second_anchor
    )
    let normal_velocity = relative.dot(collision.normal)
    let increment = -normal_mass * mass_scale *
        (normal_velocity + velocity_bias) -
        impulse_scale * previous_normal
    let accumulated_normal = Math.max(previous_normal + increment, 0.0)
    let applied_normal = accumulated_normal - previous_normal
    apply_soft_contact_impulse(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor,
        second_anchor,
        collision.normal.multiply(applied_normal)
    )
    if second_contact {
        collision.normal_impulse_second = accumulated_normal
        collision.total_normal_impulse_second += accumulated_normal
    } else {
        collision.normal_impulse_first = accumulated_normal
        collision.total_normal_impulse_first += accumulated_normal
    }
}

func solve_soft_collision_friction_point(
    store:BodyStore2D,
    collision:&Collision2D,
    second_contact:bool
) {
    var first_local = Math.Vec2(
        collision.first_anchor_a.x,
        collision.first_anchor_a.y
    )
    var second_local = Math.Vec2(
        collision.first_anchor_b.x,
        collision.first_anchor_b.y
    )
    var tangent_mass = collision.tangent_mass_first + 0.0
    var normal_impulse = collision.normal_impulse_first + 0.0
    var previous_tangent = collision.tangent_impulse_first + 0.0
    if second_contact {
        first_local = Math.Vec2(
            collision.second_anchor_a.x,
            collision.second_anchor_a.y
        )
        second_local = Math.Vec2(
            collision.second_anchor_b.x,
            collision.second_anchor_b.y
        )
        tangent_mass = collision.tangent_mass_second + 0.0
        normal_impulse = collision.normal_impulse_second + 0.0
        previous_tangent = collision.tangent_impulse_second + 0.0
    }
    let first_anchor = contact_anchor_vector(
        store,
        collision.first_body,
        first_local,
        collision.first_anchor_rotates
    )
    let second_anchor = contact_anchor_vector(
        store,
        collision.second_body,
        second_local,
        collision.second_anchor_rotates
    )

    let tangent = Math.Vec2(-collision.normal.y, collision.normal.x)
    let tangent_velocity = soft_relative_velocity(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor,
        second_anchor
    ).dot(tangent) + collision.tangent_speed
    let tangent_increment = -tangent_mass * tangent_velocity
    let friction_limit = collision.combined_friction * normal_impulse
    let accumulated_tangent = Math.max(
        -friction_limit,
        Math.min(previous_tangent + tangent_increment, friction_limit)
    )
    apply_soft_contact_impulse(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor,
        second_anchor,
        tangent.multiply(accumulated_tangent - previous_tangent)
    )
    if second_contact {
        collision.tangent_impulse_second = accumulated_tangent
    } else {
        collision.tangent_impulse_first = accumulated_tangent
    }
}

func solve_soft_rolling_friction(
    store:BodyStore2D,
    collision:&Collision2D
) {
    if collision.rolling_resistance <= 0.0 ||
        collision.rolling_mass <= 0.0
    {
        return
    }
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    let relative = store.angular_velocities[second] -
        store.angular_velocities[first]
    let increment = -(collision.rolling_mass + 0.0) * relative
    let normal_impulse = collision.normal_impulse_first +
        collision.normal_impulse_second + 0.0
    let limit = (collision.rolling_resistance + 0.0) * normal_impulse
    let previous:float = collision.rolling_impulse + 0.0
    let accumulated = Math.max(
        -limit,
        Math.min(previous + increment, limit)
    )
    let applied = accumulated - previous
    if store.awake[first] {
        store.angular_velocities[first] -=
            applied * store.inverse_inertias[first]
    }
    if store.awake[second] {
        store.angular_velocities[second] +=
            applied * store.inverse_inertias[second]
    }
    collision.rolling_impulse = accumulated
}

func apply_soft_collision_restitution(
    store:BodyStore2D,
    collision:&Collision2D,
    threshold:float
) {
    if collision.contacts.count == 1 {
        apply_soft_single_collision_restitution(store, collision, threshold)
        return
    }
    apply_soft_collision_restitution_point(store, collision, false, threshold)
    if collision.contacts.count > 1 {
        apply_soft_collision_restitution_point(store, collision, true, threshold)
    }
}

func apply_soft_single_collision_restitution(
    store:BodyStore2D,
    collision:&Collision2D,
    threshold:float
) {
    let restitution:float = collision.restitution + 0.0
    let initial_velocity:float =
        collision.initial_normal_velocity_first + 0.0
    let total_impulse:float = collision.total_normal_impulse_first + 0.0
    let normal_mass:float = collision.normal_mass_first + 0.0
    let previous:float = collision.normal_impulse_first + 0.0
    let normal_x:float = collision.normal.x + 0.0
    let normal_y:float = collision.normal.y + 0.0
    if restitution <= 0.0 || initial_velocity > -threshold ||
        total_impulse <= 0.0
    {
        return
    }
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    var first_anchor_x:float = collision.first_anchor_a.x + 0.0
    var first_anchor_y:float = collision.first_anchor_a.y + 0.0
    if collision.first_anchor_rotates {
        let cosine = store.rotation_cosines[first]
        let sine = store.rotation_sines[first]
        let local_x = first_anchor_x
        let local_y = first_anchor_y
        first_anchor_x = local_x * cosine - local_y * sine
        first_anchor_y = local_x * sine + local_y * cosine
    }
    var second_anchor_x:float = collision.first_anchor_b.x + 0.0
    var second_anchor_y:float = collision.first_anchor_b.y + 0.0
    if collision.second_anchor_rotates {
        let cosine = store.rotation_cosines[second]
        let sine = store.rotation_sines[second]
        let local_x = second_anchor_x
        let local_y = second_anchor_y
        second_anchor_x = local_x * cosine - local_y * sine
        second_anchor_y = local_x * sine + local_y * cosine
    }
    let relative_x = store.velocities_x[second] -
        store.angular_velocities[second] * second_anchor_y -
        store.velocities_x[first] +
        store.angular_velocities[first] * first_anchor_y
    let relative_y = store.velocities_y[second] +
        store.angular_velocities[second] * second_anchor_x -
        store.velocities_y[first] -
        store.angular_velocities[first] * first_anchor_x
    let normal_velocity = relative_x * normal_x + relative_y * normal_y
    let increment = -normal_mass * (
        normal_velocity + restitution * initial_velocity
    )
    let accumulated = Math.max(previous + increment, 0.0)
    let applied = accumulated - previous
    let impulse_x = normal_x * applied
    let impulse_y = normal_y * applied
    var first_inverse_mass = 0.0
    var first_inverse_inertia = 0.0
    if store.awake[first] {
        first_inverse_mass = store.inverse_masses[first]
        first_inverse_inertia = store.inverse_inertias[first]
    }
    var second_inverse_mass = 0.0
    var second_inverse_inertia = 0.0
    if store.awake[second] {
        second_inverse_mass = store.inverse_masses[second]
        second_inverse_inertia = store.inverse_inertias[second]
    }
    store.velocities_x[first] -= impulse_x * first_inverse_mass
    store.velocities_y[first] -= impulse_y * first_inverse_mass
    store.angular_velocities[first] -=
        (first_anchor_x * impulse_y - first_anchor_y * impulse_x) *
        first_inverse_inertia
    store.velocities_x[second] += impulse_x * second_inverse_mass
    store.velocities_y[second] += impulse_y * second_inverse_mass
    store.angular_velocities[second] +=
        (second_anchor_x * impulse_y - second_anchor_y * impulse_x) *
        second_inverse_inertia
    collision.normal_impulse_first = accumulated
}

func apply_soft_collision_restitution_point(
    store:BodyStore2D,
    collision:&Collision2D,
    second_contact:bool,
    threshold:float
) {
    if collision.restitution <= 0.0 { return }
    var first_local = Math.Vec2(
        collision.first_anchor_a.x,
        collision.first_anchor_a.y
    )
    var second_local = Math.Vec2(
        collision.first_anchor_b.x,
        collision.first_anchor_b.y
    )
    var initial_velocity = collision.initial_normal_velocity_first + 0.0
    var total_impulse = collision.total_normal_impulse_first + 0.0
    var normal_mass = collision.normal_mass_first + 0.0
    var previous = collision.normal_impulse_first + 0.0
    if second_contact {
        first_local = Math.Vec2(
            collision.second_anchor_a.x,
            collision.second_anchor_a.y
        )
        second_local = Math.Vec2(
            collision.second_anchor_b.x,
            collision.second_anchor_b.y
        )
        initial_velocity = collision.initial_normal_velocity_second + 0.0
        total_impulse = collision.total_normal_impulse_second + 0.0
        normal_mass = collision.normal_mass_second + 0.0
        previous = collision.normal_impulse_second + 0.0
    }
    if initial_velocity > -threshold || total_impulse <= 0.0 { return }
    let first_anchor = contact_anchor_vector(
        store,
        collision.first_body,
        first_local,
        collision.first_anchor_rotates
    )
    let second_anchor = contact_anchor_vector(
        store,
        collision.second_body,
        second_local,
        collision.second_anchor_rotates
    )
    let normal_velocity = soft_relative_velocity(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor,
        second_anchor
    ).dot(collision.normal)
    let increment = -normal_mass * (
        normal_velocity + collision.restitution * initial_velocity
    )
    let accumulated = Math.max(previous + increment, 0.0)
    apply_soft_contact_impulse(
        store,
        collision.first_body,
        collision.second_body,
        first_anchor,
        second_anchor,
        collision.normal.multiply(accumulated - previous)
    )
    if second_contact { collision.normal_impulse_second = accumulated }
    else { collision.normal_impulse_first = accumulated }
}

func warm_start_compact_circle_collision(
    store:BodyStore2D,
    collision:@CompactCircleCollision2D,
    impulses:@CompactCircleImpulses2D
) {
    if impulses.normal == 0.0 && impulses.tangent == 0.0 {
        return
    }
    let impulse_x = collision.normal.x * impulses.normal -
        collision.normal.y * impulses.tangent
    let impulse_y = collision.normal.y * impulses.normal +
        collision.normal.x * impulses.tangent
    let first = collision.first_body
    let second = collision.second_body
    store.velocities_x[first] -= impulse_x * store.inverse_masses[first]
    store.velocities_y[first] -= impulse_y * store.inverse_masses[first]
    store.angular_velocities[first] -= collision.first_tangent_arm *
        impulses.tangent * store.inverse_inertias[first]
    store.velocities_x[second] += impulse_x * store.inverse_masses[second]
    store.velocities_y[second] += impulse_y * store.inverse_masses[second]
    store.angular_velocities[second] += collision.second_tangent_arm *
        impulses.tangent * store.inverse_inertias[second]
}

func solve_soft_compact_circle(
    store:BodyStore2D,
    velocities_x:&float[..],
    velocities_y:&float[..],
    normal:@CompactCircleCollision2D,
    impulses:&CompactCircleImpulses2D,
    softness:ContactSoftness2D,
    inverse_delta:float,
    use_bias:bool
) {
    let first:int = normal.first_body + 0
    let second:int = normal.second_body + 0
    let normal_x:float = normal.normal.x + 0.0
    let normal_y:float = normal.normal.y + 0.0
    let base_separation:float = normal.base_separation + 0.0
    let initial_normal_offset:float = normal.initial_normal_offset + 0.0
    let normal_mass:float = normal.normal_mass + 0.0
    let current_normal_offset =
        (store.positions_x[second] - store.positions_x[first]) * normal_x +
        (store.positions_y[second] - store.positions_y[first]) * normal_y
    let separation = base_separation + current_normal_offset -
        initial_normal_offset
    var velocity_bias = 0.0
    var mass_scale = 1.0
    var impulse_scale = 0.0
    if separation > 0.0 {
        velocity_bias = separation * inverse_delta
    } else if use_bias {
        velocity_bias = Math.max(
            softness.bias_rate * separation,
            -softness.maximum_correction_speed
        )
        mass_scale = softness.mass_scale
        impulse_scale = softness.impulse_scale
    }
    let normal_velocity =
        (velocities_x[second] - velocities_x[first]) * normal_x +
        (velocities_y[second] - velocities_y[first]) * normal_y
    let previous_normal:float = impulses.normal + 0.0
    let increment = -normal_mass * mass_scale *
        (normal_velocity + velocity_bias) -
        impulse_scale * previous_normal
    let accumulated_normal = Math.max(previous_normal + increment, 0.0)
    let applied_normal = accumulated_normal - previous_normal
    let first_inverse_mass = store.inverse_masses[first]
    let second_inverse_mass = store.inverse_masses[second]
    velocities_x[first] -= normal_x * applied_normal * first_inverse_mass
    velocities_y[first] -= normal_y * applied_normal * first_inverse_mass
    velocities_x[second] += normal_x * applied_normal * second_inverse_mass
    velocities_y[second] += normal_y * applied_normal * second_inverse_mass
    impulses.normal = accumulated_normal
    impulses.total_normal += accumulated_normal
}

func solve_soft_compact_circle_friction(
    store:BodyStore2D,
    velocities_x:&float[..],
    velocities_y:&float[..],
    angular_velocities:&float[..],
    collision:@CompactCircleCollision2D,
    impulses:&CompactCircleImpulses2D
) {
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    let normal_x:float = collision.normal.x + 0.0
    let normal_y:float = collision.normal.y + 0.0
    let tangent_mass:float = collision.tangent_mass + 0.0
    let first_tangent_arm:float = collision.first_tangent_arm + 0.0
    let second_tangent_arm:float = collision.second_tangent_arm + 0.0
    let friction:float = collision.combined_friction + 0.0
    let accumulated_normal:float = impulses.normal + 0.0
    let first_inverse_mass = store.inverse_masses[first]
    let second_inverse_mass = store.inverse_masses[second]
    let tangent_x = -normal_y
    let tangent_y = normal_x
    let tangent_velocity =
        (velocities_x[second] - velocities_x[first]) * tangent_x +
        (velocities_y[second] - velocities_y[first]) * tangent_y +
        angular_velocities[second] * second_tangent_arm -
        angular_velocities[first] * first_tangent_arm
    let previous_tangent:float = impulses.tangent + 0.0
    let tangent_increment = -tangent_mass * tangent_velocity
    let friction_limit = friction * accumulated_normal
    let accumulated_tangent = Math.max(
        -friction_limit,
        Math.min(previous_tangent + tangent_increment, friction_limit)
    )
    let applied_tangent = accumulated_tangent - previous_tangent
    velocities_x[first] -= tangent_x * applied_tangent * first_inverse_mass
    velocities_y[first] -= tangent_y * applied_tangent * first_inverse_mass
    angular_velocities[first] -= first_tangent_arm *
        applied_tangent * store.inverse_inertias[first]
    velocities_x[second] += tangent_x * applied_tangent * second_inverse_mass
    velocities_y[second] += tangent_y * applied_tangent * second_inverse_mass
    angular_velocities[second] += second_tangent_arm *
        applied_tangent * store.inverse_inertias[second]
    impulses.tangent = accumulated_tangent
}

func solve_soft_compact_circle_four_normals(
    store:BodyStore2D,
    velocities_x:&float[..],
    velocities_y:&float[..],
    first_collision:@CompactCircleCollision2D,
    second_collision:@CompactCircleCollision2D,
    third_collision:@CompactCircleCollision2D,
    fourth_collision:@CompactCircleCollision2D,
    first_impulses:&CompactCircleImpulses2D,
    second_impulses:&CompactCircleImpulses2D,
    third_impulses:&CompactCircleImpulses2D,
    fourth_impulses:&CompactCircleImpulses2D,
    softness:ContactSoftness2D,
    inverse_delta:float,
    use_bias:bool
) {
    let first_a:int = first_collision.first_body + 0
    let first_b:int = first_collision.second_body + 0
    let second_a:int = second_collision.first_body + 0
    let second_b:int = second_collision.second_body + 0
    let third_a:int = third_collision.first_body + 0
    let third_b:int = third_collision.second_body + 0
    let fourth_a:int = fourth_collision.first_body + 0
    let fourth_b:int = fourth_collision.second_body + 0
    let normal_x = Math.Vec4(
        first_collision.normal.x,
        second_collision.normal.x,
        third_collision.normal.x,
        fourth_collision.normal.x
    )
    let normal_y = Math.Vec4(
        first_collision.normal.y,
        second_collision.normal.y,
        third_collision.normal.y,
        fourth_collision.normal.y
    )
    let position_a_x = Math.Vec4(
        store.positions_x[first_a],
        store.positions_x[second_a],
        store.positions_x[third_a],
        store.positions_x[fourth_a]
    )
    let position_a_y = Math.Vec4(
        store.positions_y[first_a],
        store.positions_y[second_a],
        store.positions_y[third_a],
        store.positions_y[fourth_a]
    )
    let position_b_x = Math.Vec4(
        store.positions_x[first_b],
        store.positions_x[second_b],
        store.positions_x[third_b],
        store.positions_x[fourth_b]
    )
    let position_b_y = Math.Vec4(
        store.positions_y[first_b],
        store.positions_y[second_b],
        store.positions_y[third_b],
        store.positions_y[fourth_b]
    )
    let current_offset = Math.Vec4(
        (position_b_x.x - position_a_x.x) * normal_x.x +
            (position_b_y.x - position_a_y.x) * normal_y.x,
        (position_b_x.y - position_a_x.y) * normal_x.y +
            (position_b_y.y - position_a_y.y) * normal_y.y,
        (position_b_x.z - position_a_x.z) * normal_x.z +
            (position_b_y.z - position_a_y.z) * normal_y.z,
        (position_b_x.w - position_a_x.w) * normal_x.w +
            (position_b_y.w - position_a_y.w) * normal_y.w
    )
    let base_separation = Math.Vec4(
        first_collision.base_separation,
        second_collision.base_separation,
        third_collision.base_separation,
        fourth_collision.base_separation
    )
    let initial_offset = Math.Vec4(
        first_collision.initial_normal_offset,
        second_collision.initial_normal_offset,
        third_collision.initial_normal_offset,
        fourth_collision.initial_normal_offset
    )
    let separation = Math.Vec4(
        base_separation.x + current_offset.x - initial_offset.x,
        base_separation.y + current_offset.y - initial_offset.y,
        base_separation.z + current_offset.z - initial_offset.z,
        base_separation.w + current_offset.w - initial_offset.w
    )
    var first_bias = 0.0
    var second_bias = 0.0
    var third_bias = 0.0
    var fourth_bias = 0.0
    var first_mass_scale = 1.0
    var second_mass_scale = 1.0
    var third_mass_scale = 1.0
    var fourth_mass_scale = 1.0
    var first_impulse_scale = 0.0
    var second_impulse_scale = 0.0
    var third_impulse_scale = 0.0
    var fourth_impulse_scale = 0.0
    if separation.x > 0.0 {
        first_bias = separation.x * inverse_delta
    } else if use_bias {
        first_bias = Math.max(
            softness.bias_rate * separation.x,
            -softness.maximum_correction_speed
        )
        first_mass_scale = softness.mass_scale
        first_impulse_scale = softness.impulse_scale
    }
    if separation.y > 0.0 {
        second_bias = separation.y * inverse_delta
    } else if use_bias {
        second_bias = Math.max(
            softness.bias_rate * separation.y,
            -softness.maximum_correction_speed
        )
        second_mass_scale = softness.mass_scale
        second_impulse_scale = softness.impulse_scale
    }
    if separation.z > 0.0 {
        third_bias = separation.z * inverse_delta
    } else if use_bias {
        third_bias = Math.max(
            softness.bias_rate * separation.z,
            -softness.maximum_correction_speed
        )
        third_mass_scale = softness.mass_scale
        third_impulse_scale = softness.impulse_scale
    }
    if separation.w > 0.0 {
        fourth_bias = separation.w * inverse_delta
    } else if use_bias {
        fourth_bias = Math.max(
            softness.bias_rate * separation.w,
            -softness.maximum_correction_speed
        )
        fourth_mass_scale = softness.mass_scale
        fourth_impulse_scale = softness.impulse_scale
    }
    let velocity_a_x = Math.Vec4(
        velocities_x[first_a],
        velocities_x[second_a],
        velocities_x[third_a],
        velocities_x[fourth_a]
    )
    let velocity_a_y = Math.Vec4(
        velocities_y[first_a],
        velocities_y[second_a],
        velocities_y[third_a],
        velocities_y[fourth_a]
    )
    let velocity_b_x = Math.Vec4(
        velocities_x[first_b],
        velocities_x[second_b],
        velocities_x[third_b],
        velocities_x[fourth_b]
    )
    let velocity_b_y = Math.Vec4(
        velocities_y[first_b],
        velocities_y[second_b],
        velocities_y[third_b],
        velocities_y[fourth_b]
    )
    let normal_velocity = Math.Vec4(
        (velocity_b_x.x - velocity_a_x.x) * normal_x.x +
            (velocity_b_y.x - velocity_a_y.x) * normal_y.x,
        (velocity_b_x.y - velocity_a_x.y) * normal_x.y +
            (velocity_b_y.y - velocity_a_y.y) * normal_y.y,
        (velocity_b_x.z - velocity_a_x.z) * normal_x.z +
            (velocity_b_y.z - velocity_a_y.z) * normal_y.z,
        (velocity_b_x.w - velocity_a_x.w) * normal_x.w +
            (velocity_b_y.w - velocity_a_y.w) * normal_y.w
    )
    let previous = Math.Vec4(
        first_impulses.normal,
        second_impulses.normal,
        third_impulses.normal,
        fourth_impulses.normal
    )
    let normal_mass = Math.Vec4(
        first_collision.normal_mass,
        second_collision.normal_mass,
        third_collision.normal_mass,
        fourth_collision.normal_mass
    )
    let mass_scale = Math.Vec4(
        first_mass_scale,
        second_mass_scale,
        third_mass_scale,
        fourth_mass_scale
    )
    let impulse_scale = Math.Vec4(
        first_impulse_scale,
        second_impulse_scale,
        third_impulse_scale,
        fourth_impulse_scale
    )
    let velocity_bias = Math.Vec4(
        first_bias,
        second_bias,
        third_bias,
        fourth_bias
    )
    let increment = Math.Vec4(
        -normal_mass.x * mass_scale.x *
            (normal_velocity.x + velocity_bias.x) -
            impulse_scale.x * previous.x,
        -normal_mass.y * mass_scale.y *
            (normal_velocity.y + velocity_bias.y) -
            impulse_scale.y * previous.y,
        -normal_mass.z * mass_scale.z *
            (normal_velocity.z + velocity_bias.z) -
            impulse_scale.z * previous.z,
        -normal_mass.w * mass_scale.w *
            (normal_velocity.w + velocity_bias.w) -
            impulse_scale.w * previous.w
    )
    let accumulated = Math.Vec4(
        Math.max(previous.x + increment.x, 0.0),
        Math.max(previous.y + increment.y, 0.0),
        Math.max(previous.z + increment.z, 0.0),
        Math.max(previous.w + increment.w, 0.0)
    )
    let applied = Math.Vec4(
        accumulated.x - previous.x,
        accumulated.y - previous.y,
        accumulated.z - previous.z,
        accumulated.w - previous.w
    )
    let inverse_mass_a = Math.Vec4(
        store.inverse_masses[first_a],
        store.inverse_masses[second_a],
        store.inverse_masses[third_a],
        store.inverse_masses[fourth_a]
    )
    let inverse_mass_b = Math.Vec4(
        store.inverse_masses[first_b],
        store.inverse_masses[second_b],
        store.inverse_masses[third_b],
        store.inverse_masses[fourth_b]
    )
    let impulse_x = Math.Vec4(
        normal_x.x * applied.x,
        normal_x.y * applied.y,
        normal_x.z * applied.z,
        normal_x.w * applied.w
    )
    let impulse_y = Math.Vec4(
        normal_y.x * applied.x,
        normal_y.y * applied.y,
        normal_y.z * applied.z,
        normal_y.w * applied.w
    )
    let delta_a_x = Math.Vec4(
        impulse_x.x * inverse_mass_a.x,
        impulse_x.y * inverse_mass_a.y,
        impulse_x.z * inverse_mass_a.z,
        impulse_x.w * inverse_mass_a.w
    )
    let delta_a_y = Math.Vec4(
        impulse_y.x * inverse_mass_a.x,
        impulse_y.y * inverse_mass_a.y,
        impulse_y.z * inverse_mass_a.z,
        impulse_y.w * inverse_mass_a.w
    )
    let delta_b_x = Math.Vec4(
        impulse_x.x * inverse_mass_b.x,
        impulse_x.y * inverse_mass_b.y,
        impulse_x.z * inverse_mass_b.z,
        impulse_x.w * inverse_mass_b.w
    )
    let delta_b_y = Math.Vec4(
        impulse_y.x * inverse_mass_b.x,
        impulse_y.y * inverse_mass_b.y,
        impulse_y.z * inverse_mass_b.z,
        impulse_y.w * inverse_mass_b.w
    )
    velocities_x[first_a] -= delta_a_x.x
    velocities_y[first_a] -= delta_a_y.x
    velocities_x[first_b] += delta_b_x.x
    velocities_y[first_b] += delta_b_y.x
    velocities_x[second_a] -= delta_a_x.y
    velocities_y[second_a] -= delta_a_y.y
    velocities_x[second_b] += delta_b_x.y
    velocities_y[second_b] += delta_b_y.y
    velocities_x[third_a] -= delta_a_x.z
    velocities_y[third_a] -= delta_a_y.z
    velocities_x[third_b] += delta_b_x.z
    velocities_y[third_b] += delta_b_y.z
    velocities_x[fourth_a] -= delta_a_x.w
    velocities_y[fourth_a] -= delta_a_y.w
    velocities_x[fourth_b] += delta_b_x.w
    velocities_y[fourth_b] += delta_b_y.w
    first_impulses.normal = accumulated.x
    second_impulses.normal = accumulated.y
    third_impulses.normal = accumulated.z
    fourth_impulses.normal = accumulated.w
    first_impulses.total_normal += accumulated.x
    second_impulses.total_normal += accumulated.y
    third_impulses.total_normal += accumulated.z
    fourth_impulses.total_normal += accumulated.w
}

func apply_soft_compact_restitution(
    store:BodyStore2D,
    collision:@CompactCircleCollision2D,
    impulses:&CompactCircleImpulses2D,
    threshold:float
) {
    if collision.restitution <= 0.0 ||
        collision.initial_normal_velocity > -threshold ||
        impulses.total_normal <= 0.0
    {
        return
    }
    let first:int = collision.first_body + 0
    let second:int = collision.second_body + 0
    let normal_x:float = collision.normal.x + 0.0
    let normal_y:float = collision.normal.y + 0.0
    let restitution:float = collision.restitution + 0.0
    let initial_normal_velocity:float =
        collision.initial_normal_velocity + 0.0
    let normal_mass:float = collision.normal_mass + 0.0
    let normal_velocity =
        (store.velocities_x[second] - store.velocities_x[first]) * normal_x +
        (store.velocities_y[second] - store.velocities_y[first]) * normal_y
    let previous:float = impulses.normal + 0.0
    let increment = -normal_mass * (
        normal_velocity +
        restitution * initial_normal_velocity
    )
    let accumulated = Math.max(previous + increment, 0.0)
    let applied = accumulated - previous
    store.velocities_x[first] -= normal_x * applied *
        store.inverse_masses[first]
    store.velocities_y[first] -= normal_y * applied *
        store.inverse_masses[first]
    store.velocities_x[second] += normal_x * applied *
        store.inverse_masses[second]
    store.velocities_y[second] += normal_y * applied *
        store.inverse_masses[second]
    impulses.normal = accumulated
}

struct ClippedContactSegment2D {
    let first:Math.Vec2
    let second:Math.Vec2
    let count:int

    init() {
        self.first = Math.Vec2()
        self.second = Math.Vec2()
        self.count = 0
    }

    init(first:Math.Vec2, second:Math.Vec2) {
        self.first = first
        self.second = second
        self.count = 2
    }
}

func clip_contact_segment(
    segment:ClippedContactSegment2D,
    axis:Math.Vec2,
    limit:float,
    keep_above:bool
) ClippedContactSegment2D {
    if segment.count < 2 { return ClippedContactSegment2D() }
    let first_distance = segment.first.dot(axis) - limit
    let second_distance = segment.second.dot(axis) - limit
    var first_inside = first_distance >= 0.0
    var second_inside = second_distance >= 0.0
    if !keep_above {
        first_inside = first_distance <= 0.0
        second_inside = second_distance <= 0.0
    }
    if first_inside && second_inside { return segment }
    if !first_inside && !second_inside { return ClippedContactSegment2D() }
    let fraction = first_distance / (first_distance - second_distance)
    let intersection = segment.first.lerp(segment.second, fraction)
    if first_inside {
        return ClippedContactSegment2D(segment.first, intersection)
    }
    return ClippedContactSegment2D(intersection, segment.second)
}

func contact_points(
    store:BodyStore2D,
    first:int,
    second:int,
    normal:Math.Vec2
) ContactPoints2D {
    let first_support = body_support(store, first, normal)
    let second_support = body_support(store, second, normal.negated())
    let support_separation = second_support.dot(normal) -
        first_support.dot(normal)
    var contact = first_support.add(second_support).multiply(0.5)
    if store.inverse_masses[first] <= 0.0 { contact = second_support }
    else if store.inverse_masses[second] <= 0.0 { contact = first_support }

    var reference = first
    var incident = second
    var reference_normal = normal
    if face_alignment(store, second, normal) >
        face_alignment(store, first, normal) + 0.000001
    {
        reference = second
        incident = first
        reference_normal = normal.negated()
    }

    let reference_axis_x = body_axis_x(store, reference)
    let reference_axis_y = body_axis_y(store, reference)
    var reference_face_normal = reference_axis_x
    var reference_tangent = reference_axis_y
    var reference_normal_extent = store.half_widths[reference]
    var reference_tangent_extent = store.half_heights[reference]
    if Math.abs(reference_axis_y.dot(reference_normal)) >
        Math.abs(reference_axis_x.dot(reference_normal))
    {
        reference_face_normal = reference_axis_y
        reference_tangent = reference_axis_x
        reference_normal_extent = store.half_heights[reference]
        reference_tangent_extent = store.half_widths[reference]
    }
    if reference_face_normal.dot(reference_normal) < 0.0 {
        reference_face_normal = reference_face_normal.negated()
    }

    let incident_axis_x = body_axis_x(store, incident)
    let incident_axis_y = body_axis_y(store, incident)
    var incident_face_normal = incident_axis_x
    var incident_tangent = incident_axis_y
    var incident_normal_extent = store.half_widths[incident]
    var incident_tangent_extent = store.half_heights[incident]
    if Math.abs(incident_axis_y.dot(reference_face_normal)) >
        Math.abs(incident_axis_x.dot(reference_face_normal))
    {
        incident_face_normal = incident_axis_y
        incident_tangent = incident_axis_x
        incident_normal_extent = store.half_heights[incident]
        incident_tangent_extent = store.half_widths[incident]
    }
    if incident_face_normal.dot(reference_face_normal) > 0.0 {
        incident_face_normal = incident_face_normal.negated()
    }

    let reference_position = body_position(store, reference)
    let reference_face_center = reference_position.add(
        reference_face_normal.multiply(reference_normal_extent)
    )
    let reference_tangent_center = reference_face_center.dot(
        reference_tangent
    )
    let incident_face_center = body_position(store, incident).add(
        incident_face_normal.multiply(incident_normal_extent)
    )
    var clipped = ClippedContactSegment2D(
        incident_face_center.subtract(
            incident_tangent.multiply(incident_tangent_extent)
        ),
        incident_face_center.add(
            incident_tangent.multiply(incident_tangent_extent)
        )
    )
    clipped = clip_contact_segment(
        clipped,
        reference_tangent,
        reference_tangent_center - reference_tangent_extent,
        true
    )
    clipped = clip_contact_segment(
        clipped,
        reference_tangent,
        reference_tangent_center + reference_tangent_extent,
        false
    )
    if clipped.count < 2 {
        return ContactPoints2D(contact, support_separation)
    }

    let reference_plane = reference_face_center.dot(reference_face_normal)
    let first_separation =
        clipped.first.dot(reference_face_normal) - reference_plane
    let second_separation =
        clipped.second.dot(reference_face_normal) - reference_plane
    let first_contact = clipped.first.subtract(
        reference_face_normal.multiply(first_separation * 0.5)
    )
    let second_contact = clipped.second.subtract(
        reference_face_normal.multiply(second_separation * 0.5)
    )
    if first_separation > 0.02 && second_separation > 0.02 {
        return ContactPoints2D(contact, support_separation)
    }
    if first_separation > 0.02 {
        return ContactPoints2D(second_contact, second_separation)
    }
    if second_separation > 0.02 {
        return ContactPoints2D(first_contact, first_separation)
    }
    return ContactPoints2D(
        first_contact,
        first_separation,
        second_contact,
        second_separation
    )
}

func face_alignment(store:BodyStore2D, body:int, normal:Math.Vec2) float {
    return Math.max(
        Math.abs(body_axis_x(store, body).dot(normal)),
        Math.abs(body_axis_y(store, body).dot(normal))
    )
}

func overlap_on_axis(
    store:BodyStore2D,
    first:int,
    second:int,
    offset:Math.Vec2,
    axis:Math.Vec2
) float {
    return projection_radius(store, first, axis) +
        projection_radius(store, second, axis) -
        Math.abs(offset.dot(axis))
}

func body_position(store:BodyStore2D, index:int) Math.Vec2 {
    return Math.Vec2(store.positions_x[index], store.positions_y[index])
}

func speculative_circle_pair(
    store:BodyStore2D,
    first:int,
    second:int
) bool {
    if store.shape_kinds[first] != 1 || store.shape_kinds[second] != 1 {
        return false
    }
    let offset_x = store.positions_x[second] - store.positions_x[first]
    let offset_y = store.positions_y[second] - store.positions_y[first]
    let radius = store.radii[first] + store.radii[second] + 0.02
    return offset_x * offset_x + offset_y * offset_y <= radius * radius
}

func circle_contact_normal(
    store:BodyStore2D,
    first:int,
    second:int,
    offset_x:float,
    offset_y:float,
    distance:float,
    combined_radius:float
) Math.Vec2 {
    if distance <= combined_radius * 0.2 {
        let previous_x = store.previous_positions_x[second] -
            store.previous_positions_x[first]
        let previous_y = store.previous_positions_y[second] -
            store.previous_positions_y[first]
        let previous_distance_squared = previous_x * previous_x +
            previous_y * previous_y
        let retained_axis_threshold = combined_radius * 0.05
        if previous_distance_squared >=
            retained_axis_threshold * retained_axis_threshold
        {
            // Once the current centres are nearly coincident, their tiny
            // offset is solver noise. Preserve the preceding contact axis even
            // when that previous contact was already penetrating. This keeps
            // two circles projected against the same wall from alternating on
            // an arbitrary horizontal axis and being clamped together again.
            let inverse_previous_distance =
                1.0 / Math.sqrt(previous_distance_squared)
            return Math.Vec2(
                previous_x * inverse_previous_distance,
                previous_y * inverse_previous_distance
            )
        }
    }
    return circle_separation_normal(
        offset_x,
        offset_y,
        distance,
        combined_radius
    )
}

func circle_separation_normal(
    offset_x:float,
    offset_y:float,
    distance:float,
    combined_radius:float
) Math.Vec2 {
    // At extreme overlap the tiny centre offset is solver noise, not a
    // reliable contact normal. A vertical noise axis at the floor is undone
    // by boundary projection and can store an entire pile's compression.
    // Escape horizontally so the correction remains valid on the floor.
    if distance <= combined_radius * 0.2 {
        if offset_x < 0.0 { return Math.Vec2(-1.0, 0.0) }
        return Math.Vec2(1.0, 0.0)
    }
    let inverse_distance = 1.0 / distance
    return Math.Vec2(
        offset_x * inverse_distance,
        offset_y * inverse_distance
    )
}

func body_local_point(
    store:BodyStore2D,
    index:int,
    point:Math.Vec2
) Math.Vec2 {
    let offset_x = point.x - store.positions_x[index]
    let offset_y = point.y - store.positions_y[index]
    let cosine = store.rotation_cosines[index]
    let sine = store.rotation_sines[index]
    return Math.Vec2(
        offset_x * cosine + offset_y * sine,
        offset_y * cosine - offset_x * sine
    )
}

func body_local_vector(
    store:BodyStore2D,
    index:int,
    vector:Math.Vec2
) Math.Vec2 {
    let cosine = store.rotation_cosines[index]
    let sine = store.rotation_sines[index]
    return Math.Vec2(
        vector.x * cosine + vector.y * sine,
        vector.y * cosine - vector.x * sine
    )
}

func normalized_joint_axis(axis:Math.Vec2) Math.Vec2 {
    let length = axis.length()
    if length <= 0.000001 {
        panic("GFX.Physics joint axis must be non-zero")
    }
    return axis.multiply(1.0 / length)
}

func body_contact_cache_point(
    store:BodyStore2D,
    index:int,
    point:Math.Vec2
) Math.Vec2 {
    return body_local_point(store, index, point).subtract(Math.Vec2(
        store.local_centers_x[index],
        store.local_centers_y[index]
    ))
}

func body_axis_x(store:BodyStore2D, index:int) Math.Vec2 {
    return Math.Vec2(
        store.rotation_cosines[index],
        store.rotation_sines[index]
    )
}

func body_axis_y(store:BodyStore2D, index:int) Math.Vec2 {
    return Math.Vec2(
        -store.rotation_sines[index],
        store.rotation_cosines[index]
    )
}

func projection_radius(
    store:BodyStore2D,
    index:int,
    axis:Math.Vec2
) float {
    if store.shape_kinds[index] == 1 { return store.radii[index] }
    let cosine = store.rotation_cosines[index]
    let sine = store.rotation_sines[index]
    let along_x = axis.x * cosine + axis.y * sine
    let along_y = axis.x * -sine + axis.y * cosine
    return store.half_widths[index] * Math.abs(along_x) +
        store.half_heights[index] * Math.abs(along_y)
}

func body_support(
    store:BodyStore2D,
    index:int,
    direction:Math.Vec2
) Math.Vec2 {
    if store.shape_kinds[index] == 1 {
        return Math.Vec2(
            store.positions_x[index] + direction.x * store.radii[index],
            store.positions_y[index] + direction.y * store.radii[index]
        )
    }
    let cosine = store.rotation_cosines[index]
    let sine = store.rotation_sines[index]
    var x = 0.0
    var y = 0.0
    let along_x = direction.x * cosine + direction.y * sine
    let along_y = direction.x * -sine + direction.y * cosine
    if along_x > 0.000001 { x = store.half_widths[index] }
    else if along_x < -0.000001 { x = -store.half_widths[index] }
    if along_y > 0.000001 { y = store.half_heights[index] }
    else if along_y < -0.000001 { y = -store.half_heights[index] }
    return Math.Vec2(
        store.positions_x[index] + cosine * x - sine * y,
        store.positions_y[index] + sine * x + cosine * y
    )
}

func velocity_at(
    store:BodyStore2D,
    index:int,
    point:Math.Vec2
) Math.Vec2 {
    let center = store.world_center_at(index)
    let radius_x = point.x - center.x
    let radius_y = point.y - center.y
    let angular = store.angular_velocities[index]
    return Math.Vec2(
        store.velocities_x[index] - angular * radius_y,
        store.velocities_y[index] + angular * radius_x
    )
}

func wake_for_contact(
    store:BodyStore2D,
    first:int,
    second:int,
    normal:Math.Vec2,
    contact:Math.Vec2,
    penetration:float
) {
    if store.awake[first] == store.awake[second] { return }
    let relative_velocity = velocity_at(store, second, contact).subtract(
        velocity_at(store, first, contact)
    )
    if relative_velocity.dot(normal) >= -0.35 { return }
    if store.awake[first] { store.wake(second) }
    else { store.wake(first) }
}

func solver_inverse_mass(store:BodyStore2D, index:int) float {
    if !store.awake[index] { return 0.0 }
    return store.inverse_masses[index]
}

func solver_inverse_inertia(store:BodyStore2D, index:int) float {
    if !store.awake[index] { return 0.0 }
    return store.inverse_inertias[index]
}

func cross(left:Math.Vec2, right:Math.Vec2) float {
    return left.x * right.y - left.y * right.x
}

func circle_grid_bucket(x:int, y:int, bucket_count:int) int {
    var reduced_x = x % bucket_count
    var reduced_y = y % bucket_count
    if reduced_x < 0 { reduced_x += bucket_count }
    if reduced_y < 0 { reduced_y += bucket_count }
    let hash = reduced_x as uint * 73_856_093 as uint ^
        reduced_y as uint * 19_349_663 as uint
    return (hash % bucket_count as uint) as int
}
