        self.parallel_enabled = false
        self.current_soft_step_stages = []
        self.current_soft_step_parallel_dispatch_count = 0
        self.previous_touching_pairs = []
        self.previous_touching_keys = PairSet2D()
        self.current_touching_keys = PairSet2D()
        self.sensor_pairs = []
        self.sensor_pair_keys = PairSet2D()
        self.current_sensor_pairs = []
        self.current_sensor_pair_keys = PairSet2D()
        self.hit_pair_keys = PairSet2D()
        self.step_start_awake = []
        self.body_move_events = []
        self.contact_begin_events = []
        self.contact_end_events = []
        self.contact_hit_events = []
        self.sensor_begin_events = []
        self.sensor_end_events = []
        self.current_hit_event_threshold = selected.hit_event_threshold
        self.current_ccd_body_count = 0
        self.current_ccd_pair_test_count = 0
    }

    func gravity() Math.Vec2 { return self.current_gravity }
    func set_gravity(gravity:Math.Vec2) {
        self.store.require_mutable()
        if !finite_world_value(gravity.x) || !finite_world_value(gravity.y) {
            panic("GFX.Physics.World2D gravity must be finite")
        }
        self.current_gravity = gravity
        var index = 0
        while index < self.store.count() {
            self.store.wake(index)
            index++
        }
    }
    func settings() World2DSettings {
        return World2DSettings()
            ..gravity = self.current_gravity
            ..sleep_enabled = self.current_sleep_enabled
            ..continuous_collision_enabled =
                self.current_continuous_collision_enabled
            ..restitution_threshold = self.current_restitution_threshold
            ..hit_event_threshold = self.current_hit_event_threshold
            ..contact_stiffness_hertz =
                self.current_contact_stiffness_hertz
            ..contact_damping_ratio = self.current_contact_damping_ratio
            ..maximum_correction_speed =
                self.current_maximum_correction_speed
            ..maximum_linear_speed = self.current_maximum_linear_speed
            ..warm_start_enabled = self.current_warm_start_enabled
    }
    func sleep_enabled() bool { return self.current_sleep_enabled }
    func set_sleep_enabled(enabled:bool) {
        self.store.require_mutable()
        if self.current_sleep_enabled == enabled { return }
        self.current_sleep_enabled = enabled
        if !enabled { self.wake_dynamic_bodies() }
    }
    func continuous_collision_enabled() bool {
        return self.current_continuous_collision_enabled
    }
    func set_continuous_collision_enabled(enabled:bool) {
        self.store.require_mutable()
        self.current_continuous_collision_enabled = enabled
    }
    func restitution_threshold() float {
        return self.current_restitution_threshold
    }
    func set_restitution_threshold(threshold:float) {
        self.store.require_mutable()
        require_non_negative_world_value(
            threshold,
            "GFX.Physics.World2D restitution threshold must be finite and non-negative"
        )
        if self.current_restitution_threshold == threshold { return }
        self.current_restitution_threshold = threshold
        self.wake_dynamic_bodies()
    }
    func contact_stiffness_hertz() float {
        return self.current_contact_stiffness_hertz
    }
    func contact_damping_ratio() float {
        return self.current_contact_damping_ratio
    }
    func set_contact_tuning(stiffness_hertz:float, damping_ratio:float) {
        self.store.require_mutable()
        require_non_negative_world_value(
            stiffness_hertz,
            "GFX.Physics.World2D contact stiffness must be finite and non-negative"
        )
        require_non_negative_world_value(
            damping_ratio,
            "GFX.Physics.World2D contact damping ratio must be finite and non-negative"
        )
        if self.current_contact_stiffness_hertz == stiffness_hertz &&
            self.current_contact_damping_ratio == damping_ratio
        {
            return
        }
        self.current_contact_stiffness_hertz = stiffness_hertz
        self.current_contact_damping_ratio = damping_ratio
        self.wake_dynamic_bodies()
    }
    func maximum_correction_speed() float {
        return self.current_maximum_correction_speed
    }
    func set_maximum_correction_speed(speed:float) {
        self.store.require_mutable()
        require_non_negative_world_value(
            speed,
            "GFX.Physics.World2D maximum correction speed must be finite and non-negative"
        )
        if self.current_maximum_correction_speed == speed { return }
        self.current_maximum_correction_speed = speed
        self.wake_dynamic_bodies()
    }
    func maximum_linear_speed() float {
        return self.current_maximum_linear_speed
    }
    func set_maximum_linear_speed(speed:float) {
        self.store.require_mutable()
        require_positive_world_value(
            speed,
            "GFX.Physics.World2D maximum linear speed must be finite and positive"
        )
        self.current_maximum_linear_speed = speed
    }
    func warm_start_enabled() bool { return self.current_warm_start_enabled }
    func set_warm_start_enabled(enabled:bool) {
        self.store.require_mutable()
        if self.current_warm_start_enabled == enabled { return }
        self.current_warm_start_enabled = enabled
        self.wake_dynamic_bodies()
    }
    func body_count() int { return self.store.count() }
    func counters() World2DCounters {
        let bodies = self.store.count()
        let colliders = self.store.shape_store.count()
        let contacts = self.contact_count()
        let joints = self.joints.count()
        let islands = self.active_island_roots.count()
        return World2DCounters(
            bodies,
            colliders,
            contacts,
            joints,
            islands,
            bodies * 192 + colliders * 160 + contacts * 128 +
                joints * 256 + islands * 24
        )
    }
    func write_dynamic_body_transforms(output:&BodyTransform2D[]) {
        var dynamic_count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic {
                dynamic_count++
            }
            index++
        }
        while output.count() < dynamic_count {
            output.append(BodyTransform2D())
        }
        while output.count() > dynamic_count { output.take_last() }
        index = 0
        var destination = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic {
                output[destination] = BodyTransform2D(
                    Math.Vec2(
                        self.store.positions_x[index],
                        self.store.positions_y[index]
                    ),
                    self.store.rotations[index]
                )
                destination++
            }
            index++
        }
    }
    func write_dynamic_body_transforms(output:BodyTransformBuffer2D) {
        var dynamic_count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic {
                dynamic_count++
            }
            index++
        }
        output.resize(dynamic_count)
        index = 0
        var destination = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic {
                output.write(
                    destination,
                    Math.Vec2(
                        self.store.positions_x[index],
                        self.store.positions_y[index]
                    ),
                    self.store.rotations[index]
                )
                destination++
            }
            index++
        }
    }
    func candidate_pair_count() int {
        var count = 0
        for candidate in self.active_pairs {
            if self.candidate_enabled[candidate] {
                let pair = self.candidate_bodies[candidate]
                if self.store.enabled[pair.first] &&
                    self.store.enabled[pair.second]
                {
                    count++
                }
            }
        }
        return count
    }
    func contact_count() int {
        var count = 0
        var index = 0
        while index < self.candidate_pairs.count() {
            if self.candidate_enabled[index] &&
                self.candidate_pairs[index].contact_count > 0 &&
                self.store.enabled[self.candidate_bodies[index].first] &&
                self.store.enabled[self.candidate_bodies[index].second] &&
                !pair_is_sensor(self.store, self.candidate_bodies[index])
            {
                count++
            }
            index++
        }
        return count
    }
    func write_contacts(output:&Contact2D[]) {
        output.clear()
        var index = 0
        while index < self.candidate_pairs.count() {
            if !self.candidate_enabled[index] ||
                self.candidate_pairs[index].contact_count <= 0 ||
                !self.store.enabled[self.candidate_bodies[index].first] ||
                !self.store.enabled[self.candidate_bodies[index].second] ||
                pair_is_sensor(self.store, self.candidate_bodies[index])
            {
                index++
                continue
            }
            let pair = self.candidate_bodies[index]
            var first = pair.first
            var second = pair.second
            if self.store.dense_slots[first] > self.store.dense_slots[second] {
                let swapped = first
                first = second
                second = swapped
            }
            let manifold = contact_manifold(self.store, first, second)
            if manifold.point_count() > 0 {
                output.append(Contact2D(
                    RigidBody2D(self.store, self.store.body_id_at(first)),
                    RigidBody2D(self.store, self.store.body_id_at(second)),
                    manifold
                ))
            }
            index++
        }
    }

    func write_aabb_overlaps(
        bounds:AABB2D,
        output:&Collider2D[],
        filter:QueryFilter2D = QueryFilter2D()
    ) WorldQueryStatistics2D {
        self.store.require_queryable()
        output.clear()
        let colliders = ordered_query_colliders(self.store)
        var visited = 0
        var candidates = 0
        for dense in colliders {
            visited++
            if !query_collider_enabled(self.store, dense) ||
                !filter.allows(self.store.shape_store.collision_filters[dense]) ||
                !bounds.overlaps(query_collider_bounds(self.store, dense))
            {
                continue
            }
            candidates++
            output.append(query_collider_handle(self.store, dense))
        }
        return WorldQueryStatistics2D(visited, candidates, output.count())
    }

    func aabb_overlaps_any(
        bounds:AABB2D,
        filter:QueryFilter2D = QueryFilter2D()
    ) bool {
        self.store.require_queryable()
        for dense in ordered_query_colliders(self.store) {
            if query_collider_enabled(self.store, dense) &&
                filter.allows(self.store.shape_store.collision_filters[dense]) &&
                bounds.overlaps(query_collider_bounds(self.store, dense))
            {
                return true
            }
        }
        return false
    }

    func write_shape_overlaps(
        shape:ShapePlacement2D,
        output:&Collider2D[],
        filter:QueryFilter2D = QueryFilter2D()
    ) WorldQueryStatistics2D {
        self.store.require_queryable()
        output.clear()
        let query = ShapePlacement2D(shape.shape(), shape.transform())
        let bounds = Geometry2D.aabb(query)
        let colliders = ordered_query_colliders(self.store)
        var visited = 0
        var candidates = 0
        for dense in colliders {
            visited++
            if !query_collider_enabled(self.store, dense) ||
                !filter.allows(self.store.shape_store.collision_filters[dense]) ||
                !bounds.overlaps(query_collider_bounds(self.store, dense))
            {
                continue
            }
            candidates++
            if Geometry2D.overlaps(query, query_collider_placement(self.store, dense)) {
                output.append(query_collider_handle(self.store, dense))
            }
        }
        return WorldQueryStatistics2D(visited, candidates, output.count())
    }

    func shape_overlaps_any(
        shape:ShapePlacement2D,
        filter:QueryFilter2D = QueryFilter2D()
    ) bool {
        self.store.require_queryable()
        let query = ShapePlacement2D(shape.shape(), shape.transform())
        let bounds = Geometry2D.aabb(query)
        for dense in ordered_query_colliders(self.store) {
            if query_collider_enabled(self.store, dense) &&
                filter.allows(self.store.shape_store.collision_filters[dense]) &&
                bounds.overlaps(query_collider_bounds(self.store, dense)) &&
                Geometry2D.overlaps(query, query_collider_placement(self.store, dense))
            {
                return true
            }
        }
        return false
    }

    func write_ray_casts(
        ray:Ray2D,
        output:&WorldCastResult2D[],
        filter:QueryFilter2D = QueryFilter2D()
    ) WorldQueryStatistics2D {
        self.store.require_queryable()
        output.clear()
        let bounds = ray_query_bounds(ray)
        let colliders = ordered_query_colliders(self.store)
        var visited = 0
        var candidates = 0
        for dense in colliders {
            visited++
            if !query_collider_enabled(self.store, dense) ||
                !filter.allows(self.store.shape_store.collision_filters[dense]) ||
                !bounds.overlaps(query_collider_bounds(self.store, dense))
            {
                continue
            }
            candidates++
            let result = Geometry2D.ray_cast(
                ray,
                query_collider_placement(self.store, dense)
            )
            if result.hit {
                output.append(WorldCastResult2D(
                    query_collider_handle(self.store, dense),
                    result
                ))
            }
        }
        return WorldQueryStatistics2D(visited, candidates, output.count())
    }

    func ray_cast_any(
        ray:Ray2D,
        filter:QueryFilter2D = QueryFilter2D()
    ) bool {
        self.store.require_queryable()
        let bounds = ray_query_bounds(ray)
        for dense in ordered_query_colliders(self.store) {
            if query_collider_enabled(self.store, dense) &&
                filter.allows(self.store.shape_store.collision_filters[dense]) &&
                bounds.overlaps(query_collider_bounds(self.store, dense)) &&
                Geometry2D.ray_cast(
                    ray,
                    query_collider_placement(self.store, dense)
                ).hit
            {
                return true
            }
        }
        return false
    }

    func ray_cast_closest(
        ray:Ray2D,
        filter:QueryFilter2D = QueryFilter2D()
    ) WorldCastResult2D {
        self.store.require_queryable()
        let bounds = ray_query_bounds(ray)
        var closest = WorldCastResult2D()
        for dense in ordered_query_colliders(self.store) {
            if !query_collider_enabled(self.store, dense) ||
                !filter.allows(self.store.shape_store.collision_filters[dense]) ||
                !bounds.overlaps(query_collider_bounds(self.store, dense))
            {
                continue
            }
            let result = Geometry2D.ray_cast(
                ray,
                query_collider_placement(self.store, dense)
            )
            if result.hit && (!closest.hit || result.fraction < closest.fraction) {
                closest = WorldCastResult2D(
                    query_collider_handle(self.store, dense),
                    result
                )
            }
        }
        return closest
    }

    func write_shape_casts(
        moving:ShapePlacement2D,
        translation:Math.Vec2,
        output:&WorldCastResult2D[],
        filter:QueryFilter2D = QueryFilter2D(),
        max_fraction:float = 1.0
    ) WorldQueryStatistics2D {
        self.store.require_queryable()
        output.clear()
        let query = ShapePlacement2D(moving.shape(), moving.transform())
        let bounds = shape_cast_query_bounds(query, translation, max_fraction)
        let colliders = ordered_query_colliders(self.store)
        var visited = 0
        var candidates = 0
        for dense in colliders {
            visited++
            if !query_collider_enabled(self.store, dense) ||
                !filter.allows(self.store.shape_store.collision_filters[dense]) ||
                !bounds.overlaps(query_collider_bounds(self.store, dense))
            {
                continue
            }
            candidates++
            let result = Geometry2D.shape_cast(
                query,
                translation,
                query_collider_placement(self.store, dense),
                max_fraction
            )
            if result.hit {
                output.append(WorldCastResult2D(
                    query_collider_handle(self.store, dense),
                    result
                ))
            }
        }
        return WorldQueryStatistics2D(visited, candidates, output.count())
    }

    func shape_cast_any(
        moving:ShapePlacement2D,
        translation:Math.Vec2,
        filter:QueryFilter2D = QueryFilter2D(),
        max_fraction:float = 1.0
    ) bool {
        self.store.require_queryable()
        let query = ShapePlacement2D(moving.shape(), moving.transform())
