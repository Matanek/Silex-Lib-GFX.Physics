public struct World2DSettings {
    var gravity:Math.Vec2
    var sleep_enabled:bool
    var continuous_collision_enabled:bool
    var restitution_threshold:float
    var hit_event_threshold:float
    var contact_stiffness_hertz:float
    var contact_damping_ratio:float
    var maximum_correction_speed:float
    var maximum_linear_speed:float
    var warm_start_enabled:bool

    init() {
        self.gravity = Math.Vec2(0.0, -9.81)
        self.sleep_enabled = true
        self.continuous_collision_enabled = true
        self.restitution_threshold = 1.0
        self.hit_event_threshold = 1.0
        self.contact_stiffness_hertz = 40.0
        self.contact_damping_ratio = 10.0
        self.maximum_correction_speed = 3.0
        self.maximum_linear_speed = 400.0
        self.warm_start_enabled = true
    }
}

public struct World2DCounters {
    let body_count:int
    let collider_count:int
    let contact_count:int
    let joint_count:int
    let active_island_count:int
    let logical_memory_bytes:int

    package init(
        body_count:int,
        collider_count:int,
        contact_count:int,
        joint_count:int,
        active_island_count:int,
        logical_memory_bytes:int
    ) {
        self.body_count = body_count
        self.collider_count = collider_count
        self.contact_count = contact_count
        self.joint_count = joint_count
        self.active_island_count = active_island_count
        self.logical_memory_bytes = logical_memory_bytes
    }
}

public struct World2DStepProfile {
    var motion_ms:float
    var broad_phase_ms:float
    var solve_ms:float
    var sleep_ms:float
    var total_ms:float

    init() {
        self.motion_ms = 0.0
        self.broad_phase_ms = 0.0
        self.solve_ms = 0.0
        self.sleep_ms = 0.0
        self.total_ms = 0.0
    }
}

public struct WorldCastResult2D {
    let hit:bool
    let point:Math.Vec2
    let normal:Math.Vec2
    let fraction:float
    private var current_collider:Collider2D?

    init() {
        self.hit = false
        self.point = Math.Vec2()
        self.normal = Math.Vec2()
        self.fraction = 0.0
        self.current_collider = null
    }

    package init(collider:Collider2D, result:CastResult2D) {
        self.hit = true
        self.point = result.point
        self.normal = result.normal
        self.fraction = result.fraction
        self.current_collider = collider
    }

    func collider() Collider2D {
        if let collider = self.current_collider { return collider }
        panic("GFX.Physics.WorldCastResult2D has no collider when hit is false")
    }
}

public class Contact2D {
    private var current_first_body:RigidBody2D?
    private var current_second_body:RigidBody2D?
    private var current_manifold:Manifold2D

    package init(
        first_body:RigidBody2D,
        second_body:RigidBody2D,
        manifold:Manifold2D
    ) {
        self.current_first_body = first_body
        self.current_second_body = second_body
        self.current_manifold = manifold
    }

    func first_body() RigidBody2D {
        if let body = self.current_first_body { return body }
        panic("GFX.Physics.Contact2D is not initialized")
    }
    func second_body() RigidBody2D {
        if let body = self.current_second_body { return body }
        panic("GFX.Physics.Contact2D is not initialized")
    }
    func manifold() Manifold2D { return self.current_manifold }
}

package class ActiveBodySet2D {
    var indices:int[]

    init() { self.indices = [] }

    func count() int { return self.indices.count() }
    func body_at(index:int) int { return self.indices[index] }
    func clear() { self.indices.clear() }
    func append(body:int) { self.indices.append(body) }
}

func soft_step_body_parallel_threshold() int { return 16_384 }
func soft_step_constraint_parallel_threshold() int { return 4_096 }

struct ContactPair2D {
    var normal:Math.Vec2
    var first_contact:Math.Vec2
    var second_contact:Math.Vec2
    var contact_count:int
    var normal_impulse_first:float
    var normal_impulse_second:float
    var tangent_impulse_first:float
    var tangent_impulse_second:float
    var rolling_impulse:float
    var first_awake:bool
    var second_awake:bool

    init() {
        self.normal = Math.Vec2()
        self.first_contact = Math.Vec2()
        self.second_contact = Math.Vec2()
        self.contact_count = 0
        self.normal_impulse_first = 0.0
        self.normal_impulse_second = 0.0
        self.tangent_impulse_first = 0.0
        self.tangent_impulse_second = 0.0
        self.rolling_impulse = 0.0
        self.first_awake = false
        self.second_awake = false
    }
}

struct SolidContact2D {
    let manifold:Manifold2D
    let first_material:PhysicsMaterial2D
    let second_material:PhysicsMaterial2D
    let first_radius:float
    let second_radius:float
    let first_anchor_rotates:bool
    let second_anchor_rotates:bool

    init(
        manifold:Manifold2D,
        first_material:PhysicsMaterial2D,
        second_material:PhysicsMaterial2D,
        first_radius:float,
        second_radius:float,
        first_anchor_rotates:bool,
        second_anchor_rotates:bool
    ) {
        self.manifold = manifold
        self.first_material = first_material
        self.second_material = second_material
        self.first_radius = first_radius
        self.second_radius = second_radius
        self.first_anchor_rotates = first_anchor_rotates
        self.second_anchor_rotates = second_anchor_rotates
    }
}

class PairSet2D {
    private var first_bodies:int[]
    private var second_bodies:int[]
    private var states:int[]
    private var entry_count:int
    private var removed_count:int

    init(minimum_capacity:int = 256) {
        self.first_bodies = []
        self.second_bodies = []
        self.states = []
        self.entry_count = 0
        self.removed_count = 0
        self.rebuild(minimum_capacity)
    }

    func count() int { return self.entry_count }

    func clear() {
        self.first_bodies.clear()
        self.second_bodies.clear()
        self.states.clear()
        var index = 0
        while index < 256 {
            self.first_bodies.append(0)
            self.second_bodies.append(0)
            self.states.append(0)
            index++
        }
        self.entry_count = 0
        self.removed_count = 0
    }

    func contains(pair:BodyPair2D) bool {
        return self.find(pair) >= 0
    }

    func add(pair:BodyPair2D) {
        self.ensure_capacity()
        var slot = self.initial_slot(pair)
        var removed_slot = -1
        while self.states[slot] != 0 {
            if self.states[slot] == 1 &&
                self.first_bodies[slot] == pair.first &&
                self.second_bodies[slot] == pair.second
            {
                return
            }
            if self.states[slot] == 2 && removed_slot < 0 {
                removed_slot = slot
            }
            slot = (slot + 1) % self.states.count()
        }
        if removed_slot >= 0 {
            slot = removed_slot
            self.removed_count--
        }
        self.first_bodies[slot] = pair.first
        self.second_bodies[slot] = pair.second
        self.states[slot] = 1
        self.entry_count++
    }

    func remove(pair:BodyPair2D) bool {
        let slot = self.find(pair)
        if slot < 0 { return false }
        self.states[slot] = 2
        self.entry_count--
        self.removed_count++
        return true
    }

    private func find(pair:BodyPair2D) int {
        var slot = self.initial_slot(pair)
        while self.states[slot] != 0 {
            if self.states[slot] == 1 &&
                self.first_bodies[slot] == pair.first &&
                self.second_bodies[slot] == pair.second
            {
                return slot
            }
            slot = (slot + 1) % self.states.count()
        }
        return -1
    }

    private func initial_slot(pair:BodyPair2D) int {
        let hash = pair.first as uint * 73_856_093 +
            pair.second as uint * 19_349_663
        return (hash % self.states.count() as uint) as int
    }

    private func ensure_capacity() {
        if (self.entry_count + self.removed_count + 1) * 4 <
            self.states.count() * 3
        {
            return
        }
        var capacity = self.states.count()
        if (self.entry_count + 1) * 4 >= capacity * 3 {
            capacity *= 2
        }
        self.rebuild(capacity)
    }

    private func rebuild(minimum_capacity:int) {
        var capacity = 8
        while capacity < minimum_capacity { capacity *= 2 }
        let previous_first = self.first_bodies
        let previous_second = self.second_bodies
        let previous_states = self.states
        self.first_bodies = []
        self.second_bodies = []
        self.states = []
        var index = 0
        while index < capacity {
            self.first_bodies.append(0)
            self.second_bodies.append(0)
            self.states.append(0)
            index++
        }
        self.entry_count = 0
        self.removed_count = 0
        index = 0
        while index < previous_states.count() {
            if previous_states[index] == 1 {
                self.add_without_growth(BodyPair2D(
                    previous_first[index],
                    previous_second[index]
                ))
            }
            index++
        }
    }

    private func add_without_growth(pair:BodyPair2D) {
        var slot = self.initial_slot(pair)
        while self.states[slot] == 1 {
            slot = (slot + 1) % self.states.count()
        }
        self.first_bodies[slot] = pair.first
        self.second_bodies[slot] = pair.second
        self.states[slot] = 1
        self.entry_count++
    }
}

struct ContinuousHit2D {
    let hit:bool
    let fraction:float
    let point:Math.Vec2
    let normal:Math.Vec2

    init() {
        self.hit = false
        self.fraction = 0.0
        self.point = Math.Vec2()
        self.normal = Math.Vec2()
    }

    init(fraction:float, point:Math.Vec2, normal:Math.Vec2) {
        self.hit = true
        self.fraction = fraction
        self.point = point
        self.normal = normal
    }
}

struct CompactCircleCollision2D {
    let first_body:int
    let second_body:int
    let normal:Math.Vec2
    let first_contact:Math.Vec2
    let cache_index:int
    var normal_impulse:float
    var tangent_impulse:float
    let normal_mass:float
    let tangent_mass:float
    let first_tangent_arm:float
    let second_tangent_arm:float
    let base_separation:float
    let initial_normal_offset:float
    let initial_normal_velocity:float
    let restitution:float
    let combined_friction:float
    var total_normal_impulse:float

    init(
        first_body:int,
        second_body:int,
        normal:Math.Vec2,
        first_contact:Math.Vec2,
        cache_index:int,
        normal_impulse:float,
        tangent_impulse:float,
        normal_mass:float,
        tangent_mass:float,
        first_tangent_arm:float,
        second_tangent_arm:float,
        base_separation:float,
        initial_normal_offset:float,
        initial_normal_velocity:float,
        restitution:float,
        combined_friction:float,
        total_normal_impulse:float = 0.0
    ) {
        self.first_body = first_body
        self.second_body = second_body
        self.normal = normal
        self.first_contact = first_contact
        self.cache_index = cache_index
        self.normal_impulse = normal_impulse
        self.tangent_impulse = tangent_impulse
        self.normal_mass = normal_mass
        self.tangent_mass = tangent_mass
        self.first_tangent_arm = first_tangent_arm
        self.second_tangent_arm = second_tangent_arm
        self.base_separation = base_separation
        self.initial_normal_offset = initial_normal_offset
        self.initial_normal_velocity = initial_normal_velocity
        self.restitution = restitution
        self.combined_friction = combined_friction
        self.total_normal_impulse = total_normal_impulse
    }
}

struct CompactCircleImpulses2D {
    var normal:float
    var tangent:float
    var total_normal:float

    init(normal:float, tangent:float, total_normal:float = 0.0) {
        self.normal = normal
        self.tangent = tangent
        self.total_normal = total_normal
    }
}

class SoftStepConstraintState2D {
    var collisions:Collision2D[]
    var compact_collisions:CompactCircleCollision2D[]
    var compact_impulses:CompactCircleImpulses2D[]
    // A non-negative entry addresses the compact circle array. A negative
    // entry addresses the general collision array through `-entry - 1`.
    var entries:int[]
    var colored_entries:int[]

    init() {
        self.collisions = []
        self.compact_collisions = []
        self.compact_impulses = []
        self.entries = []
        self.colored_entries = []
    }
}

