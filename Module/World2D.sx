                Geometry2D.shape_cast(
                    query,
                    translation,
                    query_collider_placement(self.store, dense),
                    max_fraction
                ).hit
            {
                return true
            }
        }
        return false
    }

    func shape_cast_closest(
        moving:ShapePlacement2D,
        translation:Math.Vec2,
        filter:QueryFilter2D = QueryFilter2D(),
        max_fraction:float = 1.0
    ) WorldCastResult2D {
        self.store.require_queryable()
        let query = ShapePlacement2D(moving.shape(), moving.transform())
        let bounds = shape_cast_query_bounds(query, translation, max_fraction)
        var closest = WorldCastResult2D()
        for dense in ordered_query_colliders(self.store) {
            if !query_collider_enabled(self.store, dense) ||
                !filter.allows(self.store.shape_store.collision_filters[dense]) ||
                !bounds.overlaps(query_collider_bounds(self.store, dense))
            {
                continue
            }
            let result = Geometry2D.shape_cast(
                query,
                translation,
                query_collider_placement(self.store, dense),
                max_fraction
            )
            if result.hit && (!closest.hit || result.fraction < closest.fraction) {
                closest = WorldCastResult2D(
                    query_collider_handle(self.store, dense),
                    result
                )
            }
