        return closest
    }
    func write_body_move_events(output:&BodyMoveEvent2D[]) {
        output.clear()
        for event in self.body_move_events { output.append(event) }
    }
    func write_contact_begin_events(output:&ContactBeginEvent2D[]) {
        output.clear()
        for event in self.contact_begin_events { output.append(event) }
    }
    func write_contact_end_events(output:&ContactEndEvent2D[]) {
        output.clear()
        for event in self.contact_end_events { output.append(event) }
    }
    func write_contact_hit_events(output:&ContactHitEvent2D[]) {
        output.clear()
        for event in self.contact_hit_events { output.append(event) }
    }
    func write_sensor_begin_events(output:&SensorBeginEvent2D[]) {
        output.clear()
        for event in self.sensor_begin_events { output.append(event) }
    }
    func write_sensor_end_events(output:&SensorEndEvent2D[]) {
        output.clear()
        for event in self.sensor_end_events { output.append(event) }
    }
    func hit_event_threshold() float { return self.current_hit_event_threshold }
    func set_hit_event_threshold(threshold:float) {
        self.store.require_mutable()
        require_non_negative_world_value(
            threshold,
            "GFX.Physics.World2D hit event threshold must be finite and non-negative"
        )
        self.current_hit_event_threshold = threshold
    }
    func set_profiling_enabled(enabled:bool) {
        self.store.require_mutable()
        self.profiling_enabled = enabled
    }
    func step_profile() World2DStepProfile { return self.current_step_profile }
    func enable_parallelism(worker_count:int) {
        self.store.require_mutable()
        if worker_count < 1 {
            panic("GFX.Physics.World2D parallel worker count must be positive")
        }
        self.parallel_executor = Threading.Executor(worker_count:worker_count)
        self.parallel_enabled = worker_count > 1
    }
    func awake_body_count() int {
        var count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.enabled[index] && self.store.awake[index] { count++ }
            index++
        }
        return count
    }

    private func wake_dynamic_bodies() {
        var index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic {
                self.store.wake(index)
            }
            index++
        }
    }

    package func persistent_pair_count() int {
        return self.candidate_pair_keys.count()
    }

    package func candidate_pair_slot_count() int {
        return self.candidate_pairs.count()
    }

    package func collision_count() int {
        return self.soft_constraints.collisions.count()
    }

    package func single_contact_collision_count() int {
        var count = 0
        for collision in self.soft_constraints.collisions {
            if collision.contacts.count == 1 { count++ }
        }
        return count
    }

    package func compact_collision_count() int {
        return self.soft_constraints.compact_collisions.count()
    }

    package func constraint_count() int {
        return self.soft_constraints.entries.count()
    }

    package func body_position_at(index:int) Math.Vec2 {
        return Math.Vec2(
            self.store.positions_x[index],
            self.store.positions_y[index]
        )
    }

    package func body_velocity_at(index:int) Math.Vec2 {
        return Math.Vec2(
            self.store.velocities_x[index],
            self.store.velocities_y[index]
        )
    }

    package func body_angular_velocity_at(index:int) float {
        return self.store.angular_velocities[index]
    }

    package func soft_step_stage_count() int {
        return self.current_soft_step_stages.count()
    }

    package func soft_step_stage_at(index:int) int {
        return self.current_soft_step_stages[index]
    }

    package func soft_step_parallel_dispatch_count() int {
        return self.current_soft_step_parallel_dispatch_count
    }

    package func ccd_body_count() int { return self.current_ccd_body_count }
    package func ccd_pair_test_count() int {
        return self.current_ccd_pair_test_count
    }

    package func soft_step_maximum_color_count() int {
        var maximum = 0
        for count in self.constraint_color_counts {
            if count > maximum { maximum = count }
        }
        for count in self.joints.color_counts {
            if count > maximum { maximum = count }
        }
        return maximum
    }

    package func active_island_count() int {
        return self.active_island_roots.count()
    }

    package func active_body_count() int {
        return self.active_bodies.count()
    }

    package func active_island_body_count() int {
        return self.active_island_bodies.count()
    }

    package func moved_proxy_count() int { return self.current_moved_proxy_count }

    package func discovered_pair_count() int {
        return self.current_discovered_pair_count
    }

    package func pair_collection_ms() float {
        return self.current_pair_collection_ms
    }

    package func pair_maintenance_ms() float {
        return self.current_pair_maintenance_ms
    }

    package func pair_filter_ms() float {
        return self.current_pair_filter_ms
    }

    package func pair_removal_ms() float { return self.current_pair_removal_ms }
    package func pair_discovery_ms() float { return self.current_pair_discovery_ms }
    package func pair_sort_ms() float { return self.current_pair_sort_ms }
    package func pair_insertion_ms() float { return self.current_pair_insertion_ms }
    package func collision_build_ms() float { return self.current_collision_build_ms }
    package func collision_warm_start_ms() float {
        return self.current_collision_warm_start_ms
    }
    package func collision_velocity_ms() float {
        return self.current_collision_velocity_ms
    }
    package func collision_position_ms() float {
        return self.current_collision_position_ms
    }
    package func collision_cache_ms() float { return self.current_collision_cache_ms }

    package func buried_body_count() int {
        var count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic &&
                self.support_grace[index] > 0.0 &&
                self.load_grace[index] > 0.0
            {
                count++
            }
            index++
        }
        return count
    }

    package func stable_buried_body_count() int {
        var count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic &&
                self.support_grace[index] > 0.0 &&
                self.load_grace[index] > 0.0 &&
                self.stable_for_sleep[index]
            {
                count++
            }
            index++
        }
        return count
    }

    package func quiet_buried_body_count() int {
        var count = 0
        var index = 0
        while index < self.store.count() {
            let linear_speed_squared =
                self.store.velocities_x[index] * self.store.velocities_x[index] +
                self.store.velocities_y[index] * self.store.velocities_y[index]
            let sweep_radius_squared = self.store.sweep_radii_squared[index]
            let angular_speed = self.store.angular_velocities[index]
            let motion_squared = linear_speed_squared +
                angular_speed * angular_speed * sweep_radius_squared
            if self.store.body_types[index] == BodyType2D.dynamic &&
                self.support_grace[index] > 0.0 &&
                self.load_grace[index] > 0.0 &&
                motion_squared <= 0.0009
            {
                count++
            }
            index++
        }
        return count
    }

    package func sleeping_progress_body_count() int {
        var count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.sleep_times[index] > 0.0 { count++ }
            index++
        }
        return count
    }

    package func sleep_eligible_body_count() int {
        var count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic &&
                self.store.enabled[index] &&
                self.store.awake[index] && self.sleep_eligible[index]
            {
                count++
            }
            index++
        }
        return count
    }

    package func sleep_ready_body_count() int {
        var count = 0
        var index = 0
        while index < self.store.count() {
            if self.store.body_types[index] == BodyType2D.dynamic &&
                self.store.enabled[index] &&
                self.store.awake[index] && self.sleep_eligible[index] &&
                self.store.sleep_times[index] >= 0.5
            {
                count++
            }
            index++
        }
        return count
    }

    func create_rigid_body(
        settings:RigidBody2DSettings = RigidBody2DSettings()
    ) RigidBody2D {
        self.store.require_mutable()
        let id = self.store.append(settings)
        let index = self.store.require(id)
        let bounds = body_bounds(self.store, index)
        self.tight_bounds.append(bounds)
        if settings.is_enabled {
            self.proxies.append(self.broad_phase.create_proxy(bounds, index))
        } else {
            self.proxies.append(-1)
        }
        self.circle_grid_next.append(-1)
        self.circle_grid_cell_x.append(0)
        self.circle_grid_cell_y.append(0)
        self.direct_wake_pending.append(false)
        self.contact_wake_cooldowns.append(0.0)
        if settings.is_enabled && settings.body_type != BodyType2D.dynamic {
            self.non_dynamic_bodies.append(index)
        } else if settings.is_enabled {
            if self.store.shape_counts[index] != 1 ||
                self.store.shape_kinds[index] != 1 ||
                Math.abs(self.store.local_centers_x[index]) > 0.000000001 ||
                Math.abs(self.store.local_centers_y[index]) > 0.000000001
            {
                self.dynamic_grid_eligible = false
            }
            let shape_radius = body_maximum_sweep_radius(self.store, index)
            self.maximum_dynamic_shape_radius = Math.max(
                self.maximum_dynamic_shape_radius,
                shape_radius
            )
            if self.store.shape_counts[index] == 1 &&
                self.store.shape_kinds[index] == 1
            {
                self.maximum_dynamic_circle_radius = Math.max(
                    self.maximum_dynamic_circle_radius,
                    self.store.radii[index]
                )
            }
        }
        self.support_grace.append(0.0)
        self.load_grace.append(0.0)
        self.stable_for_sleep.append(true)
        self.severe_for_sleep.append(false)
        self.sleep_parents.append(index)
        self.sleep_eligible.append(false)
        self.sleep_motion_squared.append(0.0)
        self.island_body_counts.append(0)
        self.island_ready_counts.append(0)
        self.island_can_sleep.append(true)
        self.island_write_offsets.append(0)
        if settings.is_enabled && settings.body_type == BodyType2D.dynamic &&
            settings.allow_sleep
        {
            self.sleep_enabled_body_count++
        }
        if settings.is_enabled && settings.is_bullet { self.bullet_body_count++ }
        if settings.is_enabled && settings.enable_move_events {
            self.move_event_body_count++
        }
        if settings.is_enabled && settings.enable_contact_events {
            self.contact_event_body_count++
        }
        if settings.is_enabled && settings.enable_hit_events {
            self.hit_event_body_count++
        }
        if settings.is_enabled && settings.is_sensor &&
            settings.enable_sensor_events
        {
            self.sensor_event_body_count++
        }
        self.store.dirty_transforms[index] = false
        return RigidBody2D(self.store, id)
    }

    func create_collider(
        body:RigidBody2D,
        settings:Collider2DSettings = Collider2DSettings()
    ) Collider2D {
        self.store.require_mutable()
        if !body.belongs_to(self.store) {
            panic("GFX.Physics.World2D cannot attach a collider to a body owned by another world")
        }
        let id = self.store.attach_collider(body.body_id(), settings)
        return Collider2D(self.store, id)
    }

    func destroy_collider(collider:Collider2D) {
        self.store.require_mutable()
        if !collider.belongs_to(self.store) {
            panic("GFX.Physics.World2D cannot destroy a collider owned by another world")
        }
        self.store.destroy_collider(collider.collider_id())
    }

    func joint_count() int { return self.joints.count() }

    func create_distance_joint(
        first:RigidBody2D,
        second:RigidBody2D,
        settings:DistanceJoint2DSettings = DistanceJoint2DSettings()
    ) DistanceJoint2D {
        let first_index = self.require_joint_body(first)
        let second_index = self.require_joint_body(second)
        self.require_distinct_joint_bodies(first, second)
        if settings.length < -1.0 || settings.minimum_length < 0.0 ||
            settings.maximum_length < settings.minimum_length ||
            settings.spring_hertz < 0.0 ||
            settings.spring_damping_ratio < 0.0 ||
            settings.maximum_motor_force < 0.0
        {
            panic("GFX.Physics distance joint settings are invalid")
        }
        var joint = JointConstraint2D(
            JointKind2D.distance,
            first.body_id(),
            second.body_id()
        )
        joint.first_anchor = body_local_point(
            self.store,
            first_index,
            settings.first_anchor
        )
        joint.second_anchor = body_local_point(
            self.store,
            second_index,
            settings.second_anchor
        )
        var length = settings.length
        if length < 0.0 {
            length = settings.second_anchor.subtract(
                settings.first_anchor
            ).length()
        }
        joint.scalar_target = length
        joint.minimum = settings.minimum_length
        joint.maximum = settings.maximum_length
        joint.spring_hertz = settings.spring_hertz
        joint.spring_damping_ratio = settings.spring_damping_ratio
        joint.motor_speed = settings.motor_speed
        joint.maximum_motor_force = settings.maximum_motor_force
        joint.spring_enabled = settings.spring_enabled
        joint.limit_enabled = settings.limit_enabled
        joint.motor_enabled = settings.motor_enabled
        joint.collide_connected = settings.collide_connected
        let id = self.joints.append(joint)
        self.finish_joint_creation(first_index, second_index, joint)
        return DistanceJoint2D(self.joints, id)
    }

    func create_filter_joint(
        first:RigidBody2D,
        second:RigidBody2D,
        settings:FilterJoint2DSettings = FilterJoint2DSettings()
    ) FilterJoint2D {
        let first_index = self.require_joint_body(first)
        let second_index = self.require_joint_body(second)
        self.require_distinct_joint_bodies(first, second)
        var joint = JointConstraint2D(
            JointKind2D.filter,
            first.body_id(),
            second.body_id()
        )
        joint.collide_connected = false
        let id = self.joints.append(joint)
        self.finish_joint_creation(first_index, second_index, joint)
        return FilterJoint2D(self.joints, id)
    }

    func create_motor_joint(
        first:RigidBody2D,
        second:RigidBody2D,
        settings:MotorJoint2DSettings = MotorJoint2DSettings()
    ) MotorJoint2D {
        let first_index = self.require_joint_body(first)
        let second_index = self.require_joint_body(second)
        self.require_distinct_joint_bodies(first, second)
        if settings.maximum_force < 0.0 || settings.maximum_torque < 0.0 ||
            settings.correction_factor < 0.0 ||
            settings.correction_factor > 1.0
        {
            panic("GFX.Physics motor joint settings are invalid")
        }
        var joint = JointConstraint2D(
            JointKind2D.motor,
            first.body_id(),
            second.body_id()
        )
        joint.linear_target = settings.linear_offset
        joint.reference_angle = settings.angular_offset
        joint.maximum_motor_force = settings.maximum_force
        joint.maximum_motor_torque = settings.maximum_torque
        joint.correction_factor = settings.correction_factor
        joint.collide_connected = settings.collide_connected
        let id = self.joints.append(joint)
        self.finish_joint_creation(first_index, second_index, joint)
        return MotorJoint2D(self.joints, id)
    }

    func create_mouse_joint(
        body:RigidBody2D,
        settings:MouseJoint2DSettings = MouseJoint2DSettings()
    ) MouseJoint2D {
        let body_index = self.require_joint_body(body)
        if settings.spring_hertz < 0.0 ||
            settings.spring_damping_ratio < 0.0 ||
            settings.maximum_force < 0.0
        {
            panic("GFX.Physics mouse joint settings are invalid")
        }
        var joint = JointConstraint2D(
            JointKind2D.mouse,
            body.body_id(),
            body.body_id()
        )
        joint.first_anchor = body_local_point(
            self.store,
            body_index,
            settings.target
        )
        joint.linear_target = settings.target
        joint.spring_hertz = settings.spring_hertz
        joint.spring_damping_ratio = settings.spring_damping_ratio
        joint.maximum_motor_force = settings.maximum_force
        joint.spring_enabled = true
        let id = self.joints.append(joint)
        self.finish_joint_creation(body_index, body_index, joint)
        return MouseJoint2D(self.joints, id)
    }

    func create_prismatic_joint(
        first:RigidBody2D,
        second:RigidBody2D,
        settings:PrismaticJoint2DSettings = PrismaticJoint2DSettings()
    ) PrismaticJoint2D {
        let first_index = self.require_joint_body(first)
        let second_index = self.require_joint_body(second)
        self.require_distinct_joint_bodies(first, second)
        let axis = normalized_joint_axis(settings.axis)
        if settings.lower_translation > settings.upper_translation ||
            settings.spring_hertz < 0.0 ||
            settings.spring_damping_ratio < 0.0 ||
            settings.maximum_motor_force < 0.0
        {
            panic("GFX.Physics prismatic joint settings are invalid")
        }
        var joint = JointConstraint2D(
            JointKind2D.prismatic,
            first.body_id(),
            second.body_id()
        )
        joint.first_anchor = body_local_point(
            self.store,
            first_index,
            settings.anchor
        )
        joint.second_anchor = body_local_point(
            self.store,
            second_index,
            settings.anchor
        )
        joint.local_axis = body_local_vector(self.store, first_index, axis)
        joint.reference_angle = self.store.rotations[second_index] -
            self.store.rotations[first_index]
        joint.scalar_target = settings.target_translation
        joint.minimum = settings.lower_translation
        joint.maximum = settings.upper_translation
        joint.spring_hertz = settings.spring_hertz
        joint.spring_damping_ratio = settings.spring_damping_ratio
        joint.motor_speed = settings.motor_speed
        joint.maximum_motor_force = settings.maximum_motor_force
        joint.spring_enabled = settings.spring_enabled
        joint.limit_enabled = settings.limit_enabled
        joint.motor_enabled = settings.motor_enabled
        joint.collide_connected = settings.collide_connected
        let id = self.joints.append(joint)
        self.finish_joint_creation(first_index, second_index, joint)
        return PrismaticJoint2D(self.joints, id)
    }

