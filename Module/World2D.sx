    private var sensor_end_events:SensorEndEvent2D[]
    private var current_hit_event_threshold:float
    private var current_ccd_body_count:int
    private var current_ccd_pair_test_count:int

    init(
        settings:World2DSettings = World2DSettings(),
        gravity:Math.Vec2? = null,
        hit_event_threshold:float? = null
    ) {
        var selected = settings
        if let compatibility_gravity = gravity {
            selected.gravity = compatibility_gravity
        }
        if let compatibility_threshold = hit_event_threshold {
            selected.hit_event_threshold = compatibility_threshold
        }
        validate_world_settings(selected)
        self.current_gravity = selected.gravity
        self.current_sleep_enabled = selected.sleep_enabled
        self.current_continuous_collision_enabled =
            selected.continuous_collision_enabled
        self.current_restitution_threshold = selected.restitution_threshold
        self.current_contact_stiffness_hertz =
            selected.contact_stiffness_hertz
        self.current_contact_damping_ratio = selected.contact_damping_ratio
        self.current_maximum_correction_speed =
            selected.maximum_correction_speed
        self.current_maximum_linear_speed = selected.maximum_linear_speed
        self.current_warm_start_enabled = selected.warm_start_enabled
        self.store = BodyStore2D()
        self.joints = JointStore2D(self.store)
        self.proxies = []
        self.tight_bounds = []
        self.broad_phase = BroadPhase2D()
        self.maximum_dynamic_shape_radius = 0.0
        self.maximum_dynamic_circle_radius = 0.0
        self.non_dynamic_bodies = []
        self.circle_grid_heads = []
        self.circle_grid_stamps = []
        self.circle_grid_next = []
        self.circle_grid_cell_x = []
        self.circle_grid_cell_y = []
        self.circle_grid_generation = 0
        self.dynamic_grid_active = false
        self.dynamic_grid_eligible = true
        self.discovered_pairs = []
        self.new_candidate_pairs = []
        self.candidate_bodies = []
        self.candidate_enabled = []
        self.candidate_pairs = []
        self.candidate_pair_keys = PairSet2D()
        self.free_candidate_slots = []
        self.free_candidate_count = 0
        self.active_pairs = []
        self.soft_constraints = SoftStepConstraintState2D()
        self.constraint_body_color_masks = []
        self.constraint_color_counts = []
        self.constraint_color_offsets = []
        self.constraint_color_cursors = []
        self.constraint_entry_colors = []
        self.direct_wake_pending = []
        self.direct_wake_bodies = []
        self.contact_wake_cooldowns = []
