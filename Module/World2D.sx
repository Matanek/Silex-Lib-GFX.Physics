    func create_weld_joint(
        first:RigidBody2D,
        second:RigidBody2D,
        settings:WeldJoint2DSettings = WeldJoint2DSettings()
    ) WeldJoint2D {
        let first_index = self.require_joint_body(first)
        let second_index = self.require_joint_body(second)
        self.require_distinct_joint_bodies(first, second)
        if settings.linear_hertz < 0.0 ||
            settings.linear_damping_ratio < 0.0 ||
            settings.angular_hertz < 0.0 ||
            settings.angular_damping_ratio < 0.0
        {
            panic("GFX.Physics weld joint settings are invalid")
        }
        var joint = JointConstraint2D(
            JointKind2D.weld,
            first.body_id(),
            second.body_id()
        )
        joint.first_anchor = body_local_point(
            self.store,
            first_index,
            settings.anchor
        )
        joint.second_anchor = body_local_point(
            self.store,
            second_index,
            settings.anchor
        )
        joint.reference_angle = self.store.rotations[second_index] -
            self.store.rotations[first_index]
        joint.spring_hertz = settings.linear_hertz
        joint.spring_damping_ratio = settings.linear_damping_ratio
        joint.angular_hertz = settings.angular_hertz
        joint.angular_damping_ratio = settings.angular_damping_ratio
        joint.spring_enabled = settings.linear_hertz > 0.0 ||
            settings.angular_hertz > 0.0
        joint.collide_connected = settings.collide_connected
        let id = self.joints.append(joint)
        self.finish_joint_creation(first_index, second_index, joint)
        return WeldJoint2D(self.joints, id)
    }

