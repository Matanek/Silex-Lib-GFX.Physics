use GFX.Physics
use STD.Math

func main() {
    var world=Physics.World3D()
    world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
        ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=1.0)
    var wheels:Physics.Wheel3DSettings[]=[];let sides:int[]=[-1,1]
    for x in sides { for z in sides {
        var turn=0.0;if z>0 { turn=Math.radians(30.0) }
        wheels.append(Physics.Wheel3DSettings(Math.Vec3(0.6*x as float,0.0,z as float),
            tire:Physics.Tire3DSettings(),maximum_steering_angle:turn))
    } }
    var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,0.875475,0.0))
            ..allow_sleep=false ..linear_damping=0.0 ..angular_damping=0.0,wheels,
        engine:Physics.VehicleEngine3DSettings(maximum_torque:30.0),
        differentials:[Physics.VehicleDifferential3DSettings(0,2)]))
    vehicle.set_controls(throttle:0.5)
    var step=0;while step<240 { world.step(1.0/120.0);step++ }
    assert(vehicle.chassis().linear_velocity().z>0.2)
    vehicle.set_controls(throttle:0.4,steering:0.3)
    step=0;while step<240 { world.step(1.0/120.0);step++ }
    assert(vehicle.chassis().position().x< -0.05)
    vehicle.set_controls(brake:1.0)
    step=0;while step<360 { world.step(1.0/120.0);step++ }
    assert(vehicle.chassis().linear_velocity().length()<0.03)
    print("Engine torque accelerates through the tires; automatic gears, steering and brakes complete the drive")
}
