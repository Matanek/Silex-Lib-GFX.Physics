use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Input
use GFX.Physics
use GFX.Plugins
use GFX.Resources
use STD.Math

static struct Demo {
    let pixels_per_meter:float = 90.0
    let fixed_delta:float = 1.0 / 120.0
}

struct DemoVisual { let kind:int }

class Simulation {
    var physics:Physics.World2D
    var mover:Physics.CharacterMover2D
    var position:Math.Vec2
    var velocity:Math.Vec2
    var platform:Physics.RigidBody2D?
    var elapsed:float
    var accumulator:float
    var grounded:bool
    var plane_count:int

    init() {
        self.physics = Physics.World2D(gravity:Math.Vec2())
        self.mover = Physics.CharacterMover2D(
            Physics.CharacterMover2DSettings()
                ..capsule = Physics.Capsule2D(
                    Math.Vec2(0.0, -0.45),
                    Math.Vec2(0.0, 0.45),
                    0.3
                )
                ..maximum_iterations = 10
        )
        self.position = Math.Vec2(-4.5, -1.45)
        self.velocity = Math.Vec2()
        self.platform = null
        self.elapsed = 0.0
        self.accumulator = 0.0
        self.grounded = false
        self.plane_count = 0
    }

    func reset() {
        self.position = Math.Vec2(-4.5, -1.45)
        self.velocity = Math.Vec2()
        self.grounded = false
    }
}

func box_drawing(size:Math.Vec2, color:Color, radius:float = 3.0) Canvas {
    let pixels = size.multiply(Demo.pixels_per_meter)
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), pixels, radius),
            Canvas.Fill.solid(color)
        )
        painter.stroke(
            Canvas.Rect(Math.Vec2(1.0), pixels.subtract(Math.Vec2(2.0)), radius),
            Canvas.Stroke(Color.white().with_alpha(0.22), 2.0)
        )
    })
}

func character_drawing() Canvas {
    let width = 0.6 * Demo.pixels_per_meter
    let height = 1.5 * Demo.pixels_per_meter
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(width, height), width * 0.5),
            Canvas.Fill.solid(Color.cyan_400())
        )
        painter.stroke(
            Canvas.Rect(
                Math.Vec2(2.0),
                Math.Vec2(width - 4.0, height - 4.0),
                width * 0.5
            ),
            Canvas.Stroke(Color.white(), 3.0)
        )
        painter.fill(
            Canvas.Circle(Math.Vec2(width * 0.38, height * 0.35), 3.0),
            Canvas.Fill.solid(Color.slate_950())
        )
        painter.fill(
            Canvas.Circle(Math.Vec2(width * 0.62, height * 0.35), 3.0),
            Canvas.Fill.solid(Color.slate_950())
        )
    })
}

func status_drawing() Canvas {
    return Canvas()..paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(390.0, 112.0), 10.0),
            Canvas.Fill.solid(Color.black().with_alpha(0.82))
        )
        painter.text(
            "CHARACTER MOVER 2D",
            Math.Vec2(16.0, 12.0),
            Canvas.TextStyle(
                size:16.0,
                color:Color.cyan_300(),
                weight:Canvas.TextWeight.bold
            )
        )
        painter.text(
            "A/D or arrows: move   SPACE: jump   R: reset",
            Math.Vec2(16.0, 40.0),
            Canvas.TextStyle(size:13.0, color:Color.slate_200())
        )
        painter.text(
            "LIVE CAPSULE CAST · SLIDE · DEPENETRATION",
            Math.Vec2(16.0, 68.0),
            Canvas.TextStyle(size:14.0, color:Color.emerald_300())
        )
        painter.text(
            "Slope · step · concave corner · moving platform",
            Math.Vec2(16.0, 91.0),
            Canvas.TextStyle(size:12.0, color:Color.slate_400())
        )
    })
}

func spawn_box(
    world:&Resources.World,
    simulation:&Simulation,
    position:Math.Vec2,
    size:Math.Vec2,
    color:Color,
    rotation:float = 0.0,
    body_type:Physics.BodyType2D = Physics.BodyType2D.fixed
) Physics.RigidBody2D {
    var body = simulation.physics.create_rigid_body(
        Physics.RigidBody2DSettings()
            ..body_type = body_type
            ..position = position
            ..rotation = rotation
            ..shape = Physics.Shape2D.box(Physics.Box2D(size))
    )
    var drawing = box_drawing(size, color)
    let width = Math.round(size.x * Demo.pixels_per_meter) as int
    let height = Math.round(size.y * Demo.pixels_per_meter) as int
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(
            position:position.multiply(Demo.pixels_per_meter),
            rotation:rotation
        ))
        ..with(Components.Canvas(drawing, width, height))
    )
    return body
}

func create_scene(world:&Resources.World, simulation:&Simulation) {
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )

    spawn_box(
        world, simulation,
        Math.Vec2(-3.8, -2.4), Math.Vec2(3.6, 0.45),
        Color.slate_600()
    )
    spawn_box(
        world, simulation,
        Math.Vec2(-1.55, -1.95), Math.Vec2(2.6, 0.38),
        Color.indigo_500(), 0.31
    )
    spawn_box(
        world, simulation,
        Math.Vec2(0.15, -1.45), Math.Vec2(0.9, 0.55),
        Color.violet_500()
    )
    spawn_box(
        world, simulation,
        Math.Vec2(1.15, -1.15), Math.Vec2(0.85, 1.15),
        Color.fuchsia_500()
    )
    spawn_box(
        world, simulation,
        Math.Vec2(4.7, -1.0), Math.Vec2(0.45, 3.4),
        Color.rose_500()
    )
    spawn_box(
        world, simulation,
        Math.Vec2(3.55, 1.05), Math.Vec2(2.7, 0.38),
        Color.slate_600()
    )

    var platform = simulation.physics.create_rigid_body(
        Physics.RigidBody2DSettings()
            ..body_type = Physics.BodyType2D.kinematic
            ..position = Math.Vec2(2.65, -0.25)
            ..shape = Physics.Shape2D.box(Physics.Box2D(Math.Vec2(1.8, 0.3)))
    )
    simulation.platform = platform
    var platform_drawing = box_drawing(
        Math.Vec2(1.8, 0.3),
        Color.emerald_500(),
        8.0
    )
    world.spawn(ECS.EntityRecipe()
        ..with(DemoVisual(kind:1))
        ..with(Components.Transform2D(
            position:platform.position().multiply(Demo.pixels_per_meter)
        ))
        ..with(Components.Canvas(platform_drawing, 162, 27)..layer = 2)
    )

    var character = character_drawing()
    world.spawn(ECS.EntityRecipe()
        ..with(DemoVisual(kind:0))
        ..with(Components.Transform2D(
            position:simulation.position.multiply(Demo.pixels_per_meter)
        ))
        ..with(Components.Canvas(character, 54, 135)..layer = 4)
    )

    var status = status_drawing()
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D(position:Math.Vec2(18.0)))
        ..with(Components.Canvas(status, 390, 112)
            ..anchor = Math.Vec2()
            ..pivot = Math.Vec2()
            ..space = Components.CanvasSpace.viewport
            ..layer = 100
        )
    )
}

func simulate_character(
    time:@Resources.FrameTime,
    input:@Resources.InputState,
    simulation:&Simulation,
    controller:&Application.Controller,
    visuals:ECS.Query<(@DemoVisual, &Components.Transform2D)>
) {
    if input.is_pressed(Input.Key.escape) { controller.stop() }
    if input.is_pressed(Input.Key.r) { simulation.reset() }

    var direction = 0.0
    if input.is_down(Input.Key.a) || input.is_down(Input.Key.left) {
        direction -= 1.0
    }
    if input.is_down(Input.Key.d) || input.is_down(Input.Key.right) {
        direction += 1.0
    }
    simulation.velocity.x = direction * 3.2
    if simulation.grounded && input.is_pressed(Input.Key.space) {
        simulation.velocity.y = 6.2
        simulation.grounded = false
    }

    simulation.elapsed += time.delta
    if var platform = simulation.platform {
        platform.set_position(Math.Vec2(
            2.65,
            -0.25 + Math.sin(simulation.elapsed * 1.25) * 0.65
        ))
    }

    simulation.accumulator = Math.min(
        simulation.accumulator + time.delta,
        Demo.fixed_delta * 8.0
    )
    while simulation.accumulator >= Demo.fixed_delta {
        simulation.velocity.y -= 16.0 * Demo.fixed_delta
        var result = simulation.mover.calculate_move(
            simulation.physics,
            simulation.position,
            simulation.velocity.multiply(Demo.fixed_delta)
        )
        simulation.position = simulation.position.add(result.applied_translation)
        simulation.velocity = simulation.mover.clip_vector(
            simulation.velocity,
            result.planes()
        )
        simulation.grounded = false
        for plane in result.planes() {
            if plane.normal.y > 0.55 && plane.push() > 0.0 {
                simulation.grounded = true
            }
        }
        simulation.plane_count = result.planes().count()
        simulation.accumulator -= Demo.fixed_delta
    }

    if simulation.position.y < -5.0 { simulation.reset() }
    for (visual, transform) in visuals {
        if visual.kind == 0 {
            transform.position = simulation.position.multiply(
                Demo.pixels_per_meter
            )
        } elif let platform = simulation.platform {
            transform.position = platform.position().multiply(Demo.pixels_per_meter)
        }
    }
}

func main() {
    Application()
        ..add_resource(Simulation())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Physics — Character Mover 2D"
            ..width = 1040
            ..height = 680
            ..resizable = false
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Plugins.Time())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_system(Application.Schedule.update, simulate_character)
        ..run()
}
