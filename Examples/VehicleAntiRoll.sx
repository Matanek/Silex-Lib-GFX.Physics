use GFX.Physics
use STD.Math
func main() {
    for enabled in [false,true] {
        var world=Physics.World3D()
        world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed
            ..shape=Physics.Shape3D.plane(Physics.Plane3D()) ..friction=0.0)
        var wheels:Physics.Wheel3DSettings[]=[];let sides:float[]=[-1.0,1.0]
        for x in sides { for z in sides { wheels.append(Physics.Wheel3DSettings(Math.Vec3(x*0.6,0.0,z),
            maximum_length:0.77985,stiffness:1200.0,damping:160.0)) } }
        var bars:Physics.VehicleAntiRollBar3DSettings[]=[]
        if enabled { bars=[Physics.VehicleAntiRollBar3DSettings(0,2),Physics.VehicleAntiRollBar3DSettings(1,3)] }
        var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(
            Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
                ..transform=Physics.Transform3D(Math.Vec3(0.0,0.875475,0.0))
                ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
                ..linear_damping=0.0 ..angular_damping=0.0 ..allow_sleep=false,wheels,anti_roll_bars:bars))
        var step=0
        while step<480 {
            if step>=240 { vehicle.chassis().apply_torque(Math.Vec3(0.0,0.0,40.0)) }
            world.step(1.0/120.0);step++
        }
        let pose=vehicle.chassis().transform()
        let roll=Math.atan2(pose.vector(Math.Vec3.right()).y,pose.vector(Math.Vec3.up()).y)
        print("anti-roll=$(enabled) roll=$(Math.degrees(roll)) degrees")
    }
}
