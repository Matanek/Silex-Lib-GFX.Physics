use GFX.Physics
use STD.Math

func main() {
    let capsule = Physics.ShapePlacement2D(
        Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(-1.0, 0.0),
            Math.Vec2(1.0, 0.0),
            0.25
        )),
        Physics.Transform2D(position:Math.Vec2(0.0, 1.0))
    )
    let floor = Physics.ShapePlacement2D(
        Physics.Shape2D.polygon(Physics.Polygon2D([
            Math.Vec2(-3.0, -0.25),
            Math.Vec2(3.0, -0.25),
            Math.Vec2(3.0, 0.25),
            Math.Vec2(-3.0, 0.25)
        ], 0.1))
    )

    let distance = Physics.Geometry2D.distance(capsule, floor)
    print("separation=$(distance.distance)")

    let hit = Physics.Geometry2D.ray_cast(
        Physics.Ray2D(Math.Vec2(0.0, 3.0), Math.Vec2(0.0, -6.0)),
        floor
    )
    if hit.hit {
        print("ray_fraction=$(hit.fraction) normal=$(hit.normal.x),$(hit.normal.y)")
    }
}
