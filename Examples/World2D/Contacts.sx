use GFX.Physics
use STD.Math

func print_contacts(world:Physics.World2D, label:str) {
    var contacts:Physics.Contact2D[] = []
    world.write_contacts(contacts)
    print("$(label): $(contacts.count()) contact(s)")
    for contact in contacts {
        let manifold = contact.manifold()
        let point = manifold.points[0]
        print("  normal=$(manifold.normal.x),$(manifold.normal.y) point=$(point.point.x),$(point.point.y) separation=$(point.separation)")
    }
}

func main() {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.enable_parallelism(4)
    world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
        ..shape = Physics.Shape2D.polygon(Physics.Polygon2D([
            Math.Vec2(-1.0, -0.2),
            Math.Vec2(1.0, -0.2),
            Math.Vec2(1.0, 0.2),
            Math.Vec2(-1.0, 0.2)
        ], 0.05))
    )
    var capsule = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(-0.5, 0.0),
            Math.Vec2(0.5, 0.0),
            0.25
        ))
        ..position = Math.Vec2(0.0, 0.35)
        ..gravity_scale = 0.0
        ..allow_sleep = false
    )

    world.step(0.0)
    print_contacts(world, "created")
    world.step(0.0)
    print_contacts(world, "persisted")
    capsule.set_position(Math.Vec2(0.0, 2.0))
    world.step(0.0)
    print_contacts(world, "separated")

    assert(world.contact_count() == 0)
}
