use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.enable_parallelism(4)

    var anchor = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.fixed
    )
    var arm = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(1.0, 0.0)
        ..allow_sleep = false
    )
    var payload = world.create_rigid_body(Physics.RigidBody2DSettings()
        ..position = Math.Vec2(2.0, 0.0)
        ..allow_sleep = false
    )

    var hinge = world.create_revolute_joint(
        anchor,
        arm,
        Physics.RevoluteJoint2DSettings()
            ..anchor = Math.Vec2()
            ..lower_angle = -1.0
            ..upper_angle = 1.0
            ..motor_speed = 1.5
            ..maximum_motor_torque = 30.0
            ..limit_enabled = true
            ..motor_enabled = true
    )
    var spring = world.create_distance_joint(
        arm,
        payload,
        Physics.DistanceJoint2DSettings()
            ..first_anchor = Math.Vec2(1.0, 0.0)
            ..second_anchor = Math.Vec2(2.0, 0.0)
            ..length = 1.0
            ..spring_hertz = 5.0
            ..spring_damping_ratio = 0.8
            ..spring_enabled = true
    )

    var step = 0
    while step < 240 {
        world.step(1.0 / 120.0)
        step++
    }

    assert(world.joint_count() == 2)
    assert(hinge.is_valid())
    assert(spring.is_valid())
    assert(hinge.angle() >= -1.05 && hinge.angle() <= 1.05)
    assert(Math.abs(spring.current_length() - 1.0) < 0.08)
    assert(arm.position().x == arm.position().x)
    assert(payload.position().x == payload.position().x)

    print("hinge angle: $(hinge.angle()) rad")
    print("hinge motor torque: $(hinge.motor_torque()) N.m")
    print("spring length: $(spring.current_length()) m")
    print("spring force: $(spring.constraint_force().length()) N")
}
