use GFX.Animation
use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Plugins
use GFX.Rendering
use GFX.Resources
use STD.Math
use STD.Process

static struct Showcase {
    let pixels_per_meter:float = 90.0
    let fixed_delta:float = 1.0 / 60.0
    let ball_count:int = 60
    let ball_diameter:float = 0.28
    let ball_pixels:int = 28
    let container_half_extent:float = 2.35
    let container_wall_thickness:float = 0.2
    let container_pixels:int = 468
    let container_turn_duration:float = 0.25
    let container_turn_interval:float = 0.8
}

struct BodyVisual {
    let index:int
}

struct ContainerVisual {
    let center:Math.Vec2
}

class Simulation {
    var world:Physics.World2D
    var bodies:Physics.RigidBody2D[]
    var container_left:Physics.RigidBody2D?
    var container_right:Physics.RigidBody2D?
    var container_bottom:Physics.RigidBody2D?
    var container_top:Physics.RigidBody2D?
    var container_center:Math.Vec2
    var container_angle:float
    var container_visual_angle:float
    var container_cycle_offset:float
    var container_target_angle:float
    var accumulator:float
    var elapsed:float
    var smoke_duration:float

    init(smoke_duration:float) {
        self.world = Physics.World2D()
        self.bodies = []
        self.container_left = null
        self.container_right = null
        self.container_bottom = null
        self.container_top = null
        self.container_center = Math.Vec2()
        self.container_angle = 0.0
        self.container_visual_angle = 0.0
        self.container_cycle_offset = 0.0
        self.container_target_angle = 0.0
        self.accumulator = 0.0
        self.elapsed = 0.0
        self.smoke_duration = smoke_duration
    }
}

class Visuals {
    var ball:Canvas
    var container:Canvas

    init() {
        let ball_center = Showcase.ball_pixels as float * 0.5
        self.ball = Canvas()
            ..paint(func(painter:&Canvas.Painter) {
                painter.fill(
                    Canvas.Circle(
                        Math.Vec2(ball_center),
                        Showcase.ball_diameter *
                            Showcase.pixels_per_meter * 0.5
                    ),
                    Canvas.Fill.solid(Color.white())
                )
            })
        self.container = Canvas()
            ..paint(func(painter:&Canvas.Painter) {
                painter.stroke(
                    Canvas.Rect(Math.Vec2(4.0), Math.Vec2(460.0), 13.0),
                    Canvas.Stroke(Color.violet_300(), 9.0)
                )
                painter.stroke(
                    Canvas.Rect(Math.Vec2(12.0), Math.Vec2(444.0), 9.0),
                    Canvas.Stroke(Color.cyan_300(), 2.0)
                )
            })
    }

    func ball_component() Components.Canvas {
        return Components.Canvas(
            self.ball,
            Showcase.ball_pixels,
            Showcase.ball_pixels
        )
    }

    func container_component() Components.Canvas {
        return Components.Canvas(
            self.container,
            Showcase.container_pixels,
            Showcase.container_pixels
        )..layer = 2
    }
}

func body_color(index:int) Color {
    if index % 4 == 0 { return Color.cyan_400() }
    if index % 4 == 1 { return Color.sky_400() }
    if index % 4 == 2 { return Color.violet_400() }
    return Color.fuchsia_400()
}

func rotate_offset(offset:Math.Vec2, angle:float) Math.Vec2 {
    let cosine = Math.cos(angle)
    let sine = Math.sin(angle)
    return Math.Vec2(
        offset.x * cosine - offset.y * sine,
        offset.x * sine + offset.y * cosine
    )
}

func create_container_wall(
    simulation:&Simulation,
    offset:Math.Vec2,
    size:Math.Vec2
) Physics.RigidBody2D {
    return simulation.world.create_rigid_body(
        Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.kinematic
        ..shape = Physics.Shape2D.box(Physics.Box2D(size))
        ..position = offset
        ..friction = 0.85
        ..restitution = 0.1
    )
}

func create_container_walls(simulation:&Simulation) {
    let half = Showcase.container_half_extent
    let thickness = Showcase.container_wall_thickness
    let offset = half + thickness * 0.5
    let span = half * 2.0 + thickness * 2.0
    simulation.container_left = create_container_wall(
        simulation,
        Math.Vec2(-offset, 0.0),
        Math.Vec2(thickness, span)
    )
    simulation.container_right = create_container_wall(
        simulation,
        Math.Vec2(offset, 0.0),
        Math.Vec2(thickness, span)
    )
    simulation.container_bottom = create_container_wall(
        simulation,
        Math.Vec2(0.0, -offset),
        Math.Vec2(span, thickness)
    )
    simulation.container_top = create_container_wall(
        simulation,
        Math.Vec2(0.0, offset),
        Math.Vec2(span, thickness)
    )
}

func update_container_walls(simulation:&Simulation, angle:float) {
    let half = Showcase.container_half_extent
    let thickness = Showcase.container_wall_thickness
    let offset = half + thickness * 0.5
    if var wall = simulation.container_left {
        let target = rotate_offset(Math.Vec2(-offset, 0.0), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
    if var wall = simulation.container_right {
        let target = rotate_offset(Math.Vec2(offset, 0.0), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
    if var wall = simulation.container_bottom {
        let target = rotate_offset(Math.Vec2(0.0, -offset), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
    if var wall = simulation.container_top {
        let target = rotate_offset(Math.Vec2(0.0, offset), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
}

func container_rotation() Animation.Timeline {
    let pause = Showcase.container_turn_interval -
        Showcase.container_turn_duration
    let easing = Animation.Easing.in_out
    return Animation.sequence([
        Animation.rotate_to(
            Math.pi() * 0.25,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 0.5,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 0.75,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi(),
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.25,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.5,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.75,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 2.0,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause)
    ])..loop()
}

func spawn_ball(
    scene:&Resources.World,
    simulation:&Simulation,
    visuals:@Visuals,
    index:int,
    position:Math.Vec2
) {
    var body = simulation.world.create_rigid_body(
        Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.circle(
            Physics.Circle2D(Showcase.ball_diameter * 0.5)
        )
        ..position = position
        ..friction = 0.65
        ..restitution = 0.28
        ..angular_damping = 0.16
    )
    var component = visuals.ball_component()
    component.color = body_color(index)
    scene.spawn(ECS.EntityRecipe()
        ..with(BodyVisual(index:index))
        ..with(Components.Transform2D(
            position:body.position().multiply(Showcase.pixels_per_meter)
        ))
        ..with(component)
    )
    simulation.bodies.append(body)
}

func create_scene(
    scene:&Resources.World,
    simulation:&Simulation,
    visuals:@Visuals
) {
    scene.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    create_container_walls(simulation)
    scene.spawn(ECS.EntityRecipe()
        ..with(ContainerVisual(center:Math.Vec2()))
        ..with(Components.Transform2D())
        ..with(visuals.container_component())
        ..with(container_rotation().play())
    )
    var index = 0
    while index < Showcase.ball_count {
        let column = index % 10
        let row = index / 10
        spawn_ball(
            scene,
            simulation,
            visuals,
            index,
            Math.Vec2(
                (column as float - 4.5) * 0.42,
                -1.25 + row as float * 0.42
            )
        )
        index++
    }
}

func sync_container(
    simulation:&Simulation,
    containers:ECS.Query<(@ContainerVisual, @Components.Transform2D)>
) {
    for (container, transform) in containers {
        simulation.container_center = container.center
        if simulation.container_visual_angle > Math.pi() * 1.75 &&
            transform.rotation < Math.pi() * 0.25
        {
            simulation.container_cycle_offset += Math.pi() * 2.0
        }
        simulation.container_visual_angle = transform.rotation
        simulation.container_target_angle =
            simulation.container_cycle_offset + transform.rotation
    }
}

func assert_balls_contained(simulation:@Simulation) {
    let limit = Showcase.container_half_extent +
        Showcase.container_wall_thickness * 0.75
    var index = 0
    while index < Showcase.ball_count {
        let offset = simulation.bodies[index].position()
            .subtract(simulation.container_center)
        let local_position = rotate_offset(
            offset,
            -simulation.container_angle
        )
        assert(Math.abs(local_position.x) < limit)
        assert(Math.abs(local_position.y) < limit)
        index++
    }
}

func simulate(
    time:@Resources.FrameTime,
    simulation:&Simulation,
    controller:&Application.Controller,
    body_visuals:ECS.Query<(@BodyVisual, &Components.Transform2D)>
) {
    simulation.elapsed += time.delta
    simulation.accumulator = Math.min(
        simulation.accumulator + time.delta,
        Showcase.fixed_delta * 8.0
    )
    let step_count = Math.floor(
        simulation.accumulator / Showcase.fixed_delta
    ) as int
    var step = 0
    while simulation.accumulator >= Showcase.fixed_delta {
        simulation.container_angle = Math.lerp(
            simulation.container_angle,
            simulation.container_target_angle,
            1.0 / (step_count - step) as float
        )
        update_container_walls(simulation, simulation.container_angle)
        simulation.world.step(Showcase.fixed_delta)
        if simulation.smoke_duration > 0.0 {
            assert_balls_contained(simulation)
        }
        simulation.accumulator -= Showcase.fixed_delta
        step++
    }
    for (visual, transform) in body_visuals {
        let body = simulation.bodies[visual.index]
        transform.position = body.position().multiply(
            Showcase.pixels_per_meter
        )
        transform.rotation = body.rotation()
    }
    if simulation.smoke_duration > 0.0 &&
        simulation.elapsed >= simulation.smoke_duration
    {
        assert(simulation.bodies.count() == Showcase.ball_count)
        assert(simulation.container_left != null)
        assert(simulation.container_right != null)
        assert(simulation.container_bottom != null)
        assert(simulation.container_top != null)
        assert(simulation.container_cycle_offset >= Math.pi() * 2.0)
        assert(simulation.container_angle > Math.pi() * 2.0)
        assert(simulation.world.joint_count() == 0)
        assert(simulation.world.contact_count() > 0)
        print(
            "BoxRotation smoke: balls=$(simulation.bodies.count()), " +
            "container=$(simulation.container_angle), " +
            "elapsed=$(simulation.elapsed), " +
            "awake=$(simulation.world.awake_body_count()), " +
            "contacts=$(simulation.world.contact_count())"
        )
        controller.stop()
    }
}

func smoke_duration() float {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--smoke" { return 16.25 }
            }
        }
    }
    return 0.0
}

func main() {
    Application()
        ..add_resource(Simulation(smoke_duration()))
        ..add_resource(Visuals())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Physics — Animated container"
            ..width = 720
            ..height = 720
            ..resizable = false
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
            ..present_mode = Rendering.PresentMode.immediate
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Animation.Plugin())
        ..add_plugin(Plugins.FPSPanel())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_after_system(Application.Schedule.update, sync_container)
        ..add_after_system(Application.Schedule.update, simulate)
        ..run()
}
