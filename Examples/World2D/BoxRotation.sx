use GFX.Animation
use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Physics
use GFX.Plugins
use GFX.Rendering
use GFX.Resources
use STD.Math
use STD.Process
use STD.Randomizer

static struct Showcase {
    let pixels_per_meter:float = 90.0
    let fixed_delta:float = 1.0 / 60.0
    let body_count:int = 120
    let base_body_size:float = 0.28
    let body_pixels:int = 32
    let spawn_interval:float = 0.2
    let reveal_duration:float = 0.16
    let spawn_half_extent:float = 1.65
    let spawn_candidate_count:int = 24
    let container_half_extent:float = 2.35
    let container_wall_thickness:float = 0.45
    let containment_tolerance:float = 0.12
    let container_pixels:int = 468
    let container_turn_duration:float = 0.4
    let container_turn_interval:float = 0.8
}

struct BodyVisual {
    let index:int
}

struct SimulatedBody {
    var body:Physics.RigidBody2D
    let is_box:bool
    let size:Math.Vec2
    let radius:float
    var previous_position:Math.Vec2
    var current_position:Math.Vec2
    var previous_rotation:float
    var current_rotation:float
}

struct PendingBody {
    let is_box:bool
    let size:Math.Vec2
    let local_position:Math.Vec2
    let local_rotation:float
    var elapsed:float
}

struct ContainerVisual {
    let center:Math.Vec2
}

class Simulation {
    var world:Physics.World2D
    var bodies:SimulatedBody[]
    var randomizer:Randomizer
    var container_left:Physics.RigidBody2D?
    var container_right:Physics.RigidBody2D?
    var container_bottom:Physics.RigidBody2D?
    var container_top:Physics.RigidBody2D?
    var container_center:Math.Vec2
    var container_previous_angle:float
    var container_angle:float
    var container_visual_angle:float
    var container_cycle_offset:float
    var container_target_angle:float
    var accumulator:float
    var elapsed:float
    var rendered_frames:int
    var spawn_elapsed:float
    var spawned_count:int
    var pending_count:int
    var box_count:int
    var smoke_duration:float

    init(smoke_duration:float) {
        self.world = Physics.World2D()
        self.bodies = []
        self.randomizer = Randomizer(0xB0_2D_12_0D)
        self.container_left = null
        self.container_right = null
        self.container_bottom = null
        self.container_top = null
        self.container_center = Math.Vec2()
        self.container_previous_angle = 0.0
        self.container_angle = 0.0
        self.container_visual_angle = 0.0
        self.container_cycle_offset = 0.0
        self.container_target_angle = 0.0
        self.accumulator = 0.0
        self.elapsed = 0.0
        self.rendered_frames = 0
        self.spawn_elapsed = 0.0
        self.spawned_count = 0
        self.pending_count = 0
        self.box_count = 0
        self.smoke_duration = smoke_duration
    }
}

class Visuals {
    var circle:Canvas
    var box:Canvas
    var container:Canvas

    init() {
        let body_center = Showcase.body_pixels as float * 0.5
        let body_size = Showcase.base_body_size * Showcase.pixels_per_meter
        let body_origin = body_center - body_size * 0.5
        self.circle = Canvas()
            ..paint(func(painter:&Canvas.Painter) {
                painter.fill(
                    Canvas.Circle(
                        Math.Vec2(body_center),
                        body_size * 0.5
                    ),
                    Canvas.Fill.solid(Color.white())
                )
            })
        self.box = Canvas()
            ..paint(func(painter:&Canvas.Painter) {
                painter.fill(
                    Canvas.Rect(
                        Math.Vec2(body_origin),
                        Math.Vec2(body_size),
                        3.0
                    ),
                    Canvas.Fill.solid(Color.white())
                )
            })
        self.container = Canvas()
            ..paint(func(painter:&Canvas.Painter) {
                painter.stroke(
                    Canvas.Rect(Math.Vec2(4.0), Math.Vec2(460.0), 13.0),
                    Canvas.Stroke(Color.violet_300(), 9.0)
                )
                painter.stroke(
                    Canvas.Rect(Math.Vec2(12.0), Math.Vec2(444.0), 9.0),
                    Canvas.Stroke(Color.cyan_300(), 2.0)
                )
            })
    }

    func body_component(is_box:bool) Components.Canvas {
        var drawing = self.circle
        if is_box { drawing = self.box }
        return Components.Canvas(
            drawing,
            Showcase.body_pixels,
            Showcase.body_pixels
        )
    }

    func container_component() Components.Canvas {
        return Components.Canvas(
            self.container,
            Showcase.container_pixels,
            Showcase.container_pixels
        )..layer = 2
    }
}

func body_color(index:int) Color {
    if index % 4 == 0 { return Color.cyan_400() }
    if index % 4 == 1 { return Color.sky_400() }
    if index % 4 == 2 { return Color.violet_400() }
    return Color.fuchsia_400()
}

func rotate_offset(offset:Math.Vec2, angle:float) Math.Vec2 {
    let cosine = Math.cos(angle)
    let sine = Math.sin(angle)
    return Math.Vec2(
        offset.x * cosine - offset.y * sine,
        offset.x * sine + offset.y * cosine
    )
}

func create_container_wall(
    simulation:&Simulation,
    offset:Math.Vec2,
    size:Math.Vec2
) Physics.RigidBody2D {
    return simulation.world.create_rigid_body(
        Physics.RigidBody2DSettings()
        ..body_type = Physics.BodyType2D.kinematic
        ..shape = Physics.Shape2D.box(Physics.Box2D(size))
        ..position = offset
        ..friction = 0.85
        ..restitution = 0.1
    )
}

func create_container_walls(simulation:&Simulation) {
    let half = Showcase.container_half_extent
    let thickness = Showcase.container_wall_thickness
    let offset = half + thickness * 0.5
    let span = half * 2.0 + thickness * 2.0
    simulation.container_left = create_container_wall(
        simulation,
        Math.Vec2(-offset, 0.0),
        Math.Vec2(thickness, span)
    )
    simulation.container_right = create_container_wall(
        simulation,
        Math.Vec2(offset, 0.0),
        Math.Vec2(thickness, span)
    )
    simulation.container_bottom = create_container_wall(
        simulation,
        Math.Vec2(0.0, -offset),
        Math.Vec2(span, thickness)
    )
    simulation.container_top = create_container_wall(
        simulation,
        Math.Vec2(0.0, offset),
        Math.Vec2(span, thickness)
    )
}

func update_container_walls(simulation:&Simulation, angle:float) {
    let half = Showcase.container_half_extent
    let thickness = Showcase.container_wall_thickness
    let offset = half + thickness * 0.5
    if var wall = simulation.container_left {
        let target = rotate_offset(Math.Vec2(-offset, 0.0), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
    if var wall = simulation.container_right {
        let target = rotate_offset(Math.Vec2(offset, 0.0), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
    if var wall = simulation.container_bottom {
        let target = rotate_offset(Math.Vec2(0.0, -offset), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
    if var wall = simulation.container_top {
        let target = rotate_offset(Math.Vec2(0.0, offset), angle)
        wall.set_velocity(target.subtract(wall.position()).multiply(
            1.0 / Showcase.fixed_delta
        ))
        wall.set_angular_velocity(
            (angle - wall.rotation()) / Showcase.fixed_delta
        )
    }
}

func container_rotation() Animation.Timeline {
    let pause = Showcase.container_turn_interval -
        Showcase.container_turn_duration
    let easing = Animation.Easing.in_out
    return Animation.sequence([
        Animation.rotate_to(
            Math.pi() * 0.25,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 0.5,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 0.75,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi(),
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.25,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.5,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 1.75,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause),
        Animation.rotate_to(
            Math.pi() * 2.0,
            Showcase.container_turn_duration,
            easing:easing
        ),
        Animation.wait(pause)
    ])..loop()
}

func body_size(index:int, is_box:bool) Math.Vec2 {
    let variant = index / 2 % 4
    if is_box {
        if variant == 0 { return Math.Vec2(0.22) }
        if variant == 1 { return Math.Vec2(0.34, 0.20) }
        if variant == 2 { return Math.Vec2(0.24, 0.38) }
        return Math.Vec2(0.38, 0.28)
    }
    if variant == 0 { return Math.Vec2(0.22) }
    if variant == 1 { return Math.Vec2(0.26) }
    if variant == 2 { return Math.Vec2(0.30) }
    return Math.Vec2(0.34)
}

func body_radius(size:Math.Vec2, is_box:bool) float {
    if !is_box { return size.x * 0.5 }
    return Math.sqrt(
        size.x * size.x + size.y * size.y
    ) * 0.5
}

func spawn_clearance(
    simulation:@Simulation,
    local_position:Math.Vec2,
    radius:float
) float {
    let position = simulation.container_center.add(rotate_offset(
        local_position,
        simulation.container_angle
    ))
    var clearance = Showcase.container_half_extent -
        Math.max(Math.abs(local_position.x), Math.abs(local_position.y)) -
        radius
    for simulated in simulation.bodies {
        let distance = Math.sqrt(
            position.subtract(simulated.body.position()).length_squared()
        )
        clearance = Math.min(
            clearance,
            distance - radius - simulated.radius
        )
    }
    return clearance
}

func random_spawn_position(
    simulation:&Simulation,
    radius:float
) Math.Vec2 {
    let limit = Showcase.spawn_half_extent - radius
    var best = Math.Vec2()
    var best_clearance = -Showcase.container_half_extent * 2.0
    var candidate = 0
    while candidate < Showcase.spawn_candidate_count {
        let position = Math.Vec2(
            simulation.randomizer.get_float(-limit, limit),
            simulation.randomizer.get_float(-limit, limit)
        )
        let clearance = spawn_clearance(simulation, position, radius)
        if clearance > best_clearance {
            best = position
            best_clearance = clearance
        }
        candidate++
    }
    return best
}

func spawn_body_preview(
    scene:&Resources.World,
    simulation:&Simulation,
    visuals:@Visuals,
    index:int
) {
    let is_box = index % 2 == 1
    let size = body_size(index, is_box)
    let radius = body_radius(size, is_box)
    let local_position = random_spawn_position(simulation, radius)
    let local_rotation = (index % 5 - 2) as float * 0.12
    let position = simulation.container_center.add(rotate_offset(
        local_position,
        simulation.container_angle
    ))
    let color = body_color(index)
    let scale = Math.Vec2(
        size.x / Showcase.base_body_size,
        size.y / Showcase.base_body_size
    )
    let reveal = Animation.parallel([
        Animation.scale_to(
            scale,
            Showcase.reveal_duration,
            easing:Animation.Easing.cubic_out
        ),
        Animation.color_to(
            color,
            Showcase.reveal_duration,
            easing:Animation.Easing.cubic_out
        )
    ])
    var component = visuals.body_component(is_box)
    component.color = color.with_alpha(0.0)
    if is_box { component.layer = 1 }
    scene.spawn(ECS.EntityRecipe()
        ..with(PendingBody(
            is_box:is_box,
            size:size,
            local_position:local_position,
            local_rotation:local_rotation,
            elapsed:0.0
        ))
        ..with(Components.Transform2D(
            position:position.multiply(Showcase.pixels_per_meter),
            rotation:simulation.container_angle + local_rotation,
            scale:Math.Vec2()
        ))
        ..with(component)
        ..with(reveal.play())
    )
    simulation.spawned_count++
    simulation.pending_count++
}

func create_scene(
    scene:&Resources.World,
    simulation:&Simulation,
    visuals:@Visuals
) {
    scene.spawn(ECS.EntityRecipe()
        ..with(Components.Transform2D())
        ..with(Components.Camera2D())
    )
    create_container_walls(simulation)
    scene.spawn(ECS.EntityRecipe()
        ..with(ContainerVisual(center:Math.Vec2()))
        ..with(Components.Transform2D())
        ..with(visuals.container_component())
        ..with(container_rotation().play())
    )
}

func spawn_bodies(
    time:@Resources.FrameTime,
    scene:&Resources.World,
    simulation:&Simulation,
    visuals:@Visuals
) {
    simulation.spawn_elapsed += time.delta
    while simulation.spawn_elapsed >= Showcase.spawn_interval &&
        simulation.spawned_count < Showcase.body_count
    {
        spawn_body_preview(
            scene,
            simulation,
            visuals,
            simulation.spawned_count
        )
        simulation.spawn_elapsed -= Showcase.spawn_interval
    }
}

func activate_bodies(
    time:@Resources.FrameTime,
    simulation:&Simulation,
    commands:&Resources.Commands,
    pending_visuals:ECS.Query<(
        ECS.Entity,
        &PendingBody,
        &Components.Transform2D,
        @Components.Canvas
    )>
) {
    for (entity, pending, transform, canvas) in pending_visuals {
        pending.elapsed += time.delta
        transform.position = simulation.container_center.add(rotate_offset(
            pending.local_position,
            simulation.container_angle
        )).multiply(Showcase.pixels_per_meter)
        transform.rotation = simulation.container_angle +
            pending.local_rotation
        if pending.elapsed < Showcase.reveal_duration { continue }
        if simulation.smoke_duration > 0.0 {
            let expected_scale = Math.Vec2(
                pending.size.x / Showcase.base_body_size,
                pending.size.y / Showcase.base_body_size
            )
            assert(transform.scale.nearly_equal(expected_scale, 0.001))
            assert(Math.nearly_equal(canvas.color.a, 1.0, 0.001))
        }
        var shape = Physics.Shape2D.circle(
            Physics.Circle2D(pending.size.x * 0.5)
        )
        if pending.is_box {
            shape = Physics.Shape2D.box(Physics.Box2D(pending.size))
        }
        var body = simulation.world.create_rigid_body(
            Physics.RigidBody2DSettings()
            ..shape = shape
            ..position = transform.position.multiply(
                1.0 / Showcase.pixels_per_meter
            )
            ..rotation = transform.rotation
            ..friction = 0.65
            ..restitution = 0.28
            ..angular_damping = 0.16
        )
        let body_position = body.position()
        let body_rotation = body.rotation()
        commands.insert(
            entity,
            BodyVisual(index:simulation.bodies.count())
        )
        commands.remove<PendingBody>(entity)
        commands.remove<Animation.Playback>(entity)
        simulation.bodies.append(SimulatedBody(
            body:body,
            is_box:pending.is_box,
            size:pending.size,
            radius:body_radius(pending.size, pending.is_box),
            previous_position:body_position,
            current_position:body_position,
            previous_rotation:body_rotation,
            current_rotation:body_rotation
        ))
        simulation.pending_count--
        if pending.is_box { simulation.box_count++ }
    }
}

func sync_container(
    simulation:&Simulation,
    containers:ECS.Query<(@ContainerVisual, @Components.Transform2D)>
) {
    for (container, transform) in containers {
        simulation.container_center = container.center
        if simulation.container_visual_angle > Math.pi() * 1.75 &&
            transform.rotation < Math.pi() * 0.25
        {
            simulation.container_cycle_offset += Math.pi() * 2.0
        }
        simulation.container_visual_angle = transform.rotation
        simulation.container_target_angle =
            simulation.container_cycle_offset + transform.rotation
    }
}

func assert_bodies_contained(simulation:@Simulation) {
    var index = 0
    while index < simulation.bodies.count() {
        let simulated = simulation.bodies[index]
        let offset = simulated.body.position()
            .subtract(simulation.container_center)
        let local_position = rotate_offset(
            offset,
            -simulation.container_angle
        )
        var extent = Math.Vec2(simulated.size.x * 0.5)
        if simulated.is_box {
            let relative_rotation = simulated.body.rotation() -
                simulation.container_angle
            let cosine = Math.abs(Math.cos(relative_rotation))
            let sine = Math.abs(Math.sin(relative_rotation))
            let half_width = simulated.size.x * 0.5
            let half_height = simulated.size.y * 0.5
            extent = Math.Vec2(
                cosine * half_width + sine * half_height,
                sine * half_width + cosine * half_height
            )
        }
        let limit = Showcase.container_half_extent +
            Showcase.containment_tolerance
        assert(Math.abs(local_position.x) + extent.x < limit)
        assert(Math.abs(local_position.y) + extent.y < limit)
        index++
    }
}

func simulate(
    time:@Resources.FrameTime,
    simulation:&Simulation,
    controller:&Application.Controller
) {
    simulation.elapsed += time.delta
    simulation.rendered_frames++
    simulation.accumulator = Math.min(
        simulation.accumulator + time.delta,
        Showcase.fixed_delta * 8.0
    )
    let step_count = Math.floor(
        simulation.accumulator / Showcase.fixed_delta
    ) as int
    var step = 0
    while simulation.accumulator >= Showcase.fixed_delta {
        simulation.container_previous_angle = simulation.container_angle
        var body_index = 0
        while body_index < simulation.bodies.count() {
            simulation.bodies[body_index].previous_position =
                simulation.bodies[body_index].current_position
            simulation.bodies[body_index].previous_rotation =
                simulation.bodies[body_index].current_rotation
            body_index++
        }
        simulation.container_angle = Math.lerp(
            simulation.container_angle,
            simulation.container_target_angle,
            1.0 / (step_count - step) as float
        )
        update_container_walls(simulation, simulation.container_angle)
        simulation.world.step(Showcase.fixed_delta)
        body_index = 0
        while body_index < simulation.bodies.count() {
            simulation.bodies[body_index].current_position =
                simulation.bodies[body_index].body.position()
            simulation.bodies[body_index].current_rotation =
                simulation.bodies[body_index].body.rotation()
            body_index++
        }
        if simulation.smoke_duration > 0.0 {
            assert_bodies_contained(simulation)
        }
        simulation.accumulator -= Showcase.fixed_delta
        step++
    }
    if simulation.smoke_duration > 0.0 &&
        simulation.bodies.count() > 0
    {
        let alpha = simulation.accumulator / Showcase.fixed_delta
        assert(alpha >= 0.0)
        assert(alpha < 1.0)
    }
    if simulation.smoke_duration > 0.0 &&
        simulation.elapsed >= simulation.smoke_duration
    {
        assert(simulation.spawned_count == Showcase.body_count)
        assert(simulation.pending_count == 0)
        assert(simulation.bodies.count() == Showcase.body_count)
        assert(simulation.box_count == Showcase.body_count / 2)
        assert(simulation.container_left != null)
        assert(simulation.container_right != null)
        assert(simulation.container_bottom != null)
        assert(simulation.container_top != null)
        assert(simulation.container_cycle_offset >= Math.pi() * 2.0)
        assert(simulation.container_angle > Math.pi() * 2.0)
        assert(simulation.world.joint_count() == 0)
        assert(simulation.world.contact_count() > 0)
        print(
            "BoxRotation smoke: bodies=$(simulation.bodies.count()), " +
            "boxes=$(simulation.box_count), " +
            "container=$(simulation.container_angle), " +
            "elapsed=$(simulation.elapsed), " +
            "fps=$(simulation.rendered_frames as float / simulation.elapsed), " +
            "awake=$(simulation.world.awake_body_count()), " +
            "contacts=$(simulation.world.contact_count())"
        )
        controller.stop()
    }
}

func interpolation_alpha(simulation:@Simulation) float {
    return Math.clamp(
        simulation.accumulator / Showcase.fixed_delta,
        0.0,
        1.0
    )
}

func interpolate_position(
    previous:Math.Vec2,
    current:Math.Vec2,
    alpha:float
) Math.Vec2 {
    return previous.add(current.subtract(previous).multiply(alpha))
}

func interpolate_container_visual(
    simulation:@Simulation,
    containers:ECS.Query<(@ContainerVisual, &Components.Transform2D)>
) {
    let alpha = interpolation_alpha(simulation)
    let angle = Math.lerp(
        simulation.container_previous_angle,
        simulation.container_angle,
        alpha
    )
    for (container, transform) in containers {
        transform.position = container.center.multiply(
            Showcase.pixels_per_meter
        )
        transform.rotation = angle
    }
}

func interpolate_pending_visuals(
    simulation:@Simulation,
    pending_visuals:ECS.Query<(
        @PendingBody,
        &Components.Transform2D
    )>
) {
    let alpha = interpolation_alpha(simulation)
    let angle = Math.lerp(
        simulation.container_previous_angle,
        simulation.container_angle,
        alpha
    )
    for (pending, transform) in pending_visuals {
        transform.position = simulation.container_center.add(rotate_offset(
            pending.local_position,
            angle
        )).multiply(Showcase.pixels_per_meter)
        transform.rotation = angle + pending.local_rotation
    }
}

func interpolate_body_visuals(
    simulation:@Simulation,
    body_visuals:ECS.Query<(@BodyVisual, &Components.Transform2D)>
) {
    let alpha = interpolation_alpha(simulation)
    for (visual, transform) in body_visuals {
        let simulated = simulation.bodies[visual.index]
        transform.position = interpolate_position(
            simulated.previous_position,
            simulated.current_position,
            alpha
        ).multiply(Showcase.pixels_per_meter)
        transform.rotation = Math.lerp(
            simulated.previous_rotation,
            simulated.current_rotation,
            alpha
        )
    }
}

func smoke_duration() float {
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => {
            for argument in arguments {
                if argument == "--smoke" { return 64.25 }
            }
        }
    }
    return 0.0
}

func main() {
    Application()
        ..add_resource(Simulation(smoke_duration()))
        ..add_resource(Visuals())
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Physics — Animated container"
            ..width = 720
            ..height = 720
            ..resizable = false
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_950()
        ))
        ..add_plugin(Plugins.Scene2D())
        ..add_plugin(Animation.Plugin())
        ..add_plugin(Plugins.FPSPanel())
        ..add_system(Application.Schedule.startup, create_scene)
        ..add_after_system(Application.Schedule.update, sync_container)
        ..add_after_system(Application.Schedule.update, activate_bodies)
        ..add_after_system(Application.Schedule.update, spawn_bodies)
        ..add_after_system(Application.Schedule.update, simulate)
        ..add_after_system(
            Application.Schedule.update,
            interpolate_container_visual
        )
        ..add_after_system(
            Application.Schedule.update,
            interpolate_pending_visuals
        )
        ..add_after_system(
            Application.Schedule.update,
            interpolate_body_visuals
        )
        ..run()
}
