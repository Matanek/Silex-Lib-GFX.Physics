use GFX.Physics
use STD.Math

func capsule_settings(x:float) Physics.RigidBody2DSettings {
    return Physics.RigidBody2DSettings()
        ..shape = Physics.Shape2D.capsule(Physics.Capsule2D(
            Math.Vec2(-0.5, 0.0),
            Math.Vec2(0.5, 0.0),
            0.25
        ))
        ..position = Math.Vec2(x, 0.0)
        ..gravity_scale = 0.0
}

func main() {
    var world = Physics.World2D(gravity:Math.Vec2())
    world.enable_parallelism(4)
    var first = world.create_rigid_body(capsule_settings(0.0))
    var second = world.create_rigid_body(capsule_settings(1.3))
    var third = world.create_rigid_body(capsule_settings(2.6))

    world.step(1.0 / 60.0)
    print("created: awake=$(world.awake_body_count()) contacts=$(world.contact_count())")
    var step = 0
    while step < 31 {
        world.step(1.0 / 60.0)
        step++
    }
    print("sleeping: awake=$(world.awake_body_count()) contacts=$(world.contact_count())")

    first.set_velocity(Math.Vec2(1.0, 0.0))
    world.step(0.0)
    print("impact: awake=$(world.awake_body_count()) first=$(first.is_awake()) second=$(second.is_awake()) third=$(third.is_awake())")
    world.destroy_rigid_body(second)
    world.step(0.0)
    print("deleted: awake=$(world.awake_body_count()) third=$(third.is_awake())")

    assert(first.is_awake())
    assert(!third.is_awake())
}
